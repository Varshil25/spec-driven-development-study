<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pins the Java static-analysis tools used by score_run.py (pre-registered in
  docs/PREREGISTRATION-JAVA.md). This project builds nothing; fetch.sh copies
  the jars into ./lib once, and score_run.py runs SpotBugs from there with the
  FindSecBugs plugin over a run's compiled classes.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>study</groupId>
    <artifactId>java-sast</artifactId>
    <version>1</version>
    <packaging>pom</packaging>

    <properties>
        <spotbugs.version>4.10.5</spotbugs.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs</artifactId>
            <version>${spotbugs.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h3xstream.findsecbugs</groupId>
            <artifactId>findsecbugs-plugin</artifactId>
            <version>${findsecbugs.version}</version>
        </dependency>
    </dependencies>
</project>
