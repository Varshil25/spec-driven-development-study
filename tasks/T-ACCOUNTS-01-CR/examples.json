{
  "task": "T-ACCOUNTS-01-CR",
  "package": "accounts",
  "kind": "cli",
  "includes": ["T-ACCOUNTS-01"],
  "examples": [
    {"show": "printf 'correct horse battery\\n' | python -m accounts --store users.db register alice",
     "args": ["--store", "users.db", "register", "alice"], "stdin": "correct horse battery\n",
     "expect": {"exit": 0, "stdout": "registered alice\n"}},
    {"show": "python -m accounts --store users.db reset-token alice",
     "args": ["--store", "users.db", "reset-token", "alice"],
     "expect": {"exit": 0, "stdout_nonempty": true}},
    {"show": "printf 'not-the-token\\nbrand new password\\n' | python -m accounts --store users.db reset alice",
     "args": ["--store", "users.db", "reset", "alice"], "stdin": "not-the-token\nbrand new password\n",
     "expect": {"exit": 1, "stderr_contains": "invalid token"}},
    {"show": "python -m accounts --store users.db reset-token nobody",
     "args": ["--store", "users.db", "reset-token", "nobody"],
     "expect": {"exit": 3, "stderr_nonempty": true}}
  ]
}
