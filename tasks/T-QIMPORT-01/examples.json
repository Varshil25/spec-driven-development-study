{
  "task": "T-QIMPORT-01",
  "kind": "http",
  "runtime": "quarkus",
  "data_property": "contacts.data-dir",
  "examples": [
    {"show": "curl -s -X POST 127.0.0.1:8765/contacts/import -H 'Content-Type: application/xml' --data-binary @ada.xml",
     "method": "POST", "path": "/contacts/import",
     "body": "<contacts>\n  <contact>\n    <name>Ada Lovelace</name>\n    <email>ada@example.com</email>\n    <phone>+44 20 7946 0000</phone>\n  </contact>\n  <contact>\n    <name>Grace Hopper</name>\n    <email>grace@example.com</email>\n    <company>US Navy</company>\n  </contact>\n</contacts>\n",
     "headers": {"Content-Type": "application/xml"},
     "expect": {"status": 200, "json_subset": {"imported": 2}}},
    {"show": "curl -s 127.0.0.1:8765/contacts",
     "method": "GET", "path": "/contacts",
     "expect": {"status": 200, "json_keys": ["contacts"],
                "contains_in_order": ["Ada Lovelace", "Grace Hopper"]}},
    {"show": "curl -s -o /dev/null -w '%{http_code}\\n' -X POST 127.0.0.1:8765/contacts -H 'Content-Type: application/json' -d '{\"name\": \"Ada\", \"email\": \"ada@example.com\"}'",
     "method": "POST", "path": "/contacts", "body": "{\"name\": \"Ada\", \"email\": \"ada@example.com\"}",
     "headers": {"Content-Type": "application/json"},
     "expect": {"status": 409}}
  ]
}
