{
  "task": "T-REDACT-01",
  "package": "logredact",
  "kind": "cli",
  "examples": [
    {"show": "printf 'user jane@example.com from 10.0.0.7\\n' | python -m logredact",
     "args": [], "stdin": "user jane@example.com from 10.0.0.7\n",
     "expect": {"exit": 0, "stdout": "user [EMAIL] from [IP]\n"}},
    {"show": "printf 'paid with 4111 1111 1111 1111, ref 1234567890123\\n' | python -m logredact",
     "args": [], "stdin": "paid with 4111 1111 1111 1111, ref 1234567890123\n",
     "expect": {"exit": 0, "stdout": "paid with [CARD], ref 1234567890123\n"}},
    {"show": "printf 'a@b.io 1.2.3.4\\n' | python -m logredact --count",
     "args": ["--count"], "stdin": "a@b.io 1.2.3.4\n",
     "expect": {"exit": 0, "stdout": "[EMAIL] [IP]\n", "stderr_contains": "emails=1 ips=1 cards=0"}}
  ]
}
