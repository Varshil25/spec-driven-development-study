{
  "task": "T-TARX-01-CR",
  "package": "tarx",
  "kind": "cli",
  "includes": ["T-TARX-01"],
  "files": {"photos/a.jpg": "jpeg-a", "photos/b.jpg": "jpeg-b"},
  "examples": [
    {"show": "python -m tarx create photos.tar.gz photos", "args": ["create", "photos.tar.gz", "photos"],
     "expect": {"exit": 0, "stdout": "created photos.tar.gz with 2 files\n"}},
    {"show": "python -m tarx create photos.tar.gz photos   (second time)", "args": ["create", "photos.tar.gz", "photos"],
     "expect": {"exit": 3, "stderr_nonempty": true}},
    {"show": "python -m tarx create other.tar missing-folder", "args": ["create", "other.tar", "missing-folder"],
     "expect": {"exit": 2, "stderr_nonempty": true}}
  ]
}
