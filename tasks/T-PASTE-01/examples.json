{
  "task": "T-PASTE-01",
  "package": "pastebin",
  "kind": "http",
  "server_args": ["serve", "--port", "{port}", "--data", "./pastes"],
  "ready_line": "listening on 127.0.0.1:{port}",
  "examples": [
    {"show": "curl -s -X POST 127.0.0.1:8765/pastes -d '{\"content\": \"hello\"}'",
     "method": "POST", "path": "/pastes", "body": "{\"content\": \"hello\"}",
     "headers": {"Content-Type": "application/x-www-form-urlencoded"},
     "expect": {"status": 201, "json_keys": ["id", "delete_token", "url"]},
     "capture": {"id": "id"}},
    {"show": "curl -s 127.0.0.1:8765/pastes/<id>/raw",
     "method": "GET", "path": "/pastes/{id}/raw",
     "expect": {"status": 200, "body": "hello"}},
    {"show": "curl -s -o /dev/null -w '%{http_code}\\n' 127.0.0.1:8765/pastes/does-not-exist",
     "method": "GET", "path": "/pastes/does-not-exist",
     "expect": {"status": 404}}
  ]
}
