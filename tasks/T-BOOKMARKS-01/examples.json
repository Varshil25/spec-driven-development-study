{
  "task": "T-BOOKMARKS-01",
  "package": "bookmarks",
  "kind": "cli",
  "examples": [
    {"show": "python -m bookmarks --db b.db add https://docs.python.org --title \"Python docs\" --tags python,docs",
     "args": ["--db", "b.db", "add", "https://docs.python.org", "--title", "Python docs", "--tags", "python,docs"],
     "expect": {"exit": 0, "stdout": "1\n"}},
    {"show": "python -m bookmarks --db b.db add https://example.com",
     "args": ["--db", "b.db", "add", "https://example.com"],
     "expect": {"exit": 0, "stdout": "2\n"}},
    {"show": "python -m bookmarks --db b.db list",
     "args": ["--db", "b.db", "list"],
     "expect": {"exit": 0, "stdout": "1\thttps://docs.python.org\tPython docs\tdocs,python\n2\thttps://example.com\t\t\n"}},
    {"show": "python -m bookmarks --db b.db search PYTHON",
     "args": ["--db", "b.db", "search", "PYTHON"],
     "expect": {"exit": 0, "stdout": "1\thttps://docs.python.org\tPython docs\tdocs,python\n"}},
    {"show": "python -m bookmarks --db b.db add ftp://example.com",
     "args": ["--db", "b.db", "add", "ftp://example.com"],
     "expect": {"exit": 2, "stderr_nonempty": true}}
  ]
}
