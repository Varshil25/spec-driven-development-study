{
  "task": "T-REDACT-01-CR",
  "package": "logredact",
  "kind": "cli",
  "includes": ["T-REDACT-01"],
  "files": {"app.log": "user jane@example.com\n", "web.log": "GET / from 10.0.0.7\n"},
  "examples": [
    {"show": "printf 'call +14155552671 now\\n' | python -m logredact",
     "args": [], "stdin": "call +14155552671 now\n",
     "expect": {"exit": 0, "stdout": "call [PHONE] now\n"}},
    {"show": "printf 'a@b.io +442071838750\\n' | python -m logredact --count",
     "args": ["--count"], "stdin": "a@b.io +442071838750\n",
     "expect": {"exit": 0, "stdout": "[EMAIL] [PHONE]\n", "stderr_contains": "emails=1 ips=0 cards=0 phones=1"}},
    {"show": "python -m logredact --out-dir clean app.log web.log",
     "args": ["--out-dir", "clean", "app.log", "web.log"],
     "expect": {"exit": 0, "stdout": "wrote 2 files\n"}}
  ]
}
