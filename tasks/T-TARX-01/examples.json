{
  "task": "T-TARX-01",
  "package": "tarx",
  "kind": "cli",
  "archives": [
    {"name": "photos.tar.gz", "gzip": true,
     "members": [{"name": "photos/a.jpg", "data": "jpeg-a"}, {"name": "photos/b.jpg", "data": "jpeg-b"}]}
  ],
  "examples": [
    {"show": "python -m tarx list photos.tar.gz", "args": ["list", "photos.tar.gz"],
     "expect": {"exit": 0, "stdout": "photos/a.jpg\nphotos/b.jpg\n"}},
    {"show": "python -m tarx extract photos.tar.gz out", "args": ["extract", "photos.tar.gz", "out"],
     "expect": {"exit": 0, "stdout": "extracted 2 files\n"}},
    {"show": "python -m tarx extract photos.tar.gz out   (second time)", "args": ["extract", "photos.tar.gz", "out"],
     "expect": {"exit": 3, "stderr_nonempty": true}}
  ]
}
