{
  "task": "T-LOGIN-01",
  "package": "loginapp",
  "kind": "http",
  "setup": [
    {"show": "printf 'correct-horse-battery\\n' | python -m loginapp adduser alice --users users.json",
     "args": ["adduser", "alice", "--users", "users.json"], "stdin": "correct-horse-battery\n",
     "expect": {"exit": 0, "stdout": "added alice\n"}}
  ],
  "server_args": ["serve", "--port", "{port}", "--users", "users.json"],
  "server_env": {"LOGINAPP_SECRET": "change-me"},
  "ready_line": "listening on 127.0.0.1:{port}",
  "examples": [
    {"show": "curl -s -i -d 'username=alice&password=correct-horse-battery' 127.0.0.1:8000/login",
     "method": "POST", "path": "/login", "body": "username=alice&password=correct-horse-battery",
     "headers": {"Content-Type": "application/x-www-form-urlencoded"},
     "expect": {"status": 303, "location": "/dashboard", "set_cookie": "session"},
     "capture_cookies": ["session"]},
    {"show": "curl -s -b 'session=<the token from Set-Cookie>' 127.0.0.1:8000/dashboard",
     "method": "GET", "path": "/dashboard", "headers": {"Cookie": "session={session}"},
     "expect": {"status": 200, "body_contains": "Welcome, alice"}},
    {"show": "curl -s -o /dev/null -w '%{http_code}\\n' 127.0.0.1:8000/dashboard",
     "method": "GET", "path": "/dashboard", "expect": {"status": 303}},
    {"show": "curl -s -o /dev/null -w '%{http_code}\\n' -d 'username=alice&password=wrong-password-1' 127.0.0.1:8000/login",
     "method": "POST", "path": "/login", "body": "username=alice&password=wrong-password-1",
     "headers": {"Content-Type": "application/x-www-form-urlencoded"},
     "expect": {"status": 401}}
  ]
}
