{
  "task": "T-QNOTES-01",
  "kind": "http",
  "runtime": "quarkus",
  "data_property": "notes.data-dir",
  "examples": [
    {"show": "curl -s -X POST 127.0.0.1:8765/users -H 'Content-Type: application/json' -d '{\"name\": \"alice\"}'",
     "method": "POST", "path": "/users", "body": "{\"name\": \"alice\"}",
     "headers": {"Content-Type": "application/json"},
     "expect": {"status": 201, "json_subset": {"name": "alice"}, "json_keys": ["api_key"]},
     "capture": {"KEY": "api_key"}},
    {"show": "curl -s -X POST 127.0.0.1:8765/notes -H 'X-Api-Key: <KEY>' -H 'Content-Type: application/json' -d '{\"title\": \"Groceries\", \"tags\": [\"home\"]}'",
     "method": "POST", "path": "/notes", "body": "{\"title\": \"Groceries\", \"tags\": [\"home\"]}",
     "headers": {"X-Api-Key": "{KEY}", "Content-Type": "application/json"},
     "expect": {"status": 201,
                "json_subset": {"title": "Groceries", "body": "", "tags": ["home"]},
                "json_keys": ["id", "created_at", "updated_at"]}},
    {"show": "curl -s '127.0.0.1:8765/notes?tag=home' -H 'X-Api-Key: <KEY>'",
     "method": "GET", "path": "/notes?tag=home",
     "headers": {"X-Api-Key": "{KEY}"},
     "expect": {"status": 200, "json_keys": ["notes"], "body_contains": "Groceries"}},
    {"show": "curl -s -o /dev/null -w '%{http_code}\\n' 127.0.0.1:8765/notes",
     "method": "GET", "path": "/notes",
     "expect": {"status": 401}}
  ]
}
