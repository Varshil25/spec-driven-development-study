{
  "task": "T-QCOUNT-01",
  "kind": "http",
  "runtime": "quarkus",
  "data_property": "counters.data-dir",
  "examples": [
    {"show": "curl -s -X POST 127.0.0.1:8765/counters/visits/increment",
     "method": "POST", "path": "/counters/visits/increment",
     "expect": {"status": 200, "json_subset": {"name": "visits", "value": 1}}},
    {"show": "curl -s 127.0.0.1:8765/counters/visits",
     "method": "GET", "path": "/counters/visits",
     "expect": {"status": 200, "json_subset": {"name": "visits", "value": 1}}},
    {"show": "curl -s -o /dev/null -w '%{http_code}\\n' 127.0.0.1:8765/counters/Bad_Name",
     "method": "GET", "path": "/counters/Bad_Name",
     "expect": {"status": 400}}
  ]
}
