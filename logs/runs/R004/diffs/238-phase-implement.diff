index 0000000..2149a73
--- /dev/null
+++ b/src/accounts/validation.py
@@ -0,0 +1,101 @@
+"""Username and password rules, the A-011 resource limits, and output redaction.
+
+This is the lowest boundary in the package: it depends only on ``errors`` and
+on ``re``.  ``cli`` re-exports :func:`sanitize_for_message` so the redaction
+point is reachable as ``cli.sanitize_for_message`` (the name the plan's security
+mapping uses) while ``store`` can redact a username in a malformed-store reason
+without importing ``cli``.
+"""
+
+import re
+
+from accounts.errors import AccountsError
+
+# --- A-011 limits ------------------------------------------------------------
+
+MIN_PASSWORD_CHARS = 12
+MAX_PASSWORD_CHARS = 1024
+MAX_LINE_BYTES = 4096
+MAX_STORE_BYTES = 8388608
+MAX_ACCOUNTS = 10000
+STORE_VERSION = 1
+USERNAME_MIN = 3
+USERNAME_MAX = 32
+
+# FR-016: an account is locked once this many consecutive login failures are
+# recorded.  Lock state is derived from the count, never stored (research R7).
+MAX_FAILED_LOGINS = 5
+
+# SR-002/SR-009: an echoed username is rendered printable and bounded.
+MESSAGE_ECHO_CHARS = 64
+
+USERNAME_PATTERN = re.compile(r"[A-Za-z0-9_]{%d,%d}" % (USERNAME_MIN, USERNAME_MAX))
+
+
+def sanitize_for_message(text):
+    """Render ``text`` as printable ASCII, escaping everything else as ``\\xNN``.
+
+    Applied to any username echoed into a message so that no control character
+    or terminal escape taken from input reaches a stream (SR-002), and so that
+    the message length is bounded (SR-009).  The store path is deliberately
+    exempt and echoed verbatim: SR-009 exempts the operator's own argument.
+    """
+    rendered = []
+    for byte in text.encode("utf-8", "surrogateescape"):
+        if 0x20 <= byte <= 0x7E:
+            rendered.append(chr(byte))
+        else:
+            rendered.append("\\x%02x" % byte)
+    return "".join(rendered)[:MESSAGE_ECHO_CHARS]
+
+
+def is_username(name):
+    """Whether ``name`` satisfies FR-011 exactly and case-sensitively."""
+    return USERNAME_PATTERN.fullmatch(name) is not None
+
+
+def validate_username(name):
+    """Accept only 3-32 characters of letters, digits or underscore (FR-011)."""
+    length = len(name)
+    if not USERNAME_MIN <= length <= USERNAME_MAX:
+        raise AccountsError(
+            2,
+            "error: invalid username '%s': expected %d-%d characters of letters,"
+            " digits or underscore, received %d characters"
+            % (
+                sanitize_for_message(name),
+                USERNAME_MIN,
+                USERNAME_MAX,
+                length,
+            ),
+        )
+    if not is_username(name):
+        raise AccountsError(
+            2,
+            "error: invalid username '%s': expected only letters, digits or"
+            " underscore" % sanitize_for_message(name),
+        )
+    return name
+
+
+def check_settable_password(password):
+    """Accept only 12-1024 characters, counted after UTF-8 decoding (FR-012).
+
+    Used only where a password is being *set*.  A password being *verified* is
+    not range-checked: a mismatch is a credential failure, not a request error.
+    Never truncates (FR-014).
+    """
+    length = len(password)
+    if length < MIN_PASSWORD_CHARS:
+        raise AccountsError(
+            2,
+            "error: new password too short: expected at least %d characters,"
+            " received %d" % (MIN_PASSWORD_CHARS, length),
+        )
+    if length > MAX_PASSWORD_CHARS:
+        raise AccountsError(
+            2,
+            "error: new password too long: expected at most %d characters,"
+            " received %d" % (MAX_PASSWORD_CHARS, length),
+        )
+    return password
