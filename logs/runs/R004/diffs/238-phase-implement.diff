new file mode 100644
index 0000000..d2602d0
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,162 @@
+"""Shared fixtures for the account-manager suite.
+
+The suite drives the real executable in a subprocess with piped streams, so the
+assertions are against the operator-visible contract of
+``specs/001-user-accounts-cli/contracts/cli-contract.md`` rather than against
+internal function returns.
+
+Every password literal the suite uses is defined **here and only here**
+(Constitution "Secrets hygiene"); other modules import the names.  All of them
+are synthetic strings that have never been anybody's credential, and
+``test_security.py::test_sr004_no_plaintext_in_repo_fixtures`` asserts that each
+literal occurs nowhere in the delivered tree except in this file.
+"""
+
+import base64
+import json
+import os
+import pathlib
+import subprocess
+import sys
+
+import pytest
+
+REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
+SRC = REPO_ROOT / "src"
+
+# --- synthetic passwords (never real credential material) --------------------
+
+PASSWORD=[REDACTED:assigned_secret]
+OTHER_PASSWORD = "harbor-mellow-quartz"
+WRONG_PASSWORD = "thistle-amber-drift"
+NEW_PASSWORD = "cobalt-meadow-stencil"
+SHORT_PASSWORD = "elevenchars"  # 11 characters: one under the minimum
+MIN_PASSWORD = "twelvecharss"  # exactly 12 characters
+# A base for the timing tests, which need to vary one known character position.
+TIMING_PASSWORD = "abcdefghijklmnop"
+
+# --- synthetic stored material (never a real derivation) ---------------------
+
+SYNTHETIC_SALT_BYTES = b"synthetic-salt16"  # exactly 16 bytes
+SYNTHETIC_HASH_BYTES = b"synthetic-digest" * 2  # exactly 32 bytes
+SYNTHETIC_SALT = base64.b64encode(SYNTHETIC_SALT_BYTES).decode("ascii")
+SYNTHETIC_HASH = base64.b64encode(SYNTHETIC_HASH_BYTES).decode("ascii")
+
+
+def child_env():
+    """Environment for the tool under test: ``src/`` on PYTHONPATH, no install."""
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+    env.pop("PYTHONWARNINGS", None)
+    return env
+
+
+def command(args):
+    """The argv vector that runs the real executable."""
+    return [sys.executable, "-m", "accounts", *[str(a) for a in args]]
+
+
+def invoke(args, stdin=None, timeout=120):
+    """Run the tool once and return ``(status, stdout, stderr)``.
+
+    ``stdin`` may be ``str`` (text mode), ``bytes`` (binary mode, for input that
+    is deliberately not valid UTF-8) or ``None`` (stdin closed, ``/dev/null``).
+    """
+    if stdin is None:
+        completed = subprocess.run(
+            command(args),
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            env=child_env(),
+            timeout=timeout,
+        )
+        return completed.returncode, completed.stdout, completed.stderr
+    if isinstance(stdin, bytes):
+        completed = subprocess.run(
+            command(args),
+            input=stdin,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            env=child_env(),
+            timeout=timeout,
+        )
+        return (
+            completed.returncode,
+            completed.stdout.decode("utf-8", "surrogateescape"),
+            completed.stderr.decode("utf-8", "surrogateescape"),
+        )
+    completed = subprocess.run(
+        command(args),
+        input=stdin,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        env=child_env(),
+        timeout=timeout,
+    )
+    return completed.returncode, completed.stdout, completed.stderr
+
+
+def lines(*passwords):
+    """Build a stdin payload of one password per line."""
+    return "".join(p + "\n" for p in passwords)
+
+
+def synthetic_record(**overrides):
+    """A structurally valid record built from synthetic material only."""
+    record = {
+        "kdf": "scrypt",
+        "n": 131072,
+        "r": 8,
+        "p": 1,
+        "dklen": 32,
+        "salt": SYNTHETIC_SALT,
+        "hash": SYNTHETIC_HASH,
+        "failed_logins": 0,
+    }
+    record.update(overrides)
+    return record
+
+
+def write_store(path, accounts, version=1, mode=0o600):
+    """Write a store document verbatim, byte-deterministically."""
+    document = {"version": version, "accounts": accounts}
+    raw = json.dumps(
+        document, ensure_ascii=True, sort_keys=True, separators=(",", ":")
+    ) + "\n"
+    pathlib.Path(path).write_text(raw, encoding="utf-8")
+    os.chmod(path, mode)
+    return path
+
+
+def read_store(path):
+    """Parse a store file the tool wrote."""
+    return json.loads(pathlib.Path(path).read_text(encoding="utf-8"))
+
+
+def failed_logins(path, username):
+    """The recorded consecutive-failure count for one account."""
+    return read_store(path)["accounts"][username]["failed_logins"]
+
+
+# --- fixtures ----------------------------------------------------------------
+
+
+@pytest.fixture
+def store_path(tmp_path):
+    """A path in a private directory at which no store file exists yet."""
+    return tmp_path / "accounts.store"
+
+
+@pytest.fixture
+def run():
+    """Subprocess runner for the real executable; returns (status, out, err)."""
+    return invoke
+
+
+@pytest.fixture
+def build_store():
+    """Writer for a syntactically valid store made of synthetic values only."""
+    return write_store
diff --git a/tests/test_cli_contract.py b/tests/test_cli_contract.py
new file mode 100644
index 0000000..ecd69dc
--- /dev/null
+++ b/tests/test_cli_contract.py
@@ -0,0 +1,346 @@
+"""The cross-command interface: invocation, stdin protocol, statuses, streams.
+
+FR-001 … FR-005 plus SR-001's command allow-list and the check order of
+research R6.
+"""
+
+from conftest import (
+    NEW_PASSWORD,
+    OTHER_PASSWORD,
+    PASSWORD,
+    SHORT_PASSWORD,
+    WRONG_PASSWORD,
+    failed_logins,
+    lines,
+    read_store,
+    write_store,
+)
+
+USAGE = (
+    "usage: python -m accounts --store PATH"
+    " {register|login|unlock|passwd|delete} USERNAME\n"
+)
+COMMANDS = ("register", "login", "unlock", "passwd", "delete")
+
+
+def _register(run, store_path, username="alice", password=[REDACTED:assigned_secret]):
+    assert run(["--store", store_path, "register", username], lines(password))[0] == 0
+
+
+def _lock(run, store_path, username="alice"):
+    """Drive an account to the locked state from whatever count it holds."""
+    assert run(["--store", store_path, "unlock", username], None)[0] == 0
+    for _ in range(5):
+        assert run(
+            ["--store", store_path, "login", username], lines(WRONG_PASSWORD)
+        )[0] == 1
+
+
+def test_fr001_invocation_form(run, store_path):
+    """Exactly `--store PATH COMMAND USERNAME`, no abbreviation and no help."""
+    _register(run, store_path)
+
+    # The documented form, and argparse's standard `--store=PATH` equivalent.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+    assert run(["--store=%s" % store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+    shape_errors = (
+        [],
+        ["--store", store_path],
+        ["--store", store_path, "login"],
+        ["login", "alice"],
+        ["--store", store_path, "login", "alice", "spare"],
+        ["--store", store_path, "login", "alice", "--store", store_path],
+    )
+    for argv in shape_errors:
+        status, out, err = run(argv, lines(PASSWORD))
+        assert status == 2, (argv, status, err)
+        assert out == ""
+        assert err == USAGE, (argv, err)
+
+    # Option abbreviation is not accepted, and there is no help path: nothing
+    # may exit 0 without performing an operation (FR-003).
+    for argv in (
+        ["--sto", store_path, "login", "alice"],
+        ["-h"],
+        ["--help"],
+        ["--store", store_path, "login", "alice", "-h"],
+    ):
+        status, out, err = run(argv, lines(PASSWORD))
+        assert status == 2, (argv, status, err)
+        assert out == ""
+        assert err.count("\n") == 1 and err != ""
+
+
+def test_fr001_five_commands_accepted(run, store_path):
+    """All five operations of FR-001 are accepted and nothing else is."""
+    _register(run, store_path)
+    accepted = {
+        "login": (lines(PASSWORD), 0),
+        "unlock": (None, 0),
+        "passwd": (lines(PASSWORD, NEW_PASSWORD), 0),
+        "delete": (lines(NEW_PASSWORD), 0),
+    }
+    for command, (stdin, expected) in accepted.items():
+        status, out, err = run(["--store", store_path, command, "alice"], stdin)
+        assert status == expected, (command, status, err)
+    # `register` round-trips the lifecycle back to the start.
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+
+
+def test_sr001_unknown_command_rejected(run, store_path):
+    """The command name is checked against an allow-list of exactly five (SR-001)."""
+    for name in ("frobnicate", "REGISTER", "logins", "log in", "", "--register"):
+        status, out, err = run(["--store", store_path, name, "alice"], lines(PASSWORD))
+        assert status == 2, (name, status, err)
+        assert out == ""
+        assert err.count("\n") == 1
+        assert not store_path.exists()
+
+
+def test_fr002_stdin_protocol_per_command(run, store_path):
+    """Each command reads exactly the documented number of lines (FR-002)."""
+    expected_lines = {"register": 1, "login": 1, "unlock": 0, "passwd": 2, "delete": 1}
+
+    # Too few lines is a status-2 request error naming both counts (A-010).
+    _register(run, store_path)
+    for command, needed in expected_lines.items():
+        if needed == 0:
+            continue
+        status, out, err = run(["--store", store_path, command, "alice"], None)
+        assert status == 2, (command, status, err)
+        assert out == ""
+        assert err == (
+            "error: missing password input: expected %d password line(s) on"
+            " stdin, received 0\n" % needed
+        ), (command, err)
+
+    # `passwd` needs a second line and says which it was waiting for.
+    status, out, err = run(["--store", store_path, "passwd", "alice"], lines(PASSWORD))
+    assert status == 2
+    assert err == (
+        "error: missing password input: expected 2 password line(s) on stdin,"
+        " received 1\n"
+    )
+
+    # `unlock` reads zero lines and works with stdin closed (A-006).
+    assert run(["--store", store_path, "unlock", "alice"], None) == (0, "", "")
+
+    # Surplus lines are never read and are not an error.
+    assert run(
+        ["--store", store_path, "login", "alice"], lines(PASSWORD, "spare", "spare")
+    )[0] == 0
+    assert run(
+        ["--store", store_path, "passwd", "alice"],
+        lines(PASSWORD, NEW_PASSWORD, "spare"),
+    )[0] == 0
+
+    # The order within `passwd` is current password first, then the new one.
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    )[0] == 1
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(NEW_PASSWORD, PASSWORD)
+    )[0] == 0
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+
+def test_fr003_every_status_reachable(run, store_path, tmp_path):
+    """Each of the six documented statuses is reachable for its stated condition."""
+    malformed = tmp_path / "malformed.store"
+    malformed.write_text("not json at all", encoding="utf-8")
+
+    _register(run, store_path)
+    reached = {}
+
+    reached[0] = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+    reached[1] = run(["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD))
+    reached[2] = run(["--store", store_path, "register", "ab"], lines(PASSWORD))
+    reached[3] = run(["--store", store_path, "register", "alice"], lines(PASSWORD))
+    _lock(run, store_path)
+    reached[4] = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+    reached[5] = run(["--store", malformed, "login", "alice"], lines(PASSWORD))
+
+    for expected, (status, out, err) in reached.items():
+        assert status == expected, (expected, status, out, err)
+    assert sorted(reached) == [0, 1, 2, 3, 4, 5]
+
+
+def test_fr003_no_other_status_observed(run, store_path, tmp_path):
+    """No invocation ever exits with a status outside the documented six."""
+    malformed = tmp_path / "malformed.store"
+    malformed.write_text('{"version":1,"accounts":{"alice":{}}}', encoding="utf-8")
+    oversized_name = "n" * 200
+    _register(run, store_path)
+
+    cases = (
+        ([], None),
+        (["--store", store_path], None),
+        (["--store", store_path, "nope", "alice"], None),
+        (["--store", store_path, "register", oversized_name], lines(PASSWORD)),
+        (["--store", store_path, "register", "alice"], lines(PASSWORD)),
+        (["--store", store_path, "register", "bob_42"], lines(SHORT_PASSWORD)),
+        (["--store", store_path, "login", "alice"], lines(PASSWORD)),
+        (["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD)),
+        (["--store", store_path, "login", "alice"], b"\xc3\x28 bad utf8\n"),
+        (["--store", store_path, "login", "alice"], "x" * 5000 + "\n"),
+        (["--store", store_path, "unlock", "alice"], None),
+        (["--store", store_path, "unlock", "nobody_here"], None),
+        (["--store", store_path, "passwd", "alice"], lines(PASSWORD, SHORT_PASSWORD)),
+        (["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)),
+        (["--store", store_path, "delete", "alice"], lines(WRONG_PASSWORD)),
+        (["--store", store_path, "delete", "alice"], lines(NEW_PASSWORD)),
+        (["--store", malformed, "login", "alice"], lines(PASSWORD)),
+        (["--store", tmp_path, "login", "alice"], lines(PASSWORD)),
+    )
+    for argv, stdin in cases:
+        status, out, err = run(argv, stdin)
+        assert status in (0, 1, 2, 3, 4, 5), (argv, status, out, err)
+
+
+def test_fr004_success_output_per_command(run, store_path):
+    """Only the documented success text on stdout, and a silent stderr (FR-004)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD)) == (
+        0,
+        "registered alice\n",
+        "",
+    )
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
+    assert run(["--store", store_path, "unlock", "alice"], None) == (0, "", "")
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    ) == (0, "", "")
+    assert run(["--store", store_path, "delete", "alice"], lines(NEW_PASSWORD)) == (
+        0,
+        "",
+        "",
+    )
+
+
+def test_fr005_failure_streams(run, store_path, tmp_path):
+    """Every failure writes one stderr line and leaves stdout empty (FR-005)."""
+    malformed = tmp_path / "malformed.store"
+    malformed.write_text("{", encoding="utf-8")
+    _register(run, store_path)
+    _lock(run, store_path)
+
+    cases = (
+        ([], None),
+        (["--store", store_path, "nope", "alice"], None),
+        (["--store", store_path, "register", "ab"], lines(PASSWORD)),
+        (["--store", store_path, "register", "bob_42"], lines(SHORT_PASSWORD)),
+        (["--store", store_path, "register", "alice"], lines(PASSWORD)),
+        (["--store", store_path, "login", "alice"], lines(PASSWORD)),
+        (["--store", store_path, "login", "nobody_here"], lines(PASSWORD)),
+        (["--store", store_path, "unlock", "nobody_here"], None),
+        (["--store", store_path, "passwd", "alice"], lines(WRONG_PASSWORD, NEW_PASSWORD)),
+        (["--store", store_path, "delete", "nobody_here"], lines(PASSWORD)),
+        (["--store", malformed, "login", "alice"], lines(PASSWORD)),
+    )
+    for argv, stdin in cases:
+        status, out, err = run(argv, stdin)
+        assert status != 0, (argv, status)
+        assert out == "", (argv, out)
+        assert err.endswith("\n") and err.count("\n") == 1, (argv, err)
+        assert err.strip() != "", argv
+
+
+def test_fr005_exact_fixed_messages(run, store_path):
+    """`invalid credentials` and `account locked` are byte-exact and detail-free."""
+    _register(run, store_path)
+
+    rejections = (
+        (["login", "alice"], lines(WRONG_PASSWORD)),
+        (["login", "nobody_here"], lines(PASSWORD)),
+        (["passwd", "alice"], lines(WRONG_PASSWORD, NEW_PASSWORD)),
+        (["delete", "alice"], lines(WRONG_PASSWORD)),
+    )
+    for argv, stdin in rejections:
+        status, out, err = run(["--store", store_path, *argv], stdin)
+        assert (status, out, err) == (1, "", "invalid credentials\n"), argv
+
+    _lock(run, store_path)
+    for password in (PASSWORD, WRONG_PASSWORD):
+        status, out, err = run(["--store", store_path, "login", "alice"], lines(password))
+        assert (status, out, err) == (4, "", "account locked\n")
+
+
+def test_r6_check_order_precedence(run, store_path, tmp_path):
+    """The ten-step check order of research R6, both asymmetries included."""
+    malformed = tmp_path / "malformed.store"
+    malformed.write_text("not json at all", encoding="utf-8")
+    malformed_before = malformed.read_bytes()
+
+    # 1 before 2: argument shape outranks an invalid username.
+    status, _, err = run(["--store", malformed, "nope", "ab"], None)
+    assert (status, err.count("\n")) == (2, 1)
+    assert "invalid username" not in err
+
+    # 2 before 3: an invalid username outranks missing password input.
+    status, _, err = run(["--store", store_path, "register", "ab"], None)
+    assert status == 2
+    assert err.startswith("error: invalid username ")
+
+    # 2 before 5: an invalid username is refused before the store is read, so
+    # it can never create or report on a store.
+    status, _, err = run(["--store", malformed, "login", "ab"], lines(PASSWORD))
+    assert status == 2
+    assert err.startswith("error: invalid username ")
+    assert not store_path.exists()
+
+    # 3 before 5: missing password input outranks a malformed store.
+    status, _, err = run(["--store", malformed, "login", "alice"], None)
+    assert status == 2
+    assert err.startswith("error: missing password input")
+
+    # 4 before 5 and 6, for `register` only: the new password's length is
+    # checked before the store is read (scenario 1.6).
+    status, _, err = run(["--store", malformed, "register", "alice"], lines(SHORT_PASSWORD))
+    assert status == 2
+    assert err.startswith("error: new password too short")
+    assert malformed.read_bytes() == malformed_before
+
+    # 5 before 6: the store is validated before account existence is decided.
+    status, _, err = run(["--store", malformed, "unlock", "nobody_here"], None)
+    assert status == 5
+    assert "is malformed" in err
+
+    # 6 before 7 and 8: existence outranks both the lock and the password.
+    status, _, err = run(["--store", store_path, "passwd", "nobody_here"], lines(PASSWORD, SHORT_PASSWORD))
+    assert status == 3
+    assert err == "error: no such account 'nobody_here'\n"
+
+    _register(run, store_path)
+    _lock(run, store_path)
+
+    # 7 before 8: `login` reports the lock before considering the password.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        4, "", "account locked\n",
+    )
+    assert failed_logins(store_path, "alice") == 5
+
+    # Asymmetry one: `passwd` and `delete` skip step 7 entirely (FR-019).
+    assert run(["--store", store_path, "delete", "alice"], lines(WRONG_PASSWORD)) == (
+        1, "", "invalid credentials\n",
+    )
+
+    # Asymmetry two: `passwd` authenticates (step 8) before it validates the
+    # new password (step 9) — scenario 3.2.
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(WRONG_PASSWORD, SHORT_PASSWORD)
+    ) == (1, "", "invalid credentials\n")
+    status, _, err = run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, SHORT_PASSWORD)
+    )
+    assert status == 2
+    assert err.startswith("error: new password too short")
+
+    # 10: with every check passed, the operation applies and saves.
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    ) == (0, "", "")
+    assert failed_logins(store_path, "alice") == 0
diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..94b5f75
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,88 @@
+"""SR-007 under interleaving: the lockout cannot be dodged, no account is lost.
+
+Quickstart V9.  Marked ``slow``: each child spends a deliberate KDF derivation
+and they serialise on the store directory's exclusive lock, by design.
+"""
+
+import subprocess
+
+import pytest
+
+from conftest import (
+    PASSWORD,
+    WRONG_PASSWORD,
+    child_env,
+    command,
+    failed_logins,
+    lines,
+    read_store,
+)
+
+
+def _launch(args, stdin):
+    """Start one invocation without waiting for it."""
+    child = subprocess.Popen(
+        command(args),
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        env=child_env(),
+    )
+    return child
+
+
+def _drain(children, timeout=300):
+    """Collect every child's (status, stdout, stderr)."""
+    results = []
+    for child, payload in children:
+        out, err = child.communicate(input=payload, timeout=timeout)
+        results.append((child.returncode, out, err))
+    return results
+
+
+@pytest.mark.slow
+def test_sr007_concurrent_failures_cannot_exceed_five(run, store_path):
+    """Twenty simultaneous wrong guesses still lock the account at exactly five."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+
+    children = [
+        (_launch(["--store", store_path, "login", "alice"], None), lines(WRONG_PASSWORD))
+        for _ in range(20)
+    ]
+    results = _drain(children)
+
+    statuses = sorted(status for status, _, _ in results)
+    assert set(statuses) <= {1, 4}, statuses
+    # The first five attempts to reach the lock are rejections; every later one
+    # sees the lock.  No interleaving may produce a success.
+    assert statuses.count(1) == 5, statuses
+    assert statuses.count(4) == 15, statuses
+    for status, out, err in results:
+        assert out == ""
+        assert err in ("invalid credentials\n", "account locked\n")
+
+    # No failure-count increment was lost to an interleaving.
+    assert failed_logins(store_path, "alice") == 5
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+    assert (status, out, err) == (4, "", "account locked\n")
+
+
+@pytest.mark.slow
+def test_sr007_concurrent_registers_do_not_lose_an_account(store_path):
+    """Simultaneous first-registrations against a non-existent store all survive."""
+    assert not store_path.exists()
+    names = ["user_%02d" % i for i in range(8)]
+    children = [
+        (_launch(["--store", store_path, "register", name], None), lines(PASSWORD))
+        for name in names
+    ]
+    results = _drain(children)
+
+    assert [status for status, _, _ in results] == [0] * len(names)
+    for (status, out, err), name in zip(results, names):
+        assert out == "registered %s\n" % name
+        assert err == ""
+
+    assert sorted(read_store(store_path)["accounts"]) == sorted(names)
+    assert store_path.stat().st_mode & 0o777 == 0o600
diff --git a/tests/test_crash_safety.py b/tests/test_crash_safety.py
new file mode 100644
index 0000000..db66099
--- /dev/null
+++ b/tests/test_crash_safety.py
@@ -0,0 +1,143 @@
+"""Killing the tool mid-change leaves a store that still parses and verifies.
+
+FR-009, SC-009, quickstart V8.  Marked ``slow``: each trial pays a deliberate
+KDF derivation before the write it is trying to interrupt.
+
+The write it interrupts is the one ``passwd`` performs, which is the longest
+and the only one that replaces credential material, so it is the case where a
+partial write would do the most damage.
+"""
+
+import json
+import random
+import signal
+import subprocess
+
+import pytest
+
+from conftest import (
+    NEW_PASSWORD,
+    PASSWORD,
+    child_env,
+    command,
+    lines,
+    read_store,
+)
+
+TRIALS = 10
+
+
+def _store_is_intact(store_path, expected_accounts):
+    """The store parses and still holds exactly the accounts it held before."""
+    raw = store_path.read_bytes()
+    assert raw != b"", "the store was left empty"
+    document = json.loads(raw.decode("utf-8"))
+    assert sorted(document["accounts"]) == sorted(expected_accounts)
+    assert document["version"] == 1
+    return document
+
+
+def _kill_during_passwd(store_path, username, current, replacement, delay):
+    """Start a `passwd` and SIGKILL it after ``delay`` seconds."""
+    child = subprocess.Popen(
+        command(["--store", store_path, "passwd", username]),
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        env=child_env(),
+    )
+    child.stdin.write(lines(current, replacement))
+    child.stdin.flush()
+    child.stdin.close()
+    try:
+        child.wait(timeout=delay)
+    except subprocess.TimeoutExpired:
+        child.kill()
+        child.wait(timeout=60)
+    child.stdout.close()
+    child.stderr.close()
+    return child.returncode
+
+
+@pytest.mark.slow
+def test_sc009_sigkill_loop_store_always_valid(run, store_path):
+    """After every kill the store still parses and still verifies its accounts."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    assert run(["--store", store_path, "register", "bob_42"], lines(PASSWORD))[0] == 0
+    accounts = ["alice", "bob_42"]
+
+    generator = random.Random(20261104)
+    current = PASSWORD
+    landed = 0
+    for trial in range(TRIALS):
+        # A delay spanning the command's whole lifetime, so the kill lands
+        # before, during and after the write across the run of trials.  A
+        # sub-millisecond delay would always land in interpreter startup and
+        # could never reach the write this test exists to interrupt.
+        delay = generator.uniform(0.0, 1.2)
+        _kill_during_passwd(store_path, "alice", current, NEW_PASSWORD, delay)
+
+        _store_is_intact(store_path, accounts)
+        # Fully old or fully new, never a mixture: one of the two passwords
+        # verifies, and `bob_42` is untouched either way.
+        old = run(["--store", store_path, "login", "alice"], lines(current))[0]
+        new = run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0]
+        assert {old, new} in ({0, 1}, {0}), (trial, old, new)
+        assert run(["--store", store_path, "login", "bob_42"], lines(PASSWORD)) == (
+            0,
+            "ok\n",
+            "",
+        )
+
+        if new == 0:
+            # The change went through; rotate back so the next trial has work.
+            landed += 1
+            current = NEW_PASSWORD
+            assert run(
+                ["--store", store_path, "passwd", "alice"], lines(current, PASSWORD)
+            )[0] == 0
+            current = PASSWORD
+        # `login` resets or increments the failure count; clear it so a trial
+        # cannot lock the account out from under the next one.
+        assert run(["--store", store_path, "unlock", "alice"], None)[0] == 0
+
+    # The trials must actually have reached the write, or the loop proved
+    # nothing about interrupting one.
+    assert 0 < landed < TRIALS, landed
+
+
+@pytest.mark.slow
+def test_fr009_store_old_or_new_never_mixed(run, store_path):
+    """A killed change is visible all at once or not at all (FR-009, V8)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    before = read_store(store_path)["accounts"]["alice"]
+
+    generator = random.Random(1104)
+    landed = 0
+    for trial in range(TRIALS):
+        delay = generator.uniform(0.0, 1.2)
+        _kill_during_passwd(store_path, "alice", PASSWORD, NEW_PASSWORD, delay)
+
+        document = _store_is_intact(store_path, ["alice"])
+        record = document["accounts"]["alice"]
+        assert sorted(record) == sorted(before), (trial, record)
+        # Either the whole old record or a wholly new one — never the old salt
+        # paired with the new digest, nor the reverse.
+        same_salt = record["salt"] == before["salt"]
+        same_hash = record["hash"] == before["hash"]
+        assert same_salt == same_hash, (trial, same_salt, same_hash)
+
+        if not same_hash:
+            # Reset to the starting material for the next trial.
+            landed += 1
+            assert run(
+                ["--store", store_path, "passwd", "alice"], lines(NEW_PASSWORD, PASSWORD)
+            )[0] == 0
+            before = read_store(store_path)["accounts"]["alice"]
+
+        # No leftover temporary file from an interrupted write (SR-003).
+        present = sorted(p.name for p in store_path.parent.iterdir())
+        assert present == [store_path.name], (trial, present)
+
+    assert 0 < landed < TRIALS, landed
