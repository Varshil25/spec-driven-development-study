+"""The store as a contract: creation, round-trip, permissions, limits, atomicity.
+
+FR-006, FR-007, FR-008, SR-003, SR-006, SR-008, SC-002, SC-008, SC-010.
+"""
+
+import os
+
+import pytest
+
+from conftest import (
+    NEW_PASSWORD,
+    OTHER_PASSWORD,
+    PASSWORD,
+    WRONG_PASSWORD,
+    failed_logins,
+    lines,
+    read_store,
+    synthetic_record,
+    write_store,
+)
+
+
+def test_fr007_register_creates_store(run, store_path):
+    """Only `register` brings the store into existence (FR-007)."""
+    assert not store_path.exists()
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD)) == (
+        0,
+        "registered alice\n",
+        "",
+    )
+    assert store_path.is_file()
+
+
+def test_fr007_other_commands_create_nothing(run, tmp_path):
+    """`login`/`unlock`/`passwd`/`delete` leave no file behind at all (FR-007)."""
+    expected = {
+        "login": 1,
+        "unlock": 3,
+        "passwd": 3,
+        "delete": 3,
+    }
+    for command, status in expected.items():
+        directory = tmp_path / command
+        directory.mkdir()
+        absent = directory / "absent.store"
+        stdin = None if command == "unlock" else lines(PASSWORD, PASSWORD)
+        got, out, err = run(["--store", absent, command, "alice"], stdin)
+        assert got == status, (command, out, err)
+        assert out == ""
+        assert err != ""
+        # Not the store, and not a temporary or lock file either (SR-003).
+        assert list(directory.iterdir()) == [], (command, list(directory.iterdir()))
+
+
+def test_fr008_round_trip_across_invocations(run, store_path):
+    """An account written by one invocation verifies in later ones (FR-008, SC-002)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    assert run(["--store", store_path, "register", "bob_42"], lines(OTHER_PASSWORD))[0] == 0
+
+    for _ in range(3):
+        assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+        assert run(["--store", store_path, "login", "bob_42"], lines(OTHER_PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "alice"], lines(OTHER_PASSWORD)) == (
+        1,
+        "",
+        "invalid credentials\n",
+    )
+
+
+def test_sr008_store_mode_600_on_create(run, store_path):
+    """A newly created store is readable and writable by its owner only (SC-010)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    assert store_path.stat().st_mode & 0o777 == 0o600
+
+
+def test_sr003_temp_file_in_store_directory_only(monkeypatch, store_path, tmp_path):
+    """The temporary file lives in the store's own directory and never survives.
+
+    Where a requirement is about an internal discipline rather than about
+    operator-visible behaviour, the check is in-process: ``pytest.ini`` puts
+    ``src`` on the path, so the real module under test is imported directly.
+    """
+    from accounts import store as store_module
+
+    created = []
+    real_open = os.open
+
+    def recording_open(path, flags, *rest):
+        if isinstance(path, str) and path.endswith(".tmp"):
+            created.append(path)
+        return real_open(path, flags, *rest)
+
+    monkeypatch.setattr(os, "open", recording_open)
+    store_module.atomic_write(
+        str(store_path), store_module.serialise({"version": 1, "accounts": {}})
+    )
+    monkeypatch.undo()
+
+    assert len(created) == 1
+    assert os.path.dirname(created[0]) == os.path.dirname(
+        os.path.realpath(str(store_path))
+    )
+    assert not os.path.exists(created[0])
+    assert sorted(p.name for p in tmp_path.iterdir()) == [store_path.name]
+
+
+@pytest.mark.slow
+def test_sr006_account_count_cap(run, store_path, build_store):
+    """10 000 accounts load; 10 001 is status 5; a register past the cap is 5."""
+    at_cap = {"u%06d" % i: synthetic_record() for i in range(10000)}
+    build_store(store_path, at_cap)
+    # At the cap the store still loads, so the refusal below is the cap and not
+    # a parse failure.
+    status, out, err = run(["--store", store_path, "login", "u000001"], lines(PASSWORD))
+    assert status == 1, err
+    assert err == "invalid credentials\n"
+
+    status, out, err = run(["--store", store_path, "register", "brand_new"], lines(PASSWORD))
+    assert status == 5
+    assert out == ""
+    assert err == (
+        "error: store '%s' is full: expected at most 10000 accounts,"
+        " cannot add another\n" % store_path
+    )
+    assert len(read_store(store_path)["accounts"]) == 10000
+
+    over_cap = dict(at_cap, u999999=synthetic_record())
+    build_store(store_path, over_cap)
+    status, out, err = run(["--store", store_path, "login", "u000001"], lines(PASSWORD))
+    assert status == 5
+    assert out == ""
+    assert err == (
+        "error: store '%s' holds too many accounts: expected at most 10000,"
+        " received 10001\n" % store_path
+    )
+
+
+def test_sc008_only_exception_is_login_failure_count(run, store_path):
+    """A failed `login` is the only failing command that writes, and only the count."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+
+    failing = (
+        (["register", "alice"], lines(OTHER_PASSWORD), 3),
+        (["register", "ab"], lines(PASSWORD), 2),
+        (["register", "bob_42"], lines("short"), 2),
+        (["login", "alice"], None, 2),
+        (["login", "nobody_here"], lines(PASSWORD), 1),
+        (["unlock", "nobody_here"], None, 3),
+        (["passwd", "nobody_here"], lines(PASSWORD, NEW_PASSWORD), 3),
+        (["passwd", "alice"], lines(WRONG_PASSWORD, NEW_PASSWORD), 1),
+        (["passwd", "alice"], lines(PASSWORD, "short"), 2),
+        (["delete", "nobody_here"], lines(PASSWORD), 3),
+        (["delete", "alice"], lines(WRONG_PASSWORD), 1),
+    )
+    for argv, stdin, expected in failing:
+        before = store_path.read_bytes()
+        status, out, err = run(["--store", store_path, *argv], stdin)
+        assert status == expected, (argv, status, err)
+        assert store_path.read_bytes() == before, argv
+
+    # The single documented exception: a failed `login` against an account that
+    # exists writes, and changes nothing but `failed_logins` (FR-006, SC-008).
+    before = read_store(store_path)
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD))
+    assert (status, out, err) == (1, "", "invalid credentials\n")
+    after = read_store(store_path)
+
+    assert failed_logins(store_path, "alice") == before["accounts"]["alice"]["failed_logins"] + 1
+    before["accounts"]["alice"]["failed_logins"] = after["accounts"]["alice"]["failed_logins"]
+    assert before == after
+
+
+def test_sr008_store_mode_600_after_passwd_replace(run, store_path):
+    """The store cannot inherit a wider mode across the `os.replace` (SR-008)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    assert store_path.stat().st_mode & 0o777 == 0o600
+
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    )[0] == 0
+    assert store_path.stat().st_mode & 0o777 == 0o600
+
+    # And after every other writing command, too.
+    assert run(["--store", store_path, "unlock", "alice"], None)[0] == 0
+    assert store_path.stat().st_mode & 0o777 == 0o600
+    assert run(["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD))[0] == 1
+    assert store_path.stat().st_mode & 0o777 == 0o600
+    assert run(["--store", store_path, "delete", "alice"], lines(NEW_PASSWORD))[0] == 0
+    assert store_path.stat().st_mode & 0o777 == 0o600
+
+
+def test_fr006_store_byte_identical_after_each_failure(run, store_path, tmp_path):
+    """Every failure case of every command leaves the store bytes as they were.
