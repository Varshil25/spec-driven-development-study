index 0000000..143d486
--- /dev/null
+++ b/src/accounts/cli.py
@@ -0,0 +1,262 @@
+"""The request boundary: argv, stdin, the five commands, statuses and messages.
+
+``main`` is the only place in the package that writes to a stream or decides an
+exit status.  Every boundary below it refuses work by raising
+``AccountsError``, so there is exactly one path from a failure to the operator
+and no way for a traceback or an undocumented status to escape (FR-003, FR-005,
+SR-009).
+
+The order in which a command applies its checks is fixed by research R6 and is
+deliberately asymmetric in two places: ``login`` reports a lock *before* it
+considers the password, and ``passwd`` authenticates *before* it validates the
+new password.  Both asymmetries come from the spec's own acceptance scenarios.
+"""
+
+import argparse
+import sys
+
+from accounts import crypto, store, validation
+from accounts.errors import AccountsError
+from accounts.validation import sanitize_for_message
+
+COMMANDS = ("register", "login", "unlock", "passwd", "delete")
+
+USAGE = (
+    "usage: python -m accounts --store PATH"
+    " {register|login|unlock|passwd|delete} USERNAME"
+)
+
+# Password lines each command reads from stdin (contracts/cli-contract.md).
+# Lines beyond these are never read, which is both how they are ignored and why
+# an arbitrarily long stdin costs nothing.
+STDIN_LINES = {"register": 1, "login": 1, "unlock": 0, "passwd": 2, "delete": 1}
+
+
+def _argument_error(message):
+    """Replace ``ArgumentParser.error``, which would exit on its own terms.
+
+    Installed on the instance rather than by subclassing, so the package keeps
+    its single class (Principle IV).  ``message`` is argparse's own text and is
+    deliberately discarded: every argument-shape problem reports the one usage
+    line of the contract.
+    """
+    raise AccountsError(2, USAGE)
+
+
+def _command_name(value):
+    """SR-001's allow-list for the command name, as an argparse ``type``."""
+    if value not in COMMANDS:
+        raise AccountsError(
+            2,
+            "error: unknown command '%s': expected one of %s"
+            % (sanitize_for_message(value), ", ".join(COMMANDS)),
+        )
+    return value
+
+
+def parse_args(argv):
+    """Accept exactly ``--store PATH COMMAND USERNAME`` and nothing else (FR-001).
+
+    ``allow_abbrev=False`` keeps ``--sto`` an error; ``add_help=False`` keeps
+    help out, because FR-003 admits only six statuses for their stated
+    conditions and no path may exit 0 without performing an operation.
+    """
+    parser = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
+    parser.error = _argument_error
+    # ``append`` rather than the default so that naming the store twice is a
+    # shape problem rather than silently taking the last one: FR-001 documents
+    # one ``--store`` and the contract accepts nothing else.
+    parser.add_argument("--store", required=True, action="append")
+    parser.add_argument("command", type=_command_name, choices=COMMANDS)
+    parser.add_argument("username")
+    args = parser.parse_args(argv)
+    if len(args.store) != 1:
+        raise AccountsError(2, USAGE)
+    args.store = args.store[0]
+    return args
+
+
+def read_password_line(expected, received):
+    """Read one password line from stdin under a hard byte cap (research R5).
+
+    The cap is enforced by never asking for more than ``MAX_LINE_BYTES + 1``
+    bytes, so an over-long line is refused without being loaded and is never
+    truncated (FR-014, SR-006).
+    """
+    raw = sys.stdin.buffer.readline(validation.MAX_LINE_BYTES + 1)
+    if raw == b"":
+        raise AccountsError(
+            2,
+            "error: missing password input: expected %d password line(s) on"
+            " stdin, received %d" % (expected, received),
+        )
+    if len(raw) == validation.MAX_LINE_BYTES + 1:
+        raise AccountsError(
+            2,
+            "error: password line too long: expected at most %d bytes before"
+            " the line terminator" % validation.MAX_LINE_BYTES,
+        )
+    if raw.endswith(b"\n"):
+        raw = raw[:-1]
+        if raw.endswith(b"\r"):
+            raw = raw[:-1]
+    try:
+        return raw.decode("utf-8")
+    except UnicodeDecodeError:
+        raise AccountsError(
+            2, "error: password line is not valid UTF-8 text"
+        ) from None
+
+
+def _new_record(password, failed_logins=0):
+    """Fresh verification material at the module default parameters (SR-004)."""
+    salt = crypto.new_salt()
+    digest = crypto.hash_password(
+        password, salt, crypto.N, crypto.R, crypto.P, crypto.DKLEN
+    )
+    return {
+        "kdf": crypto.KDF_NAME,
+        "n": crypto.N,
+        "r": crypto.R,
+        "p": crypto.P,
+        "dklen": crypto.DKLEN,
+        "salt": crypto.b64encode(salt),
+        "hash": crypto.b64encode(digest),
+        "failed_logins": failed_logins,
+    }
+
+
+def _no_such_account(username):
+    return AccountsError(
+        3, "error: no such account '%s'" % sanitize_for_message(username)
+    )
+
+
+def _save(path, document):
+    store.atomic_write(path, store.serialise(document))
+
+
+def cmd_register(args):
+    """Create a named account, creating the store itself on first use (FR-007)."""
+    validation.validate_username(args.username)
+    password=[REDACTED:assigned_secret](STDIN_LINES["register"], 0)
+    # Before the store is read: ``register`` has nothing to authenticate
+    # against, so the length rule is pure request validation (scenario 1.6).
+    validation.check_settable_password(password)
+    with store.locked_store(args.store):
+        document = store.load(args.store)
+        accounts = document["accounts"]
+        if args.username in accounts:
+            raise AccountsError(
+                3,
+                "error: account '%s' already exists"
+                % sanitize_for_message(args.username),
+            )
+        if len(accounts) >= validation.MAX_ACCOUNTS:
+            raise AccountsError(
+                5,
+                "error: store '%s' is full: expected at most %d accounts,"
+                " cannot add another" % (args.store, validation.MAX_ACCOUNTS),
+            )
+        accounts[args.username] = _new_record(password)
+        _save(args.store, document)
+    sys.stdout.write("registered %s\n" % args.username)
+    return 0
+
+
+def cmd_login(args):
+    """Verify a password, counting consecutive failures and honouring the lock."""
+    validation.validate_username(args.username)
+    password=[REDACTED:assigned_secret](STDIN_LINES["login"], 0)
+    with store.locked_store(args.store):
+        document = store.load(args.store)
+        record = document["accounts"].get(args.username)
+        if record is None:
+            # A-001: the same answer as a wrong password, and the discarded
+            # derivation makes it cost the same wall clock (SC-004, SR-009).
+            crypto.dummy_verify(password)
+            raise AccountsError(1, "invalid credentials")
+        if record["failed_logins"] >= validation.MAX_FAILED_LOGINS:
+            # Before the password is considered, so a locked account's count
+            # never grows past the limit (FR-017, scenario 2.4).
+            raise AccountsError(4, "account locked")
+        if not crypto.verify(password, record):
+            record["failed_logins"] += 1
+            _save(args.store, document)
+            raise AccountsError(1, "invalid credentials")
+        if record["failed_logins"] != 0:
+            record["failed_logins"] = 0
+            _save(args.store, document)
+    sys.stdout.write("ok\n")
+    return 0
+
+
+def cmd_unlock(args):
+    """Clear the lock and the failure count, without needing a password (A-006)."""
+    validation.validate_username(args.username)
+    with store.locked_store(args.store):
+        document = store.load(args.store)
+        record = document["accounts"].get(args.username)
+        if record is None:
+            raise _no_such_account(args.username)
+        record["failed_logins"] = 0
+        _save(args.store, document)
+    return 0
+
+
+def cmd_passwd(args):
+    """Replace a password after proving the current one in the same invocation."""
+    validation.validate_username(args.username)
+    current = read_password_line(STDIN_LINES["passwd"], 0)
+    replacement = read_password_line(STDIN_LINES["passwd"], 1)
+    with store.locked_store(args.store):
+        document = store.load(args.store)
+        record = document["accounts"].get(args.username)
+        if record is None:
+            raise _no_such_account(args.username)
+        # No lock check at all: the lock restricts ``login`` only (FR-019).
+        if not crypto.verify(current, record):
+            # No increment: only login failures count toward the lock (A-005).
+            raise AccountsError(1, "invalid credentials")
+        # Only after authentication (scenario 3.2, research R6 step 9).
+        validation.check_settable_password(replacement)
+        # A password change is also a recovery path: the count resets and the
+        # lock clears (FR-019).
+        document["accounts"][args.username] = _new_record(replacement)
+        _save(args.store, document)
+    return 0
+
+
+def cmd_delete(args):
+    """Remove an account after proving its password, locked or not (FR-019)."""
+    validation.validate_username(args.username)
+    password=[REDACTED:assigned_secret](STDIN_LINES["delete"], 0)
+    with store.locked_store(args.store):
+        document = store.load(args.store)
+        record = document["accounts"].get(args.username)
+        if record is None:
+            raise _no_such_account(args.username)
+        if not crypto.verify(password, record):
+            raise AccountsError(1, "invalid credentials")
+        del document["accounts"][args.username]
+        _save(args.store, document)
+    return 0
+
+
+HANDLERS = {
+    "register": cmd_register,
+    "login": cmd_login,
+    "unlock": cmd_unlock,
+    "passwd": cmd_passwd,
+    "delete": cmd_delete,
+}
+
+
+def main(argv):
+    """Run one invocation and return its exit status (FR-003, FR-004, FR-005)."""
+    try:
+        args = parse_args(argv)
+        return HANDLERS[args.command](args)
+    except AccountsError as error:
+        sys.stderr.write(error.message + "\n")
+        return error.status
