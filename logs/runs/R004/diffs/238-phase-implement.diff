new file mode 100644
index 0000000..ab96ccf
--- /dev/null
+++ b/tests/test_delete.py
@@ -0,0 +1,104 @@
+"""User Story 4: removing an account (spec scenarios 4.1-4.4).
+
+FR-013, FR-019.  ``delete`` proves the password in the same invocation and
+applies no lock check, because the lock restricts ``login`` only.
+"""
+
+from conftest import (
+    OTHER_PASSWORD,
+    PASSWORD,
+    WRONG_PASSWORD,
+    failed_logins,
+    lines,
+    read_store,
+)
+
+
+def _register(run, store_path, username="alice", password=[REDACTED:assigned_secret]):
+    assert run(["--store", store_path, "register", username], lines(password))[0] == 0
+
+
+def test_fr013_verify_before_removal(run, store_path):
+    """The password is proved before the record is removed (FR-013)."""
+    _register(run, store_path)
+    assert run(["--store", store_path, "delete", "alice"], lines(WRONG_PASSWORD)) == (
+        1,
+        "",
+        "invalid credentials\n",
+    )
+    assert "alice" in read_store(store_path)["accounts"]
+
+    assert run(["--store", store_path, "delete", "alice"], lines(PASSWORD)) == (0, "", "")
+    assert "alice" not in read_store(store_path)["accounts"]
+
+
+def test_scenario_4_1_removed_then_registerable_again(run, store_path):
+    """Status 0, no output, a later check is refused, and the name is free again."""
+    _register(run, store_path)
+    status, out, err = run(["--store", store_path, "delete", "alice"], lines(PASSWORD))
+    assert (status, out, err) == (0, "", "")
+
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+    assert (status, out, err) == (1, "", "invalid credentials\n")
+
+    assert run(["--store", store_path, "register", "alice"], lines(OTHER_PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "alice"], lines(OTHER_PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 1
+
+
+def test_scenario_4_2_wrong_password_keeps_account(run, store_path):
+    """A wrong password is status 1 and the account still exists and verifies."""
+    _register(run, store_path)
+    before = store_path.read_bytes()
+
+    status, out, err = run(["--store", store_path, "delete", "alice"], lines(WRONG_PASSWORD))
+    assert (status, out, err) == (1, "", "invalid credentials\n")
+    assert store_path.read_bytes() == before
+    # A-005: a `delete` failure does not count toward the login lock.
+    assert failed_logins(store_path, "alice") == 0
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+
+def test_scenario_4_3_delete_unknown_username(run, store_path):
+    """`delete` on an unknown username is status 3 and changes nothing."""
+    _register(run, store_path)
+    before = store_path.read_bytes()
+    status, out, err = run(
+        ["--store", store_path, "delete", "nobody_here"], lines(PASSWORD)
+    )
+    assert status == 3
+    assert out == ""
+    assert err == "error: no such account 'nobody_here'\n"
+    assert store_path.read_bytes() == before
+
+
+def test_scenario_4_4_other_accounts_unaffected(run, store_path):
+    """Deleting one of several accounts leaves the others verifying unchanged."""
+    names = ["alice", "bob_42", "carol", "dave_x"]
+    for name in names:
+        _register(run, store_path, name, PASSWORD if name != "carol" else OTHER_PASSWORD)
+
+    assert run(["--store", store_path, "delete", "bob_42"], lines(PASSWORD)) == (0, "", "")
+    assert sorted(read_store(store_path)["accounts"]) == ["alice", "carol", "dave_x"]
+
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "carol"], lines(OTHER_PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "dave_x"], lines(PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "bob_42"], lines(PASSWORD))[0] == 1
+
+
+def test_fr019_delete_works_on_locked_account(run, store_path):
+    """A locked account still accepts `delete` with the correct password (FR-019)."""
+    _register(run, store_path)
+    for _ in range(5):
+        assert run(
+            ["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD)
+        ) == (1, "", "invalid credentials\n")
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        4,
+        "",
+        "account locked\n",
+    )
+
+    assert run(["--store", store_path, "delete", "alice"], lines(PASSWORD)) == (0, "", "")
+    assert read_store(store_path)["accounts"] == {}
diff --git a/tests/test_example_sequence.py b/tests/test_example_sequence.py
new file mode 100644
index 0000000..252d277
--- /dev/null
+++ b/tests/test_example_sequence.py
@@ -0,0 +1,126 @@
+"""SC-011: the documented example sequence, reproduced line for line.
+
+The sequence is the one in
+``specs/001-user-accounts-cli/contracts/cli-contract.md`` ("Worked example
+sequence").  SC-011 refers to "the documented example sequence from the feature
+request", which the recorded request does not actually contain — see the
+clarification note in ``plan.md`` under "Spec gaps flagged".  If the operator
+has a specific sequence in mind, substituting it is a change to this file only.
+
+The passwords in the contract's listing are illustrative; the synthetic
+constants from ``conftest`` stand in for them, since no password literal may be
+duplicated across the tree (Constitution "Secrets hygiene").
+"""
+
+from conftest import NEW_PASSWORD, PASSWORD, SHORT_PASSWORD, lines
+
+
+def test_sc011_worked_sequence(run, store_path):
+    """Every line and every status of the contract's worked sequence."""
+    steps = []
+
+    # $ login alice   -> invalid credentials, exit 1 (no store, no account)
+    steps.append(
+        (
+            run(["--store", store_path, "login", "alice"], lines(PASSWORD)),
+            (1, "", "invalid credentials\n"),
+        )
+    )
+    # $ ls ./s        -> login created nothing
+    assert not store_path.exists()
+    assert list(store_path.parent.iterdir()) == []
+
+    # $ register alice -> registered alice, exit 0
+    steps.append(
+        (
+            run(["--store", store_path, "register", "alice"], lines(PASSWORD)),
+            (0, "registered alice\n", ""),
+        )
+    )
+    # $ stat -c '%a'  -> 600 (SC-010)
+    assert store_path.stat().st_mode & 0o777 == 0o600
+
+    # $ login alice   -> ok, exit 0
+    steps.append(
+        (
+            run(["--store", store_path, "login", "alice"], lines(PASSWORD)),
+            (0, "ok\n", ""),
+        )
+    )
+    # $ register bob with a 5-character password -> exit 2
+    steps.append(
+        (
+            run(["--store", store_path, "register", "bob"], lines("short")),
+            (
+                2,
+                "",
+                "error: new password too short: expected at least 12 characters,"
+                " received 5\n",
+            ),
+        )
+    )
+    # $ register alice again -> exit 3
+    steps.append(
+        (
+            run(["--store", store_path, "register", "alice"], lines(PASSWORD)),
+            (3, "", "error: account 'alice' already exists\n"),
+        )
+    )
+    # $ five wrong passwords -> invalid credentials x5, exit 1 each
+    for _ in range(5):
+        steps.append(
+            (
+                run(["--store", store_path, "login", "alice"], lines(SHORT_PASSWORD)),
+                (1, "", "invalid credentials\n"),
+            )
+        )
+    # $ login alice with the CORRECT password -> account locked, exit 4
+    steps.append(
+        (
+            run(["--store", store_path, "login", "alice"], lines(PASSWORD)),
+            (4, "", "account locked\n"),
+        )
+    )
+    # $ unlock alice < /dev/null -> no output, exit 0
+    steps.append((run(["--store", store_path, "unlock", "alice"], None), (0, "", "")))
+    # $ login alice -> ok, exit 0
+    steps.append(
+        (
+            run(["--store", store_path, "login", "alice"], lines(PASSWORD)),
+            (0, "ok\n", ""),
+        )
+    )
+    # $ passwd alice (current, then new) -> no output, exit 0
+    steps.append(
+        (
+            run(
+                ["--store", store_path, "passwd", "alice"],
+                lines(PASSWORD, NEW_PASSWORD),
+            ),
+            (0, "", ""),
+        )
+    )
+    # $ login alice with the old password -> invalid credentials, exit 1
+    steps.append(
+        (
+            run(["--store", store_path, "login", "alice"], lines(PASSWORD)),
+            (1, "", "invalid credentials\n"),
+        )
+    )
+    # $ delete alice with the new password -> no output, exit 0
+    steps.append(
+        (
+            run(["--store", store_path, "delete", "alice"], lines(NEW_PASSWORD)),
+            (0, "", ""),
+        )
+    )
+    # $ unlock alice < /dev/null -> error: no such account 'alice', exit 3
+    steps.append(
+        (
+            run(["--store", store_path, "unlock", "alice"], None),
+            (3, "", "error: no such account 'alice'\n"),
+        )
+    )
+
+    for index, (observed, expected) in enumerate(steps):
+        assert observed == expected, (index, observed, expected)
diff --git a/tests/test_login_lockout.py b/tests/test_login_lockout.py
new file mode 100644
index 0000000..e0bf765
--- /dev/null
+++ b/tests/test_login_lockout.py
@@ -0,0 +1,192 @@
+"""`login` verification (User Story 1) and the lockout cycle (User Story 2).
+
+FR-013, FR-015, FR-016, FR-017, FR-018, SC-003, A-001.
+"""
+
+from conftest import (
+    NEW_PASSWORD,
+    PASSWORD,
+    WRONG_PASSWORD,
+    failed_logins,
+    lines,
+    read_store,
+    write_store,
+)
+
+
+def _register(run, store_path, username="alice", password=[REDACTED:assigned_secret]):
+    assert run(["--store", store_path, "register", username], lines(password))[0] == 0
+
+
+def _fail(run, store_path, username="alice", times=1):
+    for _ in range(times):
+        status, out, err = run(
+            ["--store", store_path, "login", username], lines(WRONG_PASSWORD)
+        )
+        assert (status, out, err) == (1, "", "invalid credentials\n")
+
+# --- User Story 1: verification only ----------------------------------------
+
+
+def test_fr013_login_verifies(run, store_path):
+    """The correct password prints `ok` with status 0 and a silent stderr."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+    assert status == 0
+    assert out == "ok\n"
+    assert err == ""
+
+
+def test_scenario_1_3_wrong_password(run, store_path):
+    """A wrong password is exactly `invalid credentials` on stderr, status 1."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    status, out, err = run(
+        ["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD)
+    )
+    assert status == 1
+    assert out == ""
+    assert err == "invalid credentials\n"
+
+
+def test_scenario_1_4_unknown_username_is_identical(run, store_path, tmp_path):
+    """An unknown account answers byte-identically to a wrong password (A-001)."""
+    absent = tmp_path / "does-not-exist.store"
+    missing = run(["--store", absent, "login", "nobody_here"], lines(PASSWORD))
+    assert missing == (1, "", "invalid credentials\n")
+    assert not absent.exists()
+
+    write_store(store_path, {})
+    empty = run(["--store", store_path, "login", "nobody_here"], lines(PASSWORD))
+    assert empty == (1, "", "invalid credentials\n")
+
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    wrong = run(["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD))
+    unknown = run(["--store", store_path, "login", "nobody_here"], lines(PASSWORD))
+    assert wrong == unknown == (1, "", "invalid credentials\n")
+
+
+# --- User Story 2: the lockout cycle ----------------------------------------
+
+
+def test_fr015_failure_increments(run, store_path):
+    """Each failed `login` raises the recorded consecutive-failure count (FR-015)."""
+    _register(run, store_path)
+    assert failed_logins(store_path, "alice") == 0
+    for expected in (1, 2, 3, 4):
+        _fail(run, store_path)
+        assert failed_logins(store_path, "alice") == expected
+
+
+def test_fr015_success_resets(run, store_path):
+    """Three failures then a success means five *more* are needed (scenario 2.6)."""
+    _register(run, store_path)
+    _fail(run, store_path, times=3)
+    assert failed_logins(store_path, "alice") == 3
+
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        0, "ok\n", "",
+    )
+    assert failed_logins(store_path, "alice") == 0
+
+    _fail(run, store_path, times=4)
+    # Still unlocked after four, so the reset really did take effect.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        0, "ok\n", "",
+    )
+    assert failed_logins(store_path, "alice") == 0
+
+
+def test_fr016_fifth_failure_is_status_1(run, store_path):
+    """The fifth failure is itself still a rejected credential (FR-016, A-003)."""
+    _register(run, store_path)
+    _fail(run, store_path, times=4)
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD))
+    assert (status, out, err) == (1, "", "invalid credentials\n")
+    assert failed_logins(store_path, "alice") == 5
+
+
+def test_fr016_sixth_attempt_is_locked(run, store_path):
+    """The attempt after the fifth failure reports the lock (FR-016)."""
+    _register(run, store_path)
+    _fail(run, store_path, times=5)
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD))
+    assert (status, out, err) == (4, "", "account locked\n")
+
+
+def test_fr017_correct_password_refused_when_locked(run, store_path):
+    """A locked account refuses the *correct* password with status 4 (FR-017)."""
+    _register(run, store_path)
+    _fail(run, store_path, times=5)
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+    assert (status, out, err) == (4, "", "account locked\n")
+
+
+def test_fr017_lock_reported_before_password_considered(run, store_path):
+    """The lock is reported first, so the count never grows past 5 (scenario 2.4)."""
+    _register(run, store_path)
+    _fail(run, store_path, times=5)
+    before = store_path.read_bytes()
+    for password in (WRONG_PASSWORD, PASSWORD, WRONG_PASSWORD):
+        status, out, err = run(["--store", store_path, "login", "alice"], lines(password))
+        assert (status, out, err) == (4, "", "account locked\n")
+    assert failed_logins(store_path, "alice") == 5
+    # A locked `login` writes nothing at all.
+    assert store_path.read_bytes() == before
+
+
+def test_fr018_unlock_restores_access(run, store_path):
+    """`unlock` clears the lock and the count, and the password works again."""
+    _register(run, store_path)
+    _fail(run, store_path, times=5)
+    status, out, err = run(["--store", store_path, "unlock", "alice"], None)
+    assert (status, out, err) == (0, "", "")
+    assert failed_logins(store_path, "alice") == 0
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+
+def test_fr018_unlock_on_unlocked_account_succeeds(run, store_path):
+    """`unlock` is safe to repeat on an account that is not locked (A-007)."""
+    _register(run, store_path)
+    for _ in range(3):
+        status, out, err = run(["--store", store_path, "unlock", "alice"], None)
+        assert (status, out, err) == (0, "", "")
+    assert failed_logins(store_path, "alice") == 0
+
+    _fail(run, store_path, times=2)
+    assert run(["--store", store_path, "unlock", "alice"], None)[0] == 0
+    assert failed_logins(store_path, "alice") == 0
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+
+def test_fr018_unlock_reads_no_stdin(run, store_path):
+    """`unlock` works with stdin closed: it reads zero lines (A-006)."""
+    _register(run, store_path)
+    _fail(run, store_path, times=5)
+    # stdin=None closes the stream (``/dev/null``) for the child process.
+    assert run(["--store", store_path, "unlock", "alice"], None) == (0, "", "")
+    # Surplus input is never read and is not an error either.
+    assert run(["--store", store_path, "unlock", "alice"], lines(PASSWORD)) == (0, "", "")
+
+
+def test_sc003_no_guess_succeeds_while_locked(run, store_path):
+    """After five wrong guesses no further guess ever succeeds until unlock (SC-003)."""
+    _register(run, store_path)
+    _fail(run, store_path, times=5)
+    for password in (PASSWORD, WRONG_PASSWORD, NEW_PASSWORD, "", "a" * 40):
+        status, out, err = run(["--store", store_path, "login", "alice"], lines(password))
+        assert status == 4, (password, status, err)
+        assert out == ""
+        assert err == "account locked\n"
+    assert run(["--store", store_path, "unlock", "alice"], None)[0] == 0
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+
+def test_scenario_2_7_unlock_unknown_username(run, store_path):
+    """`unlock` on an unknown username is status 3 and changes nothing."""
+    _register(run, store_path)
+    before = store_path.read_bytes()
+    status, out, err = run(["--store", store_path, "unlock", "nobody_here"], None)
+    assert status == 3
+    assert out == ""
+    assert err == "error: no such account 'nobody_here'\n"
+    assert store_path.read_bytes() == before
diff --git a/tests/test_passwd.py b/tests/test_passwd.py
new file mode 100644
index 0000000..bf66daf
--- /dev/null
+++ b/tests/test_passwd.py
@@ -0,0 +1,157 @@
+"""User Story 3: changing a password (spec scenarios 3.1-3.4).
+
+FR-012, FR-013, FR-019, SR-007.  ``passwd`` is deliberately asymmetric with
+``register``: it authenticates *before* it validates the new password, because
+scenario 3.2 says a wrong current password with "any new password" is status 1.
+"""
+
+from conftest import (
+    NEW_PASSWORD,
+    OTHER_PASSWORD,
+    PASSWORD,
+    SHORT_PASSWORD,
+    WRONG_PASSWORD,
+    failed_logins,
+    lines,
+    read_store,
+)
+
+
+def _register(run, store_path, username="alice", password=[REDACTED:assigned_secret]):
+    assert run(["--store", store_path, "register", username], lines(password))[0] == 0
+
+
+def _lock(run, store_path, username="alice"):
+    for _ in range(5):
+        assert run(
+            ["--store", store_path, "login", username], lines(WRONG_PASSWORD)
+        )[0] == 1
+    assert failed_logins(store_path, username) == 5
+
+
+def test_fr013_verify_before_change(run, store_path):
+    """The current password is proved in the same invocation (FR-013, SR-007)."""
+    _register(run, store_path)
+    # A wrong current password blocks the change and says so.
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(WRONG_PASSWORD, NEW_PASSWORD)
+    ) == (1, "", "invalid credentials\n")
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    ) == (0, "", "")
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
+
+
+def test_sr007_wrong_current_password_blocks_change(run, store_path):
+    """A wrong current password is status 1 and the stored password is unchanged."""
+    _register(run, store_path)
+    before = store_path.read_bytes()
+
+    # Any new password, including one that would itself be refused: the new
+    # password is not validated first (scenario 3.2).
+    for replacement in (NEW_PASSWORD, SHORT_PASSWORD, "", "x" * 2000):
+        status, out, err = run(
+            ["--store", store_path, "passwd", "alice"],
+            lines(WRONG_PASSWORD, replacement),
+        )
+        assert (status, out, err) == (1, "", "invalid credentials\n"), replacement
+        assert store_path.read_bytes() == before
+
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+
+def test_fr012_new_password_min_length(run, store_path):
+    """A correct current password plus an 11-character new one is status 2."""
+    _register(run, store_path)
+    before = store_path.read_bytes()
+
+    status, out, err = run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, SHORT_PASSWORD)
+    )
+    assert status == 2
+    assert out == ""
+    assert err == (
+        "error: new password too short: expected at least 12 characters,"
+        " received 11\n"
+    )
+    assert store_path.read_bytes() == before
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+    status, out, err = run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, "p" * 1025)
+    )
+    assert status == 2
+    assert err == (
+        "error: new password too long: expected at most 1024 characters,"
+        " received 1025\n"
+    )
+    assert store_path.read_bytes() == before
+
+
+def test_scenario_3_4_passwd_unknown_username(run, store_path):
+    """`passwd` on an unknown username is status 3 and changes nothing."""
+    _register(run, store_path)
+    before = store_path.read_bytes()
+    status, out, err = run(
+        ["--store", store_path, "passwd", "nobody_here"], lines(PASSWORD, NEW_PASSWORD)
+    )
+    assert status == 3
+    assert out == ""
+    assert err == "error: no such account 'nobody_here'\n"
+    assert store_path.read_bytes() == before
+
+
+def test_fr019_passwd_works_on_locked_account(run, store_path):
+    """A locked account still accepts `passwd`: the lock restricts login only."""
+    _register(run, store_path)
+    _lock(run, store_path)
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        4,
+        "",
+        "account locked\n",
+    )
+
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    ) == (0, "", "")
+
+
+def test_fr019_passwd_resets_failure_count(run, store_path):
+    """A successful `passwd` clears the lock, so it is also a recovery path."""
+    _register(run, store_path)
+    _lock(run, store_path)
+
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    ) == (0, "", "")
+    assert failed_logins(store_path, "alice") == 0
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
+
+
+def test_scenario_3_1_new_verifies_old_does_not(run, store_path):
+    """Status 0, no output, the new password verifies and the old one does not."""
+    _register(run, store_path)
+    _register(run, store_path, "bob_42", OTHER_PASSWORD)
+    before = read_store(store_path)["accounts"]["alice"]
+
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    ) == (0, "", "")
+
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 1
+
+    # A fresh salt is generated on every change, so the material is wholly new.
+    after = read_store(store_path)["accounts"]["alice"]
+    assert after["salt"] != before["salt"]
+    assert after["hash"] != before["hash"]
+    # Every other account is untouched.
+    assert run(["--store", store_path, "login", "bob_42"], lines(OTHER_PASSWORD))[0] == 0
diff --git a/tests/test_performance.py b/tests/test_performance.py
new file mode 100644
index 0000000..835e873
--- /dev/null
+++ b/tests/test_performance.py
@@ -0,0 +1,130 @@
+"""Scale and timing: FR-010 and SC-007 on a 1 000-account store.
+
+Marked ``slow``.  Two assertions, because the requirement has two halves:
+
+* an **absolute** bound — every command under one second;
+* a **hardware-independent** bound — the store-scaling component is negligible,
+  so the same command against a 1-account and a 1 000-account store differ by
+  under 100 ms.
+
+**Headroom caveat** (research R8, "Performance budget against SC-007"):
+``passwd`` performs two deliberate scrypt derivations and so leaves only about
+1.3x headroom against the absolute one-second bound on the development host.
+That cost is security work, not inefficiency; if the absolute bound binds on
+slower hardware the lever is the SR-004 work factor, which is a specification
+decision rather than an implementation detail.  The store-scaling assertion
+below is the half of SC-007 that does not depend on the host.
+"""
+
+import time
+
+import pytest
+
+from conftest import (
+    NEW_PASSWORD,
+    OTHER_PASSWORD,
+    PASSWORD,
+    lines,
+    read_store,
+    synthetic_record,
+)
+
+ABSOLUTE_BUDGET = 1.0
+SCALING_BUDGET = 0.1
+
+
+def _timed(run, args, stdin, expected):
+    start = time.monotonic()
+    status, out, err = run(args, stdin)
+    elapsed = time.monotonic() - start
+    assert status == expected, (args, status, err)
+    return elapsed
+
+
+def _populate(build_store, store_path, count):
+    """A store holding ``count`` synthetic accounts, written in one go."""
+    build_store(
+        store_path,
+        {"filler_%06d" % i: synthetic_record() for i in range(count)},
+    )
+    return store_path
+
+
+@pytest.mark.slow
+def test_fr010_thousand_account_store(run, store_path, build_store):
+    """A 1 000-account store works, and no operation on it takes over a second."""
+    _populate(build_store, store_path, 999)
+    assert _timed(
+        run, ["--store", store_path, "register", "alice"], lines(PASSWORD), 0
+    ) < ABSOLUTE_BUDGET
+
+    accounts = read_store(store_path)["accounts"]
+    assert len(accounts) == 1000
+    assert "alice" in accounts
+
+    # Every account the store held beforehand is still there and intact.
+    assert len([k for k in accounts if k.startswith("filler_")]) == 999
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
+
+
+@pytest.mark.slow
+def test_sc007_each_command_under_one_second(run, store_path, build_store):
+    """Each of the five commands finishes inside the absolute budget (SC-007)."""
+    _populate(build_store, store_path, 999)
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+
+    measured = {
+        "register": _timed(
+            run, ["--store", store_path, "register", "bob_42"], lines(OTHER_PASSWORD), 0
+        ),
+        "login": _timed(
+            run, ["--store", store_path, "login", "alice"], lines(PASSWORD), 0
+        ),
+        "unlock": _timed(run, ["--store", store_path, "unlock", "alice"], None, 0),
+        "passwd": _timed(
+            run,
+            ["--store", store_path, "passwd", "alice"],
+            lines(PASSWORD, NEW_PASSWORD),
+            0,
+        ),
+        "delete": _timed(
+            run, ["--store", store_path, "delete", "alice"], lines(NEW_PASSWORD), 0
+        ),
+    }
+    over_budget = {k: v for k, v in measured.items() if v >= ABSOLUTE_BUDGET}
+    assert not over_budget, (over_budget, measured)
+
+
+@pytest.mark.slow
+def test_sc007_store_scaling_component_negligible(run, tmp_path, build_store):
+    """The cost of store scale, as opposed to the KDF, is under 100 ms (SC-007)."""
+    small = tmp_path / "small.store"
+    large = tmp_path / "large.store"
+    build_store(small, {})
+    _populate(build_store, large, 999)
+    for path in (small, large):
+        assert run(["--store", path, "register", "alice"], lines(PASSWORD))[0] == 0
+    assert len(read_store(small)["accounts"]) == 1
+    assert len(read_store(large)["accounts"]) == 1000
+
+    def best(path, args, stdin, expected):
+        return min(
+            _timed(run, ["--store", path, *args], stdin, expected) for _ in range(3)
+        )
+
+    for args, stdin, expected in (
+        (["login", "alice"], lines(PASSWORD), 0),
+        (["login", "alice"], lines(OTHER_PASSWORD), 1),
+        (["unlock", "alice"], None, 0),
+    ):
+        small_time = best(small, args, stdin, expected)
+        large_time = best(large, args, stdin, expected)
+        assert large_time - small_time < SCALING_BUDGET, (
+            args,
+            small_time,
+            large_time,
+        )
diff --git a/tests/test_register.py b/tests/test_register.py
new file mode 100644
index 0000000..bfde2bc
--- /dev/null
+++ b/tests/test_register.py
@@ -0,0 +1,98 @@
+"""User Story 1 registration: spec scenarios 1.1, 1.5, 1.6, 1.7 (FR-011, FR-012, FR-014)."""
+
+from conftest import (
+    MIN_PASSWORD,
+    OTHER_PASSWORD,
+    PASSWORD,
+    SHORT_PASSWORD,
+    lines,
+    read_store,
+)
+
+
+def test_fr011_username_length_and_charset(run, store_path):
+    """A username outside 3-32 characters of [A-Za-z0-9_] is refused (FR-011)."""
+    for username in ("ab", "a" * 33, "bad name", "al-ice", "ali.ce", "ali\x07ce"):
+        status, out, err = run(["--store", store_path, "register", username], lines(PASSWORD))
+        assert status == 2, (username, out, err)
+        assert out == ""
+        assert err.startswith("error: invalid username ")
+        assert err.endswith("\n") and err.count("\n") == 1
+        # No account and no store file is created by a rejected username.
+        assert not store_path.exists()
+
+
+def test_fr011_case_sensitive_distinct_accounts(run, store_path):
+    """`alice` and `Alice` are two accounts, each verifying only its own password."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    assert run(["--store", store_path, "register", "Alice"], lines(OTHER_PASSWORD))[0] == 0
+
+    assert sorted(read_store(store_path)["accounts"]) == ["Alice", "alice"]
+    ok = (0, "ok\n", "")
+    rejected = (1, "", "invalid credentials\n")
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == ok
+    assert run(["--store", store_path, "login", "Alice"], lines(OTHER_PASSWORD)) == ok
+    assert run(["--store", store_path, "login", "alice"], lines(OTHER_PASSWORD)) == rejected
+    assert run(["--store", store_path, "login", "Alice"], lines(PASSWORD)) == rejected
+
+
+def test_fr012_password_min_length(run, store_path):
+    """An 11-character password is refused before the store is touched (scenario 1.6)."""
+    status, out, err = run(["--store", store_path, "register", "bob"], lines(SHORT_PASSWORD))
+    assert status == 2
+    assert out == ""
+    assert err == (
+        "error: new password too short: expected at least 12 characters,"
+        " received 11\n"
+    )
+    assert not store_path.exists()
+
+    # Exactly 12 characters is accepted.
+    assert run(["--store", store_path, "register", "bob"], lines(MIN_PASSWORD))[0] == 0
+
+
+def test_fr014_password_max_length(run, store_path):
+    """1 025 characters is refused, not truncated; 1 024 is accepted (FR-014)."""
+    too_long = "p" * 1025
+    status, out, err = run(["--store", store_path, "register", "carol"], lines(too_long))
+    assert status == 2
+    assert out == ""
+    assert err == (
+        "error: new password too long: expected at most 1024 characters,"
+        " received 1025\n"
+    )
+    assert not store_path.exists()
+
+    at_limit = "p" * 1024
+    assert run(["--store", store_path, "register", "carol"], lines(at_limit))[0] == 0
+    # Refused rather than truncated: the over-long password does not verify.
+    assert run(["--store", store_path, "login", "carol"], lines(too_long))[0] == 1
+    assert run(["--store", store_path, "login", "carol"], lines(at_limit))[0] == 0
+
+
+def test_scenario_1_1_register_reports_and_creates_store(run, store_path):
+    """`registered alice`, status 0, and the store file now exists (scenario 1.1)."""
+    assert not store_path.exists()
+    status, out, err = run(["--store", store_path, "register", "alice"], lines(PASSWORD))
+    assert status == 0
+    assert out == "registered alice\n"
+    assert err == ""
+    assert store_path.exists()
+    assert sorted(read_store(store_path)) == ["accounts", "version"]
+
+
+def test_scenario_1_7_duplicate_register_leaves_account_untouched(run, store_path):
+    """A duplicate register is status 3 and her original password still verifies."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    before = store_path.read_bytes()
+
+    status, out, err = run(
+        ["--store", store_path, "register", "alice"], lines(OTHER_PASSWORD)
+    )
+    assert status == 3
+    assert out == ""
+    assert err == "error: account 'alice' already exists\n"
+    assert store_path.read_bytes() == before
+
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "alice"], lines(OTHER_PASSWORD))[0] == 1
diff --git a/tests/test_security.py b/tests/test_security.py
new file mode 100644
index 0000000..2f4f0dd
--- /dev/null
+++ b/tests/test_security.py
@@ -0,0 +1,572 @@
+"""The nine security requirements, tested as negatives as well as positives.
+
+SR-001 … SR-009 plus SC-004, SC-005, SC-006, SC-007 and FR-002.  Every password
+literal used here is a synthetic constant imported from ``conftest``; none of
+them has ever been a credential (Constitution "Secrets hygiene").
+"""
+
+import base64
+import time
+
+from conftest import (
+    MIN_PASSWORD,
+    NEW_PASSWORD,
+    OTHER_PASSWORD,
+    PASSWORD,
+    REPO_ROOT,
+    SHORT_PASSWORD,
+    TIMING_PASSWORD,
+    WRONG_PASSWORD,
+    failed_logins,
+    lines,
+    read_store,
+    synthetic_record,
+)
+
+
+def base64_of(raw):
+    """Encode raw bytes the way a store record does, for malformed fixtures."""
+    return base64.b64encode(raw).decode("ascii")
+
+# The delivered tree: the sources, the suite and this feature's documents.
+# ``logs/`` holds the study harness's own transcripts and ``.git`` its history;
+# neither is part of the delivered feature.
+SCANNED_PATHS = ("src", "tests", "pytest.ini", "requirements-dev.txt",
+                 "specs/001-user-accounts-cli")
+
+PASSWORD_LITERALS = (
+    PASSWORD,
+    OTHER_PASSWORD,
+    WRONG_PASSWORD,
+    NEW_PASSWORD,
+    SHORT_PASSWORD,
+    MIN_PASSWORD,
+    TIMING_PASSWORD,
+)
+
+
+def _scanned_files():
+    for entry in SCANNED_PATHS:
+        target = REPO_ROOT / entry
+        if target.is_file():
+            yield target
+        for path in sorted(target.rglob("*")) if target.is_dir() else ():
+            if path.is_file() and "__pycache__" not in path.parts:
+                yield path
+
+
+def test_sr004_password_absent_from_store_bytes(run, store_path):
+    """No supplied password appears anywhere in the store file (SR-004, SC-005)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    )[0] == 0
+
+    raw = store_path.read_bytes()
+    for literal in (PASSWORD, NEW_PASSWORD):
+        assert literal.encode("utf-8") not in raw
+
+
+def test_sr004_params_recorded_per_record(run, store_path):
+    """Each record carries the algorithm and all four parameters (SR-004)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    record = read_store(store_path)["accounts"]["alice"]
+    assert record["kdf"] == "scrypt"
+    assert record["n"] == 131072
+    assert record["r"] == 8
+    assert record["p"] == 1
+    assert record["dklen"] == 32
+    assert sorted(record) == [
+        "dklen", "failed_logins", "hash", "kdf", "n", "p", "r", "salt",
+    ]
+
+
+def test_sr004_no_plaintext_in_repo_fixtures():
+    """Every password literal the suite uses occurs only where it is defined."""
+    conftest = REPO_ROOT / "tests" / "conftest.py"
+    for literal in PASSWORD_LITERALS:
+        offenders = []
+        for path in _scanned_files():
+            if literal in path.read_text(encoding="utf-8", errors="replace"):
+                offenders.append(path)
+        assert offenders == [conftest], (literal, offenders)
+
+
+def test_sr005_salts_unique_across_accounts(run, store_path):
+    """Every account gets a fresh salt from a secure source (SR-005)."""
+    names = ["user_%02d" % i for i in range(5)]
+    for name in names:
+        assert run(["--store", store_path, "register", name], lines(PASSWORD))[0] == 0
+    accounts = read_store(store_path)["accounts"]
+    salts = {accounts[name]["salt"] for name in names}
+    assert len(salts) == len(names)
+
+
+def test_sr005_verify_uses_constant_time_compare(monkeypatch, store_path):
+    """`crypto.verify` routes its comparison through `hmac.compare_digest`."""
+    import hmac
+
+    from accounts import crypto
+
+    calls = []
+    real = hmac.compare_digest
+
+    def recording(left, right):
+        calls.append((len(left), len(right)))
+        return real(left, right)
+
+    monkeypatch.setattr(crypto.hmac, "compare_digest", recording)
+    salt = crypto.new_salt()
+    digest = crypto.hash_password(
+        PASSWORD, salt, crypto.N, crypto.R, crypto.P, crypto.DKLEN
+    )
+    record = {
+        "kdf": "scrypt",
+        "n": crypto.N,
+        "r": crypto.R,
+        "p": crypto.P,
+        "dklen": crypto.DKLEN,
+        "salt": crypto.b64encode(salt),
+        "hash": crypto.b64encode(digest),
+        "failed_logins": 0,
+    }
+    assert crypto.verify(PASSWORD, record) is True
+    assert crypto.verify(WRONG_PASSWORD, record) is False
+    assert calls == [(32, 32), (32, 32)]
+
+
+def test_sc006_same_password_different_digests(run, store_path):
+    """Two accounts with the same password store different material (SC-006)."""
+    assert run(["--store", store_path, "register", "carol"], lines(PASSWORD))[0] == 0
+    assert run(["--store", store_path, "register", "dave_x"], lines(PASSWORD))[0] == 0
+    accounts = read_store(store_path)["accounts"]
+    assert accounts["carol"]["salt"] != accounts["dave_x"]["salt"]
+    assert accounts["carol"]["hash"] != accounts["dave_x"]["hash"]
+
+
+def test_sc005_no_password_in_any_temp_file(run, store_path, tmp_path):
+    """No password reaches any file in the store's directory (SC-005, SR-003)."""
+    operations = (
+        (["register", "alice"], lines(PASSWORD), 0),
+        (["login", "alice"], lines(PASSWORD), 0),
+        (["login", "alice"], lines(WRONG_PASSWORD), 1),
+        (["unlock", "alice"], None, 0),
+        (["passwd", "alice"], lines(PASSWORD, NEW_PASSWORD), 0),
+        (["delete", "alice"], lines(NEW_PASSWORD), 0),
+    )
+    needles = [p.encode("utf-8") for p in (PASSWORD, WRONG_PASSWORD, NEW_PASSWORD)]
+    for argv, stdin, expected in operations:
+        status, out, err = run(["--store", store_path, *argv], stdin)
+        assert status == expected, (argv, out, err)
+        present = sorted(p.name for p in tmp_path.iterdir())
+        assert present == [store_path.name], (argv, present)
+        for path in tmp_path.iterdir():
+            blob = path.read_bytes()
+            for needle in needles:
+                assert needle not in blob, (argv, path)
+
+
+def test_sc004_timing_parity_for_unknown_account(run, store_path):
+    """An unknown account costs the same wall clock as a wrong password (SC-004)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+
+    def elapsed(username, password):
+        start = time.monotonic()
+        status, _, err = run(["--store", store_path, "login", username], lines(password))
+        assert (status, err) == (1, "invalid credentials\n")
+        return time.monotonic() - start
+
+    wrong = min(elapsed("alice", WRONG_PASSWORD) for _ in range(2))
+    unknown = min(elapsed("nobody_here", PASSWORD) for _ in range(2))
+    # The unknown-account path performs a discarded derivation for exactly this
+    # reason, so the two must not separate by a derivation's worth of time.
+    assert abs(wrong - unknown) < 0.5 * min(wrong, unknown), (wrong, unknown)
+
+
+def test_sr009_unknown_and_wrong_password_identical_output(run, store_path):
+    """Identical stream content and status, whether the username exists (SR-009)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    wrong = run(["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD))
+    unknown = run(["--store", store_path, "login", "nobody_here"], lines(PASSWORD))
+    assert wrong == unknown
+    assert wrong == (1, "", "invalid credentials\n")
+
+
+def test_sr009_no_secret_material_in_either_stream(run, store_path):
+    """No password, salt, digest or parameter reaches stdout or stderr (SR-009)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    record = read_store(store_path)["accounts"]["alice"]
+    secrets_present = [PASSWORD, WRONG_PASSWORD, record["salt"], record["hash"]]
+
+    cases = (
+        (["register", "alice"], lines(PASSWORD)),
+        (["register", "bob_42"], lines(PASSWORD)),
+        (["login", "alice"], lines(PASSWORD)),
+        (["login", "alice"], lines(WRONG_PASSWORD)),
+        (["login", "nobody_here"], lines(PASSWORD)),
+        (["unlock", "alice"], None),
+        (["unlock", "nobody_here"], None),
+        (["passwd", "alice"], lines(WRONG_PASSWORD, NEW_PASSWORD)),
+        (["passwd", "alice"], lines(PASSWORD, SHORT_PASSWORD)),
+        (["delete", "alice"], lines(WRONG_PASSWORD)),
+    )
+    for argv, stdin in cases:
+        _, out, err = run(["--store", store_path, *argv], stdin)
+        for needle in secrets_present:
+            assert needle not in out, (argv, out)
+            assert needle not in err, (argv, err)
+        # Nothing of the stored material at all, not even a KDF parameter name.
+        assert "scrypt" not in out and "scrypt" not in err
+        assert "131072" not in out and "131072" not in err
+
+
+def test_sr009_no_traceback_on_any_failure_path(run, store_path, tmp_path):
+    """Every reachable failure is one redacted line, never a traceback (SR-009)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    malformed = tmp_path / "malformed.store"
+    malformed.write_text("not json at all", encoding="utf-8")
+    unreadable = tmp_path / "missing-dir" / "deep.store"
+
+    cases = (
+        ([], None),
+        (["--store", store_path], None),
+        (["--store", store_path, "frobnicate", "alice"], None),
+        (["--store", store_path, "login"], None),
+        (["--store", store_path, "login", "alice", "extra"], None),
+        (["--store", store_path, "register", "ab"], lines(PASSWORD)),
+        (["--store", store_path, "register", "alice"], lines(SHORT_PASSWORD)),
+        (["--store", store_path, "register", "alice"], lines(PASSWORD)),
+        (["--store", store_path, "login", "alice"], None),
+        (["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD)),
+        (["--store", store_path, "login", "alice"], b"\xff\xfe not utf8\n"),
+        (["--store", store_path, "passwd", "alice"], lines(PASSWORD)),
+        (["--store", store_path, "unlock", "nobody_here"], None),
+        (["--store", malformed, "login", "alice"], lines(PASSWORD)),
+        (["--store", unreadable, "register", "alice"], lines(PASSWORD)),
+    )
+    for argv, stdin in cases:
+        status, out, err = run(argv, stdin)
+        assert status in (1, 2, 3, 4, 5), (argv, status)
+        assert out == "", (argv, out)
+        assert err.count("\n") == 1, (argv, err)
+        assert "Traceback" not in err
+        assert "File \"" not in err
+
+
+def test_sr009_store_path_is_the_only_path_echoed(run, tmp_path):
+    """A store message echoes the operator's own argument and no other path."""
+    malformed = tmp_path / "malformed.store"
+    malformed.write_text('{"version":2,"accounts":{}}', encoding="utf-8")
+    status, out, err = run(["--store", malformed, "login", "alice"], lines(PASSWORD))
+    assert status == 5
+    assert out == ""
+    assert err == (
+        "error: store '%s' is malformed: unsupported version\n" % malformed
+    )
+    assert str(REPO_ROOT) not in err
+    assert ".py" not in err
+
+
+def test_fr002_no_password_accepted_as_argument(run, store_path):
+    """No argument position or option carries a password (FR-002)."""
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    rejected = (
+        ["--store", store_path, "login", "alice", PASSWORD],
+        ["--store", store_path, "login", "--password", PASSWORD, "alice"],
+        ["--store", store_path, "login", "alice", "--password=" + PASSWORD],
+        ["--store", store_path, "register", "bob_42", PASSWORD],
+    )
+    for argv in rejected:
+        status, out, err = run(argv, None)
+        assert status == 2, (argv, status, err)
+        assert out == ""
+        assert err.count("\n") == 1
+        assert PASSWORD not in err
+    # The supplied password was never accepted as proof of anything.
+    assert "bob_42" not in read_store(store_path)["accounts"]
+
+
+def test_sr006_overlong_line_refused_not_truncated(run, store_path):
+    """A 4 097-byte line is refused outright, altering nothing (FR-014, SR-006)."""
+    overlong = "p" * 4097 + "\n"
+    expected = (
+        "error: password line too long: expected at most 4096 bytes before"
+        " the line terminator\n"
+    )
+
+    status, out, err = run(["--store", store_path, "register", "alice"], overlong)
+    assert (status, out, err) == (2, "", expected)
+    assert not store_path.exists()
+
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    before = store_path.read_bytes()
+    status, out, err = run(["--store", store_path, "login", "alice"], overlong)
+    assert (status, out, err) == (2, "", expected)
+    assert store_path.read_bytes() == before
+    assert failed_logins(store_path, "alice") == 0
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+
+# --- store-layer and injection negatives (SR-001, SR-002, SR-003, SR-006) ---
+
+
+def test_sr001_record_field_allowlist(run, store_path, build_store):
+    """Every record field is range-checked on load against the allow-list."""
+    rejected = (
+        {"kdf": "argon2"},
+        {"kdf": 1},
+        {"n": 131073},            # not a power of two
+        {"n": 1},                 # below the floor
+        {"n": 2097152},           # above the ceiling
+        {"n": True},              # bool is not an integer here
+        {"n": "131072"},
+        {"n": 131072, "r": 12},   # n * r * 128 exceeds the memory bound
+        {"r": 0},
+        {"r": 33},
+        {"p": 0},
+        {"p": 17},
+        {"dklen": 15},
+        {"dklen": 65},
+        {"dklen": 16},            # hash no longer decodes to dklen bytes
+        {"failed_logins": -1},
+        {"failed_logins": 6},
+        {"failed_logins": False},
+        {"salt": "not base64 at all!!"},
+        {"salt": base64_of(b"short")},
+        {"hash": base64_of(b"too-short")},
+    )
+    for overrides in rejected:
+        build_store(store_path, {"alice": synthetic_record(**overrides)})
+        before = store_path.read_bytes()
+        status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+        assert status == 5, (overrides, status, err)
+        assert out == ""
+        assert "is malformed" in err, (overrides, err)
+        assert err.count("\n") == 1
+        assert store_path.read_bytes() == before
+
+
+def test_sr001_unknown_record_field_is_status_5(run, store_path, build_store):
+    """The field set is an allow-list, not a minimum: extra or missing is 5."""
+    extra = synthetic_record()
+    extra["locked"] = True
+    missing = synthetic_record()
+    del missing["failed_logins"]
+
+    for record in (extra, missing, {}, "not an object", 42, []):
+        build_store(store_path, {"alice": record})
+        status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+        assert status == 5, (record, status, err)
+        assert out == ""
+        assert "is malformed" in err
+
+    # The same for the document itself.
+    for document in ('{"version":1}', '{"accounts":{}}',
+                     '{"version":1,"accounts":{},"extra":1}',
+                     '{"version":1,"accounts":[]}', '[]', '"text"', 'null'):
+        store_path.write_text(document, encoding="utf-8")
+        status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+        assert status == 5, (document, status, err)
+        assert "is malformed" in err
+
+
+def test_sr001_invalid_record_never_skipped_or_repaired(run, store_path, build_store):
+    """One invalid record fails the whole load; the file is untouched (V7)."""
+    build_store(
+        store_path,
+        {"carol": synthetic_record(), "alice": synthetic_record(kdf="argon2")},
+    )
+    before = store_path.read_bytes()
+
+    # Not a partial load: the *valid* account is not reachable either.
+    for argv, stdin in (
+        (["login", "carol"], lines(PASSWORD)),
+        (["login", "alice"], lines(PASSWORD)),
+        (["register", "brand_new"], lines(PASSWORD)),
+        (["unlock", "carol"], None),
+        (["delete", "carol"], lines(PASSWORD)),
+    ):
+        status, out, err = run(["--store", store_path, *argv], stdin)
+        assert status == 5, (argv, status, err)
+        assert out == ""
+        assert "is malformed" in err
+        # Never repaired, never partially overwritten, never treated as empty.
+        assert store_path.read_bytes() == before
+
+    truncated = store_path.parent / "truncated.store"
+    truncated.write_text("not json at all", encoding="utf-8")
+    truncated_before = truncated.read_bytes()
+    status, out, err = run(["--store", truncated, "register", "carol"], lines(PASSWORD))
+    assert status == 5
+    assert truncated.read_bytes() == truncated_before
+
+
+def test_sr002_delimiter_in_username_cannot_split_record(run, store_path, build_store):
+    """No username can create, merge or truncate a record (SR-002)."""
+    hostile = (
+        'alice","bob":{"kdf":"scrypt"',
+        "alice\nbob",
+        "alice:bob",
+        'alice"}}',
+        "alice\\x00bob",
+        "alice\t\rbob",
+    )
+    for username in hostile:
+        status, out, err = run(
+            ["--store", store_path, "register", username], lines(PASSWORD)
+        )
+        assert status == 2, (username, status, err)
+        assert out == ""
+        assert err.startswith("error: invalid username ")
+        assert not store_path.exists()
+
+    # And a store key that would not survive the rule is malformed, not read.
+    build_store(store_path, {"alice:bob": synthetic_record()})
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+    assert status == 5
+    assert "is malformed" in err
+
+    # A legitimate account's record survives a round trip with its own key
+    # intact and no neighbouring record invented.
+    store_path.unlink()
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    assert list(read_store(store_path)["accounts"]) == ["alice"]
+
+
+def test_sr002_control_chars_not_echoed_raw_to_stderr(run, store_path):
+    """Control characters from input are escaped before they reach a stream."""
+    hostile = "al\x07\x1b[31mice\n"
+    status, out, err = run(["--store", store_path, "register", hostile], lines(PASSWORD))
+    assert status == 2
+    assert out == ""
+    assert err.count("\n") == 1
+    assert "\\x07" in err and "\\x1b" in err and "\\x0a" in err
+    for raw in ("\x07", "\x1b"):
+        assert raw not in err
+
+    # A NUL byte cannot be carried in argv at all — the operating system
+    # refuses the exec — so the redaction of one is asserted at its boundary.
+    from accounts.validation import sanitize_for_message
+
+    assert sanitize_for_message("a\x00b") == "a\\x00b"
+    assert sanitize_for_message("\x1b[31m") == "\\x1b[31m"
+    assert len(sanitize_for_message("\x07" * 100)) == 64
+    # Non-ASCII is escaped per UTF-8 byte and the echo is length-bounded.
+    status, out, err = run(["--store", store_path, "register", "wörd" * 40], lines(PASSWORD))
+    assert status == 2
+    assert err.isascii()
+    assert err.count("\n") == 1
+
+
+def test_sr003_no_temp_file_survives_failure(monkeypatch, store_path):
+    """A failed write leaves no temporary file behind (SR-003)."""
+    from accounts import store as store_module
+    from accounts.errors import AccountsError
+
+    def failing_replace(source, target):
+        raise OSError(28, "No space left on device")
+
+    monkeypatch.setattr(store_module.os, "replace", failing_replace)
+    try:
+        store_module.atomic_write(
+            str(store_path), store_module.serialise({"version": 1, "accounts": {}})
+        )
+    except AccountsError as error:
+        assert error.status == 5
+        assert error.message.startswith("error: cannot write store ")
+        assert "No space left on device" in error.message
+    else:
+        raise AssertionError("a failed replace must be reported, not swallowed")
+    monkeypatch.undo()
+
+    assert not store_path.exists()
+    assert list(store_path.parent.iterdir()) == []
+
+
+def test_sr003_temp_name_unpredictable_and_exclusive(monkeypatch, store_path):
+    """The temporary name is unpredictable and is created with O_EXCL (SR-003)."""
+    import os as os_module
+
+    from accounts import store as store_module
+
+    observed = []
+    real_open = os_module.open
+
+    def recording_open(path, flags, *rest):
+        if isinstance(path, str) and path.endswith(".tmp"):
+            observed.append((path, flags, rest))
+        return real_open(path, flags, *rest)
+
+    monkeypatch.setattr(os_module, "open", recording_open)
+    payload = store_module.serialise({"version": 1, "accounts": {}})
+    for _ in range(6):
+        store_module.atomic_write(str(store_path), payload)
+    monkeypatch.undo()
+
+    assert len(observed) == 6
+    names = [os_module.path.basename(path) for path, _, _ in observed]
+    assert len(set(names)) == 6, names
+    for name in names:
+        assert name.startswith("." + store_path.name + ".")
+        assert name.endswith(".tmp")
+        token = name[len("." + store_path.name + "."):-len(".tmp")]
+        assert len(token) == 16 and all(c in "0123456789abcdef" for c in token)
+    for _, flags, rest in observed:
+        assert flags & os_module.O_EXCL
+        assert flags & os_module.O_CREAT
+        assert rest == (0o600,)
+
+
+def test_sr006_oversize_store_refused_before_parsing(run, store_path):
+    """A store over 8 MiB is refused from its size alone, unparsed (SR-006)."""
+    # Valid JSON padded with whitespace: were it parsed, it would be a usable
+    # empty store, so a size refusal proves the check precedes the parse.
+    body = '{"version":1,"accounts":{}}'
+    padding = " " * (8388609 - len(body))
+    store_path.write_text(body + padding, encoding="utf-8")
+    size = store_path.stat().st_size
+    assert size == 8388609
+
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+    assert status == 5
+    assert out == ""
+    assert err == (
+        "error: store '%s' is too large: expected at most 8388608 bytes,"
+        " received %d\n" % (store_path, size)
+    )
+
+    # One byte under the cap parses normally.
+    store_path.write_text(body + padding[:-1], encoding="utf-8")
+    assert store_path.stat().st_size == 8388608
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+    assert (status, out, err) == (1, "", "invalid credentials\n")
+
+
+def test_sr006_deeply_nested_store_is_status_5(run, store_path):
+    """Pathological nesting is reported, never a traceback or a crash (SR-006)."""
+    store_path.write_text("[" * 200000 + "]" * 200000, encoding="utf-8")
+    status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+    assert status == 5
+    assert out == ""
+    assert "is malformed" in err
+    assert err.count("\n") == 1
+    assert "Traceback" not in err
+
+
+def test_sc007_rejection_timing_independent_of_mismatch_position(run, store_path):
+    """Rejection time does not depend on which part of the password was wrong."""
+    base = TIMING_PASSWORD
+    assert run(["--store", store_path, "register", "alice"], base + "\n")[0] == 0
+
+    def elapsed(candidate):
+        start = time.monotonic()
+        status, _, err = run(["--store", store_path, "login", "alice"], candidate + "\n")
+        assert (status, err) == (1, "invalid credentials\n")
+        return time.monotonic() - start
+
+    first_char_wrong = min(elapsed("X" + base[1:]) for _ in range(2))
+    last_char_wrong = min(elapsed(base[:-1] + "X") for _ in range(2))
+    assert abs(first_char_wrong - last_char_wrong) < 0.5 * min(
+        first_char_wrong, last_char_wrong
+    ), (first_char_wrong, last_char_wrong)
