index 0000000..f3f2e25
--- /dev/null
+++ b/src/accounts/crypto.py
@@ -0,0 +1,126 @@
+"""Password hashing: scrypt parameters, salts, derivation and constant-time check.
+
+Parameters are the OWASP Password Storage minimum work factor for scrypt
+(research R1) and are recorded per account record, so raising them later is not
+a migration: existing accounts keep verifying under their own recorded values
+while new and changed passwords get the module defaults.
+"""
+
+import base64
+import hashlib
+import hmac
+import re
+import secrets
+
+KDF_NAME = "scrypt"
+N = 2 ** 17
+R = 8
+P = 1
+DKLEN = 32
+MAXMEM = 192 * 1024 * 1024
+SALT_BYTES = 16
+
+# The documented cross-field bound on a stored record (store-format.md): a
+# record demanding more working memory than the tool's own ``maxmem`` is
+# malformed rather than an unbounded allocation (SR-006).
+MAXMEM_PRODUCT_LIMIT = 201326592
+
+# A fixed synthetic constant, not a credential and not a stored salt: it exists
+# only so that a login against an account that does not exist still costs one
+# derivation and cannot be told from a wrong password by stopwatch (SC-004).
+DUMMY_SALT = b"accounts-dummy16"
+
+_B64_BODY = re.compile(r"[A-Za-z0-9+/]*")
+
+# Per-record parameter ranges (store-format.md "Record").
+N_MIN, N_MAX = 2, 1048576
+R_MIN, R_MAX = 1, 32
+P_MIN, P_MAX = 1, 16
+DKLEN_MIN, DKLEN_MAX = 16, 64
+
+
+def new_salt():
+    """A fresh per-account salt from a cryptographically secure source (SR-005)."""
+    return secrets.token_bytes(SALT_BYTES)
+
+
+def b64encode(raw):
+    """Standard-alphabet, padded base64 — the store's encoding for raw bytes."""
+    return base64.b64encode(raw).decode("ascii")
+
+
+def b64decode(text):
+    """Decode padded standard-alphabet base64 that has already been validated."""
+    return base64.b64decode(text, validate=True)
+
+
+def b64decode_exact(text, size):
+    """Decode ``text`` when it is padded base64 of exactly ``size`` bytes, else None.
+
+    The shape is checked before decoding rather than by catching a decoder
+    error, so this returns a value or ``None`` and raises nothing: the store
+    validator turns ``None`` into a status-5 reason (SR-001).
+    """
+    if type(text) is not str:
+        return None
+    encoded_length = 4 * ((size + 2) // 3)
+    if len(text) != encoded_length:
+        return None
+    padding = (-size) % 3
+    body, trailer = text[: encoded_length - padding], text[encoded_length - padding :]
+    if trailer != "=" * padding or _B64_BODY.fullmatch(body) is None:
+        return None
+    raw = b64decode(text)
+    return raw if len(raw) == size else None
+
+
+def fits_maxmem(n, r, p):
+    """Whether a derivation with these parameters fits the tool's memory bound.
+
+    ``n * r * 128`` is the bound store-format.md documents; OpenSSL additionally
+    reserves ``128 * r * (2 + p)``, so the enforced form is its exact
+    accounting.  That is strictly stronger than the documented product, so every
+    record the documented rule rejects is rejected here too (SR-006).
+    """
+    return 128 * r * (n + 2 + p) <= MAXMEM
+
+
+def hash_password(password, salt, n, r, p, dklen):
+    """Derive a digest from a password with a deliberately slow KDF (SR-004)."""
+    return hashlib.scrypt(
+        password.encode("utf-8"),
+        salt=salt,
+        n=n,
+        r=r,
+        p=p,
+        dklen=dklen,
+        maxmem=MAXMEM,
+    )
+
+
+def verify(password, record):
+    """Whether ``password`` matches ``record``, compared in constant time (SR-005).
+
+    Derives with the record's *own* recorded parameters and salt, never the
+    module defaults, so an account written under older parameters keeps working.
+    """
+    derived = hash_password(
+        password,
+        b64decode(record["salt"]),
+        record["n"],
+        record["r"],
+        record["p"],
+        record["dklen"],
+    )
+    return hmac.compare_digest(derived, b64decode(record["hash"]))
+
+
+def dummy_verify(password):
+    """Spend one derivation and discard it, for timing parity (SC-004, SR-009).
+
+    Called on the unknown-account path of ``login`` so that path costs the same
+    wall clock as a wrong password against an account that exists.  The salt is a
+    fixed module constant and the result is never compared to anything.
+    """
+    hash_password(password, DUMMY_SALT, N, R, P, DKLEN)
+    return False
diff --git a/src/accounts/errors.py b/src/accounts/errors.py
new file mode 100644
index 0000000..7179c22
--- /dev/null
+++ b/src/accounts/errors.py
@@ -0,0 +1,19 @@
+"""The single error type the package uses to carry a failure to the exit point.
+
+Principle II requires every failure to reach the operator as a message *and* a
+non-zero exit status.  ``AccountsError`` is the carrier for both, so every
+boundary can refuse work without knowing how output is written; ``cli.main`` is
+the one place that turns it into a stderr line and a status.
+
+The message an ``AccountsError`` carries MUST already be redacted (SR-009).
+This class performs no formatting and never touches store content.
+"""
+
+
+class AccountsError(Exception):
+    """A refused operation: one exit status and one already-redacted line."""
+
+    def __init__(self, status, message):
+        super().__init__(message)
+        self.status = status
+        self.message = message
