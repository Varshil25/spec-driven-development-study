index 0000000..ff58c8a
--- /dev/null
+++ b/src/accounts/store.py
@@ -0,0 +1,281 @@
+"""The store boundary: directory lock, validated load, atomic owner-only write.
+
+The on-disk format is a cross-invocation contract
+(``specs/001-user-accounts-cli/contracts/store-format.md``); this module is its
+only producer and only consumer.
+
+Two disciplines are load-bearing here:
+
+* every command holds an exclusive ``flock`` on the store's **directory** for
+  the whole read-modify-write, because the store file may not exist yet and
+  ``os.replace`` swaps its inode (research R4, SR-007);
+* a change is written to an unpredictable ``0o600`` temporary file in that same
+  directory and renamed over the target, so a reader sees the whole old or the
+  whole new content and never a mixture (FR-009, SR-003, SR-008, SC-009).
+"""
+
+import contextlib
+import fcntl
+import json
+import os
+import pathlib
+import secrets
+
+from accounts import crypto, validation
+from accounts.errors import AccountsError
+
+RECORD_KEYS = frozenset(
+    ("kdf", "n", "r", "p", "dklen", "salt", "hash", "failed_logins")
+)
+DOCUMENT_KEYS = frozenset(("version", "accounts"))
+
+
+def _errno_text(error):
+    """The operating system's own description of a failure, and nothing more."""
+    return error.strerror or "unknown error"
+
+
+def _cannot_read(path, error):
+    return "error: cannot read store '%s': %s" % (path, _errno_text(error))
+
+
+def _cannot_write(path, error):
+    return "error: cannot write store '%s': %s" % (path, _errno_text(error))
+
+
+def _malformed(path, reason):
+    return "error: store '%s' is malformed: %s" % (path, reason)
+
+
+def _store_directory(path):
+    """The real directory the store and its temporary file both live in."""
+    return os.path.dirname(os.path.realpath(path)) or "."
+
+
+@contextlib.contextmanager
+def locked_store(path):
+    """Serialise the whole read-modify-write against other invocations (SR-007).
+
+    Locks the store's directory, which exists for the whole operation and has a
+    stable inode.  Creates no file of any kind — not the store, not a lock
+    sidecar — so a command other than ``register`` leaves nothing behind
+    (FR-007).
+    """
+    try:
+        fd = os.open(_store_directory(path), os.O_RDONLY)
+    except OSError as error:
+        raise AccountsError(5, _cannot_read(path, error)) from None
+    try:
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX)
+        except OSError as error:
+            raise AccountsError(5, _cannot_read(path, error)) from None
+        yield
+    finally:
+        os.close(fd)
+
+
+def _read_exactly(fd, size):
+    """Read at most ``size`` bytes from ``fd``; the read is bounded by design."""
+    chunks = []
+    remaining = size
+    while remaining > 0:
+        chunk = os.read(fd, min(remaining, 1 << 16))
+        if not chunk:
+            break
+        chunks.append(chunk)
+        remaining -= len(chunk)
+    return b"".join(chunks)
+
+
+def load(path):
+    """Read and fully validate the store, or return an empty one in memory.
+
+    Follows store-format.md "Order of checks on load" exactly.  A missing file
+    is not an error and is **not** created: it loads as an empty store (FR-007).
+    """
+    try:
+        fd = os.open(path, os.O_RDONLY)
+    except FileNotFoundError:
+        return {"version": validation.STORE_VERSION, "accounts": {}}
+    except OSError as error:
+        raise AccountsError(5, _cannot_read(path, error)) from None
+
+    try:
+        try:
+            size = os.fstat(fd).st_size
+        except OSError as error:
+            raise AccountsError(5, _cannot_read(path, error)) from None
+        if size > validation.MAX_STORE_BYTES:
+            raise AccountsError(
+                5,
+                "error: store '%s' is too large: expected at most %d bytes,"
+                " received %d" % (path, validation.MAX_STORE_BYTES, size),
+            )
+        try:
+            raw = _read_exactly(fd, size)
+        except OSError as error:
+            raise AccountsError(5, _cannot_read(path, error)) from None
+    finally:
+        os.close(fd)
+
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        raise AccountsError(5, _malformed(path, "not valid UTF-8 text")) from None
+
+    try:
+        document = json.loads(text)
+    except json.JSONDecodeError:
+        raise AccountsError(5, _malformed(path, "not valid JSON")) from None
+    except RecursionError:
+        # The one deliberate suppression of an exception class that is normally
+        # left to propagate, recorded in plan.md Complexity Tracking: the C
+        # scanner signals pathological nesting this way, and a traceback on
+        # stderr would breach SR-009 and FR-003 together.
+        raise AccountsError(5, _malformed(path, "nesting too deep")) from None
+
+    reason = validate_document(document)
+    if reason is not None:
+        raise AccountsError(5, _malformed(path, reason))
+
+    accounts = document["accounts"]
+    if len(accounts) > validation.MAX_ACCOUNTS:
+        raise AccountsError(
+            5,
+            "error: store '%s' holds too many accounts: expected at most %d,"
+            " received %d" % (path, validation.MAX_ACCOUNTS, len(accounts)),
+        )
+
+    for username in accounts:
+        reason = validate_record(username, accounts[username])
+        if reason is not None:
+            raise AccountsError(5, _malformed(path, reason))
+
+    return document
+
+
+def validate_document(document):
+    """Return ``None`` for a valid store document, else the structural reason.
+
+    The reason names the shape problem and never a stored value (SR-009); the
+    account count is checked separately because it has its own message.
+    """
+    if type(document) is not dict:
+        return "not a JSON object"
+    keys = set(document)
+    missing = sorted(DOCUMENT_KEYS - keys)
+    if missing:
+        return "missing key '%s'" % missing[0]
+    if keys - DOCUMENT_KEYS:
+        return "unexpected document key"
+    version = document["version"]
+    if type(version) is not int or version != validation.STORE_VERSION:
+        return "unsupported version"
+    if type(document["accounts"]) is not dict:
+        return "'accounts' is not a JSON object"
+    return None
+
+
+def _in_range(value, low, high):
+    """An integer in range — explicitly not ``True``/``False`` (store-format.md)."""
+    return type(value) is int and low <= value <= high
+
+
+def validate_record(username, record):
+    """Return ``None`` for a valid account record, else the structural reason.
+
+    The field set is an allow-list of exactly eight keys, not a minimum
+    (SR-001).  One invalid record fails the whole load: nothing here repairs,
+    guesses at, skips or partially loads a record.
+    """
+    label = validation.sanitize_for_message(username)
+    if not validation.is_username(username):
+        return "account key '%s' is not a valid username" % label
+    if type(record) is not dict:
+        return "record '%s' is not a JSON object" % label
+    if set(record) != RECORD_KEYS:
+        return "record '%s' has an unexpected field set" % label
+    if type(record["kdf"]) is not str or record["kdf"] != crypto.KDF_NAME:
+        return "record '%s' field 'kdf' is not supported" % label
+
+    n, r, p = record["n"], record["r"], record["p"]
+    if not _in_range(n, crypto.N_MIN, crypto.N_MAX) or n & (n - 1):
+        return "record '%s' field 'n' out of range" % label
+    if not _in_range(r, crypto.R_MIN, crypto.R_MAX):
+        return "record '%s' field 'r' out of range" % label
+    if not _in_range(p, crypto.P_MIN, crypto.P_MAX):
+        return "record '%s' field 'p' out of range" % label
+    if not crypto.fits_maxmem(n, r, p):
+        return "record '%s' demands more memory than the enforced bound" % label
+
+    dklen = record["dklen"]
+    if not _in_range(dklen, crypto.DKLEN_MIN, crypto.DKLEN_MAX):
+        return "record '%s' field 'dklen' out of range" % label
+    if crypto.b64decode_exact(record["salt"], crypto.SALT_BYTES) is None:
+        return "record '%s' field 'salt' is not %d base64 bytes" % (
+            label,
+            crypto.SALT_BYTES,
+        )
+    if crypto.b64decode_exact(record["hash"], dklen) is None:
+        return "record '%s' field 'hash' is not 'dklen' base64 bytes" % label
+    if not _in_range(record["failed_logins"], 0, validation.MAX_FAILED_LOGINS):
+        return "record '%s' field 'failed_logins' out of range" % label
+    return None
+
+
+def serialise(document):
+    """Encode a store document byte-deterministically (store-format.md, SR-002)."""
+    text = json.dumps(
+        document, ensure_ascii=True, sort_keys=True, separators=(",", ":")
+    )
+    return (text + "\n").encode("utf-8")
+
+
+def _write_all(fd, data):
+    offset = 0
+    while offset < len(data):
+        offset += os.write(fd, data[offset:])
+
+
+def atomic_write(path, data):
+    """Replace the store as a whole, owner-only, leaving no temporary behind.
+
+    The six-step discipline of store-format.md "Write discipline".  The mode is
+    passed to ``os.open`` so it is set at creation rather than applied
+    afterwards (SR-008), and it survives the rename, so the store is owner-only
+    from the moment it first exists (SC-010).
+    """
+    real = os.path.realpath(path)
+    directory = os.path.dirname(real) or "."
+    temporary = os.path.join(
+        directory, ".%s.%s.tmp" % (os.path.basename(real), secrets.token_hex(8))
+    )
+    try:
+        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    except OSError as error:
+        raise AccountsError(5, _cannot_write(path, error)) from None
+
+    try:
+        try:
+            _write_all(fd, data)
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        os.replace(temporary, real)
+    except OSError as error:
+        message = _cannot_write(path, error)
+        # No temporary file survives a failed write (SR-003).  Reachable only
+        # with the directory still writable — we created a file in it a moment
+        # ago — so the removal itself does not need its own failure path.
+        pathlib.Path(temporary).unlink(missing_ok=True)
+        raise AccountsError(5, message) from None
+
+    try:
+        dir_fd = os.open(directory, os.O_RDONLY)
+        try:
+            os.fsync(dir_fd)
+        finally:
+            os.close(dir_fd)
+    except OSError as error:
+        raise AccountsError(5, _cannot_write(path, error)) from None
