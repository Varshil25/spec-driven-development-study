+PASSWORD_HEADER = "X-Paste-Password"
+
+
+def password_headers(password):
+    """Build request headers carrying ``password``, for the feature-002 read gate.
+
+    The three shapes FR-041 distinguishes are all reachable from one argument:
+
+    * ``None`` — **no** ``X-Paste-Password`` header at all (the absent case, and what every
+      pre-existing caller gets)
+    * a ``str`` — exactly one occurrence. ``""`` is a legitimate value here: it sends the
+      header with an empty value, which is one occurrence that fails the ordinary comparison
+    * a ``list``/``tuple`` of ``str`` — that many occurrences, so ``["pw", "pw"]`` sends the
+      header twice and ``[]`` sends it zero times
+
+    Returns a mapping for the first two and a list of pairs for the third, which
+    :func:`request` accepts either way.
+    """
+    if password is None:
+        return {}
+    if isinstance(password, (list, tuple)):
+        return [(PASSWORD_HEADER, value) for value in password]
+    return {PASSWORD_HEADER: password}
