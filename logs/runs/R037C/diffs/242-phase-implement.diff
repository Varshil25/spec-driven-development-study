+def _write_raw_record(data_dir, paste_id, record):
+    """Write ``record`` verbatim as ``<paste_id>.json``."""
+    with open(os.path.join(str(data_dir), paste_id + ".json"), "w", encoding="utf-8") as handle:
+        json.dump(record, handle)
