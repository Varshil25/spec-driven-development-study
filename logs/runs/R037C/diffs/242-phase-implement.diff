+"""Continuity: nothing the service already does changes.
+
+Owns these requirements (traceability table in
+``specs/002-burn-after-reading-password/quickstart.md``):
+
+* **FR-037** — the ``201`` body stays exactly ``id``, ``delete_token``, ``url``
+* **FR-038** — a rejected creation stores nothing
+* **FR-039** — an existing rejection keeps its status even when a new field is also invalid
+* **FR-054** — the JSON read body is exactly six fields, the four old ones unchanged
+* **FR-055** — the two new booleans match what was set at creation
+* **FR-056** — the raw read body is the content and nothing else
+* **FR-057** — a restart over the same directory preserves both behaviours
+* **FR-058** — records written by the previous version read back unchanged, both flags ``false``
+* **FR-059** — every new ``400``/``403``/``404`` body is exactly ``{"error": "<message>"}``
+
+Success criteria: **SC-015** (rejection and boundary tables), **SC-017** (legacy records),
+**SC-018** (restart durability), **SC-021** (availability soak). **FR-060** is carried by the
+pre-existing suite passing unmodified, which this module also checks structurally.
+
+Test names carry their requirement id, as the existing suite does, so ``pytest -k FR_058``
+selects one requirement (Constitution III, SC-016).
+"""
+
+import json
+import os
+import time
+
+import pytest
+
+from conftest import free_port, write_legacy_record
+from pastebin import storage
+
+#: The four option combinations. Both new fields are independent (spec assumption).
+COMBINATIONS = [
+    ({}, False, False),
+    ({"burn_after_reading": True}, True, False),
+    ({"password": "hunter2"}, False, True),
+    ({"burn_after_reading": True, "password": "hunter2"}, True, True),
+]
+
+#: The exact six keys FR-054 pins for the JSON read body.
+READ_FIELDS = [
+    "burn_after_reading",
+    "content",
+    "created_at",
+    "expires_at",
+    "id",
+    "protected",
+]
+
+
+# --- helpers ------------------------------------------------------------------------------
+
+
+def _assert_json_error(response, status):
+    """Assert the FR-059 error shape and return the message."""
+    assert response.status == status, (response.status, response.body)
+    assert response.headers["Content-Type"] == "application/json"
+    body = json.loads(response.body)
+    assert sorted(body) == ["error"]
+    return body["error"]
+
+
+def _records(data_dir):
+    return sorted(entry.name for entry in os.scandir(str(data_dir)))
+
+
+def _stored_record(data_dir, paste_id):
+    with open(os.path.join(str(data_dir), paste_id + ".json"), encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+# --- T031 / FR-037: the creation response is unchanged ------------------------------------
+
+
+@pytest.mark.parametrize("fields,burn,protected", COMBINATIONS)
+def test_FR_037_creation_response_is_exactly_three_fields(service, fields, burn, protected):
+    """FR-037: 201 with exactly id, delete_token, url — for all four option combinations."""
+    response = service.post_json({"content": "x", **fields})
+    assert response.status == 201
+    assert response.headers["Content-Type"] == "application/json"
+
+    body = json.loads(response.body)
+    assert sorted(body) == ["delete_token", "id", "url"]
+    assert body["url"] == "/pastes/" + body["id"]
+
+    # Neither option is echoed and the password is not reported here (FR-037, FR-046).
+    assert "password" not in response.body.decode("utf-8")
+    assert "burn_after_reading" not in response.body.decode("utf-8")
+    assert "protected" not in response.body.decode("utf-8")
+    assert "hunter2" not in response.body.decode("utf-8")
+
+
+def test_FR_039_a_body_mentioning_neither_new_field_is_unchanged(service):
+    """FR-039: a request with neither new field produces the previous version's outcome.
+
+    Status, body shape, and the stored record's pre-existing keys are all checked. The record
+    gains the three new keys at their "not one-time, not protected" values, which is internal
+    and not part of the contract (R-017, 001 data model).
+    """
+    response = service.post_json({"content": "unchanged", "expires_in": 3600})
+    assert response.status == 201
+    created = json.loads(response.body)
+    assert sorted(created) == ["delete_token", "id", "url"]
+
+    record = _stored_record(service.data_dir, created["id"])
+    assert record["version"] == 1
+    assert record["id"] == created["id"]
+    assert record["content"] == "unchanged"
+    assert record["delete_token"] == created["delete_token"]
+    assert record["expires_at"] == record["created_at"] + 3600
+    assert record["burn_after_reading"] is False
+    assert record["password_salt"] is None
+    assert record["password_hash"] is None
+
+    # And it behaves exactly as before: repeatedly readable, no password, deletes by token.
+    for _ in range(3):
+        assert service.read(created["id"]).status == 200
+        assert service.read_raw(created["id"]).status == 200
+    assert service.delete(created["id"], created["delete_token"]).status == 204
+
+
+# --- T032 / FR-039: existing rejections keep their status ---------------------------------
+
+
+def test_FR_039_oversized_content_with_an_invalid_new_field_is_still_413(service):
+    """FR-039/R-019: the existing 413 wins over the new 400 — the headline precedence case.
+
+    Reversing the order of the checks in ``_parse_create`` turns this into a 400, which is the
+    regression the quickstart troubleshooting table names.
+    """
+    oversized = "x" * (storage.CONTENT_MAX_BYTES + 1)
+
+    for bad_field in (
+        {"burn_after_reading": "true"},
+        {"burn_after_reading": 1},
+        {"password": 5},
+        {"password": ""},
+        {"password": "a" * 129},
+        {"burn_after_reading": [], "password": {}},
+    ):
+        error = _assert_json_error(
+            service.post_json({"content": oversized, **bad_field}), 413
+        )
+        assert "content" in error
+    assert _records(service.data_dir) == []
+
+
+@pytest.mark.parametrize(
+    "body,status,named",
+    [
+        ({}, 400, "content"),
+        ({"content": 1}, 400, "content"),
+        ({"content": None}, 400, "content"),
+        ({"content": []}, 400, "content"),
+        ({"content": "x", "expires_in": 0}, 400, "expires_in"),
+        ({"content": "x", "expires_in": "60"}, 400, "expires_in"),
+        ({"content": "x", "expires_in": None}, 400, "expires_in"),
+        ({"content": "x", "expires_in": 2_592_001}, 400, "expires_in"),
+    ],
+)
+def test_FR_039_existing_rejections_keep_their_status_and_message(service, body, status, named):
+    """FR-039: every existing rejection is unchanged even when a new field is also invalid."""
+    plain = service.post_json(body)
+    assert plain.status == status
+    plain_error = json.loads(plain.body)["error"]
+    assert named in plain_error
+
+    # The same body with an invalid new field alongside: same status, same message.
+    for bad_field in ({"burn_after_reading": "yes"}, {"password": 5}, {"password": ""}):
+        response = service.post_json({**body, **bad_field})
+        assert response.status == status, (body, bad_field)
+        assert json.loads(response.body)["error"] == plain_error, (body, bad_field)
+
+    assert _records(service.data_dir) == []
+
+
+def test_FR_039_unparsable_and_non_object_bodies_keep_their_status(service):
+    """FR-039: V-1 and V-2 run before the new fields, so these are unchanged."""
+    for raw in ("not json", "[1,2]", "null", "42", '"string"'):
+        response = service.request("POST", "/pastes", body=raw)
+        assert response.status == 400, raw
+        assert sorted(json.loads(response.body)) == ["error"]
+    assert _records(service.data_dir) == []
+
+
+def test_FR_038_SC_015_no_rejected_creation_writes_anything(service):
+    """FR-038/SC-015: the data directory stays empty across every new rejection cause."""
+    assert _records(service.data_dir) == []
+    for bad in ["true", "false", 1, 0, 1.0, None, [], {}]:
+        service.post_json({"content": "x", "burn_after_reading": bad})
+    for bad in [5, 0, 1.5, True, None, [], {}, "", "a" * 129]:
+        service.post_json({"content": "x", "password": bad})
+    for bad_pair in [{"burn_after_reading": 1, "password": 2}]:
+        service.post_json({"content": "x", **bad_pair})
+    assert _records(service.data_dir) == []
+
+
+# --- T033 / FR-054, FR-055, FR-056: the read bodies --------------------------------------
+
+
+@pytest.mark.parametrize("fields,burn,protected", COMBINATIONS)
+def test_FR_054_FR_055_json_read_body_is_exactly_six_fields(service, fields, burn, protected):
+    """FR-054/FR-055: exactly six keys, the four old ones unchanged, the two new ones correct."""
+    content = "body ü 🌍\nline two"
+    created = service.create(content=content, expires_in=3600, **fields)
+    password=[REDACTED:assigned_secret]("password")
+
+    response = service.read(created["id"], password)
+    assert response.status == 200
+    assert response.headers["Content-Type"] == "application/json"
+
+    body = json.loads(response.body)
+    assert sorted(body) == READ_FIELDS
+
+    # The four pre-existing fields keep their names, formats, and meanings (FR-054).
+    assert body["id"] == created["id"]
+    assert body["content"] == content
+    assert time.strptime(body["created_at"], "%Y-%m-%dT%H:%M:%SZ")
+    assert time.strptime(body["expires_at"], "%Y-%m-%dT%H:%M:%SZ")
+    assert "delete_token" not in body
+
+    # The two new ones are exactly true or false — never absent, never null (FR-055).
+    assert body["burn_after_reading"] is burn
+    assert body["protected"] is protected
+
+
+def test_FR_054_expires_at_is_still_json_null_when_there_is_no_expiry(service):
+    """FR-054: the new fields do not disturb expires_at's null form (FR-010)."""
+    created = service.create(content="x", burn_after_reading=False, password="hunter2")
+    body = json.loads(service.read(created["id"], "hunter2").body)
+    assert body["expires_at"] is None
+    assert b'"expires_at": null' in service.read(created["id"], "hunter2").body
+
+
+@pytest.mark.parametrize("fields,burn,protected", COMBINATIONS)
+def test_FR_056_raw_read_body_is_the_content_and_nothing_else(service, fields, burn, protected):
+    """FR-056: the raw route is unchanged — no new fields appear there."""
+    content = "raw ü 🌍\ttab\n"
+    created = service.create(content=content, **fields)
