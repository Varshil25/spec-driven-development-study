+            f"plain ascii {index}",
+            f"multi-byte héllo {index} ü ß",
+            f"emoji 🌍🚀 {index}",
+            f"mixed 日本語 {index}\nline two\ttab",
+            "",
+        ][index % 5]
+        paste_id = f"legacy{index:015d}xxxxx"[:22]
+        assert storage.is_valid_id(paste_id)
+        expires_at = now + 2_592_000 if index % 3 == 0 else None  # mixed expiring/non-expiring
+        token=[REDACTED:assigned_secret](
+            data_dir,
+            paste_id,
+            content,
+            created_at=now - 100,
+            expires_at=expires_at,
+            delete_token=f"legacy-token-{index:04d}" + "y" * 20,
+        )
+        expected.append((paste_id, content, expires_at, token))
+
+    legacy = in_process_factory(data_dir)
+
+    for paste_id, content, expires_at, token in expected:
+        response = legacy.read(paste_id)
+        assert response.status == 200, paste_id
+        body = json.loads(response.body)
+
+        # Unchanged content, identifier, creation timestamp, and expiry (SC-017).
+        assert body["id"] == paste_id
+        assert body["content"] == content
+        assert body["created_at"] == storage.iso_z(now - 100)
+        assert body["expires_at"] == storage.iso_z(expires_at)
+
+        # Reported as neither one-time nor protected (FR-058).
+        assert body["burn_after_reading"] is False
+        assert body["protected"] is False
+
+        # Readable repeatedly, on both routes, with no password (FR-051, FR-044).
+        assert legacy.read_raw(paste_id).body == content.encode("utf-8")
+        assert legacy.read(paste_id, "any password at all").status == 200
+        assert legacy.read(paste_id).status == 200
+
+    # Every original deletion token still works (SC-017).
+    for paste_id, _, _, token in expected:
+        assert legacy.delete(paste_id, token).status == 204, paste_id
+    assert _records(data_dir) == []
