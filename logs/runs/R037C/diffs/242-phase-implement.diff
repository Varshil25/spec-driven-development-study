+def _legacy_shape(paste_id, now):
+    return {
+        "version": 1,
+        "id": paste_id,
+        "content": "should never be served",
+        "created_at": now,
+        "expires_at": None,
+        "delete_token": "token" + "z" * 38,
+    }
+
+
+#: Every malformed shape of the three new keys (data-model section 3, invariant S-10).
+MALFORMED = {
+    "burnnotboolstringxxxxx": {"burn_after_reading": "true"},
+    "burnnotboolnumberxxxxx": {"burn_after_reading": 1},
+    "burnnotboolnullxxxxxxx": {"burn_after_reading": None},
+    "burnnotboollistxxxxxxx": {"burn_after_reading": []},
+    "saltnothexxxxxxxxxxxxx": {"password_salt": "nothex!!", "password_hash": "ab" * 32},
+    "saltwrongwidthxxxxxxxx": {"password_salt": "ab" * 8, "password_hash": "ab" * 32},
+    "saltnotstringxxxxxxxxx": {"password_salt": 5, "password_hash": "ab" * 32},
+    "hashnothexxxxxxxxxxxxx": {"password_salt": "ab" * 16, "password_hash": "zz" * 32},
+    "hashwrongwidthxxxxxxxx": {"password_salt": "ab" * 16, "password_hash": "ab" * 16},
+    "saltwithouthashxxxxxxx": {"password_salt": "ab" * 16},
+    "hashwithoutsaltxxxxxxx": {"password_hash": "ab" * 32},
+    "saltsethashnullxxxxxxx": {"password_salt": "ab" * 16, "password_hash": None},
+    "hashsetsaltnullxxxxxxx": {"password_hash": "ab" * 32, "password_salt": None},
+}
