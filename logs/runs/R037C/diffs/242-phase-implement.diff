+def test_FR_045_the_password_header_is_inert_outside_the_read_routes(service):
+    """FR-045/spec edge case: the header does nothing on POST, DELETE, or an undefined route."""
+    with_header = {"X-Paste-Password": "hunter2", "Content-Type": "application/json"}
+
+    # On POST it is neither required nor consumed: creation behaves exactly as without it.
+    response = service.request(
+        "POST", "/pastes", body=json.dumps({"content": "x"}), headers=with_header
+    )
+    assert response.status == 201
+    created = json.loads(response.body)
+    assert sorted(created) == ["delete_token", "id", "url"]
+    assert json.loads(service.read(created["id"]).body)["protected"] is False
+
+    # On an undefined route it adds no route and changes no status (FR-060).
+    assert service.request("GET", "/undefined", headers=with_header).status == 404
+    assert service.request("PUT", f"/pastes/{created['id']}", headers=with_header).status == 404
