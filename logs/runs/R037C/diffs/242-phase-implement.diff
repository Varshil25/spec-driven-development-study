+def test_FR_043_leading_whitespace_cannot_be_carried_in_a_header(service):
+    """FR-043/FR-040: HTTP strips leading OWS from a header value — a transport property.
+
+    RFC 7230 defines a header field value as ``OWS field-value OWS``, so the parser removes
+    whitespace *before* the value. The consequence, recorded here rather than worked around:
+
+    * supplying ``" pw"`` for a paste whose password is ``"pw"`` succeeds, because the space
+      never reaches the service;
+    * a paste created with a *leading-whitespace* password therefore cannot be read through
+      the header at all.
+
+    Both follow from HTTP, not from the comparison, which trims nothing (see the test above).
+    Trailing whitespace is preserved by the parser and so is matched exactly.
+    """
+    ordinary = service.create(content="secret", password="pw")
+    assert service.read(ordinary["id"], " pw").status == 200
+    assert service.read(ordinary["id"], "pw ").status == 403
+
+    # FR-036 accepts it at creation — 1…128 characters, with no exclusions — but no client
+    # can present it, so the paste is effectively unreadable. Documented, not special-cased:
+    # trimming the stored side to compensate would break FR-043's "compared exactly".
+    unreachable = service.create(content="secret", password=" pw")
+    assert service.read(unreachable["id"], " pw").status == 403  # the space is stripped...
+    assert service.read(unreachable["id"], "pw").status == 403  # ...so both are the same read
+
+    # It is still deletable by its token, so nothing is permanently stuck (FR-045).
+    assert service.delete(unreachable["id"], unreachable["delete_token"]).status == 204
+
+
+def test_FR_043_a_password_outside_latin_1_cannot_be_carried_in_a_header(service):
+    """FR-040/FR-036: HTTP header values are latin-1 — a second transport property.
+
+    RFC 7230 restricts a field value to US-ASCII plus ``obs-text`` (latin-1), and
+    ``http.client`` enforces that by encoding header values as latin-1. So:
+
+    * a password of latin-1 characters (``ä``, ``í``, ``ö``) travels fine and matches exactly;
+    * a password containing anything outside latin-1 (CJK, emoji) cannot be put in the header
+      by a conforming client at all.
+
+    FR-036 accepts such a password at creation — it is a string of 1…128 characters — and
+    storage handles it correctly (see the previous test), so the limitation is the header, not
+    the service. Recorded rather than worked around: encoding the header value would change
+    the external contract, which FR-037/FR-054 pin.
+    """
+    latin1 = service.create(content="secret", password="näme ö í")
+    assert service.read(latin1["id"], "näme ö í").status == 200
+
+    wide = service.create(content="secret", password="日本語🌍")
+    with pytest.raises(UnicodeEncodeError):
+        service.read(wide["id"], "日本語🌍")
+
+    # It is still 403 to everything a client *can* send, and still deletable by its token.
+    assert service.read(wide["id"], "latin-1-only").status == 403
+    assert service.delete(wide["id"], wide["delete_token"]).status == 204
+
