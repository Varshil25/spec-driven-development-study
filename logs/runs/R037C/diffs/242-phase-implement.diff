@@ -0,0 +1,444 @@
+"""Burn-after-reading: the one-time read option.
+
+Owns these requirements (traceability table in
+``specs/002-burn-after-reading-password/quickstart.md``):
+
+* **FR-033** — absent ``burn_after_reading`` behaves as ``false``; explicit ``false`` is identical
+* **FR-034** — a non-boolean ``burn_after_reading`` is ``400`` naming the field
+* **FR-047** — the first successful read serves the paste exactly as an ordinary paste
+* **FR-048** — after that read, both read routes and a delete with the original token are ``404``
+* **FR-049** — at most one successful read under concurrency; no partial or corrupt content
+* **FR-050** — a refused read (``403``/``404``) consumes nothing
+* **FR-051** — a non-one-time paste reads an unlimited number of times
+* **FR-052** — an expired one-time paste is ``404`` and is never treated as having been read
+* **FR-053** — delete-before-read is ``204``; a missing/wrong token on an unread paste is ``403``
+
+Success criteria: **SC-011** (read twice per route), **SC-012** (200 pastes x 10 concurrent reads),
+**SC-019** (20 wrong passwords then one right one). **FR-059** error shapes are asserted inline.
+
+Test names carry their requirement id, as the existing suite does, so ``pytest -k FR_047``
+selects one requirement (Constitution III, SC-016).
+"""
+
+import concurrent.futures
+import json
+import os
+import threading
+import time
+
+import pytest
+
+from conftest import free_port
+
+# --- helpers ------------------------------------------------------------------------------
+
+
+def _assert_json_error(response, status):
+    """Assert the FR-059 error shape and return the message."""
+    assert response.status == status, (response.status, response.body)
+    assert response.headers["Content-Type"] == "application/json"
+    body = json.loads(response.body)
+    assert sorted(body) == ["error"]
+    return body["error"]
+
+
+def _records(data_dir):
+    """Return the record filenames in ``data_dir``."""
+    return sorted(entry.name for entry in os.scandir(str(data_dir)))
+
+
+def _stored_record(data_dir, paste_id):
+    """Return the on-disk record for ``paste_id`` as a dict."""
+    with open(os.path.join(str(data_dir), paste_id + ".json"), encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def _create_with_margin(service, content, margin=0.4, **fields):
+    """Create an expiring paste with enough life left to observe it before it goes.
+
+    ``created_at`` is truncated to whole seconds, so a paste created at ``t.95`` with a
+    1-second lifetime is readable for only ~50 ms. Waiting for the next second boundary first
+    makes the readable window the full lifetime (the idiom ``test_expiry.py`` already uses).
+
+    ``expires_at`` is taken from the **record on disk** rather than from a read response:
+    issuing a read here would consume a one-time paste and destroy the very thing the caller
+    is about to test.
+    """
+    for _ in range(5):
+        time.sleep(1.0 - (time.time() % 1.0) + 0.02)
+        created = service.create(content=content, expires_in=1, **fields)
+        expires_at = _stored_record(service.data_dir, created["id"])["expires_at"]
+        if expires_at - time.time() >= margin:
+            return created, expires_at
+        service.delete(created["id"], created["delete_token"])
+    pytest.fail("could not create an expiring paste with a usable margin")
+
+
+# --- T012 / FR-033: absent is false -------------------------------------------------------
+
+
+def test_FR_033_absent_burn_after_reading_behaves_as_false(service):
+    """FR-033: with the field absent the paste is ordinary and reads an unlimited number of times."""
+    created = service.create(content="ordinary")
+    for _ in range(5):
+        response = service.read(created["id"])
+        assert response.status == 200
+        assert json.loads(response.body)["burn_after_reading"] is False
+        assert service.read_raw(created["id"]).status == 200
+
+
+def test_FR_033_explicit_false_is_indistinguishable_from_absent(service):
+    """FR-033: explicit ``false`` and an absent field produce identical observable behaviour."""
+    absent = service.create(content="same")
+    explicit = service.create(content="same", burn_after_reading=False)
+
+    assert sorted(absent) == sorted(explicit) == ["delete_token", "id", "url"]
+
+    for created in (absent, explicit):
+        for _ in range(3):
+            body = json.loads(service.read(created["id"]).body)
+            assert body["burn_after_reading"] is False
+            assert body["content"] == "same"
+
+    # Byte-for-byte identical read bodies once the two ids are factored out.
+    absent_body = json.loads(service.read(absent["id"]).body)
+    explicit_body = json.loads(service.read(explicit["id"]).body)
+    del absent_body["id"], explicit_body["id"]
+    del absent_body["created_at"], explicit_body["created_at"]
+    assert absent_body == explicit_body
+
+
+def test_FR_033_explicit_true_is_reported_by_the_json_read(service):
+    """FR-033/FR-055: an enabled one-time paste reports the flag on its single read."""
+    created = service.create(content="once", burn_after_reading=True)
+    body = json.loads(service.read(created["id"]).body)
+    assert body["burn_after_reading"] is True
+    assert body["protected"] is False
+
+
+# --- T012 / FR-034: only a real JSON boolean is accepted ----------------------------------
+
+#: Every non-boolean shape FR-034 enumerates. ``1``/``0`` matter especially: in Python
+#: ``isinstance(True, int)`` is ``True``, so a check written against ``int`` would let numbers
+#: through (spec edge case "numbers are not booleans").
+_NON_BOOLEANS = [
+    "true",
+    "false",
+    "True",
+    "",
+    1,
+    0,
+    1.0,
+    0.0,
+    -1,
+    None,
+    [],
+    [True],
+    {},
+    {"value": True},
+]
+
+
+@pytest.mark.parametrize("bad", _NON_BOOLEANS)
+def test_FR_034_non_boolean_burn_after_reading_is_400_naming_the_field(service, bad):
+    """FR-034: a string, number, null, array, or object is 400 and names the field."""
+    error = _assert_json_error(
+        service.post_json({"content": "x", "burn_after_reading": bad}), 400
+    )
+    assert "burn_after_reading" in error
+
+
+def test_FR_034_SC_015_rejected_burn_after_reading_stores_nothing(service):
+    """FR-034/FR-038/SC-015: no rejected creation leaves a file in the data directory."""
+    assert _records(service.data_dir) == []
+    for bad in _NON_BOOLEANS:
+        assert service.post_json({"content": "x", "burn_after_reading": bad}).status == 400
+        assert _records(service.data_dir) == []
+
+
+def test_FR_034_both_boolean_values_are_accepted(service):
+    """FR-034: the two legitimate values are accepted and round-trip."""
+    for value in (True, False):
+        created = service.create(content="x", burn_after_reading=value)
+        assert json.loads(service.read(created["id"]).body)["burn_after_reading"] is value
+
+
+# --- T013 / FR-047: the first read is an ordinary read ------------------------------------
+
+
+def test_FR_047_first_json_read_serves_the_ordinary_response(service):
+    """FR-047: the single JSON read is indistinguishable from an ordinary paste's read."""
+    content = "recovery-code-8842\nsecond line\thello 🌍"
+    created = service.create(content=content, burn_after_reading=True)
+    ordinary = service.create(content=content)
+
+    burn_response = service.read(created["id"])
+    ordinary_response = service.read(ordinary["id"])
+
+    assert burn_response.status == ordinary_response.status == 200
+    assert burn_response.headers["Content-Type"] == ordinary_response.headers["Content-Type"]
+
+    burn_body = json.loads(burn_response.body)
+    assert burn_body["content"] == content
+    assert burn_body["id"] == created["id"]
+    assert burn_body["expires_at"] is None
+    assert "delete_token" not in burn_body
+    # Same field set as an ordinary paste: the flag differs, the shape does not (FR-054).
+    assert sorted(burn_body) == sorted(json.loads(ordinary_response.body))
+
+
+def test_FR_047_FR_056_first_raw_read_serves_the_content_byte_for_byte(service):
+    """FR-047/FR-056: the single raw read is the content and nothing else."""
+    content = "secret ü ß 日本語\n"
+    created = service.create(content=content, burn_after_reading=True)
+
+    response = service.read_raw(created["id"])
+    assert response.status == 200
+    assert response.body == content.encode("utf-8")
+    assert response.headers["Content-Type"] == "text/plain; charset=utf-8"
+    assert response.headers["Content-Length"] == str(len(content.encode("utf-8")))
+
+
+def test_FR_048_after_one_json_read_both_routes_and_delete_are_404(service):
+    """FR-048: one read, then every later read and the original delete token are all 404."""
+    created = service.create(content="once only", burn_after_reading=True)
+    assert service.read(created["id"]).status == 200
+
+    # Including the delete presenting the original token: the paste behaves as never having
+    # existed, so 404 wins over the 204 the token would otherwise buy (FR-048).
+    assert _assert_json_error(service.read(created["id"]), 404) == "paste not found"
+    assert _assert_json_error(service.read_raw(created["id"]), 404) == "paste not found"
+    _assert_json_error(service.delete(created["id"], created["delete_token"]), 404)
+
+
+def test_FR_048_consumed_on_raw_route_is_404_on_the_json_route(service):
+    """FR-048: the raw route consumes the paste for the JSON route too."""
+    created = service.create(content="raw first", burn_after_reading=True)
+    assert service.read_raw(created["id"]).status == 200
+    _assert_json_error(service.read(created["id"]), 404)
+    _assert_json_error(service.read_raw(created["id"]), 404)
+
+
+def test_FR_048_consumed_on_json_route_is_404_on_the_raw_route(service):
+    """FR-048: and the JSON route consumes it for the raw route — one read, either form."""
+    created = service.create(content="json first", burn_after_reading=True)
+    assert service.read(created["id"]).status == 200
+    _assert_json_error(service.read_raw(created["id"]), 404)
+
+
+def test_FR_048_the_record_is_gone_from_the_data_directory(service):
+    """FR-048: destruction is immediate and permanent — the record itself is removed."""
+    created = service.create(content="x", burn_after_reading=True)
+    assert _records(service.data_dir) == [created["id"] + ".json"]
+    assert service.read(created["id"]).status == 200
+    assert _records(service.data_dir) == []
+
+
+def test_FR_051_non_burn_paste_reads_repeatedly_on_both_routes(service):
+    """FR-051: a paste that is not one-time is readable an unlimited number of times."""
+    created = service.create(content="unlimited", burn_after_reading=False)
+    for _ in range(25):
+        assert service.read(created["id"]).status == 200
+        assert service.read_raw(created["id"]).body == b"unlimited"
+    assert _records(service.data_dir) == [created["id"] + ".json"]
+
+
+def test_SC_011_read_twice_per_route_yields_exactly_one_success(service):
+    """SC-011: for each route, the first read is 200 and the second is 404."""
+    for route in ("json", "raw"):
+        created = service.create(content=f"sweep-{route}", burn_after_reading=True)
+        first = service.read(created["id"]) if route == "json" else service.read_raw(created["id"])
+        assert first.status == 200, route
+
+        statuses = [
+            service.read(created["id"]).status,
+            service.read_raw(created["id"]).status,
+        ]
+        assert statuses == [404, 404], route
+
+
+# --- T014 / FR-050: a refused read costs nothing ------------------------------------------
+
+
+def test_FR_050_ill_shaped_identifier_404_leaves_the_one_read_available(service):
+    """FR-050: a 404 from an ill-shaped identifier consumes nothing."""
+    created = service.create(content="still here", burn_after_reading=True)
+
+    # A literal space is rejected by http.client before it reaches the wire, so the
+    # percent-encoded form is used instead (the server decodes before matching).
+    for hostile in ("../../etc/passwd", "has%20space", "has.dot", "x" * 65, "a/b"):
+        assert service.read(hostile).status == 404
+        assert service.read_raw(hostile).status == 404
+
+    # The never-issued-identifier case too, which does reach the filesystem.
+    assert service.read("neverissuedxxxxxxxxxx").status == 404
+
+    response = service.read(created["id"])
+    assert response.status == 200
+    assert json.loads(response.body)["content"] == "still here"
+
+
+def test_FR_050_wrong_password_403_leaves_the_one_read_available(service):
+    """FR-050: a 403 is refused *before* the claim, so a wrong password destroys nothing."""
+    created = service.create(content="both options", burn_after_reading=True, password="pw")
+
+    for attempt in (None, "", "wrong", ["pw", "pw"]):
+        assert service.read(created["id"], attempt).status == 403, attempt
+        assert service.read_raw(created["id"], attempt).status == 403, attempt
+
+    response = service.read(created["id"], "pw")
+    assert response.status == 200
+    assert json.loads(response.body)["content"] == "both options"
+    assert service.read(created["id"], "pw").status == 404
+
+
+def test_SC_019_twenty_wrong_passwords_then_one_correct_read(service):
+    """SC-019: 20 refusals cost nothing, then the one read is served, then it is gone."""
+    created = service.create(content="survives-20", burn_after_reading=True, password="pw")
+
+    statuses = [service.read(created["id"], "nope").status for _ in range(20)]
+    assert statuses == [403] * 20
+    assert _records(service.data_dir) == [created["id"] + ".json"]
+
+    assert json.loads(service.read(created["id"], "pw").body)["content"] == "survives-20"
+    assert service.read(created["id"], "pw").status == 404
+    assert _records(service.data_dir) == []
+
+
+# --- T014 / FR-052: expiry comes first ----------------------------------------------------
+
+
+def test_FR_052_expired_one_time_paste_is_404_and_is_not_consumed(service):
+    """FR-052: an expired one-time paste is 404 on both routes and never counts as read."""
+    created, expires_at = _create_with_margin(service, "transient", burn_after_reading=True)
+    time.sleep(max(0.0, expires_at - time.time()) + 0.2)
+
+    # Repeatedly 404 — if expiry were resolved after the claim, the first of these would
+    # have silently consumed the paste and the record would be gone.
+    for _ in range(3):
+        _assert_json_error(service.read(created["id"]), 404)
+        _assert_json_error(service.read_raw(created["id"]), 404)
+
+    # 001 leaves an expired record in place; the one-time rule must not have removed it.
+    assert _records(service.data_dir) == [created["id"] + ".json"]
+
+
+# --- T014 / FR-053: deletion before the read ----------------------------------------------
+
+
+def test_FR_053_delete_before_read_is_204_and_every_later_read_is_404(service):
+    """FR-053: a one-time paste still deletes by token before it has been read."""
+    created = service.create(content="deleted first", burn_after_reading=True)
+    assert service.delete(created["id"], created["delete_token"]).status == 204
+    _assert_json_error(service.read(created["id"]), 404)
+    _assert_json_error(service.read_raw(created["id"]), 404)
+    assert _records(service.data_dir) == []
+
+
+@pytest.mark.parametrize("token", [None, "", "wrong-token", "x" * 43])
+def test_FR_053_bad_token_on_an_unread_burn_paste_is_403_and_leaves_it_readable(service, token):
+    """FR-053: a missing or wrong token is 403 and does not consume the one read."""
+    created = service.create(content="still readable", burn_after_reading=True)
+    error = _assert_json_error(service.delete(created["id"], token), 403)
+    assert "X-Delete-Token" in error
+
+    response = service.read(created["id"])
+    assert response.status == 200
+    assert json.loads(response.body)["content"] == "still readable"
+
+
+# --- T015 / FR-049: at most one successful read under concurrency -------------------------
+
+
+def test_FR_049_SC_012_two_hundred_pastes_ten_concurrent_reads_each(service):
+    """FR-049/SC-012: 200 one-time pastes x 10 simultaneous reads → exactly one 200 each.
+
+    A ``Barrier`` makes the ten reads of a paste genuinely simultaneous rather than merely
+    submitted together, and the pool has exactly ten workers so all ten are occupied by the
+    same paste's reads. The served body is compared in full: FR-049 forbids partial or corrupt
+    content, not just a second success.
+    """
+    pastes = 200
+    readers = 10
+    contents = {}
+    for index in range(pastes):
+        content = f"paste-{index}:" + "x" * 500 + f":end-{index}"
+        created = service.create(content=content, burn_after_reading=True)
+        contents[created["id"]] = content
+
+    barrier = threading.Barrier(readers)
+
+    def read_once(paste_id):
+        barrier.wait()
+        response = service.read(paste_id)
+        return response.status, response.body
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=readers) as pool:
+        for paste_id, content in contents.items():
+            results = list(pool.map(read_once, [paste_id] * readers))
+
+            statuses = sorted(status for status, _ in results)
+            assert statuses == [200] + [404] * (readers - 1), (paste_id, statuses)
+
+            served = [body for status, body in results if status == 200]
+            assert json.loads(served[0])["content"] == content, paste_id
+
+            for status, body in results:
+                if status == 404:
+                    assert sorted(json.loads(body)) == ["error"]
+
+    # No paste is left behind: every one was served exactly once and then destroyed.
+    assert _records(service.data_dir) == []
+
+
+def test_FR_049_concurrent_reads_split_across_both_routes_still_yield_one_success(service):
+    """FR-049: the single read is one *per paste*, not one per route."""
+    created = service.create(content="either route", burn_after_reading=True)
+    barrier = threading.Barrier(10)
+
+    def read_once(index):
+        barrier.wait()
+        if index % 2:
+            response = service.read_raw(created["id"])
+        else:
+            response = service.read(created["id"])
+        return response.status
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=10) as pool:
+        statuses = sorted(pool.map(read_once, range(10)))
+    assert statuses == [200] + [404] * 9
+
+
+# --- T016 / FR-057: the option survives a restart -----------------------------------------
+
+
+def test_FR_057_SC_018_one_time_paste_survives_a_restart_in_process(service, in_process_factory):
+    """FR-057/SC-018: a one-time paste created before a restart is still consumed exactly once."""
+    created = service.create(content="durable burn", burn_after_reading=True)
+
+    second = in_process_factory(service.data_dir)
+    body = json.loads(second.read(created["id"]).body)
+    assert body["burn_after_reading"] is True
+    assert body["content"] == "durable burn"
+
+    # Consumed by that one read, on the first server as well as the second.
+    assert second.read(created["id"]).status == 404
+    assert service.read(created["id"]).status == 404
+
+
+def test_FR_057_SC_018_one_time_paste_survives_a_process_restart(launch, tmp_path):
+    """FR-057/SC-018: the same across a real stop-and-start of ``python -m pastebin serve``."""
+    data_dir = tmp_path / "pastes"
+    first = launch(data_dir=data_dir)
+    created = first.create(content="durable across processes", burn_after_reading=True)
+    assert first.stop() is not None
+
+    second = launch(data_dir=data_dir, port=free_port())
+    response = second.read(created["id"])
+    assert response.status == 200
+    assert json.loads(response.body)["burn_after_reading"] is True
+    assert json.loads(response.body)["content"] == "durable across processes"
+
+    assert second.read(created["id"]).status == 404
+    assert second.read_raw(created["id"]).status == 404
+    assert "skipping unreadable record" not in second.stderr
