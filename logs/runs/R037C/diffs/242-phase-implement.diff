+def test_FR_058_SC_017_fifty_legacy_records_read_back_unchanged(
+    service, in_process_factory, tmp_path
+):
+    """FR-058/SC-017: 50 previous-version records load unchanged and report both flags false.
+
+    Written in the exact shape 001 documented — no ``burn_after_reading``, no
+    ``password_salt``, no ``password_hash`` — then served by a server that starts over that
+    directory, so the startup scan is exercised too.
