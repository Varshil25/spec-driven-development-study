+def write_legacy_record(
+    data_dir, paste_id, content, created_at, expires_at=None, delete_token=None
+):
+    """Write one record in the **exact previous-version shape** and return its delete token.
+
+    The record carries ``version``, ``id``, ``content``, ``created_at``, ``expires_at``, and
+    ``delete_token`` and **none** of the three keys feature 002 adds — the shape pinned in
+    ``specs/002-burn-after-reading-password/data-model.md`` section 3.
+
+    This is the only honest way to test FR-058/SC-017: the previous version of the code is not
+    available in-tree to create records with, so the test writes the format it documented and
+    asserts the new reader loads it unchanged, reports neither flag, and never reports it as
+    unreadable on stderr.
+    """
+    if delete_token is None:
+        delete_token = "legacy-" + "x" * 36
+    record = {
+        "version": 1,
+        "id": paste_id,
+        "content": content,
+        "created_at": created_at,
+        "expires_at": expires_at,
+        "delete_token": delete_token,
+    }
+    path = os.path.join(str(data_dir), paste_id + ".json")
+    with open(path, "w", encoding="utf-8") as handle:
+        json.dump(record, handle)
+    return delete_token
+
