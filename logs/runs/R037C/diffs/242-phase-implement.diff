+def test_FR_043_comparison_is_exact_with_no_normalisation(service):
+    """FR-043/Story 2 scenario 13: a visually similar password fails; the exact one works."""
+    password = "näme wíth spaces!"
+    created = service.create(content="secret", password=[REDACTED:assigned_secret])
+
+    # Same characters to the eye, different code points or whitespace. Two variants are
+    # deliberately absent and are asserted below the HTTP layer instead: a *leading* space
+    # (stripped by the header parser) and the NFD form (not latin-1, so unsendable). See
+    # the two transport tests that follow.
+    for similar in (
+        "name wíth spaces!",  # plain n
+        "näme with spaces!",  # plain i
+        "näme  wíth spaces!",  # doubled interior space
+        "näme wíth spaces! ",  # trailing space
+        "NÄME WÍTH SPACES!",  # case
+    ):
+        assert service.read(created["id"], similar).status == 403, similar
+
+    # And the exact password — non-ASCII, spaces, and punctuation included — is served.
+    assert service.read(created["id"], password).status == 200
