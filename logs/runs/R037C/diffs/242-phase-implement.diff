+def test_FR_058_S_10_malformed_new_keys_are_reported_and_skipped(launch, tmp_path):
+    """Spec edge case/S-10: a malformed new key is reported on stderr and the record skipped.
+
+    Never coerced to a default: silently serving a paste that was created as one-time an
+    unlimited number of times is the "silent wrong answer" Constitution II calls the
+    highest-severity defect.
+    """
+    data_dir = tmp_path / "malformed"
+    data_dir.mkdir()
+    now = int(time.time())
+    for paste_id, overrides in MALFORMED.items():
+        assert storage.is_valid_id(paste_id), paste_id
+        _write_raw_record(data_dir, paste_id, {**_legacy_shape(paste_id, now), **overrides})
+
+    # One good record alongside, to prove a bad entry never blocks a usable one (S-6).
+    good = {**_legacy_shape("goodrecordxxxxxxxxxxxx", now), "content": "served"}
+    _write_raw_record(data_dir, "goodrecordxxxxxxxxxxxx", good)
+
+    service = launch(data_dir=data_dir)
+
+    for paste_id in MALFORMED:
+        assert f"{paste_id}.json" in service.stderr, paste_id
+        assert service.read(paste_id).status == 404, paste_id
+        assert service.read_raw(paste_id).status == 404, paste_id
+        assert service.read(paste_id, "any").status == 404, paste_id
+        # Reported at startup by scan_directory, through the same reader the read path uses.
+        assert "skipping unreadable record" in service.stderr
+
+    assert json.loads(service.read("goodrecordxxxxxxxxxxxx").body)["content"] == "served"
+
+    # The malformed records are left on disk, not repaired and not deleted.
+    assert len(_records(data_dir)) == len(MALFORMED) + 1
