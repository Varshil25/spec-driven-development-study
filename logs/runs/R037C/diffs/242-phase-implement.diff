+"""Password protection: the ``X-Paste-Password`` read gate.
+
+Owns these requirements (traceability table in
+``specs/002-burn-after-reading-password/quickstart.md``):
+
+* **FR-035** — a 1- and a 128-character password are accepted; the paste reports ``protected``
+* **FR-036** — a non-string, ``""``, and 129 characters are each ``400`` naming the field
+* **FR-040** — the correct header serves ``200`` on both read routes
+* **FR-041** — absent / empty / wrong / duplicated / foreign password is ``403``, paste still readable
+* **FR-042** — ``404`` always beats ``403``: unknown, deleted, expired, ill-shaped ids are ``404``
+* **FR-043** — verification is constant-time over derived values
+* **FR-044** — an unprotected paste ignores a stray ``X-Paste-Password``
+* **FR-045** — deletion stays token-only; a password is never authorisation
+* **FR-046** — the password is never disclosed and never stored recoverably
+
+Success criteria: **SC-013** (refusal sweep), **SC-014** (404-beats-403 sweep), **SC-019**
+(a refused read costs nothing), **SC-020** (no response anywhere contains a password).
+**FR-059** error shapes are asserted inline.
+
+Test names carry their requirement id, as the existing suite does, so ``pytest -k FR_041``
+selects one requirement (Constitution III, SC-016).
+"""
+
+import json
+import os
+import secrets
+import time
+
+import pytest
+
+from conftest import free_port
+from pastebin import storage
+
+#: Passwords for SC-020's disclosure sweep. Each is a **distinctive sentinel**, so a substring
+#: match in any response is genuine disclosure rather than coincidence. Short passwords are
+#: excluded on purpose: a 1- or 2-character string occurs incidentally inside random
+#: identifiers and deletion tokens, which would make the sweep assert nothing. Their
+#: non-disclosure is covered structurally instead — the ``201`` body has exactly three keys
+#: (FR-037), the read body exactly six (FR-054), and the record holds only a salt and a
+#: derivation (FR-046).
+PASSWORDS = [
+    "hunter2-sentinel-9f3a",
+    "näme wíth spaces!-sentinel-b71c",
+    "P@ss word/42-sentinel-c04e",
+    "x" * 128,
+    "ö" * 128,
+]
+
+
+# --- helpers ------------------------------------------------------------------------------
+
+
+def _assert_json_error(response, status):
+    """Assert the FR-059 error shape and return the message."""
+    assert response.status == status, (response.status, response.body)
+    assert response.headers["Content-Type"] == "application/json"
+    body = json.loads(response.body)
+    assert sorted(body) == ["error"]
+    return body["error"]
+
+
+def _records(data_dir):
+    return sorted(entry.name for entry in os.scandir(str(data_dir)))
+
+
+def _stored_record(data_dir, paste_id):
+    with open(os.path.join(str(data_dir), paste_id + ".json"), encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def _create_with_margin(service, content, margin=0.4, **fields):
+    """Create an expiring paste with a usable readable window (``test_expiry.py`` idiom).
+
+    ``expires_at`` is read off the record rather than from a read response, so the helper
+    works for a one-time paste too.
+    """
+    for _ in range(5):
+        time.sleep(1.0 - (time.time() % 1.0) + 0.02)
+        created = service.create(content=content, expires_in=1, **fields)
+        expires_at = _stored_record(service.data_dir, created["id"])["expires_at"]
+        if expires_at - time.time() >= margin:
+            return created, expires_at
+        service.delete(created["id"], created["delete_token"])
+    pytest.fail("could not create an expiring paste with a usable margin")
+
+
+# --- T022 / FR-035: accepted passwords ----------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "password",
+    [
+        "a",  # exactly PASSWORD_MIN_CHARS
+        "pw",
+        "hunter2",
+        "näme wíth spaces!",
+        "P@ss word/42",
+        "x" * 128,  # exactly PASSWORD_MAX_CHARS, single-byte
+        "ö" * 128,  # exactly 128 *characters*, 256 UTF-8 bytes (FR-036, V-13)
+    ],
+)
+def test_FR_035_accepted_passwords_make_the_paste_protected(service, password):
+    """FR-035: 1…128 characters inclusive is accepted and the paste reports protected."""
+    created = service.create(content="secret", password=[REDACTED:assigned_secret])
+    assert sorted(created) == ["delete_token", "id", "url"]
+
+    body = json.loads(service.read(created["id"], password).body)
+    assert body["protected"] is True
+    assert body["content"] == "secret"
+
+
+def test_FR_035_V_13_length_is_counted_in_characters_not_bytes(service):
+    """FR-035/FR-036: a 128-character multi-byte password is accepted though its encoding is longer.
+
+    Deliberately unlike ``content``, whose limit is measured in UTF-8 bytes (R-019).
+    """
+    password = "ö" * 128
+    assert len(password) == 128
+    assert len(password.encode("utf-8")) == 256
+
+    created = service.create(content="x", password=[REDACTED:assigned_secret])
+    assert service.read(created["id"], password).status == 200
+
