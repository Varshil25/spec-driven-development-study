+def test_FR_043_comparison_goes_through_secrets_compare_digest(monkeypatch, tmp_path):
+    """FR-043: the password check uses secrets.compare_digest, not ==.
+
+    Asserted directly rather than by timing, which is unreliable in a test suite: a timing
+    measurement would be flaky, while the primitive being used is exactly the requirement.
+    Mirrors ``test_delete.py``'s FR-015 test.
+    """
+    calls = []
+    real = secrets.compare_digest
+
+    def spy(a, b):
+        calls.append((a, b))
+        return real(a, b)
+
+    monkeypatch.setattr(storage.secrets, "compare_digest", spy)
+    paste = storage.create_paste(str(tmp_path), "secret", password="hunter2")
+    assert storage.password_matches(paste, "hunter2") is True
+    assert calls, "password_matches did not call secrets.compare_digest"
+
+    # The comparison is over *derived* values, not over the password itself.
+    for left, right in calls:
+        assert "hunter2" not in str(left)
+        assert "hunter2" not in str(right)
+    assert storage.password_matches(paste, "wrong") is False
+
+
