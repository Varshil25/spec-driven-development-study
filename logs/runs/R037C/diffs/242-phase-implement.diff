+def test_SC_020_FR_046_no_response_anywhere_contains_a_password(service):
+    """SC-020: every response at every status is searched for every password used here.
+
+    Bodies **and** headers, across creation, both read routes, deletion, and an undefined
+    route, at 200/201/204/400/403/404.
+    """
+    responses = []
+
+    for password in PASSWORDS:
+        created = service.post_json({"content": "secret", "password": password})
+        responses.append(created)
+        assert created.status == 201
+        paste_id = json.loads(created.body)["id"]
+        token=[REDACTED:assigned_secret](created.body)["delete_token"]
+
+        responses.append(service.read(paste_id))  # 403, no header
+        responses.append(service.read(paste_id, ""))  # 403, empty
+        responses.append(service.read(paste_id, "wrong"))  # 403, mismatch
+        responses.append(service.read(paste_id, [password, password]))  # 403, duplicated
+        responses.append(service.read(paste_id, password))  # 200
+        responses.append(service.read_raw(paste_id, password))  # 200
+        responses.append(service.read("neverissuedxxxxxxxxxx", password))  # 404
+        responses.append(service.request("GET", "/undefined", headers={"X-Paste-Password": password}))
+        responses.append(service.delete(paste_id, None, password))  # 403, token missing
+        responses.append(service.delete(paste_id, token, password))  # 204
+        responses.append(service.read(paste_id, password))  # 404, now deleted
+
+    # Rejections too: the echoed-back diagnostic must not quote the password.
+    for password in PASSWORDS:
+        responses.append(service.post_json({"content": "x" * 70000, "password": password}))
+        responses.append(service.post_json({"content": 1, "password": password}))
+        responses.append(service.post_json({"content": "x", "password": password + "x" * 200}))
+
+    assert len(responses) > 50
+    for response in responses:
+        haystack = response.body + str(response.headers).encode("utf-8")
+        for password in PASSWORDS:
+            assert password.encode("utf-8") not in haystack, (
+                response.status,
+                password,
+                response.body[:200],
+            )
