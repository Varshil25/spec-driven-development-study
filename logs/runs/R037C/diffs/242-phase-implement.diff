+def test_FR_043_no_trimming_happens_in_the_comparison_itself(tmp_path):
+    """FR-043: ``password_matches`` trims nothing — asserted below the HTTP layer.
+
+    The service does no trimming, case folding, or normalisation of its own (R-016, spec
+    assumption). This is asserted directly against storage because HTTP itself strips
+    *leading* whitespace from a header value, which would otherwise mask the property; see
+    :func:`test_FR_043_leading_whitespace_cannot_be_carried_in_a_header`.
+    """
+    paste = storage.create_paste(str(tmp_path), "x", password="pw")
+    for supplied in (" pw", "pw ", " pw ", "\tpw", "PW", "p w"):
+        assert storage.password_matches(paste, supplied) is False, supplied
+    assert storage.password_matches(paste, "pw") is True
+
+    leading = storage.create_paste(str(tmp_path), "x", password=" pw")
+    assert storage.password_matches(leading, " pw") is True
+    assert storage.password_matches(leading, "pw") is False
+
+    # No Unicode normalisation either: NFC and NFD of the same text are different passwords.
+    nfc = storage.create_paste(str(tmp_path), "x", password="näme")
+    assert storage.password_matches(nfc, "näme") is True
+    assert storage.password_matches(nfc, "näme") is False  # NFD
+
+    # And a password outside latin-1 is stored and matched perfectly well at this layer; it is
+    # only the header that cannot carry it (see the next test).
+    wide = storage.create_paste(str(tmp_path), "x", password="日本語🌍")
+    assert storage.password_matches(wide, "日本語🌍") is True
+    assert storage.password_matches(wide, "日本語") is False
+
