+"""The command line, the output streams, and the exit statuses.
+
+Covers FR-001…FR-006 and FR-044. Every failure mode asserts both the message and the exit status
+(Constitution Principle II and III): ``2`` for an invalid command line, ``1`` for a startup
+failure.
+"""
+
+import signal
+import socket
+import struct
+import time
+
+import pytest
+
+from conftest import READY_PREFIX, free_port, run_cli
+
+
+def test_fr001_serve_accepts_port_and_data(server_process, tmp_path):
+    """FR-001: the service starts from a command naming a port and a storage location."""
+    data_dir = tmp_path / "snippets"
+    service = server_process(data_dir=data_dir)
+
+    assert service.stdout_lines == [f"{READY_PREFIX}{service.port}"]
+    assert data_dir.is_dir()
+    # The socket really is serving: a request for an identifier never issued is answered.
+    assert service.read("neverIssuedIdentifier").status == 404
+
+
+def test_fr002_listens_on_loopback_only(service):
+    """FR-002: requests are accepted only on the loopback interface, at the requested port."""
+    assert service.httpd.server_address[0] == "127.0.0.1"
+    assert service.read("neverIssuedIdentifier").status == 404
+
+    # 127.0.0.2 is also local on Linux, but nothing is listening on it: binding 127.0.0.1
+    # exposes that one address and no other.
+    with socket.socket() as sock:
+        sock.settimeout(5)
+        with pytest.raises(ConnectionRefusedError):
+            sock.connect(("127.0.0.2", service.port))
+
+
+def test_fr003_creates_missing_data_dir_including_parents(server_process, tmp_path):
+    """FR-003: a storage location that does not exist is created, missing parents included."""
+    data_dir = tmp_path / "absent" / "parents" / "pastes"
+    assert not data_dir.parent.parent.exists()
+
+    service = server_process(data_dir=data_dir)
+
+    assert service.wait_ready()
+    assert data_dir.is_dir()
+
+
+def test_fr004_ready_line_printed_once_after_socket_accepts(server_process):
+    """FR-004: one ready line naming the actual port, printed only once the socket accepts."""
+    service = server_process()
+
+    assert service.stdout_lines == [f"listening on 127.0.0.1:{service.port}"]
+    # The line is the start signal: the socket is already accepting when it appears, with no
+    # sleep or retry needed here.
+    assert service.read("neverIssuedIdentifier").status == 404
+
+    for _ in range(5):
+        service.post_json({"content": "hello"})
+        service.read("neverIssuedIdentifier")
+    assert len(service.stdout_lines) == 1
+
+
+def test_fr005_port_in_use_exits_nonzero_without_ready_line(server_process, tmp_path):
+    """FR-005: an unbindable port is reported on stderr and exits non-zero, with no ready line."""
+    first = server_process(data_dir=tmp_path / "first")
+
+    second = server_process(
+        data_dir=tmp_path / "second", port=first.port, expect_ready=False
+    )
+    status = second.wait_exit()
+
+    assert status == 1
+    assert second.stdout_lines == []
+    assert len(second.stderr_lines) == 1
+    assert str(first.port) in second.stderr_lines[0]
+    assert "listening" not in "".join(second.stdout_lines)
+    # The first service is unaffected and still serving.
+    assert first.read("neverIssuedIdentifier").status == 404
+
+
+@pytest.mark.parametrize("kind", ["parent-is-a-file", "path-is-a-file"])
+def test_fr005_unwritable_data_dir_exits_nonzero(server_process, tmp_path, kind):
+    """FR-005: a storage location that cannot be created or written is a non-zero exit."""
+    blocker = tmp_path / "blocker"
+    blocker.write_text("not a directory")
+    data_dir = blocker / "pastes" if kind == "parent-is-a-file" else blocker
+
+    service = server_process(data_dir=data_dir, expect_ready=False)
+    status = service.wait_exit()
+
+    assert status == 1
+    assert service.stdout_lines == []
+    assert len(service.stderr_lines) == 1
+    assert str(data_dir) in service.stderr_lines[0]
+
+
+def test_fr006_rejects_missing_port(tmp_path):
+    """FR-006: a missing port is a usage error on stderr with exit status 2."""
+    result = run_cli("serve", "--data", str(tmp_path / "pastes"))
+
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "--port" in result.stderr
+
+
+@pytest.mark.parametrize("value", ["abc", "", "8080.5", "0x50", "eight"])
+def test_fr006_rejects_non_numeric_port(tmp_path, value):
+    """FR-006: a non-numeric port is a usage error naming the argument, with exit status 2."""
+    result = run_cli("serve", "--port", value, "--data", str(tmp_path / "pastes"))
+
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "--port" in result.stderr
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "65536", "999999"])
+def test_fr006_rejects_out_of_range_port(tmp_path, value):
+    """FR-006: a port outside 1…65535 is a usage error with exit status 2."""
+    result = run_cli("serve", "--port", value, "--data", str(tmp_path / "pastes"))
+
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "--port" in result.stderr
+
+
+def test_fr006_rejects_missing_data():
+    """FR-006: a missing storage location is a usage error naming the argument, exit status 2."""
+    result = run_cli("serve", "--port", str(free_port()))
+
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "--data" in result.stderr
+
+
+@pytest.mark.parametrize("args", [(), ("listen",), ("--port", "8080")])
+def test_fr006_rejects_missing_or_unknown_subcommand(args):
+    """FR-006: no subcommand, or one the service does not define, is a usage error."""
+    result = run_cli(*args)
+
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr != ""
+
+
+def test_fr044_stdout_contains_only_the_ready_line(server_process):
+    """FR-044: standard output never carries anything but the single ready line."""
+    service = server_process()
+
+    service.publish("a snippet")
+    service.post_raw(b"not json")
+    service.read("neverIssuedIdentifier")
+    service.request("PUT", "/pastes")
+    service.get("/")
+    service.delete("neverIssuedIdentifier", token="wrong")
+
+    assert service.stop(signal.SIGINT) == 0
+    assert service.stdout_lines == [f"{READY_PREFIX}{service.port}"]
+
+
+def test_fr044_stderr_silent_across_valid_and_invalid_traffic(server_process):
+    """FR-044: no per-request lines reach standard error, whatever the status."""
+    service = server_process()
+
+    published = service.publish("a snippet")
+    service.read(published["id"])
+    service.read_raw(published["id"])
+    service.post_raw(b"{ not json")
+    service.post_json([1, 2, 3])
+    service.post_json({"content": 42})
+    service.post_json({"content": "x", "expires_in": 0})
+    service.read("neverIssuedIdentifier")
+    service.delete(published["id"], token="wrong")
+    service.request("OPTIONS", "/pastes")
+    service.get("/pastes/%s/extra" % published["id"])
+    service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"])
+
+    assert service.stop(signal.SIGINT) == 0
+    assert service.stderr_lines == []
+
+
+@pytest.mark.parametrize(
+    "request_bytes",
+    [
+        b"GET /pastes/{id}/raw HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n",
+        b"GET /pastes/{id} HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n",
+        b"POST /pastes HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Length: 50\r\n\r\n",
+        b"GET /pas",
+    ],
+    ids=["abandon-raw-read", "abandon-read", "abandon-body", "abandon-request-line"],
+)
+def test_fr044_stderr_silent_when_a_caller_abandons_the_connection(
+    server_process, request_bytes
+):
+    """FR-044 and SC-009: a caller that resets its connection produces no output at all.
+
+    A reset is ordinary client behaviour, not a failure of this service, so it must not reach
+    standard error — and ``socketserver`` would print a traceback for it by default.
+    """
+    service = server_process()
+    published = service.publish("z" * 65536)  # too large to sit in a socket buffer
+
+    sock = socket.create_connection(("127.0.0.1", service.port), timeout=10)
+    try:
+        # SO_LINGER with a zero timeout makes close() send RST instead of FIN.
+        sock.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
+        sock.sendall(request_bytes.replace(b"{id}", published["id"].encode()))
+    finally:
+        sock.close()
+    time.sleep(0.5)
+
+    # The service is unharmed and still answering.
+    assert service.read(published["id"]).status == 200
+
+    assert service.stop(signal.SIGINT) == 0
+    assert service.stderr_lines == []
+    assert service.stdout_lines == [f"{READY_PREFIX}{service.port}"]
+
+
+@pytest.mark.parametrize("sig", [signal.SIGINT, signal.SIGTERM])
+def test_cli_exits_zero_on_clean_interrupt(server_process, sig):
+    """contracts/cli.md: an interrupt stops the service, exits 0, and writes nothing further."""
+    service = server_process()
+
+    status = service.stop(sig)
+
+    assert status == 0
+    assert service.stderr_lines == []
+    assert service.stdout_lines == [f"{READY_PREFIX}{service.port}"]
diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..8aa4090
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,193 @@
+"""Concurrency and partial-read safety.
+
+Covers FR-042 and FR-043, and the ten-overlapping-callers figure of SC-010: a caller that goes
+quiet must not delay anyone, and a snippet must never be observed half-written or half-deleted.
+"""
+
+import socket
+import threading
+import time
+
+from conftest import Client
+from pastebin import store
+
+BIG_CONTENT = "y" * store.MAX_CONTENT_BYTES
+
+
+def test_fr042_quiet_client_does_not_block_other_requests(service):
+    """FR-042: a connection that declares a body and then sends nothing delays nobody."""
+    published = service.publish("served while another caller is quiet")
+
+    quiet = socket.create_connection(("127.0.0.1", service.port), timeout=30)
+    try:
+        quiet.sendall(
+            b"POST /pastes HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Length: 50\r\n\r\n"
+        )
+        # Nothing further is ever sent on this connection.
+
+        started = time.monotonic()
+        assert service.read(published["id"]).status == 200
+        assert service.publish("published meanwhile")
+        assert service.read_raw(published["id"]).status == 200
+        elapsed = time.monotonic() - started
+
+        # Well under the service's own 10-second per-connection timeout.
+        assert elapsed < 2.0, elapsed
+    finally:
+        quiet.close()
+
+
+def test_fr042_overlapping_requests_are_served_concurrently(service):
+    """FR-042 and SC-010: ten callers publishing, reading, and deleting at once all succeed."""
+    callers = 10
+    failures = []
+    published = {}
+    barrier = threading.Barrier(callers)
+
+    def caller(index):
+        client = Client(service.port)
+        try:
+            barrier.wait(timeout=30)
+            content = f"caller {index} content"
+            created = client.post_json({"content": content})
+            assert created.status == 201, created
+            snippet = created.json()
+            published[index] = snippet
+
+            read = client.read(snippet["id"])
+            assert read.status == 200, read
+            assert read.json()["content"] == content, read.json()
+            assert client.read_raw(snippet["id"]).body == content.encode("utf-8")
+
+            assert client.delete(snippet["id"], token="wrong").status == 403
+            assert (
+                client.delete(snippet["id"], token=snippet["delete_token"]).status == 204
+            )
+            assert client.read(snippet["id"]).status == 404
+        # Recorded rather than swallowed: the assertion below re-raises it in the main thread,
+        # because an exception in a worker thread would otherwise go unnoticed.
+        except Exception as error:
+            failures.append((index, repr(error)))
+
+    started = time.monotonic()
+    threads = [threading.Thread(target=caller, args=(index,)) for index in range(callers)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=60)
+    elapsed = time.monotonic() - started
+
+    assert failures == []
+    assert not any(thread.is_alive() for thread in threads)
+    assert len(published) == callers
+    assert len({snippet["id"] for snippet in published.values()}) == callers
+    assert elapsed < 30, elapsed
+
+
+def test_fr043_reader_never_sees_partially_written_paste(service):
+    """FR-043: a concurrent reader sees a published snippet complete or not at all."""
+    rounds = 25
+    failures = []
+    identifiers = []
+    done = threading.Event()
+
+    def publisher():
+        try:
+            for _ in range(rounds):
+                snippet = service.publish(BIG_CONTENT)
+                identifiers.append(snippet["id"])
+        except Exception as error:  # recorded, then asserted on in the main thread
+            failures.append(("publisher", repr(error)))
+        finally:
+            done.set()
+
+    def reader():
+        client = Client(service.port)
+        try:
+            while not done.is_set() or identifiers:
+                if not identifiers:
+                    time.sleep(0.001)
+                    continue
+                paste_id = identifiers[-1]
+                response = client.read(paste_id)
+                if response.status == 404:
+                    continue  # Published a moment from now; absence is allowed.
+                assert response.status == 200, response
+                assert response.json()["content"] == BIG_CONTENT, "truncated content"
+                raw = client.read_raw(paste_id)
+                assert raw.status == 200, raw
+                assert raw.body == BIG_CONTENT.encode("utf-8"), "truncated raw body"
+                if done.is_set():
+                    break
+        except Exception as error:  # recorded, then asserted on in the main thread
+            failures.append(("reader", repr(error)))
+
+    threads = [threading.Thread(target=publisher)] + [
+        threading.Thread(target=reader) for _ in range(3)
+    ]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=120)
+
+    assert failures == []
+    assert len(identifiers) == rounds
+    # No temporary file is left behind by a completed publication.
+    assert [path.name for path in service.data_dir.iterdir() if path.name.startswith(".tmp-")] == []
+
+
+def test_fr043_delete_during_read_yields_whole_or_404(service):
+    """FR-043: deleting a snippet while it is read yields the whole snippet or 404."""
+    count = 30
+    snippets = [service.publish(BIG_CONTENT) for _ in range(count)]
+    failures = []
+    statuses = []
+    start = threading.Barrier(3)
+
+    def deleter():
+        client = Client(service.port)
+        try:
+            start.wait(timeout=30)
+            for snippet in snippets:
+                response = client.delete(snippet["id"], token=snippet["delete_token"])
+                assert response.status in (204, 404), response
+        except Exception as error:  # recorded, then asserted on in the main thread
+            failures.append(("deleter", repr(error)))
+
+    def reader():
+        client = Client(service.port)
+        try:
+            start.wait(timeout=30)
+            for snippet in snippets:
+                for _ in range(2):
+                    response = client.read(snippet["id"])
+                    statuses.append(response.status)
+                    if response.status == 200:
+                        assert response.json()["content"] == BIG_CONTENT, "truncated"
+                    else:
+                        assert response.status == 404, response
+                        assert response.json()["error"] == "not found"
+                    raw = client.read_raw(snippet["id"])
+                    statuses.append(raw.status)
+                    if raw.status == 200:
+                        assert raw.body == BIG_CONTENT.encode("utf-8"), "truncated raw"
+                    else:
+                        assert raw.status == 404, raw
+        except Exception as error:  # recorded, then asserted on in the main thread
+            failures.append(("reader", repr(error)))
+
+    threads = [
+        threading.Thread(target=deleter),
+        threading.Thread(target=reader),
+        threading.Thread(target=reader),
+    ]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=120)
+
+    assert failures == []
+    assert set(statuses) <= {200, 404}
+    # Every snippet is gone once the dust settles, and nothing was corrupted on the way.
+    for snippet in snippets:
+        assert service.read(snippet["id"]).status == 404
diff --git a/tests/test_damaged_storage.py b/tests/test_damaged_storage.py
new file mode 100644
index 0000000..4d6dcac
--- /dev/null
+++ b/tests/test_damaged_storage.py
@@ -0,0 +1,185 @@
+"""Damaged storage.
+
+Covers FR-038 and FR-039: a stored record that cannot be read or parsed is an internal error for
+that identifier alone, never "not found", with a diagnostic naming the snippet on standard error —
+and storage is never inspected at startup to look for the condition.
+
+Damaged records are constructed by hand against the published on-disk contract
+(contracts/storage.md), which is also what a hand-edited file would look like.
+"""
+
+import json
+import time
+
+import pytest
+
+from pastebin import store
+
+GOOD_RECORD = {
+    "id": "aGoodStoredPasteRecord",
+    "content": "intact",
+    "created_at": "2026-10-23T20:15:00Z",
+    "expires_at": None,
+    "delete_token": "a-token-for-the-intact-record",
+}
+
+
+def damaged_forms(paste_id):
+    """Every way a stored record can be damaged, as raw bytes to write in its place."""
+    return {
+        "truncated": b'{"id": "' + paste_id.encode() + b'", "content": "he',
+        "invalid-json": b"not json at all",
+        "not-an-object": b'["id", "content"]',
+        "missing-keys": json.dumps({"id": paste_id, "content": "x"}).encode(),
+        "extra-key": json.dumps(
+            {**GOOD_RECORD, "id": paste_id, "surprise": 1}
+        ).encode(),
+        "non-string-content": json.dumps({**GOOD_RECORD, "id": paste_id, "content": 42}).encode(),
+        "empty-delete-token": json.dumps(
+            {**GOOD_RECORD, "id": paste_id, "delete_token": ""}
+        ).encode(),
+        "bad-timestamp": json.dumps(
+            {**GOOD_RECORD, "id": paste_id, "created_at": "2026-13-45T99:99:99Z"}
+        ).encode(),
+        "offset-timestamp": json.dumps(
+            {**GOOD_RECORD, "id": paste_id, "created_at": "2026-10-23T20:15:00+00:00"}
+        ).encode(),
+        "wrong-identifier": json.dumps({**GOOD_RECORD, "id": "someOtherIdentifier"}).encode(),
+        "not-utf8": b'{"id": "\xff\xfe", "content": "x"}',
+        "empty-file": b"",
+    }
+
+
+def test_fr038_damaged_record_is_500_not_404(service):
+    """FR-038: an unreadable record is an internal error, not "not found"."""
+    service.write_raw_record("aDamagedPasteRecord", b"not json at all")
+
+    for response in (
+        service.read("aDamagedPasteRecord"),
+        service.read_raw("aDamagedPasteRecord"),
+        service.delete("aDamagedPasteRecord", token=[REDACTED:assigned_secret]),
+        service.delete("aDamagedPasteRecord"),
+    ):
+        assert response.status == 500, response
+        assert response.json()["error"]
+
+
+def test_fr038_damaged_record_is_500_when_unreadable_as_a_file(service):
+    """FR-038: an ``OSError`` reading the record is damage too, not absence."""
+    # A directory where a record should be: the read fails with IsADirectoryError.
+    service.record_path("aPasteThatIsADirectory").mkdir()
+
+    response = service.read("aPasteThatIsADirectory")
+
+    assert response.status == 500
+    assert response.json()["error"]
+
+
+@pytest.mark.parametrize("form", sorted(damaged_forms("x")))
+def test_fr039_damaged_record_500_body_has_error_field(service, form):
+    """FR-039: every kind of damage is a 500 carrying the standard single-error-field body."""
+    paste_id = "aDamagedPasteRecord"
+    service.write_raw_record(paste_id, damaged_forms(paste_id)[form])
+
+    response = service.read(paste_id)
+
+    assert response.status == 500, form
+    body = response.json()
+    assert set(body) == {"error"}
+    assert isinstance(body["error"], str) and body["error"]
+    # No filesystem path or exception text is disclosed to the caller.
+    assert str(service.data_dir) not in body["error"]
+    assert paste_id not in body["error"]
+
+
+def test_fr038_diagnostic_names_the_paste_on_stderr(server_process, tmp_path):
+    """FR-038: a diagnostic naming the affected snippet is written to standard error."""
+    data_dir = tmp_path / "pastes"
+    data_dir.mkdir(parents=True)
+    paste_id = "aDamagedPasteRecord"
+    (data_dir / f"{paste_id}.json").write_bytes(b"not json at all")
+
+    service = server_process(data_dir=data_dir)
+    assert service.read(paste_id).status == 500
+
+    line = service.wait_for_stderr(paste_id)
+    assert line is not None, f"no diagnostic naming {paste_id}: {service.stderr_lines}"
+    assert "json" in line.lower() or "read" in line.lower()
+    # The ready line is still the only thing on standard output.
+    assert len(service.stdout_lines) == 1
+
+
+def test_fr038_other_pastes_unaffected(service):
+    """FR-038: damage is confined to the snippet whose record is damaged."""
+    intact = service.publish("intact text")
+    service.write_raw_record("aDamagedPasteRecord", b"{ truncated")
+
+    assert service.read("aDamagedPasteRecord").status == 500
+
+    # Reading, publishing, and deleting other snippets all keep working.
+    assert service.read(intact["id"]).json()["content"] == "intact text"
+    another = service.publish("published after the damage was seen")
+    assert service.read(another["id"]).status == 200
+    assert service.delete(intact["id"], token=intact["delete_token"]).status == 204
+    assert service.read("neverIssuedIdentifier").status == 404
+
+
+def test_fr038_startup_does_not_scan_storage(server_process, tmp_path):
+    """FR-038 and SC-007: startup inspects nothing, so damage is found only when asked for."""
+    data_dir = tmp_path / "pastes"
+    data_dir.mkdir(parents=True)
+
+    good_ids = []
+    for index in range(900):
+        paste_id = f"storedPasteNumber{index:04d}"
+        good_ids.append(paste_id)
+        (data_dir / f"{paste_id}.json").write_text(
+            json.dumps(
+                {
+                    "id": paste_id,
+                    "content": f"snippet {index}",
+                    "created_at": "2026-10-23T20:15:00Z",
+                    "expires_at": None,
+                    "delete_token": f"token-{index}",
+                }
+            ),
+            encoding="utf-8",
+        )
+    for index in range(100):
+        (data_dir / f"damagedPasteNumber{index:04d}.json").write_bytes(b"{ truncated")
+
+    started = time.monotonic()
+    service = server_process(data_dir=data_dir)
+    elapsed = time.monotonic() - started
+
+    # Ready quickly despite 1,000 stored snippets, and silent about the damaged ones.
+    assert elapsed < 2.0, elapsed
+    assert service.stdout_lines == [f"listening on 127.0.0.1:{service.port}"]
+    assert service.stderr_lines == []
+
+    # The records are served on demand, read fresh from the directory.
+    assert service.read(good_ids[0]).json()["content"] == "snippet 0"
+    assert service.read(good_ids[-1]).json()["content"] == "snippet 899"
+    assert service.read("damagedPasteNumber0000").status == 500
+    assert service.wait_for_stderr("damagedPasteNumber0000") is not None
+
+
+def test_fr038_damaged_record_is_not_rewritten_or_removed(service):
+    """A damaged record is reported, not repaired, truncated, or skipped."""
+    service.write_raw_record("aDamagedPasteRecord", b"{ truncated")
+    before = service.record_path("aDamagedPasteRecord").read_bytes()
+
+    assert service.read("aDamagedPasteRecord").status == 500
+
+    assert service.record_path("aDamagedPasteRecord").read_bytes() == before
+
+
+def test_fr038_store_raises_rather_than_returning_a_sentinel(tmp_path):
+    """Principle II: the storage layer signals damage with an exception, not a value."""
+    (tmp_path / "aDamagedPasteRecord.json").write_bytes(b"{ truncated")
+
+    with pytest.raises(store.StoreCorrupt):
+        store.read_paste(tmp_path, "aDamagedPasteRecord")
+
+    with pytest.raises(FileNotFoundError):
+        store.read_paste(tmp_path, "neverIssuedIdentifier")
diff --git a/tests/test_delete.py b/tests/test_delete.py
new file mode 100644
index 0000000..527858a
--- /dev/null
+++ b/tests/test_delete.py
@@ -0,0 +1,149 @@
+"""Withdrawing a snippet: ``DELETE /pastes/<id>``.
+
+Covers FR-022…FR-026, including the rule that makes the endpoint safe to probe: "not found" takes
+precedence over "refused", so a deletion attempt reveals nothing a read would not have revealed.
+"""
+
+import secrets
+from datetime import timedelta
+
+from pastebin import store
+
+from test_expiry import past_record
+
+
+def test_fr022_delete_with_token_removes_paste(service):
+    """FR-022: presenting the credential alongside the request deletes the snippet."""
+    published = service.publish("to be withdrawn")
+    assert service.record_path(published["id"]).exists()
+
+    response = service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"])
+
+    assert response.status == 204
+    assert not service.record_path(published["id"]).exists()
+
+
+def test_fr023_delete_responds_204_and_paste_is_then_404(service):
+    """FR-023: a no-content acknowledgement, after which the snippet is not found."""
+    published = service.publish("to be withdrawn")
+
+    response = service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"])
+
+    assert response.status == 204
+    assert response.body == b""
+    assert service.read(published["id"]).status == 404
+    assert service.read_raw(published["id"]).status == 404
+
+
+def test_fr024_missing_token_is_403_and_paste_survives(service):
+    """FR-024: a deletion with no credential is refused and changes nothing."""
+    published = service.publish("still here")
+
+    response = service.delete(published["id"])
+
+    assert response.status == 403
+    assert response.json()["error"]
+    assert service.read(published["id"]).json()["content"] == "still here"
+    assert service.read_raw(published["id"]).body == b"still here"
+
+
+def test_fr024_wrong_token_is_403_and_paste_survives(service):
+    """FR-024: a credential that does not match is refused and changes nothing."""
+    published = service.publish("still here")
+    token=[REDACTED:assigned_secret]["delete_token"]
+
+    for wrong in [
+        "wrong",
+        "",
+        token[:-1],
+        token[:-1] + ("A" if token[-1] != "A" else "B"),
+        token + "x",
+        token.upper() if token.lower() != token else token.lower(),
+        "x" * len(token),
+    ]:
+        if wrong == token:
+            continue
+        response = service.delete(published["id"], token=wrong)
+        assert response.status == 403, wrong
+        assert response.json()["error"]
+
+    assert service.read(published["id"]).status == 200
+
+    # The real credential still works afterwards.
+    assert service.delete(published["id"], token=token).status == 204
+
+
+def test_fr025_token_compared_with_compare_digest(service, monkeypatch):
+    """FR-025: the comparison goes through ``secrets.compare_digest``, not ``==``."""
+    published = service.publish("to be withdrawn")
+    calls = []
+    real = secrets.compare_digest
+
+    def recording(left, right):
+        calls.append((left, right))
+        return real(left, right)
+
+    monkeypatch.setattr(secrets, "compare_digest", recording)
+
+    assert service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"]).status == 204
+
+    assert calls, "the credentials were compared without secrets.compare_digest"
+    presented, stored = calls[-1]
+    assert published["delete_token"] in (
+        presented.decode() if isinstance(presented, bytes) else presented
+    )
+    assert published["delete_token"] in (
+        stored.decode() if isinstance(stored, bytes) else stored
+    )
+
+
+def test_fr026_unknown_id_is_404_regardless_of_token(service):
+    """FR-026: an identifier that was never issued is not found, whatever is presented."""
+    published = service.publish("a different snippet")
+
+    for token in [None, "wrong", published["delete_token"]]:
+        response = service.delete("neverIssuedIdentifier", token=token)
+        assert response.status == 404, token
+        assert response.json()["error"] == "not found"
+
+
+def test_fr026_expired_paste_delete_is_404_not_403(service, monkeypatch):
+    """FR-026: an expired snippet is not found even when the correct credential is presented."""
+    service.write_record("handWrittenExpiredPaste", past_record("handWrittenExpiredPaste"))
+    assert (
+        service.delete(
+            "handWrittenExpiredPaste", token=[REDACTED:assigned_secret]
+        ).status
+        == 404
+    )
+    # Not found takes precedence over refused: a wrong credential gives the same answer.
+    assert service.delete("handWrittenExpiredPaste", token="wrong").status == 404
+
+    published = service.publish("short lived", expires_in=3600)
+    later = store.now_utc() + timedelta(seconds=3600)
+    monkeypatch.setattr(store, "now_utc", lambda: later)
+
+    assert service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"]).status == 404
+    assert service.delete(published["id"]).status == 404
+
+
+def test_fr026_second_delete_is_404(service):
+    """FR-026: a second deletion with the original credential is not found, not acknowledged."""
+    published = service.publish("to be withdrawn")
+
+    assert service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"]).status == 204
+    second = service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"])
+
+    assert second.status == 404
+    assert second.json()["error"] == "not found"
+
+
+def test_fr022_deleting_one_paste_leaves_the_others(service):
+    """A deletion affects exactly the snippet it names."""
+    published = [service.publish(f"snippet {n}") for n in range(5)]
+
+    assert service.delete(published[2]["id"], token=[REDACTED:assigned_secret][2]["delete_token"]).status == 204
+
+    for index, snippet in enumerate(published):
+        expected = 404 if index == 2 else 200
+        assert service.read(snippet["id"]).status == expected
