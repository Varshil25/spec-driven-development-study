new file mode 100644
index 0000000..f1f670a
--- /dev/null
+++ b/src/pastebin/store.py
@@ -0,0 +1,239 @@
+"""Snippet records on disk.
+
+One JSON file per snippet at ``<DIR>/<id>.json``; the directory is the sole source of truth. See
+``specs/001-pastebin-service/contracts/storage.md`` for the record format and the write, read, and
+delete protocols this module implements.
+"""
+
+import json
+import os
+import re
+import secrets
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+#: Largest snippet text accepted, measured in UTF-8 encoded bytes (FR-009).
+MAX_CONTENT_BYTES = 65_536
+
+#: Ceiling on how much of a request body is ever read (FR-040). Derived from the content limit:
+#: JSON's worst case is 6 output bytes per input byte (a C0 control byte becomes ``\\u0001``), plus
+#: slack for the other fields, whitespace, and the unknown fields FR-015 requires us to tolerate.
+MAX_BODY_BYTES = 6 * MAX_CONTENT_BYTES + 1_024
+
+#: Bounds on a requested lifetime, in seconds (FR-010).
+MIN_EXPIRES_IN = 1
+MAX_EXPIRES_IN = 2_592_000
+
+#: ISO 8601, UTC, second precision, trailing ``Z`` (FR-019).
+TIMESTAMP_FORMAT = "%Y-%m-%dT%H:%M:%SZ"
+
+#: An identifier is accepted from a request path only if it matches this, checked before the
+#: identifier is ever joined to a path. This is the defence against traversal (research.md R-04).
+ID_PATTERN = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
+
+#: The record has exactly these five keys; anything else is damaged (contracts/storage.md).
+RECORD_KEYS = frozenset({"id", "content", "created_at", "expires_at", "delete_token"})
+
+#: Identifier collisions are resolved by regenerating, not by overwriting (research.md R-02).
+LINK_ATTEMPTS = 5
+
+
+class StoreCorrupt(Exception):
+    """A stored record exists but cannot be read, decoded, or validated.
+
+    Raised rather than returning a sentinel the caller could mistake for a snippet
+    (Constitution Principle II). The handler translates it into a 500 plus a diagnostic
+    (FR-038, FR-039); it is never reported as "not found".
+    """
+
+
+def now_utc():
+    """The current moment in UTC, truncated to whole seconds."""
+    return datetime.now(timezone.utc).replace(microsecond=0)
+
+
+def format_timestamp(moment):
+    """Render a datetime in the one format this service reads and writes."""
+    return moment.strftime(TIMESTAMP_FORMAT)
+
+
+def parse_timestamp(text):
+    """Parse a timestamp written in exactly ``TIMESTAMP_FORMAT``.
+
+    ``strptime`` with the explicit format, not ``fromisoformat``: a hand-edited timestamp in any
+    other shape must be rejected rather than silently given a different meaning (research.md R-06).
+    Raises ``ValueError`` if the text is not in that shape.
+    """
+    return datetime.strptime(text, TIMESTAMP_FORMAT).replace(tzinfo=timezone.utc)
+
+
+def is_valid_id(paste_id):
+    """Whether an identifier taken from a request path may be used to build a file name."""
+    return ID_PATTERN.fullmatch(paste_id) is not None
+
+
+def prepare_storage(data_dir):
+    """Create the storage directory if absent and prove it is writable.
+
+    A probe file is created and removed because existence is not usability: permission bits lie on
+    read-only mounts and under some container runtimes, and FR-005 requires the service to refuse
+    to start rather than discover the problem on the first publication. ``OSError`` propagates to
+    the caller, which reports it and exits non-zero (research.md R-04).
+    """
+    directory = Path(data_dir)
+    directory.mkdir(parents=True, exist_ok=True)
+    probe = directory / f".probe-{secrets.token_urlsafe(8)}"
+    handle = os.open(probe, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+    os.close(handle)
+    os.unlink(probe)
+    return directory
+
+
+def create_paste(data_dir, content, expires_in=None):
+    """Publish a snippet and return its record.
+
+    ``expires_in`` is the requested lifetime in seconds, or ``None`` for "never expires". The
+    expiry moment is computed here, once, from the creation time, and is never recomputed
+    afterwards (FR-011, FR-028).
+
+    The record is written to a temporary name in the same directory, flushed and ``fsync``ed, and
+    only then linked to ``<id>.json``, so a concurrent reader sees the name either absent or
+    complete, never partial (FR-043), and no acknowledged publication can be lost by an abrupt
+    stop (FR-029). ``os.link`` fails if the identifier is already in use, in which case a fresh
+    identifier is drawn — it never overwrites (research.md R-02, R-03).
+    """
+    directory = Path(data_dir)
+    created = now_utc()
+    created_at = format_timestamp(created)
+    if expires_in is None:
+        expires_at = None
+    else:
+        expires_at = format_timestamp(created + timedelta(seconds=expires_in))
+
+    for _ in range(LINK_ATTEMPTS):
+        paste_id = secrets.token_urlsafe(16)
+        record = {
+            "id": paste_id,
+            "content": content,
+            "created_at": created_at,
+            "expires_at": expires_at,
+            "delete_token": secrets.token_urlsafe(32),
+        }
+        payload = json.dumps(record).encode("utf-8")
+        temporary = directory / f".tmp-{secrets.token_urlsafe(8)}"
+        descriptor = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+        try:
+            with os.fdopen(descriptor, "wb") as handle:
+                handle.write(payload)
+                handle.flush()
+                os.fsync(handle.fileno())
+            try:
+                os.link(temporary, directory / f"{paste_id}.json")
+            except FileExistsError:
+                continue
+            return record
+        finally:
+            os.unlink(temporary)
+
+    raise RuntimeError(
+        f"could not allocate an unused paste identifier in {LINK_ATTEMPTS} attempts"
+    )
+
+
+def read_paste(data_dir, paste_id):
+    """Return the stored record for ``paste_id``.
+
+    Raises ``FileNotFoundError`` when there is no such snippet — unknown, deleted, or never issued
+    — which the handler reports as 404. Raises ``StoreCorrupt`` when the file exists but cannot be
+    read, decoded, or validated, which the handler reports as 500 (FR-038). ``FileNotFoundError``
+    is caught before the broader ``OSError`` so that "absent" is never reported as "damaged", and
+    ``OSError`` is caught at all so that "damaged" is never reported as "absent" (research.md R-08).
+    """
+    path = Path(data_dir) / f"{paste_id}.json"
+    try:
+        raw = path.read_bytes()
+    except FileNotFoundError:
+        raise
+    except OSError as error:
+        raise StoreCorrupt(f"cannot be read: {error}") from error
+    return _validate_record(raw, paste_id)
+
+
+def _validate_record(raw, paste_id):
+    """Decode and validate one stored record, or raise ``StoreCorrupt`` saying why.
+
+    The rules are the ones published in contracts/storage.md: UTF-8 JSON, an object, exactly the
+    five keys with the stated types, an ``id`` equal to the file-name stem, and both timestamps in
+    ``TIMESTAMP_FORMAT``. Anything else is damaged — never "not found".
+    """
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as error:
+        raise StoreCorrupt(f"is not valid UTF-8: {error}") from error
+
+    try:
+        record = json.loads(text)
+    except json.JSONDecodeError as error:
+        raise StoreCorrupt(f"is not valid JSON: {error.msg}") from error
+
+    if not isinstance(record, dict):
+        raise StoreCorrupt("is not a JSON object")
+
+    keys = set(record)
+    if keys != set(RECORD_KEYS):
+        missing = sorted(set(RECORD_KEYS) - keys)
+        unexpected = sorted(keys - set(RECORD_KEYS))
+        raise StoreCorrupt(f"has missing keys {missing} and unexpected keys {unexpected}")
+
+    if record["id"] != paste_id:
+        raise StoreCorrupt(f"names a different identifier, {record['id']!r}")
+
+    if not isinstance(record["content"], str):
+        raise StoreCorrupt("has a non-string 'content'")
+
+    if not isinstance(record["delete_token"], str) or not record["delete_token"]:
+        raise StoreCorrupt("has a missing or non-string 'delete_token'")
+
+    if not isinstance(record["created_at"], str):
+        raise StoreCorrupt("has a non-string 'created_at'")
+    try:
+        parse_timestamp(record["created_at"])
+    except ValueError as error:
+        raise StoreCorrupt(f"has an unparseable 'created_at': {error}") from error
+
+    expires_at = record["expires_at"]
+    if expires_at is not None:
+        if not isinstance(expires_at, str):
+            raise StoreCorrupt("has an 'expires_at' that is neither a string nor null")
+        try:
+            parse_timestamp(expires_at)
+        except ValueError as error:
+            raise StoreCorrupt(f"has an unparseable 'expires_at': {error}") from error
+
+    return record
+
+
+def is_expired(record, now=None):
+    """Whether the snippet's expiry moment has been reached or passed (FR-027).
+
+    ``>=``, so that "at or after" is unreachable rather than nearly so. Expiry is evaluated here,
+    on each access; nothing is deleted or rewritten on the read path and no background process
+    reclaims an expired file (research.md R-06).
+    """
+    expires_at = record["expires_at"]
+    if expires_at is None:
+        return False
+    if now is None:
+        now = now_utc()
+    return now >= parse_timestamp(expires_at)
+
+
+def delete_paste(data_dir, paste_id):
+    """Remove the only link to a snippet's record, permanently (FR-031).
+
+    ``FileNotFoundError`` propagates: another deletion won the race, which the handler reports as
+    404. No tombstone and no index are written, so a restart cannot resurrect the snippet. A
+    reader that already opened the file keeps reading the unlinked inode to completion, so a
+    concurrent read yields the whole snippet or 404, never a fragment (FR-043).
+    """
+    os.unlink(Path(data_dir) / f"{paste_id}.json")
