+"""Shared test harness: two server fixtures and a standard-library HTTP client.
+
+Two fixtures exist because two groups of requirements genuinely differ (research.md R-10):
+
+* ``service`` runs the server in this process, so a test can substitute the store's clock with
+  ``monkeypatch`` and reach expiry instantly, with no test-only hook in runtime code.
+* ``server_process`` launches ``python -m pastebin`` as a child process, because the ready line,
+  the exit statuses, the stderr diagnostics, and the restart story are properties of the process.
+
+Only the standard library is used here; ``pytest`` is the single development dependency
+(Constitution Principle I).
+"""
+
+import http.client
+import json
+import os
+import signal
+import socket
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC_DIR = REPO_ROOT / "src"
+
+READY_PREFIX = "listening on 127.0.0.1:"
+
+
+# -- HTTP client ---------------------------------------------------------------------------
+
+
+class Response:
+    """One HTTP response, read in full."""
+
+    def __init__(self, status, headers, body):
+        self.status = status
+        self.headers = headers
+        self.body = body
+
+    def json(self):
+        """The body decoded as JSON."""
+        return json.loads(self.body.decode("utf-8"))
+
+    def text(self):
+        return self.body.decode("utf-8")
+
+    def __repr__(self):
+        return f"<Response {self.status} {self.body[:60]!r}>"
+
+
+class Client:
+    """A caller of the service over ``http.client``, one connection per request."""
+
+    def __init__(self, port):
+        self.port = port
+
+    def request(self, method, path, body=None, headers=None, timeout=10):
+        connection = http.client.HTTPConnection("127.0.0.1", self.port, timeout=timeout)
+        try:
+            connection.request(method, path, body=body, headers=dict(headers or {}))
+            raw = connection.getresponse()
+            return Response(raw.status, dict(raw.getheaders()), raw.read())
+        finally:
+            connection.close()
+
+    def post_json(self, payload, path="/pastes", headers=None):
+        """POST a JSON body built from ``payload`` (a Python object)."""
+        return self.request(
+            "POST", path, body=json.dumps(payload).encode("utf-8"), headers=headers
+        )
+
+    def post_raw(self, body, path="/pastes", headers=None):
+        """POST a body verbatim, without encoding it as JSON first."""
+        return self.request("POST", path, body=body, headers=headers)
+
+    def publish(self, content, **fields):
+        """Publish a snippet and return the parsed 201 body, asserting success."""
+        payload = {"content": content}
+        payload.update(fields)
+        response = self.post_json(payload)
+        assert response.status == 201, response
+        return response.json()
+
+    def get(self, path, headers=None):
+        return self.request("GET", path, headers=headers)
+
+    def read(self, paste_id):
+        return self.request("GET", f"/pastes/{paste_id}")
+
+    def read_raw(self, paste_id):
+        return self.request("GET", f"/pastes/{paste_id}/raw")
+
+    def delete(self, paste_id, token=None):
+        headers = {} if token is None else {"X-Delete-Token": token}
+        return self.request("DELETE", f"/pastes/{paste_id}", headers=headers)
+
+    def send_bytes(self, payload, read_response=True, timeout=10):
+        """Send bytes over a raw socket, for request framing ``http.client`` cannot express.
+
+        Returns the raw response bytes (possibly empty). Write errors are tolerated: the service
+        is entitled to answer and close before a too-large body has finished arriving.
+        """
+        sock = socket.create_connection(("127.0.0.1", self.port), timeout=timeout)
+        try:
+            try:
+                sock.sendall(payload)
+            except (BrokenPipeError, ConnectionResetError):
+                pass
+            if not read_response:
+                return b""
+            sock.shutdown(socket.SHUT_WR)
+            chunks = []
+            while True:
+                try:
+                    chunk = sock.recv(65536)
+                except (ConnectionResetError, TimeoutError):
+                    break
+                if not chunk:
+                    break
+                chunks.append(chunk)
+            return b"".join(chunks)
+        finally:
+            sock.close()
+
+
+def parse_raw_response(raw):
+    """Split a raw HTTP response into ``(status, headers, body)``."""
+    head, _, body = raw.partition(b"\r\n\r\n")
+    lines = head.decode("latin-1").split("\r\n")
+    status = int(lines[0].split()[1])
+    headers = {}
+    for line in lines[1:]:
+        name, _, value = line.partition(":")
+        headers[name.strip()] = value.strip()
+    return status, headers, body
+
+
+# -- in-process server ---------------------------------------------------------------------
+
+
+class Service(Client):
+    """The in-process service, plus the storage directory it is backed by."""
+
+    def __init__(self, port, data_dir, httpd):
+        super().__init__(port)
+        self.data_dir = data_dir
+        self.httpd = httpd
+
+    def record_path(self, paste_id):
+        return self.data_dir / f"{paste_id}.json"
+
+    def read_record(self, paste_id):
+        """The stored record for a snippet, straight off disk."""
+        return json.loads(self.record_path(paste_id).read_text(encoding="utf-8"))
+
+    def write_record(self, paste_id, record):
+        """Hand-write a record, as contracts/storage.md documents it (research.md R-10)."""
+        self.record_path(paste_id).write_text(
+            json.dumps(record), encoding="utf-8"
+        )
+
+    def write_raw_record(self, paste_id, raw):
+        """Hand-write arbitrary bytes as a snippet's stored form, to make it damaged."""
+        self.record_path(paste_id).write_bytes(raw)
+
+
+@pytest.fixture
+def service(tmp_path):
+    """A server bound to an operating-system-chosen port, serving in a background thread."""
+    from pastebin import server
+
+    data_dir = tmp_path / "pastes"
+    data_dir.mkdir()
+    httpd = server.make_server(0, data_dir)
+    thread = threading.Thread(target=httpd.serve_forever, daemon=True)
+    thread.start()
+    try:
+        yield Service(httpd.server_address[1], data_dir, httpd)
+    finally:
+        httpd.shutdown()
+        httpd.server_close()
+        thread.join(timeout=10)
+
+
+# -- subprocess server ---------------------------------------------------------------------
+
+
+def child_env():
+    """The environment a child ``python -m pastebin`` needs: ``src/`` on the path."""
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC_DIR)
+    return env
+
+
+def free_port():
+    """A port that was free a moment ago, for the cases that cannot use port 0."""
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        return sock.getsockname()[1]
+
+
+def run_cli(*args, timeout=30):
+    """Run the command line to completion and return the ``CompletedProcess``."""
+    return subprocess.run(
+        [sys.executable, "-m", "pastebin", *args],
+        cwd=REPO_ROOT,
+        env=child_env(),
+        capture_output=True,
+        text=True,
+        timeout=timeout,
+    )
+
+
+class ServerProcess(Client):
+    """A child ``python -m pastebin serve`` whose streams are captured as they are written."""
+
+    def __init__(self, data_dir, port=None):
+        self.data_dir = Path(data_dir)
+        self.port = port if port is not None else free_port()
+        super().__init__(self.port)
+        self.stdout_lines = []
+        self.stderr_lines = []
+        self.process = subprocess.Popen(
+            [
+                sys.executable,
+                "-m",
+                "pastebin",
+                "serve",
+                "--port",
+                str(self.port),
+                "--data",
+                str(self.data_dir),
+            ],
+            cwd=REPO_ROOT,
+            env=child_env(),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        self._readers = [
+            self._drain(self.process.stdout, self.stdout_lines),
+            self._drain(self.process.stderr, self.stderr_lines),
+        ]
+
+    @staticmethod
+    def _drain(stream, sink):
+        def run():
+            for line in stream:
+                sink.append(line.rstrip("\n"))
+
+        thread = threading.Thread(target=run, daemon=True)
+        thread.start()
+        return thread
+
+    def wait_ready(self, timeout=15):
+        """Wait for the ready line. Returns ``True`` if it appeared, ``False`` if the child exited."""
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            if any(line.startswith(READY_PREFIX) for line in self.stdout_lines):
+                return True
+            if self.process.poll() is not None:
+                return False
+            time.sleep(0.01)
+        return False
+
+    def wait_for_stderr(self, needle, timeout=10):
+        """Wait for a diagnostic line containing ``needle``; returns the line or ``None``."""
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            for line in list(self.stderr_lines):
+                if needle in line:
+                    return line
+            time.sleep(0.01)
+        return None
+
+    def wait_exit(self, timeout=15):
+        """Wait for the child to exit and return its status."""
+        status = self.process.wait(timeout=timeout)
+        for reader in self._readers:
+            reader.join(timeout=5)
+        return status
+
+    def stop(self, sig=signal.SIGINT, timeout=15):
+        """Signal the child to stop and return its exit status."""
+        if self.process.poll() is None:
+            self.process.send_signal(sig)
+        return self.wait_exit(timeout=timeout)
+
+    def kill(self):
+        if self.process.poll() is None:
+            self.process.kill()
+            self.process.wait(timeout=10)
+        for stream in (self.process.stdout, self.process.stderr):
+            if stream is not None and not stream.closed:
+                stream.close()
+
+    def record_path(self, paste_id):
+        return self.data_dir / f"{paste_id}.json"
+
+
+@pytest.fixture
+def server_process(tmp_path):
+    """Factory for child service processes; every one started is cleaned up afterwards."""
+    started = []
+
+    def start(data_dir=None, port=None, expect_ready=True):
+        process = ServerProcess(data_dir or (tmp_path / "pastes"), port=port)
+        started.append(process)
+        if expect_ready:
+            assert process.wait_ready(), (
+                f"service did not become ready; stdout={process.stdout_lines} "
+                f"stderr={process.stderr_lines}"
+            )
+        return process
+
+    yield start
+
+    for process in started:
+        process.kill()
