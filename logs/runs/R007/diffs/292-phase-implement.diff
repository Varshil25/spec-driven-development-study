index 0000000..2174239
--- /dev/null
+++ b/tests/test_expiry.py
@@ -0,0 +1,120 @@
+"""Lifetimes and lazy expiry.
+
+Covers FR-027 and FR-028. Expiry is reached two ways, neither of which needs a third-party clock
+library (research.md R-10): by substituting the store's clock through the in-process fixture, and
+by hand-writing a record whose expiry moment is already past — legitimate because the on-disk form
+is a published contract (contracts/storage.md) that a later instance must honour.
+"""
+
+from datetime import timedelta
+
+from pastebin import store
+
+HOUR = 3600
+
+
+def past_record(paste_id, content="expired", delete_token="token-for-an-expired-paste"):
+    """A record, shaped exactly as contracts/storage.md documents it, that expired yesterday."""
+    created = store.now_utc() - timedelta(days=1, seconds=HOUR)
+    return {
+        "id": paste_id,
+        "content": content,
+        "created_at": store.format_timestamp(created),
+        "expires_at": store.format_timestamp(created + timedelta(seconds=HOUR)),
+        "delete_token": delete_token,
+    }
+
+
+def test_fr027_expired_paste_is_404_on_get_raw_and_delete(service, monkeypatch):
+    """FR-027: an expired snippet does not exist for reading, reading-as-text, or deletion."""
+    # Reached by hand-writing a record that expired yesterday.
+    service.write_record("handWrittenExpiredPaste", past_record("handWrittenExpiredPaste"))
+
+    assert service.read("handWrittenExpiredPaste").status == 404
+    assert service.read_raw("handWrittenExpiredPaste").status == 404
+    assert (
+        service.delete(
+            "handWrittenExpiredPaste", token=[REDACTED:assigned_secret]
+        ).status
+        == 404
+    )
+
+    # And reached by moving the service's clock past a lifetime it granted itself.
+    published = service.publish("short lived", expires_in=HOUR)
+    assert service.read(published["id"]).status == 200
+
+    later = store.now_utc() + timedelta(seconds=HOUR)
+    monkeypatch.setattr(store, "now_utc", lambda: later)
+
+    assert service.read(published["id"]).status == 404
+    assert service.read_raw(published["id"]).status == 404
+    assert service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"]).status == 404
+
+    body = service.read(published["id"]).json()
+    assert body == {"error": "not found"}
+
+
+def test_fr028_expires_at_equals_created_at_plus_lifetime(service):
+    """FR-028: the expiry moment is the creation time plus the requested lifetime."""
+    published = service.publish("temporary", expires_in=HOUR)
+
+    snippet = service.read(published["id"]).json()
+
+    created = store.parse_timestamp(snippet["created_at"])
+    expires = store.parse_timestamp(snippet["expires_at"])
+    assert expires - created == timedelta(seconds=HOUR)
+
+
+def test_fr028_expires_at_unchanged_by_later_reads(service):
+    """FR-028: the expiry moment is computed once at publication and never recomputed."""
+    published = service.publish("temporary", expires_in=HOUR)
+
+    first = service.read(published["id"]).json()
+    stored_before = service.read_record(published["id"])
+    second = service.read(published["id"]).json()
+    service.read_raw(published["id"])
+    third = service.read(published["id"]).json()
+    stored_after = service.read_record(published["id"])
+
+    assert first == second == third
+    assert stored_before == stored_after
+    assert stored_after["expires_at"] == first["expires_at"]
+
+
+def test_fr028_expiry_boundary_is_at_or_after(service, monkeypatch):
+    """FR-027: the snippet is gone at the expiry moment, not only after it."""
+    published = service.publish("temporary", expires_in=HOUR)
+    expires_at = store.parse_timestamp(service.read(published["id"]).json()["expires_at"])
+
+    monkeypatch.setattr(store, "now_utc", lambda: expires_at - timedelta(seconds=1))
+    assert service.read(published["id"]).status == 200
+
+    monkeypatch.setattr(store, "now_utc", lambda: expires_at)
+    assert service.read(published["id"]).status == 404
+
+
+def test_fr027_expired_record_is_not_reclaimed_on_access(service):
+    """Expiry is evaluated lazily: nothing is written or deleted on the read path."""
+    service.write_record("handWrittenExpiredPaste", past_record("handWrittenExpiredPaste"))
+    before = service.record_path("handWrittenExpiredPaste").read_bytes()
+
+    assert service.read("handWrittenExpiredPaste").status == 404
+
+    assert service.record_path("handWrittenExpiredPaste").read_bytes() == before
+
+
+def test_fr027_expiry_with_the_real_clock(service):
+    """FR-027 end to end, with no clock substitution at all."""
+    import time
+
+    published = service.publish("brief", expires_in=2)
+
+    # created_at is truncated to whole seconds, so the snippet has at least a second of life.
+    assert service.read(published["id"]).status == 200
+
+    expires_at = store.parse_timestamp(service.read(published["id"]).json()["expires_at"])
+    while store.now_utc() < expires_at:
+        time.sleep(0.05)
+
+    assert service.read(published["id"]).status == 404
+    assert service.read_raw(published["id"]).status == 404
diff --git a/tests/test_persistence.py b/tests/test_persistence.py
new file mode 100644
index 0000000..d0d5a2a
--- /dev/null
+++ b/tests/test_persistence.py
@@ -0,0 +1,129 @@
+"""Snippets outlive a restart of the service.
+
+Covers FR-029…FR-031. These tests use the subprocess fixture throughout, because the process
+boundary is the thing under test: a second instance is started against the same storage directory
+after the first has exited (research.md R-10).
+"""
+
+import signal
+import time
+from datetime import timedelta
+
+from pastebin import store
+
+
+def test_fr029_paste_readable_from_new_instance_on_same_dir(server_process, tmp_path):
+    """FR-029: a later instance started against the same directory serves what the first stored."""
+    data_dir = tmp_path / "shared"
+    first = server_process(data_dir=data_dir)
+    published = first.publish("durable text")
+    assert first.stop(signal.SIGINT) == 0
+
+    second = server_process(data_dir=data_dir)
+
+    response = second.read(published["id"])
+    assert response.status == 200
+    assert response.json()["content"] == "durable text"
+    assert second.read_raw(published["id"]).body == b"durable text"
+
+
+def test_fr030_id_content_created_at_expires_at_token_survive_restart(
+    server_process, tmp_path
+):
+    """FR-030: identifier, text, creation time, expiry time, and credential all survive."""
+    data_dir = tmp_path / "shared"
+    first = server_process(data_dir=data_dir)
+    permanent = first.publish("never expires")
+    temporary = first.publish("expires in a month", expires_in=store.MAX_EXPIRES_IN)
+    unicode_snippet = first.publish("ünïcødé ☃ 🎉\nsecond line")
+    before = {
+        snippet["id"]: first.read(snippet["id"]).json()
+        for snippet in (permanent, temporary, unicode_snippet)
+    }
+    assert first.stop(signal.SIGINT) == 0
+
+    second = server_process(data_dir=data_dir)
+
+    for paste_id, expected in before.items():
+        assert second.read(paste_id).json() == expected
+
+    # The restart neither extends nor shortens the expiry.
+    assert before[temporary["id"]]["expires_at"] is not None
+    assert second.read(permanent["id"]).json()["expires_at"] is None
+
+    # An original credential still withdraws its snippet.
+    assert second.delete(temporary["id"], token=[REDACTED:assigned_secret]["delete_token"]).status == 204
+    assert second.read(temporary["id"]).status == 404
+
+
+def test_fr031_deleted_paste_not_resurrected_by_restart(server_process, tmp_path):
+    """FR-031: a deletion is permanent — a restart does not bring the snippet back."""
+    data_dir = tmp_path / "shared"
+    first = server_process(data_dir=data_dir)
+    published = first.publish("to be withdrawn")
+    survivor = first.publish("kept")
+    assert first.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"]).status == 204
+    assert first.stop(signal.SIGINT) == 0
+
+    second = server_process(data_dir=data_dir)
+
+    assert second.read(published["id"]).status == 404
+    assert second.read_raw(published["id"]).status == 404
+    assert (
+        second.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"]).status == 404
+    )
+    assert not second.record_path(published["id"]).exists()
+    # The snippet that was not deleted is still there.
+    assert second.read(survivor["id"]).json()["content"] == "kept"
+
+
+def test_us4_expiry_passed_while_stopped_is_404(server_process, tmp_path):
+    """US4 scenario 5: a snippet whose expiry moment passed while the service was stopped is gone."""
+    data_dir = tmp_path / "shared"
+    first = server_process(data_dir=data_dir)
+    brief = first.publish("brief", expires_in=1)
+    expires_at = store.parse_timestamp(first.read(brief["id"]).json()["expires_at"])
+    assert first.stop(signal.SIGINT) == 0
+
+    while store.now_utc() < expires_at:
+        time.sleep(0.05)
+
+    second = server_process(data_dir=data_dir)
+
+    assert second.read(brief["id"]).status == 404
+    assert second.read_raw(brief["id"]).status == 404
+    assert second.delete(brief["id"], token=brief["delete_token"]).status == 404
+
+
+def test_fr029_storage_directory_is_the_only_state(server_process, tmp_path):
+    """FR-029: the directory is the sole source of truth — an empty one serves nothing."""
+    first = server_process(data_dir=tmp_path / "one")
+    published = first.publish("in the first directory")
+    assert first.stop(signal.SIGINT) == 0
+
+    # A new instance on a *different* directory knows nothing of it.
+    second = server_process(data_dir=tmp_path / "two")
+
+    assert second.read(published["id"]).status == 404
+
+
+def test_fr029_record_on_disk_matches_the_published_contract(server_process, tmp_path):
+    """contracts/storage.md: the service's own writes are records its own reader accepts."""
+    data_dir = tmp_path / "shared"
+    service = server_process(data_dir=data_dir)
+    published = service.publish("hello", expires_in=3600)
+
+    record = store.read_paste(data_dir, published["id"])
+
+    assert set(record) == set(store.RECORD_KEYS)
+    assert record["id"] == published["id"]
+    assert record["content"] == "hello"
+    assert record["delete_token"] == published["delete_token"]
+    lifetime = store.parse_timestamp(record["expires_at"]) - store.parse_timestamp(
+        record["created_at"]
+    )
+    assert lifetime == timedelta(seconds=3600)
+    # Only snippet files and nothing else is left behind after a publication.
+    assert sorted(path.name for path in data_dir.iterdir()) == [
+        f"{published['id']}.json"
+    ]
diff --git a/tests/test_publish.py b/tests/test_publish.py
new file mode 100644
index 0000000..c0ba0b5
--- /dev/null
+++ b/tests/test_publish.py
@@ -0,0 +1,291 @@
+"""Publishing a snippet: ``POST /pastes``.
+
+Covers FR-007…FR-016, FR-040, and FR-041 — what is accepted, what is refused and with which
+status, and how much of a request body the service is willing to read.
+"""
+
+import json
+import re
+import time
+
+import pytest
+
+from conftest import parse_raw_response
+from pastebin import store
+
+URLSAFE = re.compile(r"^[A-Za-z0-9_-]+$")
+
+
+def test_fr007_publish_with_content_creates_paste(service):
+    """FR-007: a snippet is published by submitting a body carrying its text."""
+    response = service.post_json({"content": "hello"})
+
+    assert response.status == 201
+    published = response.json()
+    assert service.read(published["id"]).json()["content"] == "hello"
+
+
+def test_fr008_missing_content_is_400(service):
+    """FR-008: a submission without the text field is invalid input."""
+    response = service.post_json({"expires_in": 60})
+
+    assert response.status == 400
+    assert "content" in response.json()["error"]
+
+
+@pytest.mark.parametrize(
+    "value", [42, 3.5, True, False, None, ["a"], {"text": "a"}], ids=repr
+)
+def test_fr008_non_string_content_is_400(service, value):
+    """FR-008: a text field that is not a string is invalid input, whatever it is."""
+    response = service.post_json({"content": value})
+
+    assert response.status == 400
+    assert "content" in response.json()["error"]
+
+
+def test_fr009_content_at_65536_bytes_accepted(service):
+    """FR-009: text of exactly 65,536 encoded bytes is accepted."""
+    content = "x" * store.MAX_CONTENT_BYTES
+
+    response = service.post_json({"content": content})
+
+    assert response.status == 201
+    assert service.read_raw(response.json()["id"]).body == content.encode("utf-8")
+
+
+def test_fr009_content_at_65537_bytes_is_413(service):
+    """FR-009: one byte more than the limit is refused as too large."""
+    response = service.post_json({"content": "x" * (store.MAX_CONTENT_BYTES + 1)})
+
+    assert response.status == 413
+    assert response.json()["error"]
+
+
+@pytest.mark.parametrize(
+    ("character", "width"), [("é", 2), ("☃", 3), ("🎉", 4)], ids=["2-byte", "3-byte", "4-byte"]
+)
+def test_fr009_limit_measured_in_encoded_bytes(service, character, width):
+    """FR-009: the limit counts UTF-8 bytes, not characters."""
+    at_limit = character * (store.MAX_CONTENT_BYTES // width) + "x" * (
+        store.MAX_CONTENT_BYTES % width
+    )
+    assert len(at_limit) < store.MAX_CONTENT_BYTES  # fewer characters than bytes
+    assert len(at_limit.encode("utf-8")) == store.MAX_CONTENT_BYTES
+
+    assert service.post_json({"content": at_limit}).status == 201
+    assert service.post_json({"content": at_limit + character}).status == 413
+
+
+def test_fr012_response_is_201_with_id_delete_token_and_url(service):
+    """FR-012: created status, with the identifier, the credential, and the location."""
+    response = service.post_json({"content": "hello"})
+
+    assert response.status == 201
+    published = response.json()
+    assert set(published) == {"id", "delete_token", "url"}
+    assert published["url"] == f"/pastes/{published['id']}"
+    assert published["id"] and published["delete_token"]
+
+
+def test_fr013_ids_are_unique_across_many_publications(service):
+    """FR-013: identifiers do not repeat."""
+    identifiers = {service.publish(f"snippet {n}")["id"] for n in range(50)}
+
+    assert len(identifiers) == 50
+
+
+def test_fr013_id_entropy_and_alphabet(service):
+    """FR-013: identifiers are URL-safe, full-length, and not guessable from one another."""
+    identifiers = [service.publish("x")["id"] for _ in range(20)]
+
+    for identifier in identifiers:
+        assert len(identifier) == 22, identifier  # 128 bits, URL-safe base64
+        assert URLSAFE.fullmatch(identifier), identifier
+
+    prefixes = {identifier[:4] for identifier in identifiers}
+    assert len(prefixes) == len(identifiers), "identifiers share a prefix; not random"
+
+
+def test_fr014_delete_token_not_derivable_from_id(service):
+    """FR-014: the credential is a separate, longer, independent draw from the identifier."""
+    first = service.publish("same text")
+    second = service.publish("same text")
+
+    for published in (first, second):
+        assert len(published["delete_token"]) == 43  # 256 bits, URL-safe base64
+        assert URLSAFE.fullmatch(published["delete_token"])
+        assert published["delete_token"] != published["id"]
+        assert published["id"] not in published["delete_token"]
+        assert published["delete_token"] not in published["id"]
+
+    assert first["delete_token"] != second["delete_token"]
+    assert first["id"] != second["id"]
+
+
+def test_fr015_unknown_fields_are_ignored(service):
+    """FR-015: fields the service does not define are ignored, not rejected."""
+    response = service.post_json(
+        {
+            "content": "hello",
+            "title": "ignored",
+            "expires_at": "2000-01-01T00:00:00Z",
+            "id": "chosen-by-caller",
+            "delete_token": "chosen-by-caller",
+            "nested": {"anything": [1, 2, 3]},
+        }
+    )
+
+    assert response.status == 201
+    published = response.json()
+    assert published["id"] != "chosen-by-caller"
+    assert published["delete_token"] != "chosen-by-caller"
+
+    stored = service.read(published["id"]).json()
+    assert stored["content"] == "hello"
+    assert stored["expires_at"] is None
+    assert "title" not in stored
+
+
+@pytest.mark.parametrize(
+    "body",
+    [b"not json", b"{", b'{"content": }', b"", b'{"content": "x",}', b"\xff\xfe"],
+    ids=["words", "truncated", "no-value", "empty", "trailing-comma", "not-utf8"],
+)
+def test_fr016_malformed_json_is_400(service, body):
+    """FR-016: a body that is not well-formed structured data is invalid input."""
+    response = service.post_raw(body)
+
+    assert response.status == 400
+    assert response.json()["error"]
+
+
+@pytest.mark.parametrize(
+    "payload", [[1, 2, 3], 42, "a string", None, True], ids=repr
+)
+def test_fr016_non_object_json_is_400(service, payload):
+    """FR-016: a well-formed body that is not an object is invalid input."""
+    response = service.post_json(payload)
+
+    assert response.status == 400
+    assert response.json()["error"]
+
+
+def test_fr040_declared_length_over_bound_is_413_without_reading_body(service):
+    """FR-040: a declared length beyond the bound is refused without the body being read."""
+    request = (
+        b"POST /pastes HTTP/1.0\r\n"
+        b"Host: 127.0.0.1\r\n"
+        b"Content-Length: 999999999\r\n"
+        b"\r\n"
+    )
+
+    started = time.monotonic()
+    raw = service.send_bytes(request)
+    elapsed = time.monotonic() - started
+
+    status, _, body = parse_raw_response(raw)
+    assert status == 413
+    assert json.loads(body)["error"]
+    # No body was ever sent, so a service that waited for one would have hung until its timeout.
+    assert elapsed < 5
+
+    assert service.post_json({"content": "still serving"}).status == 201
+
+
+def test_fr040_understated_length_cannot_exceed_read_ceiling(service):
+    """FR-040: the ceiling holds even when the caller omits or understates the length."""
+    oversize = b"x" * (store.MAX_BODY_BYTES + 1)
+    raw = service.send_bytes(
+        b"POST /pastes HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n" + oversize
+    )
+
+    status, _, body = parse_raw_response(raw)
+    assert status == 413
+    assert json.loads(body)["error"]
+
+    # An understated length means the declared bytes are read and no more; the rest is never
+    # consumed, and the request is answered with a defined status.
+    understated = service.send_bytes(
+        b"POST /pastes HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Length: 5\r\n\r\n"
+        + b"xxxxx"
+        + b"y" * 4096
+    )
+    status, _, body = parse_raw_response(understated)
+    assert status == 400
+    assert json.loads(body)["error"]
+
+    assert service.post_json({"content": "still serving"}).status == 201
+
+
+@pytest.mark.parametrize("lifetime", [1, 60, 86400, store.MAX_EXPIRES_IN], ids=repr)
+def test_fr010_expires_in_accepts_1_and_2592000(service, lifetime):
+    """FR-010: a lifetime anywhere in 1…2,592,000 seconds is accepted."""
+    response = service.post_json({"content": "temporary", "expires_in": lifetime})
+
+    assert response.status == 201
