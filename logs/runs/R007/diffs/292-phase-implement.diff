+    assert response.status == 400, (value, response)
+    assert "expires_in" in response.json()["error"]
+    assert sorted(path.name for path in service.data_dir.iterdir()) == before
+
+
+def test_fr011_absent_expires_in_means_no_expiry(service):
+    """FR-011: an absent lifetime means the snippet never expires."""
+    published = service.publish("permanent")
+
+    snippet = service.read(published["id"]).json()
+
+    assert snippet["expires_at"] is None
+    assert service.read_record(published["id"])["expires_at"] is None
+
+
+def test_fr011_null_expires_in_means_no_expiry(service):
+    """FR-011: a lifetime given as null means the snippet never expires."""
+    response = service.post_json({"content": "permanent", "expires_in": None})
+
+    assert response.status == 201
+    published = response.json()
+    assert service.read(published["id"]).json()["expires_at"] is None
+    assert service.read_record(published["id"])["expires_at"] is None
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [None, "application/json", "text/plain", "application/x-www-form-urlencoded", "nonsense"],
+    ids=["absent", "json", "plain", "form", "nonsense"],
+)
+def test_fr041_content_type_is_ignored(service, content_type):
