@@ -0,0 +1,380 @@
+"""The HTTP surface.
+
+Paths, methods, header names, field names, and status codes are fixed by the specification; see
+``specs/001-pastebin-service/contracts/http-api.md``. One thread per connection, HTTP/1.0 (one
+request per connection), and no per-request output on either stream (FR-042, FR-044).
+"""
+
+import json
+import secrets
+import sys
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import urlsplit
+
+from pastebin import store
+
+#: Per-connection socket timeout. A caller that opens a connection and goes quiet is bounded
+#: rather than merely parallel: the stalled read raises ``TimeoutError`` instead of pinning a
+#: thread forever (FR-042; research.md R-01).
+SOCKET_TIMEOUT_SECONDS = 10
+
+
+class Handler(BaseHTTPRequestHandler):
+    """Routing, validation, and responses for the four defined requests."""
+
+    #: One request per connection: no keep-alive framing to get precisely right on error paths,
+    #: which is what makes "reject a too-large body without reading it" safe (research.md R-01).
+    protocol_version = "HTTP/1.0"
+
+    timeout = SOCKET_TIMEOUT_SECONDS
+
+    def log_message(self, format, *args):
+        """Silenced: FR-044 forbids per-request lines on either stream."""
+
+    def log_error(self, format, *args):
+        """Silenced for the same reason; it fires on client errors (research.md R-09)."""
+
+    def __getattr__(self, name):
+        """Answer every verb this service does not define with 404 rather than 501.
+
+        ``BaseHTTPRequestHandler`` dispatches on ``do_<VERB>`` and sends its own 501 HTML page when
+        the attribute is missing, which would break FR-032 (a JSON error body on every
+        unsuccessful response) and FR-036 (404 for an unsupported method). Scoping this to the
+        ``do_`` prefix covers verbs nobody enumerated without masking genuine typos elsewhere in
+        the handler (research.md R-07).
+        """
+        if name.startswith("do_"):
+            return self._not_found
+        raise AttributeError(name)
+
+    # -- routing ---------------------------------------------------------------------------
+
+    def do_POST(self):
+        path = urlsplit(self.path).path
+        if path == "/pastes":
+            self._publish()
+        else:
+            self._not_found()
+
+    def do_GET(self):
+        paste_id, suffix = self._split_paste_path()
+        if paste_id is not None and suffix == "":
+            self._read(paste_id, raw=False)
+        elif paste_id is not None and suffix == "raw":
+            self._read(paste_id, raw=True)
+        else:
+            self._not_found()
+
+    def do_DELETE(self):
+        paste_id, suffix = self._split_paste_path()
+        if paste_id is not None and suffix == "":
+            self._delete(paste_id)
+        else:
+            self._not_found()
+
+    def _split_paste_path(self):
+        """Return ``(paste_id, suffix)`` for a ``/pastes/<id>[/<suffix>]`` path, else ``(None, None)``.
+
+        The query string is split off first, so ``/pastes/<id>?x=1`` reads the snippet rather than
+        404-ing on a path the caller never meant to change. An identifier that does not match
+        ``ID_PATTERN`` yields ``(None, None)`` — a 404 before any path is constructed.
+        """
+        parts = urlsplit(self.path).path.split("/")
+        if len(parts) not in (3, 4) or parts[0] != "" or parts[1] != "pastes":
+            return None, None
+        if not store.is_valid_id(parts[2]):
+            return None, None
+        return parts[2], parts[3] if len(parts) == 4 else ""
+
+    # -- request handlers ------------------------------------------------------------------
+
+    def _publish(self):
+        """``POST /pastes`` — publish a snippet (FR-007, FR-012, FR-015)."""
+        body = self._read_body()
+        if body is None:
+            return
+
+        payload = self._decode_payload(body)
+        if payload is None:
+            return
+
+        content = payload.get("content")
+        if not isinstance(content, str):
+            self._send_error(400, "'content' is required and must be a string")
+            return
+        if len(content.encode("utf-8")) > store.MAX_CONTENT_BYTES:
+            self._send_error(
+                413, f"content exceeds the maximum of {store.MAX_CONTENT_BYTES} bytes"
+            )
+            return
+
+        expires_in = payload.get("expires_in")
+        if expires_in is not None and not self._is_valid_lifetime(expires_in):
+            self._send_error(
+                400,
+                "'expires_in' must be an integer from "
+                f"{store.MIN_EXPIRES_IN} to {store.MAX_EXPIRES_IN}, or null",
+            )
+            return
+
+        record = store.create_paste(self.server.data_dir, content, expires_in)
+        self._send_json(
+            201,
+            {
+                "id": record["id"],
+                "delete_token": record["delete_token"],
+                "url": f"/pastes/{record['id']}",
+            },
+        )
+
+    def _read(self, paste_id, raw):
+        """``GET /pastes/<id>`` and ``GET /pastes/<id>/raw`` (FR-017…FR-021)."""
+        record = self._load(paste_id)
+        if record is None:
+            return
+        if raw:
+            # The text alone is the whole body: no wrapper, no added newline (FR-020).
+            self._send_bytes(
+                200, "text/plain; charset=utf-8", record["content"].encode("utf-8")
+            )
+        else:
+            # Timestamps are served verbatim from the record, never recomputed (FR-019, FR-028),
+            # and the deletion credential is not among the fields (FR-014).
+            self._send_json(
+                200,
+                {
+                    "id": record["id"],
+                    "content": record["content"],
+                    "created_at": record["created_at"],
+                    "expires_at": record["expires_at"],
+                },
+            )
+
+    def _delete(self, paste_id):
+        """``DELETE /pastes/<id>`` — withdraw a snippet (FR-022…FR-026).
+
+        The order is deliberate. The record is read and its expiry checked *before* the
+        credential is looked at, so "not found" takes precedence over "refused" and the endpoint
+        never reveals the existence of an identifier a read would not have revealed (FR-026).
+        """
+        record = self._load(paste_id)
+        if record is None:
+            return
+
+        presented = self.headers.get("X-Delete-Token")
+        if presented is None or not self._tokens_match(presented, record["delete_token"]):
+            self._send_error(403, "missing or invalid X-Delete-Token")
+            return
+
+        try:
+            store.delete_paste(self.server.data_dir, paste_id)
+        except FileNotFoundError:
+            # Another deletion won the race; this request found nothing to withdraw.
+            self._not_found()
+            return
+        self._send_no_content()
+
+    # -- request helpers -------------------------------------------------------------------
+
+    def _load(self, paste_id):
+        """Return a live record, or answer the request and return ``None``.
+
+        404 when there is no such snippet or its expiry moment has passed — the two are
+        indistinguishable to every caller (FR-027, FR-036) — and 500 plus a diagnostic when the
+        stored form is damaged (FR-038, FR-039).
+        """
+        try:
+            record = store.read_paste(self.server.data_dir, paste_id)
+        except FileNotFoundError:
+            self._not_found()
+            return None
+        except store.StoreCorrupt as corruption:
+            self._damaged(paste_id, corruption)
+            return None
+        if store.is_expired(record):
+            self._not_found()
+            return None
+        return record
+
+    @staticmethod
+    def _is_valid_lifetime(value):
+        """Whether a present, non-null ``expires_in`` is acceptable (FR-010).
+
+        ``type(value) is int``, not ``isinstance``: ``isinstance(True, int)`` is true in Python
+        and ``{"expires_in": true}`` must be a 400. A numeric string is likewise refused — no
+        coercion (Constitution Principle II).
+        """
+        return type(value) is int and store.MIN_EXPIRES_IN <= value <= store.MAX_EXPIRES_IN
+
+    @staticmethod
+    def _tokens_match(presented, stored):
+        """Compare credentials without revealing how much of the presented one was correct.
+
+        ``secrets.compare_digest`` takes the same time whatever the inputs share (FR-025). The
+        comparison is on encoded bytes so that a header carrying non-ASCII characters is a plain
+        mismatch rather than a ``TypeError`` escaping the handler.
+        """
+        return secrets.compare_digest(
+            presented.encode("utf-8", "replace"), stored.encode("utf-8")
+        )
+
+    def _read_body(self):
+        """Return the request body, or answer the request and return ``None``.
+
+        No more than ``MAX_BODY_BYTES`` is ever read from the connection, whether or not a length
+        was declared, so a caller who overstates, understates, or omits ``Content-Length`` cannot
+        make the service consume unbounded memory (FR-040; research.md R-05).
+        """
+        declared = self.headers.get("Content-Length")
+        if declared is None:
+            return self._read_until_ceiling()
+
+        try:
+            length = int(declared)
+        except ValueError:
+            self._send_error(400, "invalid Content-Length header")
+            return None
+        if length < 0:
+            self._send_error(400, "invalid Content-Length header")
+            return None
+        if length > store.MAX_BODY_BYTES:
+            # Refused before the body is read at all.
+            self._send_error(
+                413, f"request body exceeds the maximum of {store.MAX_BODY_BYTES} bytes"
+            )
+            return None
+
+        try:
+            body = self.rfile.read(length)
+        except TimeoutError:
+            # The caller declared a body and then went quiet: best-effort answer, then close.
+            self._send_error(400, "request body incomplete")
+            return None
+        if len(body) < length:
+            self._send_error(400, "request body incomplete")
+            return None
+        return body
+
+    def _read_until_ceiling(self):
+        """Read an undeclared body, refusing to go more than one byte past the ceiling."""
+        try:
+            body = self.rfile.read(store.MAX_BODY_BYTES + 1)
+        except TimeoutError:
+            self._send_error(400, "request body incomplete")
+            return None
+        if len(body) > store.MAX_BODY_BYTES:
+            self._send_error(
+                413, f"request body exceeds the maximum of {store.MAX_BODY_BYTES} bytes"
+            )
+            return None
+        return body
+
+    def _decode_payload(self, body):
+        """Decode the body as a UTF-8 JSON object, or answer and return ``None``.
+
+        ``Content-Type`` is neither required nor consulted: acceptance depends only on whether the
+        body parses (FR-041).
+        """
+        try:
+            text = body.decode("utf-8")
+        except UnicodeDecodeError:
+            self._send_error(400, "request body is not valid JSON")
+            return None
+        try:
+            payload = json.loads(text)
+        except json.JSONDecodeError:
+            self._send_error(400, "request body is not valid JSON")
+            return None
+        if not isinstance(payload, dict):
+            self._send_error(400, "request body must be a JSON object")
+            return None
+        return payload
+
+    # -- responses -------------------------------------------------------------------------
+
+    def _send_bytes(self, status, content_type, body):
+        """Send one response with an accurate ``Content-Length``."""
+        self.send_response(status)
+        self.send_header("Content-Type", content_type)
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        if body:
+            self.wfile.write(body)
+
+    def _send_json(self, status, payload):
+        self._send_bytes(status, "application/json", json.dumps(payload).encode("utf-8"))
+
+    def _send_no_content(self):
+        """204 with a genuinely empty body (FR-023)."""
+        self.send_response(204)
+        self.send_header("Content-Length", "0")
+        self.end_headers()
+
+    def _send_error(self, status, message):
+        """Every unsuccessful response carries exactly one ``error`` field (FR-032).
+
+        ``BaseHTTPRequestHandler.send_error`` is never called: it emits an HTML page.
+        """
+        self._send_json(status, {"error": message})
+
+    def _not_found(self):
+        self._send_error(404, "not found")
+
+    def _damaged(self, paste_id, reason):
+        """Report damaged storage as an internal error, naming the snippet on stderr.
+
+        The response discloses no filesystem path or exception text; the detail goes to standard
+        error instead, and the service keeps serving every other snippet (FR-038, FR-039).
+        """
+        print(
+            f"error: stored paste {paste_id} {reason}",
+            file=sys.stderr,
+            flush=True,
+        )
+        self._send_error(500, "stored paste could not be read")
+
+
+class Server(ThreadingHTTPServer):
+    """A threading server that stays silent when a caller abandons its connection."""
+
+    daemon_threads = True
+
+    def handle_error(self, request, client_address):
+        """Report a failed connection only if the service is what failed.
+
+        ``socketserver`` prints a traceback to standard error for any exception that escapes a
+        handler, which FR-044 and SC-009 forbid: a caller is free to reset a connection at any
+        point — before the request line is complete, part way through its body, or before reading
+        the response — and none of those is a failure of this service or anything an operator can
+        act on. Each raises a connection-level error from a different place, including inside
+        ``http.server``'s own ``handle_one_request``, so this is the one point that covers them
+        all; wrapping the call sites would still leave the request-line read uncovered, and
+        reimplementing ``handle_one_request`` is what research.md R-08 rejects.
+
+        Every other exception keeps the standard loud traceback. That is the deliberate
+        non-decision of research.md R-08: an unanticipated failure must be noisy, never swallowed.
+        """
+        if isinstance(
+            sys.exc_info()[1],
+            (
+                BrokenPipeError,
+                ConnectionResetError,
+                ConnectionAbortedError,
+                TimeoutError,
+            ),
+        ):
+            return
+        super().handle_error(request, client_address)
+
+
+def make_server(port, data_dir):
+    """Build a listening server for ``127.0.0.1:port`` backed by ``data_dir``.
+
+    Construction binds and listens, so the socket is already accepting when this returns — which
+    is what lets the caller print the ready line only once the service really is ready (FR-004).
+    Pass ``port=0`` to let the operating system choose; the chosen port is in
+    ``server.server_address[1]``.
+    """
+    httpd = Server(("127.0.0.1", port), Handler)
+    httpd.data_dir = str(data_dir)
+    return httpd
