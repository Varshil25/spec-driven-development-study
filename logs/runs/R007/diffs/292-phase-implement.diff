+"""Undefined paths and unsupported methods.
+
+Covers FR-036: everything outside the four defined requests is 404 with the standard error body —
+never ``http.server``'s own 501 or 404 HTML page (research.md R-07).
+"""
+
+import pytest
+
+PASTE_ID = "Vk3q7mB2x9aLpR4sTzYwQg"
+
+
+@pytest.mark.parametrize(
+    "path",
+    [
+        "/",
+        "/pastes",
+        "/pastes/",
+        f"/pastes/{PASTE_ID}/extra",
+        f"/pastes/{PASTE_ID}/text",
+        f"/pastes/{PASTE_ID}/raw/extra",
+        "/pastes/../etc/passwd",
+        "/pastes/with%2Fslash",
+        "/pastes/far-too-long-" + "x" * 80,
+        "/snippets",
+        "/favicon.ico",
+    ],
+)
+def test_fr036_undefined_paths_are_404(service, path):
+    """FR-036: any path the service does not define is 404 with a JSON error body."""
+    response = service.get(path)
+
+    assert response.status == 404
+    assert response.json()["error"]
+    assert response.headers["Content-Type"] == "application/json"
+
+
+@pytest.mark.parametrize(
+    ("method", "path"),
+    [
+        ("PUT", "/pastes"),
+        ("PATCH", "/pastes"),
+        ("HEAD", "/pastes"),
+        ("OPTIONS", "/pastes"),
+        ("DELETE", "/pastes"),
+        ("GET", "/pastes"),
+        ("PUT", f"/pastes/{PASTE_ID}"),
+        ("PATCH", f"/pastes/{PASTE_ID}"),
+        ("POST", f"/pastes/{PASTE_ID}"),
+        ("OPTIONS", f"/pastes/{PASTE_ID}"),
+        ("HEAD", f"/pastes/{PASTE_ID}"),
+        ("TRACE", "/"),
+        ("PROPFIND", f"/pastes/{PASTE_ID}"),
+    ],
+)
+def test_fr036_unsupported_methods_are_404(service, method, path):
+    """FR-036: a defined path used with a method it does not support is 404, not 501."""
+    response = service.request(method, path)
+
+    assert response.status == 404
+    if method == "HEAD":
+        # A HEAD response carries no body for the client to read; the status is the assertion.
+        return
+    assert response.json()["error"]
+
+
+def test_fr036_query_string_does_not_change_the_route(service):
+    """A query string is ignored when matching the path (contracts/http-api.md)."""
+    response = service.get(f"/pastes/{PASTE_ID}?full=1")
+
+    # The identifier was never issued, so this is 404 for that reason rather than a routing miss.
+    assert response.status == 404
+    assert response.json()["error"] == "not found"