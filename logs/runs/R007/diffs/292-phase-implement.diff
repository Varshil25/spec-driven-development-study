+"""Command line: ``python -m pastebin serve --port PORT --data DIR``.
+
+Standard output carries exactly one line, ever: the ready line of FR-004. Standard error carries
+only the failures the specification names. See
+``specs/001-pastebin-service/contracts/cli.md``.
+"""
+
+import argparse
+import signal
+import sys
+
+from pastebin import server, store
+
+
+def _port(value):
+    """An ``argparse`` type for ``--port``: an integer in 1…65535, or a usage error (FR-006)."""
+    try:
+        number = int(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"{value!r} is not an integer") from None
+    if not 1 <= number <= 65535:
+        raise argparse.ArgumentTypeError(f"{number} is not in the range 1-65535")
+    return number
+
+
+def _parse_args(argv):
+    """Parse the command line. A violation exits 2 with the usage message (``argparse``)."""
+    parser = argparse.ArgumentParser(
+        prog="python -m pastebin",
+        description="A loopback-only HTTP service for text snippets.",
+    )
+    subcommands = parser.add_subparsers(dest="command", required=True)
+    serve = subcommands.add_parser("serve", help="start the service")
+    serve.add_argument(
+        "--port", type=_port, required=True, help="TCP port to listen on (1-65535)"
+    )
+    serve.add_argument(
+        "--data",
+        required=True,
+        metavar="DIR",
+        help="storage directory; created if absent, including parents",
+    )
+    return parser.parse_args(argv)
+
+
+def _interrupt(signum, frame):
+    """Turn SIGTERM into the same clean stop as Ctrl-C (contracts/cli.md → Shutdown)."""
+    raise KeyboardInterrupt
+
+
+def main(argv=None):
+    """Start the service. Returns the process exit status."""
+    args = _parse_args(argv)
+
+    try:
+        store.prepare_storage(args.data)
+    except OSError as error:
+        print(
+            f"error: storage directory {args.data!r} cannot be used: {error}",
+            file=sys.stderr,
+            flush=True,
+        )
+        return 1
+
+    try:
+        httpd = server.make_server(args.port, args.data)
+    except OSError as error:
+        print(
+            f"error: cannot listen on port {args.port}: {error}",
+            file=sys.stderr,
+            flush=True,
+        )
+        return 1
+
+    # The socket is bound and accepting by now, and never printed if either step above failed,
+    # so a caller that waits for this line can tell "started" from "failed" (FR-004, FR-005).
+    print(f"listening on 127.0.0.1:{httpd.server_address[1]}", flush=True)
+
+    signal.signal(signal.SIGTERM, _interrupt)
+    try:
+        httpd.serve_forever()
+    except KeyboardInterrupt:
+        return 0
+    finally:
+        httpd.server_close()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
