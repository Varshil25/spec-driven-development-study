new file mode 100644
index 0000000..c315729
--- /dev/null
+++ b/tests/test_errors.py
@@ -0,0 +1,242 @@
+"""The aggregate error surface.
+
+Covers FR-032…FR-035, FR-037, and FR-039: the shape of every unsuccessful response, which status
+each kind of problem gets, and the guarantee that no input the specification describes can provoke
+an undefined response.
+"""
+
+import json
+
+import pytest
+
+from conftest import parse_raw_response
+from pastebin import store
+
+OVERSIZE_CONTENT = "x" * (store.MAX_CONTENT_BYTES + 1)
+
+
+def provoke_400(service):
+    return service.post_raw(b"not json")
+
+
+def provoke_403(service):
+    published = service.publish("still here")
+    return service.delete(published["id"], token="wrong")
+
+
+def provoke_404(service):
+    return service.read("neverIssuedIdentifier")
+
+
+def provoke_413(service):
+    return service.post_json({"content": OVERSIZE_CONTENT})
+
+
+def provoke_500(service):
+    service.write_raw_record("aDamagedPasteRecord", b"{ truncated")
+    return service.read("aDamagedPasteRecord")
+
+
+PROVOKERS = {
+    400: provoke_400,
+    403: provoke_403,
+    404: provoke_404,
+    413: provoke_413,
+    500: provoke_500,
+}
+
+
+@pytest.mark.parametrize("status", sorted(PROVOKERS))
+def test_fr032_every_error_status_carries_single_error_field(service, status):
+    """FR-032: every unsuccessful response is a JSON object with exactly one ``error`` field."""
+    response = PROVOKERS[status](service)
+
+    assert response.status == status
+    body = response.json()
+    assert set(body) == {"error"}
+    assert isinstance(body["error"], str)
+    assert body["error"].strip()
+    assert response.headers["Content-Type"] == "application/json"
+    assert response.headers["Content-Length"] == str(len(response.body))
+
+
+@pytest.mark.parametrize(
+    ("payload", "expected_in_message"),
+    [
+        ({"expires_in": 60}, "content"),
+        ({"content": 42}, "content"),
+        ({"content": None}, "content"),
+        ({"content": ["a"]}, "content"),
+        ({"content": "x", "expires_in": 0}, "expires_in"),
+        ({"content": "x", "expires_in": -1}, "expires_in"),
+        ({"content": "x", "expires_in": "3600"}, "expires_in"),
+        ({"content": "x", "expires_in": 1.5}, "expires_in"),
+        ({"content": "x", "expires_in": True}, "expires_in"),
+        ({"content": "x", "expires_in": store.MAX_EXPIRES_IN + 1}, "expires_in"),
+    ],
+    ids=repr,
+)
+def test_fr033_invalid_input_is_400(service, payload, expected_in_message):
+    """FR-033: a malformed body, a missing or non-string text, or an invalid lifetime is 400."""
+    response = service.post_json(payload)
+
+    assert response.status == 400
+    assert expected_in_message in response.json()["error"]
+
+
+@pytest.mark.parametrize(
+    "body", [b"not json", b"{", b"[1,2,3]", b'"a string"', b"null", b""], ids=repr
+)
+def test_fr033_malformed_body_is_400(service, body):
+    """FR-033: a body that is not a well-formed JSON object is 400."""
+    response = service.post_raw(body)
+
+    assert response.status == 400
+    assert response.json()["error"]
+
+
+def test_fr034_oversize_content_is_413_not_400(service):
+    """FR-034: text over the size limit is payload-too-large, distinct from other invalid input."""
+    response = service.post_json({"content": OVERSIZE_CONTENT})
+
+    assert response.status == 413
+    assert "65536" in response.json()["error"]
+
+    # One byte less is accepted, so 413 marks the limit and nothing else.
+    assert service.post_json({"content": OVERSIZE_CONTENT[:-1]}).status == 201
+
+    # An oversize body is 413 as well, and names the larger bound.
+    raw = service.send_bytes(
+        b"POST /pastes HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Length: 999999999\r\n\r\n"
+    )
+    status, _, body = parse_raw_response(raw)
+    assert status == 413
+    assert str(store.MAX_BODY_BYTES) in json.loads(body)["error"]
+
+
+def test_fr035_refused_delete_is_403(service):
+    """FR-035: a refused deletion is forbidden, and the snippet is untouched."""
+    published = service.publish("still here")
+
+    missing = service.delete(published["id"])
+    wrong = service.delete(published["id"], token="wrong")
+
+    assert missing.status == 403
+    assert wrong.status == 403
+    assert "X-Delete-Token" in missing.json()["error"]
+    assert service.read(published["id"]).status == 200
+
+
+def test_fr037_no_specified_input_produces_an_undefined_response(service):
+    """FR-037: every input the specification describes gets one of the defined responses.
+
+    No caller input reaches the internal error of FR-039, which only damaged storage produces.
+    """
+    published = service.publish("a snippet to aim requests at")
+    paste_id = published["id"]
+    defined = {200, 201, 204, 400, 403, 404, 413}
+
+    responses = []
+
+    # Bodies the service must refuse.
+    for body in [
+        b"",
+        b"not json",
+        b"{",
+        b'{"content": }',
+        b"[1,2,3]",
+        b"42",
+        b'"a string"',
+        b"null",
+        b"true",
+        b"\xff\xfe",
+        b'{"content": "x"',
+        json.dumps({"content": 1}).encode(),
+        json.dumps({"content": None}).encode(),
+        json.dumps({"content": {}}).encode(),
+        json.dumps({"content": OVERSIZE_CONTENT}).encode(),
+        json.dumps({"content": "x", "expires_in": 0}).encode(),
+        json.dumps({"content": "x", "expires_in": -5}).encode(),
+        json.dumps({"content": "x", "expires_in": "60"}).encode(),
+        json.dumps({"content": "x", "expires_in": 1.5}).encode(),
+        json.dumps({"content": "x", "expires_in": False}).encode(),
+        json.dumps({"content": "x", "expires_in": store.MAX_EXPIRES_IN + 1}).encode(),
+        json.dumps({"expires_in": 60}).encode(),
+        json.dumps({}).encode(),
+        json.dumps({"content": "x", "unknown": "ignored"}).encode(),
+    ]:
+        responses.append(service.post_raw(body))
+
+    # Paths and methods the service does not define.
+    for method, path in [
+        ("GET", "/"),
+        ("GET", "/pastes"),
+        ("GET", f"/pastes/{paste_id}/extra"),
+        ("GET", "/pastes/../etc/passwd"),
+        ("GET", "/pastes/" + "x" * 200),
+        ("GET", "/pastes/not!a!valid!id"),
+        ("POST", "/"),
+        ("POST", f"/pastes/{paste_id}"),
+        ("PUT", "/pastes"),
+        ("PATCH", f"/pastes/{paste_id}"),
+        ("OPTIONS", "/pastes"),
+        ("DELETE", "/pastes"),
+        ("BREW", "/pastes"),
+    ]:
+        responses.append(service.request(method, path))
+
+    # Deletions with every kind of credential.
+    responses.append(service.delete(paste_id))
+    responses.append(service.delete(paste_id, token=""))
+    responses.append(service.delete(paste_id, token="wrong"))
+    responses.append(service.delete(paste_id, token="ünïcødé-token"))
+    responses.append(service.delete("neverIssuedIdentifier", token="wrong"))
+    responses.append(service.delete(paste_id, token=[REDACTED:assigned_secret]["delete_token"]))
+
+    # Reads of what no longer exists.
+    responses.append(service.read(paste_id))
+    responses.append(service.read_raw(paste_id))
+
+    for response in responses:
+        assert response.status in defined, response
+        if response.status >= 400:
+            body = response.json()
+            assert set(body) == {"error"}
+            assert isinstance(body["error"], str) and body["error"].strip()
+
+    # And a malformed Content-Length is a defined rejection too.
+    raw = service.send_bytes(
+        b"POST /pastes HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Length: abc\r\n\r\n{}"
+    )
+    status, _, body = parse_raw_response(raw)
+    assert status == 400
+    assert json.loads(body)["error"]
+
+
+def test_unanticipated_failure_is_still_loud(service, monkeypatch, capsys):
+    """research.md R-08: silencing abandoned connections must not silence a real defect.
+
+    There is no catch-all around the request handler. An exception nobody anticipated closes the
+    connection and prints a traceback, rather than being answered with a plausible 500.
+    """
+
+    def broken(*args, **kwargs):
+        raise ValueError("an unanticipated defect")
+
+    monkeypatch.setattr(store, "read_paste", broken)
+
+    with pytest.raises(Exception):
+        service.read("someIdentifier")
+
+    captured = capsys.readouterr()
+    assert "an unanticipated defect" in captured.err
+    assert "ValueError" in captured.err
+
+
+def test_fr039_internal_error_is_reachable_only_from_damaged_storage(service):
+    """FR-037 and FR-039: 500 comes from the stored form, never from what a caller sends."""
+    service.write_raw_record("aDamagedPasteRecord", b"{ truncated")
+
+    assert service.read("aDamagedPasteRecord").status == 500
+    # The same request against an identifier that is merely absent is a 404.
+    assert service.read("neverIssuedIdentifier").status == 404
