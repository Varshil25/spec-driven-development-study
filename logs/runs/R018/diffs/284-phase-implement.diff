@@ -0,0 +1,250 @@
+"""Storage rules for the bookmark manager: opening and validating the SQLite store,
+the schema, tag normalisation, the URL scheme check, and the queries.
+
+Standard library only (FR-025, constitution Principle I).
+"""
+
+import sqlite3
+from pathlib import Path
+
+
+class BookmarkError(Exception):
+    """A failure the contract describes, carrying the exit status it maps to.
+
+    One exception type with the status as data, rather than one class per status
+    (research R-008). ``message`` names what was invalid and what was expected, as
+    constitution Principle II requires; ``status`` is the process exit status from the
+    map in FR-024 (1 unusable store, 2 user mistake, 3 identifier does not exist).
+    """
+
+    def __init__(self, message, status):
+        super().__init__(message)
+        self.message = message
+        self.status = status
+
+
+# Quoted verbatim from data-model.md. AUTOINCREMENT is load-bearing for FR-006
+# (identifiers are never reused) and PRIMARY KEY (bookmark_id, tag) enforces FR-010's
+# at-most-once rule in storage. No index on tags(tag) and no UNIQUE on bookmarks.url
+# (data-model.md, research R-006).
+SCHEMA = (
+    """
+    CREATE TABLE IF NOT EXISTS bookmarks (
+        id    INTEGER PRIMARY KEY AUTOINCREMENT,
+        url   TEXT NOT NULL,
+        title TEXT NOT NULL DEFAULT ''
+    )
+    """,
+    """
+    CREATE TABLE IF NOT EXISTS tags (
+        bookmark_id INTEGER NOT NULL REFERENCES bookmarks(id) ON DELETE CASCADE,
+        tag         TEXT    NOT NULL,
+        PRIMARY KEY (bookmark_id, tag)
+    )
+    """,
+)
+
+OUR_TABLES = frozenset({"bookmarks", "tags"})
+
+
+def _initialise(connection):
+    for statement in SCHEMA:
+        connection.execute(statement)
+    connection.commit()
+
+
+def open_store(path):
+    """Open the store at ``path``, creating it only when it is absent (FR-002, FR-003).
+
+    An existing path that is not a usable bookmark store raises ``BookmarkError`` with
+    status 1 and is left byte-for-byte unchanged — never overwritten, truncated,
+    re-initialised or repaired — and no file or directory is created on any failing
+    branch (FR-003a, SC-009). The sequence is research R-002: open with ``mode=rw`` so
+    SQLite cannot create a file, and defer the verdict to a read-only query, so the
+    failure path never writes.
+    """
+    target = Path(path)
+    existed = target.exists()
+    # resolve().as_uri() percent-encodes the path, so a '?' or '#' in it is not read as
+    # SQLite URI syntax (research R-002).
+    uri = target.resolve().as_uri() + ("?mode=rw" if existed else "?mode=rwc")
+
+    try:
+        connection = sqlite3.connect(uri, uri=True)
+    except sqlite3.OperationalError as exc:
+        # Missing parent directory, or the file system denies access. No file and no
+        # directory has been created (FR-003a).
+        raise BookmarkError(f"cannot open store {path}: {exc}", 1) from exc
+
+    # SQLite leaves foreign keys off by default, so ON DELETE CASCADE would otherwise do
+    # nothing (data-model.md). Harmless before validation: it touches no page of the file.
+    connection.execute("PRAGMA foreign_keys = ON")
+
+    if not existed:
+        _initialise(connection)
+        return connection
+
+    try:
+        tables = {row[0] for row in connection.execute(
+            "SELECT name FROM sqlite_master WHERE type='table'"
+        )}
+    except sqlite3.OperationalError as exc:
+        connection.close()
+        raise BookmarkError(f"cannot read store {path}: {exc}", 1) from exc
+    except sqlite3.DatabaseError as exc:
+        connection.close()
+        raise BookmarkError(f"{path} is not a bookmark database: {exc}", 1) from exc
+
+    if tables & OUR_TABLES:
+        return connection
+    if tables:
+        connection.close()
+        raise BookmarkError(
+            f"{path} is a SQLite database belonging to another program "
+            f"(it holds {', '.join(sorted(tables))} but neither bookmarks nor tags); "
+            f"refusing to use it as a bookmark store",
+            1,
+        )
+    # A valid but empty database: give it our schema and carry on (FR-003).
+    _initialise(connection)
+    return connection
+
+
+ACCEPTED_SCHEMES = ("http://", "https://")
+
+
+def normalise_tags(raw):
+    """Turn a ``--tags``/``--tag`` value into the sorted set of tags it names (FR-010).
+
+    The five steps of data-model.md, in that order: split on ``,``, strip surrounding
+    whitespace, drop entries empty after stripping, lower-case, collapse duplicates. No
+    stemming, no synonyms, no Unicode form folding beyond ``str.lower()``.
+
+    The same function normalises the ``--tag`` filter value (FR-012), which is what
+    guarantees the two sides can never disagree.
+    """
+    if not raw:
+        return []
+    return sorted({entry.strip().lower() for entry in raw.split(",") if entry.strip()})
+
+
+def check_url(url):
+    """Reject a URL not beginning with the literal ``http://`` or ``https://`` (FR-007).
+
+    A literal prefix test: no parsing, no host validation, no reachability check (spec
+    Assumptions). Raises before any insert, so a rejected URL leaves the store exactly as
+    it was.
+    """
+    if not url.startswith(ACCEPTED_SCHEMES):
+        raise BookmarkError(
+            f"refusing to store {url!r}: a URL must begin with "
+            f"{ACCEPTED_SCHEMES[0]!r} or {ACCEPTED_SCHEMES[1]!r}",
+            2,
+        )
+
+
+def add_bookmark(connection, url, title, tags):
+    """Store a bookmark and return its new identifier (FR-005, FR-006, FR-008 … FR-010).
+
+    ``title`` is the empty string when the user omitted ``--title``, which the schema's
+    ``NOT NULL DEFAULT ''`` then keeps as a storage invariant (FR-008). ``tags`` is the raw
+    ``--tags`` value or ``None``.
+
+    No de-duplication on ``url``: the same address may be saved more than once, each time
+    receiving its own identifier (spec Edge Cases).
+    """
+    check_url(url)
+    cursor = connection.execute(
+        "INSERT INTO bookmarks (url, title) VALUES (?, ?)", (url, title)
+    )
+    bookmark_id = cursor.lastrowid
+    normalised = normalise_tags(tags)
+    if normalised:
+        connection.executemany(
+            "INSERT INTO tags (bookmark_id, tag) VALUES (?, ?)",
+            [(bookmark_id, tag) for tag in normalised],
+        )
+    connection.commit()
+    return bookmark_id
+
+
+_ROWS_QUERY = """
+    SELECT b.id, b.url, b.title, t.tag
+    FROM bookmarks b LEFT JOIN tags t ON t.bookmark_id = b.id
+    {where}
+    ORDER BY b.id
+"""
+
+
+def _collect(cursor):
+    """Group the joined rows into one record per bookmark, tags sorted (FR-014)."""
+    records = {}
+    for bookmark_id, url, title, tag in cursor:
+        record = records.get(bookmark_id)
+        if record is None:
+            record = records[bookmark_id] = {
+                "id": bookmark_id,
+                "url": url,
+                "title": title,
+                "tags": [],
+            }
+        if tag is not None:
+            record["tags"].append(tag)
+    for record in records.values():
+        # Python's default string ordering; stored tags are always lower case, so this is
+        # ordinary alphabetical order (data-model.md).
+        record["tags"].sort()
+    return list(records.values())
+
+
+def list_bookmarks(connection, tag=None):
+    """Every bookmark in ascending identifier order (FR-011, FR-014).
+
+    With ``tag``, only bookmarks carrying that whole tag (FR-012). The filter value goes
+    through :func:`normalise_tags` — the same function that normalised the stored tags, so
+    the two sides cannot disagree — and the comparison is SQL ``=``, from which whole-tag
+    matching comes free: ``py`` cannot match ``python`` (research R-005).
+    """
+    if tag is None:
+        return _collect(connection.execute(_ROWS_QUERY.format(where="")))
+
+    normalised = normalise_tags(tag)
+    if len(normalised) != 1:
+        # No bookmark can carry an empty tag, or one whose text holds a comma.
+        return []
+    return _collect(
+        connection.execute(
+            _ROWS_QUERY.format(
+                where="WHERE b.id IN (SELECT bookmark_id FROM tags WHERE tag = ?)"
+            ),
+            (normalised[0],),
+        )
+    )
+
+
+def delete_bookmark(connection, bookmark_id):
+    """Remove the bookmark with that identifier, together with its tags (FR-016).
+
+    The tag rows go with it through ``ON DELETE CASCADE`` — one declaration rather than a
+    second ``DELETE`` that could drift (research R-006). An identifier no bookmark holds is
+    status 3, and nothing is committed, so the store is unchanged (FR-017).
+    """
+    cursor = connection.execute("DELETE FROM bookmarks WHERE id = ?", (bookmark_id,))
+    if cursor.rowcount == 0:
+        raise BookmarkError(f"no bookmark has identifier {bookmark_id}", 3)
+    connection.commit()
+
+
+def search_bookmarks(connection, text):
+    """Bookmarks whose title or URL contains ``text``, ignoring case (FR-013).
+
+    Filtered in Python, not with SQL ``LIKE``/``lower()``: both are ASCII-only by default,
+    which would silently fail to fold case for a non-ASCII title, and ``LIKE`` would treat
+    ``%`` and ``_`` in the user's text as wildcards (research R-005).
+    """
+    needle = text.lower()
+    return [
+        row
+        for row in list_bookmarks(connection)
+        if needle in row["title"].lower() or needle in row["url"].lower()
+    ]
