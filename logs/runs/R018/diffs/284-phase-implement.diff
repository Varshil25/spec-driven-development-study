+# --------------------------------------------------------------------------- FR-025
+
+
+def _imported_top_level_modules(path):
+    """Top-level module names imported absolutely by one module (relative imports of our
+    own package carry no module name and are not third-party by construction)."""
+    names = set()
+    for node in ast.walk(ast.parse(path.read_text(encoding="utf-8"))):
+        if isinstance(node, ast.Import):
+            names.update(alias.name.split(".")[0] for alias in node.names)
+        elif isinstance(node, ast.ImportFrom) and not node.level:
+            names.add(node.module.split(".")[0])
+    return names
+
+
+def test_fr025_runtime_code_imports_only_the_standard_library():
+    """FR-025, constitution Principle I: no third-party runtime import anywhere, and the
+    import surface is exactly the six modules the design allows."""
+    imported = set()
+    modules = sorted(PACKAGE.glob("*.py"))
+    assert modules, "no runtime modules found"
+    for module in modules:
+        imported |= _imported_top_level_modules(module)
+
+    assert imported <= ALLOWED_IMPORTS, f"unexpected imports: {imported - ALLOWED_IMPORTS}"
+    assert imported <= sys.stdlib_module_names
+    assert "pytest" not in imported
+
+
+def test_fr025_runtime_runs_on_a_bare_interpreter_with_no_installed_package(run_cli, db):
+    """FR-025: nothing to install — the tool runs with src/ on PYTHONPATH alone."""
+    result = subprocess.run(
+        [sys.executable, "-m", "bookmarks", "--db", str(db), "list"],
+        # A minimal environment: no site-packages path tricks, no inherited variables.
+        env={"PYTHONPATH": str(REPO_ROOT / "src"), "PATH": "/usr/bin:/bin"},
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0
+
+
+def test_fr025_declared_python_floor_is_3_11():
+    """FR-025 and the constitution's Additional Constraints: the floor is declared once."""
+    pyproject = (REPO_ROOT / "pyproject.toml").read_text(encoding="utf-8")
+    assert pyproject.count("requires-python") == 1
+    assert 'requires-python = ">=3.11"' in pyproject
+    assert sys.version_info >= (3, 11)
+
+
+# ----------------------------------------------------------------- FR-027 (SC-008)
+
+
+def normalise(identifier):
+    """`FR-003a`, `fr_003a` and the `fr003a` of a test function name all mean FR-003a."""
+    return "FR-" + identifier[2:].lstrip("-_").lower()
+
+
+def test_fr027_sc008_every_functional_requirement_is_named_by_at_least_one_test():
+    """FR-027, SC-008, constitution Principle III: every FR in the spec is named by at
+    least one test, in its name or a comment. A requirement with no test counts as
+    unimplemented regardless of the code."""
+    spec = SPEC.read_text(encoding="utf-8")
+    requirements = sorted(set(re.findall(r"\bFR-\d{3}[a-z]?\b", spec)))
+    assert len(requirements) >= 27, requirements
+
+    covered = set()
+    for test_file in sorted(TESTS.glob("test_*.py")):
+        text = test_file.read_text(encoding="utf-8")
+        covered |= {
+            normalise(requirement)
+            for requirement in re.findall(r"\b[Ff][Rr][-_]?\d{3}[a-z]?\b", text)
+        }
+
+    missing = [requirement for requirement in requirements if requirement not in covered]
+    assert not missing, f"requirements with no test naming them: {missing}"
+
+
+def test_fr027_the_store_schema_matches_the_data_model(db):
+    """FR-027/data-model.md: AUTOINCREMENT and the composite primary key are load-bearing
+    for FR-006 and FR-010, so assert they are actually in the shipped schema."""
+    from bookmarks import store
+
+    store.open_store(db).close()
+    connection = sqlite3.connect(str(db))
+    try:
+        schema = {
+            name: sql
+            for name, sql in connection.execute(
+                "SELECT name, sql FROM sqlite_master WHERE type='table'"
+            )
+        }
+    finally:
+        connection.close()
+    assert "AUTOINCREMENT" in schema["bookmarks"]
+    assert "ON DELETE CASCADE" in schema["tags"]
+    assert "PRIMARY KEY (bookmark_id, tag)" in schema["tags"]
