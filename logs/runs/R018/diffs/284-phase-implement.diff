--- /dev/null
+++ b/tests/test_performance.py
@@ -0,0 +1,69 @@
+"""The performance budget and large-store fidelity: SC-002 and SC-007.
+
+The 1,000-bookmark store is seeded through ``store.py`` directly — 1,000 subprocess
+launches would cost minutes, and the seeding route is not what is under test (research
+R-009). The user-visible commands are then measured as real subprocesses.
+"""
+
+import time
+
+import pytest
+
+COUNT = 1000
+BUDGET_SECONDS = 1.0
+
+
+@pytest.fixture
+def large_store(db, seed_many):
+    identifiers = seed_many(db, COUNT)
+    assert len(identifiers) == COUNT
+    return db
+
+
+def timed(run_cli, *args):
+    start = time.perf_counter()
+    result = run_cli(*args)
+    elapsed = time.perf_counter() - start
+    assert result.returncode == 0, result.stderr
+    return result, elapsed
+
+
+# --------------------------------------------------------------------------- SC-007
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        ("list",),
+        ("list", "--tag", "common"),
+        ("search", "Page 7"),
+        ("export", "--format", "csv"),
+        ("export", "--format", "json"),
+        ("delete", 1),
+    ],
+    ids=["list", "list-tag", "search", "export-csv", "export-json", "delete"],
+)
+def test_sc007_each_command_returns_in_under_a_second_on_a_1000_bookmark_store(
+    run_cli, large_store, command
+):
+    """SC-007: under one second per command, measured through a real subprocess."""
+    _, elapsed = timed(run_cli, "--db", large_store, *command)
+    assert elapsed < BUDGET_SECONDS, f"{command} took {elapsed:.3f}s"
+
+
+# --------------------------------------------------------------------------- SC-002
+
+
+def test_sc002_list_returns_all_1000_bookmarks_unchanged(run_cli, large_store):
+    """SC-002: all 1,000 come back with URLs, titles and tags identical to what was
+    stored, in ascending identifier order."""
+    result, _ = timed(run_cli, "--db", large_store, "list")
+    lines = result.stdout.split("\n")[:-1]
+    assert len(lines) == COUNT
+
+    for index, line in enumerate(lines):
+        identifier, url, title, tags = line.split("\t")
+        assert identifier == str(index + 1)
+        assert url == f"https://example.com/page/{index}"
+        assert title == f"Page {index}"
+        assert tags == ",".join(sorted({"common", f"tag{index % 10}"}))
diff --git a/tests/test_store.py b/tests/test_store.py
new file mode 100644
index 0000000..e077546
--- /dev/null
+++ b/tests/test_store.py
@@ -0,0 +1,241 @@
+"""Store lifecycle: FR-002, FR-003, FR-003a, FR-004 and SC-009.
+
+These exercise ``store.open_store`` directly; the subprocess-level assertions for the
+same failures (exit status 1, empty stdout) are at the bottom of this file.
+"""
+
+import hashlib
+import os
+import sqlite3
+import stat
+from pathlib import Path
+
+import pytest
+
+from bookmarks import store
+from bookmarks.cli import build_parser
+
+
+def sha256(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def tables_of(path):
+    connection = sqlite3.connect(str(path))
+    try:
+        return {
+            row[0]
+            for row in connection.execute(
+                "SELECT name FROM sqlite_master WHERE type='table'"
+            )
+        }
+    finally:
+        connection.close()
+
+
+# --------------------------------------------------------------------------- FR-002
+
+
+def test_fr002_default_store_is_bookmarks_db_in_the_current_directory():
+    """FR-002: with no --db, the store is bookmarks.db in the working directory."""
+    assert build_parser().get_default("db") == "bookmarks.db"
+
+
+def test_fr002_default_path_is_relative_to_the_working_directory(tmp_path, monkeypatch):
+    """FR-002: the default path resolves against the current directory, so two
+    directories hold two separate collections."""
+    monkeypatch.chdir(tmp_path)
+    store.open_store("bookmarks.db").close()
+    assert (tmp_path / "bookmarks.db").exists()
+
+
+def test_fr002_db_option_path_overrides_the_default(tmp_path):
+    """FR-002: --db PATH selects the store file."""
+    elsewhere = tmp_path / "chosen.db"
+    store.open_store(elsewhere).close()
+    assert elsewhere.exists()
+
+
+# --------------------------------------------------------------------------- FR-003
+
+
+def test_fr003_absent_path_with_existing_parent_is_created_with_its_schema(db):
+    """FR-003: the store file and its structure are created when absent."""
+    assert not db.exists()
+    store.open_store(db).close()
+    assert db.exists()
+    assert {"bookmarks", "tags"} <= tables_of(db)
+
+
+def test_fr003_existing_store_is_opened_and_appended_to_never_reset(db):
+    """FR-003: an existing store is opened without destroying its contents."""
+    connection = store.open_store(db)
+    connection.execute("INSERT INTO bookmarks (url, title) VALUES ('https://a', 'A')")
+    connection.commit()
+    connection.close()
+
+    reopened = store.open_store(db)
+    try:
+        rows = reopened.execute("SELECT url, title FROM bookmarks").fetchall()
+        reopened.execute("INSERT INTO bookmarks (url, title) VALUES ('https://b', 'B')")
+        reopened.commit()
+        assert rows == [("https://a", "A")]
+        assert reopened.execute("SELECT count(*) FROM bookmarks").fetchone()[0] == 2
+    finally:
+        reopened.close()
+
+
+def test_fr003_valid_but_empty_sqlite_database_gets_the_schema(db):
+    """FR-003: a zero-table SQLite file is initialised rather than refused."""
+    sqlite3.connect(str(db)).close()
+    assert tables_of(db) == set()
+    store.open_store(db).close()
+    assert {"bookmarks", "tags"} <= tables_of(db)
+
+
+def test_fr003_foreign_keys_are_enabled_on_every_connection(db):
+    """FR-003/FR-016: without PRAGMA foreign_keys = ON the ON DELETE CASCADE is inert."""
+    connection = store.open_store(db)
+    try:
+        assert connection.execute("PRAGMA foreign_keys").fetchone()[0] == 1
+    finally:
+        connection.close()
+
+
+# -------------------------------------------------------------------------- FR-003a
+
+
+def test_fr003a_missing_parent_directory_fails_without_creating_anything(tmp_path):
+    """FR-003a: exit status 1, and no directory and no file is created."""
+    missing_parent = tmp_path / "nope"
+    target = missing_parent / "bookmarks.db"
+
+    with pytest.raises(store.BookmarkError) as raised:
+        store.open_store(target)
+
+    assert raised.value.status == 1
+    assert str(target) in raised.value.message
+    assert not missing_parent.exists()
+    assert not target.exists()
+
+
+def test_fr003a_sc009_plain_text_file_is_refused_byte_for_byte_unchanged(tmp_path):
+    """FR-003a, SC-009: a file that is not a bookmark database is left untouched."""
+    plain = tmp_path / "plain.txt"
+    plain.write_text("this is not a database\n", encoding="utf-8")
+    before = sha256(plain)
+
+    with pytest.raises(store.BookmarkError) as raised:
+        store.open_store(plain)
+
+    assert raised.value.status == 1
+    assert str(plain) in raised.value.message
+    # Names the reason as well as the path (constitution Principle II).
+    assert "not a bookmark database" in raised.value.message
+    assert sha256(plain) == before
+
+
+def test_fr003a_sc009_another_programs_database_is_refused_and_untouched(tmp_path):
+    """FR-003a, SC-009: a valid SQLite file holding foreign tables is still not ours."""
+    other = tmp_path / "other.db"
+    connection = sqlite3.connect(str(other))
+    connection.execute("CREATE TABLE other (x)")
+    connection.commit()
+    connection.close()
+    before = sha256(other)
+
+    with pytest.raises(store.BookmarkError) as raised:
+        store.open_store(other)
+
+    assert raised.value.status == 1
+    assert str(other) in raised.value.message
+    assert "another program" in raised.value.message
+    assert sha256(other) == before
+    assert tables_of(other) == {"other"}
+
+
+@pytest.mark.skipif(
+    os.geteuid() == 0,
+    reason="root bypasses the mode bits, so a chmod 000 store would still open and the "
+    "test would pass without proving anything (research R-002)",
+)
+def test_fr003a_permission_denied_is_reported_as_an_unusable_store(db):
+    """FR-003a: the file system denying the required access exits 1, file unchanged."""
+    store.open_store(db).close()
+    before = sha256(db)
+    db.chmod(0)
+    try:
+        with pytest.raises(store.BookmarkError) as raised:
+            store.open_store(db)
+        assert raised.value.status == 1
+        assert str(db) in raised.value.message
+    finally:
+        db.chmod(stat.S_IRUSR | stat.S_IWUSR)
+    assert sha256(db) == before
+
+
+# ------------------------------------- FR-003a, SC-009 at the subprocess level (T021)
+#
+# The same failures as above, now observed the way a user does: a real exit status, a
+# diagnostic on stderr and nothing on stdout, for a read command and a write command
+# alike (research R-009).
+
+
+def unusable_store_cases(tmp_path):
+    plain = tmp_path / "plain.txt"
+    plain.write_text("this is not a database\n", encoding="utf-8")
+
+    other = tmp_path / "other.db"
+    connection = sqlite3.connect(str(other))
+    connection.execute("CREATE TABLE other (x)")
+    connection.commit()
+    connection.close()
+
+    return {
+        "missing-parent": tmp_path / "nope" / "bookmarks.db",
+        "not-a-database": plain,
+        "another-program": other,
+    }
+
+
+@pytest.mark.parametrize("case", ["missing-parent", "not-a-database", "another-program"])
+@pytest.mark.parametrize("command", [("list",), ("add", "https://x.example.com")])
+def test_fr003a_sc009_unusable_store_exits_1_with_empty_stdout(
+    run_cli, tmp_path, case, command
+):
+    """FR-003a, SC-009: status 1, a diagnostic naming the path on stderr, nothing on
+    stdout, no file or directory created, and the target byte-for-byte unchanged — for
+    both a read command (list) and a write command (add)."""
+    target = unusable_store_cases(tmp_path)[case]
+    before = sha256(target) if target.exists() else None
+
+    result = run_cli("--db", target, *command)
+
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert str(target) in result.stderr
+    if before is None:
+        assert not target.exists()
+        assert not target.parent.exists()
+    else:
+        assert sha256(target) == before
+
+
+@pytest.mark.skipif(
+    os.geteuid() == 0,
+    reason="root bypasses the mode bits, so a read-only store would still open and the "
+    "test would pass without proving anything (research R-002)",
+)
+def test_fr003a_read_only_store_file_fails_with_status_1_even_for_list(run_cli, db):
+    """Research R-002, CLI contract: all commands open the store read-write because any
+    command may have to create it, so a read-only file exits 1 even for `list` — a
+    documented consequence, not an accident."""
+    store.open_store(db).close()
+    db.chmod(stat.S_IRUSR)
+    try:
+        result = run_cli("--db", db, "list")
+        assert result.returncode == 1
+        assert result.stdout == ""
+        assert str(db) in result.stderr
+    finally:
+        db.chmod(stat.S_IRUSR | stat.S_IWUSR)