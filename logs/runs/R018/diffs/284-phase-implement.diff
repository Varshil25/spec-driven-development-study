+"""`delete`: FR-016, FR-017, and identifier non-reuse (FR-006)."""
+
+import hashlib
+import sqlite3
+from pathlib import Path
+
+
+def tag_rows(db):
+    connection = sqlite3.connect(str(db))
+    try:
+        return connection.execute("SELECT bookmark_id, tag FROM tags").fetchall()
+    finally:
+        connection.close()
+
+
+# --------------------------------------------------------------------------- FR-016
+
+
+def test_fr016_deleted_bookmark_appears_in_no_later_listing_search_or_export(run_cli, db):
+    """FR-016: the bookmark is gone from every later view."""
+    run_cli("--db", db, "add", "https://keep.example.com", "--title", "Keep")
+    run_cli("--db", db, "add", "https://drop.example.com", "--title", "Drop")
+
+    result = run_cli("--db", db, "delete", 2)
+    assert result.returncode == 0
+    assert result.stdout == ""
+
+    assert "drop.example.com" not in run_cli("--db", db, "list").stdout
+    assert run_cli("--db", db, "search", "Drop").stdout == ""
+    assert "drop.example.com" not in run_cli("--db", db, "export", "--format", "csv").stdout
+    assert "drop.example.com" not in run_cli("--db", db, "export", "--format", "json").stdout
+    assert "keep.example.com" in run_cli("--db", db, "list").stdout
+
+
+def test_fr016_deleting_a_bookmark_removes_its_tags_by_cascade(run_cli, db):
+    """FR-016: the tag rows go with the bookmark, which is only true if
+    PRAGMA foreign_keys = ON is set on the connection (research R-006)."""
+    run_cli("--db", db, "add", "https://a.example.com", "--tags", "python,docs")
+    run_cli("--db", db, "add", "https://b.example.com", "--tags", "news")
+    assert sorted(tag_rows(db)) == [(1, "docs"), (1, "python"), (2, "news")]
+
+    assert run_cli("--db", db, "delete", 1).returncode == 0
+    assert tag_rows(db) == [(2, "news")]
+
+
+# --------------------------------------------------------------------------- FR-017
+
+
+def test_fr017_sc005_deleting_an_identifier_no_bookmark_holds_exits_3(run_cli, db):
+    """FR-017, SC-005: a diagnostic naming the identifier on stderr, status 3, and the
+    stored collection left byte-for-byte unchanged."""
+    run_cli("--db", db, "add", "https://a.example.com")
+    before = hashlib.sha256(Path(db).read_bytes()).hexdigest()
+
+    result = run_cli("--db", db, "delete", 99)
+
+    assert result.returncode == 3
+    assert result.stdout == ""
+    assert "99" in result.stderr
+    assert hashlib.sha256(Path(db).read_bytes()).hexdigest() == before
+    assert "a.example.com" in run_cli("--db", db, "list").stdout
+
+
+def test_fr017_us3_scenario3_deleting_an_already_deleted_identifier_exits_3(run_cli, db):
+    """US3 scenario 3: the second delete of the same identifier also exits 3."""
+    run_cli("--db", db, "add", "https://a.example.com")
+    assert run_cli("--db", db, "delete", 1).returncode == 0
+
+    result = run_cli("--db", db, "delete", 1)
+    assert result.returncode == 3
+    assert "1" in result.stderr
+
+
+def test_fr017_delete_on_an_empty_store_exits_3(run_cli, db):
+    """FR-017: well-formed but absent, even when nothing was ever stored."""
+    result = run_cli("--db", db, "delete", 1)
+    assert result.returncode == 3
+    assert result.stdout == ""
+    assert result.stderr != ""
+
+
+# --------------------------------------------------------------------------- FR-006
+
+
+def test_fr006_us3_scenario4_identifiers_are_never_reissued_after_deletion(run_cli, db):
+    """FR-006, US3 scenario 4: delete bookmark 2 of 2 and the next add must print 3,
+    not 2 — the single most likely thing to regress (research R-004)."""
+    assert run_cli("--db", db, "add", "https://a.example.com").stdout == "1\n"
+    assert run_cli("--db", db, "add", "https://b.example.com").stdout == "2\n"
+    assert run_cli("--db", db, "delete", 2).returncode == 0
+
+    assert run_cli("--db", db, "add", "https://c.example.com").stdout == "3\n"
+
+
+def test_fr006_identifier_stays_retired_after_deleting_every_bookmark(run_cli, db):
+    """FR-006: an identifier that has been issued is never issued again, even when the
+    store is emptied."""
+    run_cli("--db", db, "add", "https://a.example.com")
+    run_cli("--db", db, "add", "https://b.example.com")
+    run_cli("--db", db, "delete", 1)
+    run_cli("--db", db, "delete", 2)
+    assert run_cli("--db", db, "list").stdout == ""
+
+    assert run_cli("--db", db, "add", "https://c.example.com").stdout == "3\n"
+
+
+# -------------------------------------------------------------- FR-024 (2, never 3)
+
+
+def test_fr024_non_numeric_identifier_exits_2_never_3(run_cli, db):
+    """FR-024, data-model.md: `delete abc` is a usage mistake (2); status 3 is reserved
+    exclusively for a well-formed identifier that no bookmark holds."""
+    run_cli("--db", db, "add", "https://a.example.com")
+
+    result = run_cli("--db", db, "delete", "abc")
+
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "abc" in result.stderr
+    assert "a.example.com" in run_cli("--db", db, "list").stdout
