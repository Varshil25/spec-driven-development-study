+"""Command grammar, stream setup, dispatch, output rendering and the single error
+handler for the bookmark manager.
+
+Standard library only (FR-025, constitution Principle I).
+"""
+
+import argparse
+import csv
+import json
+import sys
+
+from . import store
+
+
+def render_tsv(rows):
+    """The `list`/`search` record format: exactly four tab-separated fields per line, in
+    the order identifier, URL, title, comma-joined alphabetical tags, emitted raw with no
+    escaping (FR-014, CLI contract).
+
+    Shared by both commands, so the two views cannot drift apart.
+    """
+    for row in rows:
+        print(f"{row['id']}\t{row['url']}\t{row['title']}\t{','.join(row['tags'])}")
+
+
+def render_csv(rows):
+    """The CSV export: the header line, then one row per bookmark (FR-018, FR-019).
+
+    ``lineterminator="\\n"`` overrides the module's RFC-4180 default of ``\\r\\n``
+    (FR-019a) and works with the ``newline=""`` set on stdout in :func:`main`, which is
+    what keeps a line break inside a quoted field intact. The module's own quoting is
+    correct and round-trip tested — hand-rolling it is a known source of data-corrupting
+    bugs (research R-007).
+    """
+    writer = csv.writer(sys.stdout, lineterminator="\n")
+    writer.writerow(["id", "url", "title", "tags"])
+    for row in rows:
+        writer.writerow([row["id"], row["url"], row["title"], ",".join(row["tags"])])
+
+
+def render_json(rows):
+    """The JSON export: one array, two-space indented, literal non-ASCII, exactly one
+    trailing newline (FR-020, FR-020a, research R-007)."""
+    sys.stdout.write(json.dumps(rows, indent=2, ensure_ascii=False))
+    sys.stdout.write("\n")
+
+
+RENDERERS = {"csv": render_csv, "json": render_json}
+
+
+def handle_add(args):
+    """`add URL [--title TITLE] [--tags TAGS]` (FR-005, FR-008, FR-009)."""
+    connection = store.open_store(args.db)
+    try:
+        bookmark_id = store.add_bookmark(connection, args.url, args.title, args.tags)
+    finally:
+        connection.close()
+    print(bookmark_id)
+    return 0
+
+
+def handle_list(args):
+    """`list [--tag TAG]` (FR-011, FR-012, FR-014, FR-015)."""
+    connection = store.open_store(args.db)
+    try:
+        rows = store.list_bookmarks(connection, args.tag)
+    finally:
+        connection.close()
+    render_tsv(rows)
+    return 0
+
+
+def handle_export(args):
+    """`export --format {csv,json}` (FR-018, FR-020).
+
+    Reads through the existing ``list_bookmarks`` — no new store function is needed.
+    """
+    connection = store.open_store(args.db)
+    try:
+        rows = store.list_bookmarks(connection)
+    finally:
+        connection.close()
+    RENDERERS[args.format](rows)
+    return 0
+
+
+def handle_delete(args):
+    """`delete ID` — nothing on stdout, status 0 on success (FR-016, CLI contract)."""
+    connection = store.open_store(args.db)
+    try:
+        store.delete_bookmark(connection, args.id)
+    finally:
+        connection.close()
+    return 0
+
+
+def handle_search(args):
+    """`search TEXT` (FR-013, FR-014, FR-015)."""
+    connection = store.open_store(args.db)
+    try:
+        rows = store.search_bookmarks(connection, args.text)
+    finally:
+        connection.close()
+    render_tsv(rows)
+    return 0
+
+
+def build_parser():
+    """The command grammar.
+
+    ``prog`` must be set explicitly: argparse's default under ``python -m bookmarks`` is
+    the literal string ``__main__.py``, which would misname the tool in every diagnostic
+    (research R-003).
+
+    ``ArgumentParser.error`` is deliberately **not** overridden. Its default already
+    writes a specific diagnostic to stderr and exits 2, which is exactly what FR-024
+    demands for an unknown command, a missing required argument, a non-numeric ``delete``
+    identifier and an unsupported ``--format`` (research R-003).
+    """
+    parser = argparse.ArgumentParser(
+        prog="python -m bookmarks",
+        description="Save, find, remove and export bookmarks in a single SQLite file.",
+    )
+    parser.add_argument(
+        "--db",
+        metavar="PATH",
+        default="bookmarks.db",
+        help="the SQLite store file (default: bookmarks.db in the current directory)",
+    )
+    subcommands = parser.add_subparsers(dest="command", required=True)
+
+    add = subcommands.add_parser("add", help="store a bookmark and print its identifier")
+    add.add_argument("url", help="must begin with http:// or https://")
+    add.add_argument("--title", default="", help="display title (default: empty)")
+    add.add_argument("--tags", help="comma-separated tag list, e.g. python,cli")
+    add.set_defaults(handler=handle_add)
+
+    listing = subcommands.add_parser(
+        "list", help="print bookmarks in ascending identifier order"
+    )
+    listing.add_argument(
+        "--tag",
+        metavar="TAG",
+        help="keep only bookmarks carrying this whole tag (capitalisation disregarded)",
+    )
+    listing.set_defaults(handler=handle_list)
+
+    search = subcommands.add_parser(
+        "search", help="print bookmarks whose title or URL contains TEXT"
+    )
+    search.add_argument("text", metavar="TEXT", help="substring to look for, ignoring case")
+    search.set_defaults(handler=handle_search)
+
+    delete = subcommands.add_parser(
+        "delete", help="remove the bookmark with this identifier, together with its tags"
+    )
+    # type=int makes argparse itself produce the precise diagnostic and status 2 for a
+    # non-numeric value, keeping status 3 strictly for the well-formed-but-absent case
+    # (research R-003).
+    delete.add_argument("id", metavar="ID", type=int, help="identifier of the bookmark")
+    delete.set_defaults(handler=handle_delete)
+
+    export = subcommands.add_parser("export", help="print the whole collection")
+    # required=True plus choices gives argparse's own diagnostic and exit 2 for an
+    # unsupported or missing value, with no hand-written validation (research R-003).
+    export.add_argument(
+        "--format", required=True, choices=sorted(RENDERERS), help="output format"
+    )
+    export.set_defaults(handler=handle_export)
+
+    return parser
+
+
+def main(argv):
+    """Entry point. Returns the process exit status (FR-024)."""
+    # UTF-8 on both streams regardless of locale (FR-023a), and no newline translation on
+    # stdout, which is what keeps a line break inside a quoted CSV field intact and every
+    # line LF-terminated (FR-019a, research R-007). Done once, here.
+    sys.stdout.reconfigure(encoding="utf-8", newline="")
+    sys.stderr.reconfigure(encoding="utf-8")
+
+    args = build_parser().parse_args(argv)
+
+    # Exactly one handler. Results reach stdout only after the work succeeds, so a failing
+    # command emits no partial output (FR-023). sqlite3.Error is deliberately not caught
+    # broadly: an unexpected database fault must crash loudly rather than be folded into
+    # one of the four documented statuses (research R-008).
+    try:
+        return args.handler(args)
+    except store.BookmarkError as exc:
+        print(f"bookmarks: {exc.message}", file=sys.stderr)
+        return exc.status
