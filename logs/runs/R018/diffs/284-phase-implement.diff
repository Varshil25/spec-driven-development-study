@@ -0,0 +1,17 @@
+# Bookmark Manager CLI — project configuration.
+#
+# Deliberately minimal (constitution Principle IV): there is no build backend and no
+# packaging metadata, because the tool is run as `python -m bookmarks` with `src/` on
+# PYTHONPATH (FR-026) and is never installed. The only two things declared here are the
+# supported Python floor and the test-runner configuration.
+
+[project]
+# The minimum supported Python version, declared exactly once for the whole project
+# (constitution, Additional Constraints). No name/version/dependencies: nothing builds
+# or installs this tree, and the runtime has no third-party dependency at all (FR-025).
+requires-python = ">=3.11"
+
+[tool.pytest.ini_options]
+# Resolves `import bookmarks` from src/ with no install step (research R-009).
+pythonpath = ["src"]
+testpaths = ["tests"]
