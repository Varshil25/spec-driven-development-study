+# --------------------------------------------------------------------------- FR-024
+
+
+def test_fr024_unsupported_format_exits_2_with_a_diagnostic(run_cli, db):
+    """FR-024: `--format xml` is a usage mistake — stderr, nothing on stdout, status 2."""
+    result = run_cli("--db", db, "export", "--format", "xml")
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "xml" in result.stderr
