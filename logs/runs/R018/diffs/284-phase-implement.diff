@@ -0,0 +1,338 @@
+"""The cross-cutting contract: FR-001, FR-022, FR-023, FR-023a, FR-024, FR-025, FR-026
+and FR-027 (with SC-008).
+
+Everything here is asserted through a real subprocess, because an in-process call cannot
+observe a real process exit status or the stdout/stderr split (research R-009).
+"""
+
+import ast
+import re
+import subprocess
+import sqlite3
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+PACKAGE = REPO_ROOT / "src" / "bookmarks"
+TESTS = REPO_ROOT / "tests"
+SPEC = REPO_ROOT / "specs" / "001-bookmark-manager-cli" / "spec.md"
+
+COMMANDS = ("add", "list", "search", "delete", "export")
+
+# The complete runtime import surface allowed by FR-025 and research R-001/R-010.
+ALLOWED_IMPORTS = {"argparse", "sqlite3", "csv", "json", "sys", "pathlib"}
+
+
+# ------------------------------------------------------------------- FR-001, FR-026
+
+
+def test_fr001_fr026_tool_is_invocable_as_python_m_bookmarks(run_cli):
+    """FR-001, FR-026: runnable as `python -m bookmarks` with src/ on PYTHONPATH."""
+    result = run_cli("--help")
+    assert result.returncode == 0
+    assert "python -m bookmarks" in result.stdout
+
+
+def test_fr026_package_lives_in_bookmarks_under_src():
+    """FR-026: the code lives in a package named bookmarks under src/."""
+    assert (PACKAGE / "__init__.py").exists()
+    assert (PACKAGE / "__main__.py").exists()
+
+
+@pytest.mark.parametrize("command", COMMANDS)
+def test_fr001_all_five_commands_are_supported(run_cli, command):
+    """FR-001: add, list, search, delete and export are all present."""
+    result = run_cli(command, "--help")
+    assert result.returncode == 0
+    assert command in result.stdout
+
+
+def test_fr001_db_option_is_global_and_precedes_the_command(run_cli, db):
+    """FR-001, CLI contract: --db PATH is a global option, declared before the command."""
+    assert run_cli("--db", db, "add", "https://example.com").returncode == 0
+    assert db.exists()
+
+
+# --------------------------------------------------------------------------- FR-022
+
+
+def test_fr022_every_command_that_completes_its_work_exits_zero(run_cli, db):
+    """FR-022: status 0 for all five commands, including ones that match nothing."""
+    assert run_cli("--db", db, "add", "https://a.example.com", "--tags", "t").returncode == 0
+    assert run_cli("--db", db, "list").returncode == 0
+    assert run_cli("--db", db, "list", "--tag", "t").returncode == 0
+    assert run_cli("--db", db, "list", "--tag", "absent").returncode == 0
+    assert run_cli("--db", db, "search", "a").returncode == 0
+    assert run_cli("--db", db, "search", "zzz").returncode == 0
+    assert run_cli("--db", db, "export", "--format", "csv").returncode == 0
+    assert run_cli("--db", db, "export", "--format", "json").returncode == 0
+    assert run_cli("--db", db, "delete", 1).returncode == 0
+
+
+# --------------------------------------------------------------------------- FR-023
+
+
+def test_fr023_results_go_to_stdout_and_nothing_to_stderr_on_success(run_cli, db):
+    """FR-023: results on stdout; a successful command writes no diagnostic."""
+    run_cli("--db", db, "add", "https://example.com", "--title", "T")
+    result = run_cli("--db", db, "list")
+    assert result.stdout.startswith("1\thttps://example.com\tT")
+    assert result.stderr == ""
+
+
+def test_fr023_rejected_url_writes_nothing_to_stdout(run_cli, db):
+    """FR-023: a failing command writes no partial results to stdout."""
