@@ -0,0 +1,201 @@
+"""`add`: FR-005, FR-006, FR-007, FR-008, FR-009, FR-010 (and SC-004)."""
+
+import sqlite3
+
+import pytest
+
+
+def stored_rows(db):
+    connection = sqlite3.connect(str(db))
+    try:
+        return connection.execute("SELECT id, url, title FROM bookmarks ORDER BY id").fetchall()
+    finally:
+        connection.close()
+
+
+def stored_tags(db, bookmark_id):
+    connection = sqlite3.connect(str(db))
+    try:
+        return [
+            row[0]
+            for row in connection.execute(
+                "SELECT tag FROM tags WHERE bookmark_id = ? ORDER BY tag", (bookmark_id,)
+            )
+        ]
+    finally:
+        connection.close()
+
+
+def tags_field(run_cli, db):
+    """The tags column of the single bookmark in the store, via `list` (FR-014)."""
+    result = run_cli("--db", db, "list")
+    assert result.returncode == 0
+    lines = result.stdout.splitlines()
+    assert len(lines) == 1
+    return lines[0].split("\t")[3]
+
+
+# --------------------------------------------------------------------------- FR-005
+
+
+def test_fr005_add_prints_the_identifier_and_nothing_else(run_cli, db):
+    """FR-005: stdout is the new identifier and nothing else."""
+    result = run_cli("--db", db, "add", "https://docs.python.org")
+    assert result.returncode == 0
+    assert result.stdout == "1\n"
+    assert result.stderr == ""
+
+
+def test_sc001_first_bookmark_is_saved_and_listed_in_two_commands_with_no_setup(
+    run_cli, tmp_path
+):
+    """SC-001: a first-time user saves and sees a bookmark with two commands and no
+    configuration step — the store does not exist until the first `add` creates it."""
+    assert not (tmp_path / "bookmarks.db").exists()
+
+    added = run_cli("add", "https://docs.python.org", "--title", "Python docs", cwd=tmp_path)
+    listed = run_cli("list", cwd=tmp_path)
+
+    assert (added.returncode, added.stdout) == (0, "1\n")
+    assert listed.returncode == 0
+    assert listed.stdout == "1\thttps://docs.python.org\tPython docs\t\n"
+
+
+# --------------------------------------------------------------------------- FR-006
+
+
+def test_fr006_identifiers_start_at_one_and_increase(run_cli, db):
+    """FR-006: the first identifier in a fresh store is 1, and they increase."""
+    first = run_cli("--db", db, "add", "https://a.example.com")
+    second = run_cli("--db", db, "add", "https://b.example.com")
+    third = run_cli("--db", db, "add", "https://c.example.com")
+    assert [first.stdout, second.stdout, third.stdout] == ["1\n", "2\n", "3\n"]
+
+
+def test_fr006_the_same_url_may_be_saved_twice_with_its_own_identifier(run_cli, db):
+    """Spec Edge Cases: duplicate URLs are allowed, each getting its own identifier."""
+    first = run_cli("--db", db, "add", "https://example.com")
+    second = run_cli("--db", db, "add", "https://example.com")
+    assert (first.stdout, second.stdout) == ("1\n", "2\n")
+    assert len(stored_rows(db)) == 2
+
+
+# --------------------------------------------------------------- FR-007 (and SC-004)
+
+
+@pytest.mark.parametrize(
+    "bad_url",
+    [
+        "ftp://example.com",
+        "example.com",
+        "",
+        "see https://x",
+        "HTTP://example.com",
+    ],
+)
+def test_fr007_sc004_malformed_url_is_refused_with_status_2_and_stores_nothing(
+    run_cli, db, bad_url
+):
+    """FR-007, SC-004: not beginning with the literal http:// or https:// exits 2, with a
+    diagnostic on stderr naming the rejected URL and the accepted schemes, nothing on
+    stdout, and nothing stored."""
+    result = run_cli("--db", db, "add", bad_url)
+    assert result.returncode == 2
+    assert result.stdout == ""
+    if bad_url:
+        assert bad_url in result.stderr
+    assert "http://" in result.stderr and "https://" in result.stderr
+    # Nothing was stored: the scheme check runs before any insert.
+    listed = run_cli("--db", db, "list")
+    assert listed.stdout == ""
+    assert listed.returncode == 0
+
+
+@pytest.mark.parametrize("good_url", ["http://example.com", "https://example.com"])
+def test_fr007_both_accepted_schemes_are_stored(run_cli, db, good_url):
+    """FR-007: http:// and https:// are the accepted prefixes."""
+    result = run_cli("--db", db, "add", good_url)
+    assert result.returncode == 0
+    assert stored_rows(db)[0][1] == good_url
+
+
+def test_fr007_url_is_stored_verbatim(run_cli, db):
+    """FR-007: the URL is stored exactly as supplied — no parsing, no normalisation."""
+    url = "https://Example.COM/Path?q=1&r=2#frag"
+    run_cli("--db", db, "add", url)
+    assert stored_rows(db)[0][1] == url
+
+
+# --------------------------------------------------------------------------- FR-008
+
+
+def test_fr008_title_option_sets_the_title(run_cli, db):
+    """FR-008: --title TITLE sets the bookmark's title."""
+    run_cli("--db", db, "add", "https://docs.python.org", "--title", "Python docs")
+    assert stored_rows(db)[0][2] == "Python docs"
+
+
+def test_fr008_omitted_title_is_the_empty_string_never_null_or_a_placeholder(run_cli, db):
+    """FR-008: an omitted title is the empty string — never NULL, never a placeholder."""
+    run_cli("--db", db, "add", "https://example.com")
+    connection = sqlite3.connect(str(db))
+    try:
+        title, is_null = connection.execute(
+            "SELECT title, title IS NULL FROM bookmarks WHERE id = 1"
+        ).fetchone()
+    finally:
+        connection.close()
+    assert title == ""
+    assert is_null == 0
+
+
+# --------------------------------------------------------------------------- FR-009
+
+
+def test_fr009_tags_option_is_comma_separated(run_cli, db):
+    """FR-009: --tags interprets its value as a comma-separated list."""
+    run_cli("--db", db, "add", "https://example.com", "--tags", "python,cli")
+    assert stored_tags(db, 1) == ["cli", "python"]
+
+
+def test_fr009_omitted_tags_means_no_tags(run_cli, db):
+    """FR-009: omitting --tags leaves the bookmark with no tags."""
+    run_cli("--db", db, "add", "https://example.com")
+    assert stored_tags(db, 1) == []
+    assert tags_field(run_cli, db) == ""
+
+
+# --------------------------------------------------------------------------- FR-010
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("python,cli", ["cli", "python"]),
+        ("python,,docs", ["docs", "python"]),
+        ("", []),
+        ("  python  ,  docs ", ["docs", "python"]),
+        ("Python,python,PYTHON", ["python"]),
+        ("Python,Docs", ["docs", "python"]),
+    ],
+)
+def test_fr010_tag_normalisation_table_from_the_data_model(run_cli, db, raw, expected):
+    """FR-010: trim, drop empties, lower-case, then store each distinct tag at most once."""
+    result = run_cli("--db", db, "add", "https://example.com", "--tags", raw)
+    assert result.returncode == 0
+    assert stored_tags(db, 1) == expected
+    assert tags_field(run_cli, db) == ",".join(expected)
+
+
+def test_fr010_each_distinct_tag_is_stored_at_most_once_per_bookmark(run_cli, db):
+    """FR-010: duplicates collapse, so the store holds one row per distinct tag."""
+    run_cli("--db", db, "add", "https://example.com", "--tags", "a, A ,a,,b")
+    assert stored_tags(db, 1) == ["a", "b"]
+
+
+def test_fr010_a_tag_text_may_be_shared_by_several_bookmarks(run_cli, db):
+    """FR-010/data-model: at-most-once is per bookmark, not global."""
+    run_cli("--db", db, "add", "https://a.example.com", "--tags", "shared")
+    run_cli("--db", db, "add", "https://b.example.com", "--tags", "shared")
+    assert stored_tags(db, 1) == ["shared"]
+    assert stored_tags(db, 2) == ["shared"]
