+"""`export`: FR-018, FR-019, FR-019a, FR-020, FR-020a, FR-021 and SC-006."""
+
+import csv
+import io
+import json
+
+import pytest
+
+# Values that stress quoting: a comma, a quotation mark, an embedded newline, non-ASCII
+# characters, multiple tags and an empty title (SC-006).
+AWKWARD = [
+    ("https://docs.python.org", "Python docs", "python,docs"),
+    ("https://example.com", 'He said "hi", then\nleft', ""),
+    ("https://café.example.com", "Café — ünïcode", "café,naïve"),
+]
+
+
+@pytest.fixture
+def awkward_store(run_cli, db):
+    for url, title, tags in AWKWARD:
+        args = ["--db", db, "add", url, "--title", title]
+        if tags:
+            args += ["--tags", tags]
+        assert run_cli(*args).returncode == 0
+    return db
+
+
+def csv_text(run_cli, db):
+    result = run_cli("--db", db, "export", "--format", "csv")
+    assert result.returncode == 0
+    assert result.stderr == ""
+    return result.stdout
+
+
+def json_text(run_cli, db):
+    result = run_cli("--db", db, "export", "--format", "json")
+    assert result.returncode == 0
+    assert result.stderr == ""
+    return result.stdout
+
+
+# --------------------------------------------------------------------------- FR-018
+
+
+def test_fr018_csv_starts_with_the_header_then_one_row_per_bookmark_by_id(run_cli, db):
+    """FR-018: the header line `id,url,title,tags`, then ascending identifier order."""
+    run_cli("--db", db, "add", "https://a.example.com", "--title", "A", "--tags", "x")
+    run_cli("--db", db, "add", "https://b.example.com", "--title", "B")
+
+    rows = list(csv.reader(io.StringIO(csv_text(run_cli, db))))
+    assert rows[0] == ["id", "url", "title", "tags"]
+    assert rows[1] == ["1", "https://a.example.com", "A", "x"]
+    assert rows[2] == ["2", "https://b.example.com", "B", ""]
+    assert len(rows) == 3
+
+
+def test_fr018_sc003_csv_tags_column_is_comma_joined_in_alphabetical_order(run_cli, db):
+    """FR-018, SC-003: the tags column holds the tags joined by `,`, alphabetically."""
+    run_cli("--db", db, "add", "https://a.example.com", "--tags", "zeta,Alpha,mid")
+    rows = list(csv.reader(io.StringIO(csv_text(run_cli, db))))
+    assert rows[1][3] == "alpha,mid,zeta"
+
+
+# --------------------------------------------------------------- FR-019 (and SC-006)
+
+
+def test_fr019_fields_with_commas_quotes_and_line_breaks_are_quoted(run_cli, awkward_store):
+    """FR-019: quoting with embedded quotes doubled, as a standard reader expects."""
+    text = csv_text(run_cli, awkward_store)
+    # The tags column of bookmark 1 contains a comma, so it is quoted.
+    assert '"docs,python"' in text
+    # The title of bookmark 2 contains a quote, a comma and a newline: quoted, quotes doubled.
+    assert '"He said ""hi"", then\nleft"' in text
+
+
+# -------------------------------------------------------------------------- FR-019a
+
+
+def test_fr019a_every_csv_line_ends_with_a_single_lf_and_never_crlf(run_cli, awkward_store):
+    """FR-019a: asserted on the raw bytes, header included."""
+    result = run_cli("--db", awkward_store, "export", "--format", "csv", text=False)
+    assert result.returncode == 0
+    raw = result.stdout
+    assert b"\r" not in raw
+    assert raw.startswith(b"id,url,title,tags\n")
+    assert raw.endswith(b"\n")
+
+
+def test_fr019a_line_break_inside_a_quoted_field_is_preserved_as_given(run_cli, awkward_store):
+    """FR-019a: the break inside the quoted title is part of the value, not a row end."""
+    rows = list(csv.reader(io.StringIO(csv_text(run_cli, awkward_store))))
+    assert rows[2][2] == 'He said "hi", then\nleft'
+    assert len(rows) == 1 + len(AWKWARD)
