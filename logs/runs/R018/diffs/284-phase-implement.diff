+
+def test_fr024_missing_format_exits_2(run_cli, db):
+    """FR-024: --format is required."""
+    result = run_cli("--db", db, "export")
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "--format" in result.stderr
+
+
+# --------------------------------------------------------------------------- SC-006
+
+
+def test_sc006_csv_round_trips_every_seeded_value_unchanged(run_cli, awkward_store):
+    """SC-006: csv.reader recovers every field exactly, including the embedded newline,
+    the embedded quote and the non-ASCII title."""
+    rows = list(csv.reader(io.StringIO(csv_text(run_cli, awkward_store))))
+    assert rows[1:] == [
+        ["1", "https://docs.python.org", "Python docs", "docs,python"],
+        ["2", "https://example.com", 'He said "hi", then\nleft', ""],
+        ["3", "https://café.example.com", "Café — ünïcode", "café,naïve"],
+    ]
+
+
+def test_sc006_json_round_trips_every_seeded_value_unchanged(run_cli, awkward_store):
+    """SC-006: json.load recovers every field exactly."""
+    payload = json.loads(json_text(run_cli, awkward_store))
+    assert payload == [
+        {
+            "id": 1,
+            "url": "https://docs.python.org",
+            "title": "Python docs",
+            "tags": ["docs", "python"],
+        },
+        {
+            "id": 2,
+            "url": "https://example.com",
+            "title": 'He said "hi", then\nleft',
+            "tags": [],
+        },
+        {
+            "id": 3,
+            "url": "https://café.example.com",
+            "title": "Café — ünïcode",
+            "tags": ["café", "naïve"],
+        },
+    ]
