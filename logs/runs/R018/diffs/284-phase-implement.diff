index 0000000..3419193
--- /dev/null
+++ b/tests/test_list_search.py
@@ -0,0 +1,241 @@
+"""`list` and `search`: FR-004, FR-011, FR-012, FR-013, FR-014, FR-015."""
+
+import sqlite3
+
+
+def lines(result):
+    assert result.returncode == 0
+    return result.stdout.split("\n")[:-1] if result.stdout else []
+
+
+def stored_title(db, bookmark_id):
+    connection = sqlite3.connect(str(db))
+    try:
+        return connection.execute(
+            "SELECT title FROM bookmarks WHERE id = ?", (bookmark_id,)
+        ).fetchone()[0]
+    finally:
+        connection.close()
+
+
+# --------------------------------------------------------------------------- FR-011
+
+
+def test_fr011_sc003_list_prints_every_bookmark_in_ascending_identifier_order(run_cli, db):
+    """FR-011, SC-003: every bookmark, ascending identifier order."""
+    for url in ("https://a.example.com", "https://b.example.com", "https://c.example.com"):
+        run_cli("--db", db, "add", url)
+    result = run_cli("--db", db, "list")
+    assert [line.split("\t")[0] for line in lines(result)] == ["1", "2", "3"]
+    assert [line.split("\t")[1] for line in lines(result)] == [
+        "https://a.example.com",
+        "https://b.example.com",
+        "https://c.example.com",
+    ]
+
+
+def test_fr011_order_is_by_identifier_not_insertion_of_titles(run_cli, db):
+    """FR-011: ordering is by identifier, regardless of title or URL ordering."""
+    run_cli("--db", db, "add", "https://z.example.com", "--title", "Zebra")
+    run_cli("--db", db, "add", "https://a.example.com", "--title", "Aardvark")
+    assert [line.split("\t")[0] for line in lines(run_cli("--db", db, "list"))] == ["1", "2"]
+
+
+# --------------------------------------------------------------------------- FR-014
+
+
+def test_fr014_each_line_is_exactly_four_tab_separated_fields(run_cli, db):
+    """FR-014: identifier, URL, title, comma-joined alphabetical tags."""
+    run_cli(
+        "--db", db, "add", "https://docs.python.org",
+        "--title", "Python docs", "--tags", "python,docs",
+    )
+    (line,) = lines(run_cli("--db", db, "list"))
+    assert line.count("\t") == 3
+    assert line.split("\t") == ["1", "https://docs.python.org", "Python docs", "docs,python"]
+
+
+def test_fr014_sc003_tags_are_comma_joined_in_alphabetical_order(run_cli, db):
+    """FR-014, SC-003: the fourth field joins the bookmark's tags alphabetically."""
+    run_cli("--db", db, "add", "https://example.com", "--tags", "zeta,alpha,Mid")
+    (line,) = lines(run_cli("--db", db, "list"))
+    assert line.split("\t")[3] == "alpha,mid,zeta"
+
+
+def test_fr014_empty_title_and_empty_tags_are_empty_fields(run_cli, db):
+    """FR-014: a bookmark with no title and no tags ends in two consecutive tabs and the
+    line still carries three tabs."""
+    run_cli("--db", db, "add", "https://example.com")
+    (line,) = lines(run_cli("--db", db, "list"))
+    assert line == "1\thttps://example.com\t\t"
+    assert line.endswith("\t\t")
+    assert line.count("\t") == 3
+
+
+def test_fr014_tab_in_a_title_is_stored_and_returned_unchanged(run_cli, db):
+    """FR-014/CLI contract: fields are emitted raw with no escaping, so a title holding a
+    tab is returned unchanged and the TSV view is deliberately ambiguous for it."""
+    title = "two\tparts"
+    run_cli("--db", db, "add", "https://example.com", "--title", title)
+    assert stored_title(db, 1) == title
+    result = run_cli("--db", db, "list")
+    assert result.returncode == 0
+    assert result.stdout == f"1\thttps://example.com\t{title}\t\n"
+
+
+def test_fr014_newline_in_a_title_is_stored_and_returned_unchanged(run_cli, db):
+    """FR-014/CLI contract: a title holding a newline is stored and returned unchanged;
+    the lossless views are the CSV and JSON exports."""
+    title = "first\nsecond"
+    run_cli("--db", db, "add", "https://example.com", "--title", title)
+    assert stored_title(db, 1) == title
+    result = run_cli("--db", db, "list")
+    assert result.returncode == 0
+    assert result.stdout == f"1\thttps://example.com\t{title}\t\n"
+
+
+# --------------------------------------------------------------------------- FR-015
+
+
+def test_fr015_list_on_an_empty_store_prints_nothing_and_exits_zero(run_cli, db):
+    """FR-015: no matches means empty stdout and status 0."""
+    result = run_cli("--db", db, "list")
+    assert result.returncode == 0
+    assert result.stdout == ""
+
+
+# --------------------------------------------------------------------------- FR-004
+
+
+def test_fr004_bookmarks_persist_across_separate_invocations(run_cli, db):
+    """FR-004: a later process returns what earlier, separate processes stored."""
+    run_cli("--db", db, "add", "https://docs.python.org", "--title", "Python docs",
+            "--tags", "python,docs")
+    run_cli("--db", db, "add", "https://example.com")
+    result = run_cli("--db", db, "list")
+    assert lines(result) == [
+        "1\thttps://docs.python.org\tPython docs\tdocs,python",
+        "2\thttps://example.com\t\t",
+    ]
+
+
+# --------------------------------------------------------------------------- FR-012
+
+
+def test_fr012_tag_filter_prints_only_bookmarks_carrying_that_tag(run_cli, db):
+    """FR-012: --tag keeps only bookmarks carrying that whole tag, ascending id order,
+    in the same four-field layout as an unfiltered listing."""
+    run_cli("--db", db, "add", "https://a.example.com", "--tags", "python,docs")
+    run_cli("--db", db, "add", "https://b.example.com", "--tags", "news")
+    run_cli("--db", db, "add", "https://c.example.com", "--tags", "python")
+    result = run_cli("--db", db, "list", "--tag", "python")
+    assert lines(result) == [
+        "1\thttps://a.example.com\t\tdocs,python",
+        "3\thttps://c.example.com\t\tpython",
+    ]
+    for line in lines(result):
+        assert line.count("\t") == 3
+
+
+def test_fr012_filter_is_trimmed_and_lower_cased_before_comparison(run_cli, db):
+    """FR-012: --tag Python, --tag python and --tag " PYTHON " select the same bookmarks."""
+    run_cli("--db", db, "add", "https://a.example.com", "--tags", "python")
+    run_cli("--db", db, "add", "https://b.example.com", "--tags", "news")
+    selected = [
+        lines(run_cli("--db", db, "list", "--tag", spelling))
+        for spelling in ("Python", "python", " PYTHON ", "PyThOn")
+    ]
+    assert selected[0] == ["1\thttps://a.example.com\t\tpython"]
+    assert all(result == selected[0] for result in selected)
+
+
+def test_fr012_comparison_is_against_whole_tags_never_a_substring(run_cli, db):
+    """FR-012, spec Edge Cases: --tag py returns nothing for a bookmark tagged python."""
+    run_cli("--db", db, "add", "https://a.example.com", "--tags", "python")
+    result = run_cli("--db", db, "list", "--tag", "py")
+    assert result.returncode == 0
+    assert result.stdout == ""
+
+
+def test_fr015_tag_filter_matching_nothing_prints_nothing_and_exits_zero(run_cli, db):
+    """FR-015: a filter naming a tag no bookmark carries prints nothing, status 0."""
+    run_cli("--db", db, "add", "https://a.example.com", "--tags", "python")
+    result = run_cli("--db", db, "list", "--tag", "absent")
+    assert result.returncode == 0
+    assert result.stdout == ""
+
+
+def test_fr012_us2_scenario6_mixed_case_tags_are_found_by_either_spelling(run_cli, db):
+    """US2 acceptance scenario 6: added with --tags "Python,Docs", found by --tag python
+    and --tag PYTHON, with its tags field reading docs,python."""
+    run_cli("--db", db, "add", "https://docs.python.org", "--title", "Python docs",
+            "--tags", "Python,Docs")
+    for spelling in ("python", "PYTHON"):
+        (line,) = lines(run_cli("--db", db, "list", "--tag", spelling))
+        assert line.split("\t")[3] == "docs,python"
+
+
+# --------------------------------------------------------------------------- FR-013
+
+
+def test_fr013_search_matches_the_title_disregarding_capitalisation(run_cli, db):
+    """FR-013: search matches the title, ignoring case, ascending identifier order."""
+    run_cli("--db", db, "add", "https://docs.python.org", "--title", "Python docs")
+    run_cli("--db", db, "add", "https://news.example.com", "--title", "News")
+    result = run_cli("--db", db, "search", "PYTHON")
+    assert lines(result) == ["1\thttps://docs.python.org\tPython docs\t"]
+
+
+def test_fr013_search_matches_the_url_even_when_the_title_does_not(run_cli, db):
+    """FR-013: the URL is searched too."""
+    run_cli("--db", db, "add", "https://news.example.com", "--title", "Headlines")
+    result = run_cli("--db", db, "search", "EXAMPLE")
+    assert lines(result) == ["1\thttps://news.example.com\tHeadlines\t"]
+
+
+def test_fr013_search_returns_matches_in_ascending_identifier_order(run_cli, db):
+    """FR-013: ascending identifier order."""
+    for index in range(3):
+        run_cli("--db", db, "add", f"https://example.com/{index}", "--title", "Thing")
+    result = run_cli("--db", db, "search", "thing")
+    assert [line.split("\t")[0] for line in lines(result)] == ["1", "2", "3"]
+
+
+def test_fr013_search_folds_case_for_non_ascii_titles(run_cli, db):
+    """FR-013: case folding is Unicode-aware, not ASCII-only (research R-005)."""
+    run_cli("--db", db, "add", "https://cafe.example.com", "--title", "CAFÉ ÜNÏCODE")
+    result = run_cli("--db", db, "search", "café")
+    assert [line.split("\t")[0] for line in lines(result)] == ["1"]
+
+
+def test_fr015_search_matching_nothing_prints_nothing_and_exits_zero(run_cli, db):
+    """FR-015: search text appearing nowhere prints nothing and exits 0."""
+    run_cli("--db", db, "add", "https://example.com", "--title", "Thing")
+    result = run_cli("--db", db, "search", "zzz")
+    assert result.returncode == 0
+    assert result.stdout == ""
+
+
+def test_fr013_empty_search_text_matches_every_bookmark(run_cli, db):
+    """Spec Edge Cases: every string contains the empty string."""
+    run_cli("--db", db, "add", "https://a.example.com")
+    run_cli("--db", db, "add", "https://b.example.com")
+    result = run_cli("--db", db, "search", "")
+    assert [line.split("\t")[0] for line in lines(result)] == ["1", "2"]
+
+
+def test_fr013_search_text_is_matched_literally_with_no_wildcards(run_cli, db):
+    """FR-013, CLI contract, research R-005: % and _ are not wildcards."""
+    run_cli("--db", db, "add", "https://example.com/a", "--title", "100% done")
+    run_cli("--db", db, "add", "https://example.com/b", "--title", "a_b")
+    run_cli("--db", db, "add", "https://example.com/c", "--title", "axb")
+
+    percent = run_cli("--db", db, "search", "100%")
+    assert [line.split("\t")[0] for line in lines(percent)] == ["1"]
+
+    underscore = run_cli("--db", db, "search", "a_b")
+    assert [line.split("\t")[0] for line in lines(underscore)] == ["2"]
+
+    # '%' alone would match everything if it were a wildcard.
+    wildcard = run_cli("--db", db, "search", "%")
+    assert [line.split("\t")[0] for line in lines(wildcard)] == ["1"]
