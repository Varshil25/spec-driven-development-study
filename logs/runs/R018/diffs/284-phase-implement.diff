+"""Shared fixtures: a scratch store path, a subprocess CLI runner, and a bulk seeder.
+
+The CLI is exercised as a real subprocess because an in-process call cannot observe a
+real process exit status, which FR-022 and FR-024 are stated in terms of (research
+R-009). The bulk seeder goes through ``store.py`` directly: 1,000 subprocess launches
+would cost minutes and the seeding route is not what is under test.
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from bookmarks import store
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC = REPO_ROOT / "src"
+
+
+@pytest.fixture
+def db(tmp_path):
+    """A fresh, not-yet-created store path for one test (used as ``--db``)."""
+    return tmp_path / "bookmarks.db"
+
+
+@pytest.fixture
+def run_cli():
+    """Invoke the real CLI as a subprocess; returns the CompletedProcess.
+
+    ``result.returncode`` is the real exit status, and stdout/stderr are captured
+    separately so the FR-023 stream split can be asserted.
+    """
+
+    def run(*args, cwd=None, env=None, text=True):
+        environment = {**os.environ, "PYTHONPATH": str(SRC)}
+        if env:
+            environment.update(env)
+        return subprocess.run(
+            [sys.executable, "-m", "bookmarks", *[str(a) for a in args]],
+            cwd=str(cwd) if cwd else None,
+            env=environment,
+            capture_output=True,
+            text=text,
+            encoding="utf-8" if text else None,
+        )
+
+    return run
+
+
+@pytest.fixture
+def seed():
+    """Insert bookmarks straight through ``store.py``, returning the identifiers."""
+
+    def _seed(path, bookmarks):
+        connection = store.open_store(path)
+        try:
+            return [
+                store.add_bookmark(connection, url, title, tags)
+                for url, title, tags in bookmarks
+            ]
+        finally:
+            connection.close()
+
+    return _seed
+
+
+@pytest.fixture
+def seed_many(seed):
+    """Seed ``count`` generated bookmarks for the performance budget (SC-002, SC-007)."""
+
+    def _seed_many(path, count):
+        return seed(
+            path,
+            [
+                (
+                    f"https://example.com/page/{index}",
+                    f"Page {index}",
+                    f"tag{index % 10},common",
+                )
+                for index in range(count)
+            ],
+        )
+
+    return _seed_many
