@@ -0,0 +1,296 @@
+"""Share splitting, balances, and the settlement plan."""
+
+import random
+from itertools import combinations
+
+import pytest
+
+from splitter.expenses import Expense
+from splitter.settle import (
+    EXACT_LIMIT,
+    Payment,
+    compute_balances,
+    equal_shares,
+    plan_settlement,
+    settle,
+)
+
+
+def expense(payer, cents):
+    return Expense(payer=payer, cents=cents, description="")
+
+
+# --- equal_shares -----------------------------------------------------------
+
+
+def test_shares_divide_evenly_when_possible():
+    assert equal_shares(3000, ["Alice", "Bob"]) == {"Alice": 1500, "Bob": 1500}
+
+
+def test_shares_distribute_indivisible_remainder_in_list_order():
+    """10.00 over three people is 3.34 / 3.33 / 3.33, summing to exactly 10.00."""
+    shares = equal_shares(1000, ["Alice", "Bob", "Carol"])
+    assert shares == {"Alice": 334, "Bob": 333, "Carol": 333}
+    assert sum(shares.values()) == 1000
+
+
+def test_shares_remainder_goes_to_the_first_names():
+    shares = equal_shares(1001, ["A", "B", "C", "D"])  # 1001 = 4*250 + 1
+    assert shares == {"A": 251, "B": 250, "C": 250, "D": 250}
+
+
+def test_shares_always_sum_to_the_total():
+    for total in range(0, 500):
+        for count in range(1, 12):
+            names = [f"P{i}" for i in range(count)]
+            assert sum(equal_shares(total, names).values()) == total
+
+
+def test_shares_of_zero():
+    assert equal_shares(0, ["Alice", "Bob"]) == {"Alice": 0, "Bob": 0}
+
+
+def test_shares_rejects_empty_participants():
+    with pytest.raises(ValueError):
+        equal_shares(100, [])
+
+
+# --- compute_balances -------------------------------------------------------
+
+
+def test_balances_for_the_spec_example():
+    balances = compute_balances([expense("Alice", 3000)], ["Alice", "Bob"])
+    assert balances == {"Alice": 1500, "Bob": -1500}
+
+
+def test_balances_include_participants_who_never_paid():
+    balances = compute_balances([expense("Alice", 3000)], ["Alice", "Bob", "Carol"])
+    assert balances["Bob"] == -1000
+    assert balances["Carol"] == -1000
+
+
+def test_balances_sum_to_zero_even_with_an_awkward_remainder():
+    balances = compute_balances([expense("Alice", 1000)], ["Alice", "Bob", "Carol"])
+    assert sum(balances.values()) == 0
+    assert balances == {"Alice": 666, "Bob": -333, "Carol": -333}
+
+
+def test_balances_accumulate_multiple_expenses_per_payer():
+    expenses = [expense("Alice", 1000), expense("Alice", 500), expense("Bob", 300)]
+    balances = compute_balances(expenses, ["Alice", "Bob"])
+    assert balances == {"Alice": 600, "Bob": -600}
+
+
+def test_everyone_square_yields_zero_balances():
+    expenses = [expense("Alice", 1000), expense("Bob", 1000)]
+    assert compute_balances(expenses, ["Alice", "Bob"]) == {"Alice": 0, "Bob": 0}
+
+
+def test_no_expenses_yields_zero_balances():
+    assert compute_balances([], ["Alice", "Bob"]) == {"Alice": 0, "Bob": 0}
+
+
+# --- settle -----------------------------------------------------------------
+
+
+def test_settle_simple_two_person_case():
+    payments = settle({"Alice": 1500, "Bob": -1500})
+    assert payments == [Payment(payer="Bob", payee="Alice", cents=1500)]
+
+
+def test_settle_returns_nothing_when_all_square():
+    assert settle({"Alice": 0, "Bob": 0}) == []
+    assert settle({}) == []
+
+
+def test_settle_never_emits_a_zero_or_negative_payment():
+    balances = {"A": 1000, "B": 0, "C": -400, "D": -600}
+    assert all(payment.cents > 0 for payment in settle(balances))
+
+
+def test_settle_matches_equal_and_opposite_pairs_first():
+    """Two independent debts should not be shuffled through a third party."""
+    balances = {"A": 500, "B": -500, "C": 300, "D": -300}
+    payments = settle(balances)
+    assert len(payments) == 2
+    assert {(p.payer, p.payee, p.cents) for p in payments} == {
+        ("B", "A", 500),
+        ("D", "C", 300),
+    }
+
+
+def test_settle_uses_at_most_n_minus_1_payments():
+    balances = {"A": -1000, "B": -600, "C": 700, "D": 900}
+    payments = settle(balances)
+    assert len(payments) <= len(balances) - 1
+
+
+def test_settle_splits_into_independent_zero_sum_subgroups():
+    """Two self-contained pairs need two payments, not three."""
+    balances = {"A": 500, "B": -500, "C": 300, "D": -300}
+    assert len(settle(balances)) == 2
+
+
+def test_settle_finds_a_subgroup_greedy_alone_would_miss():
+    """Greedy largest-first takes 4 payments here; the optimum is 3."""
+    balances = {"A": 5, "B": 4, "C": 6, "D": -6, "E": -9}
+    assert len(settle(balances)) == 3
+
+
+def test_settle_output_is_sorted_by_payer_then_payee():
+    balances = {"A": -300, "B": -200, "C": 500}
+    payments = settle(balances)
+    keys = [(p.payer, p.payee) for p in payments]
+    assert keys == sorted(keys)
+
+
+def test_settle_rejects_balances_that_do_not_sum_to_zero():
+    with pytest.raises(ValueError, match="sum to zero"):
+        settle({"Alice": 100, "Bob": -50})
+
+
+def test_settle_is_deterministic_under_dict_reordering():
+    """Tie-breaking by name means output does not depend on insertion order."""
+    balances = {"A": -500, "B": -500, "C": 500, "D": 500}
+    expected = settle(balances)
+    for _ in range(20):
+        items = list(balances.items())
+        random.shuffle(items)
+        assert settle(dict(items)) == expected
+
+
+# --- the core invariants ----------------------------------------------------
+
+
+def apply_payments(balances, payments):
+    """Replay the payments against the balances; everything should land on zero."""
+    final = dict(balances)
+    for payment in payments:
+        final[payment.payer] += payment.cents
+        final[payment.payee] -= payment.cents
+    return final
+
+
+def test_payments_zero_out_every_balance():
+    balances = {"A": -1000, "B": -600, "C": 700, "D": 900}
+    assert all(value == 0 for value in apply_payments(balances, settle(balances)).values())
+
+
+def test_payments_sum_exactly_to_the_total_imbalance():
+    balances = {"A": -1000, "B": -600, "C": 700, "D": 900}
+    payments = settle(balances)
+    imbalance = sum(value for value in balances.values() if value > 0)
+    assert sum(payment.cents for payment in payments) == imbalance
+
+
+@pytest.mark.parametrize("seed", range(300))
+def test_randomised_settlements_conserve_money_exactly(seed):
+    """No set of expenses may create, destroy, or misroute a single cent."""
+    rng = random.Random(seed)
+    count = rng.randint(1, 9)
+    participants = [f"P{i}" for i in range(count)]
+    expenses = [
+        expense(rng.choice(participants), rng.randint(0, 100_000))
+        for _ in range(rng.randint(0, 12))
+    ]
+
+    balances = compute_balances(expenses, participants)
+    payments = plan_settlement(expenses, participants)
+
+    # Shares exhaust the total: nothing unallocated.
+    assert sum(balances.values()) == 0
+    assert sum(e.cents for e in expenses) == sum(
+        equal_shares(sum(e.cents for e in expenses), participants).values()
+    )
+
+    # Payments are well formed.
+    assert all(p.cents > 0 for p in payments)
+    assert all(p.payer != p.payee for p in payments)
+    assert len(payments) <= max(len(participants) - 1, 0)
+
+    # Payments settle everyone to zero and move exactly the imbalance.
+    assert all(value == 0 for value in apply_payments(balances, payments).values())
+    assert sum(p.cents for p in payments) == sum(
+        value for value in balances.values() if value > 0
+    )
+
+
+def fewest_possible_payments(balances):
+    """Brute-force oracle for the minimum number of transfers.
+
+    The minimum equals (people with a non-zero balance) minus (the largest
+    number of disjoint zero-sum subgroups they can be split into). Computed here
+    by exhaustive search over set partitions, independently of the
+    implementation under test.
+    """
+    values = [value for value in balances.values() if value != 0]
+    count = len(values)
+    if count == 0:
+        return 0
+
+    def most_groups(remaining):
+        if not remaining:
+            return 0
+        best = None
+        first = remaining[0]
+        rest = remaining[1:]
+        for size in range(len(rest) + 1):
+            for companions in combinations(rest, size):
+                group = (first, *companions)
+                if sum(value for _, value in group) != 0:
+                    continue
+                leftover = [item for item in rest if item not in companions]
+                deeper = most_groups(leftover)
+                if deeper is not None:
+                    best = 1 + deeper if best is None else max(best, 1 + deeper)
+        return best
+
+    indexed = list(enumerate(values))
+    return count - most_groups(indexed)
+
+
+@pytest.mark.parametrize("seed", range(200))
+def test_settle_uses_the_fewest_possible_payments(seed):
+    """Checked against an independent brute-force oracle on small instances."""
+    rng = random.Random(seed)
+    count = rng.randint(2, 7)
+    # Small magnitudes so that zero-sum subgroups actually occur.
+    values = [rng.randint(-6, 6) for _ in range(count - 1)]
+    values.append(-sum(values))
+    balances = {f"P{i}": value for i, value in enumerate(values)}
+
+    assert len(settle(balances)) == fewest_possible_payments(balances)
+
+
+@pytest.mark.parametrize("count", [1, 2, 3, 7, 11, 13, 97])
+def test_indivisible_totals_across_group_sizes(count):
+    """A total of 1 cent split N ways still settles exactly."""
+    participants = [f"P{i}" for i in range(count)]
+    expenses = [expense("P0", 1)]
+    balances = compute_balances(expenses, participants)
+    payments = plan_settlement(expenses, participants)
+
+    assert sum(balances.values()) == 0
+    assert all(value == 0 for value in apply_payments(balances, payments).values())
+
+
+@pytest.mark.parametrize("seed", range(40))
+def test_large_groups_take_the_fallback_path_and_still_settle_exactly(seed):
+    """Above EXACT_LIMIT the exact search is skipped; correctness must not be."""
+    rng = random.Random(seed)
+    count = EXACT_LIMIT + rng.randint(1, 40)
+    values = [rng.randint(-100_000, 100_000) for _ in range(count - 1)]
+    values.append(-sum(values))
+    balances = {f"P{i:03d}": value for i, value in enumerate(values)}
+
+    payments = settle(balances)
+    assert all(value == 0 for value in apply_payments(balances, payments).values())
+    assert sum(p.cents for p in payments) == sum(
+        v for v in balances.values() if v > 0
+    )
+    assert len(payments) <= sum(1 for v in balances.values() if v != 0) - 1
+
+
+def test_single_participant_owes_nothing():
+    expenses = [expense("Alice", 5000)]
+    assert plan_settlement(expenses, ["Alice"]) == []
