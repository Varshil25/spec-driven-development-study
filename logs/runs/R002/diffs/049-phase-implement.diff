index 0000000..42ada43
--- /dev/null
+++ b/src/splitter/settle.py
@@ -0,0 +1,193 @@
+"""Turning expenses into a list of payments that settles everyone up.
+
+Three steps, all in integer cents:
+
+1. ``equal_shares``    -- split the group total evenly, distributing the
+   indivisible remainder cent by cent.
+2. ``compute_balances`` -- what each person paid, minus what they owe.
+3. ``settle``          -- the shortest list of payments that drives every
+   balance to zero.
+
+The invariant that matters for money: shares sum to the total, balances sum to
+zero, and payments sum to the total imbalance. Every step is integer-only, so
+there is nowhere for a rounding error to hide.
+"""
+
+from __future__ import annotations
+
+import heapq
+from dataclasses import dataclass
+
+from .expenses import Expense
+
+# Above this many people with a non-zero balance, fall back to the greedy
+# heuristic. The exact search is O(3^n); see _plan_groups for the reasoning.
+EXACT_LIMIT = 13
+
+
+@dataclass(frozen=True)
+class Payment:
+    """One transfer: ``payer`` hands ``cents`` to ``payee``. Always positive."""
+
+    payer: str
+    payee: str
+    cents: int
+
+
+def equal_shares(total_cents: int, participants: list[str]) -> dict[str, int]:
+    """Divide ``total_cents`` as evenly as possible among ``participants``.
+
+    A total of 10.00 across 3 people is 3.34 / 3.33 / 3.33, not three times
+    3.3333: the remainder is handed out one cent at a time, in participant
+    order, so the shares add up to exactly the total. Someone has to get the
+    odd cent; doing it by list order makes it predictable rather than arbitrary.
+    """
+    count = len(participants)
+    if count == 0:
+        raise ValueError("participants must not be empty")
+
+    base, remainder = divmod(total_cents, count)
+    return {
+        name: base + (1 if position < remainder else 0)
+        for position, name in enumerate(participants)
+    }
+
+
+def compute_balances(
+    expenses: list[Expense], participants: list[str]
+) -> dict[str, int]:
+    """Net position of each participant, in cents.
+
+    Positive means the group owes them; negative means they owe the group.
+    The values sum to exactly zero.
+    """
+    paid = dict.fromkeys(participants, 0)
+    for expense in expenses:
+        paid[expense.payer] += expense.cents
+
+    owed = equal_shares(sum(paid.values()), participants)
+    return {name: paid[name] - owed[name] for name in participants}
+
+
+def settle(balances: dict[str, int]) -> list[Payment]:
+    """Produce the shortest list of payments that brings every balance to zero.
+
+    Anyone already square is left out of it. The rest are split into the largest
+    possible number of subgroups that each sum to zero, and each subgroup is
+    settled on its own. A subgroup of ``k`` people that contains no smaller
+    zero-sum subgroup cannot be settled in fewer than ``k - 1`` payments, and
+    the greedy pass inside it achieves exactly that -- so maximising the number
+    of subgroups minimises the total number of payments.
+
+    Finding that decomposition is NP-hard in general (it contains the partition
+    problem), so for a large number of non-zero balances this falls back to the
+    greedy heuristic alone, which still settles everyone correctly in at most
+    ``n - 1`` payments. See ``EXACT_LIMIT``.
+
+    Output is sorted by payer then payee, so it does not depend on the order the
+    balances happened to be built in.
+    """
+    total = sum(balances.values())
+    if total != 0:
+        raise ValueError(f"balances must sum to zero, got {total}")
+
+    # Sorted so that ties anywhere downstream resolve by name, not dict order.
+    active = sorted((name, value) for name, value in balances.items() if value)
+    if not active:
+        return []
+
+    payments: list[Payment] = []
+    for group in _plan_groups(active):
+        payments.extend(_settle_greedily(group))
+
+    payments.sort(key=lambda payment: (payment.payer, payment.payee))
+    return payments
+
+
+def _plan_groups(active: list[tuple[str, int]]) -> list[list[tuple[str, int]]]:
+    """Split the non-zero balances into as many zero-sum subgroups as possible.
+
+    Exact subset dynamic programming: ``best[mask]`` is the largest number of
+    disjoint zero-sum subgroups that the people in ``mask`` can be carved into.
+    Iterating the sub-masks of every mask costs O(3^n), which is instant for the
+    group sizes a shared-expenses tool actually sees (a house share, a trip) and
+    hopeless beyond that -- hence the fallback.
+    """
+    count = len(active)
+    if count > EXACT_LIMIT:
+        return [active]
+
+    values = [value for _, value in active]
+    full = (1 << count) - 1
+
+    # Sum of each subset, built up by peeling off the lowest set bit.
+    subset_sum = [0] * (1 << count)
+    for mask in range(1, 1 << count):
+        lowest = mask & -mask
+        subset_sum[mask] = subset_sum[mask ^ lowest] + values[lowest.bit_length() - 1]
+
+    best = [-1] * (1 << count)  # -1 == this mask cannot be partitioned
+    best[0] = 0
+    chosen = [0] * (1 << count)  # the zero-sum subgroup to peel off at each step
+
+    for mask in range(1, 1 << count):
+        # Anchor on the lowest set bit so each partition is counted once.
+        lowest = mask & -mask
+        subset = mask
+        while subset:
+            if (
+                subset & lowest
+                and subset_sum[subset] == 0
+                and best[mask ^ subset] >= 0
+                and best[mask ^ subset] + 1 > best[mask]
+            ):
+                best[mask] = best[mask ^ subset] + 1
+                chosen[mask] = subset
+            subset = (subset - 1) & mask
+
+    # The full set sums to zero, so it is always partitionable (worst case: into
+    # itself), and walking the recorded choices always terminates.
+    groups = []
+    remaining = full
+    while remaining:
+        subset = chosen[remaining]
+        groups.append([active[i] for i in range(count) if subset >> i & 1])
+        remaining ^= subset
+
+    return groups
+
+
+def _settle_greedily(group: list[tuple[str, int]]) -> list[Payment]:
+    """Settle one zero-sum group: largest debtor pays largest creditor, repeat.
+
+    Each payment zeroes out at least one person, so a group of ``k`` needs at
+    most ``k - 1`` payments.
+    """
+    # Max-heaps keyed on amount owed/due, then on name for deterministic ties.
+    debtors = [(value, name) for name, value in group if value < 0]
+    creditors = [(-value, name) for name, value in group if value > 0]
+    heapq.heapify(debtors)
+    heapq.heapify(creditors)
+
+    payments = []
+    while debtors and creditors:
+        negated_debt, debtor = heapq.heappop(debtors)
+        negated_credit, creditor = heapq.heappop(creditors)
+        debt, credit = -negated_debt, -negated_credit
+
+        amount = min(debt, credit)
+        payments.append(Payment(payer=debtor, payee=creditor, cents=amount))
+
+        if debt > amount:
+            heapq.heappush(debtors, (amount - debt, debtor))
+        if credit > amount:
+            heapq.heappush(creditors, (amount - credit, creditor))
+
+    return payments
+
+
+def plan_settlement(
+    expenses: list[Expense], participants: list[str]
+) -> list[Payment]:
+    """Convenience wrapper: expenses and participants straight to payments."""
+    return settle(compute_balances(expenses, participants))
