index 0000000..3d415b8
--- /dev/null
+++ b/src/splitter/expenses.py
@@ -0,0 +1,160 @@
+"""Reading the inputs: the participant list and the expenses CSV."""
+
+from __future__ import annotations
+
+import csv
+from dataclasses import dataclass
+from pathlib import Path
+
+from .errors import SplitterError
+from .money import parse_cents
+
+REQUIRED_COLUMNS = ("payer", "amount", "description")
+
+
+@dataclass(frozen=True)
+class Expense:
+    """One row of the CSV: who paid, how much (in cents), and what for."""
+
+    payer: str
+    cents: int
+    description: str
+
+
+def parse_participants(text: str) -> list[str]:
+    """Split the ``--participants`` argument into an ordered list of names.
+
+    Surrounding whitespace on each name is ignored, so ``"Alice, Bob"`` works.
+    Order is preserved because it decides who absorbs the leftover cents when
+    the total does not divide evenly.
+
+    Raises:
+        SplitterError: if the list is empty, has an empty name, or repeats a name.
+    """
+    names = [part.strip() for part in text.split(",")]
+
+    if all(not name for name in names):
+        raise SplitterError("participant list is empty")
+    if any(not name for name in names):
+        raise SplitterError(
+            f"participant list {text!r} has an empty name; "
+            f"check for a stray or doubled comma"
+        )
+
+    seen: set[str] = set()
+    for name in names:
+        if name in seen:
+            # Silently accepting this would charge the person two shares.
+            raise SplitterError(f"participant {name!r} is listed more than once")
+        seen.add(name)
+
+    return names
+
+
+def load_expenses(path: str | Path, participants: list[str]) -> list[Expense]:
+    """Read and validate the expenses CSV.
+
+    Every payer must be one of ``participants``; every amount must be a
+    non-negative whole number of cents. A header-only file is valid and yields
+    no expenses.
+
+    Raises:
+        SplitterError: if the file cannot be read or any row is malformed.
+    """
+    known = set(participants)
+
+    try:
+        with open(path, newline="", encoding="utf-8-sig") as handle:
+            rows = list(csv.reader(handle))
+    except FileNotFoundError:
+        raise SplitterError(f"no such file: {path}") from None
+    except IsADirectoryError:
+        raise SplitterError(f"{path} is a directory, not a CSV file") from None
+    except PermissionError:
+        raise SplitterError(f"cannot read {path}: permission denied") from None
+    except UnicodeDecodeError:
+        raise SplitterError(
+            f"cannot read {path}: not valid UTF-8 text (is it really a CSV?)"
+        ) from None
+    except OSError as exc:
+        raise SplitterError(f"cannot read {path}: {exc.strerror or exc}") from None
+
+    if not rows:
+        raise SplitterError(f"{path} is empty; expected a header row")
+
+    index = _column_index(rows[0], path)
+    expenses = []
+
+    for line_number, row in enumerate(rows[1:], start=2):
+        if not any(field.strip() for field in row):
+            continue  # tolerate blank separator lines
+
+        try:
+            expense = _parse_row(row, index, known, width=len(rows[0]))
+        except SplitterError as exc:
+            raise SplitterError(f"{path}, line {line_number}: {exc}") from None
+        expenses.append(expense)
+
+    return expenses
+
+
+def _column_index(header: list[str], path: str | Path) -> dict[str, int]:
+    """Locate the required columns in the header row.
+
+    Matched case-insensitively and whitespace-trimmed, by name rather than by
+    position, so column order in the file does not matter.
+    """
+    positions: dict[str, int] = {}
+    for position, name in enumerate(header):
+        key = name.strip().lower()
+        if key in REQUIRED_COLUMNS and key not in positions:
+            positions[key] = position
+
+    missing = [name for name in REQUIRED_COLUMNS if name not in positions]
+    if missing:
+        found = ", ".join(name.strip() for name in header) or "(nothing)"
+        raise SplitterError(
+            f"{path}: header row is missing column(s) {', '.join(missing)}; "
+            f"found: {found}"
+        )
+
+    return positions
+
+
+def _parse_row(
+    row: list[str], index: dict[str, int], known: set[str], width: int
+) -> Expense:
+    """Turn one CSV row into an Expense, or raise SplitterError explaining why not."""
+    needed = max(index.values()) + 1
+    if len(row) < needed:
+        raise SplitterError(
+            f"expected at least {needed} fields, found {len(row)}: {row!r}"
+        )
+
+    # More populated fields than the header declares means the row does not line
+    # up with its columns, and the values have shifted into the wrong slots. The
+    # usual cause is an unquoted comma -- "Alice,1,000,Hotel" reads as an amount
+    # of 1 and a description of "000", quietly turning $1000 into $1. Trailing
+    # empty fields are just a stray comma and carry no data, so they are allowed.
+    if len(row) > width and any(field.strip() for field in row[width:]):
+        raise SplitterError(
+            f"found {len(row)} fields but the header declares {width}: {row!r}; "
+            f"a value containing a comma must be quoted"
+        )
+
+    payer = row[index["payer"]].strip()
+    if not payer:
+        raise SplitterError("payer is empty")
+    if payer not in known:
+        roster = ", ".join(sorted(known))
+        raise SplitterError(
+            f"payer {payer!r} is not in the participant list ({roster})"
+        )
+
+    cents = parse_cents(row[index["amount"]], what="amount")
+
+    return Expense(
+        payer=payer,
+        cents=cents,
+        description=row[index["description"]].strip(),
+    )
