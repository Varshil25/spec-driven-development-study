@@ -0,0 +1,85 @@
+"""Money handling.
+
+Every amount in this program is an ``int`` number of cents. Floats never touch
+money: ``0.1 + 0.2 != 0.3`` is not a property you want in a ledger. Parsing goes
+through ``decimal.Decimal`` and then to an exact integer, and formatting goes
+back out by integer division, so no value is ever rounded on the way in or out.
+"""
+
+from decimal import Decimal, InvalidOperation
+
+from .errors import SplitterError
+
+CENTS_PER_UNIT = 100
+
+
+def parse_cents(text: str, *, what: str = "amount") -> int:
+    """Parse a decimal money string into a whole number of cents.
+
+    Accepts the forms a person actually types: ``30``, ``30.00``, ``.5``,
+    ``+1.25``, ``1e3``. Rejects anything that is not a finite non-negative
+    number, and rejects amounts finer than a cent (``0.005``) rather than
+    silently rounding them -- rounding here would mean the printed payments no
+    longer sum to the real total.
+
+    Raises:
+        SplitterError: if ``text`` is not a usable amount.
+    """
+    stripped = text.strip()
+    if not stripped:
+        raise SplitterError(f"{what} is empty")
+
+    try:
+        value = Decimal(stripped)
+    except InvalidOperation:
+        raise SplitterError(f"{what} {stripped!r} is not a number") from None
+
+    if not value.is_finite():
+        # Decimal happily parses "nan" and "Infinity".
+        raise SplitterError(f"{what} {stripped!r} is not a finite number")
+    if value < 0:
+        raise SplitterError(f"{what} {stripped!r} is negative")
+
+    cents = _to_cents_exact(value)
+    if cents is None:
+        raise SplitterError(
+            f"{what} {stripped!r} is finer than one cent; "
+            f"use at most two decimal places"
+        )
+    return cents
+
+
+def _to_cents_exact(value: Decimal) -> int | None:
+    """Multiply a finite Decimal by 100, exactly, or return None if it cannot be.
+
+    Done on the digit tuple rather than as ``value * 100`` so that the active
+    decimal context's precision cannot quietly round a large amount.
+    """
+    sign, digits, exponent = value.as_tuple()
+    assert isinstance(exponent, int)  # guaranteed: caller checked is_finite()
+
+    magnitude = int("".join(map(str, digits)) or "0")
+    shift = exponent + 2  # multiply by 10**2 == 100
+
+    if shift >= 0:
+        cents = magnitude * 10**shift
+    else:
+        divisor = 10 ** -shift
+        if magnitude % divisor:
+            return None  # would need a fraction of a cent
+        cents = magnitude // divisor
+
+    return -cents if sign else cents
+
+
+def format_cents(cents: int) -> str:
+    """Render cents as a decimal string with exactly two places.
+
+    Integer-only, so the output is an exact transcription of the stored value.
+
+        >>> format_cents(1500), format_cents(5), format_cents(-1234)
+        ('15.00', '0.05', '-12.34')
+    """
+    sign = "-" if cents < 0 else ""
+    whole, fraction = divmod(abs(cents), CENTS_PER_UNIT)
+    return f"{sign}{whole}.{fraction:02d}"
