@@ -0,0 +1,113 @@
+"""Money parsing and formatting: the layer that must never lose a cent."""
+
+import pytest
+
+from splitter.errors import SplitterError
+from splitter.money import format_cents, parse_cents
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("30.00", 3000),
+        ("30", 3000),
+        ("0", 0),
+        ("0.00", 0),
+        ("0.01", 1),
+        (".5", 50),
+        ("+1.25", 125),
+        ("  7.77  ", 777),  # surrounding whitespace is fine
+        ("1e3", 100_000),  # exponent notation
+        ("1E2", 10_000),
+        ("0.10", 10),
+        ("12345678901234567890.99", 1234567890123456789099),  # beyond float precision
+    ],
+)
+def test_parse_cents_accepts_valid_amounts(text, expected):
+    assert parse_cents(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "abc",
+        "",
+        "   ",
+        "1.2.3",
+        "$5.00",
+        "5 dollars",
+        "1,000.00",  # thousands separators are not money syntax here
+        "nan",
+        "NaN",
+        "Infinity",
+        "-Infinity",
+        "inf",
+    ],
+)
+def test_parse_cents_rejects_non_numbers(text):
+    with pytest.raises(SplitterError):
+        parse_cents(text)
+
+
+@pytest.mark.parametrize("text", ["-1", "-0.01", "-30.00", " -5 "])
+def test_parse_cents_rejects_negative(text):
+    with pytest.raises(SplitterError, match="negative"):
+        parse_cents(text)
+
+
+@pytest.mark.parametrize("text", ["0.005", "1.234", "0.001", "1e-3"])
+def test_parse_cents_rejects_sub_cent_precision(text):
+    """Rounding these would silently change the group total."""
+    with pytest.raises(SplitterError, match="finer than one cent"):
+        parse_cents(text)
+
+
+def test_parse_cents_allows_trailing_zeros_beyond_two_places():
+    """0.5000 is exactly 50 cents, so it is representable and accepted."""
+    assert parse_cents("0.5000") == 50
+    assert parse_cents("30.000000") == 3000
+
+
+def test_negative_zero_is_zero():
+    assert parse_cents("-0.00") == 0
+
+
+def test_parse_cents_error_mentions_the_field_name():
+    with pytest.raises(SplitterError, match="amount"):
+        parse_cents("abc", what="amount")
+
+
+@pytest.mark.parametrize(
+    ("cents", "expected"),
+    [
+        (0, "0.00"),
+        (1, "0.01"),
+        (5, "0.05"),
+        (10, "0.10"),
+        (100, "1.00"),
+        (1500, "15.00"),
+        (333, "3.33"),
+        (-1234, "-12.34"),
+        (-1, "-0.01"),
+        (123456789, "1234567.89"),
+    ],
+)
+def test_format_cents(cents, expected):
+    assert format_cents(cents) == expected
+
+
+def test_format_cents_always_has_two_decimal_places():
+    for cents in range(0, 1000):
+        assert format_cents(cents).split(".")[1] == f"{cents % 100:02d}"
+
+
+def test_parse_and_format_round_trip():
+    for cents in range(0, 2000):
+        assert parse_cents(format_cents(cents)) == cents
+
+
+def test_no_float_rounding_on_classic_trap_values():
+    """0.1 + 0.2 == 0.30000000000000004 as floats; not here."""
+    assert parse_cents("0.1") + parse_cents("0.2") == parse_cents("0.3")
+    total = sum(parse_cents("0.01") for _ in range(100))
+    assert total == parse_cents("1.00")
