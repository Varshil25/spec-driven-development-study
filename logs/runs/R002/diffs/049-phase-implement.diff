+"""Error type for all user-facing failures."""
+
+
+class SplitterError(Exception):
+    """A problem with the user's input.
+
+    Raised for anything the user can fix: a missing file, a malformed row, an
+    empty participant list. The CLI turns these into a message on stderr and a
+    non-zero exit status. Anything *not* a SplitterError is a bug in this tool
+    and is allowed to propagate as a traceback.
+    """
