+"""Parsing the participant list and loading the expenses CSV."""
+
+import pytest
+
+from splitter.errors import SplitterError
+from splitter.expenses import Expense, load_expenses, parse_participants
+
+
+def write_csv(tmp_path, text, name="expenses.csv"):
+    path = tmp_path / name
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+# --- participants -----------------------------------------------------------
+
+
+def test_parses_a_simple_list():
+    assert parse_participants("Alice,Bob") == ["Alice", "Bob"]
+
+
+def test_strips_whitespace_around_names():
+    assert parse_participants(" Alice , Bob ,Carol") == ["Alice", "Bob", "Carol"]
+
+
+def test_single_participant_is_allowed():
+    assert parse_participants("Alice") == ["Alice"]
+
+
+def test_preserves_the_given_order():
+    assert parse_participants("Carol,Alice,Bob") == ["Carol", "Alice", "Bob"]
+
+
+def test_names_with_internal_spaces_are_kept():
+    assert parse_participants("Alice Smith,Bob Jones") == ["Alice Smith", "Bob Jones"]
+
+
+@pytest.mark.parametrize("text", ["", "   ", ",", ",,", " , "])
+def test_rejects_an_empty_participant_list(text):
+    with pytest.raises(SplitterError, match="empty"):
+        parse_participants(text)
+
+
+@pytest.mark.parametrize("text", ["Alice,", ",Bob", "Alice,,Bob", "Alice, ,Bob"])
+def test_rejects_an_empty_name_among_real_ones(text):
+    with pytest.raises(SplitterError, match="empty name"):
+        parse_participants(text)
+
+
+def test_rejects_a_duplicated_name():
+    """Counting someone twice would charge them two shares."""
+    with pytest.raises(SplitterError, match="more than once"):
+        parse_participants("Alice,Bob,Alice")
+
+
+# --- loading the CSV --------------------------------------------------------
+
+
+def test_loads_the_spec_example(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\nAlice,30.00,Hotel\n")
+    assert load_expenses(path, ["Alice", "Bob"]) == [
+        Expense(payer="Alice", cents=3000, description="Hotel")
+    ]
+
+
+def test_loads_multiple_rows(tmp_path):
+    path = write_csv(
+        tmp_path,
+        "payer,amount,description\nAlice,30.00,Hotel\nBob,10.50,Taxi\n",
+    )
+    expenses = load_expenses(path, ["Alice", "Bob"])
+    assert [(e.payer, e.cents) for e in expenses] == [("Alice", 3000), ("Bob", 1050)]
+
+
+def test_header_only_file_is_valid_and_yields_nothing(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\n")
+    assert load_expenses(path, ["Alice"]) == []
+
+
+def test_column_order_does_not_matter(tmp_path):
+    path = write_csv(tmp_path, "description,payer,amount\nHotel,Alice,30.00\n")
+    assert load_expenses(path, ["Alice"]) == [
+        Expense(payer="Alice", cents=3000, description="Hotel")
+    ]
+
+
+def test_header_matching_ignores_case_and_whitespace(tmp_path):
+    path = write_csv(tmp_path, " Payer , AMOUNT , Description \nAlice,30.00,Hotel\n")
+    assert load_expenses(path, ["Alice"])[0].cents == 3000
+
+
+def test_extra_columns_are_ignored(tmp_path):
+    path = write_csv(
+        tmp_path, "payer,amount,description,notes\nAlice,30.00,Hotel,paid cash\n"
+    )
+    assert load_expenses(path, ["Alice"])[0].description == "Hotel"
+
+
+def test_blank_lines_are_skipped(tmp_path):
+    path = write_csv(
+        tmp_path, "payer,amount,description\nAlice,30.00,Hotel\n\nBob,5.00,Snacks\n"
+    )
+    assert len(load_expenses(path, ["Alice", "Bob"])) == 2
+
+
+def test_quoted_commas_in_description(tmp_path):
+    path = write_csv(
+        tmp_path, 'payer,amount,description\nAlice,30.00,"Hotel, two nights"\n'
+    )
+    assert load_expenses(path, ["Alice"])[0].description == "Hotel, two nights"
+
+
+def test_a_utf8_bom_does_not_break_the_header(tmp_path):
+    path = tmp_path / "bom.csv"
+    path.write_text("payer,amount,description\nAlice,30.00,Hotel\n", encoding="utf-8-sig")
+    assert load_expenses(path, ["Alice"])[0].cents == 3000
+
+
+def test_non_ascii_names_work(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\nZoë,30.00,Café\n")
+    assert load_expenses(path, ["Zoë"])[0].description == "Café"
+
+
+def test_zero_amount_is_allowed(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\nAlice,0.00,Free sample\n")
+    assert load_expenses(path, ["Alice"])[0].cents == 0
+
+
+def test_empty_description_is_allowed(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\nAlice,30.00,\n")
+    assert load_expenses(path, ["Alice"])[0].description == ""
+
+
+# --- malformed input --------------------------------------------------------
+
+
+def test_missing_file(tmp_path):
+    with pytest.raises(SplitterError, match="no such file"):
+        load_expenses(tmp_path / "nope.csv", ["Alice"])
+
+
+def test_directory_instead_of_file(tmp_path):
+    with pytest.raises(SplitterError, match="directory"):
+        load_expenses(tmp_path, ["Alice"])
+
+
+def test_completely_empty_file(tmp_path):
+    path = write_csv(tmp_path, "")
+    with pytest.raises(SplitterError, match="empty"):
+        load_expenses(path, ["Alice"])
+
+
+def test_missing_required_column(tmp_path):
+    path = write_csv(tmp_path, "payer,amount\nAlice,30.00\n")
+    with pytest.raises(SplitterError, match="description"):
+        load_expenses(path, ["Alice"])
+
+
+def test_header_that_looks_like_data(tmp_path):
+    """A file without a header row should complain, not silently drop a row."""
+    path = write_csv(tmp_path, "Alice,30.00,Hotel\nBob,5.00,Snacks\n")
+    with pytest.raises(SplitterError, match="header row is missing"):
+        load_expenses(path, ["Alice", "Bob"])
+
+
+def test_unknown_payer(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\nZara,30.00,Hotel\n")
+    with pytest.raises(SplitterError, match="not in the participant list"):
+        load_expenses(path, ["Alice", "Bob"])
+
+
+def test_unknown_payer_error_names_the_row_and_the_roster(tmp_path):
+    path = write_csv(
+        tmp_path, "payer,amount,description\nAlice,30.00,Hotel\nZara,5.00,Taxi\n"
+    )
+    with pytest.raises(SplitterError) as info:
+        load_expenses(path, ["Alice", "Bob"])
+    message = str(info.value)
+    assert "line 3" in message
+    assert "Zara" in message
+    assert "Alice, Bob" in message
+
+
+def test_payer_matching_is_case_sensitive(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\nalice,30.00,Hotel\n")
+    with pytest.raises(SplitterError, match="not in the participant list"):
+        load_expenses(path, ["Alice"])
+
+
+def test_empty_payer(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\n,30.00,Hotel\n")
+    with pytest.raises(SplitterError, match="payer is empty"):
+        load_expenses(path, ["Alice"])
+
+
+@pytest.mark.parametrize("amount", ["abc", "", "   ", "$30", "nan", "12 34"])
+def test_non_numeric_amount(tmp_path, amount):
+    path = write_csv(tmp_path, f"payer,amount,description\nAlice,{amount},Hotel\n")
+    with pytest.raises(SplitterError, match="amount"):
+        load_expenses(path, ["Alice"])
+
+
+def test_quoted_thousands_separator_is_rejected(tmp_path):
+    path = write_csv(tmp_path, 'payer,amount,description\nAlice,"1,000",Hotel\n')
+    with pytest.raises(SplitterError, match="not a number"):
+        load_expenses(path, ["Alice"])
+
+
+def test_unquoted_comma_in_amount_is_rejected(tmp_path):
+    """Alice,1,000,Hotel would otherwise read as $1.00 with description '000'."""
+    path = write_csv(tmp_path, "payer,amount,description\nAlice,1,000,Hotel\n")
+    with pytest.raises(SplitterError, match="must be quoted"):
+        load_expenses(path, ["Alice"])
+
+
+def test_unquoted_comma_in_description_is_rejected(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\nAlice,30.00,Hotel, 2 nights\n")
+    with pytest.raises(SplitterError, match="must be quoted"):
+        load_expenses(path, ["Alice"])
+
+
+def test_a_trailing_comma_is_tolerated(tmp_path):
+    """An empty extra field carries no data, so it is not a column mismatch."""
+    path = write_csv(tmp_path, "payer,amount,description\nAlice,30.00,Hotel,\n")
+    assert load_expenses(path, ["Alice"])[0].cents == 3000
+
+
+@pytest.mark.parametrize("amount", ["-30.00", "-0.01"])
+def test_negative_amount(tmp_path, amount):
+    path = write_csv(tmp_path, f"payer,amount,description\nAlice,{amount},Hotel\n")
+    with pytest.raises(SplitterError, match="negative"):
+        load_expenses(path, ["Alice"])
+
+
+def test_sub_cent_amount(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\nAlice,0.005,Hotel\n")
+    with pytest.raises(SplitterError, match="finer than one cent"):
+        load_expenses(path, ["Alice"])
+
+
+def test_row_with_too_few_fields(tmp_path):
+    path = write_csv(tmp_path, "payer,amount,description\nAlice,30.00\n")
+    with pytest.raises(SplitterError, match="expected at least 3 fields"):
+        load_expenses(path, ["Alice"])
+
+
+def test_row_errors_report_the_line_number(tmp_path):
+    path = write_csv(
+        tmp_path,
+        "payer,amount,description\n"
+        "Alice,30.00,Hotel\n"
+        "Bob,10.00,Taxi\n"
+        "Alice,oops,Dinner\n",
+    )
+    with pytest.raises(SplitterError, match="line 4"):
+        load_expenses(path, ["Alice", "Bob"])
+
+
+def test_invalid_utf8_file(tmp_path):
+    path = tmp_path / "binary.csv"
+    path.write_bytes(b"payer,amount,description\n\xff\xfe\x00bad,30.00,x\n")
+    with pytest.raises(SplitterError, match="UTF-8"):
+        load_expenses(path, ["Alice"])
