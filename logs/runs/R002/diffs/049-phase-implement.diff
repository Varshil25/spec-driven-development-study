@@ -0,0 +1,64 @@
+"""Command-line entry point."""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from collections.abc import Sequence
+
+from .errors import SplitterError
+from .expenses import load_expenses, parse_participants
+from .money import format_cents
+from .settle import Payment, plan_settlement
+
+PROGRAM = "splitter"
+
+EXIT_OK = 0
+EXIT_ERROR = 2  # matches argparse's own exit status for bad usage
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog=f"python -m {PROGRAM}",
+        description=(
+            "Split shared group expenses and print who owes whom. "
+            "Every participant owes an equal share of the group total."
+        ),
+        epilog="example: python -m splitter trip.csv --participants Alice,Bob",
+    )
+    parser.add_argument(
+        "csv_file",
+        metavar="EXPENSES.csv",
+        help="CSV file with a header row and columns payer, amount, description",
+    )
+    parser.add_argument(
+        "--participants",
+        metavar="NAMES",
+        required=True,
+        help="comma-separated list of everyone sharing the costs, e.g. Alice,Bob",
+    )
+    return parser
+
+
+def format_payment(payment: Payment) -> str:
+    """Render one payment as ``PAYER pays PAYEE AMOUNT``."""
+    return f"{payment.payer} pays {payment.payee} {format_cents(payment.cents)}"
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    """Run the tool. Returns the process exit status."""
+    args = build_parser().parse_args(argv)
+
+    try:
+        participants = parse_participants(args.participants)
+        expenses = load_expenses(args.csv_file, participants)
+        payments = plan_settlement(expenses, participants)
+    except SplitterError as exc:
+        print(f"{PROGRAM}: error: {exc}", file=sys.stderr)
+        return EXIT_ERROR
+
+    # Nothing to print when everyone already paid their share; that is success.
+    for payment in payments:
+        print(format_payment(payment))
+
+    return EXIT_OK
