@@ -0,0 +1,210 @@
+"""End-to-end behaviour: output format, exit codes, stderr."""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from splitter.cli import EXIT_ERROR, EXIT_OK, main
+
+SRC = str(Path(__file__).resolve().parents[1] / "src")
+
+
+def write_csv(tmp_path, text, name="expenses.csv"):
+    path = tmp_path / name
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+def run(tmp_path, capsys, csv_text, participants, name="expenses.csv"):
+    """Invoke main() in-process and return (exit code, stdout lines, stderr)."""
+    path = write_csv(tmp_path, csv_text, name)
+    code = main([str(path), "--participants", participants])
+    captured = capsys.readouterr()
+    lines = captured.out.splitlines()
+    return code, lines, captured.err
+
+
+# --- the documented examples ------------------------------------------------
+
+
+def test_spec_example_output(tmp_path, capsys):
+    code, lines, err = run(
+        tmp_path, capsys, "payer,amount,description\nAlice,30.00,Hotel\n", "Alice,Bob"
+    )
+    assert code == EXIT_OK
+    assert lines == ["Bob pays Alice 15.00"]
+    assert err == ""
+
+
+def test_spec_example_missing_file(capsys):
+    code = main(["missing.csv", "--participants", "Alice,Bob"])
+    captured = capsys.readouterr()
+    assert code == EXIT_ERROR
+    assert captured.out == ""
+    assert "missing.csv" in captured.err
+
+
+# --- output format ----------------------------------------------------------
+
+
+def test_each_payment_on_its_own_line_with_two_decimals(tmp_path, capsys):
+    code, lines, _ = run(
+        tmp_path,
+        capsys,
+        "payer,amount,description\nAlice,30.00,Hotel\nBob,15.00,Taxi\n",
+        "Alice,Bob,Carol",
+    )
+    assert code == EXIT_OK
+    for line in lines:
+        payer, pays, payee, amount = line.split()
+        assert pays == "pays"
+        assert payer != payee
+        assert len(amount.split(".")[1]) == 2
+
+
+def test_amount_keeps_two_decimals_for_whole_and_sub_unit_values(tmp_path, capsys):
+    _, lines, _ = run(
+        tmp_path, capsys, "payer,amount,description\nAlice,0.02,Gum\n", "Alice,Bob"
+    )
+    assert lines == ["Bob pays Alice 0.01"]
+
+
+def test_nothing_printed_when_everyone_is_square(tmp_path, capsys):
+    code, lines, err = run(
+        tmp_path,
+        capsys,
+        "payer,amount,description\nAlice,10.00,A\nBob,10.00,B\n",
+        "Alice,Bob",
+    )
+    assert code == EXIT_OK
+    assert lines == []
+    assert err == ""
+
+
+def test_nothing_printed_for_a_header_only_file(tmp_path, capsys):
+    code, lines, _ = run(tmp_path, capsys, "payer,amount,description\n", "Alice,Bob")
+    assert code == EXIT_OK
+    assert lines == []
+
+
+def test_printed_amounts_sum_to_the_total_imbalance(tmp_path, capsys):
+    """The headline guarantee, checked on the printed text rather than internals."""
+    csv_text = (
+        "payer,amount,description\n"
+        "Alice,100.00,Hotel\n"
+        "Bob,33.33,Taxi\n"
+        "Carol,0.01,Gum\n"
+    )
+    _, lines, _ = run(tmp_path, capsys, csv_text, "Alice,Bob,Carol")
+
+    printed = sum(round(float(line.split()[-1]) * 100) for line in lines)
+    total = 10000 + 3333 + 1
+    share = total // 3
+    # Alice is the only creditor here; the imbalance is what she overpaid.
+    imbalance = (10000 - (share + (1 if total % 3 > 0 else 0)))
+    assert printed == imbalance
+
+
+def test_three_way_split_with_an_awkward_remainder(tmp_path, capsys):
+    """10.00 over three is 3.34/3.33/3.33 -- the cent must not vanish."""
+    code, lines, _ = run(
+        tmp_path, capsys, "payer,amount,description\nAlice,10.00,Lunch\n", "Alice,Bob,Carol"
+    )
+    assert code == EXIT_OK
+    amounts = sorted(line.split()[-1] for line in lines)
+    assert amounts == ["3.33", "3.33"]
+    assert sum(round(float(a) * 100) for a in amounts) == 666
+
+
+def test_participant_who_paid_nothing_appears_as_a_payer(tmp_path, capsys):
+    _, lines, _ = run(
+        tmp_path, capsys, "payer,amount,description\nAlice,9.00,Pizza\n", "Alice,Bob,Carol"
+    )
+    payers = {line.split()[0] for line in lines}
+    assert payers == {"Bob", "Carol"}
+
+
+# --- error handling ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("csv_text", "participants", "fragment"),
+    [
+        ("payer,amount,description\nZara,30.00,Hotel\n", "Alice,Bob", "Zara"),
+        ("payer,amount,description\nAlice,abc,Hotel\n", "Alice", "not a number"),
+        ("payer,amount,description\nAlice,-5.00,Hotel\n", "Alice", "negative"),
+        ("payer,amount,description\nAlice,30.00,Hotel\n", "", "empty"),
+        ("payer,amount\nAlice,30.00\n", "Alice", "description"),
+        ("", "Alice", "empty"),
+    ],
+)
+def test_malformed_input_errors_on_stderr_with_nonzero_exit(
+    tmp_path, capsys, csv_text, participants, fragment
+):
+    code, lines, err = run(tmp_path, capsys, csv_text, participants)
+    assert code != EXIT_OK
+    assert lines == [], "no partial results should be printed on error"
+    assert fragment in err
+
+
+def test_errors_are_prefixed_and_single_line(tmp_path, capsys):
+    _, _, err = run(
+        tmp_path, capsys, "payer,amount,description\nAlice,abc,Hotel\n", "Alice"
+    )
+    assert err.startswith("splitter: error: ")
+    assert err.count("\n") == 1
+
+
+def test_error_has_no_traceback(tmp_path, capsys):
+    _, _, err = run(tmp_path, capsys, "payer,amount,description\nAlice,abc,X\n", "Alice")
+    assert "Traceback" not in err
+
+
+# --- the real command line --------------------------------------------------
+
+
+def module_run(args, cwd):
+    env = {**os.environ, "PYTHONPATH": SRC}
+    return subprocess.run(
+        [sys.executable, "-m", "splitter", *args],
+        capture_output=True,
+        text=True,
+        cwd=cwd,
+        env=env,
+    )
+
+
+def test_python_dash_m_invocation(tmp_path):
+    write_csv(tmp_path, "payer,amount,description\nAlice,30.00,Hotel\n", "trip.csv")
+    result = module_run(["trip.csv", "--participants", "Alice,Bob"], tmp_path)
+    assert result.returncode == 0
+    assert result.stdout == "Bob pays Alice 15.00\n"
+    assert result.stderr == ""
+
+
+def test_python_dash_m_missing_file_exit_status(tmp_path):
+    result = module_run(["missing.csv", "--participants", "Alice,Bob"], tmp_path)
+    assert result.returncode != 0
+    assert result.stdout == ""
+    assert result.stderr.strip() != ""
+
+
+def test_missing_participants_argument_is_a_usage_error(tmp_path):
+    write_csv(tmp_path, "payer,amount,description\n", "trip.csv")
+    result = module_run(["trip.csv"], tmp_path)
+    assert result.returncode != 0
+    assert "participants" in result.stderr
+
+
+def test_no_arguments_is_a_usage_error(tmp_path):
+    result = module_run([], tmp_path)
+    assert result.returncode != 0
+
+
+def test_help_works(tmp_path):
+    result = module_run(["--help"], tmp_path)
+    assert result.returncode == 0
+    assert "participants" in result.stdout
