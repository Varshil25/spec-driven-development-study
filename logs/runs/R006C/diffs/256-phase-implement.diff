+    keep = write(tmp_path / "clean" / "unrelated.txt", b"keep me\n")
+    before = keep.stat()
+
+    status, stdout, _ = run_cli("--out-dir", "clean", "app.log", cwd=tmp_path)
+    assert (status, stdout) == (0, b"wrote 1 files\n")
+    assert keep.read_bytes() == b"keep me\n"
+    assert keep.stat().st_mtime_ns == before.st_mtime_ns
+    assert sorted(p.name for p in (tmp_path / "clean").iterdir()) == [
+        "app.log",
+        "unrelated.txt",
+    ]
+
+
+def test_empty_input_file_is_written_and_counted(run_cli, tmp_path):
+    """Spec Edge Cases, C-57: an empty input gives an empty output, and it counts."""
