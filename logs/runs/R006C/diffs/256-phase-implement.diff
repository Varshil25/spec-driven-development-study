+    time.sleep(0.01)
+
+    status, stdout, _ = run_cli(
+        "--out-dir", "clean", *sorted(str(p.name) for p in sources), cwd=tmp_path
+    )
+    assert (status, stdout) == (0, b"wrote 3 files\n")
+    for path, expected in before.items():
+        assert (path.read_bytes(), path.stat().st_size, path.stat().st_mtime_ns) == expected
+
+
+# ===============================================================================================
+# T025 — without the option, nothing changes (C-55, FR-035)
+# ===============================================================================================
+
+
+def test_without_out_dir_unchanged(run_cli, tmp_path):
