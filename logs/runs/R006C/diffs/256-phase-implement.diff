+
+def test_count_and_out_dir(run_cli, tmp_path):
+    """C-46, FR-032, SC-022: the two summary lines together, each on its own stream.
+
+    These two formats are the whole of SC-022's "what was removed, how many files" contract:
+    the tally on stderr, the file count on stdout, and neither in any output file.
+    """
+    write(tmp_path / "app.log", b"user jane@example.com called +14155552671\n")
+    write(tmp_path / "web.log", b"GET / from 10.0.0.7\n")
+
+    status, stdout, stderr = run_cli(
+        "--count", "--out-dir", "clean", "app.log", "web.log", cwd=tmp_path
+    )
+    assert status == 0
+    assert stdout == b"wrote 2 files\n"
+    assert stderr == b"emails=1 ips=1 cards=0 phones=1\n"
+
+    assert (tmp_path / "clean" / "app.log").read_bytes() == (
+        b"user [EMAIL] called [PHONE]\n"
+    )
+    assert (tmp_path / "clean" / "web.log").read_bytes() == b"GET / from [IP]\n"
