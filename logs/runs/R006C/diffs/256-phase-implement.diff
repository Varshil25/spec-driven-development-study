+        "--out-dir", "clean", "a/app.log", "b/app.log", cwd=tmp_path
+    )
+    assert (status, stdout) == (0, b"wrote 2 files\n")
+    assert [p.name for p in (tmp_path / "clean").iterdir()] == ["app.log"]
+    assert (tmp_path / "clean" / "app.log").read_bytes() == b"second [IP]\n"
+
+
+def test_same_operand_twice(run_cli, tmp_path):
+    """C-59, A-18: the same operand named twice reports 2 and leaves one redaction."""
+    write(tmp_path / "app.log", APP_IN)
+    status, stdout, _ = run_cli(
+        "--out-dir", "clean", "app.log", "app.log", cwd=tmp_path
+    )
+    assert (status, stdout) == (0, b"wrote 2 files\n")
+    assert (tmp_path / "clean" / "app.log").read_bytes() == APP_OUT
+
+
+# ===============================================================================================
+# T027 — no leakage: no staging path, no temp machinery, no data in the count line
+#        (SR-013, SR-014, SC-021)
+# ===============================================================================================
+
+
+def test_no_staging_path_appears_during_the_run(run_cli, tmp_path):
+    """SR-013, A-25: output is written in place — no temporary or staging path ever exists.
+
+    The tree under `tmp_path` is sampled continuously while the run is in flight, so a file
+    that is created and renamed away would still be caught.
+    """
+    names = ["src%02d.log" % index for index in range(12)]
+    for name in names:
+        write(tmp_path / name, (b"jane@example.com +14155552671\n" * 2000))
+    expected = set(names) | {"clean"}
+
+    seen = set()
+    stop = threading.Event()
+
+    def sample():
+        while not stop.is_set():
+            for path in tmp_path.rglob("*"):
+                seen.add(path.relative_to(tmp_path).as_posix())
+
+    sampler = threading.Thread(target=sample, daemon=True)
+    sampler.start()
+    try:
+        status, stdout, _ = run_cli("--out-dir", "clean", *names, cwd=tmp_path)
+    finally:
+        stop.set()
+        sampler.join(timeout=30)
+
+    assert (status, stdout) == (0, b"wrote 12 files\n")
+    allowed = expected | {"clean/" + name for name in names}
+    assert seen <= allowed, sorted(seen - allowed)
+
+
+def test_no_tempfile_import():
+    """SR-013: the sources import no temporary-file or logging machinery at all."""
