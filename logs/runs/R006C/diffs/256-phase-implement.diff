+#: SC-018's scale: at least 50 operands whose total size is at least 100x the 1 MiB line cap.
+MANY_OPERANDS = 50
+PER_OPERAND_BYTES = 2 * 1024 * 1024  # 50 x 2 MiB = 100 MiB = 100x the cap
+
+
+def _run_with_peak_rss(argv, cwd, cap=ADDRESS_SPACE_CAP):
+    """Run `argv` with its address space capped, sampling peak RSS from `/proc`.
+
+    Two instruments, because each covers the other's blind spot: the `RLIMIT_AS` cap is a hard
+    ceiling the run simply cannot exceed (and is immune to the `ru_maxrss` fork artefact
+    described in `_run_capped`), while the sampled high-water mark shows whether the peak
+    *grew* between a one-operand run and a fifty-operand one.
+    """
+
+    def cap_address_space():
+        import resource
+
+        resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
+
+    process = subprocess.Popen(
+        argv,
+        cwd=str(cwd),
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        env=cli_env(),
+        preexec_fn=cap_address_space,
+    )
+    peak = 0
+    status_path = "/proc/%d/status" % process.pid
+    while process.poll() is None:
+        try:
+            with open(status_path) as handle:
+                for line in handle:
+                    if line.startswith("VmRSS:"):
+                        peak = max(peak, int(line.split()[1]) * 1024)
+                        break
+        except OSError:
+            break
+        time.sleep(0.002)
+    stdout, stderr = process.communicate(timeout=900)
+    return process.returncode, stdout, stderr, peak
+
