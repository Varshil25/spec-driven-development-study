+    for module in ("cli.py", "redact.py"):
+        text = (source_dir / module).read_text(encoding="utf-8")
+        assert "tempfile" not in text, module
+        assert "import logging" not in text, module
+        assert "mkstemp" not in text, module
+
+
+def test_count_line_is_only_literals_and_an_integer(run_cli, tmp_path):
