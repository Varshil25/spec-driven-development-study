index 0000000..503509f
--- /dev/null
+++ b/tests/test_cli_outdir.py
@@ -0,0 +1,486 @@
+"""Contract tests for User Story 2 — `--out-dir DIR`, the success paths.
+
+Covers FR-023…FR-027, FR-032, FR-034 and FR-035, and the security requirements the output
+folder engages: SR-010 (the output path is DIR plus one component and nothing else), SR-011
+(owner-only permissions set at creation), SR-013 (no temporary file, no staging path) and
+SR-014 (the `wrote N files` line is literals and an integer only).
+
+Everything here runs the real `python -m logredact` in a subprocess through the `run_cli`
+fixture from `tests/conftest.py` and compares raw bytes, file contents and permission bits —
+the guarantees are about what the delivered interface does to the filesystem, so they are
+asserted from outside the process (research.md R25).
+"""
+
+import os
+import re
+import stat
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+APP_IN = b"user jane@example.com\n"
+APP_OUT = b"user [EMAIL]\n"
+WEB_IN = b"GET / from 10.0.0.7\n"
+WEB_OUT = b"GET / from [IP]\n"
+
+
+def write(path, content):
+    """Create `path` with `content`, making its parents as needed."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(content)
+    return path
+
+
+def owner_only(path):
+    """SR-011 as a umask-independent assertion: nothing for group, nothing for other."""
+    return stat.S_IMODE(os.stat(path).st_mode) & 0o077 == 0
+
+
+# ===============================================================================================
+# T020 — acceptance, the count line, and the third worked example
+#        (C-48, C-49, C-53, FR-023, FR-024, FR-027, SC-011)
+# ===============================================================================================
+
+
+def test_out_dir_accepted(run_cli, tmp_path):
+    """FR-023: the option is accepted and the run succeeds."""
+    write(tmp_path / "app.log", APP_IN)
+    status, stdout, stderr = run_cli("--out-dir", "clean", "app.log", cwd=tmp_path)
+    assert (status, stdout, stderr) == (0, b"wrote 1 files\n", b"")
+    assert (tmp_path / "clean" / "app.log").read_bytes() == APP_OUT
+
+
+def test_equals_form(run_cli, tmp_path):
+    """A-21: `--out-dir=DIR` is the same option, spelled the other way."""
+    write(tmp_path / "app.log", APP_IN)
+    status, stdout, stderr = run_cli("--out-dir=clean", "app.log", cwd=tmp_path)
+    assert (status, stdout, stderr) == (0, b"wrote 1 files\n", b"")
+    assert (tmp_path / "clean" / "app.log").read_bytes() == APP_OUT
+
+
+def test_writes_one_file_per_operand(run_cli, tmp_path):
+    """C-48, FR-024: one output file per operand, named by the operand."""
+    write(tmp_path / "app.log", APP_IN)
+    write(tmp_path / "web.log", WEB_IN)
+    status, stdout, _ = run_cli(
+        "--out-dir", "clean", "app.log", "web.log", cwd=tmp_path
+    )
+    assert status == 0
+    assert stdout == b"wrote 2 files\n"
+    assert sorted(p.name for p in (tmp_path / "clean").iterdir()) == [
+        "app.log",
+        "web.log",
+    ]
+    assert (tmp_path / "clean" / "app.log").read_bytes() == APP_OUT
+    assert (tmp_path / "clean" / "web.log").read_bytes() == WEB_OUT
+
+
+def test_count_line(run_cli, tmp_path):
+    """C-48, FR-027: `wrote N files` on stdout, once, with N the number written."""
+    write(tmp_path / "app.log", APP_IN)
+    write(tmp_path / "web.log", WEB_IN)
+    _, stdout, _ = run_cli("--out-dir", "clean", "app.log", "web.log", cwd=tmp_path)
+    assert stdout == b"wrote 2 files\n"
+
+
+def test_no_redacted_line_on_stdout(run_cli, tmp_path):
+    """C-49, FR-024: stdout is *exactly* the count line — never a redacted line."""
+    write(tmp_path / "app.log", APP_IN + WEB_IN)
+    status, stdout, stderr = run_cli("--out-dir", "clean", "app.log", cwd=tmp_path)
+    assert (status, stdout, stderr) == (0, b"wrote 1 files\n", b"")
+    for leak in (b"[EMAIL]", b"[IP]", b"user", b"GET", b"jane"):
+        assert leak not in stdout
+
+
+def test_count_line_not_pluralised(run_cli, tmp_path):
+    """C-53, FR-027: the format is fixed — one file still reports `wrote 1 files`."""
+    write(tmp_path / "app.log", APP_IN)
+    _, stdout, _ = run_cli("--out-dir", "clean", "app.log", cwd=tmp_path)
+    assert stdout == b"wrote 1 files\n"
+
+
+def test_worked_example_out_dir(run_cli, tmp_path):
+    """C-48, SC-011: the third worked example, byte-for-byte on every observable."""
+    write(tmp_path / "app.log", b"user jane@example.com\n")
+    write(tmp_path / "web.log", b"GET / from 10.0.0.7\n")
+    assert not (tmp_path / "clean").exists()
+
+    status, stdout, stderr = run_cli(
+        "--out-dir", "clean", "app.log", "web.log", cwd=tmp_path
+    )
+
+    assert (tmp_path / "clean").is_dir()
+    assert (tmp_path / "clean" / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert (tmp_path / "clean" / "web.log").read_bytes() == b"GET / from [IP]\n"
+    assert stdout == b"wrote 2 files\n"
+    assert stderr == b""
+    assert status == 0
+
+
+# ===============================================================================================
+# T021 — naming and confinement (C-50, C-51, FR-024, FR-025, SR-010)
+# ===============================================================================================
+
+
+def test_only_final_path_component(run_cli, tmp_path):
+    """C-50, FR-024, SR-010: directory parts of the operand are discarded, never recreated."""
+    write(tmp_path / "logs" / "2026" / "app.log", APP_IN)
+    status, stdout, _ = run_cli(
+        "--out-dir", "clean", "logs/2026/app.log", cwd=tmp_path
+    )
+    assert (status, stdout) == (0, b"wrote 1 files\n")
+    assert (tmp_path / "clean" / "app.log").read_bytes() == APP_OUT
+    assert not (tmp_path / "clean" / "logs").exists()
+    assert not (tmp_path / "clean" / "2026").exists()
+    assert [p.name for p in (tmp_path / "clean").iterdir()] == ["app.log"]
+
+
+def test_creates_missing_parents(run_cli, tmp_path):
+    """C-51, FR-025: every missing component of DIR is created."""
+    write(tmp_path / "app.log", APP_IN)
+    assert not (tmp_path / "a").exists()
+
+    status, stdout, _ = run_cli("--out-dir", "a/b/c", "app.log", cwd=tmp_path)
+    assert (status, stdout) == (0, b"wrote 1 files\n")
+    for part in ("a", "a/b", "a/b/c"):
+        assert (tmp_path / part).is_dir(), part
+    assert (tmp_path / "a" / "b" / "c" / "app.log").read_bytes() == APP_OUT
+
+
+def test_absolute_operand_contributes_no_path(run_cli, tmp_path):
+    """SR-010: an absolute operand contributes only its final component."""
+    source = write(tmp_path / "sources" / "app.log", APP_IN)
+    target = tmp_path / "clean"
+    status, stdout, _ = run_cli(
+        "--out-dir", str(target), str(source), cwd=tmp_path
+    )
+    assert (status, stdout) == (0, b"wrote 1 files\n")
+    assert [p.name for p in target.iterdir()] == ["app.log"]
+    assert (target / "app.log").read_bytes() == APP_OUT
+
+
+def _snapshot(root, exclude):
+    """Files outside `exclude`: path → (size, mtime_ns); plus the set of directories.
+
+    Directory mtimes are deliberately not compared: creating DIR legitimately changes the
+    mtime of DIR's parent, which is not a write outside DIR.
+    """
+    files = {}
+    directories = set()
+    for path in sorted(root.rglob("*")):
+        if path == exclude or exclude in path.parents:
+            continue
+        if path.is_dir() and not path.is_symlink():
+            directories.add(path)
+        else:
+            info = path.lstat()
+            files[path] = (info.st_size, info.st_mtime_ns)
+    return files, directories
+
+
+def test_no_file_written_outside_dir(run_cli, tmp_path):
+    """SR-010, SR-013: nothing outside DIR changes in existence, size or mtime."""
+    write(tmp_path / "app.log", APP_IN)
+    write(tmp_path / "web.log", WEB_IN)
+    write(tmp_path / "logs" / "2026" / "deep.log", APP_IN + WEB_IN)
+    write(tmp_path / "unrelated" / "keep.txt", b"keep me\n")
+
+    before = _snapshot(tmp_path, tmp_path / "clean")
+    time.sleep(0.01)  # so any rewrite would show a different mtime
+    status, stdout, _ = run_cli(
+        "--out-dir",
+        "clean",
+        "app.log",
+        "web.log",
+        "logs/2026/deep.log",
+        cwd=tmp_path,
+    )
+    after = _snapshot(tmp_path, tmp_path / "clean")
+
+    assert (status, stdout) == (0, b"wrote 3 files\n")
+    assert after == before
+
+
+# ===============================================================================================
+# T022 — replacement and reuse (C-52, C-56, C-57, FR-025, FR-026)
+# ===============================================================================================
+
+
+def test_existing_output_replaced_in_full(run_cli, tmp_path):
+    """C-52, FR-026: longer previous content leaves no remnant."""
+    write(tmp_path / "app.log", APP_IN)
+    stale = write(tmp_path / "clean" / "app.log", b"X" * 4096 + b"\nstale tail\n")
+    assert stale.stat().st_size > len(APP_OUT)
+
+    status, stdout, _ = run_cli("--out-dir", "clean", "app.log", cwd=tmp_path)
+    assert (status, stdout) == (0, b"wrote 1 files\n")
+    assert stale.read_bytes() == APP_OUT
+    assert b"X" not in stale.read_bytes()
+    assert b"stale" not in stale.read_bytes()
+
+
+def test_existing_dir_reused_and_untouched(run_cli, tmp_path):
+    """C-56, FR-025: an existing DIR is used as it is and is never emptied."""
