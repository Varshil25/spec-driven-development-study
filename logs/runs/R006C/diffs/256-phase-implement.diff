+# ===============================================================================================
+# 002 — the phone rule (SR-015) and the many-operand output folder (SC-018, FR-034)
+# ===============================================================================================
+
+#: The five adversarial shapes research.md R15 measured. Each one targets a different part of
+#: `\+[0-9]{8,15}(?![0-9])`: one long digit run, lone `+` characters, the 16-digit run that makes
+#: the lookahead fail at every one of the eight attempt lengths, alternating `+9`, and a dense run
+#: of exactly-15-digit matches.
+PHONE_SHAPES = {
+    "plus-then-long-run": lambda n: "+" + "9" * (n - 1),
+    "plus-repeated": lambda n: "+" * n,
+    "plus-sixteen-digits": lambda n: "+9999999999999999" * (n // 17),
+    "plus-nine-alternating": lambda n: "+9" * (n // 2),
+    "plus-fifteen-digits": lambda n: "+999999999999999 " * (n // 17),
+}
+
+
+@pytest.mark.slow
+@pytest.mark.parametrize("shape", sorted(PHONE_SHAPES))
+def test_phone_adversarial_lines_are_linear(shape):
+    """SR-015: the phone rule is linear in line length, with no backtracking blow-up.
+
+    Same instrument and the same 10 s tripwire as `test_adversarial_lines_are_linear`: the
+    bounded `{8,15}` over one character class caps the work at any start position at eight
+    attempts, so doubling the line must roughly double the time rather than explode
+    (research.md R15, worst case measured 425 ms for 1 MiB).
+    """
+    build = PHONE_SHAPES[shape]
+    elapsed = [_time_redaction(build(size)) for size in SIZES]
+
+    assert elapsed[-1] < CEILING_SECONDS, (shape, dict(zip(SIZES, elapsed)))
+
+    floor = 0.002  # below this the measurement is timer noise, not work
+    for previous, current in zip(elapsed, elapsed[1:]):
+        if previous < floor:
+            continue
+        assert current / previous < 3.0, (shape, dict(zip(SIZES, elapsed)))
+
