+"""Contract tests for User Story 4 — every `--out-dir` failure path.
+
+Covers FR-028…FR-031, FR-033 and FR-036, and SR-010 (a symbolic link at the output path is
+refused, dangling ones included), SR-012 (no operand is ever opened for writing, creation or
+truncation), SR-016 (the argument allowlist) and SR-017 (no diagnostic discloses input data and
+none carries a traceback).
+
+Every case asserts the diagnostic, the exit status and what did *not* happen — no output file,
+no directory created, no operand truncated — because a silently short or missing output file
+mistaken for a complete redaction is the defect these paths exist to prevent.
+
+Tests depending on permission bits carry `skipif(os.geteuid() == 0)` exactly as
+`tests/test_cli_errors.py:176` does: root bypasses them (research.md R19, R25).
+"""
+
+import hashlib
+import os
+
+import pytest
+
+from conftest import ERROR_PREFIX
+
+APP_IN = b"user jane@example.com\n"
+APP_OUT = b"user [EMAIL]\n"
+WEB_IN = b"GET / from 10.0.0.7\n"
+WEB_OUT = b"GET / from [IP]\n"
+
+AS_ROOT = pytest.mark.skipif(
+    os.geteuid() == 0, reason="root bypasses file permissions"
+)
+
+
+def write(path, content):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(content)
+    return path
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+# ===============================================================================================
+# T036 — an unreadable operand (C-62, FR-028, SC-019)
+# ===============================================================================================
+
+
+def test_unreadable_operand_skipped(run_cli, tmp_path):
+    """C-62: the others are complete, the missing one is named, N excludes it, status 2."""
+    write(tmp_path / "app.log", APP_IN)
+    write(tmp_path / "web.log", WEB_IN)
+    assert not (tmp_path / "missing.log").exists()
+
+    status, stdout, stderr = run_cli(
+        "--out-dir", "clean", "app.log", "missing.log", "web.log", cwd=tmp_path
+    )
+
+    assert status == 2
+    assert stdout == b"wrote 2 files\n"
+    assert ERROR_PREFIX in stderr
+    assert b"missing.log" in stderr
+    assert b"Traceback" not in stderr
+    assert (tmp_path / "clean" / "app.log").read_bytes() == APP_OUT
+    assert (tmp_path / "clean" / "web.log").read_bytes() == WEB_OUT
+    assert not (tmp_path / "clean" / "missing.log").exists()
+
+
+# ===============================================================================================
+# T037 — DIR cannot be created (C-63, C-64, C-72, FR-029)
+# ===============================================================================================
+
+
+def test_dir_is_a_regular_file(run_cli, tmp_path):
+    """C-63: DIR names an existing regular file — nothing is read, nothing is written."""
+    write(tmp_path / "app.log", APP_IN)
+    blocker = write(tmp_path / "clean", b"not a directory\n")
+
+    status, stdout, stderr = run_cli("--out-dir", "clean", "app.log", cwd=tmp_path)
+
+    assert status == 2
+    assert stdout == b""
+    assert ERROR_PREFIX in stderr
+    assert b"cannot create output directory 'clean'" in stderr
+    assert b"File exists" in stderr
+    assert b"Traceback" not in stderr
+    # no operand was read and nothing was written: the blocker is untouched
+    assert blocker.read_bytes() == b"not a directory\n"
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["app.log", "clean"]
+
+
+def test_empty_dir_value(run_cli, tmp_path):
+    """C-72, spec Edge Cases: `--out-dir ""` cannot be created, so the run fails."""
+    write(tmp_path / "app.log", APP_IN)
+
+    status, stdout, stderr = run_cli("--out-dir", "", "app.log", cwd=tmp_path)
+
+    assert status == 2
+    assert stdout == b""
+    assert b"cannot create output directory ''" in stderr
+    assert b"No such file or directory" in stderr
+    assert b"Traceback" not in stderr
+    # nothing was read and, in particular, no output file landed in the working directory
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["app.log"]
+
+
+@AS_ROOT
+def test_dir_parent_denies_write(run_cli, tmp_path):
+    """C-64: a parent that denies write — `os.mkdir` *succeeds* as root, hence the skip."""
+    write(tmp_path / "app.log", APP_IN)
+    parent = tmp_path / "locked"
+    parent.mkdir()
+    os.chmod(parent, 0o500)
+    try:
+        status, stdout, stderr = run_cli(
+            "--out-dir", "locked/clean", "app.log", cwd=tmp_path
+        )
+        assert status == 2
+        assert stdout == b""
+        assert b"cannot create output directory 'locked/clean'" in stderr
+        assert b"Permission denied" in stderr
+        assert b"Traceback" not in stderr
+        assert not (parent / "clean").exists()
+    finally:
+        os.chmod(parent, 0o700)
+
+
+# ===============================================================================================
+# T038 — `--out-dir` with no FILE operand (C-65, FR-031)
+# ===============================================================================================
+
+
+def test_out_dir_without_operand(run_cli, tmp_path):
+    """C-65: stdin is not read, DIR is not created, stdout is empty, status 2."""
+    status, stdout, stderr = run_cli("--out-dir", "nope", cwd=tmp_path)
+
+    assert status == 2
+    assert stdout == b""
+    assert ERROR_PREFIX in stderr
+    assert b"--out-dir requires at least one FILE operand" in stderr
+    assert b"Traceback" not in stderr
+    assert not (tmp_path / "nope").exists()
+
+
+def test_out_dir_without_operand_does_not_read_stdin(run_cli, tmp_path):
+    """FR-031, A-16: data offered on stdin is left unread and unredacted."""
+    status, stdout, stderr = run_cli(
+        "--out-dir", "nope", stdin=b"user jane@example.com\n", cwd=tmp_path
+    )
+    assert status == 2
+    assert stdout == b""
+    assert b"[EMAIL]" not in stdout
+    assert b"jane" not in stderr
+    assert not (tmp_path / "nope").exists()
+
+
+# ===============================================================================================
+# T039 — the output file cannot be opened, or fails on flush/close (C-66, FR-030)
+# ===============================================================================================
+
+
+@AS_ROOT
+def test_output_file_cannot_be_opened(run_cli, tmp_path):
+    """C-66: the output path is named, the later operand is still processed, status 2."""
+    write(tmp_path / "a.log", APP_IN)
+    write(tmp_path / "b.log", WEB_IN)
+    blocked = write(tmp_path / "clean" / "a.log", b"")
+    os.chmod(blocked, 0o400)
+    try:
+        status, stdout, stderr = run_cli(
+            "--out-dir", "clean", "a.log", "b.log", cwd=tmp_path
+        )
+        assert status == 2
+        assert stdout == b"wrote 1 files\n"  # a.log not counted, b.log is
+        assert b"cannot write 'clean/a.log'" in stderr
+        assert b"Permission denied" in stderr
+        assert b"Traceback" not in stderr
+        assert (tmp_path / "clean" / "b.log").read_bytes() == WEB_OUT
+        assert blocked.read_bytes() == b""
+    finally:
+        os.chmod(blocked, 0o600)
+
+
+def test_output_flush_failure_fails_run(run_cli, tmp_path):
+    """FR-030, research.md R22: a write/flush failure is reported and the operand is not counted.
+
+    `/dev/full` accepts an `open` and fails the write with `ENOSPC`, which is the shape of a
+    full filesystem. DIR is `/dev`, so the operand named `full` has `/dev/full` as its output
+    path. The second operand is a *missing* file rather than a readable one, deliberately: a
+    readable one would have the tool create a new file in `/dev`, and its diagnostic proves
+    just as well that the run continued past the write failure.
+    """
+    write(tmp_path / "full", APP_IN * 4096)  # large enough that the write reaches the device
+    assert not (tmp_path / "missing.log").exists()
+
+    status, stdout, stderr = run_cli(
+        "--out-dir",
+        "/dev",
+        str(tmp_path / "full"),
+        str(tmp_path / "missing.log"),
+        cwd=tmp_path,
+    )
+
+    assert status == 2
+    assert b"cannot write '/dev/full'" in stderr
+    assert b"No space left on device" in stderr
+    assert b"Traceback" not in stderr
+    # the failing operand is not counted: an operand counts only after a clean close (R22)
+    assert stdout == b"wrote 0 files\n"
+    # and the run went on to the operand after it
+    assert b"missing.log" in stderr
+    assert b"jane" not in stderr
+
+
+# ===============================================================================================
+# T040 — the output path is the input file (C-67, FR-036, SR-012, SC-017)
+# ===============================================================================================
+
+
+def test_output_path_is_the_input(run_cli, tmp_path):
+    """C-67: `--out-dir .` in the operand's own directory — refused, nothing truncated.
+
+    With DIR `.` *every* operand is its own output path, so both are refused and N is 0. The
+    second diagnostic is what proves the run carried on past the first refusal rather than
+    stopping at it (FR-036: the remaining operands are still processed).
+    """
+    app = write(tmp_path / "app.log", APP_IN)
+    web = write(tmp_path / "b.log", WEB_IN)
+    before = {
+        path: (path.read_bytes(), path.stat().st_size, digest(path))
+        for path in (app, web)
+    }
+
+    status, stdout, stderr = run_cli(
+        "--out-dir", ".", "app.log", "b.log", cwd=tmp_path
+    )
+
+    assert status == 2
+    assert stderr.count(b"refusing to write") == 2  # the run continued to the second
+    assert b"app.log" in stderr
+    assert b"b.log" in stderr
+    assert b"Traceback" not in stderr
+    # neither operand is touched — the whole point of the identity guard is that `O_TRUNC`
+    # never reaches the input
+    for path, expected in before.items():
+        assert (path.read_bytes(), path.stat().st_size, digest(path)) == expected
+    assert stdout == b"wrote 0 files\n"
+
+
+def test_operand_not_truncated_when_refused(run_cli, tmp_path):
+    """SR-012, SC-017: the aliasing shapes the guard exists for — none is the same string.
+
+    `--out-dir .`, an absolute DIR that contains the operand, and a hard link to it: each is
+    the same file by `st_dev`/`st_ino` and none is the same path string (research.md R21).
+    """
+    payload = APP_IN * 64
+
+    # 1. the relative `.` spelling
+    app = write(tmp_path / "one" / "app.log", payload)
+    before = (app.stat().st_size, digest(app))
+    status, _, stderr = run_cli("--out-dir", ".", "app.log", cwd=tmp_path / "one")
+    assert status == 2
+    assert b"refusing to write" in stderr
+    assert (app.stat().st_size, digest(app)) == before
+
+    # 2. an absolute DIR holding the operand, named relatively
+    app = write(tmp_path / "two" / "app.log", payload)
+    before = (app.stat().st_size, digest(app))
+    status, _, stderr = run_cli(
+        "--out-dir", str(tmp_path / "two"), "app.log", cwd=tmp_path / "two"
+    )
+    assert status == 2
+    assert b"refusing to write" in stderr
+    assert (app.stat().st_size, digest(app)) == before
+
+    # 3. a hard link: the output path and the operand are different names for one file
+    source = write(tmp_path / "three" / "src" / "app.log", payload)
+    (tmp_path / "three" / "clean").mkdir(parents=True, exist_ok=True)
+    os.link(source, tmp_path / "three" / "clean" / "app.log")
+    before = (source.stat().st_size, digest(source))
+    status, _, stderr = run_cli(
+        "--out-dir", "clean", "src/app.log", cwd=tmp_path / "three"
+    )
+    assert status == 2
+    assert b"refusing to write" in stderr
+    assert (source.stat().st_size, digest(source)) == before
+
+
+# ===============================================================================================
+# T041 — symbolic links at the output path (C-73, C-74, SR-010)
+# ===============================================================================================
+
+
+def test_symlink_output_refused(run_cli, tmp_path):
+    """C-73: a symlink at the output path is not followed and its target is untouched."""
+    write(tmp_path / "app.log", APP_IN)
+    outside = write(tmp_path / "outside" / "secret.txt", b"do not touch\n")
+    (tmp_path / "clean").mkdir()
+    os.symlink(outside, tmp_path / "clean" / "app.log")
+
+    status, stdout, stderr = run_cli("--out-dir", "clean", "app.log", cwd=tmp_path)
+
+    assert status == 2
+    assert stdout == b"wrote 0 files\n"
+    assert b"cannot write 'clean/app.log'" in stderr
+    assert b"Too many levels of symbolic links" in stderr
+    assert b"Traceback" not in stderr
+    assert outside.read_bytes() == b"do not touch\n"
+
+
+def test_dangling_symlink_refused_and_target_not_created(run_cli, tmp_path):
+    """C-74, SR-010: the case an existence check would miss.
+
+    A *dangling* symlink out of DIR is the shape that would otherwise silently create a file
+    holding redacted data outside the folder the caller named. Required Phase 0 regression
+    test (research.md R20).
+    """
+    write(tmp_path / "web.log", WEB_IN)
+    target = tmp_path / "outside" / "created.txt"
+    target.parent.mkdir(parents=True, exist_ok=True)
+    (tmp_path / "clean").mkdir()
+    os.symlink(target, tmp_path / "clean" / "web.log")
+    assert not target.exists()
+
+    status, stdout, stderr = run_cli("--out-dir", "clean", "web.log", cwd=tmp_path)
+
+    assert status == 2
+    assert stdout == b"wrote 0 files\n"
+    assert b"cannot write 'clean/web.log'" in stderr
+    assert b"Too many levels of symbolic links" in stderr
+    assert not target.exists(), "redacted data was written outside DIR"
+    assert not os.path.lexists(target)
+
+
+# ===============================================================================================
+# T042 — an over-length line suppresses the count line (C-68, FR-033)
+# ===============================================================================================
+
+
+def test_over_length_line_suppresses_count_line(run_cli, tmp_path):
+    """C-68: the run stops, the folder is plainly marked untrustworthy by the missing line."""
+    first = b"first line jane@example.com\n"
+    over_length = b"x" * (1024 * 1024 + 1) + b"\n"
+    write(tmp_path / "big.log", first + over_length + b"after\n")
+    write(tmp_path / "app.log", APP_IN)
+
+    status, stdout, stderr = run_cli(
+        "--out-dir", "clean3", "big.log", "app.log", cwd=tmp_path
+    )
+
+    assert status == 2
+    assert b"wrote" not in stdout
+    assert stdout == b""
+    assert b"big.log" in stderr
+    assert b"line exceeds the maximum length of 1048576 characters" in stderr
+    assert b"Traceback" not in stderr
+
+    # the lines before the over-length one stay; no part of it is written
+    written = (tmp_path / "clean3" / "big.log").read_bytes()
+    assert written == b"first line [EMAIL]\n"
+    assert b"x" * 1000 not in written
+    # the run read no later operand, so no output file exists for it
+    assert not (tmp_path / "clean3" / "app.log").exists()
