+
+# ===============================================================================================
+# T026 — multiplicity and collisions (C-58, C-59, SC-015, A-18)
+# ===============================================================================================
+
+
+@pytest.mark.parametrize("k", [1, 2, 3, 7, 12])
+def test_k_operands_produce_k_files(run_cli, tmp_path, k):
+    """SC-015: K operands give exactly K files, each the redaction of its own operand."""
+    names = []
+    for index in range(k):
+        name = "src%02d.log" % index
+        write(tmp_path / name, b"id=%d jane@example.com +14155552671\n" % index)
+        names.append(name)
+
+    status, stdout, stderr = run_cli("--out-dir", "clean", *names, cwd=tmp_path)
+    assert (status, stderr) == (0, b"")
+    assert stdout == b"wrote %d files\n" % k
+    assert sorted(p.name for p in (tmp_path / "clean").iterdir()) == sorted(names)
+    for index, name in enumerate(names):
+        assert (tmp_path / "clean" / name).read_bytes() == (
+            b"id=%d [EMAIL] [PHONE]\n" % index
+        )
+
+
+def test_colliding_final_components(run_cli, tmp_path):
+    """C-58, A-18: two operands sharing a name report 2, and the last one wins the file."""
+    write(tmp_path / "a" / "app.log", b"first jane@example.com\n")
+    write(tmp_path / "b" / "app.log", b"second 10.0.0.7\n")
