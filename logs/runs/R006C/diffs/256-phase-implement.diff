+def _prepare_out_dir(dir_path):
+    """Create `dir_path` and every missing parent, owner-accessible only. True when usable.
+
+    Each missing component is created individually with `os.mkdir(path, 0o700)`, outermost
+    first. `os.makedirs(dir_path, mode=0o700, exist_ok=True)` is **not** used and must not be
+    substituted: since Python 3.7 its `mode` applies only to the leaf, measured `0o755` on `a`
+    and `a/b` for `a/b/c` under the usual umask, which leaves two group- and world-readable
+    directories holding redacted log data — a direct SR-011 and SC-020 failure.
+    `makedirs` followed by `chmod` is rejected too, because the Security Baseline requires the
+    narrowest permissions *set at creation* rather than relaxed and then tightened
+    (research.md R19).
+
+    An existing directory is used exactly as it is: nothing is created inside it, nothing in it
+    is removed, and its mode is not altered (FR-025).
+
+    On failure the diagnostic names DIR as it was written on the command line, with the
+    operating system's own reason, and `False` is returned so the run can stop before any
+    operand is opened (FR-029). `OSError` is caught at this boundary only and always reported
+    (Principle II).
+    """
+    missing = []
+    path = dir_path
+    while not os.path.isdir(path):
+        missing.append(path)
+        parent = os.path.dirname(path)
+        if parent == path or not parent:
+            # Reached the filesystem root, a bare relative name, or the empty string — which is
+            # not a directory and cannot be created, so `os.mkdir("")` below reports
+            # `No such file or directory` for it (FR-029, spec Edge Cases).
+            break
+        path = parent
