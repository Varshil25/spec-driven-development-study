+# ===============================================================================================
+# T044 — disclosure across every failure path (C-71, SR-017, SC-021)
+# ===============================================================================================
+
+#: Values that must never appear in a diagnostic, and the input that carries them.
+SECRETS = [
+    b"jane.doe@example.com",
+    b"jane",
+    b"example.com",
+    b"192.168.0.10",
+    b"192.168",
+    b"4111 1111 1111 1111",
+    b"4111",
+    b"+14155552671",
+    b"14155552671",
+    b"1415",
+    b"paid with",
+]
+
+SENSITIVE_LINE = (
+    b"jane.doe@example.com paid with 4111 1111 1111 1111 from 192.168.0.10\n"
+    b"call +14155552671 now\n"
+)
+
+
+def _failure_runs(run_cli, tmp_path):
+    """Every `--out-dir` failure path, each over input carrying personal data.
+
+    Yields `(label, stderr)` so the two disclosure assertions below can share one sweep.
+    """
+    root = tmp_path / "sweep"
+
+    # 1. an unreadable operand beside a readable one
+    case = root / "unreadable"
+    write(case / "app.log", SENSITIVE_LINE)
+    yield "unreadable-operand", run_cli(
+        "--out-dir", "clean", "app.log", "missing.log", cwd=case
+    )[2]
+
+    # 2. DIR is a regular file
+    case = root / "dir-is-file"
+    write(case / "app.log", SENSITIVE_LINE)
+    write(case / "clean", b"blocker\n")
+    yield "dir-is-a-file", run_cli("--out-dir", "clean", "app.log", cwd=case)[2]
+
+    # 3. an empty DIR value
+    case = root / "empty-dir"
+    write(case / "app.log", SENSITIVE_LINE)
+    yield "empty-dir", run_cli("--out-dir", "", "app.log", cwd=case)[2]
+
+    # 4. no operand
+    case = root / "no-operand"
+    case.mkdir(parents=True, exist_ok=True)
+    yield "no-operand", run_cli(
+        "--out-dir", "nope", stdin=SENSITIVE_LINE, cwd=case
+    )[2]
+
+    # 5. a repeated option
+    case = root / "repeated"
+    write(case / "app.log", SENSITIVE_LINE)
+    yield "repeated-option", run_cli(
+        "--out-dir", "a", "--out-dir", "b", "app.log", cwd=case
+    )[2]
+
+    # 6. a rejected spelling
+    case = root / "spelling"
+    write(case / "app.log", SENSITIVE_LINE)
+    yield "rejected-spelling", run_cli("--out_dir", "clean", "app.log", cwd=case)[2]
+
+    # 7. the output path is the input file
+    case = root / "self-write"
+    write(case / "app.log", SENSITIVE_LINE)
+    yield "self-write", run_cli("--out-dir", ".", "app.log", cwd=case)[2]
+
+    # 8. a symlink at the output path
+    case = root / "symlink"
+    write(case / "app.log", SENSITIVE_LINE)
+    write(case / "outside" / "secret.txt", b"do not touch\n")
+    (case / "clean").mkdir(parents=True, exist_ok=True)
+    os.symlink(case / "outside" / "secret.txt", case / "clean" / "app.log")
+    yield "symlink-output", run_cli("--out-dir", "clean", "app.log", cwd=case)[2]
+
+    # 9. a dangling symlink at the output path
+    case = root / "dangling"
+    write(case / "app.log", SENSITIVE_LINE)
+    (case / "clean").mkdir(parents=True, exist_ok=True)
+    os.symlink(case / "outside" / "created.txt", case / "clean" / "app.log")
+    yield "dangling-symlink", run_cli("--out-dir", "clean", "app.log", cwd=case)[2]
+
+    # 10. an over-length line
+    case = root / "over-length"
+    write(case / "big.log", SENSITIVE_LINE + b"x" * (1024 * 1024 + 1) + b"\n")
+    yield "over-length-line", run_cli("--out-dir", "clean", "big.log", cwd=case)[2]
+
+    # 11. a write failure on a full device
+    case = root / "enospc"
+    write(case / "full", SENSITIVE_LINE * 4096)
+    yield "write-failure", run_cli("--out-dir", "/dev", str(case / "full"), cwd=case)[2]
+
+
+def test_no_input_data_in_diagnostics(run_cli, tmp_path):
+    """C-71, SR-017, SC-021: no email, IP, phone, card or input line reaches stderr."""
+    leaks = []
+    for label, stderr in _failure_runs(run_cli, tmp_path):
+        assert stderr != b"", label  # every one of these must fail loudly
+        for secret in SECRETS:
+            if secret in stderr:
+                leaks.append((label, secret, stderr))
+    assert leaks == []
+
+
+def test_no_traceback_on_any_out_dir_error_path(run_cli, tmp_path):
+    """C-71, SR-017: every new failure path is a handled `OSError` or a usage check."""
+    offences = []
+    for label, stderr in _failure_runs(run_cli, tmp_path):
+        if b"Traceback" in stderr or b'File "' in stderr:
+            offences.append((label, stderr))
+    assert offences == []
