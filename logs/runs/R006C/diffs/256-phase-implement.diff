+# ===============================================================================================
+# T043 — the argument allowlist (C-69, C-70, C-75, SR-016)
+# ===============================================================================================
+
+
+@pytest.mark.parametrize("spelling", ["--out_dir", "--out", "--out-di", "--outdir"])
+def test_rejected_out_dir_spellings(run_cli, tmp_path, spelling):
+    """C-69, SR-016: the allowlist is closed — no abbreviation and no near miss is accepted."""
