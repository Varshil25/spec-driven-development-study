+    status, stdout, stderr = run_cli("--out-dir", "clean", "empty.log", cwd=tmp_path)
+    assert (status, stdout, stderr) == (0, b"wrote 1 files\n", b"")
+    assert (tmp_path / "clean" / "empty.log").read_bytes() == b""
+
+
+# ===============================================================================================
+# T023 — permissions (C-60, C-61, SR-011, SC-020)
+# ===============================================================================================
+
+
+def test_created_modes_are_owner_only(run_cli, tmp_path):
+    """C-60, SR-011, SC-020: DIR, **each created parent**, and every output file.
+
+    Asserting the parents is a required Phase 0 regression test: `os.makedirs(…, mode=0o700)`
+    left `a` and `a/b` at `0o755`, so without this the defect is invisible (research.md R19).
+    The mask form `mode & 0o077 == 0` is umask-independent.
+    """
+    write(tmp_path / "app.log", APP_IN)
+    write(tmp_path / "web.log", WEB_IN)
+
+    status, _, _ = run_cli(
+        "--out-dir", "a/b/c", "app.log", "web.log", cwd=tmp_path
+    )
+    assert status == 0
+
+    for part in ("a", "a/b", "a/b/c"):
+        assert owner_only(tmp_path / part), (part, oct(os.stat(tmp_path / part).st_mode))
+    for name in ("app.log", "web.log"):
+        output = tmp_path / "a" / "b" / "c" / name
+        assert owner_only(output), (name, oct(os.stat(output).st_mode))
+
+
+def test_existing_output_keeps_its_mode(run_cli, tmp_path):
+    """C-61, SR-011: a pre-existing output file's mode is neither widened nor narrowed."""
+    write(tmp_path / "app.log", APP_IN)
+    existing = write(tmp_path / "clean" / "app.log", b"old\n")
+    os.chmod(existing, 0o644)
+
+    status, _, _ = run_cli("--out-dir", "clean", "app.log", cwd=tmp_path)
+    assert status == 0
+    assert stat.S_IMODE(os.stat(existing).st_mode) == 0o644
+    assert existing.read_bytes() == APP_OUT
+
+
+# ===============================================================================================
+# T024 — operands are never written (C-54, SC-017, FR-017)
+# ===============================================================================================
+
+
+def test_operands_unmodified(run_cli, tmp_path):
+    """C-54, SC-017: every operand is byte-for-byte, size- and mtime-identical afterwards."""
