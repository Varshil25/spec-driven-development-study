+"""Tests for the ``accounts`` command-line tool.
+
+Run from the repository root::
+
+    PYTHONPATH=src python -m unittest discover -s tests -v
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC = REPO_ROOT / "src"
+
+PASSWORD = "correct horse battery"
+OTHER_PASSWORD = "a different passphrase"
+
+EXIT_OK = 0
+EXIT_CREDS = 1
+EXIT_VALIDATION = 2
+EXIT_NOT_FOUND = 3
+EXIT_LOCKED = 4
+
+
+class CliTestCase(unittest.TestCase):
+    """Drives the tool the way a user does: ``python -m accounts`` in a subprocess."""
+
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.workdir = Path(self._tmp.name)
+        self.store = self.workdir / "users.db"
+
+    def run_cmd(self, *args: str, stdin: str = "", store: str | None = None):
+        env = dict(os.environ)
+        env["PYTHONPATH"] = str(SRC) + (
+            os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else ""
+        )
+        argv = [sys.executable, "-m", "accounts", "--store", store or str(self.store), *args]
+        return subprocess.run(
+            argv,
+            input=stdin,
+            capture_output=True,
+            text=True,
+            cwd=self.workdir,
+            env=env,
+            timeout=120,
+        )
+
+    # convenience wrappers -------------------------------------------------
+    def register(self, username: str = "alice", password: str = PASSWORD):
+        return self.run_cmd("register", username, stdin=f"{password}\n")
+
+    def login(self, username: str = "alice", password: str = PASSWORD):
+        return self.run_cmd("login", username, stdin=f"{password}\n")
+
+    def assertResult(self, proc, status: int, stdout: str | None = None, stderr: str | None = None):
+        self.assertEqual(
+            proc.returncode,
+            status,
+            f"expected exit {status}, got {proc.returncode}\n"
+            f"stdout={proc.stdout!r}\nstderr={proc.stderr!r}",
+        )
+        if stdout is not None:
+            self.assertEqual(proc.stdout, stdout)
+        if stderr is not None:
+            self.assertEqual(proc.stderr, stderr)
+
+    def users(self) -> dict:
+        return json.loads(self.store.read_text(encoding="utf-8"))["users"]
+
+
+class TestRegister(CliTestCase):
