@@ -0,0 +1,50 @@
+"""Exit statuses and the exception used to carry them."""
+
+from __future__ import annotations
+
+# Exit statuses defined by the command-line contract.
+EXIT_OK = 0
+EXIT_INVALID_CREDENTIALS = 1
+EXIT_VALIDATION = 2
+EXIT_NOT_FOUND = 3  # also used for "already exists"
+EXIT_LOCKED = 4
+EXIT_STORE_ERROR = 5  # unreadable / corrupt / unwritable store
+
+
+class AccountsError(Exception):
+    """An error that maps to a message on stderr and a specific exit status."""
+
+    def __init__(self, message: str, status: int) -> None:
+        super().__init__(message)
+        self.message = message
+        self.status = status
+
+
+class ValidationError(AccountsError):
+    def __init__(self, message: str) -> None:
+        super().__init__(message, EXIT_VALIDATION)
+
+
+class InvalidCredentialsError(AccountsError):
+    def __init__(self, message: str = "invalid credentials") -> None:
+        super().__init__(message, EXIT_INVALID_CREDENTIALS)
+
+
+class NoSuchUserError(AccountsError):
+    def __init__(self, username: str) -> None:
+        super().__init__(f"no such user: {username}", EXIT_NOT_FOUND)
+
+
+class UserExistsError(AccountsError):
+    def __init__(self, username: str) -> None:
+        super().__init__(f"user already exists: {username}", EXIT_NOT_FOUND)
+
+
+class AccountLockedError(AccountsError):
+    def __init__(self, message: str = "account locked") -> None:
+        super().__init__(message, EXIT_LOCKED)
+
+
+class StoreError(AccountsError):
+    def __init__(self, message: str) -> None:
+        super().__init__(message, EXIT_STORE_ERROR)
