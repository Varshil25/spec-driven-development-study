index 0000000..576a53b
--- /dev/null
+++ b/src/accounts/service.py
@@ -0,0 +1,171 @@
+"""Account operations: register, login, unlock, passwd, delete.
+
+Each operation loads the store, applies its change, and saves the store again
+(only when something actually changed).  Operations raise ``AccountsError``
+subclasses, which the CLI turns into a message on stderr and an exit status.
+"""
+
+from __future__ import annotations
+
+import datetime as _dt
+import re
+from typing import Any
+
+from .errors import (
+    AccountLockedError,
+    InvalidCredentialsError,
+    NoSuchUserError,
+    UserExistsError,
+    ValidationError,
+)
+from .passwords import MIN_PASSWORD_LENGTH, dummy_verify, hash_password, verify_password
+from .store import Store
+
+USERNAME_MIN = 3
+USERNAME_MAX = 32
+USERNAME_RE = re.compile(rf"\A[A-Za-z0-9_]{{{USERNAME_MIN},{USERNAME_MAX}}}\Z")
+
+MAX_FAILED_ATTEMPTS = 5
+
+
+def _now() -> str:
+    return _dt.datetime.now(_dt.timezone.utc).replace(microsecond=0).isoformat()
+
+
+def validate_username(username: str) -> str:
+    """Return ``username`` unchanged, or raise :class:`ValidationError`."""
+    if not USERNAME_RE.match(username):
+        raise ValidationError(
+            f"invalid username: {username!r} "
+            f"(use {USERNAME_MIN}-{USERNAME_MAX} letters, digits or underscores)"
+        )
+    return username
+
+
+def validate_password(password: str) -> str:
+    """Return ``password`` unchanged, or raise :class:`ValidationError`."""
+    if len(password) < MIN_PASSWORD_LENGTH:
+        raise ValidationError(
+            f"password too short: at least {MIN_PASSWORD_LENGTH} characters required"
+        )
+    return password
+
+
+def _is_locked(record: dict[str, Any]) -> bool:
+    if record.get("locked") is True:
+        return True
+    return _failed_attempts(record) >= MAX_FAILED_ATTEMPTS
+
+
+def _failed_attempts(record: dict[str, Any]) -> int:
+    value = record.get("failed_attempts", 0)
+    return value if isinstance(value, int) and value > 0 else 0
+
+
+class AccountService:
+    """The operations behind the command-line interface."""
+
+    def __init__(self, store: Store) -> None:
+        self.store = store
+
+    # -- helpers ---------------------------------------------------------
+    def _get(self, data: dict[str, Any], username: str) -> dict[str, Any]:
+        """Return an existing account record or raise :class:`NoSuchUserError`."""
+        record = data["users"].get(username)
+        if record is None:
+            raise NoSuchUserError(username)
+        return record
+
+    # -- commands --------------------------------------------------------
+    def register(self, username: str, password: str) -> str:
+        """Create a new account.  Returns the line to print on success."""
+        validate_username(username)
+        validate_password(password)
+
+        data = self.store.load()
+        if username in data["users"]:
+            raise UserExistsError(username)
+
+        record = hash_password(password)
+        record.update(
+            {
+                "failed_attempts": 0,
+                "locked": False,
+                "created_at": _now(),
+                "updated_at": _now(),
+            }
+        )
+        data["users"][username] = record
+        self.store.save(data)
+        return f"registered {username}"
+
+    def login(self, username: str, password: str) -> str:
+        """Authenticate.  Returns ``"ok"`` on success.
+
+        A failed attempt increments the account's failed-attempt counter; the
+        account is locked once the counter reaches 5.  A locked account is
+        rejected before the password is even checked, so a correct password on
+        a locked account still fails.  An unknown username is reported as
+        invalid credentials (not "no such user") to avoid disclosing which
+        names are registered.
+        """
+        data = self.store.load()
+        record = data["users"].get(username)
+        if record is None:
+            dummy_verify(password)
+            raise InvalidCredentialsError()
+
+        if _is_locked(record):
+            raise AccountLockedError()
+
+        if not verify_password(password, record):
+            record["failed_attempts"] = _failed_attempts(record) + 1
+            if record["failed_attempts"] >= MAX_FAILED_ATTEMPTS:
+                record["locked"] = True
+            record["updated_at"] = _now()
+            self.store.save(data)
+            raise InvalidCredentialsError()
+
+        if _failed_attempts(record) or record.get("locked"):
+            record["failed_attempts"] = 0
+            record["locked"] = False
+            record["updated_at"] = _now()
+            self.store.save(data)
+        return "ok"
+
+    def unlock(self, username: str) -> str:
+        """Unlock an account and reset its failed-attempt counter."""
+        data = self.store.load()
+        record = self._get(data, username)
+        record["failed_attempts"] = 0
+        record["locked"] = False
+        record["updated_at"] = _now()
+        self.store.save(data)
+        return f"unlocked {username}"
+
+    def passwd(self, username: str, current_password: str, new_password: str) -> str:
+        """Change an account's password, given the current one."""
+        data = self.store.load()
+        record = self._get(data, username)
+
+        if not verify_password(current_password, record):
+            raise InvalidCredentialsError()
+        validate_password(new_password)
+
+        updated = hash_password(new_password)
+        record.update(updated)
+        record["updated_at"] = _now()
+        self.store.save(data)
+        return f"changed password for {username}"
+
+    def delete(self, username: str, password: str) -> str:
+        """Delete an account, given its password."""
+        data = self.store.load()
+        record = self._get(data, username)
+
+        if not verify_password(password, record):
+            raise InvalidCredentialsError()
+
+        del data["users"][username]
+        self.store.save(data)
+        return f"deleted {username}"
diff --git a/src/accounts/store.py b/src/accounts/store.py
new file mode 100644
index 0000000..023f15c
--- /dev/null
+++ b/src/accounts/store.py
@@ -0,0 +1,137 @@
+"""The account store: a single JSON file holding every account record.
+
+The on-disk format is::
+
+    {
+      "version": 1,
+      "users": {
+        "alice": {
+          "algorithm": "scrypt", "n": 16384, "r": 8, "p": 1,
+          "salt": "<hex>", "hash": "<hex>",
+          "failed_attempts": 0, "locked": false,
+          "created_at": "...", "updated_at": "..."
+        }
+      }
+    }
+
+Reads tolerate a missing file (an empty store).  Writes are atomic: the whole
+store is written to a temporary file in the same directory, flushed, and then
+renamed over the target, so an interrupted run never leaves a half-written
+store behind.  The file is created with owner-only permissions.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+from pathlib import Path
+from typing import Any
+
+from .errors import StoreError
+
+STORE_VERSION = 1
+FILE_MODE = 0o600
+
+
+class Store:
+    """Read/write access to the JSON store file at ``path``."""
+
+    def __init__(self, path: str | os.PathLike[str]) -> None:
+        self.path = Path(path)
+
+    # -- loading ---------------------------------------------------------
+    def load(self) -> dict[str, Any]:
+        """Return the store contents, or an empty store if the file is absent."""
+        try:
+            raw = self.path.read_text(encoding="utf-8")
+        except FileNotFoundError:
+            return self._empty()
+        except IsADirectoryError:
+            raise StoreError(f"store path is a directory: {self.path}") from None
+        except OSError as exc:
+            raise StoreError(f"cannot read store {self.path}: {exc.strerror or exc}") from None
+
+        if not raw.strip():
+            return self._empty()
+
+        try:
+            data = json.loads(raw)
+        except json.JSONDecodeError as exc:
+            raise StoreError(f"store {self.path} is corrupt: {exc}") from None
+
+        if not isinstance(data, dict):
+            raise StoreError(f"store {self.path} is corrupt: expected a JSON object")
+
+        version = data.get("version", STORE_VERSION)
+        if not isinstance(version, int) or version > STORE_VERSION:
+            raise StoreError(
+                f"store {self.path} has unsupported version {version!r}; "
+                f"this tool understands version {STORE_VERSION}"
+            )
+
+        users = data.get("users", {})
+        if not isinstance(users, dict) or any(
+            not isinstance(k, str) or not isinstance(v, dict) for k, v in users.items()
+        ):
+            raise StoreError(f"store {self.path} is corrupt: bad 'users' section")
+
+        return {"version": STORE_VERSION, "users": users}
+
+    @staticmethod
+    def _empty() -> dict[str, Any]:
+        return {"version": STORE_VERSION, "users": {}}
+
+    # -- saving ----------------------------------------------------------
+    def save(self, data: dict[str, Any]) -> None:
+        """Atomically replace the store file with ``data``."""
+        payload = json.dumps(
+            {"version": STORE_VERSION, "users": data.get("users", {})},
+            indent=2,
+            sort_keys=True,
+            ensure_ascii=True,
+        )
+        directory = self.path.parent if str(self.path.parent) else Path(".")
+        try:
+            directory.mkdir(parents=True, exist_ok=True)
+            fd, tmp_name = tempfile.mkstemp(
+                prefix=f".{self.path.name}.", suffix=".tmp", dir=directory
+            )
+            try:
+                with os.fdopen(fd, "w", encoding="utf-8") as handle:
+                    handle.write(payload)
+                    handle.write("\n")
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.chmod(tmp_name, FILE_MODE)
+                os.replace(tmp_name, self.path)
+            except BaseException:
+                # Leave no stray temporary file behind on failure.
+                try:
+                    os.unlink(tmp_name)
+                except OSError:
+                    pass
+                raise
+            self._fsync_dir(directory)
+        except OSError as exc:
+            raise StoreError(f"cannot write store {self.path}: {exc.strerror or exc}") from None
+
+    @staticmethod
+    def _fsync_dir(directory: Path) -> None:
+        try:
+            fd = os.open(directory, os.O_RDONLY)
+        except OSError:
+            return
+        try:
+            os.fsync(fd)
+        except OSError:
+            pass
+        finally:
+            os.close(fd)
+
+    # -- creation --------------------------------------------------------
+    def ensure_exists(self) -> None:
+        """Create an empty store file if it is not there yet ("created on first use")."""
+        if self.path.exists():
+            return
+        self.save(self._empty())
