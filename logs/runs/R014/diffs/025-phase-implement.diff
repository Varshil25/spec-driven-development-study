+            with self.subTest(username=username):
+                proc = self.run_cmd("register", username, stdin=f"{PASSWORD}\n")
+                self.assertResult(proc, EXIT_VALIDATION, stdout="")
+
+    def test_valid_usernames_accepted(self):
