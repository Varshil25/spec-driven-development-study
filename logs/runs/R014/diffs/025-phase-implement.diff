--- /dev/null
+++ b/src/accounts/passwords.py
@@ -0,0 +1,86 @@
+"""Password hashing and verification.
+
+Passwords are stored as salted scrypt hashes (``hashlib.scrypt``, standard
+library).  Each record keeps its own salt and cost parameters so that the
+parameters can be raised later without invalidating existing accounts.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import os
+import secrets
+from typing import Any
+
+MIN_PASSWORD_LENGTH = 12
+
+ALGORITHM = "scrypt"
+SALT_BYTES = 16
+KEY_BYTES = 32
+
+# cost parameters: ~16 MiB of memory per hash
+SCRYPT_N = 1 << 14
+SCRYPT_R = 8
+SCRYPT_P = 1
+# hashlib.scrypt requires maxmem >= 128 * n * r * p plus slack.
+SCRYPT_MAXMEM = 64 * 1024 * 1024
+
+
+def _derive(password: str, salt: bytes, n: int, r: int, p: int, length: int) -> bytes:
+    return hashlib.scrypt(
+        password.encode("utf-8"),
+        salt=salt,
+        n=n,
+        r=r,
+        p=p,
+        dklen=length,
+        maxmem=SCRYPT_MAXMEM,
+    )
+
+
+def hash_password(password: str) -> dict[str, Any]:
+    """Return a JSON-serialisable hash record for ``password``."""
+    salt = secrets.token_bytes(SALT_BYTES)
+    digest = _derive(password, salt, SCRYPT_N, SCRYPT_R, SCRYPT_P, KEY_BYTES)
+    return {
+        "algorithm": ALGORITHM,
+        "n": SCRYPT_N,
+        "r": SCRYPT_R,
+        "p": SCRYPT_P,
+        "salt": salt.hex(),
+        "hash": digest.hex(),
+    }
+
+
+def verify_password(password: str, record: dict[str, Any]) -> bool:
+    """Check ``password`` against a hash record produced by :func:`hash_password`."""
+    if not isinstance(record, dict) or record.get("algorithm") != ALGORITHM:
+        return False
+    try:
+        salt = bytes.fromhex(record["salt"])
+        expected = bytes.fromhex(record["hash"])
+        n = int(record["n"])
+        r = int(record["r"])
+        p = int(record["p"])
+    except (KeyError, TypeError, ValueError):
+        return False
+    if not expected or n <= 1 or r <= 0 or p <= 0:
+        return False
+    try:
+        actual = _derive(password, salt, n, r, p, len(expected))
+    except ValueError:
+        return False
+    return hmac.compare_digest(actual, expected)
+
+
+def dummy_verify(password: str) -> None:
+    """Burn roughly one hash worth of work.
+
+    Used when a username does not exist so that the response time of an
+    unknown-user login resembles that of a wrong-password login.
+    """
+    try:
+        _derive(password, os.urandom(SALT_BYTES), SCRYPT_N, SCRYPT_R, SCRYPT_P, KEY_BYTES)
+    except ValueError:  # pragma: no cover - only on an exotic OpenSSL build
+        pass
