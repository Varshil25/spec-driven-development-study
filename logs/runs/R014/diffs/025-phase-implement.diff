+        self.assertNotEqual(records["alice"]["salt"], records["bob"]["salt"])
+        self.assertNotEqual(records["alice"]["hash"], records["bob"]["hash"])
+
+    def test_duplicate_username_fails(self):
+        self.register()
+        proc = self.register()
+        self.assertResult(proc, EXIT_NOT_FOUND, stdout="")
+        self.assertTrue(proc.stderr.strip())
+
+    def test_duplicate_registration_does_not_change_the_password(self):
