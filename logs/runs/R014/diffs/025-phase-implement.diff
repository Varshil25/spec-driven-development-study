+++ b/src/accounts/cli.py
@@ -0,0 +1,113 @@
+"""Command-line interface.
+
+Usage::
+
+    python -m accounts --store PATH COMMAND USERNAME
+
+Passwords are never given on the command line: each command reads the
+passwords it needs from standard input, one per line.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from typing import IO, Sequence
+
+from . import __version__
+from .errors import EXIT_OK, AccountsError, ValidationError
+from .service import AccountService
+from .store import Store
+
+COMMANDS = ("register", "login", "unlock", "passwd", "delete")
+
+# How many password lines each command consumes from standard input.
+PASSWORD_LINES = {
+    "register": 1,  # new password
+    "login": 1,  # password
+    "unlock": 0,
+    "passwd": 2,  # current password, then new password
+    "delete": 1,  # password
+}
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="python -m accounts",
+        description=(
+            "Manage local user accounts kept in a single store file. "
+            "Passwords are read from standard input, one per line."
+        ),
+        epilog=(
+            "exit status: 0 success, 1 invalid credentials, 2 invalid username or "
+            "password, 3 no such user / user already exists, 4 account locked, "
+            "5 store error"
+        ),
+    )
+    parser.add_argument(
+        "--store",
+        required=True,
+        metavar="PATH",
+        help="path to the account store file (created on first use)",
+    )
+    parser.add_argument("--version", action="version", version=f"accounts {__version__}")
+    parser.add_argument("command", choices=COMMANDS, metavar="COMMAND", help=", ".join(COMMANDS))
+    parser.add_argument("username", metavar="USERNAME", help="the account to act on")
+    return parser
+
+
+def read_password(stream: IO[str]) -> str:
+    """Read one password line from ``stream``.
+
+    The trailing newline (and a preceding carriage return) is removed; any
+    other character, including leading or trailing spaces, is part of the
+    password.  End of input yields an empty password, which the normal
+    validation and verification rules then reject.
+    """
+    try:
+        line = stream.readline()
+    except UnicodeDecodeError:
+        raise ValidationError("could not read password: input is not valid UTF-8") from None
+    if line.endswith("\n"):
+        line = line[:-1]
+        if line.endswith("\r"):
+            line = line[:-1]
+    return line
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = build_parser()
+    args = parser.parse_args(argv)
+
+    stdin = sys.stdin
+    stdout = sys.stdout
+    stderr = sys.stderr
+
+    try:
+        passwords = [read_password(stdin) for _ in range(PASSWORD_LINES[args.command])]
+
+        store = Store(args.store)
+        store.ensure_exists()
+        service = AccountService(store)
+
+        if args.command == "register":
+            message = service.register(args.username, passwords[0])
+        elif args.command == "login":
+            message = service.login(args.username, passwords[0])
+        elif args.command == "unlock":
+            message = service.unlock(args.username)
+        elif args.command == "passwd":
+            message = service.passwd(args.username, passwords[0], passwords[1])
+        elif args.command == "delete":
+            message = service.delete(args.username, passwords[0])
+        else:  # pragma: no cover - argparse restricts the choices
+            parser.error(f"unknown command: {args.command}")
+    except AccountsError as exc:
+        print(exc.message, file=stderr)
+        return exc.status
+    except KeyboardInterrupt:  # pragma: no cover - interactive use only
+        print("interrupted", file=stderr)
+        return 130
+
+    print(message, file=stdout)
+    return EXIT_OK
