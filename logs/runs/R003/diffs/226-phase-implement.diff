@@ -0,0 +1,80 @@
+"""Share allocation, net balances, and the greedy settlement.
+
+Pure functions: no I/O, no exceptions raised, no global state. All money is
+integer cents (research D1). All name ordering is plain `str` comparison, which
+is ascending Unicode code-point order and is unaffected by any locale setting
+(FR-011a, research D5).
+"""
+
+from dataclasses import dataclass
+
+from .expenses import Expense
+
+
+@dataclass(frozen=True)
+class Payment:
+    """A single whole-cent transfer from a participant who owes to one who is owed."""
+
+    payer: str  # had a negative balance
+    payee: str  # had a positive balance
+    amount_cents: int  # >= 1, so a 0.00 line can never be printed (FR-013)
+
+
+def compute_shares(participants: list[str], total_cents: int) -> dict[str, int]:
+    """Equal split, with the remainder charged one cent each to the first
+    `remainder` participants in ascending code-point name order.
+
+    Postcondition: sum(result.values()) == total_cents exactly — that is
+    divmod's own invariant, so no reconciliation pass is needed (FR-011,
+    FR-011a, research D6).
+    """
+    base, remainder = divmod(total_cents, len(participants))
+    shares = {name: base for name in participants}
+    for name in sorted(participants)[:remainder]:
+        shares[name] = base + 1
+    return shares
+
+
+def compute_balances(
+    participants: list[str], expenses: list[Expense]
+) -> dict[str, int]:
+    """Each participant's paid total minus their share.
+
+    Participants absent from every expense row are included with a paid total
+    of 0 (acceptance 1.4).
+
+    Postcondition: sum(result.values()) == 0 exactly (FR-012).
+    """
+    paid = {name: 0 for name in participants}
+    total_cents = 0
+    for expense in expenses:
+        paid[expense.payer] += expense.amount_cents
+        total_cents += expense.amount_cents
+    shares = compute_shares(participants, total_cents)
+    return {name: paid[name] - shares[name] for name in participants}
+
+
+def settle(balances: dict[str, int]) -> list[Payment]:
+    """Greedy largest-debt against largest-credit, re-selected each step.
+
+    Ties are broken in ascending code-point name order. Returns payments in
+    generation order, which is part of the output contract (FR-015).
+
+    Precondition: sum(balances.values()) == 0.
+    Postconditions: at most len(balances) - 1 payments, each at least one cent,
+    their total equal to the sum of the positive balances, and applying them
+    leaves every balance at exactly 0 (FR-013, FR-014, SC-002, SC-003).
+
+    The plain O(n squared) re-scan is deliberate: at 50 participants it is
+    ~2,500 operations, and it reads as FR-015's wording (research D7).
+    """
+    remaining = {name: value for name, value in balances.items() if value != 0}
+    payments: list[Payment] = []
+    while any(value < 0 for value in remaining.values()):
+        debtor = min(remaining, key=lambda name: (remaining[name], name))
+        creditor = min(remaining, key=lambda name: (-remaining[name], name))
+        amount = min(-remaining[debtor], remaining[creditor])
+        payments.append(Payment(debtor, creditor, amount))
+        remaining[debtor] += amount
+        remaining[creditor] -= amount
+    return payments
