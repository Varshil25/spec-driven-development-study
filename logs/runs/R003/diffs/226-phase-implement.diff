+"""The command-line surface: the accepted shape (FR-001) and misuse (FR-020).
+
+Exit-2 cases run in a subprocess because argparse exits the process itself
+(research D11).
+"""
+
+import pytest
+
+from splitter import cli
+
+REFERENCE_FILE = "payer,amount,description\nAlice,30.00,Hotel\n"
+
+
+# --------------------------------------------------------------------------
+# FR-001 — the accepted invocation
+# --------------------------------------------------------------------------
+
+
+def test_fr001_positional_path_plus_required_participants(write_csv, capsys):
+    """FR-001: one positional path and --participants, run in process."""
+    path = write_csv(REFERENCE_FILE)
+    assert cli.main([path, "--participants", "Alice,Bob"]) == 0
+    assert capsys.readouterr().out == "Bob pays Alice 15.00\n"
+
+
+def test_fr001_published_invocation_works_as_a_module(write_csv, run_subprocess):
+    """FR-001 / contracts/cli.md: python -m splitter FILE --participants NAMES."""
+    path = write_csv(REFERENCE_FILE)
+    result = run_subprocess(path, "--participants", "Alice,Bob")
+    assert result.returncode == 0
+    assert result.stdout == "Bob pays Alice 15.00\n"
+    assert result.stderr == ""
+
+
+def test_fr001_participants_value_may_carry_surrounding_spaces(write_csv, capsys):
+    """FR-001 / FR-006: names are trimmed after splitting on commas."""
+    path = write_csv(REFERENCE_FILE)
+    assert cli.main([path, "--participants", " Alice , Bob "]) == 0
+    assert capsys.readouterr().out == "Bob pays Alice 15.00\n"
+
+
+# --------------------------------------------------------------------------
+# FR-020 — malformed command line is exit 2 (T023)
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("argv", "case"),
+    [
+        ([], "missing positional path and --participants"),
+        (["--participants", "Alice,Bob"], "missing positional path"),
+        (["EXPENSES"], "missing --participants"),
+        (["EXPENSES", "--participants", "Alice,Bob", "--verbose"], "unknown option"),
+        (["EXPENSES", "extra", "--participants", "Alice,Bob"], "extra positional"),
+    ],
+)
+def test_fr020_command_line_misuse_exits_two(
+    write_csv, run_subprocess, argv, case
+):
+    """FR-020: argparse's native status 2, usage line on stderr, empty stdout."""
+    path = write_csv(REFERENCE_FILE)
+    args = [path if arg == "EXPENSES" else arg for arg in argv]
+    result = run_subprocess(*args)
+    assert result.returncode == 2, case
+    assert result.stdout == "", case
+    assert "splitter:" in result.stderr, case
+    assert "usage:" in result.stderr, case
