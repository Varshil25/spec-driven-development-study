+"""The command-line boundary: argument wiring, orchestration, and formatting.
+
+Results go to stdout, diagnostics to stderr, and the status is the return value
+(Constitution "Interfaces"). All money is integer cents; formatting is integer
+arithmetic, never float (research D1).
+"""
+
+import argparse
+import sys
+
+from .errors import SplitterError
+from .expenses import read_expenses
+from .settle import Payment, compute_balances, settle
+
+
+def parse_participants(raw: str) -> list[str]:
+    """Split on commas, trim each element, return names in command-line order.
+
+    Order is preserved rather than sorted — sorting happens only where
+    ordering matters (FR-006, FR-011a).
+
+    Rejections are checked in exactly this order (research D9): no names at
+    all, then any empty element, then any duplicate. An empty element is never
+    silently skipped, because the group size determines every share (FR-007,
+    FR-008).
+    """
+    names = [name.strip() for name in raw.split(",")]
+    if not any(names):
+        raise SplitterError("--participants requires at least one participant name")
+    if not all(names):
+        raise SplitterError("--participants contains an empty participant name")
+    seen: set[str] = set()
+    for name in names:
+        if name in seen:
+            raise SplitterError(
+                f"--participants contains duplicate participant name '{name}'"
+            )
+        seen.add(name)
+    return names
+
+
+def format_payment(payment: Payment) -> str:
+    """Render as 'PAYER pays PAYEE AMOUNT' with exactly two decimal places.
+
+    The amount is built by integer arithmetic, so no currency symbol,
+    thousands separator, sign, or float rounding can appear (FR-016,
+    research D1).
+    """
+    cents = payment.amount_cents
+    return (
+        f"{payment.payer} pays {payment.payee} {cents // 100}.{cents % 100:02d}"
+    )
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    """The whole command-line surface: one positional path and --participants.
+
+    argparse's native behaviour *is* FR-020's status 2 for a malformed command
+    line, so there is no exit_on_error=False, no error() override, and no
+    try/except around parse_args (research D8).
+    """
+    parser = argparse.ArgumentParser(
+        prog="splitter",
+        description=(
+            "Split a group's expenses equally and print who pays whom."
+        ),
+    )
+    parser.add_argument(
+        "expenses",
+        metavar="EXPENSES.csv",
+        help="path of the expenses file (payer,amount,description)",
+    )
+    parser.add_argument(
+        "--participants",
+        required=True,
+        metavar="NAMES",
+        help="comma-separated participant names",
+    )
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Entry point. Returns 0 on success; argparse exits 2 itself on misuse.
+
+    Payment lines are written only after the whole pipeline has succeeded, so
+    stdout is structurally untouched on failure (FR-019). `argv` defaults to
+    sys.argv[1:]; tests pass it explicitly to exercise the CLI in process
+    (research D11).
+
+    This is the only place that catches SplitterError and the only place that
+    writes a diagnostic (research D8).
+    """
+    args = _build_parser().parse_args(argv)
+    try:
+        participants = parse_participants(args.participants)
+        expenses = read_expenses(args.expenses, participants)
+        balances = compute_balances(participants, expenses)
+        payments = settle(balances)
+    except SplitterError as exc:
+        print(f"splitter: error: {exc}", file=sys.stderr)
+        return 1
+    for payment in payments:
+        print(format_payment(payment))
+    return 0
