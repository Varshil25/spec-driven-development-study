+"""End-to-end stdout behaviour: format, silence, determinism, read-only guarantee.
+
+Covers FR-016, FR-017, FR-018, FR-021, SC-001, SC-005, SC-008.
+"""
+
+from pathlib import Path
+
+import pytest
+
+from splitter import cli
+
+REFERENCE_FILE = "payer,amount,description\nAlice,30.00,Hotel\n"
+
+
+def _run(capsys, path, participants):
+    """Run the CLI in process and return (exit_status, stdout, stderr)."""
+    status = cli.main([path, "--participants", participants])
+    captured = capsys.readouterr()
+    return status, captured.out, captured.err
+
+
+# --------------------------------------------------------------------------
+# SC-001 / FR-016 — the reference case and the output format
+# --------------------------------------------------------------------------
+
+
+def test_sc001_reference_case_prints_exactly_one_line(write_csv, capsys):
+    """SC-001 / FR-016: the contracts/cli.md reference case."""
+    path = write_csv(REFERENCE_FILE)
+    status, out, err = _run(capsys, path, "Alice,Bob")
+    assert out == "Bob pays Alice 15.00\n"
+    assert status == 0
+    assert err == ""
+
+
+def test_fr016_amount_has_exactly_two_decimal_places(write_csv, capsys):
+    """FR-016: a whole-currency amount still prints two decimals."""
+    path = write_csv("payer,amount,description\nAlice,30,Hotel\n")
+    _, out, _ = _run(capsys, path, "Alice,Bob")
+    assert out == "Bob pays Alice 15.00\n"
+
+
+def test_fr016_single_cent_amount_is_zero_padded(write_csv, capsys):
+    """FR-016: cents below ten are zero-padded, never '3.3'."""
+    path = write_csv("payer,amount,description\nAlice,0.02,Gum\n")
+    _, out, _ = _run(capsys, path, "Alice,Bob")
+    assert out == "Bob pays Alice 0.01\n"
+
+
+def test_fr016_no_thousands_separator_or_currency_symbol(write_csv, capsys):
+    """FR-016: no symbol, no separator, no sign."""
+    path = write_csv("payer,amount,description\nAlice,2000000.00,Villa\n")
+    _, out, _ = _run(capsys, path, "Alice,Bob")
+    assert out == "Bob pays Alice 1000000.00\n"
+    assert "," not in out
+    assert "$" not in out
+    assert "+" not in out
+
+
+def test_fr016_every_line_ends_with_a_newline_including_the_last(write_csv, capsys):
+    """FR-016 / contracts/cli.md: trailing newline on every line."""
+    path = write_csv("payer,amount,description\nAlice,30.00,Hotel\n")
+    _, out, _ = _run(capsys, path, "Alice,Bob,Carol")
+    lines = out.splitlines(keepends=True)
+    assert len(lines) == 2
+    assert all(line.endswith("\n") for line in lines)
+
+
+def test_fr016_line_shape_is_payer_pays_payee_amount(write_csv, capsys):
+    """FR-016: single spaces and the literal word 'pays'."""
+    path = write_csv(REFERENCE_FILE)
+    _, out, _ = _run(capsys, path, "Alice,Bob")
+    payer, pays, payee, amount = out.strip().split(" ")
+    assert (payer, pays, payee, amount) == ("Bob", "pays", "Alice", "15.00")
+
+
+def test_fr016_format_payment_uses_integer_arithmetic():
+    """FR-016 (research D1): formatting never routes through float."""
+    from splitter.settle import Payment
+
+    assert cli.format_payment(Payment("Bob", "Alice", 1)) == "Bob pays Alice 0.01"
+    assert cli.format_payment(Payment("Bob", "Alice", 100)) == "Bob pays Alice 1.00"
+    assert (
+        cli.format_payment(Payment("Bob", "Alice", 123456789))
+        == "Bob pays Alice 1234567.89"
+    )
+
+
+# --------------------------------------------------------------------------
+# FR-017 — silence when there is nothing to settle
+# --------------------------------------------------------------------------
+
+
+def test_fr017_already_settled_prints_nothing(write_csv, capsys):
+    """FR-017 / acceptance 1.3: no output at all, exit 0."""
+    path = write_csv("payer,amount,description\nAlice,10.00,A\nBob,10.00,B\n")
+    status, out, err = _run(capsys, path, "Alice,Bob")
+    assert out == ""
+    assert err == ""
+    assert status == 0
+
+
+def test_fr017_header_only_file_prints_nothing(write_csv, capsys):
+    """FR-017: a header with no data rows is settled by definition."""
+    path = write_csv("payer,amount,description\n")
+    status, out, _ = _run(capsys, path, "Alice,Bob")
+    assert out == ""
+    assert status == 0
+
+
+def test_fr017_group_of_one_prints_nothing(write_csv, capsys):
+    """FR-017 edge case: a group of one owes itself nothing."""
+    path = write_csv("payer,amount,description\nAlice,30.00,Hotel\n")
+    status, out, _ = _run(capsys, path, "Alice")
+    assert out == ""
+    assert status == 0
+
+
+def test_fr017_all_zero_amount_rows_print_nothing(write_csv, capsys):
+    """FR-005 / FR-017: zero amounts leave every balance at zero."""
+    path = write_csv("payer,amount,description\nAlice,0.00,A\nBob,0,B\n")
+    status, out, _ = _run(capsys, path, "Alice,Bob")
+    assert out == ""
+    assert status == 0
+
+
+# --------------------------------------------------------------------------
+# Acceptance 1.4 / 1.5 / 1.6 / 1.7
+# --------------------------------------------------------------------------
+
+
+def test_acceptance_1_4_participant_in_no_row_is_charged_and_pays(write_csv, capsys):
+    """Acceptance 1.4 / FR-011: Carol paid nothing but still owes her share."""
+    path = write_csv("payer,amount,description\nAlice,60.00,Flights\nBob,30.00,Food\n")
+    status, out, _ = _run(capsys, path, "Alice,Bob,Carol")
+    assert status == 0
+    assert "Carol pays " in out
+    amounts = [float(line.rsplit(" ", 1)[1]) for line in out.splitlines()]
+    assert round(sum(amounts), 2) == 30.00
+
+
+def test_acceptance_1_6_zero_amount_row_matches_an_absent_row(write_csv, capsys):
+    """Acceptance 1.6 / FR-005: a 0.00 row changes nothing."""
+    with_zero = write_csv(
+        "payer,amount,description\nAlice,30.00,Hotel\nBob,0.00,Nothing\n", name="a.csv"
+    )
+    _, out_with_zero, _ = _run(capsys, with_zero, "Alice,Bob")
+    without = write_csv("payer,amount,description\nAlice,30.00,Hotel\n", name="b.csv")
+    _, out_without, _ = _run(capsys, without, "Alice,Bob")
+    assert out_with_zero == out_without
+
+
+def test_acceptance_1_5_description_text_is_inert(write_csv, capsys):
+    """Acceptance 1.5 / FR-018: files differing only in description agree."""
+    plain = write_csv("payer,amount,description\nAlice,30.00,Hotel\n", name="a.csv")
+    _, out_plain, _ = _run(capsys, plain, "Alice,Bob")
+    quoted = write_csv(
+        'payer,amount,description\nAlice,30.00,"Hotel, nice"\n', name="b.csv"
+    )
+    _, out_quoted, _ = _run(capsys, quoted, "Alice,Bob")
+    assert out_plain == out_quoted
+
+
+def test_acceptance_1_7_bom_and_non_bom_files_agree(write_csv, capsys):
+    """Acceptance 1.7 / FR-002a: the byte-order mark is invisible."""
+    plain = write_csv(REFERENCE_FILE, name="a.csv")
+    _, out_plain, _ = _run(capsys, plain, "Alice,Bob")
+    with_bom = write_csv(
+        b"\xef\xbb\xbfpayer,amount,description\nAlice,30.00,Hotel\n", name="b.csv"
+    )
+    _, out_bom, _ = _run(capsys, with_bom, "Alice,Bob")
+    assert out_plain == out_bom
+
+
+# --------------------------------------------------------------------------
+# FR-021 / SC-008 — nothing on disk changes
+# --------------------------------------------------------------------------
+
+
+def test_fr021_expenses_file_is_byte_identical_after_a_successful_run(
+    write_csv, capsys, tmp_path
+):
+    """FR-021 / SC-008: the file is opened read-only."""
+    path = write_csv(REFERENCE_FILE)
+    before = Path(path).read_bytes()
+    _run(capsys, path, "Alice,Bob")
+    assert Path(path).read_bytes() == before
+
+
+def test_sc008_no_file_is_created_or_deleted(write_csv, capsys, tmp_path):
+    """SC-008: the tool writes nothing anywhere."""
+    path = write_csv(REFERENCE_FILE)
+    before = sorted(p.name for p in tmp_path.iterdir())
+    _run(capsys, path, "Alice,Bob")
+    assert sorted(p.name for p in tmp_path.iterdir()) == before
+
+
+def test_fr021_expenses_file_is_unchanged_after_a_failed_run(write_csv, capsys):
+    """FR-021 / SC-008: a rejected run also leaves the file alone."""
+    path = write_csv("payer,amount,description\nAlice,abc,X\n")
+    before = Path(path).read_bytes()
+    status, out, err = _run(capsys, path, "Alice,Bob")
+    assert status == 1
+    assert out == ""
+    assert err != ""
+    assert Path(path).read_bytes() == before
+
+
+# --------------------------------------------------------------------------
+# Acceptance 3.1 / 3.3 / SC-005 — the awkward split and determinism (T032)
+# --------------------------------------------------------------------------
+
+
+def test_acceptance_3_1_awkward_split_prints_two_equal_payments(write_csv, capsys):
+    """Acceptance 3.1 / FR-011: 10.00 three ways — Alice absorbs the odd cent."""
+    path = write_csv("payer,amount,description\nAlice,10.00,Taxi\n")
+    status, out, _ = _run(capsys, path, "Alice,Bob,Carol")
+    assert status == 0
+    assert out == "Bob pays Alice 3.33\nCarol pays Alice 3.33\n"
+
+
+def test_acceptance_3_1_awkward_split_amounts_total_six_sixty_six(write_csv, capsys):
+    """Acceptance 3.1 / FR-014: the printed cents sum to 666, i.e. 6.66.
+
+    Under FR-011/FR-011a the leftover cent is charged to Alice (first in
+    ascending code-point name order), raising her share to 334 cents and so
+    lowering her credit to 666. No cent is lost (SC-002).
+    """
+    path = write_csv("payer,amount,description\nAlice,10.00,Taxi\n")
+    _, out, _ = _run(capsys, path, "Alice,Bob,Carol")
+    total_cents = sum(
+        int(line.rsplit(" ", 1)[1].replace(".", "")) for line in out.splitlines()
+    )
+    assert total_cents == 666
+
+
+@pytest.mark.parametrize(
+    "contents",
+    [
+        "payer,amount,description\nAlice,10.00,Taxi\n",
+        "payer,amount,description\nAlice,0.01,A\nBob,0.02,B\n",
+        "payer,amount,description\nAlice,33.33,A\nBob,0.01,B\nCarol,100.00,C\n",
+    ],
+)
+def test_acceptance_3_3_repeated_runs_are_identical(write_csv, capsys, contents):
+    """Acceptance 3.3 / SC-005: identical input, identical output."""
+    path = write_csv(contents)
+    _, first, _ = _run(capsys, path, "Alice,Bob,Carol")
+    _, second, _ = _run(capsys, path, "Alice,Bob,Carol")
+    assert first == second
+
+
+def test_sc005_output_is_byte_identical_across_locales(write_csv, run_subprocess):
+    """SC-005: nothing imports locale, so LC_ALL cannot change the output."""
+    path = write_csv("payer,amount,description\nAlice,60.00,Flights\nBob,30.00,Food\n")
+    args = (path, "--participants", "Alice,Bob,Carol")
+    c_locale = run_subprocess(*args, env={"LC_ALL": "C"})
+    utf8_locale = run_subprocess(*args, env={"LC_ALL": "en_US.UTF-8"})
+    assert c_locale.returncode == 0
+    assert utf8_locale.returncode == 0
+    assert c_locale.stdout == utf8_locale.stdout
+
+
+def test_sc005_non_ascii_names_sort_by_code_point_in_every_locale(
+    write_csv, run_subprocess
+):
+    """SC-005 / FR-011a: no locale collation and no accent folding."""
+    path = write_csv("payer,amount,description\nZoe,9.00,Taxi\n")
+    args = (path, "--participants", "Zoe,Ágnes,alice")
+    # PYTHONIOENCODING is pinned in both runs so the comparison isolates the
+    # effect of LC_ALL on *ordering*, not on the child's stream encoding.
+    c_locale = run_subprocess(
+        *args, env={"LC_ALL": "C", "PYTHONIOENCODING": "utf-8"}
+    )
+    utf8_locale = run_subprocess(
+        *args, env={"LC_ALL": "en_US.UTF-8", "PYTHONIOENCODING": "utf-8"}
+    )
+    assert c_locale.stdout == utf8_locale.stdout
+    assert c_locale.returncode == 0
