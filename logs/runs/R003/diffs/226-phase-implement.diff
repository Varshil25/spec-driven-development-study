+"""Reading and validating the expenses CSV.
+
+All money is integer cents (research D1); amounts are validated by an explicit
+regular expression rather than a permissive numeric parser (research D2).
+"""
+
+import csv
+import re
+from dataclasses import dataclass
+
+from .errors import SplitterError
+
+HEADER: tuple[str, str, str] = ("payer", "amount", "description")
+
+# FR-003, FR-004: digits, optional single decimal point with one or two digits,
+# optional leading '+'. Anchored, so `1e3`, `-5.00`, `1.005`, `$5`, `1,200.00`,
+# `inf`, `nan` and `3 0.00` all fail from this one rule (research D2).
+_AMOUNT_RE = re.compile(r"^\+?\d+(?:\.\d{1,2})?$")
+
+_HEADER_TEXT = ",".join(HEADER)
+
+
+@dataclass(frozen=True)
+class Expense:
+    """One recorded payment, read from one non-blank data row of the expenses file.
+
+    The description column is deliberately not a field: FR-018 makes it
+    computationally inert, so it is read only to satisfy the three-field count
+    check and then discarded.
+    """
+
+    payer: str  # trimmed; a known participant (FR-006)
+    amount_cents: int  # >= 0 (FR-003, FR-005)
+    line: int  # 1-based physical line in the file, for error messages only
+
+
+def parse_amount(value: str, *, path: str, line: int) -> int:
+    """Trim `value`, match the amount grammar, and return whole cents.
+
+    Conversion is pure integer arithmetic — never float, never Decimal
+    (research D1). Raises SplitterError naming path, line, and value if the
+    text does not match (FR-003, FR-004).
+    """
+    text = value.strip()
+    if _AMOUNT_RE.match(text) is None:
+        raise SplitterError(
+            f"{path}:{line}: invalid amount '{value}'; "
+            "expected a non-negative number with at most two decimal places"
+        )
+    whole, _, frac = text.lstrip("+").partition(".")
+    if frac:
+        return int(whole) * 100 + int(frac.ljust(2, "0"))
+    return int(whole) * 100
+
+
+def _is_blank(row: list[str]) -> bool:
+    """A row csv.reader yields as [] or as one field that is empty when stripped.
+
+    A row of `,,` is *not* blank: it is a three-field row with an empty payer,
+    so it belongs in the data-row error path (research D4).
+    """
+    return not row or (len(row) == 1 and not row[0].strip())
+
+
+def read_expenses(path: str, participants: list[str]) -> list[Expense]:
+    """Read and fully validate the expenses file; descriptions are discarded.
+
+    Opens with encoding="utf-8-sig" (a leading byte-order mark is consumed and
+    is otherwise a strict UTF-8 decoder) and newline="" as the csv module
+    requires (research D3, D4). Blank rows are skipped wherever they appear,
+    including before the header. The first non-blank row must equal HEADER
+    exactly. Each data row is validated in order: field count, payer
+    membership, amount. Returns expenses in file order.
+
+    Raises SplitterError for an unreadable path (FR-009), undecodable bytes
+    (FR-002a), a missing or wrong header (FR-002, FR-010), a wrong field count
+    (FR-010), an unknown payer (FR-006), or an invalid amount (FR-003,
+    FR-004). Only the first problem is reported (FR-010a).
+    """
+    rows: list[tuple[int, list[str]]] = []
+    try:
+        with open(path, newline="", encoding="utf-8-sig") as handle:
+            reader = csv.reader(handle)
+            for row in reader:
+                # reader.line_num is the physical line; for a multi-line quoted
+                # record it is the record's last line (FR-010, research D4).
+                rows.append((reader.line_num, row))
+    except OSError as exc:
+        raise SplitterError(
+            f"cannot read expenses file '{path}': {exc.strerror}"
+        ) from exc
+    except UnicodeDecodeError as exc:
+        raise SplitterError(
+            f"cannot decode expenses file '{path}' as UTF-8"
+        ) from exc
+
+    non_blank = [(line, row) for line, row in rows if not _is_blank(row)]
+    if not non_blank:
+        raise SplitterError(
+            f"{path}: missing header row; expected '{_HEADER_TEXT}'"
+        )
+
+    header_line, header_row = non_blank[0]
+    if header_row != list(HEADER):
+        raise SplitterError(
+            f"{path}:{header_line}: header must be exactly '{_HEADER_TEXT}'; "
+            f"found '{','.join(header_row)}'"
+        )
+
+    expenses: list[Expense] = []
+    for line, row in non_blank[1:]:
+        if len(row) != 3:
+            raise SplitterError(f"{path}:{line}: expected 3 fields, found {len(row)}")
+        payer = row[0].strip()
+        if payer not in participants:
+            raise SplitterError(
+                f"{path}:{line}: unknown payer '{payer}'; "
+                "not in the participant list"
+            )
+        amount_cents = parse_amount(row[1], path=path, line=line)
+        expenses.append(Expense(payer, amount_cents, line))
+    return expenses
