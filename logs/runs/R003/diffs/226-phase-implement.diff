+"""SC-006: 1,000 expense rows across 50 participants settle in under two seconds.
+
+Generation is deterministic — payers cycle and amounts are derived from the row
+index in whole cents — so the test cannot flake on its own input.
+"""
+
+import time
+
+from splitter import cli
+
+PARTICIPANT_COUNT = 50
+ROW_COUNT = 1000
+TIME_LIMIT_SECONDS = 2.0
+
+NAMES = [f"P{i:02d}" for i in range(PARTICIPANT_COUNT)]
+
+
+def _big_file(write_csv):
+    """A 1,000-row file whose amounts are exact cents (no float anywhere)."""
+    lines = ["payer,amount,description"]
+    for row in range(ROW_COUNT):
+        payer = NAMES[row % PARTICIPANT_COUNT]
+        cents = 1 + (row * 7919) % 50000  # deterministic spread, 0.01 … 500.00
+        lines.append(f"{payer},{cents // 100}.{cents % 100:02d},item{row}")
+    return write_csv("\n".join(lines) + "\n", name="big.csv")
+
+
+def test_sc006_thousand_rows_fifty_participants_under_two_seconds(write_csv, capsys):
+    """SC-006: the stated scale completes well inside the two-second ceiling."""
+    path = _big_file(write_csv)
+    argv = [path, "--participants", ",".join(NAMES)]
+
+    start = time.perf_counter()
+    status = cli.main(argv)
+    elapsed = time.perf_counter() - start
+
+    out = capsys.readouterr().out
+    assert status == 0
+    assert elapsed < TIME_LIMIT_SECONDS, f"took {elapsed:.3f}s"
+    assert len(out.splitlines()) <= PARTICIPANT_COUNT - 1
+
+
+def test_sc003_large_input_respects_the_payment_count_bound(write_csv, capsys):
+    """SC-003 at scale: at most 49 payment lines for 50 participants."""
+    path = _big_file(write_csv)
+    cli.main([path, "--participants", ",".join(NAMES)])
+    lines = capsys.readouterr().out.splitlines()
+    assert len(lines) <= PARTICIPANT_COUNT - 1
+    assert all(" pays " in line for line in lines)
+
+
+def test_sc002_large_input_conserves_every_cent(write_csv, capsys):
+    """SC-002 at scale: the printed amounts sum to the total imbalance exactly."""
+    from splitter.expenses import read_expenses
+    from splitter.settle import compute_balances, settle
+
+    path = _big_file(write_csv)
+    expenses = read_expenses(path, NAMES)
+    balances = compute_balances(NAMES, expenses)
+    assert sum(balances.values()) == 0
+
+    payments = settle(balances)
+    assert sum(p.amount_cents for p in payments) == sum(
+        value for value in balances.values() if value > 0
+    )
+
+    remaining = dict(balances)
+    for payment in payments:
+        remaining[payment.payer] += payment.amount_cents
+        remaining[payment.payee] -= payment.amount_cents
+    assert all(value == 0 for value in remaining.values())
