+"""Pure settlement functions: shares, balances, greedy settlement.
+
+Covers FR-011, FR-011a, FR-012, FR-013, FR-014, FR-015.
+"""
+
+import pytest
+
+from splitter.expenses import Expense
+from splitter.settle import Payment, compute_balances, compute_shares, settle
+
+
+# --------------------------------------------------------------------------
+# FR-011 / FR-011a — equal shares with the remainder charged by name order
+# --------------------------------------------------------------------------
+
+
+def test_fr011_shares_sum_to_total_exactly():
+    """FR-011: the shares account for every cent of the group total."""
+    shares = compute_shares(["Alice", "Bob", "Carol"], 1000)
+    assert sum(shares.values()) == 1000
+
+
+def test_fr011a_leftover_cent_goes_to_first_name_in_code_point_order():
+    """FR-011a: data-model.md worked example — 10.00 three ways."""
+    assert compute_shares(["Alice", "Bob", "Carol"], 1000) == {
+        "Alice": 334,
+        "Bob": 333,
+        "Carol": 333,
+    }
+
+
+def test_fr011a_share_allocation_ignores_command_line_order():
+    """FR-011a: allocation depends on name order, not argument order."""
+    assert compute_shares(["Carol", "Bob", "Alice"], 1000) == compute_shares(
+        ["Alice", "Bob", "Carol"], 1000
+    )
+
+
+def test_fr011a_two_leftover_cents_go_to_the_first_two_names():
+    """FR-011a: at most one extra cent each, to the earliest names."""
+    assert compute_shares(["Alice", "Bob", "Carol"], 1001) == {
+        "Alice": 334,
+        "Bob": 334,
+        "Carol": 333,
+    }
+
+
+def test_fr011a_ordering_is_code_point_not_case_folded():
+    """FR-011a: 'Bob' < 'alice' by code point; no case folding (FR-006)."""
+    shares = compute_shares(["alice", "Bob"], 101)
+    assert shares == {"Bob": 51, "alice": 50}
+
+
+def test_fr011_group_of_one_is_charged_the_whole_total():
+    """FR-011: with one participant that participant's share is the total."""
+    assert compute_shares(["Alice"], 1000) == {"Alice": 1000}
+
+
+# --------------------------------------------------------------------------
+# FR-012 — net balances
+# --------------------------------------------------------------------------
+
+
+def test_fr012_balance_is_paid_minus_share():
+    """FR-012: data-model.md worked example balances."""
+    expenses = [Expense("Alice", 1000, 2)]
+    assert compute_balances(["Alice", "Bob", "Carol"], expenses) == {
+        "Alice": 666,
+        "Bob": -333,
+        "Carol": -333,
+    }
+
+
+def test_fr012_participant_in_no_expense_row_is_included_with_paid_zero():
+    """FR-012 / acceptance 1.4: Carol paid nothing but still owes a share."""
+    balances = compute_balances(["Alice", "Bob", "Carol"], [Expense("Alice", 900, 2)])
+    assert set(balances) == {"Alice", "Bob", "Carol"}
+    assert balances["Bob"] == -300
+    assert balances["Carol"] == -300
+
+
+def test_fr012_balances_sum_to_zero_exactly():
+    """FR-012: the postcondition sum(balances) == 0."""
+    expenses = [Expense("Alice", 6000, 2), Expense("Bob", 3000, 3)]
+    balances = compute_balances(["Alice", "Bob", "Carol"], expenses)
+    assert sum(balances.values()) == 0
+
+
+def test_fr012_multiple_rows_for_one_payer_are_summed():
+    """FR-012: a participant's paid total is the sum of their rows."""
+    expenses = [Expense("Alice", 500, 2), Expense("Alice", 500, 3)]
+    balances = compute_balances(["Alice", "Bob"], expenses)
+    assert balances == {"Alice": 500, "Bob": -500}
+
+
+def test_fr012_group_of_one_has_zero_balance():
+    """FR-012 edge case: a group of one is always settled."""
+    assert compute_balances(["Alice"], [Expense("Alice", 1234, 2)]) == {"Alice": 0}
+
+
+# --------------------------------------------------------------------------
+# FR-013 / FR-014 / FR-015 — the greedy settlement
+# --------------------------------------------------------------------------
+
+
+def test_fr015_worked_example_payments_and_their_order():
+    """FR-015: data-model.md worked example, in generation order."""
+    balances = {"Alice": 666, "Bob": -333, "Carol": -333}
+    assert settle(balances) == [
+        Payment("Bob", "Alice", 333),
+        Payment("Carol", "Alice", 333),
+    ]
+
+
+def test_fr015_debtor_tie_is_broken_in_ascending_name_order():
+    """FR-015: equal debts settle in ascending code-point name order."""
+    payments = settle({"Zoe": 1000, "Bob": -500, "Carol": -500})
+    assert [p.payer for p in payments] == ["Bob", "Carol"]
+
+
+def test_fr015_creditor_tie_is_broken_in_ascending_name_order():
+    """FR-015: equal credits are paid in ascending code-point name order."""
+    payments = settle({"Alice": 500, "Bob": 500, "Zoe": -1000})
+    assert [p.payee for p in payments] == ["Alice", "Bob"]
+
+
+def test_fr015_largest_debt_is_matched_against_largest_credit():
+    """FR-015: the greedy pairing is re-selected each step."""
+    payments = settle({"Alice": 700, "Bob": 300, "Carol": -400, "Dave": -600})
+    assert payments[0] == Payment("Dave", "Alice", 600)
+
+
+def test_fr015_identical_input_gives_identical_output():
+    """FR-015: the settlement is fully determined by the balance map."""
+    balances = {"Alice": 666, "Bob": -333, "Carol": -333}
+    assert settle(dict(balances)) == settle(dict(balances))
+
+
+def test_fr013_no_payment_is_below_one_cent():
+    """FR-013: a 0.00 payment line can never be generated."""
+    payments = settle({"Alice": 1, "Bob": -1})
+    assert all(p.amount_cents >= 1 for p in payments)
+
+
+def test_fr013_payment_count_is_at_most_participants_minus_one():
+    """FR-013 / SC-003: the minimal-ish bound on the number of transfers."""
+    balances = {"Alice": 700, "Bob": 300, "Carol": -400, "Dave": -600}
+    assert len(settle(balances)) <= len(balances) - 1
+
+
+def test_fr013_settled_balances_produce_no_payments():
+    """FR-017 / FR-013: nothing to do when every balance is zero."""
+    assert settle({"Alice": 0, "Bob": 0}) == []
+
+
+def test_fr014_payments_sum_to_the_total_imbalance():
+    """FR-014: the printed amounts equal the sum of the positive balances."""
+    balances = {"Alice": 700, "Bob": 300, "Carol": -400, "Dave": -600}
+    payments = settle(balances)
+    assert sum(p.amount_cents for p in payments) == 1000
+
+
+def test_fr015_settle_does_not_mutate_its_argument():
+    """FR-015: settle is a pure function (contracts/python-api.md)."""
+    balances = {"Alice": 666, "Bob": -333, "Carol": -333}
+    settle(balances)
+    assert balances == {"Alice": 666, "Bob": -333, "Carol": -333}
+
+
+def test_fr013_payer_owed_and_payee_was_owed():
+    """FR-013: payer had a negative balance, payee a positive one."""
+    balances = {"Alice": 700, "Bob": 300, "Carol": -400, "Dave": -600}
+    for payment in settle(balances):
+        assert balances[payment.payer] < 0
+        assert balances[payment.payee] > 0
+
+
+# --------------------------------------------------------------------------
+# SC-002 / SC-003 — conservation invariants over a sweep of inputs (T031)
+# --------------------------------------------------------------------------
+
+SWEEP_TOTALS = [0, 1, 2, 99, 100, 101, 999, 1000, 1001, 123457]
+SWEEP_COUNTS = [1, 2, 3, 4, 5, 6, 7]
+
+
+def _names(count):
+    """Participant names whose code-point order is not the obvious one."""
+    return [f"P{i}" for i in range(count)]
+
+
+@pytest.mark.parametrize("total_cents", SWEEP_TOTALS)
+@pytest.mark.parametrize("count", SWEEP_COUNTS)
+def test_sc002_shares_always_sum_to_the_total(total_cents, count):
+    """SC-002: shares sum to the total in 100% of cases."""
+    shares = compute_shares(_names(count), total_cents)
+    assert sum(shares.values()) == total_cents
+    assert len(shares) == count
+
+
+@pytest.mark.parametrize("total_cents", SWEEP_TOTALS)
+@pytest.mark.parametrize("count", SWEEP_COUNTS)
+def test_sc002_balances_always_sum_to_zero(total_cents, count):
+    """SC-002 / FR-012: balances sum to exactly zero in 100% of cases."""
+    names = _names(count)
+    expenses = [Expense(names[0], total_cents, 2)] if total_cents else []
+    balances = compute_balances(names, expenses)
+    assert sum(balances.values()) == 0
+
+
+@pytest.mark.parametrize("total_cents", SWEEP_TOTALS)
+@pytest.mark.parametrize("count", SWEEP_COUNTS)
+def test_sc002_applying_every_payment_zeroes_all_balances(total_cents, count):
+    """SC-002: the settlement leaves every balance at exactly zero."""
+    names = _names(count)
+    expenses = [Expense(names[0], total_cents, 2)] if total_cents else []
+    balances = compute_balances(names, expenses)
+    remaining = dict(balances)
+    for payment in settle(balances):
+        remaining[payment.payer] += payment.amount_cents
+        remaining[payment.payee] -= payment.amount_cents
+    assert all(value == 0 for value in remaining.values())
+
+
+@pytest.mark.parametrize("total_cents", SWEEP_TOTALS)
+@pytest.mark.parametrize("count", SWEEP_COUNTS)
+def test_sc003_payment_count_bound_and_minimum_amount(total_cents, count):
+    """SC-003: at most n-1 payments, every one at least one cent."""
+    names = _names(count)
+    expenses = [Expense(names[0], total_cents, 2)] if total_cents else []
+    balances = compute_balances(names, expenses)
+    payments = settle(balances)
+    assert len(payments) <= len(names) - 1
+    assert all(p.amount_cents >= 1 for p in payments)
+
+
+@pytest.mark.parametrize("total_cents", SWEEP_TOTALS)
+@pytest.mark.parametrize("count", SWEEP_COUNTS)
+def test_fr014_payments_equal_positive_balances_over_the_sweep(total_cents, count):
+    """FR-014: conservation holds for every total and group size."""
+    names = _names(count)
+    expenses = [Expense(names[0], total_cents, 2)] if total_cents else []
+    balances = compute_balances(names, expenses)
+    payments = settle(balances)
+    assert sum(p.amount_cents for p in payments) == sum(
+        value for value in balances.values() if value > 0
+    )
+
+
+@pytest.mark.parametrize("count", SWEEP_COUNTS)
+def test_sc002_zero_total_settles_with_no_payments(count):
+    """SC-002: a zero total leaves nothing to transfer (loop terminates)."""
+    names = _names(count)
+    balances = compute_balances(names, [])
+    assert settle(balances) == []
+
+
+def test_sc003_group_of_one_terminates_with_no_payments():
+    """SC-003: a group of one has balance 0, so no payment is generated."""
+    balances = compute_balances(["Alice"], [Expense("Alice", 1000, 2)])
+    assert balances == {"Alice": 0}
+    assert settle(balances) == []
+
+
+@pytest.mark.parametrize("total_cents", SWEEP_TOTALS)
+@pytest.mark.parametrize("count", SWEEP_COUNTS)
+def test_sc005_settlement_is_deterministic_over_the_sweep(total_cents, count):
+    """SC-005 / FR-015: identical input always yields identical output."""
+    names = _names(count)
+    expenses = [Expense(names[0], total_cents, 2)] if total_cents else []
+    balances = compute_balances(names, expenses)
+    assert settle(dict(balances)) == settle(dict(balances))