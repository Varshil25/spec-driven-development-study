@@ -0,0 +1,410 @@
+"""One test per row of the contracts/cli.md exit-1 message catalogue.
+
+Each asserts the exact message on stderr, empty stdout, and exit status 1 —
+Constitution III requires every error path to pin both message and status.
+Covers FR-002, FR-002a, FR-003, FR-004, FR-006, FR-007, FR-008, FR-009,
+FR-010, FR-010a, FR-019, SC-004, SC-007.
+"""
+
+import pytest
+
+from splitter import cli
+
+OK_FILE = "payer,amount,description\nAlice,30.00,Hotel\n"
+PARTICIPANTS = "Alice,Bob"
+AMOUNT_TAIL = "expected a non-negative number with at most two decimal places"
+HEADER_TEXT = "payer,amount,description"
+
+
+def expect_error(capsys, argv, message):
+    """Run the CLI and assert the one-message / empty-stdout / exit-1 contract."""
+    status = cli.main(argv)
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"splitter: error: {message}\n"
+    assert status == 1
+
+
+# --------------------------------------------------------------------------
+# FR-007 — the participant list must yield at least one name
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("raw", ["", "   ", ",", " , "])
+def test_fr007_empty_participant_list(write_csv, capsys, raw):
+    """FR-007: no name at all is an error (SC-004 case: empty participant list)."""
+    path = write_csv(OK_FILE)
+    expect_error(
+        capsys,
+        [path, "--participants", raw],
+        "--participants requires at least one participant name",
+    )
+
+
+@pytest.mark.parametrize("raw", ["Alice,,Bob", "Alice,Bob,", ",Alice,Bob", "Alice, ,Bob"])
+def test_fr007_empty_participant_name(write_csv, capsys, raw):
+    """FR-007: an empty element is never silently skipped (SC-004 case)."""
+    path = write_csv(OK_FILE)
+    expect_error(
+        capsys,
+        [path, "--participants", raw],
+        "--participants contains an empty participant name",
+    )
+
+
+# --------------------------------------------------------------------------
+# FR-008 — no duplicate participant
+# --------------------------------------------------------------------------
+
+
+def test_fr008_duplicate_participant_name(write_csv, capsys):
+    """FR-008: the same name twice is an error (SC-004 case: duplicate)."""
+    path = write_csv(OK_FILE)
+    expect_error(
+        capsys,
+        [path, "--participants", "Alice,Alice"],
+        "--participants contains duplicate participant name 'Alice'",
+    )
+
+
+def test_fr008_duplicate_is_detected_after_trimming(write_csv, capsys):
+    """FR-008 / FR-006: ' Alice ' and 'Alice' are the same person."""
+    path = write_csv(OK_FILE)
+    expect_error(
+        capsys,
+        [path, "--participants", "Alice,Bob, Alice "],
+        "--participants contains duplicate participant name 'Alice'",
+    )
+
+
+def test_fr008_names_differing_only_in_case_are_not_duplicates(write_csv, capsys):
+    """FR-006: 'alice' and 'Alice' are two people, so this is accepted."""
+    path = write_csv(OK_FILE)
+    assert cli.main([path, "--participants", "Alice,alice"]) == 0
+
+
+def test_fr010a_duplicate_is_reported_without_opening_the_file(tmp_path, capsys):
+    """FR-010a / acceptance 2.8: the list is checked before the file is touched."""
+    missing = str(tmp_path / "does-not-exist.csv")
+    expect_error(
+        capsys,
+        [missing, "--participants", "Alice,Alice"],
+        "--participants contains duplicate participant name 'Alice'",
+    )
+
+
+# --------------------------------------------------------------------------
+# FR-009 — the file must be readable
+# --------------------------------------------------------------------------
+
+
+def test_fr009_missing_file(tmp_path, capsys):
+    """FR-009: an unreadable path names the path and the reason (SC-004 case)."""
+    missing = str(tmp_path / "does-not-exist.csv")
+    expect_error(
+        capsys,
+        [missing, "--participants", PARTICIPANTS],
+        f"cannot read expenses file '{missing}': No such file or directory",
+    )
+
+
+def test_fr009_directory_instead_of_a_file(tmp_path, capsys):
+    """FR-009: any OSError from open becomes one clear message."""
+    directory = str(tmp_path)
+    expect_error(
+        capsys,
+        [directory, "--participants", PARTICIPANTS],
+        f"cannot read expenses file '{directory}': Is a directory",
+    )
+
+
+# --------------------------------------------------------------------------
+# FR-002a — the file must be UTF-8
+# --------------------------------------------------------------------------
+
+
+def test_fr002a_undecodable_bytes(write_csv, capsys):
+    """FR-002a: invalid UTF-8 is an error, never replaced (SC-004 case)."""
+    path = write_csv(b"payer,amount,description\nAlice,5.00,\xff\xfe\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"cannot decode expenses file '{path}' as UTF-8",
+    )
+
+
+# --------------------------------------------------------------------------
+# FR-002 / FR-010 — the header
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("contents", ["", "\n", "\n   \n\n"])
+def test_fr002_missing_header_row(write_csv, capsys, contents):
+    """FR-002 / FR-010: an empty or all-blank file has no header."""
+    path = write_csv(contents)
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}: missing header row; expected '{HEADER_TEXT}'",
+    )
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "Payer,Amount,Description",
+        "amount,payer,description",
+        "payer,amount,description,date",
+        "payer,amount",
+    ],
+)
+def test_fr002_wrong_header(write_csv, capsys, header):
+    """FR-002 / FR-010: exact comparison; the message echoes the user's row."""
+    path = write_csv(f"{header}\nAlice,30.00,Hotel\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:1: header must be exactly '{HEADER_TEXT}'; found '{header}'",
+    )
+
+
+def test_fr010_wrong_header_line_number_skips_blank_rows(write_csv, capsys):
+    """FR-010: the reported line is where the header actually is."""
+    path = write_csv("\n\nPayer,Amount,Description\nAlice,30.00,Hotel\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:3: header must be exactly '{HEADER_TEXT}'; "
+        "found 'Payer,Amount,Description'",
+    )
+
+
+# --------------------------------------------------------------------------
+# FR-010 — field count
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("row", "count"),
+    [("Alice,5.00", 2), ("Alice", 1), ("Alice,5.00,X,extra", 4)],
+)
+def test_fr010_wrong_field_count(write_csv, capsys, row, count):
+    """FR-010: a data row has exactly three fields (SC-004 case: row length)."""
+    path = write_csv(f"{HEADER_TEXT}\n{row}\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:2: expected 3 fields, found {count}",
+    )
+
+
+# --------------------------------------------------------------------------
+# FR-006 — unknown payer
+# --------------------------------------------------------------------------
+
+
+def test_fr006_unknown_payer(write_csv, capsys):
+    """FR-006: a payer outside the list names the row and the value (SC-004)."""
+    path = write_csv(f"{HEADER_TEXT}\nDave,5.00,X\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:2: unknown payer 'Dave'; not in the participant list",
+    )
+
+
+def test_fr006_unknown_payer_is_case_sensitive(write_csv, capsys):
+    """FR-006: 'alice' is not the participant 'Alice'."""
+    path = write_csv(f"{HEADER_TEXT}\nalice,5.00,X\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:2: unknown payer 'alice'; not in the participant list",
+    )
+
+
+def test_fr006_empty_payer_from_a_two_comma_row(write_csv, capsys):
+    """Research D4: ',,' is a three-field row whose payer is empty."""
+    path = write_csv(f"{HEADER_TEXT}\n,,\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:2: unknown payer ''; not in the participant list",
+    )
+
+
+# --------------------------------------------------------------------------
+# FR-003 / FR-004 — the amount grammar, rejecting side
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("field", "shown"),
+    [
+        ("abc", "abc"),
+        ("", ""),
+        ("-5.00", "-5.00"),
+        ("1.005", "1.005"),
+        ("$5", "$5"),
+        ('"1,200.00"', "1,200.00"),
+        ("1e3", "1e3"),
+        ("inf", "inf"),
+        ("nan", "nan"),
+        ("3 0.00", "3 0.00"),
+        ("30.", "30."),
+        (".30", ".30"),
+        ("--5", "--5"),
+        ("++5", "++5"),
+        ("5+", "5+"),
+        ("0x10", "0x10"),
+        ("1_000", "1_000"),
+        ("5.0.0", "5.0.0"),
+    ],
+)
+def test_fr004_invalid_amount(write_csv, capsys, field, shown):
+    """FR-003 / FR-004: every rejection names the row and the value (SC-007)."""
+    path = write_csv(f"{HEADER_TEXT}\nAlice,{field},X\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:2: invalid amount '{shown}'; {AMOUNT_TAIL}",
+    )
+
+
+def test_fr004_negative_amount(write_csv, capsys):
+    """FR-004: a negative amount is rejected (SC-004 case: negative)."""
+    path = write_csv(f"{HEADER_TEXT}\nAlice,-5.00,X\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:2: invalid amount '-5.00'; {AMOUNT_TAIL}",
+    )
+
+
+def test_fr004_over_precise_amount(write_csv, capsys):
+    """FR-004: three decimal places is rejected (SC-004 case: over-precise)."""
+    path = write_csv(f"{HEADER_TEXT}\nAlice,1.005,X\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:2: invalid amount '1.005'; {AMOUNT_TAIL}",
+    )
+
+
+def test_fr010_invalid_amount_reports_the_right_line(write_csv, capsys):
+    """FR-010 / SC-007: the line number points at the offending row."""
+    path = write_csv(f"{HEADER_TEXT}\nAlice,1.00,A\nBob,2.00,B\nAlice,abc,C\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:4: invalid amount 'abc'; {AMOUNT_TAIL}",
+    )
+
+
+# --------------------------------------------------------------------------
+# FR-010a — only the first problem is reported
+# --------------------------------------------------------------------------
+
+
+def test_fr010a_earlier_row_wins_over_a_later_one(write_csv, capsys):
+    """FR-010a / acceptance 2.8: bad amount on line 3 hides line 5's bad payer."""
+    path = write_csv(
+        f"{HEADER_TEXT}\nAlice,1.00,A\nAlice,abc,B\nBob,2.00,C\nDave,3.00,D\n"
+    )
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:3: invalid amount 'abc'; {AMOUNT_TAIL}",
+    )
+
+
+def test_fr010a_bad_header_hides_every_row_problem(write_csv, capsys):
+    """FR-010a: the header is checked before any data row."""
+    path = write_csv("Payer,Amount,Description\nDave,abc,X\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:1: header must be exactly '{HEADER_TEXT}'; "
+        "found 'Payer,Amount,Description'",
+    )
+
+
+def test_fr010a_participant_list_is_checked_before_the_header(write_csv, capsys):
+    """FR-010a / research D9: the command-line value is level 2, the header level 4."""
+    path = write_csv("Payer,Amount,Description\nAlice,5.00,X\n")
+    expect_error(
+        capsys,
+        [path, "--participants", "Alice,,Bob"],
+        "--participants contains an empty participant name",
+    )
+
+
+def test_fr010a_field_count_is_checked_before_the_payer(write_csv, capsys):
+    """FR-010a / research D9: within a row, field count precedes the payer."""
+    path = write_csv(f"{HEADER_TEXT}\nDave,5.00\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:2: expected 3 fields, found 2",
+    )
+
+
+def test_fr010a_payer_is_checked_before_the_amount(write_csv, capsys):
+    """FR-010a / research D9: within a row, the payer precedes the amount."""
+    path = write_csv(f"{HEADER_TEXT}\nDave,abc,X\n")
+    expect_error(
+        capsys,
+        [path, "--participants", PARTICIPANTS],
+        f"{path}:2: unknown payer 'Dave'; not in the participant list",
+    )
+
+
+def test_fr019_only_one_message_is_ever_written(write_csv, capsys):
+    """FR-019: exactly one line on stderr, nothing on stdout."""
+    path = write_csv(f"{HEADER_TEXT}\nAlice,abc,A\nDave,xyz,B\n")
+    cli.main([path, "--participants", PARTICIPANTS])
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert len(captured.err.splitlines()) == 1
+
+
+# --------------------------------------------------------------------------
+# SC-004 — all eleven named malformed cases, counted
+# --------------------------------------------------------------------------
+
+SC004_CASES = {
+    "missing file": ("MISSING", PARTICIPANTS),
+    "unreadable encoding": (b"payer,amount,description\nAlice,5.00,\xff\xfe\n", PARTICIPANTS),
+    "unknown payer": (f"{HEADER_TEXT}\nDave,5.00,X\n", PARTICIPANTS),
+    "non-numeric amount": (f"{HEADER_TEXT}\nAlice,abc,X\n", PARTICIPANTS),
+    "negative amount": (f"{HEADER_TEXT}\nAlice,-5.00,X\n", PARTICIPANTS),
+    "over-precise amount": (f"{HEADER_TEXT}\nAlice,1.005,X\n", PARTICIPANTS),
+    "empty participant list": (OK_FILE, ""),
+    "empty participant name": (OK_FILE, "Alice,,Bob"),
+    "duplicate participant": (OK_FILE, "Alice,Alice"),
+    "bad header": ("Payer,Amount,Description\nAlice,5.00,X\n", PARTICIPANTS),
+    "bad row length": (f"{HEADER_TEXT}\nAlice,5.00\n", PARTICIPANTS),
+}
+
+
+@pytest.mark.parametrize("case", sorted(SC004_CASES))
+def test_sc004_every_named_malformed_case_fails_loudly(
+    write_csv, capsys, tmp_path, case
+):
+    """SC-004: 11 of 11 cases give one stderr message, empty stdout, status != 0."""
+    contents, participants = SC004_CASES[case]
+    if contents == "MISSING":
+        path = str(tmp_path / "does-not-exist.csv")
+    else:
+        path = write_csv(contents)
+    status = cli.main([path, "--participants", participants])
+    captured = capsys.readouterr()
+    assert status != 0, case
+    assert captured.out == "", case
+    assert captured.err.startswith("splitter: error: "), case
+    assert len(captured.err.strip()) > len("splitter: error: "), case
+
+
+def test_sc004_case_count_is_eleven():
+    """SC-004: the specification names exactly eleven malformed-input cases."""
+    assert len(SC004_CASES) == 11
