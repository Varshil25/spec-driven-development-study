+"""Shared test fixtures: a temp-CSV writer and a subprocess runner (research D11)."""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC_DIR = REPO_ROOT / "src"
+
+
+@pytest.fixture
+def write_csv(tmp_path):
+    """Write `content` to a temp file and return its path as a str.
+
+    `content` may be `str` (encoded with `encoding`, default UTF-8) or `bytes`
+    (written verbatim), so tests can produce a byte-order mark or invalid UTF-8.
+    """
+
+    def _write(content, *, encoding="utf-8", name="expenses.csv"):
+        path = tmp_path / name
+        if isinstance(content, bytes):
+            path.write_bytes(content)
+        else:
+            # newline="" so the bytes on disk are exactly what the test wrote.
+            with open(path, "w", encoding=encoding, newline="") as fh:
+                fh.write(content)
+        return str(path)
+
+    return _write
+
+
+@pytest.fixture
+def run_subprocess():
+    """Run `python -m splitter *args` in a child process, returning CompletedProcess.
+
+    PYTHONPATH points at the repository-root `src` directory so the published
+    invocation works with no install step. `env` entries are overlaid on the
+    current environment (used for the cross-locale determinism check, SC-005).
+    """
+
+    def _run(*args, env=None):
+        child_env = dict(os.environ)
+        child_env["PYTHONPATH"] = str(SRC_DIR)
+        if env:
+            child_env.update(env)
+        return subprocess.run(
+            [sys.executable, "-m", "splitter", *args],
+            capture_output=True,
+            text=True,
+            env=child_env,
+        )
+
+    return _run
