+"""Reading and validating the expenses file — the accepting cases.
+
+Covers FR-002, FR-002a, FR-003, FR-005, FR-006, FR-010. The exact rejection
+messages are asserted in tests/test_cli_errors.py (FR-019).
+"""
+
+import pytest
+
+from splitter.errors import SplitterError
+from splitter.expenses import HEADER, Expense, parse_amount, read_expenses
+
+PARTICIPANTS = ["Alice", "Bob"]
+
+
+def _parse(value):
+    return parse_amount(value, path="expenses.csv", line=2)
+
+
+# --------------------------------------------------------------------------
+# FR-003 / FR-005 — the amount grammar, accepting side
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("value", "expected_cents"),
+    [
+        ("30", 3000),
+        ("30.5", 3050),
+        ("30.00", 3000),
+        ("0", 0),
+        ("0.00", 0),
+        ("+30", 3000),
+    ],
+)
+def test_fr003_accepted_amount_forms_and_their_cent_values(value, expected_cents):
+    """FR-003: every accepted form from contracts/cli.md, in exact cents."""
+    assert _parse(value) == expected_cents
+
+
+@pytest.mark.parametrize(
+    ("value", "expected_cents"),
+    [
+        ("30.1", 3010),
+        ("30.05", 3005),
+        ("1200.00", 120000),
+        ("+0.01", 1),
+        ("0.5", 50),
+    ],
+)
+def test_fr003_one_and_two_decimal_places_both_scale_to_cents(value, expected_cents):
+    """FR-003: one decimal place means tenths, not hundredths."""
+    assert _parse(value) == expected_cents
+
+
+@pytest.mark.parametrize("value", [" 30.00 ", "\t30.00", "30.00\n", "  +30  "])
+def test_fr003_surrounding_whitespace_is_ignored(value):
+    """FR-003 (research D2): surrounding whitespace is stripped before matching."""
+    assert _parse(value) == 3000
+
+
+def test_fr005_zero_amount_is_accepted():
+    """FR-005: an amount of exactly zero is valid."""
+    assert _parse("0.00") == 0
+
+
+def test_fr003_amount_result_is_an_int_not_a_float():
+    """FR-003 (research D1): money is integer cents end to end."""
+    assert isinstance(_parse("30.5"), int)
+
+
+def test_fr003_large_amount_keeps_exact_cents():
+    """FR-003: integer arithmetic means no precision loss at any size."""
