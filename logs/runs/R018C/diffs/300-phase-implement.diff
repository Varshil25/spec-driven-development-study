+def test_fr019_the_new_module_imports_only_the_standard_library():
+    """FR-019, constitution Principle I: no third-party runtime dependency anywhere in the
+    package, the new `importer.py` included.
+
+    The pre-existing `tests/test_cli_contract.py` already checks this across the package
+    and so covers the new module automatically — which is also why the shipped renderer
+    spells FR-014's four substitutions out instead of importing `html`: that test pins the
+    import surface to an exact set, and FR-020/SC-006 require it to pass unmodified.
+    Restated here under this feature's own requirement number."""
+    package = pathlib.Path(__file__).resolve().parent.parent / "src" / "bookmarks"
+    modules = sorted(package.glob("*.py"))
+    assert [module.name for module in modules] == [
+        "__init__.py",
+        "__main__.py",
+        "cli.py",
+        "importer.py",
+        "store.py",
+    ]
+
+    for module in modules:
+        for node in ast.walk(ast.parse(module.read_text(encoding="utf-8"))):
+            if isinstance(node, ast.Import):
+                found = {alias.name.split(".")[0] for alias in node.names}
+            elif isinstance(node, ast.ImportFrom) and not node.level:
+                found = {node.module.split(".")[0]}
+            else:
+                continue
+            assert found <= set(sys.stdlib_module_names), f"{module.name}: {found}"
+            assert "pytest" not in found
