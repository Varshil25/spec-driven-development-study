+def schema_of(path):
+    """The store's own description of its structure, straight from SQLite."""
+    connection = sqlite3.connect(path)
+    try:
+        return sorted(
+            connection.execute(
+                "SELECT type, name, sql FROM sqlite_master ORDER BY type, name"
+            )
+        )
+    finally:
+        connection.close()
+
+
+def test_fr016_importing_does_not_change_the_stored_structure(
+    run_cli, tmp_path, seed
+):
+    """FR-016: no migration, no new table, no new column — a store an import wrote is
+    structurally identical to one `add` wrote, so a store written by the previous version
+    is used as-is."""
+    added = tmp_path / "added.db"
+    through_import = tmp_path / "imported.db"
+
+    seed(added, [("https://a.example.com", "A", "x")])
+    path = csv_file(tmp_path, "id,url,title,tags\n1,https://a.example.com,A,x\n")
+    assert imported(run_cli, through_import, path, "csv") == "imported 1\n"
+
+    assert schema_of(through_import) == schema_of(added)
+    tables = {name for kind, name, _ in schema_of(through_import) if kind == "table"}
+    assert tables == {"bookmarks", "tags", "sqlite_sequence"}
+
