@@ -0,0 +1,237 @@
+"""Reading an import file: the two file shapes, their parsers and record validation
+(FR-006 … FR-011).
+
+This module **opens no database**. That is the point of it: the whole file is read, parsed
+and validated here, and only then does :func:`cli.handle_import` open the store. Since
+opening the store is what creates the store file, that ordering is the single source of
+four separate guarantees — nothing is added on a failure, no store file is created where
+none existed, no identifier is advanced, and a file problem is never reported as a store
+problem (FR-011, FR-017, research R-105, R-109).
+
+Every failure here raises ``store.BookmarkError`` with status 2 and a message naming the
+file, what was invalid and what was expected, as FR-010 and constitution Principle II
+require. No new exception type is introduced: ``BookmarkError`` carries its status as data,
+so ``cli.main``'s single existing handler renders these with no new error path.
+
+Named ``importer.py`` rather than ``import.py``, which is a reserved word (research R-109).
+
+Standard library only (FR-019, constitution Principle I).
+"""
+
+import csv
+import json
+
+from . import store
+
+CSV_HEADER = ["id", "url", "title", "tags"]
+JSON_REQUIRED_KEYS = ("url", "title", "tags")
+JSON_ALLOWED_KEYS = frozenset({"id", "url", "title", "tags"})
+
+# Reported in diagnostics as the JSON type names a user of the file would recognise, not
+# as Python class names (`str` would be a puzzle for someone reading a JSON file).
+_JSON_TYPE_NAMES = {
+    dict: "an object",
+    list: "an array",
+    str: "a string",
+    bool: "a boolean",
+    int: "a number",
+    float: "a number",
+    type(None): "null",
+}
+
+
+def _json_type_name(value):
+    return _JSON_TYPE_NAMES.get(type(value), "an unexpected value")
+
+
+def _read_text(path):
+    """Return the whole file as text (FR-009, FR-010, research R-101).
+
+    ``encoding="utf-8-sig"`` does UTF-8 decoding and the single-leading-byte-order-mark
+    rule in one step. ``newline=""`` suppresses newline translation, which is what keeps a
+    line break inside a quoted CSV field part of that field and lets ``csv.reader`` handle
+    ``\\n`` and ``\\r\\n`` itself.
+
+    No ``errors=`` parameter is passed, deliberately: an undecodable byte must raise rather
+    than quietly become U+FFFD, which would be the silent wrong answer constitution
+    Principle II ranks worst. ``FileNotFoundError``, ``IsADirectoryError`` and
+    ``PermissionError`` are all ``OSError`` subclasses, so absent, a directory and
+    access-denied need one clause between them.
+    """
+    try:
+        with open(path, encoding="utf-8-sig", newline="") as handle:
+            return handle.read()
+    except UnicodeDecodeError as exc:
+        raise store.BookmarkError(
+            f"cannot read {path}: it is not valid UTF-8 ({exc})", 2
+        ) from exc
+    except OSError as exc:
+        raise store.BookmarkError(f"cannot read {path}: {exc}", 2) from exc
+
+
+def _chunks(text):
+    """Split ``text`` on ``\\n`` alone, keeping each terminator, for ``csv.reader``.
+
+    Split on ``\\n`` and nothing else, deliberately. ``str.splitlines`` would also split on
+    form feed, vertical tab, U+0085 and U+2028, which are ordinary characters inside a CSV
+    field and not record terminators. ``\\r\\n`` needs no special handling: the chunk ends
+    ``…\\r\\n`` and ``csv.reader`` strips both, so both terminators of FR-006 work from one
+    rule. A line break inside a *quoted* field also needs none — the reader stays inside the
+    quotes and concatenates the next chunk onto the same field, terminator included, which
+    is what keeps the embedded break part of the value.
+
+    An ``io.StringIO`` would do the same job, at the cost of a second import; the project's
+    import surface is pinned (FR-019, constitution Principle I).
+    """
+    lines = text.split("\n")
+    chunks = [line + "\n" for line in lines[:-1]]
+    # A text ending in "\n" leaves "" last: that is the final record's terminator, not a
+    # blank record, and must not become a chunk (FR-006a).
+    if lines[-1]:
+        chunks.append(lines[-1])
+    return chunks
+
+
+def _parse_csv(path, text):
+    """Parse the CSV shape into import records (FR-004, FR-006, FR-006a, research R-102).
+
+    The default dialect, because the writer side (``cli.render_csv``) uses the defaults —
+    a reader configured differently would make the round trip of SC-001 not a round trip.
+
+    ``csv.DictReader`` is deliberately **not** used: it would silently absorb a wrong
+    header and pad or discard a wrong field count, turning two of FR-010's failure causes
+    into quiet data corruption.
+
+    Field 0 (``id``) is parsed and discarded unvalidated — any value, numeric or not, is
+    accepted and ignored, because it is not used (FR-004).
+    """
+    reader = csv.reader(_chunks(text))
+
+    header = next(reader, None)
+    if header != CSV_HEADER:
+        if header is None:
+            found = "nothing (the file holds no records)"
+        elif not header:
+            found = "a blank record"
+        else:
+            found = ",".join(header)
+        raise store.BookmarkError(
+            f"{path}: expected the header record {','.join(CSV_HEADER)} but found {found}",
+            2,
+        )
+
+    records = []
+    # Line numbers come from the reader, so a record spanning several physical lines
+    # inside a quoted field is still reported at the line the record ends on.
+    for record in reader:
+        if len(record) != len(CSV_HEADER):
+            raise store.BookmarkError(
+                f"{path} line {reader.line_num}: expected "
+                f"{len(CSV_HEADER)} fields ({','.join(CSV_HEADER)}) but found {len(record)}",
+                2,
+            )
+        records.append({"url": record[1], "title": record[2], "tags": record[3]})
+    return records
+
+
+def _parse_json(path, text):
+    """Parse the JSON shape into import records (FR-004, FR-007, research R-103, R-104).
+
+    Validated by hand, in a fixed order, with a message per cause: the top level is an
+    array, each element is an object, the required keys are all present, no key outside the
+    allowed set appears, ``url`` and ``title`` are strings, ``tags`` is an array of
+    strings. A missing key is reported as missing and **never** defaulted to empty, and an
+    unrecognised key is a shape error rather than silently dropped data (spec Assumptions).
+
+    No schema-validation layer is built for this: six explicit checks with six specific
+    messages is both smaller and more informative than a generic validator
+    (research R-103, constitution Principle IV).
+
+    ``tags`` is joined with ``,`` so the value reaches ``store.normalise_tags`` in exactly
+    the form an ``add --tags`` value does — one normaliser, not two (research R-104).
+    """
+    try:
+        payload = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise store.BookmarkError(f"{path} is not valid JSON: {exc}", 2) from exc
+
+    if not isinstance(payload, list):
+        raise store.BookmarkError(
+            f"{path}: expected a JSON array of bookmark objects but found "
+            f"{_json_type_name(payload)}",
+            2,
+        )
+
+    records = []
+    for index, element in enumerate(payload, start=1):
+        where = f"{path} record {index}"
+        if not isinstance(element, dict):
+            raise store.BookmarkError(
+                f"{where}: expected a JSON object but found {_json_type_name(element)}", 2
+            )
+
+        for key in JSON_REQUIRED_KEYS:
+            if key not in element:
+                raise store.BookmarkError(f"{where}: missing the required key {key!r}", 2)
+        for key in element:
+            if key not in JSON_ALLOWED_KEYS:
+                raise store.BookmarkError(
+                    f"{where}: unrecognised key {key!r} "
+                    f"(expected only {', '.join(CSV_HEADER)})",
+                    2,
+                )
+
+        for key in ("url", "title"):
+            if not isinstance(element[key], str):
+                raise store.BookmarkError(
+                    f"{where}: expected {key!r} to be a string but found "
+                    f"{_json_type_name(element[key])}",
+                    2,
+                )
+
+        tags = element["tags"]
+        if not isinstance(tags, list) or not all(isinstance(tag, str) for tag in tags):
+            found = (
+                "an array holding a value that is not a string"
+                if isinstance(tags, list)
+                else _json_type_name(tags)
+            )
+            raise store.BookmarkError(
+                f"{where}: expected 'tags' to be an array of strings but found {found}", 2
+            )
+
+        records.append(
+            {"url": element["url"], "title": element["title"], "tags": ",".join(tags)}
+        )
+    return records
+
+
+_PARSERS = {"csv": _parse_csv, "json": _parse_json}
+
+
+def read_records(path, shape):
+    """Read ``path`` in the declared ``shape`` and return its import records in file order
+    (FR-005, FR-008, FR-009, FR-010, FR-011).
+
+    Each record is a ``{"url", "title", "tags"}`` dict, ``tags`` comma-joined. The declared
+    ``shape`` **alone** selects the parser: the file's name, extension and contents are
+    never consulted, and there is no fallback to the other shape when the declared one does
+    not parse (FR-008).
+
+    The three steps of the data-model's validation order — read, parse, then check **every**
+    address against the scheme rule — all happen here, which is what leaves the caller
+    nothing to do before opening the store. The scheme check in particular has to be on
+    this side of ``open_store``: it is the one failure cause that is a record's content
+    rather than the file's shape, and opening the store is what creates the store file, so
+    checking it afterwards would leave a store file behind for a file that imported nothing
+    (FR-011). ``store.add_bookmarks`` checks the addresses again, so that its own
+    all-or-nothing guarantee holds for any caller; the repeat costs one string comparison
+    per record and makes neither function depend on the other's diligence.
+
+    Opens no database.
+    """
+    records = _PARSERS[shape](path, _read_text(path))
+    for record in records:
+        # The existing diagnostic from `001:FR-007`, reused unchanged (FR-003).
+        store.check_url(record["url"])
+    return records
