+    page yields exactly one `<a>` per bookmark, in identifier order, each `href` equal to
+    the stored address and each element's text equal to the stored title. This checks the
+    escaping is correct, not merely stable."""
+    seed(db, SC004_STORE)
+
+    parser = Links()
+    parser.feed(page(run_cli, db))
+    parser.close()
+
+    assert [tuple(link) for link in parser.links] == [
+        (url, title) for url, title, _ in SC004_STORE
+    ]
