+    seeded here through the same `store.py` path the previous version used."""
+    seed(db, [("https://old.example.com", "Old", "old")])
+    path = csv_file(tmp_path, "id,url,title,tags\n1,https://new.example.com,New,new\n")
+    assert imported(run_cli, db, path, "csv") == "imported 1\n"
+    assert listing(run_cli, db) == (
+        "1\thttps://old.example.com\tOld\told\n2\thttps://new.example.com\tNew\tnew\n"
+    )
