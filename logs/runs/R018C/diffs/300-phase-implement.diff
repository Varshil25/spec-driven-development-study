+closed and the page is therefore fully determined by the collection — exactly the property
+the CSV and JSON exports already have. One test (SC-004) parses the page on top of that,
+to check the escaping is *correct* rather than merely stable (research R-110).
+"""
+
+import html
+from html.parser import HTMLParser
+
+import pytest
+
+from bookmarks import cli
+
+OPENING = (
+    "<!DOCTYPE html>\n"
+    "<html>\n"
+    '<head><meta charset="utf-8"><title>Bookmarks</title></head>\n'
+    "<body>\n"
+    "<ul>\n"
+)
+CLOSING = "</ul>\n</body>\n</html>\n"
+
+
+def page(run_cli, db, text=True):
+    result = run_cli("--db", db, "export", "--format", "html", text=text)
+    assert result.returncode == 0, result.stderr
+    assert result.stderr == (b"" if not text else "")
+    return result.stdout
+
+
+def li(url, title, tags):
+    return f'<li><a href="{url}">{title}</a> <small>{tags}</small></li>\n'
+
+
+# The contract's worked-example store.
+CONTRACT_STORE = [
+    ("https://docs.python.org", "Python docs", "python,docs"),
+    ("https://example.com", "", None),
+]
+
+
+@pytest.fixture
+def contract_store(db, seed):
+    seed(db, CONTRACT_STORE)
+    return db
+
+
+# --------------------------------------------------------------------------- FR-012
+
+
+def test_fr012_the_page_matches_the_contract_worked_example_byte_for_byte(
+    run_cli, contract_store
+):
