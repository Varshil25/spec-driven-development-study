+# ------------------------------------------------- User Story 3: SC-001 round trip
+
+# The awkward values of the spec's Acceptance Scenarios: a comma, a quotation mark, an
+# embedded line break, non-English characters, several labels, none at all, and an address
+# that is already stored.
+AWKWARD = [
+    ("https://docs.python.org", "Python docs", "python,docs"),
+    ("https://a.example.com", "Comma, in the title", "one,two,three"),
+    ("https://b.example.com", 'He said "hi", then left', ""),
+    ("https://c.example.com", "Broken\nover two lines", "multi"),
+    ("https://café.example.com", "Café — ünïcode", "café,naïve"),
+    ("https://d.example.com", "", None),
+    ("https://docs.python.org", "The same address again", "python"),
+]
+
+
+@pytest.mark.parametrize("shape", ["csv", "json"])
+def test_sc001_a_collection_round_trips_through_either_shape_unchanged(
+    run_cli, db, seed, tmp_path, shape
+):
+    """SC-001, FR-003 … FR-007: export on one machine, import on another. The second
+    store's listing is identical to the first's — proving identifiers renumber from 1 while
+    every address, title and label survives the trip, commas, quotation marks, embedded
+    line breaks and non-English characters included."""
+    seed(db, AWKWARD)
+    original = listing(run_cli, db)
+
+    exported = run_cli("--db", db, "export", "--format", shape)
+    assert exported.returncode == 0
