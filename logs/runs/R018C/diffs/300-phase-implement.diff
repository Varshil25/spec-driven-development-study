+"""`import FILE --format csv|json`: FR-001 … FR-011, plus FR-017's status split and the
+User Story 3 round trip (SC-001, SC-002).
+
+Every test is driven through the real-subprocess ``run_cli`` fixture, because the exit
+statuses of FR-010 and FR-017 are *process* statuses that an in-process call to
+``cli.main`` cannot evidence — ``main`` returns a status rather than exiting (research
+R-110). Import files are written with pytest's ``tmp_path`` and always as explicit bytes,
+so the file under test is byte-for-byte what the test says it is.
+"""
+
+import ast
+import json
+import pathlib
+import re
+import sqlite3
+import sys
+
+import pytest
+
+# --------------------------------------------------------------------------- helpers
+
+
+def write(path, text, encoding="utf-8"):
+    """Write ``text`` as exact bytes — no newline translation, no added terminator."""
+    path.write_bytes(text.encode(encoding))
+    return path
+
+
+def write_bytes(path, raw):
+    path.write_bytes(raw)
+    return path
+
+
+CSV_TWO = (
+    "id,url,title,tags\n"
+    '1,https://docs.python.org,Python docs,"docs,python"\n'
+    "2,https://example.com,,\n"
+)
+
+JSON_TWO = (
+    "[\n"
+    '  {"id": 1, "url": "https://docs.python.org", "title": "Python docs",'
+    ' "tags": ["docs", "python"]},\n'
+    '  {"id": 2, "url": "https://example.com", "title": "", "tags": []}\n'
+    "]\n"
+)
+
+
+def csv_file(tmp_path, text, name="in.csv"):
+    return write(tmp_path / name, text)
+
+
+def json_file(tmp_path, payload, name="in.json"):
+    text = payload if isinstance(payload, str) else json.dumps(payload)
+    return write(tmp_path / name, text)
+
+
+def imported(run_cli, db, path, shape):
+    """Run a successful import and return its stdout."""
+    result = run_cli("--db", db, "import", path, "--format", shape)
+    assert result.returncode == 0, result.stderr
+    assert result.stderr == ""
+    return result.stdout
+
+
+def listing(run_cli, db):
+    result = run_cli("--db", db, "list")
+    assert result.returncode == 0, result.stderr
+    return result.stdout
+
+
+def records(text):
+    """Split a `list` output into its four-field records.
+
+    Not simply ``splitlines``: a title holding a line break makes its record span more than
+    one physical line, which the pre-existing tab-separated listing accepts as-is (spec
+    Edge Cases). A record starts where a line begins with an identifier and a tab.
+    """
+    lines = text.split("\n")
+    assert lines[-1] == "", "a list output ends with exactly one newline, or is empty"
+    found = []
+    for line in lines[:-1]:
+        if re.match(r"^\d+\t", line):
+            found.append(line)
+        else:
+            found[-1] += "\n" + line
+    return [record.split("\t") for record in found]
+
+
+# --------------------------------------------------------------------------- FR-001
+
+
+def test_fr001_import_without_a_file_exits_2_with_argparse_usage(run_cli, db):
+    """FR-001: FILE is required — argparse's own diagnostic, empty stdout, status 2."""
+    result = run_cli("--db", db, "import")
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr != ""
+    assert "usage" in result.stderr.lower()
