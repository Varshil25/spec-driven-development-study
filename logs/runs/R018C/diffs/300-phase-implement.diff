+"""The two performance budgets of `002`: SC-005.
+
+A **new** file rather than an edit to ``tests/test_performance.py``, which FR-020 and
+SC-006 require to pass unmodified — quickstart.md Scenario 6 checks that mechanically with
+``git status --short tests/``. The timing pattern is the existing one: a
+``time.perf_counter()`` bracket around a real ``run_cli`` subprocess, with the exit status
+asserted first so a budget can never be met by failing fast.
+"""
+
+import csv
+import time
+
+import pytest
+
+COUNT = 1000
+IMPORT_BUDGET_SECONDS = 5.0
+EXPORT_BUDGET_SECONDS = 1.0
+
+
+def timed(run_cli, *args):
+    start = time.perf_counter()
+    result = run_cli(*args)
+    elapsed = time.perf_counter() - start
+    assert result.returncode == 0, result.stderr
+    return result, elapsed
+
+
+@pytest.fixture
+def big_csv(tmp_path):
+    """A 1,000-record file in exactly the shape ``export --format csv`` writes."""
+    path = tmp_path / "big.csv"
+    with open(path, "w", encoding="utf-8", newline="") as handle:
+        writer = csv.writer(handle, lineterminator="\n")
+        writer.writerow(["id", "url", "title", "tags"])
+        for index in range(COUNT):
+            writer.writerow(
+                [
+                    index + 1,
+                    f"https://example.com/page/{index}",
+                    f"Page {index}",
+                    f"tag{index % 10},common",
+                ]
+            )
+    return path
+
+
+# --------------------------------------------------------------------------- SC-005
+
+
+def test_sc005_importing_1000_bookmarks_completes_in_under_five_seconds(
+    run_cli, db, big_csv
+):
+    """SC-005: one commit for the whole import, not one per bookmark (research R-106)."""
+    result, elapsed = timed(run_cli, "--db", db, "import", big_csv, "--format", "csv")
+    assert result.stdout == f"imported {COUNT}\n"
+    assert elapsed < IMPORT_BUDGET_SECONDS, f"import took {elapsed:.3f}s"
+
+
+def test_sc005_html_export_of_1000_bookmarks_returns_in_under_a_second(
+    run_cli, db, seed_many
+):
+    """SC-005: the page reuses the existing single-query read path, so it costs what the
+    CSV and JSON exports already cost."""
+    assert len(seed_many(db, COUNT)) == COUNT
+    result, elapsed = timed(run_cli, "--db", db, "export", "--format", "html")
+    assert result.stdout.count("<li>") == COUNT
+    assert elapsed < EXPORT_BUDGET_SECONDS, f"html export took {elapsed:.3f}s"