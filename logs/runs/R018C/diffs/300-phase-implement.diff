+# --------------------------------------------------------------------------- FR-010
+
+
+def damaged(tmp_path, kind):
+    """Build one of the damage kinds SC-003 enumerates. Returns (path, shape)."""
+    if kind == "absent-file":
+        return tmp_path / "missing.csv", "csv"
+    if kind == "a-directory":
+        directory = tmp_path / "adir"
+        directory.mkdir()
+        return directory, "csv"
+    if kind == "zero-byte-file":
+        return write(tmp_path / "empty.csv", ""), "csv"
+    if kind == "wrong-header-record":
+        return write(tmp_path / "wrong.csv", "name,link\n1,https://a.example.com\n"), "csv"
+    if kind == "wrong-field-count":
+        return (
+            write(tmp_path / "short.csv", "id,url,title,tags\n1,https://a.example.com,A\n"),
+            "csv",
+        )
+    if kind == "blank-line":
+        return (
+            write(
+                tmp_path / "blank.csv",
+                "id,url,title,tags\n1,https://a.example.com,A,\n\n",
+            ),
+            "csv",
+        )
+    if kind == "not-valid-utf8":
+        return write_bytes(tmp_path / "bytes.csv", b"\xff\xfe\x00bad"), "csv"
+    if kind == "malformed-json-text":
+        return write(tmp_path / "broken.json", '[{"url":}'), "json"
+    if kind == "top-level-not-a-list":
+        return write(tmp_path / "one.json", '{"url": "https://a.example.com"}'), "json"
+    if kind == "element-not-an-object":
+        return write(tmp_path / "strings.json", '["https://a.example.com"]'), "json"
+    if kind == "record-missing-a-key":
+        return (
+            write(tmp_path / "gap.json", '[{"url": "https://a.example.com", "title": "A"}]'),
+            "json",
+        )
+    if kind == "unrecognised-key":
+        return (
+            write(
+                tmp_path / "extra.json",
+                '[{"url": "https://a.example.com", "title": "A", "tags": [], "note": "n"}]',
+            ),
+            "json",
+        )
+    if kind == "tags-not-an-array-of-strings":
+        return (
+            write(
+                tmp_path / "tags.json",
+                '[{"url": "https://a.example.com", "title": "A", "tags": "x"}]',
+            ),
+            "json",
+        )
+    if kind == "address-fails-the-scheme-rule":
+        return (
+            write(
+                tmp_path / "scheme.csv",
+                "id,url,title,tags\n1,ftp://x.example.com,A,\n",
+            ),
+            "csv",
+        )
+    raise AssertionError(f"unknown damage kind {kind!r}")
+
+
+FILE_AT_FAULT = {
+    "absent-file",
+    "a-directory",
+    "zero-byte-file",
+    "wrong-header-record",
+    "wrong-field-count",
+    "blank-line",
+    "not-valid-utf8",
+    "malformed-json-text",
+    "top-level-not-a-list",
+    "element-not-an-object",
+    "record-missing-a-key",
+    "unrecognised-key",
+    "tags-not-an-array-of-strings",
+}
+
+DAMAGE_KINDS = sorted(FILE_AT_FAULT) + ["address-fails-the-scheme-rule"]
+
+
+@pytest.mark.parametrize("kind", DAMAGE_KINDS)
+def test_fr010_every_damaged_file_gives_stderr_empty_stdout_and_status_2(
+    run_cli, db, tmp_path, kind
+):
+    """FR-010, SC-003: the same triple for every damage kind — status 2, exactly nothing
+    on stdout, and a non-empty stderr naming the file (where a file is at fault) together
+    with what was invalid and what was expected."""
+    path, shape = damaged(tmp_path, kind)
+    result = run_cli("--db", db, "import", path, "--format", shape)
+
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr != ""
+    assert result.stderr.startswith("bookmarks: ")
+    if kind in FILE_AT_FAULT:
+        assert path.name in result.stderr, result.stderr
+    else:
+        # The scheme rule names the offending address and what was expected instead.
+        assert "ftp://x.example.com" in result.stderr
+        assert "http://" in result.stderr and "https://" in result.stderr
+
