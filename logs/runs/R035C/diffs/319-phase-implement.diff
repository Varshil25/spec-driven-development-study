+def test_create_fr_026_order_is_independent_of_scandir_order(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-026 / SC-012: the order ``os.scandir`` reports entries is irrelevant.
+
+    The whole subtree is collected before it is sorted, so reversing every directory listing
+    must not change a single member position. Sorting *during* the walk, or using
+    ``os.walk`` with ``dirnames.sort()``, would fail this.
+    """
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, SAMPLE)
+    run_cli("create", "forward.tar", "d", "photos")
+
+    real_scandir = os.scandir
+
+    class ReversedListing:
+        """Iterable *and* a context manager, so the fake fits either calling style."""
+
+        def __init__(self, entries):
+            self._entries = entries
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *exc_info):
+            return False
+
+        def __iter__(self):
+            return iter(self._entries)
+
+    def reversed_scandir(path="."):
+        with real_scandir(path) as entries:
+            listing = sorted(entries, key=lambda entry: entry.name, reverse=True)
+        return ReversedListing(listing)
+
+    # A nested context so that undoing the scandir patch does not also undo the chdir.
+    with monkeypatch.context() as patched:
+        patched.setattr(os, "scandir", reversed_scandir)
+        status, out, err = run_cli("create", "reversed.tar", "d", "photos")
+
+    assert status == 0, err
+    assert member_names("reversed.tar") == member_names("forward.tar")
+
