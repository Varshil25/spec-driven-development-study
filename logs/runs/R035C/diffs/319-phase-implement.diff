+"""User Story 4: everything that worked before still works, and the round trip closes.
+
+Covers CREATE-FR-009, CREATE-FR-023 and CREATE-FR-024, plus SC-001, SC-002, SC-003 and SC-008.
+
+The interesting asymmetry this module pins down: ``create`` selects compression from the
+archive's **name** (CREATE-FR-005) while ``list`` and ``extract`` detect it from the archive's
+**content** (``001-tarx-cli`` FR-004). The two never conflict, because the name is load-bearing
+only at creation time -- so a plain archive called ``PHOTOS.TAR.GZ`` still reads fine.
+"""
+
+from create_support import DIR, build_tree, is_gzip, member_names, work_in
+
+#: A tree with depth, an empty directory, a zero-length file and binary content -- everything
+#: the round trip has to carry without loss.
+TREE = {
+    "src/notes.txt": "hello\nworld\n",
+    "src/photos/a.jpg": b"\x00\xff\x01\xfe" * 300,
+    "src/photos/b.jpg": b"B",
+    "src/deep/a/b/c.txt": "nested",
+    "src/deep/empty": DIR,
+    "src/zero.dat": b"",
+}
+
+
+# ======================================================================================
+# T044 -- the round trip (CREATE-FR-009, SC-001, SC-002, SC-003, SC-008)
+# ======================================================================================
+
+
+def _roundtrip(run_cli, snapshot_tree, archive):
+    """``create`` -> ``list`` -> ``extract``, returning the three results plus both snapshots."""
+    created = run_cli("create", archive, "src")
+    listed = run_cli("list", archive)
+    extracted = run_cli("extract", archive, "dest")
+    return created, listed, extracted, snapshot_tree("src"), snapshot_tree("dest/src")
+
+
+def test_create_fr_009_plain_archives_round_trip_without_loss(
+    run_cli, tmp_path, monkeypatch, snapshot_tree
+):
+    """CREATE-FR-009 / SC-001 / SC-002 / SC-008: a plain archive is listed and extracted with
+    status 0, and the extracted tree is identical to the source in both relative paths and bytes.
+    """
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, TREE)
+
+    created, listed, extracted, source, restored = _roundtrip(run_cli, snapshot_tree, "out.tar")
+
+    assert created == (0, "created out.tar with 5 files\n", "")
+    assert listed[0] == 0 and listed[2] == ""
+    assert extracted == (0, "extracted 5 files\n", "")
+    assert not is_gzip("out.tar")
+    assert restored == source
+
+
+def test_create_fr_009_gzip_archives_round_trip_without_loss(
+    run_cli, tmp_path, monkeypatch, snapshot_tree
+):
+    """CREATE-FR-009 / SC-001 / SC-002 / SC-008: the same, for a gzip-compressed archive."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, TREE)
+
+    created, listed, extracted, source, restored = _roundtrip(
+        run_cli, snapshot_tree, "out.tar.gz"
+    )
+
+    assert created == (0, "created out.tar.gz with 5 files\n", "")
+    assert listed[0] == 0 and listed[2] == ""
+    assert extracted == (0, "extracted 5 files\n", "")
+    assert is_gzip("out.tar.gz")
+    assert restored == source
+
+
+def test_create_fr_009_list_prints_every_member_with_no_trailing_slashes(
+    run_cli, tmp_path, monkeypatch
+):
+    """CREATE-FR-009 / CREATE-FR-004: ``list`` prints the stored names one per line, and no
+    stripping is needed because ``create`` never stores a trailing ``/``."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, TREE)
+    run_cli("create", "out.tar", "src")
+
+    status, out, err = run_cli("list", "out.tar")
+
+    assert (status, err) == (0, "")
+    printed = out.splitlines()
+    assert printed == member_names("out.tar")
+    assert not any(name.endswith("/") for name in printed)
+    assert printed == [
+        "src",
+        "src/deep",
+        "src/deep/a",
+        "src/deep/a/b",
+        "src/deep/a/b/c.txt",
+        "src/deep/empty",
+        "src/notes.txt",
+        "src/photos",
+        "src/photos/a.jpg",
+        "src/photos/b.jpg",
+        "src/zero.dat",
+    ]
+
+
+def test_create_fr_009_the_extracted_count_equals_the_created_count(
+    run_cli, tmp_path, monkeypatch
+):
+    """SC-003: the number ``create`` reports is the number ``extract`` reports back."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, TREE)
+
+    created = run_cli("create", "out.tar", "src")
+    extracted = run_cli("extract", "out.tar", "dest")
+
+    assert created[1] == "created out.tar with 5 files\n"
+    assert extracted[1] == "extracted 5 files\n"
+
+
+def test_create_fr_009_hard_linked_names_survive_the_round_trip(
+    run_cli, tmp_path, monkeypatch
+):
+    """CREATE-FR-009 / CREATE-FR-015: both names of a hard-linked file extract to full content.
+
+    This is the end-to-end consequence of not using ``TarFile.add()``: with ``add()`` the second
+    name would be a zero-byte ``LNKTYPE`` member, which ``extract`` skips -- so this file would
+    silently come back missing (research.md section 4).
+    """
+    import os
+
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"hl/one.txt": "data"})
+    os.link(tmp_path / "hl" / "one.txt", tmp_path / "hl" / "two.txt")
+
+    created = run_cli("create", "hl.tar", "hl")
+    extracted = run_cli("extract", "hl.tar", "out")
+
+    assert created == (0, "created hl.tar with 2 files\n", "")
+    assert extracted == (0, "extracted 2 files\n", "")
+    assert (tmp_path / "out" / "hl" / "one.txt").read_bytes() == b"data"
+    assert (tmp_path / "out" / "hl" / "two.txt").read_bytes() == b"data"
+
+
+# ======================================================================================
+# T045 -- compression interop, including the deliberate name/content mismatches
+# ======================================================================================
+
+
+def test_create_fr_009_a_gzip_archive_named_tgz_reads_fine(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-009: ``.tgz`` produces gzip and both reading commands accept it, because they
+    detect compression from content rather than from the name."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"src/a.txt": "a"})
+
+    created = run_cli("create", "notes.tgz", "src")
+    listed = run_cli("list", "notes.tgz")
+    extracted = run_cli("extract", "notes.tgz", "dest")
+
+    assert created == (0, "created notes.tgz with 1 files\n", "")
+    assert is_gzip("notes.tgz")
+    assert listed == (0, "src\nsrc/a.txt\n", "")
+    assert extracted == (0, "extracted 1 files\n", "")
+
+
+def test_create_fr_009_a_plain_archive_with_a_gzip_name_reads_fine(
+    run_cli, tmp_path, monkeypatch
+):
+    """CREATE-FR-009 / CREATE-FR-005: ``PHOTOS.TAR.GZ`` gets a **plain** archive, because the
+    suffix match is case-sensitive -- and ``list``/``extract`` read it anyway, because they never
+    consult the name. The two rules coexist instead of conflicting."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"src/a.txt": "a"})
+
+    created = run_cli("create", "PHOTOS.TAR.GZ", "src")
+    listed = run_cli("list", "PHOTOS.TAR.GZ")
+    extracted = run_cli("extract", "PHOTOS.TAR.GZ", "dest")
+
+    assert created == (0, "created PHOTOS.TAR.GZ with 1 files\n", "")
+    assert not is_gzip("PHOTOS.TAR.GZ")
+    assert listed == (0, "src\nsrc/a.txt\n", "")
+    assert extracted == (0, "extracted 1 files\n", "")
+
+
+def test_create_fr_009_every_created_archive_is_accepted_with_empty_stderr(
+    run_cli, tmp_path, monkeypatch
+):
+    """SC-008: every archive ``create`` writes is accepted by ``list`` and ``extract`` with
+    status 0 and nothing on stderr, across every compression-relevant name form."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"src/a.txt": "a", "src/sub": DIR})
+
+    for index, name in enumerate(["a.tar", "b.tar.gz", "c.tgz", "d", "E.TAR.GZ"]):
+        assert run_cli("create", name, "src")[0] == 0
+        assert run_cli("list", name) == (0, "src\nsrc/a.txt\nsrc/sub\n", "")
+        assert run_cli("extract", name, "dest{0}".format(index)) == (0, "extracted 1 files\n", "")
+
+
+def test_create_fr_009_an_empty_directory_only_archive_round_trips(
+    run_cli, tmp_path, monkeypatch
+):
+    """CREATE-FR-009 / CREATE-FR-007: a zero-file archive is a valid archive on both sides."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"src/empty": DIR})
+
+    created = run_cli("create", "out.tar", "src")
+    listed = run_cli("list", "out.tar")
+    extracted = run_cli("extract", "out.tar", "dest")
+
+    assert created == (0, "created out.tar with 0 files\n", "")
+    assert listed == (0, "src\nsrc/empty\n", "")
+    assert extracted == (0, "extracted 0 files\n", "")
+    assert (tmp_path / "dest" / "src" / "empty").is_dir()
+
+
+# ======================================================================================
+# T046 -- discoverability (CREATE-FR-024)
+# ======================================================================================
+
+
+def test_create_fr_024_top_level_help_names_the_whole_interface(run_module):
+    """CREATE-FR-024: the top-level usage names all three commands, their operands and
+    ``--overwrite``, on **stdout**, exiting **0**."""
+    result = run_module("--help")
+
+    assert result.returncode == 0
+    assert result.stderr == ""
+    for token in ("list", "extract", "create", "ARCHIVE", "DEST", "PATH", "--overwrite"):
+        assert token in result.stdout, "missing {0!r} from top-level usage".format(token)
+
+
+def test_create_fr_024_create_help_names_its_operands_and_option(run_module):
+    """CREATE-FR-024: ``create --help`` names ``ARCHIVE``, ``PATH`` and ``--overwrite``, on
+    stdout, exiting 0."""
+    result = run_module("create", "--help")
+
+    assert result.returncode == 0
+    assert result.stderr == ""
+    for token in ("ARCHIVE", "PATH", "--overwrite"):
+        assert token in result.stdout, "missing {0!r} from create usage".format(token)
+
+
+def test_create_fr_024_help_is_available_for_every_command(run_module):
+    """CREATE-FR-024: adding ``create`` did not disturb the other two commands' own help."""
+    for command, operands in (("list", ["ARCHIVE"]), ("extract", ["ARCHIVE", "DEST"])):
+        result = run_module(command, "--help")
+        assert result.returncode == 0
+        assert result.stderr == ""
+        for token in operands:
+            assert token in result.stdout
+
+
+# ======================================================================================
+# T047 -- behaviour preservation (CREATE-FR-023)
+# ======================================================================================
+
+
+def test_create_fr_023_list_keeps_its_operands_output_and_status(run_cli, make_archive):
+    """CREATE-FR-023: ``list`` prints the same lines, in the same order, with the same status."""
+    archive = make_archive(
+        [("b.txt", "file", "b"), ("dir/", "dir", None), ("a.txt", "file", "a")]
+    )
+
+    status, out, err = run_cli("list", archive)
+
+    assert (status, err) == (0, "")
+    assert out == "b.txt\ndir\na.txt\n"
+
+
+def test_create_fr_023_extract_keeps_its_operands_output_and_status(
+    run_cli, make_archive, tmp_path
+):
+    """CREATE-FR-023: ``extract`` keeps ``ARCHIVE DEST [--overwrite]``, its summary line and its
+    status."""
+    archive = make_archive([("a.txt", "file", "a"), ("d/b.txt", "file", "b")])
+
+    status, out, err = run_cli("extract", archive, tmp_path / "dest")
+
+    assert (status, out, err) == (0, "extracted 2 files\n", "")
+    assert (tmp_path / "dest" / "a.txt").read_text() == "a"
+
+
+def test_create_fr_023_extract_still_skips_hard_link_members_unchanged(
+    run_cli, make_archive, tmp_path
+):
+    """CREATE-FR-023: ``extract``'s treatment of ``LNKTYPE`` members is untouched by this
+    feature -- it still skips them with the same notice and the same status.
+
+    ``create`` never *writes* a ``LNKTYPE`` member (CREATE-FR-015), but archives from elsewhere
+    contain them and ``extract``'s behaviour for those is shipped behaviour.
+    """
+    archive = make_archive(
+        [("a.txt", "file", "a"), ("link.txt", "hardlink", "a.txt")]
+    )
+
+    status, out, err = run_cli("extract", archive, tmp_path / "dest")
+
+    assert status == 0
+    assert out == "extracted 1 files\n"
+    assert err == "tarx: skipping non-regular member 'link.txt' (hard link)\n"
+
+
+def test_create_fr_023_extract_keeps_its_diagnostics_and_statuses(
+    run_cli, make_archive, tmp_path
+):
+    """CREATE-FR-023: the pre-existing diagnostics and exit statuses are unchanged -- the refused
+    overwrite is still D10 with status 3, and an unopenable archive is still D1 with status 2."""
+    archive = make_archive([("a.txt", "file", "new")])
+    dest = tmp_path / "dest"
+    dest.mkdir()
+    (dest / "a.txt").write_text("old")
+
+    refused = run_cli("extract", archive, dest)
+    missing = run_cli("list", tmp_path / "nosuch.tar")
+
+    assert refused[0] == 3
+    assert refused[1] == ""
+    assert "refusing to overwrite existing file" in refused[2]
+    assert missing[0] == 2
+    assert "cannot open archive" in missing[2]
+    assert (dest / "a.txt").read_text() == "old"
+
+
+def test_create_fr_023_a_third_subcommand_changed_no_observable_output(run_module, make_archive):
+    """CREATE-FR-023: the only new thing a caller can see from ``list`` and ``extract`` is
+    nothing at all -- adding a subcommand changed neither stream."""
+    archive = make_archive([("a.txt", "file", "a")])
+
+    listed = run_module("list", archive)
+
+    assert listed.returncode == 0
+    assert listed.stdout == "a.txt\n"
+    assert listed.stderr == ""
