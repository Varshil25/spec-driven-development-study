+    # the file at ARCHIVE until this whole function has returned an empty problem list, so a run
+    # that fails for an unrelated reason leaves the previous archive intact (FR-011).
+    archive_problem = _check_archive_path(archive, overwrite)
+    if archive_problem is not None:
+        archive_problems.append(archive_problem)
+
+    for given in paths:
+        operand_problem = _check_operand(given)
+        if operand_problem is not None:
+            operand_problems.append(operand_problem)
+            continue
+        read_problems.extend(_plan_operand(given, archive_abs, plan, seen))
+
+    return plan, archive_problems + operand_problems + read_problems
+
+
+# --------------------------------------------------------------------------------------
+# create: write phase, entered only when validation found nothing (FR-016)
+# --------------------------------------------------------------------------------------
+
+
+def _member_info(member):
+    """A hand-built ``TarInfo`` for one planned member.
+
+    Built by hand rather than with ``TarFile.gettarinfo()``/``TarFile.add()`` because ``add()``
+    keeps an inode cache and stores the *second* name of a hard-linked file as a zero-byte
+    ``LNKTYPE`` member, which FR-015 forbids and which ``extract`` would silently skip -- a
+    silent wrong answer (measured, research.md section 4). ``add()`` would also append a
+    trailing ``/`` to directory names, contradicting FR-004.
+
+    Permissions and the modification time are recorded because a tar header has fields for them;
+    ``extract`` deliberately does not restore either (spec Assumptions).
+    """
+    source = os.lstat(member.path)
+    info = tarfile.TarInfo(member.name)
+    info.mode = stat.S_IMODE(source.st_mode)
+    info.mtime = int(source.st_mtime)
+    if member.kind == KIND_DIR:
+        info.type = tarfile.DIRTYPE
+        info.size = 0
+    else:
+        info.type = tarfile.REGTYPE
+        info.size = source.st_size
+    return info
+
+
+def write_archive(archive, plan):
+    """Write every planned member in plan order and return ``N``, the regular-file count.
+
+    Entered only when validation found no problem, so this call is the first write of the whole
+    run and the exact moment the archive comes into existence (FR-016).
+
+    Compression comes from :func:`_archive_mode`, i.e. from the archive's name (FR-005). Each
+    regular file is streamed by handing its open file object to ``addfile``, which copies through
+    ``tarfile``'s internal fixed-size buffer: no file is ever read whole and the archive is never
+    built in memory, so peak memory does not grow with file size (SC-010, research.md section 9).
+
+    ``N`` is derived from the plan that was actually written rather than counted independently,
+    so the reported count cannot drift from what the archive holds (FR-008, SC-003).
+
+    Only ``OSError`` and ``tarfile.TarError`` are caught -- no bare ``except``, nothing
+    swallowed (Principle II) -- and each is re-raised as :class:`TarxError` carrying template C9
+    for a failure of the open and C10 for a failure once writing had begun, both class 2
+    (FR-021).
+
+    An incomplete archive may remain after a genuine mid-write failure and is explicitly **not**
+    rolled back; FR-021 permits that, and ``001-tarx-cli`` FR-022 makes the same choice. What
+    must never happen is the summary line being printed, which ``cli._run_create`` guarantees by
+    printing only after this function has returned.
+    """
+    try:
+        handle = tarfile.open(archive, _archive_mode(archive))
+    except (OSError, tarfile.TarError) as exc:
+        raise TarxError(
+            "tarx: cannot create archive '{0}': {1}".format(archive, _reason(exc)),
+            EXIT_INPUT,
+        ) from exc
+
+    writing = None
+    try:
+        with handle:
+            for member in plan.members.values():
+                writing = member.name
+                info = _member_info(member)
+                if member.kind == KIND_DIR:
+                    handle.addfile(info)
+                else:
+                    with open(member.path, "rb") as source:
+                        handle.addfile(info, source)
+    except (OSError, tarfile.TarError) as exc:
+        raise TarxError(
+            "tarx: failed while writing member '{0}' to archive '{1}': {2}".format(
+                writing, archive, _reason(exc)
+            ),
+            EXIT_INPUT,
+        ) from exc
+
+    return sum(1 for member in plan.members.values() if member.kind == KIND_FILE)
