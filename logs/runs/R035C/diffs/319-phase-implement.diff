+@pytest.mark.parametrize("entry", [DIR, symlink("elsewhere"), fifo()])
+@pytest.mark.parametrize("overwrite", [False, True])
+def test_create_fr_012_a_non_regular_archive_path_is_refused(
+    run_cli, tmp_path, monkeypatch, entry, overwrite
+):
+    """CREATE-FR-012: a directory, a symbolic link or a FIFO at ``ARCHIVE`` yields template C4
+    with status **2**, identically with and without ``--overwrite``, leaving the target untouched.
+
+    ``--overwrite`` consents to replacing a **regular file** and nothing else -- the same
+    boundary it has in ``extract``. That is why this is class 2 ("this path can never work")
+    rather than class 3 ("re-run with ``--overwrite``"), which would be false advice here.
+
+    "Untouched" is asserted through ``os.lstat`` rather than through the ``snapshot_tree``
+    fixture, because that fixture reads every non-directory it walks and would block forever on
+    the FIFO case -- and ``tests/conftest.py`` must stay byte-for-byte unchanged (SC-009). The
+    stat comparison is the assertion that matters here anyway: the entry is still there and is
+    still the same type, so nothing was replaced. It is also what makes this test meaningful at
+    all -- the C4 check is the only thing standing between a FIFO at ``ARCHIVE`` and a
+    ``tarfile.open`` that blocks forever waiting for a reader.
+    """
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"photos/a.jpg": b"A", "inthe.way": entry})
+    before = os.lstat("inthe.way")
+    argv = ["create", "inthe.way", "photos"] + (["--overwrite"] if overwrite else [])
+
+    status, out, err = run_cli(*argv)
+
+    assert status == 2
+    assert out == ""
+    assert err == "tarx: archive path 'inthe.way' exists but is not a regular file\n"
+    after = os.lstat("inthe.way")
+    assert (after.st_mode, after.st_ino, after.st_size) == (
+        before.st_mode,
+        before.st_ino,
+        before.st_size,
+    )
