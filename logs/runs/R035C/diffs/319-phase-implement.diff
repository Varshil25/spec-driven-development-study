+@pytest.mark.slow
+@pytest.mark.parametrize("gzip_name", [False, True])
+@pytest.mark.parametrize("size", [4 * 1024 * 1024, 16 * 1024 * 1024])
+def test_create_sc_010_peak_memory_does_not_grow_with_file_size(
+    run_cli, tmp_path, monkeypatch, gzip_name, size
+):
+    """SC-010: peak additional allocation stays under one fixed ceiling at two file sizes.
+
+    Asserting a single ceiling across both sizes is what makes *growth* -- not just magnitude --
+    the thing that fails. A read-it-all-in implementation would peak near the file size and blow
+    the ceiling at the larger one. Reference measurements on a 40 MB file: 44 KiB for ``w`` and
+    519 KiB for ``w:gz`` (research.md section 9).
+    """
+    work_in(monkeypatch, tmp_path)
+    (tmp_path / "big").mkdir()
+    with open(tmp_path / "big" / "blob.bin", "wb") as handle:
+        chunk = bytes(range(256)) * 4096
+        for _ in range(size // len(chunk)):
+            handle.write(chunk)
+    name = "big.tar.gz" if gzip_name else "big.tar"
+
+    tracemalloc.start()
+    status, out, err = run_cli("create", name, "big")
+    _, peak = tracemalloc.get_traced_memory()
+    tracemalloc.stop()
+
+    assert (status, err) == (0, "")
+    assert out == "created {0} with 1 files\n".format(name)
+    assert peak < 2 * 1024 * 1024, "peak {0} bytes at size {1}".format(peak, size)
