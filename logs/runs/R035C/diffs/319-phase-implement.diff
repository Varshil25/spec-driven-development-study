+"""User Story 2: a new archive never destroys an old one without consent.
+
+Covers CREATE-FR-010, CREATE-FR-011, CREATE-FR-012 and CREATE-FR-027, plus SC-004.
+
+``snapshot_tree`` comes from the untouched ``tests/conftest.py`` and is what turns
+"byte-for-byte unchanged" into an assertion rather than a claim (research.md section 12).
+"""
+
+import os
+
+import pytest
+
+from create_support import DIR, build_tree, fifo, is_gzip, member_names, symlink, work_in
+
+
+# ======================================================================================
+# T028 -- the refusal (CREATE-FR-010, C3, SC-004)
+# ======================================================================================
+
+
