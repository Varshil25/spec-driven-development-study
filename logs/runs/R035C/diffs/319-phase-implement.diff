+#: snapshotted, and ``conftest.py``'s ``snapshot_tree`` reads every non-directory it walks --
+#: so no FIFOs or sockets (it would block forever) and no dangling symbolic links (it would
+#: raise). That fixture must stay byte-for-byte unchanged (SC-009), so the trees accommodate it;
+#: the FIFO and socket cases are covered in ``test_create_overwrite.py`` and ``test_create.py``
+#: with type-aware assertions instead.
+DETECTED_FAILURES = {
+    "missing path": ({"photos/a.jpg": b"A"}, ["out.tar", "photos", "nosuch"]),
+    "all paths missing": ({}, ["out.tar", "nosuch"]),
+    "absolute path": ({"photos/a.jpg": b"A"}, ["out.tar", "/etc/hostname"]),
+    "escaping path": ({"photos/a.jpg": b"A"}, ["out.tar", "../outside"]),
+    "refused overwrite": ({"photos/a.jpg": b"A", "out.tar": b"old"}, ["out.tar", "photos"]),
+    "missing parent": ({"photos/a.jpg": b"A"}, ["backups/2026/out.tar", "photos"]),
+    "parent not a directory": (
