+"""CREATE-FR-025 / SC-011 audit: every requirement of this feature is referenced by a test.
+
+Constitution Principle III makes the requirement-to-test mapping auditable rather than assumed,
+and CREATE-FR-025 makes the mapping itself a requirement -- so it gets a test.
+
+Two things make this audit mean something rather than pass vacuously (research.md section 13):
+
+* **A separate reference namespace.** Both specs number their requirements ``FR-001``-upward, so
+  a bare ``FR-###`` sweep would be satisfied by ``001-tarx-cli``'s *existing* tests: they
+  already mention ``FR-001`` through ``FR-025``, which would "cover" this feature's FR-001
+  through FR-025 without a single new test existing. This feature is therefore referenced as
+  ``CREATE-FR-###`` in docstrings and ``create_fr_###`` in test names.
+* **Only requirement-*definition* lines are parsed.** This spec cites the earlier feature inline
+  as "``001-tarx-cli`` FR-004", "FR-017" and "FR-022"; a ``\\bFR-(\\d{3})\\b`` sweep would treat
+  those cross-references as requirements of this feature. Anchoring on ``- **FR-###**:`` at the
+  start of a line yields exactly the defined set.
+
+The pre-existing ``tests/test_traceability.py`` is left untouched, and no ``002`` identifier is
+added to any ``001-tarx-cli`` document -- which would otherwise break that file's third test.
+"""
+
+import pathlib
+import re
+
+REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
+TESTS_DIR = REPO_ROOT / "tests"
+FEATURE_DIR = REPO_ROOT / "specs" / "002-create-command"
+SPEC = FEATURE_DIR / "spec.md"
+DATA_MODEL = FEATURE_DIR / "data-model.md"
+
+#: A requirement *definition*: ``- **FR-003**: ...`` at the start of a line. Not a mention.
+DEFINITION_PATTERN = re.compile(r"^- \*\*FR-(\d{3})\*\*:", re.MULTILINE)
+
+#: A row of the requirement-to-test map in data-model.md: ``| FR-003 | ... |``.
+MAP_ROW_PATTERN = re.compile(r"^\| FR-(\d{3}) \|", re.MULTILINE)
+
+#: Test files reference requirements as ``test_create_fr_003_...`` and docstrings as
+#: ``CREATE-FR-003``; either form counts.
+REFERENCE_FORMS = ("CREATE-FR-{0}", "create_fr_{0}")
+
+#: The number of functional requirements this feature defines. Pinned so that a requirement
+#: silently deleted from the spec -- which would make the audit weaker without failing it --
+#: is caught too.
+EXPECTED_REQUIREMENT_COUNT = 27
+
+
+def _spec_requirement_ids():
+    """Every ``FR-###`` identifier **defined** in this feature's specification."""
+    assert SPEC.is_file(), "spec.md not found at {0}".format(SPEC)
+    return sorted(set(DEFINITION_PATTERN.findall(SPEC.read_text(encoding="utf-8"))))
+
+
+def _test_corpus():
+    """The concatenated text of every test module, which is where references must appear."""
+    return "\n".join(
+        path.read_text(encoding="utf-8") for path in sorted(TESTS_DIR.rglob("*.py"))
+    )
+
+
+def test_create_fr_025_spec_defines_the_requirements_to_audit():
+    """CREATE-FR-025: the audit is only meaningful if the spec yields the expected identifiers.
+
+    Also checks that the definition anchor is doing its job: the spec's inline references to
+    ``001-tarx-cli``'s FR-004, FR-017 and FR-022 must not inflate the set, and the identifiers
+    must run contiguously from 001 so a gap cannot hide a dropped requirement.
+    """
+    identifiers = _spec_requirement_ids()
+
+    assert identifiers, "no FR-### definitions found -- the audit would pass vacuously"
+    assert len(identifiers) == EXPECTED_REQUIREMENT_COUNT, (
+        "expected {0} requirements, found {1}: {2}".format(
+            EXPECTED_REQUIREMENT_COUNT, len(identifiers), ", ".join(identifiers)
+        )
+    )
+    assert identifiers == ["{0:03d}".format(n) for n in range(1, len(identifiers) + 1)]
+
+
+def test_create_fr_025_every_requirement_is_referenced_by_at_least_one_test():
+    """CREATE-FR-025 / SC-011: no functional requirement is left without a covering test.
+
+    Fails with the explicit list of uncovered identifiers so the gap is actionable rather than
+    a bare assertion failure.
+    """
+    corpus = _test_corpus()
+
+    uncovered = [
+        "CREATE-FR-{0}".format(number)
+        for number in _spec_requirement_ids()
+        if not any(form.format(number) in corpus for form in REFERENCE_FORMS)
+    ]
+
+    assert uncovered == [], "requirements with no referencing test: {0}".format(
+        ", ".join(uncovered)
+    )
+
+
+def test_create_fr_025_the_namespace_prefix_is_what_makes_the_audit_meaningful():
+    """CREATE-FR-025: guard the audit's own premise.
+
+    If this feature's requirements were referenced as bare ``FR-###``, ``001-tarx-cli``'s
+    pre-existing tests would already satisfy the audit for FR-001 through FR-025 and the result
+    would be meaningless. So: the create test corpus must carry the prefixed form, and it must
+    be the prefixed form the audit looks for.
+    """
+    create_corpus = "\n".join(
+        path.read_text(encoding="utf-8") for path in sorted(TESTS_DIR.glob("test_create*.py"))
+    )
+
+    assert "CREATE-FR-" in create_corpus
+    assert all(form.startswith(("CREATE-FR-", "create_fr_")) for form in REFERENCE_FORMS)
+
+
+def test_create_fr_025_requirement_to_test_map_is_not_stale_in_either_direction():
+    """CREATE-FR-025: cross-check the audit against the map in this feature's data-model.md.
+
+    The map is the human-readable half of the same claim, so a requirement present in the spec
+    but missing from the map -- or the reverse, a map row for a requirement that no longer
+    exists -- means one of the two documents is wrong. Checking both directions is what stops
+    the map going stale as the spec changes.
+    """
+    mapped = set(MAP_ROW_PATTERN.findall(DATA_MODEL.read_text(encoding="utf-8")))
+    specified = set(_spec_requirement_ids())
+
+    assert specified - mapped == set(), "in spec.md but absent from the map: {0}".format(
+        sorted("FR-{0}".format(n) for n in specified - mapped)
+    )
+    assert mapped - specified == set(), "in the map but absent from spec.md: {0}".format(
+        sorted("FR-{0}".format(n) for n in mapped - specified)
+    )
+
+
+def test_create_fr_025_no_002_identifier_was_added_to_a_001_document():
+    """CREATE-FR-025: this feature's identifiers stay out of ``001-tarx-cli``'s documents.
+
+    ``tests/test_traceability.py`` cross-checks 001's spec against 001's data-model in both
+    directions, so adding an ``FR-026`` or ``FR-027`` row to either would break a pre-existing
+    test -- the one failure mode this feature's traceability work could cause elsewhere
+    (SC-009).
+    """
+    older = REPO_ROOT / "specs" / "001-tarx-cli"
+    older_ids = set()
+    for name in ("spec.md", "data-model.md"):
+        older_ids |= set(re.findall(r"\bFR-(\d{3})\b", (older / name).read_text("utf-8")))
+
+    beyond = sorted(number for number in older_ids if int(number) > 25)
+    assert beyond == [], "002 identifiers leaked into a 001 document: {0}".format(beyond)