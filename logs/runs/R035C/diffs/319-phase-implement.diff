new file mode 100644
index 0000000..5cd98b8
--- /dev/null
+++ b/tests/create_support.py
@@ -0,0 +1,157 @@
+"""Source-tree building and archive-inspection helpers for the ``create`` test modules.
+
+These live here rather than in ``tests/conftest.py`` so that **no pre-existing test file is
+touched at all**, which turns SC-009 ("the existing suite passes without a single test being
+modified") from a claim into a mechanical ``git diff`` check (research.md section 12). The
+pre-existing fixtures -- ``run_cli``, ``run_module``, ``snapshot_tree``, ``make_archive``,
+``tmp_path`` -- are reused exactly as they stand.
+
+``tests/`` has no ``__init__.py``, so pytest's default ``prepend`` import mode puts the directory
+on ``sys.path`` and a sibling ``import create_support`` resolves.
+"""
+
+import os
+import pathlib
+import socket as socket_module
+import tarfile
+
+# --------------------------------------------------------------------------------------
+# Declarative source trees (T004)
+# --------------------------------------------------------------------------------------
+
+#: Marker for "this path is a directory". Directories are also created implicitly as parents,
+#: so this is only needed for a directory with no entries of its own -- which is exactly the
+#: FR-007 case, hence a spelled-out marker rather than an inferred one.
+DIR = ("dir",)
+
+
+def symlink(target):
+    """A symbolic link entry pointing at ``target`` (not required to exist -- FR-013 uses
+    ``lexists``, so a dangling link is a skipped entry rather than a missing one)."""
+    return ("symlink", target)
+
+
+def fifo():
+    """A FIFO entry (named pipe)."""
+    return ("fifo", None)
+
+
+def socket():
+    """A Unix-domain socket entry -- a type the filesystem can present and tar cannot store."""
+    return ("socket", None)
+
+
+def hardlink(target):
+    """A second name for the file already built at ``target``, relative to the tree root.
+
+    FR-015 makes this an ordinary regular file for ``create``'s purposes: both names must be
+    stored, each with its own copy of the contents.
+    """
+    return ("hardlink", target)
+
+
+def build_tree(root, spec):
+    """Materialise ``spec`` beneath ``root`` and return ``root`` as a :class:`pathlib.Path`.
+
+    ``spec`` maps a ``/``-separated relative path to what should be there:
+
+    * ``bytes`` -- a regular file holding exactly those bytes (``b""`` gives a zero-length file)
+    * ``str``   -- a regular file holding the UTF-8 encoding of that text
+    * :data:`DIR` -- a directory with no entries of its own
+    * :func:`symlink`, :func:`fifo`, :func:`socket`, :func:`hardlink` -- the matching entry type
+
+    Missing parent directories are created automatically, and ``spec`` is walked in insertion
+    order so a :func:`hardlink` can name a file defined earlier in the same spec.
+    """
+    root = pathlib.Path(root)
+    root.mkdir(parents=True, exist_ok=True)
+
+    for relative, entry in spec.items():
+        path = root / relative
+        path.parent.mkdir(parents=True, exist_ok=True)
+
+        if isinstance(entry, bytes):
+            path.write_bytes(entry)
+        elif isinstance(entry, str):
+            path.write_bytes(entry.encode("utf-8"))
+        elif entry == DIR:
+            path.mkdir(parents=True, exist_ok=True)
+        elif isinstance(entry, tuple):
+            kind, target = entry
+            if kind == "symlink":
+                os.symlink(target, path)
+            elif kind == "fifo":
+                os.mkfifo(path)
+            elif kind == "socket":
+                handle = socket_module.socket(socket_module.AF_UNIX, socket_module.SOCK_STREAM)
+                try:
+                    handle.bind(str(path))
+                finally:
+                    handle.close()
+            elif kind == "hardlink":
+                os.link(root / target, path)
+            else:
+                raise ValueError("unknown entry kind: {0!r}".format(kind))
+        else:
+            raise ValueError("unknown entry spec: {0!r}".format(entry))
+
+    return root
+
+
+def work_in(monkeypatch, path):
+    """``chdir`` into ``path`` for the duration of the test and return it as a ``Path``.
+
+    ``create``'s ``PATH`` operands are relative to the current directory (FR-003), so every
+    in-process test runs from a temporary directory rather than from the repository root.
+    ``monkeypatch.chdir`` restores the original directory at teardown.
+    """
+    path = pathlib.Path(path)
+    path.mkdir(parents=True, exist_ok=True)
+    monkeypatch.chdir(path)
+    return path
+
+
+# --------------------------------------------------------------------------------------
+# Archive inspection (T005)
+# --------------------------------------------------------------------------------------
+
+
+def member_names(archive):
+    """Every member name, in archive order, exactly as recorded (FR-004, FR-026).
+
+    No trailing-slash stripping and no sorting: the point of these assertions is that the stored
+    names and their order are already what the contract says, so anything this helper normalised
+    would hide the failure it exists to catch.
+    """
+    with tarfile.open(archive, "r:*") as handle:
+        return handle.getnames()
+
+
+def member_entries(archive):
+    """``(name, type byte as text, size)`` per member, in archive order.
+
+    The type byte is what distinguishes a regular file (``"0"``), a directory (``"5"``) and a
+    hard link (``"1"``) -- the distinction FR-015 turns on, and one that a name-only assertion
+    cannot see (research.md section 4).
+    """
+    with tarfile.open(archive, "r:*") as handle:
+        return [(info.name, info.type.decode("ascii"), info.size) for info in handle]
+
+
+def member_bytes(archive, name):
+    """The exact bytes stored for member ``name`` (FR-006)."""
+    with tarfile.open(archive, "r:*") as handle:
+        extracted = handle.extractfile(name)
+        assert extracted is not None, "member {0!r} holds no data".format(name)
+        with extracted:
+            return extracted.read()
+
+
+def is_gzip(archive):
+    """True when the archive's **own first two bytes** are the gzip magic (SC-007).
+
+    Read from the file rather than inferred from its name, so this cannot agree with the
+    implementation by sharing its mistake (FR-005).
+    """
+    with open(archive, "rb") as handle:
+        return handle.read(2) == b"\x1f\x8b"
