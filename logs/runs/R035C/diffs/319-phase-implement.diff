+"""User Story 3: a clear failure and no half-made archive.
+
+Covers CREATE-FR-001, CREATE-FR-013, CREATE-FR-014, CREATE-FR-015, CREATE-FR-016,
+CREATE-FR-018, CREATE-FR-021 and CREATE-FR-022, plus SC-005 and SC-006.
+
+Two notes on technique, both load-bearing:
+
+* **Root bypasses permission bits**, and this repository's suite runs as root, so a
+  ``chmod 0o000`` test alone would pass vacuously -- and Principle III says a requirement
+  "covered" by a test that cannot fail is not covered. CREATE-FR-021 is therefore tested twice:
+  a real permission test marked ``skipif(os.geteuid() == 0)``, and ``monkeypatch``-injected
+  ``OSError`` tests that run everywhere (research.md section 8).
+* ``tests/conftest.py``'s ``snapshot_tree`` reads every non-directory it walks, so it blocks
+  forever on a FIFO. That fixture must stay byte-for-byte unchanged (SC-009), so trees that get
+  snapshotted here contain no FIFOs and no sockets.
+"""
+
+import builtins
+import os
+import tarfile
+
+import pytest
+
+from create_support import DIR, build_tree, member_names, symlink, work_in
+
+
+def _failing_open(target, exc):
+    """A ``builtins.open`` replacement that raises ``exc`` for ``target`` and defers otherwise.
+
+    Injection is what keeps CREATE-FR-021's validation branch genuinely exercised in a root
+    test environment, where a permission-only test cannot fail (research.md section 8).
+    """
+    real_open = builtins.open
+
+    def fake_open(file, *args, **kwargs):
+        if str(file) == target:
+            raise exc
+        return real_open(file, *args, **kwargs)
+
+    return fake_open
+
+
+def _failing_scandir(target, exc):
+    """An ``os.scandir`` replacement that raises ``exc`` for ``target`` and defers otherwise."""
+    real_scandir = os.scandir
+
+    def fake_scandir(path="."):
+        if str(path) == target:
+            raise exc
+        return real_scandir(path)
+
+    return fake_scandir
+
+
