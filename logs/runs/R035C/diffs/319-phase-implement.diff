new file mode 100644
index 0000000..283d119
--- /dev/null
+++ b/tests/test_create.py
@@ -0,0 +1,727 @@
+"""User Story 1: packaging files and folders into an archive.
+
+Covers CREATE-FR-001 through CREATE-FR-008, CREATE-FR-015, CREATE-FR-017, CREATE-FR-019,
+CREATE-FR-020 and CREATE-FR-026, plus the SC-010 scale and memory checks.
+
+Every test chdirs into a temporary directory first, because ``create``'s ``PATH`` operands are
+relative to the current directory (CREATE-FR-003). Requirement identifiers are written
+``CREATE-FR-###`` and test names ``test_create_fr_###`` so the FR-025 audit can tell this
+feature's requirements apart from ``001-tarx-cli``'s identically-numbered ones
+(research.md section 13).
+"""
+
+import os
+import tarfile
+import tracemalloc
+
+import pytest
+
+from create_support import (
+    DIR,
+    build_tree,
+    fifo,
+    hardlink,
+    is_gzip,
+    member_bytes,
+    member_entries,
+    member_names,
+    socket,
+    symlink,
+    work_in,
+)
+
+# A tree used by several tests. Insertion order is deliberately *not* the expected member
+# order, so a test that passed by accident of filesystem ordering would show up.
+SAMPLE = {
+    "d/z.txt": "x",
+    "d/a.txt": "y",
+    "d/b/c.txt": "z",
+    "d/empty": DIR,
+    "photos/b.jpg": b"B",
+    "photos/a.jpg": b"A",
+    "notes.txt": "hello",
+}
+
+
+# ======================================================================================
+# T014 -- dispatch, operands and the summary line
+# ======================================================================================
+
+
+def test_create_fr_001_create_is_selected_by_the_first_operand(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-001: ``create`` is a third command selected by the first operand."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"notes.txt": "hello"})
+
+    status, out, err = run_cli("create", "out.tar", "notes.txt")
+
+    assert status == 0, err
+    assert os.path.isfile("out.tar")
+
+
+def test_create_fr_001_list_and_extract_still_dispatch(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-001: adding ``create`` does not displace the two existing commands."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"notes.txt": "hello"})
+    run_cli("create", "out.tar", "notes.txt")
+
+    list_status, list_out, _ = run_cli("list", "out.tar")
+    extract_status, extract_out, _ = run_cli("extract", "out.tar", "dest")
+
+    assert list_status == 0
+    assert list_out == "notes.txt\n"
+    assert extract_status == 0
+    assert extract_out == "extracted 1 files\n"
+
+
+def test_create_fr_002_one_path_operand_is_accepted(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-002: ``ARCHIVE PATH`` with a single ``PATH`` is a complete invocation."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"notes.txt": "hello"})
+
+    status, out, err = run_cli("create", "out.tar", "notes.txt")
+
+    assert (status, out, err) == (0, "created out.tar with 1 files\n", "")
+
+
+def test_create_fr_002_many_path_operands_are_accepted(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-002: ``PATH...`` accepts more than one operand."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, SAMPLE)
+
+    status, out, err = run_cli("create", "all.tar", "notes.txt", "d", "photos")
+
+    assert (status, out, err) == (0, "created all.tar with 6 files\n", "")
+
+
+def test_create_fr_002_overwrite_option_is_parsed(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-002: ``--overwrite`` is accepted by ``create``, in any operand position."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"notes.txt": "hello"})
+
+    trailing = run_cli("create", "a.tar", "notes.txt", "--overwrite")
+    leading = run_cli("create", "--overwrite", "b.tar", "notes.txt")
+
+    assert trailing == (0, "created a.tar with 1 files\n", "")
+    assert leading == (0, "created b.tar with 1 files\n", "")
+
+
+@pytest.mark.parametrize(
+    ("spec", "operands", "count"),
+    [
+        ({"empty": DIR}, ["empty"], 0),
+        ({"one.txt": "1"}, ["one.txt"], 1),
+        ({"one.txt": "1", "two.txt": "2"}, ["one.txt", "two.txt"], 2),
+    ],
+)
+def test_create_fr_008_summary_line_is_exact_and_files_is_always_plural(
+    run_cli, tmp_path, monkeypatch, spec, operands, count
+):
+    """CREATE-FR-008: stdout is exactly ``created ARCHIVE with N files`` at N = 0, 1 and 2.
+
+    The word ``files`` is plural at every count: the line is a fixed template for scripts, not
+    prose.
+    """
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, spec)
+
+    status, out, err = run_cli("create", "out.tar", *operands)
+
+    assert status == 0, err
+    assert out == "created out.tar with {0} files\n".format(count)
+    # The archive must actually exist and hold what was counted, so that the N = 0 case cannot
+    # be satisfied by a run that wrote nothing at all.
+    assert member_names("out.tar") == sorted(operands)
+
+
+@pytest.mark.parametrize("given", ["out.tar", "./out.tar", "sub/../out.tar"])
+def test_create_fr_008_archive_is_echoed_verbatim(run_cli, tmp_path, monkeypatch, given):
+    """CREATE-FR-008: ``ARCHIVE`` is echoed exactly as supplied -- not normalised, not absolute."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"notes.txt": "hello", "sub": DIR})
+
+    status, out, err = run_cli("create", given, "notes.txt")
+
+    assert status == 0, err
+    assert out == "created {0} with 1 files\n".format(given)
+
+
+def test_create_fr_008_nothing_else_reaches_stdout(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-008 / CREATE-FR-017: the summary line is the *only* thing on stdout."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, SAMPLE)
+
+    status, out, err = run_cli("create", "all.tar", "notes.txt", "d", "photos")
+
+    assert status == 0, err
+    assert len(out.splitlines()) == 1
+    assert out == "created all.tar with 6 files\n"
+
+
+def test_create_fr_017_success_exits_zero_with_empty_stderr(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-017: a run that completes its work exits 0 and writes no diagnostics."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, SAMPLE)
+
+    status, out, err = run_cli("create", "all.tar", "d")
+
+    assert status == 0
+    assert err == ""
+    assert out == "created all.tar with 3 files\n"
+    assert member_names("all.tar") == ["d", "d/a.txt", "d/b", "d/b/c.txt", "d/empty", "d/z.txt"]
+
+
+# ======================================================================================
+# T015 -- member coverage and naming
+# ======================================================================================
+
+
+def test_create_fr_003_file_operand_contributes_exactly_one_member(
+    run_cli, tmp_path, monkeypatch
+):
+    """CREATE-FR-003: a ``PATH`` naming a regular file contributes one regular-file member."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"notes.txt": "hello"})
+
+    run_cli("create", "out.tar", "notes.txt")
+
+    assert member_entries("out.tar") == [("notes.txt", "0", 5)]
+
+
+def test_create_fr_003_directory_operand_contributes_every_depth(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-003: a directory contributes itself plus every entry beneath it, at every depth."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"d/a.txt": "y", "d/b/deep/c.txt": "z"})
+
+    run_cli("create", "out.tar", "d")
+
+    assert member_names("out.tar") == ["d", "d/a.txt", "d/b", "d/b/deep", "d/b/deep/c.txt"]
+
+
+def test_create_fr_004_member_names_are_relative_and_slash_separated(
+    run_cli, tmp_path, monkeypatch
+):
+    """CREATE-FR-004: names are relative, ``/``-separated, with no leading ``./``."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"photos/a.jpg": b"A"})
+
+    run_cli("create", "out.tar", "./photos")
+
+    names = member_names("out.tar")
+    assert names == ["photos", "photos/a.jpg"]
+    assert not any(name.startswith("./") or name.startswith("/") for name in names)
+    assert not any("\\" in name for name in names)
+
+
+def test_create_fr_004_directory_members_carry_no_trailing_slash(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-004: ``getnames()`` returns ``photos``, not ``photos/`` -- the type byte records
+    directory-ness, so the name does not have to."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"photos/a.jpg": b"A", "photos/sub": DIR})
+
+    run_cli("create", "out.tar", "photos")
+
+    entries = member_entries("out.tar")
+    assert entries == [("photos", "5", 0), ("photos/a.jpg", "0", 1), ("photos/sub", "5", 0)]
+    assert not any(name.endswith("/") for name, _, _ in entries)
+    with tarfile.open("out.tar") as handle:
+        assert handle.getmember("photos").isdir()
+
+
+def test_create_fr_004_operand_spellings_produce_identical_archives(
+    run_cli, tmp_path, monkeypatch
+):
+    """CREATE-FR-004: ``photos``, ``photos/`` and ``./photos`` are three spellings of one path."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"photos/a.jpg": b"A", "photos/b.jpg": b"B"})
+
+    results = {}
+    for index, operand in enumerate(["photos", "photos/", "./photos"]):
+        name = "out{0}.tar".format(index)
+        status, out, err = run_cli("create", name, operand)
+        assert status == 0, err
+        results[operand] = member_entries(name)
+
+    assert results["photos"] == [("photos", "5", 0), ("photos/a.jpg", "0", 1),
+                                 ("photos/b.jpg", "0", 1)]
+    assert results["photos/"] == results["photos"]
+    assert results["./photos"] == results["photos"]
+
+
+def test_create_fr_004_dot_operand_contributes_contents_only(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-004: an operand normalising to ``.`` contributes its contents under their plain
+    relative names and no member of its own, because ``.`` is not a name FR-004 permits."""
+    work_in(monkeypatch, tmp_path / "work")
+    build_tree(tmp_path / "work", {"a.txt": "a", "sub/b.txt": "b"})
+
+    status, out, err = run_cli("create", "../out.tar", ".")
+
+    assert status == 0, err
+    assert member_names("../out.tar") == ["a.txt", "sub", "sub/b.txt"]
+
+
+# ======================================================================================
+# T016 -- compression selection (CREATE-FR-005, SC-007)
+# ======================================================================================
+
+
+@pytest.mark.parametrize("name", ["photos.tar.gz", "photos.tgz", "a.b.tar.gz"])
+def test_create_fr_005_gzip_names_produce_gzip_archives(run_cli, tmp_path, monkeypatch, name):
+    """CREATE-FR-005 / SC-007: a ``.tar.gz`` or ``.tgz`` name yields an archive starting
+    ``\\x1f\\x8b``, verified from the archive's own bytes."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"notes.txt": "hello"})
+
+    status, out, err = run_cli("create", name, "notes.txt")
+
+    assert status == 0, err
+    assert is_gzip(name)
+    assert member_names(name) == ["notes.txt"]
+
+
+@pytest.mark.parametrize("name", ["photos.tar", "backup", "data.bin", "PHOTOS.TAR.GZ", "x.TGZ"])
+def test_create_fr_005_other_names_produce_plain_archives(run_cli, tmp_path, monkeypatch, name):
+    """CREATE-FR-005: the suffix match is literal and **case-sensitive**, so ``PHOTOS.TAR.GZ``
+    and ``x.TGZ`` get plain archives."""
+    work_in(monkeypatch, tmp_path)
+    build_tree(tmp_path, {"notes.txt": "hello"})
+
+    status, out, err = run_cli("create", name, "notes.txt")
+
+    assert status == 0, err
+    assert not is_gzip(name)
+    assert member_names(name) == ["notes.txt"]
+
+
+# ======================================================================================
+# T017 -- stored contents and directory members
+# ======================================================================================
+
+
+def test_create_fr_006_stored_bytes_are_identical_to_the_source(run_cli, tmp_path, monkeypatch):
+    """CREATE-FR-006: text, binary and zero-length files are stored byte-for-byte."""
+    work_in(monkeypatch, tmp_path)
+    binary = bytes(range(256)) * 17
+    build_tree(
+        tmp_path,
+        {"t/text.txt": "line one\nline two\n", "t/blob.bin": binary, "t/zero.dat": b""},
+    )
+
+    status, out, err = run_cli("create", "out.tar", "t")
+
+    assert status == 0, err
+    assert member_bytes("out.tar", "t/text.txt") == b"line one\nline two\n"
+    assert member_bytes("out.tar", "t/blob.bin") == binary
+    assert member_bytes("out.tar", "t/zero.dat") == b""
+    for name, expected in (("t/blob.bin", len(binary)), ("t/zero.dat", 0)):
