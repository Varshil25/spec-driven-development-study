+
+    Both the FR-016 validation walk and the write pass are linear in entry count, so the budget
+    is the check that neither became quadratic.
+    """
+    import time
+
+    work_in(monkeypatch, tmp_path)
+    root = tmp_path / "many"
+    for bucket in range(100):
+        directory = root / "b{0:03d}".format(bucket)
