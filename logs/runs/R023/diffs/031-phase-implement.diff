+"""End-to-end tests that run ``python -m logredact`` as a subprocess."""
+
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+SRC = str(Path(__file__).resolve().parents[1] / "src")
+
+
+def run(args, stdin=b""):
+    """Invoke the tool; returns (returncode, stdout bytes, stderr bytes)."""
+    env = dict(os.environ)
+    env["PYTHONPATH"] = SRC + os.pathsep + env.get("PYTHONPATH", "")
+    proc = subprocess.run(
+        [sys.executable, "-m", "logredact", *args],
+        input=stdin,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        env=env,
+    )
+    return proc.returncode, proc.stdout, proc.stderr
+
+
+class StdinTests(unittest.TestCase):
+    def test_first_documented_example(self):
+        code, out, err = run([], b"user jane@example.com from 10.0.0.7\n")
+        self.assertEqual(code, 0)
+        self.assertEqual(out, b"user [EMAIL] from [IP]\n")
+        self.assertEqual(err, b"")
+
+    def test_second_documented_example(self):
+        code, out, _ = run([], b"paid with 4111 1111 1111 1111, ref 1234567890123\n")
+        self.assertEqual(code, 0)
+        self.assertEqual(out, b"paid with [CARD], ref 1234567890123\n")
+
+    def test_third_documented_example(self):
+        code, out, err = run(["--count"], b"a@b.io 1.2.3.4\n")
+        self.assertEqual(code, 0)
+        self.assertEqual(out, b"[EMAIL] [IP]\n")
+        self.assertEqual(err, b"emails=1 ips=1 cards=0\n")
+
+    def test_no_count_means_quiet_stderr(self):
+        _, _, err = run([], b"a@b.io\n")
+        self.assertEqual(err, b"")
+
+    def test_empty_input(self):
+        code, out, err = run(["--count"], b"")
+        self.assertEqual((code, out), (0, b""))
+        self.assertEqual(err, b"emails=0 ips=0 cards=0\n")
+
+    def test_missing_final_newline_is_preserved(self):
+        code, out, _ = run([], b"a@b.io")
+        self.assertEqual((code, out), (0, b"[EMAIL]"))
+
+    def test_crlf_and_undecodable_bytes_survive(self):
+        data = b"a@b.io\r\n\xff\xfe raw 1.2.3.4\r\n"
+        code, out, _ = run([], data)
+        self.assertEqual((code, out), (0, b"[EMAIL]\r\n\xff\xfe raw [IP]\r\n"))
+
+    def test_dash_means_stdin(self):
+        code, out, _ = run(["-"], b"a@b.io\n")
+        self.assertEqual((code, out), (0, b"[EMAIL]\n"))
+
+
+class FileTests(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def write(self, name, data):
+        path = Path(self.dir.name) / name
+        path.write_bytes(data)
+        return str(path)
+
+    def test_single_file(self):
+        path = self.write("a.log", b"x@y.io\n")
+        code, out, _ = run([path])
+        self.assertEqual((code, out), (0, b"[EMAIL]\n"))
+
+    def test_files_are_read_in_order_with_shared_counts(self):
+        first = self.write("1.log", b"a@b.io\n")
+        second = self.write("2.log", b"10.0.0.7 4111111111111111\n")
+        code, out, err = run(["--count", first, second])
+        self.assertEqual(code, 0)
+        self.assertEqual(out, b"[EMAIL]\n[IP] [CARD]\n")
+        self.assertEqual(err, b"emails=1 ips=1 cards=1\n")
+
+    def test_missing_file_names_it_and_exits_2(self):
+        path = str(Path(self.dir.name) / "nope.log")
+        code, out, err = run([path])
+        self.assertEqual(code, 2)
+        self.assertEqual(out, b"")
+        self.assertIn(b"nope.log", err)
+
+    def test_directory_is_a_read_error(self):
+        code, _, err = run([self.dir.name])
+        self.assertEqual(code, 2)
+        self.assertIn(os.fsencode(self.dir.name), err)
+
+    def test_option_may_follow_the_files(self):
+        path = self.write("a.log", b"a@b.io\n")
+        code, _, err = run([path, "--count"])
+        self.assertEqual(code, 0)
+        self.assertEqual(err, b"emails=1 ips=0 cards=0\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
