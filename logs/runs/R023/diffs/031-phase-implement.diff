+"""Pattern matching and replacement of personal data in log text.
+
+Three kinds of data are redacted:
+
+``[EMAIL]``
+    Email addresses, e.g. ``jane.doe+test@mail.example.com``.
+``[IP]``
+    IPv4 addresses: four dot-separated numbers, each 0-255.
+``[IP]`` is not applied to look-alikes such as ``999.1.1.1``.
+``[CARD]``
+    Payment card numbers: 13 to 19 digits, optionally written in groups
+    separated by single spaces or single hyphens, passing the Luhn checksum.
+
+Everything else is left untouched, byte for byte.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+__all__ = [
+    "CARD_TOKEN",
+    "EMAIL_TOKEN",
+    "IP_TOKEN",
+    "Counts",
+    "luhn_ok",
+    "redact",
+]
+
+EMAIL_TOKEN = "[EMAIL]"
+IP_TOKEN = "[IP]"
+CARD_TOKEN = "[CARD]"
+
+#: Shortest / longest card number, in digits.
+MIN_CARD_DIGITS = 13
+MAX_CARD_DIGITS = 19
+
+# --- Email -----------------------------------------------------------------
+# A pragmatic address: a local part, '@', one or more dot-separated domain
+# labels and an alphabetic top-level domain of at least two characters.
+_EMAIL = r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}"
+
+# --- IPv4 ------------------------------------------------------------------
+_OCTET = r"(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"
+# The surrounding guards keep us from redacting a slice of a longer
+# dotted-number run: neither '999.1.1.1' nor '1.2.3.999' nor '1.2.3.4.5'
+# contains an address as far as this tool is concerned. A trailing dot that
+# is *not* followed by a digit is fine, so "from 10.0.0.7." still redacts.
+_IPV4 = rf"(?<![0-9.])(?:{_OCTET}\.){{3}}{_OCTET}(?![0-9])(?!\.[0-9])"
+
+# --- Card numbers ----------------------------------------------------------
+# A "region" is a maximal run of digit groups joined by single spaces or
+# single hyphens. One region may hold zero, one or several card numbers, so
+# the Luhn search below works group by group inside it.
+#
+# The lookarounds exclude digits that belong to a dotted number (an IP
+# address, a version, a decimal amount): '1.2.3.999' and '4111111111111111.00'
+# must not be read as card digits.
+_CARD_REGION = r"(?<![0-9])(?<![0-9]\.)[0-9]+(?:[ \-][0-9]+)*(?![0-9])(?!\.[0-9])"
+
+_DIGIT_GROUP = re.compile(r"[0-9]+")
+
+# Order matters: an address is tried before its digits can be claimed as an
+# IP or card, and an IP before its leading octet can be eaten by a region.
+_PATTERN = re.compile(
+    rf"(?P<email>{_EMAIL})|(?P<ip>{_IPV4})|(?P<card>{_CARD_REGION})"
+)
+
+
+@dataclass
+class Counts:
+    """How many items of each kind have been redacted."""
+
+    emails: int = 0
+    ips: int = 0
+    cards: int = 0
+
+    def summary(self) -> str:
+        """Render the ``--count`` summary line."""
+        return f"emails={self.emails} ips={self.ips} cards={self.cards}"
+
+
+def luhn_ok(digits: str) -> bool:
+    """Return True if ``digits`` satisfies the Luhn checksum."""
+    total = 0
+    for index, char in enumerate(reversed(digits)):
+        value = ord(char) - 48
+        if index % 2:
+            value *= 2
+            if value > 9:
+                value -= 9
+        total += value
+    return total % 10 == 0
+
+
+def _redact_cards(region: str) -> tuple[str, int]:
+    """Replace every card number inside a digit-group ``region``.
+
+    Returns the rewritten region and the number of cards replaced. Candidates
+    are runs of whole groups, taken leftmost-first and as long as possible;
+    a run that fails Luhn is left exactly as it was.
+    """
+    if len(region) < MIN_CARD_DIGITS:
+        return region, 0  # too short to hold a card, whatever the grouping
+
+    spans = [match.span() for match in _DIGIT_GROUP.finditer(region)]
+    parts: list[str] = []
+    copied = 0  # how much of region has been emitted already
+    cards = 0
+    first = 0
+    count = len(spans)
+
+    while first < count:
+        digits_seen = 0
+        best_last = -1
+        for last in range(first, count):
+            start, end = spans[last]
+            digits_seen += end - start
+            if digits_seen > MAX_CARD_DIGITS:
+                break
+            if digits_seen >= MIN_CARD_DIGITS:
+                candidate = "".join(region[s:e] for s, e in spans[first : last + 1])
+                if luhn_ok(candidate):
+                    best_last = last  # keep looking for a longer match
+        if best_last < 0:
+            first += 1
+            continue
+        parts.append(region[copied : spans[first][0]])
+        parts.append(CARD_TOKEN)
+        copied = spans[best_last][1]
+        cards += 1
+        first = best_last + 1
+
+    if not cards:
+        return region, 0
+    parts.append(region[copied:])
+    return "".join(parts), cards
+
+
+def redact(text: str, counts: Counts | None = None) -> str:
+    """Return ``text`` with emails, IPv4 addresses and card numbers replaced.
+
+    When ``counts`` is given, its tallies are incremented in place.
+    """
+    tally = counts if counts is not None else Counts()
+
+    def replace(match: re.Match[str]) -> str:
+        matched = match.group("email")
+        if matched is not None:
+            tally.emails += 1
+            return EMAIL_TOKEN
+        matched = match.group("ip")
+        if matched is not None:
+            tally.ips += 1
+            return IP_TOKEN
+        region, cards = _redact_cards(match.group("card"))
+        tally.cards += cards
+        return region
+
+    return _PATTERN.sub(replace, text)
