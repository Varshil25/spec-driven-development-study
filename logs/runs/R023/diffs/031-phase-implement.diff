+"""Command-line interface: ``python -m logredact [--count] [FILE ...]``."""
+
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+from typing import IO, Iterable, Sequence
+
+from .redact import Counts, redact
+
+__all__ = ["main"]
+
+PROG = "logredact"
+
+_STREAM_KWARGS = {
+    # Logs are not always valid UTF-8; surrogateescape lets undecodable
+    # bytes survive the round trip so untouched lines come out byte-identical.
+    "encoding": "utf-8",
+    "errors": "surrogateescape",
+    # newline='' keeps CRLF (and lone CR) line endings exactly as they are.
+    "newline": "",
+}
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog=f"python -m {PROG}",
+        description=(
+            "Remove personal data from log files: email addresses, IPv4 "
+            "addresses and payment card numbers are replaced with [EMAIL], "
+            "[IP] and [CARD]."
+        ),
+    )
+    parser.add_argument(
+        "--count",
+        action="store_true",
+        help="after the output, print 'emails=N ips=N cards=N' to stderr",
+    )
+    parser.add_argument(
+        "files",
+        metavar="FILE",
+        nargs="*",
+        help="input files, read in order; standard input if none (or '-')",
+    )
+    return parser
+
+
+def _reconfigure(stream: IO[str] | None) -> None:
+    reconfigure = getattr(stream, "reconfigure", None)
+    if reconfigure is None:
+        return
+    try:
+        reconfigure(**_STREAM_KWARGS)
+    except (ValueError, OSError):  # pragma: no cover - exotic streams
+        pass
+
+
+def _copy_redacted(lines: Iterable[str], out: IO[str], counts: Counts) -> None:
+    for line in lines:
+        out.write(redact(line, counts))
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    """Run the tool. Returns the process exit status."""
+    args = _build_parser().parse_args(argv)
+
+    _reconfigure(sys.stdin)
+    _reconfigure(sys.stdout)
+    out = sys.stdout
+    counts = Counts()
+
+    try:
+        if not args.files:
+            _copy_redacted(sys.stdin, out, counts)
+        else:
+            for name in args.files:
+                if name == "-":
+                    _copy_redacted(sys.stdin, out, counts)
+                    continue
+                try:
+                    with open(name, "r", **_STREAM_KWARGS) as handle:
+                        _copy_redacted(handle, out, counts)
+                except BrokenPipeError:
+                    raise  # an output problem, not an input one
+                except OSError as exc:
+                    out.flush()
+                    reason = exc.strerror or str(exc)
+                    print(f"{PROG}: {name}: {reason}", file=sys.stderr)
+                    return 2
+        out.flush()
+    except BrokenPipeError:
+        # The reader went away (e.g. `| head`); leave quietly instead of
+        # letting the interpreter complain while flushing at exit.
+        devnull = os.open(os.devnull, os.O_WRONLY)
+        os.dup2(devnull, sys.stdout.fileno())
+        return 0
+
+    if args.count:
+        print(counts.summary(), file=sys.stderr)
+    return 0
