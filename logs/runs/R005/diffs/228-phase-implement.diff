index 0000000..e4b5354
--- /dev/null
+++ b/tests/test_invocation.py
@@ -0,0 +1,178 @@
+"""FR-001 ... FR-004: subcommands, argument arity, and usage errors.
+
+Also holds the two suite-wide assertions that belong to no single
+requirement cluster: FR-028's exit-status exclusivity and SC-006's
+requirement-to-test traceability.
+"""
+
+import pathlib
+import re
+
+
+def test_fr001_help_uses_prog_tarx(run_tarx):
+    """FR-001: ``--help`` succeeds and the usage line names the tool ``tarx``.
+
+    Running a package as ``python -m tarx`` leaves ``sys.argv[0]`` pointing at
+    ``__main__.py``, so without an explicit ``prog`` argparse would print
+    ``usage: __main__.py ...`` (research R7).
+    """
+    result = run_tarx("--help")
+    assert result.returncode == 0
+    assert result.stdout.startswith("usage: tarx")
+    assert "usage: __main__.py" not in result.stdout
+
+
+def test_fr002_list_rejects_zero_positional_arguments(run_tarx):
+    """FR-002: ``list`` requires its one archive argument."""
+    result = run_tarx("list")
+    assert result.returncode != 0
+    assert result.stdout == ""
+    assert "usage: tarx list" in result.stderr
+
+
+def test_fr002_list_rejects_two_positional_arguments(run_tarx, plain_archive):
+    """FR-002: ``list`` accepts exactly one archive argument, not two.
+
+    The surplus argument is rejected by the top-level parser, so the usage
+    guidance printed is the top-level one rather than ``list``'s -- either
+    satisfies FR-002's "write usage guidance to stderr".
+    """
+    result = run_tarx("list", plain_archive, plain_archive)
+    assert result.returncode != 0
+    assert result.stdout == ""
+    assert result.stderr.startswith("usage: tarx")
+
+
+def test_fr003_extract_rejects_one_positional_argument(run_tarx, plain_archive):
+    """FR-003: ``extract`` requires both the archive and the destination."""
+    result = run_tarx("extract", plain_archive)
+    assert result.returncode != 0
+    assert result.stdout == ""
+    assert "usage: tarx extract" in result.stderr
+
+
+def test_fr003_extract_rejects_three_positional_arguments(
+    run_tarx, plain_archive, tmp_path
+):
+    """FR-003: ``extract`` accepts exactly two positional arguments."""
+    result = run_tarx("extract", plain_archive, tmp_path / "out", "surplus")
+    assert result.returncode != 0
+    assert result.stdout == ""
+    assert result.stderr.startswith("usage: tarx")
+
+
+def test_fr003_extract_accepts_overwrite_flag(run_tarx, plain_archive, tmp_path):
+    """FR-003: ``--overwrite`` is a valid option on ``extract``."""
+    result = run_tarx("extract", plain_archive, tmp_path / "out", "--overwrite")
+    assert result.returncode == 0
+    assert result.stderr == ""
+
+
+# --------------------------------------------------------------------------
+# FR-004: usage guidance for invocation errors
+# --------------------------------------------------------------------------
+
+
+def test_fr004_no_subcommand(run_tarx):
+    """FR-004: invoked with no subcommand at all → usage on stderr, exit 2."""
+    result = run_tarx()
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr.startswith("usage: tarx")
+
+
+def test_fr004_unrecognized_subcommand(run_tarx, plain_archive):
+    """FR-004: an unrecognized subcommand → usage on stderr, exit 2.
+
+    This is ``argparse``'s own default behaviour, confirmed here rather than
+    reimplemented.
+    """
+    result = run_tarx("frobnicate", plain_archive)
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr.startswith("usage: tarx")
+    assert "frobnicate" in result.stderr
+
+
+def test_fr004_unrecognized_option(run_tarx, plain_archive):
+    """FR-004: an unrecognized option → usage on stderr, exit 2."""
+    result = run_tarx("list", plain_archive, "--nonsense")
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr.startswith("usage: tarx")
+
+
+def test_fr004_invocation_error_performs_no_other_action(run_tarx, plain_archive):
+    """FR-004: an invocation error performs no other action.
+
+    A bad option alongside a perfectly good archive must not list it.
+    """
+    result = run_tarx("list", plain_archive, "--nonsense")
+    assert result.stdout == ""
+    assert "photos/a.jpg" not in result.stderr
+
+
+# --------------------------------------------------------------------------
+# FR-028: exit statuses are used consistently and exclusively
+# --------------------------------------------------------------------------
+
+
+def test_fr028_observed_status_set_is_exactly_zero_two_three(
+    run_tarx, plain_archive, random_bytes_file, tmp_path
+):
+    """FR-028: across every behaviour class the statuses are exactly {0, 2, 3}.
+
+    And 3 is produced *only* by the no-``--overwrite`` file-replacement
+    conflict: every other failure, including invocation errors and kind
+    collisions, is 2 (research R8).
+    """
+    populated = tmp_path / "populated"
+    assert run_tarx("extract", plain_archive, populated).returncode == 0
+
+    collision = tmp_path / "collide"
+    (collision / "photos" / "a.jpg").mkdir(parents=True)
+    blocker = tmp_path / "blocker"
+    blocker.write_bytes(b"x")
+
+    conflict_runs = [
+        run_tarx("extract", plain_archive, populated),
+    ]
+    other_runs = [
+        run_tarx("--help"),
+        run_tarx("list", plain_archive),
+        run_tarx("extract", plain_archive, tmp_path / "fresh"),
+        run_tarx("extract", plain_archive, populated, "--overwrite"),
+        run_tarx(),
+        run_tarx("frobnicate"),
+        run_tarx("list"),
+        run_tarx("list", tmp_path / "missing.tar"),
+        run_tarx("list", random_bytes_file),
+        run_tarx("extract", plain_archive, blocker),
+        run_tarx("extract", plain_archive, collision),
+        run_tarx("extract", plain_archive, collision, "--overwrite"),
+    ]
+
+    assert {r.returncode for r in conflict_runs} == {3}
+    assert {r.returncode for r in other_runs} <= {0, 2}
+    observed = {r.returncode for r in conflict_runs + other_runs}
+    assert observed == {0, 2, 3}
+
+
+def test_sc006_every_requirement_is_named_by_some_test():
+    """SC-006: each of FR-001 ... FR-028 is traceable to a covering test.
+
+    Constitution Principle III requires the requirement-to-test mapping to be
+    traceable by test name, docstring, or explicit requirement id. Asserting
+    it here makes the mapping a merge gate rather than a one-off audit: adding
+    a requirement without a covering test fails the suite.
+    """
+    sources = sorted(pathlib.Path(__file__).parent.glob("*.py"))
+    text = "\n".join(path.read_text() for path in sources)
+
+    expected = {f"FR-{number:03d}" for number in range(1, 29)}
+    named = {
+        f"FR-{int(match):03d}"
+        for match in re.findall(r"(?:FR-|fr)(\d{3})", text)
+    }
+    uncovered = sorted(expected - named)
+    assert uncovered == [], f"requirements with no covering test: {uncovered}"
