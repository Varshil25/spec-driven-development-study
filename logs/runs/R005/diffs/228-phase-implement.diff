+++ b/tests/conftest.py
@@ -0,0 +1,316 @@
+"""Shared fixtures: archive builders and a subprocess runner for ``python -m tarx``.
+
+Every archive is built into ``tmp_path`` so each test gets its own copy. The
+archives are built with ``tarfile`` directly rather than by shelling out to
+GNU ``tar``, because several of the cases the specification calls out (a
+directory member with no files, the same path stored twice, a member whose
+name escapes the destination) cannot be produced conveniently with ``tar``.
+One fixture deliberately uses GNU ``tar`` -- see :func:`gnu_tar_dir_archive`,
+which exists to prove FR-008 against directory headers that really do store a
+trailing separator (research R3).
+"""
+
+import io
+import os
+import subprocess
+import sys
+import tarfile
+from pathlib import Path
+
+import pytest
+
+# Repository root: tests/ sits directly beneath it, and the package lives in src/.
+REPO_ROOT = Path(__file__).resolve().parents[1]
+SRC_DIR = REPO_ROOT / "src"
+
+# Distinct known bytes, of different lengths, so a mixed-up extraction cannot
+# accidentally pass a byte-identity assertion.
+CONTENT_A = b"alpha-contents-of-a"
+CONTENT_B = b"bravo-contents-of-b!!"
+
+# The two members of the plain/gzip archive pair, in archive order.
+PHOTO_MEMBERS = {
+    "photos/a.jpg": CONTENT_A,
+    "photos/b.jpg": CONTENT_B,
+}
+
+
+# --------------------------------------------------------------------------
+# Low-level archive-building helpers
+# --------------------------------------------------------------------------
+
+
+def add_file(tar, name, data):
+    """Add a regular-file member named ``name`` holding exactly ``data``."""
+    info = tarfile.TarInfo(name)
+    info.size = len(data)
+    info.mtime = 0
+    info.mode = 0o644
+    tar.addfile(info, io.BytesIO(data))
+
+
+def add_dir(tar, name):
+    """Add a directory member named ``name``."""
+    info = tarfile.TarInfo(name)
+    info.type = tarfile.DIRTYPE
+    info.mtime = 0
+    info.mode = 0o755
+    tar.addfile(info)
+
+
+def add_symlink(tar, name, linkname):
+    """Add a symbolic-link member -- a member of neither handled kind."""
+    info = tarfile.TarInfo(name)
+    info.type = tarfile.SYMTYPE
+    info.linkname = linkname
+    info.mtime = 0
+    tar.addfile(info)
+
+
+def build_photo_archive(path, mode):
+    """Write the two-member photo archive to ``path`` using ``mode``."""
+    with tarfile.open(path, mode) as tar:
+        for name, data in PHOTO_MEMBERS.items():
+            add_file(tar, name, data)
+    return path
+
+
+# --------------------------------------------------------------------------
+# Archive fixtures
+# --------------------------------------------------------------------------
+
+
+@pytest.fixture
+def archive_members():
+    """The member name -> contents mapping of the photo archives, in order."""
+    return dict(PHOTO_MEMBERS)
+
+
+@pytest.fixture
+def plain_archive(tmp_path):
+    """(a) An uncompressed archive: ``photos/a.jpg`` then ``photos/b.jpg``."""
+    return build_photo_archive(tmp_path / "photos.tar", "w")
+
+
+@pytest.fixture
+def gzip_archive(tmp_path):
+    """(b) The gzip-compressed twin of :func:`plain_archive`."""
+    return build_photo_archive(tmp_path / "photos.tar.gz", "w:gz")
+
+
+@pytest.fixture
+def mislabeled_archive(tmp_path):
+    """(c) A gzip-compressed archive deliberately *named* ``mislabeled.tar``.
+
+    Proves compression is detected from content, not from the name (FR-018).
+    """
+    return build_photo_archive(tmp_path / "mislabeled.tar", "w:gz")
+
+
+@pytest.fixture
+def nested_archive(tmp_path):
+    """(d) A nested archive plus a directory member holding no files.
+
+    Members, in archive order:
+
+    * ``nest`` and ``nest/a`` -- explicit directory members
+    * ``nest/a/one.txt`` -- a regular file under an explicit directory
+    * ``nest/a/b/c/deep.txt`` -- a regular file whose parents ``b`` and ``c``
+      have *no* directory members, so they must be created on demand (FR-011)
+    * ``nest/empty`` -- a directory member with nothing in it (FR-011)
+
+    Two regular files in total, so a correct count reports ``2``.
+    """
+    path = tmp_path / "nested.tar"
+    with tarfile.open(path, "w") as tar:
+        add_dir(tar, "nest")
+        add_dir(tar, "nest/a")
+        add_file(tar, "nest/a/one.txt", b"one")
+        add_file(tar, "nest/a/b/c/deep.txt", b"deep")
+        add_dir(tar, "nest/empty")
+    return path
+
+
+@pytest.fixture
+def empty_archive(tmp_path):
+    """(e) A *valid* archive with zero members (research R5).
+
+    Distinct from :func:`zero_byte_file`: this one opens cleanly and lists
+    nothing, where a zero-byte file is not an archive at all.
+    """
+    path = tmp_path / "empty.tar"
+    with tarfile.open(path, "w"):
+        pass
+    return path
+
+
+@pytest.fixture
+def zero_byte_file(tmp_path):
+    """(f) A zero-byte file -- *not* a valid archive (research R4/R5)."""
+    path = tmp_path / "zero.tar"
+    path.write_bytes(b"")
+    return path
+
+
+@pytest.fixture
+def truncated_archive(tmp_path):
+    """A valid archive cut off mid-member.
+
+    Opens cleanly -- the first header is intact -- and only fails once
+    ``tarfile`` parses past the end of the data, so it exercises the
+    *mid-parse* failure path rather than the open path (FR-024, FR-027).
+    """
+    whole = tmp_path / "whole.tar"
+    with tarfile.open(whole, "w") as tar:
+        for name in ("a.txt", "b.txt", "c.txt"):
+            add_file(tar, name, b"x" * 3000)
+    path = tmp_path / "truncated.tar"
+    path.write_bytes(whole.read_bytes()[:4096])
+    return path
+
+
+@pytest.fixture
+def random_bytes_file(tmp_path):
+    """(g) A file of random bytes -- not a valid archive."""
+    path = tmp_path / "junk.bin"
+    path.write_bytes(os.urandom(512))
+    return path
+
+
+@pytest.fixture
+def symlink_archive(tmp_path):
+    """(h) An archive holding a symbolic link beside a file and a directory.
+
+    Members, in archive order: ``mix`` (directory), ``mix/real.txt``
+    (regular file), ``mix/link.txt`` (symbolic link). The link is listed
+    (FR-007) but skipped and not counted on extraction (FR-016).
+    """
+    path = tmp_path / "symlink.tar"
+    with tarfile.open(path, "w") as tar:
+        add_dir(tar, "mix")
+        add_file(tar, "mix/real.txt", b"real")
+        add_symlink(tar, "mix/link.txt", "real.txt")
+    return path
+
+
+@pytest.fixture
+def duplicate_archive(tmp_path):
+    """An archive storing the same member path twice with different contents.
+
+    Built programmatically because GNU ``tar`` will not produce it
+    conveniently. ``list`` must print the path twice -- no de-duplication
+    (FR-006) -- while ``extract`` must leave the *later* contents on disk and
+    count the path *once* (FR-015, research R9).
+    """
+    path = tmp_path / "duplicate.tar"
+    with tarfile.open(path, "w") as tar:
+        add_file(tar, "dup/same.txt", b"first-write")
+        add_file(tar, "dup/same.txt", b"second-write-wins")
+    return path
+
+
+@pytest.fixture
+def duplicate_contents():
+    """The two payloads of :func:`duplicate_archive`, in archive order."""
+    return (b"first-write", b"second-write-wins")
+
+
+@pytest.fixture
+def zero_length_member_archive(tmp_path):
+    """An archive holding a zero-length regular file beside a non-empty one.
+
+    Per the spec's Edge Cases, a zero-length archived file is recreated as an
+    empty file and *is* counted in the summary -- so this archive extracts to
+    ``extracted 2 files``.
+    """
+    path = tmp_path / "zerolen.tar"
+    with tarfile.open(path, "w") as tar:
+        add_file(tar, "zl/empty.txt", b"")
+        add_file(tar, "zl/full.txt", b"full")
+    return path
+
+
+# Member names that must never be written relative to the destination. Each is
+# verified to round-trip through tarfile verbatim, so the containment check
+# really does see the name written here (FR-026).
+ESCAPING_NAMES = (
+    "/etc/escape.txt",  # absolute POSIX path
+    "../escape.txt",  # traverses straight out
+    "a/../../escape.txt",  # normalizes to ../escape.txt
+    "C:/escape.txt",  # Windows drive letter, forward slashes
+    "C:\\escape.txt",  # Windows drive letter, backslashes
+    "\\\\server\\share\\escape.txt",  # UNC prefix
+    "//server/share/escape.txt",  # UNC prefix, POSIX-absolute form
+)
+
+
+@pytest.fixture
+def escaping_archives(tmp_path):
+    """``{member name: archive path}`` for every escaping-member case.
+
+    One single-member archive per name, so each diagnostic can be asserted
+    against the member it names. Built with ``tarfile`` directly because GNU
+    ``tar`` will not conveniently produce these (quickstart.md *Scenario 4*,
+    data-model.md *Member name validation*).
+    """
+    archives = {}
+    for index, name in enumerate(ESCAPING_NAMES):
+        path = tmp_path / f"escape{index}.tar"
+        with tarfile.open(path, "w") as tar:
+            add_file(tar, name, b"escaped")
+        archives[name] = path
+    return archives
+
+
+@pytest.fixture
+def gnu_tar_dir_archive(tmp_path):
+    """An archive built by system GNU ``tar``, which stores dirs as ``real/``.
+
+    Research R3 established that ``tarfile`` strips the trailing separator
+    while parsing the header, so FR-008 needs no code of our own -- but that
+    claim is only worth anything if a test asserts it against a real GNU
+    ``tar`` archive rather than one ``tarfile`` wrote itself.
+
+    Skipped when ``tar`` is unavailable.
+    """
+    tar_bin = "/usr/bin/tar"
+    if not os.path.exists(tar_bin):
+        pytest.skip("system GNU tar is not available")
+    tree = tmp_path / "tree"
+    (tree / "real" / "sub").mkdir(parents=True)
+    (tree / "real" / "sub" / "leaf.txt").write_bytes(b"leaf")
+    path = tmp_path / "gnu.tar"
+    subprocess.run(
+        [tar_bin, "-cf", str(path), "-C", str(tree), "real"],
+        check=True,
+        capture_output=True,
+    )
+    return path
+
+
+# --------------------------------------------------------------------------
+# Subprocess runner
+# --------------------------------------------------------------------------
+
+
+@pytest.fixture
+def run_tarx():
+    """Run ``python -m tarx`` as a subprocess and return the completed process.
+
+    ``PYTHONPATH`` is set explicitly in the child environment: ``pytest.ini``'s
+    ``pythonpath`` option affects only the pytest process, not children
+    (research R10).
+    """
+
+    def _run(*argv, cwd=None):
+        env = dict(os.environ)
+        env["PYTHONPATH"] = str(SRC_DIR)
+        return subprocess.run(
+            [sys.executable, "-m", "tarx", *[str(a) for a in argv]],
+            cwd=str(cwd) if cwd is not None else None,
+            env=env,
+            capture_output=True,
+            text=True,
+        )
+
+    return _run
