new file mode 100644
index 0000000..9fab0fc
--- /dev/null
+++ b/tests/test_failures.py
@@ -0,0 +1,246 @@
+"""FR-024 ... FR-028: diagnostics, containment, and exit statuses."""
+
+import os
+
+import pytest
+
+BOTH_COMMANDS = ("list", "extract")
+
+
+def assert_clean_failure(result, status, needle):
+    """Assert the shape every failure must have (FR-027, FR-028, SC-005).
+
+    Non-empty stderr, exactly one line, naming the offending path or member,
+    empty stdout, the assigned exit status, and no Python traceback.
+    """
+    assert result.returncode == status
+    assert result.stdout == ""
+    assert result.stderr != ""
+    assert len(result.stderr.splitlines()) == 1
+    assert needle in result.stderr
+    assert "Traceback (most recent call last)" not in result.stderr
+
+
+def run_either(run_tarx, command, archive, tmp_path):
+    """Invoke ``command`` against ``archive``, supplying DEST when needed."""
+    if command == "extract":
+        return run_tarx(command, archive, tmp_path / "out")
+    return run_tarx(command, archive)
+
+
+# --------------------------------------------------------------------------
+# FR-024: the archive is missing, unreadable, a directory, or not a tar
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("command", BOTH_COMMANDS)
+def test_fr024_missing_archive(run_tarx, command, tmp_path):
+    """FR-024: a nonexistent archive path names the path and exits 2."""
+    missing = tmp_path / "missing.tar"
+    result = run_either(run_tarx, command, missing, tmp_path)
+    assert_clean_failure(
+        result, 2, f"tarx: cannot read archive '{missing}': no such file"
+    )
+
+
+@pytest.mark.parametrize("command", BOTH_COMMANDS)
+def test_fr024_archive_is_a_directory(run_tarx, command, tmp_path):
+    """FR-024: an archive path that is a directory names it and exits 2."""
+    directory = tmp_path / "a-directory"
+    directory.mkdir()
+    result = run_either(run_tarx, command, directory, tmp_path)
+    assert_clean_failure(
+        result, 2, f"tarx: cannot read archive '{directory}': is a directory"
+    )
+
+
+@pytest.mark.parametrize("command", BOTH_COMMANDS)
+def test_fr024_unreadable_archive(run_tarx, command, plain_archive, tmp_path):
+    """FR-024: an unreadable archive names the path and exits 2.
+
+    Skipped under root, which bypasses the permission bits entirely.
+    """
+    if os.geteuid() == 0:
+        pytest.skip("running as root: mode 0o000 does not deny access")
+    plain_archive.chmod(0o000)
+    result = run_either(run_tarx, command, plain_archive, tmp_path)
+    assert_clean_failure(
+        result, 2, f"tarx: cannot read archive '{plain_archive}': permission denied"
+    )
+
+
+@pytest.mark.parametrize("command", BOTH_COMMANDS)
+def test_fr024_random_bytes_is_not_an_archive(
+    run_tarx, command, random_bytes_file, tmp_path
+):
+    """FR-024: a file of random bytes is reported as not a valid archive.
+
+    ``tarfile.ReadError``'s own text is multi-line and enumerates every
+    compression method tried, so it is replaced rather than forwarded
+    (research R4) -- which is what keeps the single-line assertion true.
+    """
+    result = run_either(run_tarx, command, random_bytes_file, tmp_path)
+    assert_clean_failure(
+        result, 2, f"tarx: '{random_bytes_file}' is not a valid tar archive"
+    )
+
+
+@pytest.mark.parametrize("command", BOTH_COMMANDS)
+def test_fr024_zero_byte_file_is_not_an_archive(
+    run_tarx, command, zero_byte_file, tmp_path
+):
+    """FR-024: a zero-byte file is *not* a valid archive and exits 2.
+
+    Deliberately asserted apart from the valid-empty-archive success case
+    (``test_list``, ``test_extract``), because the two are easy to conflate:
+    an archive of only end-of-archive blocks succeeds, a zero-byte file does
+    not (research R5).
+    """
+    result = run_either(run_tarx, command, zero_byte_file, tmp_path)
+    assert_clean_failure(
+        result, 2, f"tarx: '{zero_byte_file}' is not a valid tar archive"
+    )
+
+
+@pytest.mark.parametrize("command", BOTH_COMMANDS)
+def test_fr024_truncated_archive_fails_mid_parse_without_traceback(
+    run_tarx, command, truncated_archive, tmp_path
+):
+    """FR-024 / FR-027: a truncated archive is diagnosed, not traced back.
+
+    This archive's first header is intact, so it opens cleanly and only fails
+    once ``tarfile`` reads past the end of the data -- long after the open.
+    Both commands must still report a one-line diagnostic and exit 2.
+    """
+    result = run_tarx(command, truncated_archive) if command == "list" else run_tarx(
+        command, truncated_archive, tmp_path / "out"
+    )
+    assert result.returncode == 2
+    assert f"tarx: '{truncated_archive}' is not a valid tar archive" in result.stderr
+    assert "Traceback (most recent call last)" not in result.stderr
+    assert "ReadError" not in result.stderr
+
+
+def test_fr020_truncated_archive_writes_nothing_on_extract(
+    run_tarx, truncated_archive, tmp_path
+):
+    """FR-020: the mid-parse failure happens during planning, before any write.
+
+    The destination is therefore never even created.
+    """
+    dest = tmp_path / "out"
+    assert run_tarx("extract", truncated_archive, dest).returncode == 2
+    assert not dest.exists()
+
+
+def test_r5_zero_byte_and_empty_archive_differ(
+    run_tarx, zero_byte_file, empty_archive
+):
+    """Research R5: the zero-byte file fails where the empty archive succeeds."""
+    assert run_tarx("list", zero_byte_file).returncode == 2
+    assert run_tarx("list", empty_archive).returncode == 0
+
+
+# --------------------------------------------------------------------------
+# FR-025: the destination is unusable
+# --------------------------------------------------------------------------
+
+
+def test_fr025_destination_exists_as_regular_file(run_tarx, plain_archive, tmp_path):
+    """FR-025: a destination that is a regular file names it and exits 2.
+
+    US4 acceptance scenario 3: no extraction is performed, so the blocking
+    file is left exactly as it was.
+    """
+    blocker = tmp_path / "blocker"
+    blocker.write_bytes(b"i am not a directory")
+    result = run_tarx("extract", plain_archive, blocker)
+    assert_clean_failure(
+        result, 2, f"tarx: destination '{blocker}' exists and is not a directory"
+    )
+    assert blocker.read_bytes() == b"i am not a directory"
+
+
+def test_fr025_archive_error_reported_before_destination_error(
+    run_tarx, random_bytes_file, tmp_path
+):
+    """Research R8 follow-on: the archive is diagnosed before the destination.
+
+    Both conditions are exit 2, so no observable status depends on the order;
+    it is fixed only so the diagnostic is deterministic.
+    """
+    blocker = tmp_path / "blocker"
+    blocker.write_bytes(b"not a directory")
+    result = run_tarx("extract", random_bytes_file, blocker)
+    assert result.returncode == 2
+    assert "is not a valid tar archive" in result.stderr
+    assert "exists and is not a directory" not in result.stderr
+
+
+# --------------------------------------------------------------------------
+# FR-026: member paths that escape the destination
+# --------------------------------------------------------------------------
+
+
+def test_fr026_escaping_members_refused(run_tarx, escaping_archives, tmp_path):
+    """FR-026: every escaping member name is refused, naming that member.
+
+    Also asserts nothing was created outside the destination -- both at the
+    sibling path a ``../`` member would have reached and at the absolute path
+    an ``/etc/...`` member would have reached.
+    """
+    outside_sibling = tmp_path / "escape.txt"
+    for name, archive in escaping_archives.items():
+        dest = tmp_path / "out"
+        result = run_tarx("extract", archive, dest)
+        assert_clean_failure(
+            result,
+            2,
+            f"tarx: refusing to extract member '{name}' outside destination",
+        )
+        assert not outside_sibling.exists(), f"{name} wrote outside the destination"
+        assert not os.path.exists("/etc/escape.txt")
+
+
+def test_fr026_refusal_creates_no_destination(run_tarx, escaping_archives, tmp_path):
+    """FR-026 with FR-020: the refusal happens before the destination is made."""
+    archive = escaping_archives["../escape.txt"]
+    dest = tmp_path / "never-created"
+    assert run_tarx("extract", archive, dest).returncode == 2
+    assert not dest.exists()
+
+
+# --------------------------------------------------------------------------
+# FR-027, FR-028: every failure is a named one-line diagnostic
+# --------------------------------------------------------------------------
+
+
+def test_fr027_no_failure_is_signalled_by_status_alone(
+    run_tarx, plain_archive, random_bytes_file, tmp_path
+):
+    """FR-027 / SC-005: each failure writes a non-empty one-line diagnostic.
+
+    A sweep over one representative of every specified failure class.
+    """
+    dest = tmp_path / "out"
+    assert run_tarx("extract", plain_archive, dest).returncode == 0
+
+    blocker = tmp_path / "blocker"
+    blocker.write_bytes(b"x")
+    collision = tmp_path / "collide"
+    (collision / "photos" / "a.jpg").mkdir(parents=True)
+
+    failures = [
+        run_tarx("list", tmp_path / "missing.tar"),
+        run_tarx("list", random_bytes_file),
+        run_tarx("list", tmp_path),
+        run_tarx("extract", plain_archive, blocker),
+        run_tarx("extract", plain_archive, collision),
+        run_tarx("extract", plain_archive, dest),
+    ]
+    for result in failures:
+        assert result.returncode != 0
+        assert result.stdout == ""
+        assert result.stderr.startswith("tarx: ")
+        assert len(result.stderr.splitlines()) == 1
+        assert "Traceback (most recent call last)" not in result.stderr
