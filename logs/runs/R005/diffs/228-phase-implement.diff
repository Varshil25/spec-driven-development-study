+"""Command-line interface for ``tarx``: list and extract tar archives.
+
+Two subcommands are provided:
+
+* ``list ARCHIVE`` prints the recorded name of every archive member, one per
+  line, in archive order.
+* ``extract ARCHIVE DEST [--overwrite]`` recreates regular-file and directory
+  members under ``DEST`` and prints ``extracted N files``.
+
+All runtime behaviour uses the standard library only (Constitution Principle I).
+Every failure is raised as a :class:`TarxError` and formatted in exactly one
+place -- :func:`main` -- which is also the only chooser of exit statuses
+(FR-027, FR-028).
+"""
+
+import argparse
+import posixpath
+import shutil
+import sys
+import tarfile
+from pathlib import Path
+
+# The complete set of exit statuses this program uses, consistently and
+# exclusively (FR-028). No numeric status literal appears anywhere else.
+EXIT_OK = 0
+EXIT_ERROR = 2
+EXIT_CONFLICT = 3
+
+# The two member kinds this tool handles. Members of neither kind are skipped
+# (FR-016), so they need no name of their own.
+KIND_FILE = "file"
+KIND_DIR = "dir"
+
+# Fixed copy-buffer size: extraction streams in chunks of this many bytes so
+# memory does not grow with the size of the largest member (SC-007, research R6).
+COPY_BUFFER_SIZE = 64 * 1024
+
+
+class TarxError(Exception):
+    """A specified failure, carrying its diagnostic and its exit status.
+
+    ``message`` is human-readable, one line, and names the offending path or
+    member (FR-027). ``code`` is either ``EXIT_ERROR`` or ``EXIT_CONFLICT``;
+    ``EXIT_OK`` is never carried by an error (FR-028).
+
+    A class is used here, rather than a plain tuple, only because Python's
+    ``raise`` requires an exception type -- the one place Principle IV's
+    "prefer a plain data structure" is overridden by the language.
+    """
+
+    def __init__(self, message, code):
+        super().__init__(message)
+        self.message = message
+        self.code = code
+
+
+def open_archive(path):
+    """Open ``path`` as a tar archive, sniffing compression from its content.
+
+    ``mode="r:*"`` is written explicitly so the content-sniffing intent is
+    readable; it detects gzip (and other) compression from the stream rather
+    than from the file name (FR-018, research R2).
+
+    Every failure becomes a :class:`TarxError` carrying this project's own
+    one-line message. ``tarfile.ReadError``'s own text is never forwarded:
+    research R4 verified it is multi-line and would violate FR-027
+    (FR-018, FR-024).
+    """
+    try:
+        return tarfile.open(path, mode="r:*")
+    except FileNotFoundError:
+        raise TarxError(f"cannot read archive '{path}': no such file", EXIT_ERROR)
+    except IsADirectoryError:
+        raise TarxError(f"cannot read archive '{path}': is a directory", EXIT_ERROR)
+    except PermissionError:
+        raise TarxError(f"cannot read archive '{path}': permission denied", EXIT_ERROR)
+    except tarfile.ReadError:
+        raise TarxError(f"'{path}' is not a valid tar archive", EXIT_ERROR)
+    except OSError as exc:
+        reason = exc.strerror or str(exc)
+        raise TarxError(f"cannot read archive '{path}': {reason}", EXIT_ERROR)
+
+
+def read_failure(path, exc):
+    """Return the :class:`TarxError` for a failure while reading ``path``.
+
+    Used by the mid-parse backstops, where ``tarfile`` can raise long after a
+    successful open -- a truncated archive, or an I/O error on the underlying
+    file. ``ReadError``'s own multi-line text is never forwarded (research R4).
+    """
+    if isinstance(exc, tarfile.ReadError):
+        return TarxError(f"'{path}' is not a valid tar archive", EXIT_ERROR)
+    reason = getattr(exc, "strerror", None) or str(exc)
+    return TarxError(f"cannot read archive '{path}': {reason}", EXIT_ERROR)
+
+
+def write_failure(path, exc):
+    """Return the :class:`TarxError` for a failure while writing ``path``."""
+    reason = getattr(exc, "strerror", None) or str(exc)
+    return TarxError(f"cannot write to destination '{path}': {reason}", EXIT_ERROR)
+
+
+def escapes_destination(name):
+    """Return whether a recorded member name would write outside the destination.
+
+    A **purely lexical** check on the recorded name, with no filesystem
+    access: it cannot be defeated by symlinks already present inside the
+    destination, and it runs before the destination exists (FR-026,
+    research R11).
+
+    ``os.path.realpath`` containment checks were rejected for exactly those
+    reasons. Note that ``posixpath.isabs`` catches ``/etc/...`` and the
+    POSIX-absolute UNC form ``//server/...``, but not a Windows drive letter
+    or a backslash UNC prefix, so those are checked explicitly.
+    """
+    if posixpath.isabs(name):
+        return True
+    if len(name) >= 2 and name[0].isalpha() and name[1] == ":":
+        return True
+    if name.startswith("\\\\"):
+        return True
+    normalized = posixpath.normpath(name)
+    return normalized == ".." or normalized.startswith("../")
+
+
+def validate_destination(dest):
+    """Reject a destination that exists as something other than a directory.
+
+    Called after the archive has opened successfully and before planning, so
+    an unusable archive is always diagnosed ahead of an unusable destination
+    (FR-025, research R8 follow-on decision).
+    """
+    if dest.exists() and not dest.is_dir():
+        raise TarxError(
+            f"destination '{dest}' exists and is not a directory", EXIT_ERROR
+        )
+
+
+def cmd_list(args):
+    """Print the recorded name of every archive member, one per line.
+
+    Iterates the ``TarFile`` object directly rather than calling
+    ``getmembers()``, so member metadata is consumed as it is parsed and
+    memory stays flat with respect to the member count (research R6).
+
+    ``member.name`` is printed verbatim: ``tarfile`` already strips the
+    trailing separator from directory headers, so FR-008 needs no code here
+    (research R3). No sorting, filtering, or de-duplication is applied
+    (FR-005, FR-006, FR-007, FR-008, FR-009).
+    """
+    path = args.archive
+    with open_archive(path) as tar:
+        try:
+            for member in tar:
+                print(member.name)
+        except (tarfile.ReadError, OSError) as exc:
+            raise read_failure(path, exc)
+    return EXIT_OK
+
+
+def member_target(name, dest):
+    """Resolve a member's recorded ``name`` to its path under ``dest``.
+
+    Purely lexical, with **no filesystem access**, so it can run before the
+    destination exists. ``posixpath.normpath`` collapses ``.`` and ``..``
+    segments in the recorded name; rejecting the names that escape is a
+    separate concern, handled before this result is ever written
+    (data-model.md *Member name validation*).
+    """
+    return Path(dest) / posixpath.normpath(name)
+
+
+def needed_parents(dest, name):
+    """Yield each directory between ``dest`` and a member's target, outermost first.
+
+    Purely lexical, like :func:`member_target`: the member's recorded name is
+    normalized and split, so this never touches the filesystem and never
+    raises on a name that escapes the destination.
+    """
+    current = Path(dest)
+    for part in posixpath.normpath(name).split("/")[:-1]:
+        if part in ("", ".", ".."):
+            continue
+        current = current / part
+        yield current
+
+
+def build_plan(tar, dest):
+    """Read every member and decide what to do, touching no files.
+
+    Returns ``(plan, violations, conflicts, collisions)`` -- plain lists, no
+    classes:
+
+    * ``plan`` -- ``(member, target_path, kind)`` triples in **preserved
+      archive order** (FR-006), so a path stored twice ends up with the later
+      entry's contents.
+    * ``violations`` -- *names* of members whose recorded path escapes the
+      destination. Exit 2 (FR-026). A violating member is left out of the
+      plan entirely, so no later check ever computes a path outside the
+      destination.
+    * ``conflicts`` -- destination *paths* of regular-file members that
+      already exist as regular files. Exit 3 unless ``--overwrite``
+      (FR-019).
+    * ``collisions`` -- ready-to-raise *messages* for kind mismatches, which
+      exit 2 regardless of ``--overwrite`` (FR-023). Messages rather than
+      paths because the three collision cases read differently; the one
+      diagnostic *format* still lives only in :func:`main`.
+
+    Every check reads the destination's **pre-existing** state and writes
+    nothing. Because all validation precedes any write, a path written earlier
+    in the same run can never be mistaken for a pre-existing conflict
+    (research R9).
+
+    Members are classified by exactly three cases: regular file, directory, or
+    other -- "other" members are dropped rather than counted, because nothing
+    in this specification reports a skipped total and the contract rules out
+    "totals beyond the specified lines" (FR-016, Principle IV).
+
+    ``getmembers()`` is used rather than streaming because extraction
+    needs two passes -- validate everything, then write -- and the metadata
+    for even 10,000 members is independent of member *contents*, so SC-007
+    still holds (research R6).
+    """
+    plan = []
+    violations = []
+    conflicts = []
+    collisions = []
+
+    for member in tar.getmembers():
+        if member.isreg():
+            kind = KIND_FILE
+        elif member.isdir():
+            kind = KIND_DIR
+        else:
+            # Members of neither kind are skipped before their name matters
+            # for writing, so containment never rejects a run over a member
+            # that would not have been written anyway (FR-016).
+            continue
+
+        if escapes_destination(member.name):
+            violations.append(member.name)
+            continue
+
+        target = member_target(member.name, dest)
+        plan.append((member, target, kind))
+
+        # A non-directory anywhere between the destination and the target
+        # would surface as a mid-write NotADirectoryError or FileExistsError;
+        # catch it here, while nothing has been written yet.
+        for parent in needed_parents(dest, member.name):
+            if parent.exists() and not parent.is_dir():
+                collisions.append(
+                    f"cannot replace '{parent}' with directory "
+                    f"from member '{member.name}'"
+                )
+
+        if kind == KIND_FILE:
+            if target.is_dir():
+                collisions.append(
+                    f"cannot replace directory '{target}' with file "
+                    f"from member '{member.name}'"
+                )
+            elif target.exists():
+                conflicts.append(target)
+        elif target.exists() and not target.is_dir():
+            # An existing *directory* here is not a conflict: structures
+            # merge, with or without --overwrite (FR-022).
+            collisions.append(
+                f"cannot replace '{target}' with directory "
+                f"from member '{member.name}'"
+            )
+
+    return plan, violations, conflicts, collisions
+
+
+def write_members(tar, plan):
+    """Execute ``plan`` and return the set of regular-file paths written.
+
+    A ``set`` rather than an integer counter, because a path stored twice in
+    one archive must contribute **once** to the reported count while the later
+    entry's contents win (FR-015, research R9).
+
+    Regular files are streamed with ``copyfileobj`` at a fixed buffer size --
+    never ``extractfile(...).read()``, which would buffer a whole member in
+    memory and fail SC-007. ``TarFile.extract``/``extractall`` are
+    deliberately not used: they overwrite unconditionally, cannot report a
+    count, and apply member metadata the spec puts out of scope
+    (research R11). Modes, ownership, and mtimes are therefore not reproduced.
+    """
+    written = set()
+    for member, target, kind in plan:
+        if kind == KIND_DIR:
+            target.mkdir(parents=True, exist_ok=True)
+            continue
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with tar.extractfile(member) as source, open(target, "wb") as destination:
+            shutil.copyfileobj(source, destination, length=COPY_BUFFER_SIZE)
+        written.add(target)
+    return written
+
+
+def cmd_extract(args):
+    """Extract an archive's files and directories under a destination.
+
+    A two-phase pipeline: open the archive, build the plan (read-only with
+    respect to the filesystem), prepare the destination, then run the write
+    pass. The destination is created only once planning has succeeded, so a
+    run that fails during planning leaves no new directories behind
+    (FR-012, FR-020).
+
+    Validation runs in a fixed order, and every step of it precedes the first
+    write::
+
+        archive opens and parses        -> 2
+        destination is not a directory  -> 2
+        member path escapes             -> 2
+        kind collision                  -> 2
+        overwrite conflict, no flag     -> 3
+        writes begin
+
+    Exit 2 outranks exit 3, so status 3 always means "re-run with
+    ``--overwrite``" (research R8, contracts *Validation order within
+    ``extract``*). Nothing above "writes begin" touches a file, which is what
+    makes FR-020 a structural property rather than a promise.
+    """
+    path = args.archive
+    dest = Path(args.dest)
+    with open_archive(path) as tar:
+        validate_destination(dest)
+
+        # build_plan calls getmembers(), which parses the remaining headers
+        # and so can fail long after a successful open -- a truncated archive
+        # raises here, not at open time. Without this conversion the failure
+        # would escape main as a traceback (FR-024, FR-027).
+        try:
+            plan, violations, conflicts, collisions = build_plan(tar, dest)
+        except (tarfile.ReadError, OSError) as exc:
+            raise read_failure(path, exc)
+
+        if violations:
+            raise TarxError(
+                f"refusing to extract member '{violations[0]}' outside destination",
+                EXIT_ERROR,
+            )
+        if collisions:
+            raise TarxError(collisions[0], EXIT_ERROR)
+        if conflicts and not args.overwrite:
+            raise TarxError(
+                f"'{conflicts[0]}' already exists; use --overwrite to replace it",
+                EXIT_CONFLICT,
+            )
+
+        try:
+            dest.mkdir(parents=True, exist_ok=True)
+        except OSError as exc:
+            raise write_failure(dest, exc)
+
+        # Backstop for anything that can only fail once writing has started:
+        # a permission error on a target, or an archive that turns out to be
+        # truncated part-way through streaming. Converted to a named
+        # diagnostic and exit 2 -- never swallowed, and never reported as
+        # success (spec Edge Cases *Partial write interrupted by an error*).
+        # Files already written are left in place; no rollback is required.
+        try:
+            written = write_members(tar, plan)
+        except tarfile.ReadError as exc:
+            raise read_failure(path, exc)
+        except OSError as exc:
+            raise write_failure(getattr(exc, "filename", None) or dest, exc)
+
+    print(f"extracted {len(written)} files")
+    return EXIT_OK
+
+
+def build_parser():
+    """Return the argument parser for ``tarx``.
+
+    ``prog`` is set explicitly because running a package as ``python -m tarx``
+    leaves ``sys.argv[0]`` pointing at ``__main__.py``, which would render
+    ``usage: __main__.py ...`` and undercut SC-008 (FR-001, research R7).
+    """
+    parser = argparse.ArgumentParser(
+        prog="tarx",
+        description="List and extract tar archives.",
+    )
+    subparsers = parser.add_subparsers(
+        dest="command", required=True, metavar="COMMAND"
+    )
+
+    # FR-002: exactly one positional argument, no options.
+    list_parser = subparsers.add_parser(
+        "list", help="print every archive member, one per line"
+    )
+    list_parser.add_argument("archive", metavar="ARCHIVE", help="path to a tar archive")
+
+    # FR-003: exactly two positional arguments, plus the --overwrite flag.
+    extract_parser = subparsers.add_parser(
+        "extract", help="extract an archive's files and directories"
+    )
+    extract_parser.add_argument(
+        "archive", metavar="ARCHIVE", help="path to a tar archive"
+    )
+    extract_parser.add_argument(
+        "dest", metavar="DEST", help="directory to extract into"
+    )
+    extract_parser.add_argument(
+        "--overwrite",
+        action="store_true",
+        help="replace existing regular files at colliding paths",
+    )
+
+    return parser
+
+
+def main(argv):
+    """Parse ``argv``, dispatch to a subcommand, and return an exit status.
+
+    This is the only place in the codebase that formats a diagnostic or
+    chooses an exit status (FR-027, FR-028). Invocation errors are handled by
+    ``argparse`` itself, which prints usage to stderr and exits 2 (FR-004).
+    """
+    parser = build_parser()
+    args = parser.parse_args(argv)
+    handlers = {"list": cmd_list, "extract": cmd_extract}
+    try:
+        return handlers[args.command](args)
+    except TarxError as error:
+        sys.stderr.write(f"tarx: {error.message}\n")
+        return error.code
