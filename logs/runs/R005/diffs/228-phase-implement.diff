+"""FR-010 ... FR-016: extraction contents, directories, count, and skipping."""
+
+
+def test_fr010_regular_files_recreated_byte_identically(
+    run_tarx, plain_archive, archive_members, tmp_path
+):
+    """FR-010, SC-002: each regular file lands at ``DEST/<name>`` with identical bytes."""
+    dest = tmp_path / "out"
+    result = run_tarx("extract", plain_archive, dest)
+    assert result.returncode == 0
+    for name, data in archive_members.items():
+        assert (dest / name).is_file()
+        assert (dest / name).read_bytes() == data
+
+
+def test_fr011_needed_and_empty_directories_are_created(
+    run_tarx, nested_archive, tmp_path
+):
+    """FR-011: directories needed by a member *and* empty directory members.
+
+    ``nest/a/b`` and ``nest/a/b/c`` have no directory members of their own and
+    must be created on demand; ``nest/empty`` is a directory member that
+    contains nothing and must still appear.
+    """
+    dest = tmp_path / "out"
+    assert run_tarx("extract", nested_archive, dest).returncode == 0
+    assert (dest / "nest" / "a").is_dir()
+    assert (dest / "nest" / "a" / "b" / "c").is_dir()
+    assert (dest / "nest" / "a" / "b" / "c" / "deep.txt").read_bytes() == b"deep"
+    assert (dest / "nest" / "empty").is_dir()
+    assert list((dest / "nest" / "empty").iterdir()) == []
+
+
+def test_fr012_destination_and_missing_parents_are_created(
+    run_tarx, plain_archive, tmp_path
+):
+    """FR-012: a destination that does not exist is created, parents included."""
+    dest = tmp_path / "not" / "yet" / "there"
+    assert not dest.parent.exists()
+    result = run_tarx("extract", plain_archive, dest)
+    assert result.returncode == 0
+    assert dest.is_dir()
+    assert (dest / "photos" / "a.jpg").is_file()
+
+
+def test_fr013_non_colliding_pre_existing_entries_untouched(
+    run_tarx, plain_archive, tmp_path
+):
+    """FR-013: unrelated pre-existing content under DEST is left alone.
+
+    US2 acceptance scenario 5.
+    """
+    dest = tmp_path / "out"
+    (dest / "unrelated").mkdir(parents=True)
+    keeper = dest / "unrelated" / "keep.txt"
+    keeper.write_bytes(b"do not touch")
+    result = run_tarx("extract", plain_archive, dest)
+    assert result.returncode == 0
+    assert keeper.read_bytes() == b"do not touch"
+
+
+def test_fr014_success_prints_summary_line_only(run_tarx, plain_archive, tmp_path):
+    """FR-014, SC-002: stdout is exactly ``extracted N files\\n``, exit 0, stderr empty."""
+    result = run_tarx("extract", plain_archive, tmp_path / "out")
+    assert result.stdout == "extracted 2 files\n"
+    assert result.stderr == ""
+    assert result.returncode == 0
+
+
+def test_fr015_count_excludes_directories(run_tarx, nested_archive, tmp_path):
+    """FR-015: the count includes only regular files, not directory members.
+
+    The nested archive holds three directory members and two regular files.
+    """
+    result = run_tarx("extract", nested_archive, tmp_path / "out")
+    assert result.stdout == "extracted 2 files\n"
+
+
+def test_fr015_literal_word_files_when_count_is_one(
+    run_tarx, symlink_archive, tmp_path
+):
+    """FR-015: the literal word ``files`` is used even when N is 1."""
+    result = run_tarx("extract", symlink_archive, tmp_path / "out")
+    assert result.stdout == "extracted 1 files\n"
+
+
+def test_fr015_literal_word_files_when_count_is_zero(
+    run_tarx, empty_archive, tmp_path
+):
+    """FR-015 and US2 scenario 4: ``files`` is used even when N is 0."""
+    result = run_tarx("extract", empty_archive, tmp_path / "out")
+    assert result.stdout == "extracted 0 files\n"
+    assert result.stderr == ""
+    assert result.returncode == 0
+
+
+def test_fr016_symlink_member_skipped_without_failing(
+    run_tarx, symlink_archive, tmp_path
+):
+    """FR-016: a member of neither handled kind is skipped and not counted.
+
+    The archive holds a directory, a regular file, and a symbolic link. The
+    link is neither created nor counted, and its presence is not an error.
+    """
+    dest = tmp_path / "out"
+    result = run_tarx("extract", symlink_archive, dest)
+    assert result.returncode == 0
+    assert result.stderr == ""
+    assert result.stdout == "extracted 1 files\n"
+    assert (dest / "mix").is_dir()
+    assert (dest / "mix" / "real.txt").read_bytes() == b"real"
+    assert not (dest / "mix" / "link.txt").exists()
+
+
+# --------------------------------------------------------------------------
+# Edge cases: duplicate member paths and zero-length members
+# --------------------------------------------------------------------------
+
+
+def test_fr015_duplicate_path_counted_once_later_contents_win(
+    run_tarx, duplicate_archive, duplicate_contents, tmp_path
+):
+    """FR-015: a path stored twice ends with the later contents, counted once.
+
+    Spec Edge Cases "Duplicate member names"; research R9. Writing in archive
+    order gives "later entry wins" for free, and counting distinct destination
+    paths rather than members processed gives the count.
+    """
+    _first, second = duplicate_contents
+    dest = tmp_path / "out"
+    result = run_tarx("extract", duplicate_archive, dest)
+    assert result.returncode == 0
+    assert result.stdout == "extracted 1 files\n"
+    assert (dest / "dup" / "same.txt").read_bytes() == second
+
+
+def test_zero_length_member_recreated_empty_and_counted(
+    run_tarx, zero_length_member_archive, tmp_path
+):
+    """Spec Edge Cases: a zero-length archived file is recreated and counted."""
+    dest = tmp_path / "out"
+    result = run_tarx("extract", zero_length_member_archive, dest)
+    assert result.returncode == 0
+    assert result.stdout == "extracted 2 files\n"
+    assert (dest / "zl" / "empty.txt").is_file()
+    assert (dest / "zl" / "empty.txt").read_bytes() == b""
+    assert (dest / "zl" / "full.txt").read_bytes() == b"full"
