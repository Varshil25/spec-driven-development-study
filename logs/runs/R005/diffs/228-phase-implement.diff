+"""FR-005 ... FR-009: ``list`` output content, order, membership, and status."""
+
+
+def test_fr005_one_member_per_newline_terminated_line(run_tarx, plain_archive):
+    """FR-005, SC-001: each member's path on its own newline-terminated line."""
+    result = run_tarx("list", plain_archive)
+    assert result.stdout == "photos/a.jpg\nphotos/b.jpg\n"
+
+
+def test_fr006_archive_order_is_not_sorted(run_tarx, nested_archive):
+    """FR-006: members come out in archive order, with no sorting applied.
+
+    The nested archive's recorded order differs from its sorted order --
+    ``nest/a/one.txt`` precedes ``nest/a/b/c/deep.txt`` on tape but follows it
+    alphabetically -- so a sorting implementation cannot pass this.
+    """
+    result = run_tarx("list", nested_archive)
+    lines = result.stdout.splitlines()
+    assert lines == [
+        "nest",
+        "nest/a",
+        "nest/a/one.txt",
+        "nest/a/b/c/deep.txt",
+        "nest/empty",
+    ]
+    assert lines != sorted(lines)
+
+
+def test_fr006_no_de_duplication(run_tarx, duplicate_archive):
+    """FR-006: a path stored twice is printed twice; no de-duplication."""
+    result = run_tarx("list", duplicate_archive)
+    assert result.stdout.splitlines() == ["dup/same.txt", "dup/same.txt"]
+
+
+def test_fr007_every_member_type_is_printed(run_tarx, symlink_archive):
+    """FR-007: directories and non-file/non-directory members are listed too.
+
+    No filtering is applied: the symbolic link appears even though
+    ``extract`` will skip it (FR-016).
+    """
+    result = run_tarx("list", symlink_archive)
+    assert result.stdout.splitlines() == ["mix", "mix/real.txt", "mix/link.txt"]
+
+
+def test_fr008_directory_names_have_no_trailing_separator(
+    run_tarx, gnu_tar_dir_archive
+):
+    """FR-008: directory member names print without a trailing separator.
+
+    Asserted against an archive written by system GNU ``tar``, whose
+    directory headers really do store ``real/`` -- an archive written by
+    ``tarfile`` itself would not exercise the stripping at all (research R3).
+    """
+    result = run_tarx("list", gnu_tar_dir_archive)
+    lines = result.stdout.splitlines()
+    assert lines, "expected at least the directory members to be listed"
+    assert [line for line in lines if line.endswith("/")] == []
+    assert "real" in lines
+    assert "real/sub" in lines
+
+
+def test_fr009_success_exits_zero_with_empty_stderr(run_tarx, plain_archive):
+    """FR-009: on success ``list`` exits 0 and writes nothing to stderr."""
+    result = run_tarx("list", plain_archive)
+    assert result.returncode == 0
+    assert result.stderr == ""
+
+
+def test_us1_scenario4_empty_archive_prints_nothing(run_tarx, empty_archive):
+    """US1 acceptance scenario 4: a valid archive with no members.
+
+    Prints nothing and exits 0, with no special-casing needed (research R5).
+    Contrast ``test_failures`` for the zero-byte file, which is *not* an
+    archive and exits 2.
+    """
+    result = run_tarx("list", empty_archive)
+    assert result.stdout == ""
+    assert result.stderr == ""
+    assert result.returncode == 0
diff --git a/tests/test_overwrite.py b/tests/test_overwrite.py
new file mode 100644
index 0000000..768ebbd
--- /dev/null
+++ b/tests/test_overwrite.py
@@ -0,0 +1,204 @@
+"""FR-019 ... FR-023: overwrite conflicts, ``--overwrite``, and kind collisions."""
+
+
+def snapshot(root):
+    """Return a ``{relative path: contents-or-marker}`` map of the whole tree.
+
+    Captures directories as well as files, so a run that creates, modifies,
+    truncates, or deletes anything under ``root`` changes the snapshot
+    (FR-020, SC-003).
+    """
+    entries = {}
+    for path in sorted(root.rglob("*")):
+        key = str(path.relative_to(root))
+        entries[key] = path.read_bytes() if path.is_file() else "<dir>"
+    return entries
+
+
+# --------------------------------------------------------------------------
+# FR-019 ... FR-022: the overwrite conflict and the flag that resolves it
+# --------------------------------------------------------------------------
+
+
+def test_fr019_conflict_without_flag_exits_three_with_diagnostic(
+    run_tarx, plain_archive, tmp_path
+):
+    """FR-019: an existing regular file at a file member's target → exit 3.
+
+    The diagnostic names the conflicting path and points at the flag that
+    resolves it; stdout stays empty.
+    """
+    dest = tmp_path / "out"
+    assert run_tarx("extract", plain_archive, dest).returncode == 0
+
+    result = run_tarx("extract", plain_archive, dest)
+    conflicting = dest / "photos" / "a.jpg"
+    expected = f"tarx: '{conflicting}' already exists; use --overwrite to replace it\n"
+    assert result.returncode == 3
+    assert result.stdout == ""
+    assert result.stderr == expected
+
+
+def test_fr020_failed_conflict_run_changes_nothing(
+    run_tarx, plain_archive, tmp_path
+):
+    """FR-020 / SC-003: the refused run leaves the destination byte-identical.
+
+    Verified by snapshotting the whole destination tree before and after.
+    Because every validation precedes the first write, this holds by
+    construction rather than by promise.
+    """
+    dest = tmp_path / "out"
+    assert run_tarx("extract", plain_archive, dest).returncode == 0
+    before = snapshot(dest)
+
+    result = run_tarx("extract", plain_archive, dest)
+    assert result.returncode == 3
+    assert snapshot(dest) == before
+
+
+def test_fr021_overwrite_replaces_contents_and_counts_them(
+    run_tarx, plain_archive, archive_members, tmp_path
+):
+    """FR-021, SC-004: with the flag, colliding files are replaced and counted."""
+    dest = tmp_path / "out"
+    assert run_tarx("extract", plain_archive, dest).returncode == 0
+    target = dest / "photos" / "a.jpg"
+    target.write_bytes(b"stale")
+
+    result = run_tarx("extract", plain_archive, dest, "--overwrite")
+    assert result.returncode == 0
+    assert result.stdout == "extracted 2 files\n"
+    assert result.stderr == ""
+    assert target.read_bytes() == archive_members["photos/a.jpg"]
+
+
+def test_fr022_existing_directory_for_directory_member_is_not_a_conflict(
+    run_tarx, nested_archive, tmp_path
+):
+    """FR-022: directory structures merge, with or without ``--overwrite``.
+
+    US3 acceptance scenario 4. The destination already holds directories at
+    the paths the archive stores as directory members; only the regular files
+    are new, so the run succeeds without the flag.
+    """
+    dest = tmp_path / "out"
+    (dest / "nest" / "a").mkdir(parents=True)
+    (dest / "nest" / "empty").mkdir(parents=True)
+
+    result = run_tarx("extract", nested_archive, dest)
+    assert result.returncode == 0
+    assert result.stdout == "extracted 2 files\n"
+    assert result.stderr == ""
+
+    with_flag = run_tarx("extract", nested_archive, dest, "--overwrite")
+    assert with_flag.returncode == 0
+    assert with_flag.stdout == "extracted 2 files\n"
+
+
+def test_us3_scenario3_partially_populated_destination_adds_nothing(
+    run_tarx, plain_archive, tmp_path
+):
+    """US3 scenario 3: a partial destination fails 3 and adds none of the rest."""
+    dest = tmp_path / "out"
+    (dest / "photos").mkdir(parents=True)
+    (dest / "photos" / "a.jpg").write_bytes(b"stale")
+
+    result = run_tarx("extract", plain_archive, dest)
+    assert result.returncode == 3
+    assert result.stdout == ""
+    assert (dest / "photos" / "a.jpg").read_bytes() == b"stale"
+    assert not (dest / "photos" / "b.jpg").exists()
+
+
+# --------------------------------------------------------------------------
+# FR-023: kind collisions, which exit 2 even when --overwrite is given
+# --------------------------------------------------------------------------
+
+
+def test_fr023_file_member_onto_existing_directory_exits_two(
+    run_tarx, plain_archive, tmp_path
+):
+    """FR-023: a directory is never replaced by a file, flag or no flag."""
+    dest = tmp_path / "out"
+    blocker = dest / "photos" / "a.jpg"
+    blocker.mkdir(parents=True)
+    expected = (
+        f"tarx: cannot replace directory '{blocker}' with file "
+        "from member 'photos/a.jpg'\n"
+    )
+
+    for argv in (
+        ("extract", plain_archive, dest),
+        ("extract", plain_archive, dest, "--overwrite"),
+    ):
+        result = run_tarx(*argv)
+        assert result.returncode == 2
+        assert result.stdout == ""
+        assert result.stderr == expected
+
+
+def test_fr023_directory_member_onto_existing_file_exits_two(
+    run_tarx, nested_archive, tmp_path
+):
+    """FR-023: a regular file is never replaced by a directory, flag or no flag."""
+    dest = tmp_path / "out"
+    dest.mkdir(parents=True)
+    blocker = dest / "nest"
+    blocker.write_bytes(b"in the way")
+    expected = (
+        f"tarx: cannot replace '{blocker}' with directory from member 'nest'\n"
+    )
+
+    for argv in (
+        ("extract", nested_archive, dest),
+        ("extract", nested_archive, dest, "--overwrite"),
+    ):
+        result = run_tarx(*argv)
+        assert result.returncode == 2
+        assert result.stdout == ""
+        assert result.stderr == expected
+
+
+def test_r8_regression_kind_collision_exits_two_not_three(
+    run_tarx, plain_archive, tmp_path
+):
+    """Research R8: a kind collision is exit 2 even without ``--overwrite``.
+
+    FR-019 read literally would say 3 here, but FR-023 and the Edge Cases
+    list are the more specific statements. Exit 3 must mean "re-running with
+    ``--overwrite`` would fix this", and it would not fix this -- so this case
+    is 2. This test locks that resolution in.
+    """
+    dest = tmp_path / "out"
+    (dest / "photos" / "a.jpg").mkdir(parents=True)
+
+    result = run_tarx("extract", plain_archive, dest)
+    assert result.returncode == 2
+    assert result.returncode != 3
+
+
+def test_non_directory_ancestor_reported_at_planning_time(
+    run_tarx, plain_archive, tmp_path
+):
+    """A non-directory between DEST and a target is a planning-time collision.
+
+    Without this check the failure would surface as a mid-write
+    ``NotADirectoryError`` traceback, after the destination had already been
+    created (data-model.md *ExtractionPlan*).
+    """
+    dest = tmp_path / "out"
+    dest.mkdir(parents=True)
+    blocker = dest / "photos"
+    blocker.write_bytes(b"not a directory")
+    expected = (
+        f"tarx: cannot replace '{blocker}' with directory "
+        "from member 'photos/a.jpg'\n"
+    )
+
+    result = run_tarx("extract", plain_archive, dest)
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr == expected
+    assert "Traceback (most recent call last)" not in result.stderr
+    assert blocker.read_bytes() == b"not a directory"
diff --git a/tests/test_performance.py b/tests/test_performance.py
new file mode 100644
index 0000000..6d39e0e
--- /dev/null
+++ b/tests/test_performance.py
@@ -0,0 +1,95 @@
+"""SC-007: timing on a 10,000-member archive and memory flat in member size.
+
+Kept in its own file because it is the only slow test in the suite
+(plan.md *Structure Decision*).
+"""
+
+import io
+import tarfile
+import time
+import tracemalloc
+
+import pytest
+
+MEMBER_COUNT = 10_000
+LIST_BUDGET_SECONDS = 5.0
+EXTRACT_BUDGET_SECONDS = 30.0
+
+# One member far larger than the 64 KiB copy buffer. If extraction ever
+# buffered a whole member, peak traced memory would jump by this much.
+LARGE_MEMBER_BYTES = 32 * 1024 * 1024
+PEAK_MEMORY_BUDGET_BYTES = 4 * 1024 * 1024
+
+
+@pytest.fixture(scope="module")
+def many_member_archive(tmp_path_factory):
+    """An archive of 10,000 small members, built once for the whole module."""
+    path = tmp_path_factory.mktemp("perf") / "many.tar"
+    payload = b"0123456789"
+    with tarfile.open(path, "w") as tar:
+        for index in range(MEMBER_COUNT):
+            info = tarfile.TarInfo(f"many/dir{index % 100}/member{index}.bin")
+            info.size = len(payload)
+            info.mtime = 0
+            tar.addfile(info, io.BytesIO(payload))
+    return path
+
+
+def test_sc007_list_of_ten_thousand_members_under_five_seconds(
+    run_tarx, many_member_archive
+):
+    """SC-007: a 10,000-member archive lists in under 5 seconds."""
+    start = time.perf_counter()
+    result = run_tarx("list", many_member_archive)
+    elapsed = time.perf_counter() - start
+
+    assert result.returncode == 0
+    assert len(result.stdout.splitlines()) == MEMBER_COUNT
+    assert elapsed < LIST_BUDGET_SECONDS, f"list took {elapsed:.2f}s"
+
+
+def test_sc007_extract_of_ten_thousand_members_under_thirty_seconds(
+    run_tarx, many_member_archive, tmp_path
+):
+    """SC-007: a 10,000-member archive extracts in under 30 seconds."""
+    start = time.perf_counter()
+    result = run_tarx("extract", many_member_archive, tmp_path / "out")
+    elapsed = time.perf_counter() - start
+
+    assert result.returncode == 0
+    assert result.stdout == f"extracted {MEMBER_COUNT} files\n"
+    assert elapsed < EXTRACT_BUDGET_SECONDS, f"extract took {elapsed:.2f}s"
+
+
+def test_sc007_memory_does_not_grow_with_largest_member(tmp_path):
+    """SC-007: peak memory stays flat with respect to the largest member.
+
+    Run in-process so ``tracemalloc`` can observe the extraction. The archive
+    holds a single member far larger than the copy buffer; because extraction
+    streams with ``copyfileobj`` at a fixed buffer size rather than calling
+    ``extractfile(...).read()``, the traced peak stays a small fraction of the
+    member's size (research R6).
+    """
+    from tarx.cli import main
+
+    archive = tmp_path / "large.tar"
+    with tarfile.open(archive, "w") as tar:
+        info = tarfile.TarInfo("large/payload.bin")
+        info.size = LARGE_MEMBER_BYTES
+        info.mtime = 0
+        tar.addfile(info, io.BytesIO(b"\0" * LARGE_MEMBER_BYTES))
+
+    dest = tmp_path / "out"
+    tracemalloc.start()
+    try:
+        status = main(["extract", str(archive), str(dest)])
+        _current, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+
+    assert status == 0
+    assert (dest / "large" / "payload.bin").stat().st_size == LARGE_MEMBER_BYTES
+    assert peak < PEAK_MEMORY_BUDGET_BYTES, (
+        f"peak traced memory {peak} bytes is not flat with respect to a "
+        f"{LARGE_MEMBER_BYTES}-byte member"
+    )