index 0000000..23527f5
--- /dev/null
+++ b/tests/test_compression.py
@@ -0,0 +1,65 @@
+"""FR-017, FR-018: gzip and plain archives behave identically; detection by content."""
+
+
+def test_fr017_list_identical_for_plain_and_gzip(run_tarx, plain_archive, gzip_archive):
+    """FR-017, SC-001: a gzip archive lists byte-identically to its plain twin."""
+    plain = run_tarx("list", plain_archive)
+    gzipped = run_tarx("list", gzip_archive)
+    assert gzipped.stdout == plain.stdout
+    assert gzipped.returncode == plain.returncode == 0
+    assert gzipped.stderr == plain.stderr == ""
+
+
+def test_fr018_list_detects_compression_from_content_not_name(
+    run_tarx, plain_archive, mislabeled_archive
+):
+    """FR-018: a gzip archive *named* ``mislabeled.tar`` lists correctly.
+
+    The name says uncompressed tar and the content says gzip. Detection comes
+    from the content, so the output matches the plain archive exactly
+    (research R2).
+    """
+    plain = run_tarx("list", plain_archive)
+    mislabeled = run_tarx("list", mislabeled_archive)
+    assert mislabeled.stdout == plain.stdout
+    assert mislabeled.returncode == 0
+    assert mislabeled.stderr == ""
+
+
+def _tree(root):
+    """Return a ``{relative path: contents}`` snapshot of every file under root."""
+    return {
+        str(p.relative_to(root)): p.read_bytes()
+        for p in sorted(root.rglob("*"))
+        if p.is_file()
+    }
+
+
+def test_fr017_extract_identical_for_plain_and_gzip(
+    run_tarx, plain_archive, gzip_archive, tmp_path
+):
+    """FR-017: extracting a gzip archive matches its plain twin exactly.
+
+    US2 acceptance scenario 2: identical file trees, summary lines, and
+    exit statuses.
+    """
+    plain_dest = tmp_path / "out-plain"
+    gzip_dest = tmp_path / "out-gzip"
+    plain = run_tarx("extract", plain_archive, plain_dest)
+    gzipped = run_tarx("extract", gzip_archive, gzip_dest)
+    assert gzipped.stdout == plain.stdout
+    assert gzipped.returncode == plain.returncode == 0
+    assert _tree(gzip_dest) == _tree(plain_dest)
+
+
+def test_fr018_extract_detects_compression_from_content_not_name(
+    run_tarx, plain_archive, mislabeled_archive, tmp_path
+):
+    """FR-018: extracting a gzip archive *named* ``.tar`` behaves identically."""
+    plain_dest = tmp_path / "out-plain"
+    mislabeled_dest = tmp_path / "out-mislabeled"
+    plain = run_tarx("extract", plain_archive, plain_dest)
+    mislabeled = run_tarx("extract", mislabeled_archive, mislabeled_dest)
+    assert mislabeled.stdout == plain.stdout
+    assert mislabeled.returncode == plain.returncode == 0
+    assert _tree(mislabeled_dest) == _tree(plain_dest)
