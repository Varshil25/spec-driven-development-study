@@ -0,0 +1,483 @@
+"""Compatibility with what came before.
+
+Covers FR-067 through FR-071: a record written by the previous version reads as neither one-time
+nor protected, everything feature 001 specified still holds for a snippet published without either
+option, every error this feature introduces keeps the established shape, no input the
+specification enumerates produces an unintended 500, and the pre-read body ceiling now admits the
+largest submission this specification deems valid.
+
+``tests/conftest.py`` and feature 001's eleven test modules are **not edited by this feature**,
+with one exception FR-068 explicitly permits: the closed-set assertion on the structured read
+response's fields in ``test_read.py`` is relaxed to the subset assertion feature 001's FR-017
+actually requires, because FR-064 adds two fields to that response. That they otherwise run
+unmodified is the evidence for FR-068 and SC-018, so
+``test_fr068_feature_001_suite_passes_unchanged`` pins every one of their digests and runs them,
+and ``test_fr068_the_two_added_fields_are_the_only_difference`` holds the relaxation to exactly
+what was permitted.
+"""
+
+import hashlib
+import json
+import subprocess
+import sys
+
+import pytest
+
+from conftest import REPO_ROOT, child_env, parse_raw_response
+from pastebin import store
+
+FAST_ITERATIONS = 1_000
+
+HEADER = "X-Paste-Password"
+
+#: ``tests/conftest.py`` and the eleven feature 001 test modules named in plan.md, with the SHA-256
+#: of each as it stood at this feature's baseline run (tasks.md T001). These files are the contract
+#: FR-068 and SC-018 are measured against: editing one would be a failure of this feature, not a
+#: fix, so the digests are pinned here rather than recomputed from whatever is on disk.
+#:
+#: ``test_read.py`` is pinned to its *amended* content — the one relaxation FR-068 permits, from a
+#: closed-set assertion on the read response's fields to the subset assertion feature 001's FR-017
+#: actually requires (spec.md → Clarifications, amendment raised during implementation). Pinning
+#: the amended digest keeps the guard sharp: any *further* edit to that file still fails here, and
+#: ``test_fr068_the_two_added_fields_are_the_only_difference`` below checks the relaxation did not
+#: cost feature 001 anything.
+FEATURE_001_FILES = {
+    "conftest.py": "02b5fa20a27927f948e640e16592ef46e7fe6859299e7bcb172f4b610d88842c",
+    "test_cli.py": "dbe46ccaff6a1a7cfe382df30bbd341584c1e0fa1a3f606e524631d81084fd25",
+    "test_publish.py": "462c2bb145cc5dd079cc24dced61ea209cda176a185ec140d07b6a0f03d38142",
+    "test_read.py": "88c76ad41f96730cb3bfa091dd1c940c7a992026f4fefed88a3448b69a302282",
+    "test_delete.py": "153281ed5815253e7b9db2457915647948d1716a5c9f3171e223aaf2a8052ba1",
+    "test_expiry.py": "c8cafd791360a5894f69308e041e31b250fbb1d83b0f2e176b0b1e0325033946",
+    "test_persistence.py": "5e67c5800f7ccafce4ecf62ecb137f1e6e3a6428ccb8ffd35d40a7f7dcdae678",
+    "test_routing.py": "13af58eee9a93a94375fac0da295acbe045c3de72cd523566ffc00e475982b0b",
+    "test_errors.py": "add2add987b3859c2db0803b799ac07b5c7fb259c975896c5d711514cffd5555",
+    "test_damaged_storage.py": "d88296780acb407948e2f4a9f2c39d5850bd607c8cba9235bbe3afe4ec8a8b85",
+    "test_concurrency.py": "30e8b3f433001007fdd6958191560d9e665ee83a89b09c387c7da59369bcc880",
+}
+
+#: Exactly the five keys the previous version wrote. Hand-written here, which is also what a
+#: record left behind by that version looks like (contracts/storage.md → Upgrade and downgrade).
+LEGACY_RECORD = {
+    "id": "aLegacyFiveKeyRecord",
+    "content": "written by the previous version",
+    "created_at": "2026-10-23T20:15:00Z",
+    "expires_at": None,
+    "delete_token": "a-legacy-delete-token",
+}
+
+#: Every invalid value the specification enumerates for the two new options.
+INVALID_BURN_VALUES = ["true", "false", 1, 0, None, [], {}]
+INVALID_PASSWORD_VALUES = ["", "x" * 129, 42, True, None, [], {}]
+
+
+def fast(service):
+    service.httpd.password_iterations = FAST_ITERATIONS
+    return service
+
+
+def raw_get(service, path, header_lines=()):
+    request = bytearray(f"GET {path} HTTP/1.0\r\nHost: 127.0.0.1\r\n".encode("latin-1"))
+    for line in header_lines:
+        request += line + b"\r\n"
+    request += b"\r\n"
+    return parse_raw_response(service.send_bytes(bytes(request)))
+
+
+# -- FR-067: a record from the previous version ---------------------------------------------
+
+
+def test_fr067_five_key_legacy_record_reads_as_neither(service):
+    """FR-067: a five-key record is valid and reads as neither one-time nor protected."""
+    paste_id = LEGACY_RECORD["id"]
+    service.write_record(paste_id, LEGACY_RECORD)
+
+    response = service.read(paste_id)
+
+    assert response.status == 200
+    body = response.json()
+    assert body["burn_after_reading"] is False
+    assert body["protected"] is False
+    assert body["content"] == LEGACY_RECORD["content"]
+    assert body["created_at"] == LEGACY_RECORD["created_at"]
+    assert body["expires_at"] is None
+
+    # Neither one-time nor protected: readable again, and with no password.
+    assert service.read(paste_id).status == 200
+    assert service.read_raw(paste_id).body == LEGACY_RECORD["content"].encode("utf-8")
+    assert service.record_path(paste_id).exists()
+
+
+def test_fr067_legacy_record_is_not_reported_as_damaged(service, capsys):
+    """FR-067: a legacy record is not damaged — no 500 and no diagnostic."""
+    paste_id = LEGACY_RECORD["id"]
+    service.write_record(paste_id, LEGACY_RECORD)
+
+    statuses = [
+        service.read(paste_id).status,
+        service.read_raw(paste_id).status,
+        service.delete(paste_id, token=[REDACTED:assigned_secret]["delete_token"]).status,
+    ]
+
+    assert statuses == [200, 200, 204]
+    captured = capsys.readouterr()
+    assert captured.err == ""
+    assert captured.out == ""
+
+
+@pytest.mark.parametrize(
+    "key, value",
+    [("burn_after_reading", True), ("password", None)],
+    ids=["burn-only", "password-only"],
+)
+def test_fr067_record_with_one_optional_key_is_valid(service, key, value):
+    """FR-067: each optional key is optional on its own, not only as a pair."""
+    paste_id = "aRecordWithOneOptionalKey"
+    service.write_record(paste_id, {**LEGACY_RECORD, "id": paste_id, key: value})
+
+    response = service.read(paste_id)
+
+    assert response.status == 200
+    assert response.json()["burn_after_reading"] is (key == "burn_after_reading")
+    assert response.json()["protected"] is False
+
+
+# -- FR-068: feature 001 is preserved -------------------------------------------------------
+
+
+def test_fr068_feature_001_suite_passes_unchanged():
+    """FR-068, SC-018: feature 001's test modules are unedited, and they pass.
+
+    Two assertions, because FR-068 needs both. The digests prove the files were not adjusted to
+    accommodate this feature — the unchanged files are themselves the evidence. The subprocess run
+    proves they still pass against the changed implementation. The run costs roughly as much as
+    the rest of the suite; that is the price of the evidence.
+
+    Nothing is deselected: all 196 feature 001 tests are expected to pass.
+    """
+    tests_dir = REPO_ROOT / "tests"
+
+    for name, expected in FEATURE_001_FILES.items():
+        path = tests_dir / name
+        assert path.exists(), f"{name} is missing"
+        actual = hashlib.sha256(path.read_bytes()).hexdigest()
+        assert actual == expected, (
+            f"{name} has been edited by feature 002. Feature 001's test modules and "
+            f"tests/conftest.py running unmodified is the evidence for FR-068 and SC-018, so "
+            f"editing one is a failure of this feature, not a fix."
+        )
+
+    completed = subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "pytest",
+            "-q",
+            "-p",
+            "no:cacheprovider",
+            *[f"tests/{name}" for name in FEATURE_001_FILES if name != "conftest.py"],
+        ],
+        cwd=REPO_ROOT,
+        env=child_env(),
+        capture_output=True,
+        text=True,
+        timeout=900,
+    )
+
+    assert completed.returncode == 0, completed.stdout[-4000:] + completed.stderr[-2000:]
+
+
+def test_fr068_the_two_added_fields_are_the_only_difference(service):
+    """FR-068's second permitted exception: the two added fields, and nothing else, changed.
+
+    FR-064 requires ``GET /pastes/<id>`` to report ``burn_after_reading`` and ``protected``, while
+    one feature 001 test asserted that response's field set was *closed*. FR-068 was amended to
+    except those two fields — consistent with SC-018, which already excepted them — and that one
+    assertion was relaxed to the subset check feature 001's FR-017 actually requires (spec.md →
+    Clarifications, amendment raised during implementation).
+
+    This test is what keeps the relaxation honest. It asserts the whole of what FR-068 protects:
+    every field feature 001 specified is still present with the same name, type, and value, and
+    the *only* difference is the two fields FR-064 adds. A third field appearing here, or any
+    feature 001 field being removed, renamed, retyped, or revalued, fails this test — which is
+    exactly the protection the closed-set assertion used to provide.
+    """
+    published = service.publish("hello")
+
+    response = service.read(published["id"])
+
+    assert response.status == 200
+    snippet = response.json()
+
+    # Exactly feature 001's FR-017, which is unaffected.
+    assert {"id", "content", "created_at", "expires_at"} <= set(snippet)
+    assert snippet["id"] == published["id"]
+    assert snippet["content"] == "hello"
+    assert snippet["expires_at"] is None
+    assert store.parse_timestamp(snippet["created_at"])
+
+    # The permitted exception, pinned: these two fields and no others.
+    assert set(snippet) - {"id", "content", "created_at", "expires_at"} == {
+        "burn_after_reading",
+        "protected",
+    }
+
+
+def test_fr068_plain_snippet_response_fields_unchanged_but_for_the_two_flags(service):
+    """FR-068: for a snippet published with neither option, nothing changed but the two flags."""
+    published = service.post_json({"content": "an ordinary snippet", "expires_in": 3600})
+
+    assert published.status == 201
+    created = published.json()
+    assert sorted(created) == ["delete_token", "id", "url"]
+
+    read = service.read(created["id"])
+    assert read.status == 200
+    assert read.headers["Content-Type"] == "application/json"
+    body = read.json()
+
+    # The four fields feature 001 defined, unchanged in name, type, and value.
+    assert body["id"] == created["id"]
+    assert body["content"] == "an ordinary snippet"
+    assert store.parse_timestamp(body["created_at"])
+    assert store.parse_timestamp(body["expires_at"])
+    assert body["created_at"].endswith("Z") and len(body["created_at"]) == 20
+
+    # Plus exactly the two added flags, and nothing else.
+    assert set(body) - {"id", "content", "created_at", "expires_at"} == {
+        "burn_after_reading",
+        "protected",
+    }
+
+    # The other three requests are untouched.
+    assert service.read_raw(created["id"]).body == b"an ordinary snippet"
+    assert service.read_raw(created["id"]).headers["Content-Type"] == "text/plain; charset=utf-8"
+    assert service.delete(created["id"]).status == 403
+    assert service.delete(created["id"], token=created["delete_token"]).status == 204
+    assert service.read(created["id"]).status == 404
+
+
+# -- FR-069, FR-070: the shape and the status of every new failure ---------------------------
+
+
+def new_error_paths(service):
+    """Every failure path this feature introduces, as ``(label, expected status, response)``."""
+    fast(service)
+    protected = service.publish("protected", password="secret")
+    one_time = service.publish("one-time", burn_after_reading=True)
+    assert service.read(one_time["id"]).status == 200
+
+    def raw(path, header_lines=()):
+        status, _, body = raw_get(service, path, header_lines)
+        return status, body
+
+    cases = [
+        (
+            "400-burn",
+            400,
+            service.post_json({"content": "x", "burn_after_reading": "yes"}),
+        ),
+        ("400-password", 400, service.post_json({"content": "x", "password": ""})),
+        ("403-missing", 403, service.read(protected["id"])),
+        (
+            "403-wrong",
+            403,
+            service.get(f"/pastes/{protected['id']}", headers={HEADER: "wrong"}),
+        ),
+        (
+            "403-raw-missing",
+            403,
+            service.read_raw(protected["id"]),
+        ),
+        ("404-consumed", 404, service.read(one_time["id"])),
+        ("404-consumed-raw", 404, service.read_raw(one_time["id"])),
+        (
+            "404-consumed-delete",
+            404,
+            service.delete(one_time["id"], token=[REDACTED:assigned_secret]["delete_token"]),
+        ),
+    ]
+    raw_cases = [
+        ("403-repeated", 403, raw(f"/pastes/{protected['id']}", [
+            HEADER.encode() + b": wrong", HEADER.encode() + b": secret"
+        ])),
+        ("403-invalid-utf8", 403, raw(f"/pastes/{protected['id']}", [
+            HEADER.encode() + b": \xff\xfe"
+        ])),
+        ("403-empty", 403, raw(f"/pastes/{protected['id']}", [HEADER.encode() + b":"])),
+    ]
+    return cases, raw_cases
+
+
+def test_fr069_every_new_error_has_a_single_error_field(service):
+    """FR-069: every new failure's body is a JSON object whose only key is a non-empty ``error``.
+
+    The status and the non-emptiness are asserted; the wording is not, as in feature 001.
+    """
+    cases, raw_cases = new_error_paths(service)
+
+    for label, expected, response in cases:
+        assert response.status == expected, (label, response)
+        body = response.json()
+        assert isinstance(body, dict), (label, body)
+        assert sorted(body) == ["error"], (label, body)
+        assert isinstance(body["error"], str) and body["error"], (label, body)
+
+    for label, expected, (status, raw_body) in raw_cases:
+        assert status == expected, (label, status)
+        body = json.loads(raw_body.decode("utf-8"))
+        assert sorted(body) == ["error"], (label, body)
+        assert body["error"], (label, body)
+
+
+@pytest.mark.parametrize("value", INVALID_BURN_VALUES, ids=lambda v: f"burn-{v!r}")
+def test_fr070_invalid_option_is_400(service, value):
+    """FR-070: an invalid option is a 400 — a caller error, not an internal one."""
+    response = fast(service).post_json({"content": "x", "burn_after_reading": value})
+
+    assert response.status == 400
+
+
+@pytest.mark.parametrize("value", INVALID_PASSWORD_VALUES, ids=lambda v: f"password-{v!r}")
+def test_fr070_invalid_password_is_400(service, value):
+    """FR-070: an invalid password is a 400 for every value the specification enumerates."""
+    response = fast(service).post_json({"content": "x", "password": value})
+
+    assert response.status == 400
+
+
+def test_fr070_password_failure_is_403(service):
+    """FR-070: a failure to present the password is a 403, never a 500."""
+    published = fast(service).publish("protected", password="secret")
+
+    assert service.read(published["id"]).status == 403
+    assert service.get(f"/pastes/{published['id']}", headers={HEADER: "wrong"}).status == 403
+    assert raw_get(
+        service, f"/pastes/{published['id']}", [HEADER.encode() + b": \xff\xfe"]
+    )[0] == 403
+
+
+def test_fr070_no_enumerated_input_produces_a_500_or_a_traceback(service, capsys):
+    """FR-070, SC-017: no input this specification enumerates yields a 500 or a traceback."""
+    fast(service)
+    protected = service.publish("protected", password="secret")
+    statuses = []
+
+    for value in INVALID_BURN_VALUES:
+        statuses.append(service.post_json({"content": "x", "burn_after_reading": value}).status)
+    for value in INVALID_PASSWORD_VALUES:
+        statuses.append(service.post_json({"content": "x", "password": value}).status)
+
+    # And every way of failing to present the password, including those http.client cannot frame.
+    statuses.append(service.read(protected["id"]).status)
+    statuses.append(service.get(f"/pastes/{protected['id']}", headers={HEADER: ""}).status)
+    statuses.append(service.get(f"/pastes/{protected['id']}", headers={HEADER: "wrong"}).status)
+    for header_lines in (
+        [HEADER.encode() + b": \xff\xfe"],
+        [HEADER.encode() + b":"],
+        [HEADER.encode() + b": a", HEADER.encode() + b": b"],
+        [HEADER.encode() + b": secret", HEADER.encode() + b": secret"],
+    ):
+        statuses.append(raw_get(service, f"/pastes/{protected['id']}", header_lines)[0])
+
+    assert 500 not in statuses, statuses
+    assert set(statuses) <= {400, 403}, statuses
+
+    captured = capsys.readouterr()
+    assert captured.err == "", captured.err
+    assert "Traceback" not in captured.err + captured.out
+
+
+# -- FR-071: the widened pre-read body ceiling ----------------------------------------------
+
+
+def test_fr071_max_content_with_max_password_and_burn_is_created(service):
+    """FR-071: the largest valid content, a 128-character password, and the flag together are a 201."""
+    fast(service)
+    response = service.post_json(
+        {
+            "content": "c" * store.MAX_CONTENT_BYTES,
+            "password": "p" * store.MAX_PASSWORD_CHARS,
+            "burn_after_reading": True,
+        }
+    )
+
+    assert response.status == 201, response
+
+
+def test_fr071_ceiling_covers_worst_case_escaped_body(service):
+    """FR-071: the worst-case valid submission — which the old 394,240-byte bound refused — is a 201.
+
+    Content of C0 control bytes escapes six output bytes per input byte, and a password of astral
+    characters escapes twelve per *character* as a surrogate pair (research.md R-09).
+    """
+    fast(service)
+    payload = {
+        "content": "\x01" * store.MAX_CONTENT_BYTES,
+        "password": "\U0001f600" * store.MAX_PASSWORD_CHARS,
+        "burn_after_reading": True,
+    }
+    body = json.dumps(payload).encode("utf-8")
+
+    # This is the submission the previous ceiling genuinely rejected.
+    assert len(body) > 6 * store.MAX_CONTENT_BYTES + 1_024
+    assert len(body) <= store.MAX_BODY_BYTES
+
+    response = service.post_raw(body)
+
+    assert response.status == 201, response
+
+
+def test_fr071_ceiling_is_independent_of_declared_length(service):
+    """FR-071, FR-040: no declared length — over, under, or absent — moves the ceiling."""
+    # Overstated beyond the ceiling: refused before the body is read at all.
+    status, _, body = parse_raw_response(
+        service.send_bytes(
+            b"POST /pastes HTTP/1.0\r\nHost: 127.0.0.1\r\n"
+            b"Content-Length: 999999999\r\n\r\n"
+        )
+    )
+    assert status == 413
+    assert str(store.MAX_BODY_BYTES) in json.loads(body)["error"]
+
+    # Exactly one byte over the ceiling: still refused, so the bound is where it says it is.
+    status, _, _ = parse_raw_response(
+        service.send_bytes(
+            f"POST /pastes HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Length: "
+            f"{store.MAX_BODY_BYTES + 1}\r\n\r\n".encode()
+        )
+    )
+    assert status == 413
+
+    # Absent: the service still reads no further than the ceiling.
+    status, _, _ = parse_raw_response(
+        service.send_bytes(
+            b"POST /pastes HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n"
+            + b"x" * (store.MAX_BODY_BYTES + 1)
+        )
+    )
+    assert status == 413
+
+    # Understated: only the declared bytes are read, so the truncated JSON is a 400.
+    payload = json.dumps({"content": "understated", "burn_after_reading": True}).encode()
+    status, _, _ = parse_raw_response(
+        service.send_bytes(
+            f"POST /pastes HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Length: "
+            f"{len(payload) - 10}\r\n\r\n".encode() + payload
+        )
+    )
+    assert status == 400
+
+
+def test_fr071_oversize_content_is_still_413(service):
+    """FR-071: the content limit itself is unchanged — one byte over is still a 413."""
+    fast(service)
+    response = service.post_json(
+        {
+            "content": "c" * (store.MAX_CONTENT_BYTES + 1),
+            "password": "p" * store.MAX_PASSWORD_CHARS,
+            "burn_after_reading": True,
+        }
+    )
+
+    assert response.status == 413
+    assert str(store.MAX_CONTENT_BYTES) in response.json()["error"]
