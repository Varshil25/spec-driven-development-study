@@ -0,0 +1,607 @@
+"""Password protection.
+
+Covers FR-054 through FR-063 and FR-072 through FR-074: validating the option at publication,
+storing only a salted one-way derivation, the ``X-Paste-Password`` read header and the single 403
+that every failure to present it produces, the precedence of 404 over 403, non-disclosure, the
+deliberate cost of one verification, and the fact that a password never substitutes for the delete
+token.
+
+Most tests here do not care what one derivation costs, so they wind ``password_iterations`` down
+first: the iteration count is server state the handler reads, not a constant it embeds
+(research.md R-10). The two tests that *do* care — the cost band and the concurrency check — leave
+the calibrated value alone, which is the whole point of calibrating it.
+"""
+
+import json
+import threading
+import time
+
+import pytest
+
+from conftest import Client, parse_raw_response
+from pastebin import store
+
+#: Cheap enough that a few dozen derivations cost nothing, for the tests about *behaviour*.
+FAST_ITERATIONS = 1_000
+
+HEADER = "X-Paste-Password"
+
+
+def fast(service):
+    """Wind the publication-time derivation cost down; returns the service for chaining."""
+    service.httpd.password_iterations = FAST_ITERATIONS
+    return service
+
+
+def raw_get(service, path, header_lines=()):
+    """``GET path`` with header lines given as raw bytes, for framing ``http.client`` cannot express.
+
+    Returns ``(status, headers, body)``.
+    """
+    request = bytearray(f"GET {path} HTTP/1.0\r\nHost: 127.0.0.1\r\n".encode("latin-1"))
+    for line in header_lines:
+        request += line + b"\r\n"
+    request += b"\r\n"
+    return parse_raw_response(service.send_bytes(bytes(request)))
+
+
+def password_header(value):
+    """One ``X-Paste-Password`` header line carrying ``value``'s UTF-8 bytes."""
+    if isinstance(value, str):
+        value = value.encode("utf-8")
+    return HEADER.encode("ascii") + b": " + value
+
+
+def parse_body(body):
+    """The JSON body of a raw response."""
+    return json.loads(body.decode("utf-8"))
+
+
+def read_with(service, paste_id, password, raw=False):
+    """Read a snippet presenting ``password``, or presenting nothing when it is ``None``."""
+    headers = {} if password is None else {HEADER: password}
+    suffix = "/raw" if raw else ""
+    return service.get(f"/pastes/{paste_id}{suffix}", headers=headers)
+
+
+# -- FR-054, FR-055: the option at publication ---------------------------------------------
+
+
+@pytest.mark.parametrize("length", [1, 128], ids=["one-character", "128-characters"])
+def test_fr054_password_of_1_and_128_chars_accepted(service, length):
+    """FR-054: both ends of the 1-to-128-character bound are accepted, and are what reading needs."""
+    password = "p" * length
+    published = fast(service).publish("bounded password", password=[REDACTED:assigned_secret])
+
+    assert read_with(service, published["id"], password).status == 200
+    assert read_with(service, published["id"], None).status == 403
+
+
+def test_fr054_length_is_counted_in_characters_not_bytes(service):
+    """FR-054: the bound is on characters — 128 multi-byte characters is valid, not oversize."""
+    password = "中" * 128
+    assert len(password) == 128
+    assert len(password.encode("utf-8")) == 384
+
+    published = fast(service).publish("a multi-byte password", password=[REDACTED:assigned_secret])
+
+    status, _, _ = raw_get(
+        service,
+        f"/pastes/{published['id']}",
+        [password_header(password)],
+    )
+    assert status == 200
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["", "x" * 129, 42, True, None, [], {}],
+    ids=["empty", "129-characters", "number", "boolean", "null", "list", "object"],
+)
+def test_fr055_invalid_password_is_400(service, value):
+    """FR-055: no coercion — anything but a 1-to-128-character string is a 400, ``null`` included."""
+    response = fast(service).post_json({"content": "x", "password": value})
+
+    assert response.status == 400, response
+    assert sorted(response.json()) == ["error"]
+    assert response.json()["error"]
+
+
+def test_fr055_rejected_publication_creates_nothing(service):
+    """FR-055: a refused publication leaves no trace in storage."""
+    before = sorted(path.name for path in service.data_dir.iterdir())
+
+    assert fast(service).post_json({"content": "x", "password": ""}).status == 400
+
+    assert sorted(path.name for path in service.data_dir.iterdir()) == before
+
+
+# -- FR-056: nothing recoverable is stored -------------------------------------------------
+
+
+def test_fr056_record_holds_no_recoverable_password(service):
+    """FR-056: the record holds a salted one-way derivation and no trace of the password."""
+    password=[REDACTED:assigned_secret]
+    published = fast(service).publish("protected", password=[REDACTED:assigned_secret])
+
+    record = service.read_record(published["id"])
+    assert sorted(record["password"]) == ["hash", "iterations", "salt"]
+    assert record["password"]["iterations"] == FAST_ITERATIONS
+    assert len(record["password"]["salt"]) == 32
+    assert len(record["password"]["hash"]) == 64
+
+    # Nowhere in the record, and nowhere else in the storage directory.
+    assert password not in service.record_path(published["id"]).read_text(encoding="utf-8")
+    for path in service.data_dir.iterdir():
+        assert password.encode("utf-8") not in path.read_bytes(), path
+
+
+def test_fr056_same_password_required_after_restart(server_process, tmp_path):
+    """FR-056: a later instance requires — and accepts — the same password.
+
+    Verification uses the record's own salt and iteration count, never the current process's
+    calibration, which is what makes this hold across a restart.
+    """
+    data_dir = tmp_path / "shared"
+    password=[REDACTED:assigned_secret]
+    first = server_process(data_dir=data_dir)
+    published = first.publish("protected across a restart", password=[REDACTED:assigned_secret])
+    assert first.stop() == 0
+
+    second = server_process(data_dir=data_dir)
+
+    assert read_with(second, published["id"], None).status == 403
+    assert read_with(second, published["id"], "wrong").status == 403
+    correct = read_with(second, published["id"], password)
+    assert correct.status == 200
+    assert correct.json()["content"] == "protected across a restart"
+
+
+# -- FR-073, FR-074: the cost of one verification ------------------------------------------
+
+
+def test_fr073_one_verification_costs_between_10ms_and_200ms(service):
+    """FR-073, SC-021: one verification costs 10–200 ms on the machine serving requests.
+
+    The calibrated iteration count is deliberately left alone here. Timing a protected read
+    against an unprotected one on the same host isolates the derivation from the fixed cost of a
+    request, and the minimum of several trials discards scheduling noise.
+    """
+    password=[REDACTED:assigned_secret]
+    protected = service.publish("protected", password=[REDACTED:assigned_secret])
+    plain = service.publish("unprotected")
+
+    def best(action):
+        timings = []
+        for _ in range(3):
+            started = time.perf_counter()
+            assert action().status == 200
+            timings.append(time.perf_counter() - started)
+        return min(timings)
+
+    protected_cost = best(lambda: read_with(service, protected["id"], password))
+    plain_cost = best(lambda: service.read(plain["id"]))
+    derivation = protected_cost - plain_cost
+
+    assert 0.010 <= derivation <= 0.200, (
+        f"one verification took {derivation * 1000:.1f} ms "
+        f"(protected {protected_cost * 1000:.1f} ms, plain {plain_cost * 1000:.1f} ms) "
+        f"at {service.httpd.password_iterations} iterations"
+    )
+
+
+def test_fr073_salt_is_unique_per_snippet(service):
+    """FR-073: each snippet's salt is drawn afresh."""
+    fast(service)
+    salts = {
+        service.read_record(service.publish(f"snippet {index}", password="same")["id"])[
+            "password"
+        ]["salt"]
+        for index in range(8)
+    }
+
+    assert len(salts) == 8
+
+
+def test_fr073_identical_passwords_have_different_stored_forms(service):
+    """FR-073: two snippets sharing a password differ in both salt and hash."""
+    fast(service)
+    first = service.read_record(service.publish("one", password=[REDACTED:assigned_secret])["id"])
+    second = service.read_record(service.publish("two", password=[REDACTED:assigned_secret])["id"])
+
+    assert first["password"]["salt"] != second["password"]["salt"]
+    assert first["password"]["hash"] != second["password"]["hash"]
+
+
+def test_fr074_verification_does_not_delay_other_snippets(service):
+    """FR-074, FR-042, SC-021: a verification delays no request about another snippet.
+
+    The calibrated cost is left alone, so each protected read really does spend ~50 ms deriving.
+    Reads of a *different*, unprotected snippet must not queue behind them — which holds because
+    ``pbkdf2_hmac`` releases the GIL and each connection has its own thread (research.md R-03).
+    """
+    password=[REDACTED:assigned_secret]
+    protected = service.publish("protected", password=[REDACTED:assigned_secret])
+    plain = service.publish("unprotected")
+
+    readers = 12
+    released = threading.Barrier(readers + 1)
+    statuses = []
+
+    def verify():
+        client = Client(service.port)
+        released.wait(timeout=30)
+        statuses.append(client.get(f"/pastes/{protected['id']}", headers={HEADER: password}).status)
+
+    threads = [threading.Thread(target=verify) for _ in range(readers)]
+    for thread in threads:
+        thread.start()
+
+    released.wait(timeout=30)
+    started = time.perf_counter()
+    for _ in range(5):
+        assert service.read(plain["id"]).status == 200
+    elapsed = time.perf_counter() - started
+
+    # The verifications are still running: the unprotected reads overtook them rather than
+    # queueing behind them.
+    assert any(thread.is_alive() for thread in threads), (
+        f"{readers} verifications finished before five unprotected reads "
+        f"({elapsed * 1000:.1f} ms) — the overlap this asserts did not happen"
+    )
+    # Measured against what the outstanding verifications would cost if they were serialised.
+    # Sharing a loaded host's cores costs *something*; queueing behind a lock or a work pool
+    # would cost a multiple of this, which is the delay FR-074 prohibits.
+    serial_cost = readers * store.PASSWORD_TARGET_SECONDS
+    assert elapsed < serial_cost / 2, (
+        f"five unprotected reads took {elapsed * 1000:.1f} ms while {readers} verifications "
+        f"worth {serial_cost * 1000:.1f} ms of serial work were outstanding"
+    )
+
+    for thread in threads:
+        thread.join(timeout=30)
+    assert statuses == [200] * readers
+
+
+# -- FR-057: the password is never disclosed -----------------------------------------------
+
+
+def test_fr057_password_absent_from_publication_response(service):
+    """FR-057: the 201 carries only ``id``, ``delete_token``, and ``url``."""
+    password=[REDACTED:assigned_secret]
+    response = fast(service).post_json({"content": "protected", "password": password})
+
+    assert response.status == 201
+    assert sorted(response.json()) == ["delete_token", "id", "url"]
+    assert password not in response.text()
+
+
+def test_fr057_password_absent_from_every_response_and_stream(server_process, tmp_path):
+    """FR-057, FR-066, SC-015: the password appears in no response and on neither stream."""
+    password=[REDACTED:assigned_secret]
+    service = server_process(data_dir=tmp_path / "pastes")
+    published = service.publish("protected", password=[REDACTED:assigned_secret])
+
+    responses = [
+        read_with(service, published["id"], password),
+        read_with(service, published["id"], None),
+        read_with(service, published["id"], "wrong"),
+        read_with(service, published["id"], password, raw=True),
+        service.delete(published["id"]),
+        service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"]),
+    ]
+
+    for response in responses:
+        assert password.encode("utf-8") not in response.body, response
+        for name, value in response.headers.items():
+            assert password not in f"{name}: {value}"
+
+    assert service.stop() == 0
+    for line in service.stdout_lines + service.stderr_lines:
+        assert password not in line, line
+
+
+# -- FR-058: exact matching on UTF-8 bytes -------------------------------------------------
+
+
+def test_fr058_correct_password_reads_both_endpoints(service):
+    """FR-058: the correct password reads the snippet through both endpoints."""
+    password=[REDACTED:assigned_secret]
+    published = fast(service).publish("behind a password", password=[REDACTED:assigned_secret])
+
+    structured = read_with(service, published["id"], password)
+    assert structured.status == 200
+    assert structured.json()["content"] == "behind a password"
+
+    raw = read_with(service, published["id"], password, raw=True)
+    assert raw.status == 200
+    assert raw.body == b"behind a password"
+
+
+def test_fr058_non_ascii_password_matches_utf8_header_bytes(service):
+    """FR-058: the header's bytes are interpreted as UTF-8, so a non-ASCII password matches."""
+    password = "pässwörd-é中"
+    published = fast(service).publish("non-ascii password", password=[REDACTED:assigned_secret])
+
+    status, _, body = raw_get(
+        service, f"/pastes/{published['id']}/raw", [password_header(password)]
+    )
+
+    assert status == 200
+    assert body == b"non-ascii password"
+
+
+@pytest.mark.parametrize(
+    "presented",
+    ["secret ", "SECRET", "Secret", "sécret"],
+    ids=["trailing-space", "upper", "capitalised", "decomposed"],
+)
+def test_fr058_no_trimming_case_folding_or_normalisation(service, presented):
+    """FR-058: comparison is exact — nothing is trimmed, case-folded, or normalised.
+
+    A *leading* space is absent from this list because HTTP itself strips the optional whitespace
+    between a header's colon and its value, so no caller can present one and the service never
+    sees it. Padding on the other side is covered below.
+    """
+    published = fast(service).publish("exact match only", password="secret")
+
+    status, _, _ = raw_get(
+        service, f"/pastes/{published['id']}", [password_header(presented)]
+    )
+
+    assert status == 403
+    # And the snippet is untouched by the refusal.
+    assert read_with(service, published["id"], "secret").status == 200
+
+
+def test_fr058_a_stored_password_ending_in_a_space_is_not_trimmed(service):
+    """FR-058: a password whose own characters include padding is matched exactly, not trimmed."""
+    published = fast(service).publish("padded password", password="secret ")
+
+    assert read_with(service, published["id"], "secret").status == 403
+
+    status, _, body = raw_get(
+        service, f"/pastes/{published['id']}/raw", [password_header("secret ")]
+    )
+    assert status == 200
+    assert body == b"padded password"
+
+
+def test_fr058_invalid_utf8_header_bytes_are_403(service):
+    """FR-058, FR-070: undecodable header bytes are a mismatch — a 403, never a 500."""
+    published = fast(service).publish("protected", password="secret")
+
+    status, _, body = raw_get(
+        service, f"/pastes/{published['id']}", [password_header(b"\xff\xfe")]
+    )
+
+    assert status == 403
+    assert sorted(parse_body(body)) == ["error"]
+    assert read_with(service, published["id"], "secret").status == 200
+
+
+# -- FR-059: the one refusal -------------------------------------------------------------
+
+
+def test_fr059_missing_password_is_403(service):
+    """FR-059: a protected snippet read with no password header is refused."""
+    published = fast(service).publish("protected", password="secret")
+
+    response = read_with(service, published["id"], None)
+
+    assert response.status == 403
+    assert response.json() == {"error": "missing or invalid X-Paste-Password"}
+
+
+def test_fr059_wrong_password_is_403(service):
+    """FR-059: a protected snippet read with the wrong password is refused."""
+    published = fast(service).publish("protected", password="secret")
+
+    response = read_with(service, published["id"], "not-the-secret")
+
+    assert response.status == 403
+    assert response.json() == {"error": "missing or invalid X-Paste-Password"}
+
+
+def test_fr059_empty_password_header_is_403(service):
+    """FR-059: an empty value is a presented password of zero characters, so it is refused.
+
+    It is not treated as absent — but the two are the same 403 regardless, by design.
+    """
+    published = fast(service).publish("protected", password="secret")
+
+    status, _, body = raw_get(
+        service, f"/pastes/{published['id']}", [HEADER.encode("ascii") + b":"]
+    )
+
+    assert status == 403
+    assert parse_body(body) == {"error": "missing or invalid X-Paste-Password"}
+
+
+def test_fr059_refused_read_leaves_snippet_readable(service):
+    """FR-059: a refusal changes nothing — the password holder can still read the snippet."""
+    published = fast(service).publish("still here", password="secret")
+
+    for presented in (None, "wrong", "", "SECRET"):
+        assert read_with(service, published["id"], presented).status == 403
+
+    assert read_with(service, published["id"], "secret").status == 200
+    assert read_with(service, published["id"], "secret", raw=True).body == b"still here"
+
+
+# -- FR-072: a repeated header selects no occurrence ---------------------------------------
+
+
+def test_fr072_repeated_password_header_is_403(service):
+    """FR-072: the header given more than once is refused, whatever the copies hold."""
+    published = fast(service).publish("protected", password="secret")
+
+    status, _, body = raw_get(
+        service,
+        f"/pastes/{published['id']}",
+        [password_header("wrong"), password_header("also-wrong")],
+    )
+
+    assert status == 403
+    assert parse_body(body) == {"error": "missing or invalid X-Paste-Password"}
+
+
+@pytest.mark.parametrize(
+    "lines",
+    [
+        ["wrong", "secret"],
+        ["secret", "wrong"],
+        ["secret", "secret"],
+    ],
+    ids=["correct-second", "correct-first", "correct-twice"],
+)
+def test_fr072_repeated_header_with_one_correct_copy_is_403(service, lines):
+    """FR-072: no occurrence is selected — not the first, not the last, not any.
+
+    A correct password smuggled into a second copy of the header must not open the snippet.
+    """
+    published = fast(service).publish("protected", password="secret")
+
+    status, _, _ = raw_get(
+        service,
+        f"/pastes/{published['id']}",
+        [password_header(value) for value in lines],
+    )
+
+    assert status == 403
+
+
+def test_fr072_snippet_still_readable_with_one_correct_header(service):
+    """FR-072: the repeated-header refusal consumes and changes nothing."""
+    published = fast(service).publish("still readable", password="secret")
+
+    assert (
+        raw_get(
+            service,
+            f"/pastes/{published['id']}",
+            [password_header("secret"), password_header("secret")],
+        )[0]
+        == 403
+    )
+
+    status, _, body = raw_get(
+        service, f"/pastes/{published['id']}/raw", [password_header("secret")]
+    )
+    assert status == 200
+    assert body == b"still readable"
+
+
+# -- FR-060: 404 outranks 403 --------------------------------------------------------------
+
+
+@pytest.mark.parametrize("presented", [None, "any-password"], ids=["absent", "wrong"])
+def test_fr060_unknown_identifier_is_404_not_403(service, presented):
+    """FR-060: an unknown identifier is a 404, and no password can turn it into anything else."""
+    response = read_with(service, "anIdentifierNeverIssued", presented)
+
+    assert response.status == 404
+    assert sorted(response.json()) == ["error"]
+
+
+@pytest.mark.parametrize(
+    "presented", [None, "secret", "wrong"], ids=["absent", "correct", "wrong"]
+)
+def test_fr060_expired_protected_snippet_is_404_whatever_password(service, presented):
+    """FR-060: expiry outranks the password gate, for every password a caller might present."""
+    published = fast(service).publish("expires", password="secret", expires_in=3600)
+    record = service.read_record(published["id"])
+    record["expires_at"] = "2026-01-01T00:00:00Z"
+    service.write_record(published["id"], record)
+
+    assert read_with(service, published["id"], presented).status == 404
+    assert read_with(service, published["id"], presented, raw=True).status == 404
+
+
+def test_fr060_consumed_protected_snippet_is_404(service):
+    """FR-060: once consumed, a protected one-time snippet is a 404 even with its password."""
+    published = fast(service).publish(
+        "protected and one-time", password="secret", burn_after_reading=True
+    )
+    assert read_with(service, published["id"], "secret").status == 200
+
+    assert read_with(service, published["id"], "secret").status == 404
+    assert read_with(service, published["id"], None).status == 404
+    assert read_with(service, published["id"], "wrong").status == 404
+
+
+# -- FR-061, FR-062, FR-063 -----------------------------------------------------------------
+
+
+def test_fr061_verification_uses_compare_digest_on_derived_bytes(service, monkeypatch):
+    """FR-061: the comparison is over fixed-length derived keys, never the passwords themselves.
+
+    Timing therefore cannot reveal how much of a presented password was correct: whatever is
+    presented, ``compare_digest`` sees two 32-byte derived keys.
+    """
+    calls = []
+    real = store.secrets.compare_digest
+
+    def spy(left, right):
+        calls.append((left, right))
+        return real(left, right)
+
+    monkeypatch.setattr(store.secrets, "compare_digest", spy)
+
+    password=[REDACTED:assigned_secret]
+    published = fast(service).publish("protected", password=[REDACTED:assigned_secret])
+
+    # One presented password shares a long prefix with the correct one, one shares nothing.
+    assert read_with(service, published["id"], "correct-horsX").status == 403
+    assert read_with(service, published["id"], "zzzzzzzzzzzzz").status == 403
+    assert read_with(service, published["id"], password).status == 200
+
+    assert len(calls) == 3
+    for left, right in calls:
+        assert isinstance(left, bytes) and isinstance(right, bytes)
+        assert len(left) == 32 and len(right) == 32
+        assert password.encode("utf-8") not in left + right
+
+    # The stored side is identical every time; only the derived candidate differs.
+    assert {right for _, right in calls} == {calls[0][1]}
+    assert calls[0][0] != calls[1][0]
+
+
+@pytest.mark.parametrize(
+    "header_lines",
+    [
+        [b"X-Paste-Password=[REDACTED:assigned_secret]],
+        [b"X-Paste-Password: \xff\xfe"],
+        [b"X-Paste-Password: one", b"X-Paste-Password: two"],
+    ],
+    ids=["ordinary-value", "invalid-utf8", "repeated"],
+)
+def test_fr062_password_header_ignored_on_unprotected_snippet(service, header_lines):
+    """FR-062: on an unprotected snippet the header is not inspected at all."""
+    published = fast(service).publish("not protected")
+
+    status, _, body = raw_get(service, f"/pastes/{published['id']}/raw", header_lines)
+
+    assert status == 200
+    assert body == b"not protected"
+
+
+def test_fr063_delete_needs_only_the_token_no_password(service):
+    """FR-063, SC-016: a protected snippet is withdrawn by its delete token alone."""
+    published = fast(service).publish("protected", password="secret")
+
+    assert service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"]).status == 204
+
+    assert read_with(service, published["id"], "secret").status == 404
+
+
+def test_fr063_password_does_not_substitute_for_the_token(service):
+    """FR-063: the reading password is not a deletion credential."""
+    published = fast(service).publish("protected", password="secret")
+
+    refused = service.request(
+        "DELETE", f"/pastes/{published['id']}", headers={HEADER: "secret"}
+    )
+
+    assert refused.status == 403
+    assert refused.json() == {"error": "missing or invalid X-Delete-Token"}
+    assert read_with(service, published["id"], "secret").status == 200
