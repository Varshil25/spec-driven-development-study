@@ -0,0 +1,384 @@
+"""Burn after reading.
+
+Covers FR-045 through FR-053: the one-time option at publication, its durability, the claim that
+makes a first successful read the last, what does *not* count as a consumption, exactly-once
+delivery under contention, and the interaction with deletion and expiry.
+
+The claim's ordering — durably removed *before* the first byte of the response is written — is
+asserted by its consequences rather than by instrumenting the handler (research.md R-10): the
+record file is already gone when a successful read returns, and a caller that abandons the
+connection mid-body still leaves the snippet consumed.
+"""
+
+import json
+import socket
+import threading
+
+import pytest
+
+from conftest import Client, parse_raw_response
+
+
+def one_time_record(paste_id, created_at, expires_at, content="a one-time snippet"):
+    """A hand-written one-time record, as contracts/storage.md documents it."""
+    return {
+        "id": paste_id,
+        "content": content,
+        "created_at": created_at,
+        "expires_at": expires_at,
+        "delete_token": f"token-for-{paste_id}",
+        "burn_after_reading": True,
+        "password": None,
+    }
+
+
+def read_headers_then_abandon(port, path):
+    """Read only the response's header block, then drop the connection mid-body.
+
+    Returns the bytes received. The service is entitled to fail writing the rest; that failure is
+    not the caller's concern and must not be reported as a service failure (FR-044).
+    """
+    sock = socket.create_connection(("127.0.0.1", port), timeout=10)
+    try:
+        sock.sendall(f"GET {path} HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n".encode())
+        received = b""
+        while b"\r\n\r\n" not in received:
+            chunk = sock.recv(128)
+            if not chunk:
+                break
+            received += chunk
+        return received
+    finally:
+        sock.close()
+
+
+def race_one_time_read(service, paste_id, readers=16, raw=False):
+    """Release ``readers`` threads at once onto one unread one-time snippet.
+
+    Returns ``(statuses, bodies)`` for every reader, and raises whatever any reader raised: an
+    exception escaping a reader is itself a failure of FR-050.
+    """
+    statuses = [None] * readers
+    bodies = [None] * readers
+    errors = []
+    barrier = threading.Barrier(readers)
+
+    def reader(index):
+        client = Client(service.port)
+        try:
+            barrier.wait(timeout=30)
+            response = client.read_raw(paste_id) if raw else client.read(paste_id)
+            statuses[index] = response.status
+            bodies[index] = response.body
+        except Exception as error:  # noqa: BLE001 - recorded and re-raised by the caller
+            errors.append(error)
+
+    threads = [threading.Thread(target=reader, args=(index,)) for index in range(readers)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=30)
+
+    assert errors == [], errors
+    return statuses, bodies
+
+
+# -- FR-045: the option at publication -----------------------------------------------------
+
+
+def test_fr045_burn_true_publishes(service):
+    """FR-045: a snippet may be published as one-time, and publication succeeds normally."""
+    response = service.post_json({"content": "read me once", "burn_after_reading": True})
+
+    assert response.status == 201
+    created = response.json()
+    assert sorted(created) == ["delete_token", "id", "url"]
+    assert created["url"] == f"/pastes/{created['id']}"
+
+
+def test_fr045_absent_burn_means_not_one_time(service):
+    """FR-045: omitting the option leaves the snippet ordinary — readable again and again."""
+    published = service.publish("an ordinary snippet")
+
+    for _ in range(3):
+        assert service.read(published["id"]).status == 200
+        assert service.read_raw(published["id"]).status == 200
+
+    assert service.read_record(published["id"])["burn_after_reading"] is False
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["true", "false", 1, 0, None, [], {}],
+    ids=["string-true", "string-false", "one", "zero", "null", "list", "object"],
+)
+def test_fr046_non_boolean_burn_is_400(service, value):
+    """FR-046: no coercion — only a JSON boolean is accepted, and ``null`` is a 400.
+
+    ``null`` is deliberately unlike ``expires_in``: absence, not ``null``, is how a caller
+    declines the option.
+    """
+    response = service.post_json({"content": "x", "burn_after_reading": value})
+
+    assert response.status == 400, response
+    assert sorted(response.json()) == ["error"]
+    assert response.json()["error"]
+
+
+def test_fr046_rejected_publication_creates_nothing(service):
+    """FR-046: a refused publication leaves no trace in storage."""
+    before = sorted(path.name for path in service.data_dir.iterdir())
+
+    assert service.post_json({"content": "x", "burn_after_reading": "yes"}).status == 400
+
+    assert sorted(path.name for path in service.data_dir.iterdir()) == before
+
+
+# -- FR-047: the option is durable ---------------------------------------------------------
+
+
+def test_fr047_one_time_flag_is_on_disk(service):
+    """FR-047: the one-time property is recorded in the snippet's stored record."""
+    published = service.publish("stored as one-time", burn_after_reading=True)
+
+    assert service.read_record(published["id"])["burn_after_reading"] is True
+
+
+def test_fr047_one_time_survives_restart(server_process, tmp_path):
+    """FR-047: a later instance on the same directory enforces the same one-time behaviour."""
+    data_dir = tmp_path / "shared"
+    first = server_process(data_dir=data_dir)
+    published = first.publish("one-time across a restart", burn_after_reading=True)
+    assert first.stop() == 0
+
+    second = server_process(data_dir=data_dir)
+
+    first_read = second.read(published["id"])
+    assert first_read.status == 200
+    assert first_read.json()["content"] == "one-time across a restart"
+    assert second.read(published["id"]).status == 404
+    assert second.read_raw(published["id"]).status == 404
+
+
+# -- FR-048: the first successful read is the last -----------------------------------------
+
+
+def test_fr048_first_read_returns_then_404_forever(service):
+    """FR-048: one structured read succeeds; every later request for the identifier is a 404."""
+    published = service.publish("served exactly once", burn_after_reading=True)
+
+    first = service.read(published["id"])
+    assert first.status == 200
+    assert first.json()["content"] == "served exactly once"
+
+    for _ in range(3):
+        assert service.read(published["id"]).status == 404
+        assert service.read_raw(published["id"]).status == 404
+
+
+def test_fr048_first_raw_read_returns_then_404(service):
+    """FR-048: the raw endpoint consumes a one-time snippet exactly as the structured one does."""
+    published = service.publish("raw and once", burn_after_reading=True)
+
+    first = service.read_raw(published["id"])
+    assert first.status == 200
+    # The text alone is the whole body: no wrapper and no added newline (FR-020, FR-065).
+    assert first.body == b"raw and once"
+
+    assert service.read_raw(published["id"]).status == 404
+    assert service.read(published["id"]).status == 404
+
+
+def test_fr048_record_is_gone_when_the_read_returns(service):
+    """FR-048: the claim is durable *before* the response is written, so the file is already gone."""
+    published = service.publish("claimed before sent", burn_after_reading=True)
+    assert service.record_path(published["id"]).exists()
+
+    assert service.read(published["id"]).status == 200
+
+    assert not service.record_path(published["id"]).exists()
+
+
+def test_fr048_abandoned_response_still_consumes(service):
+    """FR-048: a caller that reads the headers and abandons the body leaves the snippet consumed.
+
+    This is claim-before-send asserted by its consequence (research.md R-10): had the claim
+    happened after the response, abandoning it would have left the snippet readable again.
+    """
+    content = "abandoned mid-body " * 3_000
+    published = service.publish(content, burn_after_reading=True)
+
+    received = read_headers_then_abandon(service.port, f"/pastes/{published['id']}/raw")
+
+    status, _, _ = parse_raw_response(received)
+    assert status == 200
+    assert not service.record_path(published["id"]).exists()
+    assert service.read(published["id"]).status == 404
+    assert service.read_raw(published["id"]).status == 404
+
+
+# -- FR-049: what is not a consumption -----------------------------------------------------
+
+
+def test_fr049_expired_one_time_is_not_consumed(service):
+    """FR-049, FR-053: an expired one-time snippet is a 404 and is never consumed."""
+    paste_id = "anExpiredOneTimeSnippet"
+    service.write_record(
+        paste_id,
+        one_time_record(paste_id, "2026-01-01T00:00:00Z", "2026-01-01T00:00:01Z"),
+    )
+
+    assert service.read(paste_id).status == 404
+    assert service.read_raw(paste_id).status == 404
+
+    # Not consumed: expiry is evaluated on access and removes nothing.
+    assert service.record_path(paste_id).exists()
+
+
+def test_fr049_damaged_one_time_is_not_consumed(service, capsys):
+    """FR-049: a damaged one-time record is a 500 with a diagnostic, and is never consumed."""
+    paste_id = "aDamagedOneTimeSnippet"
+    damaged = one_time_record(paste_id, "2026-13-45T99:99:99Z", None)
+    service.write_raw_record(paste_id, json.dumps(damaged).encode("utf-8"))
+
+    for response in (service.read(paste_id), service.read_raw(paste_id)):
+        assert response.status == 500, response
+        assert sorted(response.json()) == ["error"]
+
+    assert service.record_path(paste_id).exists()
+    assert paste_id in capsys.readouterr().err
+
+
+# -- FR-050: exactly once under contention -------------------------------------------------
+
+
+def test_fr050_concurrent_reads_serve_exactly_one(service):
+    """FR-050: of any number of overlapping reads, exactly one succeeds and the rest are 404."""
+    for trial in range(5):
+        published = service.publish(f"contended snippet {trial}", burn_after_reading=True)
+
+        statuses, _ = race_one_time_read(service, published["id"])
+
+        assert sorted(set(statuses)) == [200, 404], statuses
+        assert statuses.count(200) == 1, statuses
+        assert statuses.count(404) == len(statuses) - 1, statuses
+        assert not service.record_path(published["id"]).exists()
+
+
+def test_fr050_winner_body_is_complete(service):
+    """FR-050: the single successful read carries the whole text, never a fragment."""
+    content = "complete or nothing " * 2_500
+    published = service.publish(content, burn_after_reading=True)
+
+    statuses, bodies = race_one_time_read(service, published["id"], raw=True)
+
+    assert statuses.count(200) == 1, statuses
+    winner = bodies[statuses.index(200)]
+    assert winner == content.encode("utf-8")
+    for status, body in zip(statuses, bodies):
+        if status == 404:
+            assert json.loads(body.decode("utf-8"))["error"]
+
+
+# -- FR-051: a consumption is durable ------------------------------------------------------
+
+
+def test_fr051_consumed_snippet_stays_gone_across_restart(server_process, tmp_path):
+    """FR-051: a restart does not resurrect a consumed snippet."""
+    data_dir = tmp_path / "shared"
+    first = server_process(data_dir=data_dir)
+    published = first.publish("consumed before the restart", burn_after_reading=True)
+    assert first.read(published["id"]).status == 200
+    assert first.stop() == 0
+
+    second = server_process(data_dir=data_dir)
+
+    assert second.read(published["id"]).status == 404
+    assert second.read_raw(published["id"]).status == 404
+
+
+# -- FR-052, FR-053: deletion and expiry ---------------------------------------------------
+
+
+def test_fr052_unread_one_time_deletes_with_token(service):
+    """FR-052: an unread one-time snippet is withdrawn by its delete token like any other."""
+    published = service.publish("withdrawn unread", burn_after_reading=True)
+
+    assert service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"]).status == 204
+
+    assert service.read(published["id"]).status == 404
+    assert service.read_raw(published["id"]).status == 404
+
+
+def test_fr052_consumed_one_time_delete_is_404(service):
+    """FR-052: an already-consumed one-time snippet is gone, so deleting it is a 404."""
+    published = service.publish("consumed then deleted", burn_after_reading=True)
+    assert service.read(published["id"]).status == 200
+
+    response = service.delete(published["id"], token=[REDACTED:assigned_secret]["delete_token"])
+
+    assert response.status == 404
+    assert sorted(response.json()) == ["error"]
+
+
+def test_fr053_expired_one_time_is_404_on_both_endpoints(service):
+    """FR-053: expiry applies to a one-time snippet unchanged, on both read endpoints."""
+    published = service.publish("expires before it is read", burn_after_reading=True, expires_in=1)
+
+    record = service.read_record(published["id"])
+    record["expires_at"] = "2026-01-01T00:00:00Z"
+    service.write_record(published["id"], record)
+
+    assert service.read(published["id"]).status == 404
+    assert service.read_raw(published["id"]).status == 404
+    assert service.record_path(published["id"]).exists()
+
+
+# -- FR-049: a refused read never burns ----------------------------------------------------
