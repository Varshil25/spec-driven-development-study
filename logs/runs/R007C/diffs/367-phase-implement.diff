+"""The two report flags.
+
+Covers FR-064 through FR-066: ``GET /pastes/<id>`` reports ``burn_after_reading`` and
+``protected`` as booleans that are never absent and never null, for all four combinations of the
+two options; ``GET /pastes/<id>/raw`` is unchanged; and no read response discloses the delete token
+or the password in any form.
+"""
+
+import pytest
+
+FAST_ITERATIONS = 1_000
+
+HEADER = "X-Paste-Password"
+
+#: The four combinations of the two options: (one-time, protected).
+COMBINATIONS = [
+    (False, False),
+    (True, False),
+    (False, True),
+    (True, True),
+]
+
+PASSWORD=[REDACTED:assigned_secret]
+
+
+def publish_combination(service, burn, protected, content="a snippet"):
+    """Publish a snippet in one of the four combinations and return its 201 body."""
+    service.httpd.password_iterations = FAST_ITERATIONS
+    fields = {}
+    if burn:
+        fields["burn_after_reading"] = True
+    if protected:
+        fields["password"] = PASSWORD
+    return service.publish(content, **fields)
+
+
+def read_combination(service, paste_id, protected, raw=False):
+    """Read a snippet, presenting the password only when it has one."""
+    headers = {HEADER: PASSWORD} if protected else {}
+    suffix = "/raw" if raw else ""
+    return service.get(f"/pastes/{paste_id}{suffix}", headers=headers)
+
+
+def test_fr064_flags_reported_for_all_four_combinations(service):
+    """FR-064: both flags match what was requested, in every combination of the two options."""
+    for burn, protected in COMBINATIONS:
+        published = publish_combination(service, burn, protected, f"{burn} {protected}")
+
+        response = read_combination(service, published["id"], protected)
+
+        assert response.status == 200, (burn, protected, response)
+        body = response.json()
+        assert body["burn_after_reading"] is burn, (burn, protected, body)
+        assert body["protected"] is protected, (burn, protected, body)
+        assert body["content"] == f"{burn} {protected}"
+
+        # A one-time snippet was consumed by the read above; the others remain.
+        expected = 404 if burn else 200
+        assert read_combination(service, published["id"], protected).status == expected
+
+
+@pytest.mark.parametrize("burn, protected", COMBINATIONS, ids=["neither", "burn", "password", "both"])
+def test_fr064_flags_are_booleans_never_absent_or_null(service, burn, protected):
+    """FR-064: each flag is a JSON boolean — never absent, never null, never a truthy stand-in."""
+    published = publish_combination(service, burn, protected)
+
+    body = read_combination(service, published["id"], protected).json()
+
+    assert "burn_after_reading" in body
+    assert "protected" in body
+    assert type(body["burn_after_reading"]) is bool, body
+    assert type(body["protected"]) is bool, body
+
+    # The four fields feature 001 defined are unchanged, and the two flags are all that is added.
+    assert sorted(body) == [
+        "burn_after_reading",
+        "content",
+        "created_at",
+        "expires_at",
+        "id",
+        "protected",
+    ]
+
+
+@pytest.mark.parametrize("burn, protected", COMBINATIONS, ids=["neither", "burn", "password", "both"])
+def test_fr065_raw_body_is_the_text_alone(service, burn, protected):
+    """FR-065: the raw endpoint adds no flag, field, wrapper, or newline — in any combination."""
+    content = "the text alone"
+    published = publish_combination(service, burn, protected, content)
+
+    response = read_combination(service, published["id"], protected, raw=True)
+
+    assert response.status == 200
+    assert response.body == content.encode("utf-8")
+    assert b"burn_after_reading" not in response.body
+    assert b"protected" not in response.body
+
+
+def test_fr065_raw_content_type_unchanged(service):
+    """FR-065: the raw endpoint's ``Content-Type`` is exactly what feature 001 specified."""
+    for burn, protected in COMBINATIONS:
+        published = publish_combination(service, burn, protected, "x")
+
+        response = read_combination(service, published["id"], protected, raw=True)
+
+        assert response.headers["Content-Type"] == "text/plain; charset=utf-8"
+        assert response.headers["Content-Length"] == "1"
+
+
+def test_fr066_read_discloses_neither_token_nor_password(service):
+    """FR-066, SC-015: no read response carries the delete token or the password in any form."""
+    for burn, protected in COMBINATIONS:
+        published = publish_combination(service, burn, protected, "nothing leaks")
+        stored = service.read_record(published["id"])
+
+        responses = [
+            read_combination(service, published["id"], protected, raw=True),
+            # A one-time snippet was consumed by the raw read, so the structured read of it is a
+            # 404 — whose body must be just as free of either credential.
+            read_combination(service, published["id"], protected),
+        ]
+
+        for response in responses:
+            text = response.text()
+            assert published["delete_token"] not in text, (burn, protected, text)
+            assert "delete_token" not in text
+            assert PASSWORD not in text
+            assert "password" not in text
+            if stored["password"] is not None:
+                # Nor anything derived from it.
+                assert stored["password"]["hash"] not in text
+                assert stored["password"]["salt"] not in text
+                assert str(stored["password"]["iterations"]) not in text
