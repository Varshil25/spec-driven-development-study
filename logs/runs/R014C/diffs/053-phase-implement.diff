index 0000000..2e579ce
--- /dev/null
+++ b/src/accounts/tokens.py
@@ -0,0 +1,104 @@
+"""One-time password-reset tokens.
+
+A token is 32 random bytes rendered as URL-safe text (``secrets.token_urlsafe``)
+and is shown exactly once, when ``reset-token`` prints it.  Only a SHA-256
+digest of it is kept in the store, together with the moment it expires::
+
+    "reset_token": {
+      "algorithm": "sha256",
+      "hash": "<hex>",
+      "issued_at": "2026-11-14T12:00:00+00:00",
+      "expires_at": "2026-11-14T12:15:00.123456+00:00"
+    }
+
+Hashing the token means a stolen store file does not hand out working reset
+tokens.  A plain digest is enough here (unlike for passwords): the token has
+256 bits of entropy, so it cannot be guessed or attacked with a dictionary.
+
+The record is removed from the account as soon as the token is used, which is
+what makes the token one-time; issuing a new token replaces any earlier one.
+"""
+
+from __future__ import annotations
+
+import datetime as _dt
+import hashlib
+import hmac
+import secrets
+from typing import Any
+
+#: Default lifetime of a reset token, in seconds (15 minutes).
+DEFAULT_TTL_SECONDS = 900
+
+TOKEN_BYTES = 32
+TOKEN_ALGORITHM = "sha256"
+
+
+def now_utc() -> _dt.datetime:
+    """Return the current time as an aware UTC timestamp."""
+    return _dt.datetime.now(_dt.timezone.utc)
+
+
+def new_token() -> str:
+    """Return a fresh, unpredictable reset token."""
+    return secrets.token_urlsafe(TOKEN_BYTES)
+
+
+def hash_token(token: str) -> str:
+    """Return the hex digest stored for ``token``."""
+    return hashlib.sha256(token.encode("utf-8")).hexdigest()
+
+
+def make_record(token: str, ttl_seconds: int, now: _dt.datetime | None = None) -> dict[str, Any]:
+    """Return the JSON-serialisable record describing ``token``."""
+    moment = now or now_utc()
+    expires = moment + _dt.timedelta(seconds=ttl_seconds)
+    return {
+        "algorithm": TOKEN_ALGORITHM,
+        "hash": hash_token(token),
+        "issued_at": moment.replace(microsecond=0).isoformat(),
+        "expires_at": expires.isoformat(),
+    }
+
+
+def _expires_at(record: dict[str, Any]) -> _dt.datetime | None:
+    """Return the expiry of ``record``, or ``None`` if it cannot be read."""
+    raw = record.get("expires_at")
+    if not isinstance(raw, str):
+        return None
+    try:
+        moment = _dt.datetime.fromisoformat(raw)
+    except ValueError:
+        return None
+    if moment.tzinfo is None:  # a naive timestamp is read as UTC
+        moment = moment.replace(tzinfo=_dt.timezone.utc)
+    return moment
+
+
+def is_expired(record: dict[str, Any], now: _dt.datetime | None = None) -> bool:
+    """Say whether ``record`` has expired.
+
+    A record without a readable expiry counts as expired, so a damaged or
+    hand-edited entry can never be used to reset a password.
+    """
+    expires = _expires_at(record)
+    if expires is None:
+        return True
+    return (now or now_utc()) >= expires
+
+
+def verify_token(token: str, record: Any, now: _dt.datetime | None = None) -> bool:
+    """Check ``token`` against a record made by :func:`make_record`.
+
+    Returns ``False`` for a wrong token, for an expired one, and for a missing
+    or unusable record (which is also how an already used token looks, since
+    using a token deletes its record).
+    """
+    if not isinstance(record, dict) or record.get("algorithm") != TOKEN_ALGORITHM:
+        return False
+    expected = record.get("hash")
+    if not isinstance(expected, str) or not expected or not token:
+        return False
+    if is_expired(record, now):
+        return False
+    return hmac.compare_digest(hash_token(token), expected)
