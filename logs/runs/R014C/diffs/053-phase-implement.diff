+$ printf '%s\nbrand new password\n' "$token" | python -m accounts --store users.db reset alice
+password reset
+$ printf '%s\nanother new password\n' "$token" | python -m accounts --store users.db reset alice
+invalid token                # the token was one-time; exit status 1
+$ python -m accounts --store users.db reset-token nobody
+no such user: nobody         # on stderr, exit status 3
 ```
 
