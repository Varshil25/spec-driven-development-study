diff --git a/pyproject.toml b/pyproject.toml
new file mode 100644
index 0000000..5ff90a9
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,15 @@
+# Test configuration only.
+#
+# There is deliberately no [project] table, no build backend, and no dependency list:
+# Constitution Principle I requires the tool to run on a bare CPython interpreter with no
+# `pip install` step. `pythonpath` is what puts `src/` on the import path for the test run
+# (research R-009); the tool itself is invoked as `PYTHONPATH=src python3 -m logredact`.
+
+[tool.pytest.ini_options]
+pythonpath = ["src"]
+testpaths = ["tests"]
+markers = ["slow: large-input cases, deselected by default"]
+# Registering the marker alone would not deselect anything, and T034's multi-hundred-MB case
+# must not run on a bare `python3 -m pytest`. A command-line `-m slow` overrides this value,
+# so `python3 -m pytest -m slow` still selects exactly those cases (quickstart.md).
+addopts = ["-m", "not slow"]
