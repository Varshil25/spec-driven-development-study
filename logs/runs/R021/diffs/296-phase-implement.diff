@@ -0,0 +1,69 @@
+"""Constitution Principle I gate: the runtime imports nothing but the standard library.
+
+Walks every `*.py` file under `src/`, parses it, and checks the top-level module name of
+every import against `sys.stdlib_module_names`. First-party modules of this repository's own
+`src/` tree are allowed; anything else would be a third-party runtime dependency, which
+Principle I forbids outright (there is no `pip install` step for this tool).
+"""
+
+from __future__ import annotations
+
+import ast
+import sys
+from pathlib import Path
+
+SRC_DIR = Path(__file__).resolve().parent.parent / "src"
+
+#: Top-level names that live in this repository rather than site-packages.
+FIRST_PARTY = {path.name for path in SRC_DIR.iterdir() if path.is_dir()} | {
+    path.stem for path in SRC_DIR.glob("*.py")
+}
+
+
+def source_files() -> list[Path]:
+    return sorted(SRC_DIR.rglob("*.py"))
+
+
+def imported_top_level_modules(path: Path) -> set[str]:
+    """Top-level module names imported by `path`. Relative imports are intra-package."""
+    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+    names: set[str] = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                names.add(alias.name.split(".")[0])
+        elif isinstance(node, ast.ImportFrom):
+            if node.level:  # `from . import x` — within the package, not a dependency
+                continue
+            if node.module:
+                names.add(node.module.split(".")[0])
+    return names
+
+
+def test_src_tree_is_not_empty() -> None:
+    """A vacuously green gate would be worse than no gate."""
+    assert source_files(), f"no Python sources found under {SRC_DIR}"
+
+
+def test_principle_i_runtime_imports_are_stdlib_only() -> None:
+    """Principle I: no third-party package may be imported by shipped code."""
+    offenders: dict[str, set[str]] = {}
+    for path in source_files():
+        foreign = {
+            name
+            for name in imported_top_level_modules(path)
+            if name not in sys.stdlib_module_names and name not in FIRST_PARTY
+        }
+        if foreign:
+            offenders[str(path.relative_to(SRC_DIR))] = foreign
+    assert not offenders, f"non-stdlib imports in runtime code: {offenders}"
+
+
+def test_principle_i_pytest_is_not_importable_from_runtime_code() -> None:
+    """Principle I: `pytest` is a development dependency and must not reach runtime code."""
+    offenders = [
+        str(path.relative_to(SRC_DIR))
+        for path in source_files()
+        if "pytest" in imported_top_level_modules(path)
+    ]
+    assert not offenders, f"runtime code imports pytest: {offenders}"