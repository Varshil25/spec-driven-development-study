+"""Shared test helpers.
+
+The contract-level tests invoke the real CLI as a subprocess rather than calling
+`cli.main()` in-process. That is not a stylistic preference (research R-009): SC-001 and
+SC-003 require byte-identical stdout and stderr plus a specific exit status, and FR-031a
+requires a closed pipe to be observable. `capsys` replaces `sys.stdout` with an object that
+has no `.buffer`, so neither the surrogateescape path nor the broken-pipe path can be
+exercised in-process at all.
+
+`run_cli` therefore returns raw `bytes`, never decoded text: byte comparison is what makes
+the non-UTF-8 (FR-005a) and line-ending (FR-007, FR-007a) assertions meaningful.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC_DIR = REPO_ROOT / "src"
+
+
+def cli_env() -> dict[str, str]:
+    """The environment the tool is invoked under: `src/` on PYTHONPATH, nothing installed."""
+    env = os.environ.copy()
+    env["PYTHONPATH"] = str(SRC_DIR)
+    return env
+
+
+def run_cli(
+    *args: str,
+    stdin: bytes = b"",
+    cwd: str | os.PathLike[str] | None = None,
+) -> tuple[bytes, bytes, int]:
+    """Run `python -m logredact *args` as a subprocess.
+
+    Returns `(stdout_bytes, stderr_bytes, returncode)`. `cwd` is used by the tests that need
+    a relative operand spelling (for example a file literally named `-`).
+    """
+    completed = subprocess.run(
+        [sys.executable, "-m", "logredact", *args],
+        input=stdin,
+        capture_output=True,
+        env=cli_env(),
+        cwd=None if cwd is None else str(cwd),
+        check=False,
+    )
+    return completed.stdout, completed.stderr, completed.returncode
+
+
+@pytest.fixture(name="run_cli")
+def run_cli_fixture():
+    """Fixture form of `run_cli`, for tests that prefer injection over import."""
+    return run_cli
