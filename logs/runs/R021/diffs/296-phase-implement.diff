@@ -0,0 +1,225 @@
+"""I/O layer: argument parsing, stream setup, source iteration, tally, and exit status.
+
+The command-line contract this implements is specified in contracts/cli.md. `main` returns
+its exit status instead of calling `sys.exit`, so `__main__.py` is a one-liner and the whole
+CLI stays importable.
+"""
+
+from __future__ import annotations
+
+import argparse
+import collections
+import io
+import os
+import sys
+from collections.abc import Iterable, Iterator
+
+from logredact import redact
+
+
+class OutputWriteError(Exception):
+    """A write or flush of standard output failed (FR-031a).
+
+    Deliberately **not** an `OSError`. A failed write raised while a source file is being
+    iterated would otherwise be caught by that loop's `except OSError` and misreported as
+    "cannot read FILE" — a confident wrong diagnostic, which Constitution Principle II
+    treats as a failure in its own right. Not being an `OSError` is what lets this
+    exception propagate past the read handler to its own (plan.md Complexity Tracking,
+    research R-007).
+    """
+
+
+def _write(stream: io.TextIOBase, text: str) -> None:
+    """Write `text`, converting any OS-level failure into `OutputWriteError`."""
+    try:
+        stream.write(text)
+    except OSError as exc:  # closed pipe, full destination, I/O error, ...
+        raise OutputWriteError("write to standard output failed") from exc
+
+
+def _flush(stream: io.TextIOBase) -> None:
+    """Flush `stream`, converting any OS-level failure into `OutputWriteError`.
+
+    When stdout is a pipe it is block-buffered, so a closed reader usually surfaces here
+    rather than on the write whose bytes were discarded. Both sites report identically.
+    """
+    try:
+        stream.flush()
+    except OSError as exc:
+        raise OutputWriteError("flush of standard output failed") from exc
+
+
+def _text_stream(binary_stream: io.BufferedIOBase, *, write: bool) -> io.TextIOWrapper:
+    """Wrap a binary stream in the one text configuration this tool is allowed to use.
+
+    All three settings are load-bearing (research R-001, R-002):
+
+    * `errors="surrogateescape"` round-trips bytes that are not valid UTF-8 byte for byte,
+      with no replacement character and no failure (FR-005a).
+    * `newline="\\n"` means *only* a newline terminates a line and the terminator is handed
+      back untranslated, so `\\r\\n` survives as `\\r\\n`, a bare `\\r` stays ordinary text
+      (FR-007), and a missing final newline stays missing (FR-007a). Neither
+      `newline=None` (translates `\\r\\n`) nor `newline=""` (still splits on `\\r`) would do.
+    * `encoding="utf-8"` fixes the codec regardless of the ambient locale.
+
+    `write` selects the buffering policy, which is the only difference between the two
+    directions: an output stream attached to a terminal is line-buffered so interactive use
+    echoes line by line, while a piped or redirected stream stays block-buffered, which is
+    what FR-031a's detection assumes.
+    """
+    return io.TextIOWrapper(
+        binary_stream,
+        encoding="utf-8",
+        errors="surrogateescape",
+        newline="\n",
+        line_buffering=write and binary_stream.isatty(),
+    )
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    """The argument parser.
+
+    `prog` is set explicitly because under `python -m logredact` argparse would compute
+    `__main__.py`, printing a usage line a reader cannot copy (research R-006).
+
+    There is deliberately no custom error handling and no `exit_on_error` override:
+    argparse's stock behaviour *is* the specified behaviour — usage to stderr with exit 2
+    for an unrecognized option (FR-030), and usage to stdout with exit 0 for `--help`
+    or `-h` (FR-030a).
+    """
+    parser = argparse.ArgumentParser(
+        prog="python -m logredact",
+        description=(
+            "Replace email addresses, IPv4 addresses, and Luhn-valid 13-19 digit payment "
+            "card numbers in log text with [EMAIL], [IP], and [CARD]. Everything else is "
+            "passed through unchanged."
+        ),
+        epilog="With no FILE operand, standard input is read. A FILE of '-' is a file named '-'.",
+    )
+    parser.add_argument(
+        "--count",
+        action="store_true",
+        help="after all output is written, report a tally of replacements on standard error",
+    )
+    parser.add_argument(
+        "files",
+        nargs="*",
+        metavar="FILE",
+        help="paths to read, in the order given; standard input is read when none is given",
+    )
+    return parser
+
+
+def main(argv: list[str]) -> int:
+    """Run the tool. Returns the process exit status: only ever 0 or 2.
+
+    `parse_intermixed_args` rather than `parse_args`: with `nargs="*"` the latter rejects
+    `a.log --count b.log` as "unrecognized arguments", which FR-001 requires to be accepted
+    (research R-006). Parsing happens before any stream is touched and before any source is
+    opened, so a help request or a usage error never reads input (FR-030a).
+    """
+    parser = _build_parser()
+    args = parser.parse_intermixed_args(argv)
+
+    stdout = sys.stdout = _text_stream(sys.stdout.buffer, write=True)
+
+    # The keys are never pre-seeded: reading a never-incremented key already yields 0,
+    # which is exactly what FR-026 requires for a category with no replacements.
+    total: collections.Counter = collections.Counter()
+    read_error: str | None = None
+
+    try:
+        if args.files:
+            # The display name is the path exactly as given on the command line — not
+            # resolved, not made absolute — because FR-028's diagnostic must use that
+            # spelling (data-model.md section 1).
+            for path in args.files:
+                try:
+                    _redact_stream(_iter_source_lines(path), stdout, total)
+                except OSError as exc:
+                    # The only `except OSError` on the read side. It does not swallow:
+                    # the failure is re-reported as a diagnostic that names the path and
+                    # the run still fails (Constitution Principle II).
+                    read_error = f"logredact: error: cannot read {path!r}: {exc}\n"
+                    break  # stop reading further sources (FR-029)
+        else:
+            # Wrapped only on the branch that actually reads it, so a run with operands
+            # does not so much as touch standard input (FR-003).
+            stdin = sys.stdin = _text_stream(sys.stdin.buffer, write=False)
+            _redact_stream(stdin, stdout, total)
+
+        # Inside the guard, so a failure here is reported as a write failure rather than
+        # going unnoticed; and before the tally, which is FR-024.
+        _flush(stdout)
+    except OutputWriteError:
+        # Reached from either `_write` or `_flush`, and reached even from inside the
+        # per-source loop above, because `OutputWriteError` is not an `OSError` and so
+        # propagates past that loop's read handler.
+        sys.stderr.write("logredact: error: failed writing to standard output\n")
+        _silence_stdout()
+        return 2  # never 0: a truncated log must be distinguishable (FR-031a, SC-009)
+
+    if read_error is not None:
+        # Written after the flush, so the output produced before the failure is on its way
+        # to the destination. No tally is written, even with `--count` (FR-029).
+        sys.stderr.write(read_error)
+        return 2
+
+    if args.count:
+        # Written only after the flush above succeeded (FR-024): a consumer redirecting
+        # the two streams separately always sees a complete log before the summary, and a
+        # failed flush suppresses the tally rather than vouching for a truncated log.
+        # The three keys are named explicitly because the order is fixed by FR-023 and
+        # must not come from the Counter's insertion order.
+        sys.stderr.write(
+            f"emails={total['emails']} ips={total['ips']} cards={total['cards']}\n"
+        )
+    return 0
+
+
+def _silence_stdout() -> None:
+    """Point file descriptor 1 at the null device after a failed write (FR-031a).
+
+    Required, not cosmetic. CPython flushes `sys.stdout` during interpreter shutdown, and
+    a flush that fails there prints `Exception ignored in: <_io.TextIOWrapper ...>` with a
+    traceback to stderr — text FR-031a forbids and SC-005 asserts the absence of. With fd
+    1 pointing at the null device the shutdown flush succeeds silently (research R-007).
+
+    Note what is deliberately *not* done here: `signal.signal(SIGPIPE, SIG_DFL)`. CPython's
+    inherited `SIG_IGN` is what turns a closed reader into a catchable `BrokenPipeError`
+    instead of killing the process with no diagnostic and no exit status.
+    """
+    null_fd = os.open(os.devnull, os.O_WRONLY)
+    try:
+        os.dup2(null_fd, 1)
+    finally:
+        os.close(null_fd)
+
+
+def _iter_source_lines(path: str) -> Iterator[str]:
+    """Yield the lines of `path`, with the same three text settings as `_text_stream`.
+
+    A generator, so the file is opened only when the consumer asks for its first line and
+    is closed before the next source is opened (data-model.md section 1). That laziness is
+    what makes FR-029's "output already written for earlier sources remains written" true,
+    and it is why no source is opened at all on a help run (FR-030a).
+    """
+    with open(path, encoding="utf-8", errors="surrogateescape", newline="\n") as source:
+        yield from source
+
+
+def _redact_stream(
+    lines: Iterable[str], stdout: io.TextIOWrapper, total: collections.Counter
+) -> None:
+    """Redact `lines` one at a time, writing each result as soon as it is produced.
+
+    One line is resident at a time and nothing accumulates except the three running
+    totals, so peak memory is bounded by the longest line rather than by the total size of
+    the input (SC-006). Iterating the text stream directly is what yields each line
+    *including* its trailing newline when one is present, which is what FR-007 and FR-007a
+    rest on.
+    """
+    for line in lines:
+        text, line_counts = redact.redact_line(line)
+        _write(stdout, text)
+        total.update(line_counts)
