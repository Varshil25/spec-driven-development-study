new file mode 100644
index 0000000..88fc4f5
--- /dev/null
+++ b/tests/test_fidelity.py
@@ -0,0 +1,216 @@
+"""Cross-story fidelity criteria: SC-002, SC-003, and SC-008.
+
+These exercise the whole tool through its real command line, because what they assert is a
+property of the delivered stream rather than of any one recognition rule.
+"""
+
+from __future__ import annotations
+
+import re
+
+from conftest import run_cli
+
+# --------------------------------------------------------------------------------------
+# SC-002: a mixed fixture of planted personal data and look-alikes
+# --------------------------------------------------------------------------------------
+
+#: Personal data planted in the fixture: 100% of these must be redacted.
+PLANTED: list[tuple[str, str]] = [
+    ("jane@example.com", "[EMAIL]"),
+    ("jane.doe+test@mail.example.com", "[EMAIL]"),
+    ("a@b.io", "[EMAIL]"),
+    ("user_name%tag-1@sub.domain.co.uk", "[EMAIL]"),
+    ("admin@1.2.3.4", "[EMAIL]"),
+    ("192.168.0.10", "[IP]"),
+    ("10.0.0.7", "[IP]"),
+    ("0.0.0.0", "[IP]"),
+    ("255.255.255.255", "[IP]"),
+    ("010.0.0.1", "[IP]"),
+    ("4111111111111111", "[CARD]"),
+    ("4111 1111 1111 1111", "[CARD]"),
+    ("4111-1111-1111-1111", "[CARD]"),
+    ("4111-1111 1111-1111", "[CARD]"),
+]
+
+#: Look-alikes the specification names: 0% of these may be altered.
+LOOKALIKES: list[str] = [
+    "999.1.1.1",  # out-of-range octet
+    "256.1.1.1",  # out-of-range octet
+    "1.2.3.4.5",  # five-part dotted number
+    "1.2.3.4.5.6",  # six-part dotted number
+    "1.2.3.45678",  # trailing digits
+    "1.2.3",  # three groups
+    "12345.1.1.1",  # leading digits
+    "1234567890123",  # Luhn-failing 13-digit run
+    "411111111111",  # 12 digits, too short
+    "4111  1111  1111  1111",  # doubled separators
+    "9" * 25,  # over-length digit run
+    "0" * 20,  # over-length run in which every inner stretch is Luhn-valid
+    "jane@localhost",  # single-label domain
+    "jane@example",  # fewer than two labels
+    "admin@999.1.1.1",  # neither a hostname nor a dotted quad
+    "[EMAIL]",  # placeholder already present
+    "[IP]",
+    "[CARD]",
+    "2026-11-20T06:34:01",  # a timestamp is not a card number
+    "build=1.2.3 pid=4211",  # ordinary log furniture
+]
+
+MIN_FIXTURE_LINES = 200
+
+
+def build_mixed_fixture() -> tuple[bytes, bytes, dict[str, int]]:
+    """Return `(input_bytes, expected_output_bytes, expected_tally)`.
+
+    Each token sits on its own line behind a `L0001: ` prefix whose digits are terminated
+    by a colon, so the line number can never join the token into one digit run.
+    """
+    tokens: list[tuple[str, str, str | None]] = [
+        (token, placeholder, placeholder) for token, placeholder in PLANTED
+    ] + [(token, token, None) for token in LOOKALIKES]
+
+    source: list[str] = []
+    expected: list[str] = []
+    tally = {"emails": 0, "ips": 0, "cards": 0}
+    key = {"[EMAIL]": "emails", "[IP]": "ips", "[CARD]": "cards"}
+
+    number = 0
+    while len(source) < MIN_FIXTURE_LINES:
+        for token, replacement, placeholder in tokens:
+            number += 1
+            source.append(f"L{number:04d}: {token} tail\n")
+            expected.append(f"L{number:04d}: {replacement} tail\n")
+            if placeholder is not None:
+                tally[key[placeholder]] += 1
+
+    return (
+        "".join(source).encode("utf-8"),
+        "".join(expected).encode("utf-8"),
+        tally,
+    )
+
+
+def test_sc002_all_planted_personal_data_is_redacted_and_no_lookalike_is_altered() -> None:
+    """SC-002: 100% of the planted data redacted, 0% of the look-alike tokens altered."""
+    source, expected, tally = build_mixed_fixture()
+    assert source.count(b"\n") >= MIN_FIXTURE_LINES
+
+    stdout, stderr, status = run_cli("--count", stdin=source)
+    assert status == 0
+    assert stdout == expected
+
+    text = stdout.decode("utf-8")
+    for token, _placeholder in PLANTED:
+        assert token not in text, f"planted {token!r} survived redaction"
+    for token in LOOKALIKES:
+        assert token in text, f"look-alike {token!r} was altered"
+
+    assert stderr == (
+        f"emails={tally['emails']} ips={tally['ips']} cards={tally['cards']}\n".encode()
+    )
+
+
+# --------------------------------------------------------------------------------------
+# SC-003: byte-identical pass-through when there is nothing to redact
+# --------------------------------------------------------------------------------------
+
+#: One fixture covering every form SC-003 names. Look-alike tokens are separated by commas
+#: rather than spaces: a single space is a card separator, so `3, 1234567890123` keeps the
+#: two digit runs apart where `3 1234567890123` would join them into one 14-digit run.
+SC003_FIXTURE = (
+    b"plain line with nothing to hide\r\n"
+    b"bare\rCR is ordinary text\n"
+    b"\n"
+    b"   \n"
+    b"\t \t\n"
+    b"\ttabs\tand  doubled  spaces   \n"
+    b"raw byte: \xff here\n"
+    b"more raw bytes: \x80\xfe\xc0\n"
+    b"look-alikes: 999.1.1.1, 256.1.1.1, 1.2.3, 1.2.3.4.5, 1.2.3.45678\n"
+    b"more look-alikes: 1234567890123, 411111111111, " + b"9" * 25 + b", " + b"0" * 20 + b"\n"
+    b"doubled separators: 4111  1111  1111  1111\n"
+    b"already redacted: [EMAIL] [IP] [CARD]\n"
+    b"unicode: caf\xc3\xa9 \xc3\xbcber \xe4\xb8\xad\xe6\x96\x87\n"
+    b"crlf again\r\n"
+    b"no trailing newline"
+)
+
+
+def test_sc003_output_is_byte_identical_when_there_is_nothing_to_redact() -> None:
+    """SC-003: blank lines, odd whitespace, CRLF, mixed endings, a bare CR, non-UTF-8
+    bytes, and a missing final newline all survive byte for byte (quickstart V2)."""
+    stdout, stderr, status = run_cli(stdin=SC003_FIXTURE)
+    assert status == 0
+    assert stderr == b""
+    assert stdout == SC003_FIXTURE
+
+
+def test_sc003_output_is_byte_identical_when_read_from_a_file(tmp_path) -> None:
+    """SC-003: the file path and the stdin path give the same byte-exact result."""
+    path = tmp_path / "fidelity.log"
+    path.write_bytes(SC003_FIXTURE)
+    stdout, stderr, status = run_cli("--count", str(path))
+    assert status == 0
+    assert stdout == SC003_FIXTURE
+    assert stderr == b"emails=0 ips=0 cards=0\n"
+
+
+def test_sc003_no_replacement_character_is_ever_introduced() -> None:
+    """SC-003 / FR-005a: an undecodable byte is never turned into U+FFFD."""
+    stdout, _, status = run_cli(stdin=SC003_FIXTURE)
+    assert status == 0
+    assert b"\xef\xbf\xbd" not in stdout
+
+
+# --------------------------------------------------------------------------------------
+# SC-008: the tally equals the placeholders present in the output
+# --------------------------------------------------------------------------------------
+
+TALLY_LINE = re.compile(rb"^emails=(\d+) ips=(\d+) cards=(\d+)\n$")
+
+
+def test_sc008_the_tally_equals_the_placeholder_count_in_the_output_stream() -> None:
+    """SC-008: verified by counting placeholders in the redacted stream itself."""
+    source, _expected, _tally = build_mixed_fixture()
+    stdout, stderr, status = run_cli("--count", stdin=source)
+    assert status == 0
+
+    match = TALLY_LINE.match(stderr)
+    assert match is not None, stderr
+    reported = {
+        "emails": int(match.group(1)),
+        "ips": int(match.group(2)),
+        "cards": int(match.group(3)),
+    }
+    counted = {
+        "emails": stdout.count(b"[EMAIL]"),
+        "ips": stdout.count(b"[IP]"),
+        "cards": stdout.count(b"[CARD]"),
+    }
+    # The fixture also plants literal placeholders that must not be counted, so subtract
+    # the ones that were already there rather than comparing raw occurrences.
+    pre_existing = {
+        "emails": source.count(b"[EMAIL]"),
+        "ips": source.count(b"[IP]"),
+        "cards": source.count(b"[CARD]"),
+    }
+    for category in ("emails", "ips", "cards"):
+        assert reported[category] == counted[category] - pre_existing[category], category
+        assert reported[category] > 0, f"the fixture must exercise {category}"
+
+
+def test_sc008_holds_across_several_files(tmp_path) -> None:
+    """SC-008: the identity holds for a multi-source run, not only for one stream."""
+    first = tmp_path / "a.log"
+    second = tmp_path / "b.log"
+    first.write_bytes(b"a@b.io 1.2.3.4\n4111111111111111\n")
+    second.write_bytes(b"c@d.io\n999.1.1.1 1234567890123\n")
+    stdout, stderr, status = run_cli("--count", str(first), str(second))
+    assert status == 0
+    match = TALLY_LINE.match(stderr)
+    assert match is not None, stderr
+    assert (int(match.group(1)), int(match.group(2)), int(match.group(3))) == (
+        stdout.count(b"[EMAIL]"),
+        stdout.count(b"[IP]"),
+        stdout.count(b"[CARD]"),
+    )
diff --git a/tests/test_performance.py b/tests/test_performance.py
new file mode 100644
index 0000000..04e3468
--- /dev/null
+++ b/tests/test_performance.py
@@ -0,0 +1,170 @@
+"""Scale criteria: SC-006 (bounded memory) and SC-007 (throughput).
+
+How the memory figure is obtained: the tool is run as the single child of a freshly forked
+process, so `RUSAGE_CHILDREN` in that fork starts at zero and its `ru_maxrss` is the tool's
+own peak resident set rather than a running maximum polluted by earlier tests.
+
+What is *not* done here, stated plainly (research R-008): SC-006 names a 1 GB log, and the
+default suite does not generate one. It proves instead the two properties that figure rests
+on — that a single 10 MB line is handled, and that peak resident memory is flat as the line
+count grows by orders of magnitude — and reaches the 1 GB figure by extrapolation from that
+flatness. The `slow`-marked test below runs a multi-hundred-megabyte stream directly for
+anyone who wants the evidence without the extrapolation; it is deselected by default.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import time
+
+import pytest
+
+from conftest import cli_env
+
+resource = pytest.importorskip("resource", reason="POSIX resource accounting is required")
+
+requires_fork = pytest.mark.skipif(
+    not hasattr(os, "fork"), reason="peak-RSS measurement needs os.fork"
+)
+
+#: SC-007's figure.
+THROUGHPUT_LINES = 100_000
+THROUGHPUT_LIMIT_SECONDS = 30.0
+
+#: SC-006's single-line figure: 10 MB on one line.
+LONG_LINE_BYTES = 10_000_000
+
+#: A ceiling for the 10 MB case. Peak measures around 40 MB (interpreter included), so this
+#: leaves generous headroom while still failing loudly if the whole line were ever buffered
+#: several times over.
+LONG_LINE_PEAK_LIMIT_KB = 150_000
+
+#: Line counts used for the flatness check, three orders of magnitude apart.
+FLATNESS_LINE_COUNTS = (1_000, 200_000)
+
+#: Peak must not grow by more than this factor across those counts. Observed ratio is 1.0.
+FLATNESS_TOLERANCE = 1.5
+
+
+def write_line_fixture(path, count: int) -> None:
+    """A log with personal data of all three kinds on every line."""
+    with open(path, "w", encoding="utf-8") as handle:
+        for number in range(count):
+            handle.write(f"{number} jane@example.com 10.0.0.7 4111 1111 1111 1111\n")
+
+
+def run_measured(argv: list[str], source) -> tuple[int, int, float]:
+    """Run `argv` with `source` on stdin. Returns `(peak_rss_kb, returncode, seconds)`."""
+    read_fd, write_fd = os.pipe()
+    pid = os.fork()
+    if pid == 0:  # child: the tool's only parent, so RUSAGE_CHILDREN is its alone
+        os.close(read_fd)
+        try:
+            with open(source, "rb") as stdin, open(os.devnull, "wb") as sink:
+                started = time.monotonic()
+                completed = subprocess.run(
+                    argv, stdin=stdin, stdout=sink, stderr=sink, env=cli_env(), check=False
+                )
+                elapsed = time.monotonic() - started
+            usage = resource.getrusage(resource.RUSAGE_CHILDREN)
+            os.write(write_fd, f"{usage.ru_maxrss} {completed.returncode} {elapsed:.3f}".encode())
+        finally:
+            os._exit(0)
+
+    os.close(write_fd)
+    payload = os.read(read_fd, 256).decode()
+    os.close(read_fd)
+    os.waitpid(pid, 0)
+    peak_kb, returncode, elapsed = payload.split()
+    return int(peak_kb), int(returncode), float(elapsed)
+
+
+TOOL = [sys.executable, "-m", "logredact"]
+
+
+def test_sc007_a_hundred_thousand_line_log_is_redacted_well_under_thirty_seconds(tmp_path) -> None:
+    """SC-007: a 100,000-line log is redacted in under 30 seconds."""
+    source = tmp_path / "100k.log"
+    write_line_fixture(source, THROUGHPUT_LINES)
+
+    started = time.monotonic()
+    with open(source, "rb") as stdin, open(os.devnull, "wb") as sink:
+        completed = subprocess.run(
+            [*TOOL, "--count"],
+            stdin=stdin,
+            stdout=sink,
+            stderr=subprocess.PIPE,
+            env=cli_env(),
+            check=False,
+        )
+    elapsed = time.monotonic() - started
+
+    assert completed.returncode == 0
+    assert completed.stderr == (
+        f"emails={THROUGHPUT_LINES} ips={THROUGHPUT_LINES} cards={THROUGHPUT_LINES}\n".encode()
+    )
+    assert elapsed < THROUGHPUT_LIMIT_SECONDS, f"took {elapsed:.1f}s"
+
+
+@requires_fork
+def test_sc006_a_ten_megabyte_single_line_is_redacted_within_bounded_memory(tmp_path) -> None:
+    """SC-006: a single line of at least 10 MB is handled, with peak on the order of the line."""
+    source = tmp_path / "longline.log"
+    source.write_text("x " * (LONG_LINE_BYTES // 2) + "a@b.io\n", encoding="utf-8")
+    assert source.stat().st_size >= LONG_LINE_BYTES
+    assert source.read_bytes().count(b"\n") == 1, "the fixture must be a single line"
+
+    peak_kb, returncode, _elapsed = run_measured(TOOL, source)
+    assert returncode == 0
+    assert peak_kb < LONG_LINE_PEAK_LIMIT_KB, (
+        f"peak RSS {peak_kb} kB exceeds {LONG_LINE_PEAK_LIMIT_KB} kB for a "
+        f"{LONG_LINE_BYTES // 1_000_000} MB line"
+    )
+
+
+@requires_fork
+def test_sc006_peak_memory_does_not_grow_with_the_number_of_lines(tmp_path) -> None:
+    """SC-006: memory use is not proportional to total input size.
+
+    This flatness is what the 1 GB figure in SC-006 is extrapolated from: the input grows
+    200-fold here while the peak resident set does not move.
+    """
+    peaks: dict[int, int] = {}
+    for count in FLATNESS_LINE_COUNTS:
+        source = tmp_path / f"lines-{count}.log"
+        write_line_fixture(source, count)
+        peak_kb, returncode, _elapsed = run_measured(TOOL, source)
+        assert returncode == 0
+        peaks[count] = peak_kb
+
+    smallest, largest = min(FLATNESS_LINE_COUNTS), max(FLATNESS_LINE_COUNTS)
+    growth = peaks[largest] / peaks[smallest]
+    assert growth < FLATNESS_TOLERANCE, (
+        f"peak RSS grew {growth:.2f}x from {smallest} to {largest} lines "
+        f"({peaks[smallest]} kB -> {peaks[largest]} kB)"
+    )
+
+
+@pytest.mark.slow
+@requires_fork
+def test_sc006_resident_memory_stays_flat_on_a_multi_hundred_megabyte_stream(tmp_path) -> None:
+    """SC-006: the large case run directly rather than by extrapolation (deselected by default).
+
+    Run it with `python3 -m pytest -m slow`.
+    """
+    lines = 5_000_000  # roughly 265 MB of input at ~53 bytes a line
+    source = tmp_path / "huge.log"
+    write_line_fixture(source, lines)
+    size_bytes = source.stat().st_size
+    assert size_bytes > 200_000_000, f"fixture is only {size_bytes} bytes"
+
+    peak_kb, returncode, _elapsed = run_measured(TOOL, source)
+    assert returncode == 0
+    # A ceiling far below the input size: if anything accumulated per line, a 265 MB
+    # stream could not finish inside 150 MB of resident memory.
+    assert peak_kb < LONG_LINE_PEAK_LIMIT_KB, (
+        f"peak RSS {peak_kb} kB on a {size_bytes // 1_000_000} MB stream"
+    )
+    assert peak_kb * 1024 < size_bytes, "peak memory must be smaller than the input itself"
diff --git a/tests/test_redact.py b/tests/test_redact.py
new file mode 100644
index 0000000..38e97c5
--- /dev/null
+++ b/tests/test_redact.py
@@ -0,0 +1,390 @@
+"""Unit tests for the recognition grammar and per-line redaction (FR-005 - FR-022).
+
+Every test cites the functional requirement it covers in its name, as Constitution
+Principle III and SC-004 require. The grammar under test is specified in
+contracts/redaction-patterns.md; the "must not match" cases are the look-alikes the
+specification names, and each has a case here.
+
+These tests call `redact.redact_line` directly: it is a pure function, so no stream, no
+subprocess, and no capture is needed. The stream-level requirements live in test_cli.py.
+"""
+
+from __future__ import annotations
+
+import collections
+
+import pytest
+
+from logredact import redact
+
+# A 13-digit Luhn-valid number whose first 13 digits and whose full 16 digits are *both*
+# Luhn-valid once a group of three is appended, used for FR-019. Both candidates start at
+# the same position and both end where no digit follows, so both are eligible.
+CARD_13_VALID = "4111111111119"
+CARD_16_VALID_FROM_13 = "4111111111119 007"
+
+# A Luhn-valid 16-digit number embedded in an unbroken 25-digit run, used for FR-018.
+CARD_16_VALID = "4111111111111111"
+LONG_RUN_HIDING_A_VALID_CARD = "123" + CARD_16_VALID + "456789"
+
+
+def assert_redaction(line: str, expected: str, *, emails: int = 0, ips: int = 0, cards: int = 0) -> None:
+    """Assert both halves of `redact_line`'s result: the text and the per-line tally."""
+    out, counts = redact.redact_line(line)
+    assert out == expected
+    assert isinstance(counts, collections.Counter)
+    assert (counts["emails"], counts["ips"], counts["cards"]) == (emails, ips, cards)
+    assert set(counts) <= {"emails", "ips", "cards"}, f"unexpected tally keys: {set(counts)}"
+
+
+def assert_unchanged(line: str) -> None:
+    """Assert the line passes through byte for byte and contributes nothing to the tally."""
+    assert_redaction(line, line)
+
+
+# --------------------------------------------------------------------------------------
+# Email (FR-008, FR-009, FR-010)
+# --------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "address",
+    [
+        "jane@example.com",
+        "jane.doe+test@mail.example.com",
+        "a@b.io",
+        "user_name%tag-1@sub.domain.co.uk",
+    ],
+)
+def test_fr008_each_email_address_is_replaced_by_the_placeholder(address: str) -> None:
+    """FR-008: each email address is replaced with the literal text `[EMAIL]`."""
+    assert_redaction(address, "[EMAIL]", emails=1)
+
+
+def test_fr009_local_part_characters_and_multi_label_domain_are_recognized() -> None:
+    """FR-009: dots and `+` in the local part, multi-label domain, one single `[EMAIL]`."""
+    assert_redaction(
+        "from jane.doe+test@mail.example.com ok",
+        "from [EMAIL] ok",
+        emails=1,
+    )
+
+
+@pytest.mark.parametrize("address", ["jane@localhost", "jane@example", "jane@example.c"])
+def test_fr009_domain_needs_two_labels_and_a_two_letter_final_label(address: str) -> None:
+    """FR-009: a single-label domain, or a final label under two letters, is not an address."""
+    assert_unchanged(address)
+
+
+def test_fr009_out_of_range_quad_domain_is_not_an_address() -> None:
+    """FR-009: `admin@999.1.1.1` is neither a hostname nor a dotted quad, so it is left alone."""
+    assert_unchanged("admin@999.1.1.1")
+
+
+def test_fr010_the_whole_address_is_replaced_with_no_fragment_left_behind() -> None:
+    """FR-010: the match spans the whole address; the domain is not separately redacted."""
+    out, counts = redact.redact_line("mail jane.doe+test@mail.example.com now")
+    assert out == "mail [EMAIL] now"
+    assert out.count("[EMAIL]") == 1
+    for fragment in ("jane", "doe", "test", "example", "@", "[IP]"):
+        assert fragment not in out, f"fragment {fragment!r} survived the redaction"
+    assert (counts["emails"], counts["ips"], counts["cards"]) == (1, 0, 0)
+
+
+def test_fr010_a_trailing_dot_is_not_part_of_the_address() -> None:
+    """FR-010: `jane@example.com.` yields `[EMAIL].` — the sentence dot survives."""
+    assert_redaction("jane@example.com.", "[EMAIL].", emails=1)
+
+
+# --------------------------------------------------------------------------------------
+# IPv4 (FR-011, FR-012, FR-013, FR-014)
+# --------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "address",
+    ["192.168.0.10", "10.0.0.7", "1.2.3.4", "0.0.0.0", "255.255.255.255", "010.0.0.1", "00.0.0.0"],
+)
+def test_fr011_each_ipv4_address_is_replaced_by_the_placeholder(address: str) -> None:
+    """FR-011: each IPv4 address is replaced with the literal text `[IP]`."""
+    assert_redaction(address, "[IP]", ips=1)
+
+
+def test_fr012_four_groups_in_range_are_recognized_in_context() -> None:
+    """FR-012: `192.168.0.10` and `10.0.0.7` are recognized, surrounding text untouched."""
+    assert_redaction(
+        "from 192.168.0.10 via 10.0.0.7 ok",
+        "from [IP] via [IP] ok",
+        ips=2,
+    )
+
+
+def test_fr012_leading_zero_groups_are_still_addresses() -> None:
+    """FR-012: the group's *value* is what must be 0-255, so `010.0.0.1` is an address."""
+    assert_redaction("host 010.0.0.1 up", "host [IP] up", ips=1)
+
+
+@pytest.mark.parametrize("candidate", ["999.1.1.1", "256.1.1.1", "1.2.3.256"])
+def test_fr013_a_group_above_255_is_left_unchanged(candidate: str) -> None:
+    """FR-013: a candidate with any group whose value exceeds 255 is left unchanged."""
+    assert_unchanged(candidate)
+
+
+@pytest.mark.parametrize(
+    "candidate",
+    ["1.2.3.4.5", "1.2.3.45678", "1.2.3", "1.2.3.4.5.6", "12345.1.1.1", "1.2.3.4.5.6.7.8"],
+)
+def test_fr014_a_candidate_flanked_by_a_digit_or_a_dot_is_not_an_address(candidate: str) -> None:
+    """FR-014: an adjacent digit or dot on either side disqualifies the candidate."""
+    assert_unchanged(candidate)
+
+
+def test_fr014_a_non_digit_non_dot_neighbour_does_not_disqualify() -> None:
+    """FR-014: `v` is neither a digit nor a dot, so `v1.2.3.4` yields `v[IP]`."""
+    assert_redaction("v1.2.3.4", "v[IP]", ips=1)
+
+
+# --------------------------------------------------------------------------------------
+# Payment card (FR-015, FR-016, FR-017, FR-018, FR-019, FR-019a)
+# --------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "card",
+    [
+        "4111111111111111",
+        "4111 1111 1111 1111",
+        "4111-1111-1111-1111",
+        "4111-1111 1111-1111",
+    ],
+)
+def test_fr015_each_card_number_is_replaced_by_the_placeholder(card: str) -> None:
+    """FR-015: each payment card number is replaced with the literal text `[CARD]`."""
+    assert_redaction(card, "[CARD]", cards=1)
+
+
+def test_fr016_grouped_and_unseparated_forms_are_both_candidates() -> None:
+    """FR-016: 13-19 digits with optional single space or hyphen separators are candidates."""
+    assert_redaction(
+        "paid 4111 1111 1111 1111 and 4111111111111111",
+        "paid [CARD] and [CARD]",
+        cards=2,
+    )
+
+
+def test_fr016_a_twelve_digit_run_is_too_short_to_be_a_candidate() -> None:
+    """FR-016: fewer than 13 digits is not a candidate, whatever the checksum would say."""
+    assert_unchanged("411111111111")
+
+
+def test_fr016_doubled_separators_break_the_run() -> None:
+    """FR-016: no two separators may be adjacent, so doubled spaces leave 4-digit pieces."""
+    assert_unchanged("4111  1111  1111  1111")
+
+
+def test_fr016_a_candidate_must_begin_and_end_with_a_digit() -> None:
+    """FR-016: a redaction never begins or ends on a separator, so punctuation survives."""
+    assert_redaction("4111 1111 1111 1111, ref", "[CARD], ref", cards=1)
+    assert_redaction("ref: 4111-1111-1111-1111.", "ref: [CARD].", cards=1)
+
+
+def test_fr017_a_candidate_failing_the_checksum_is_left_unchanged() -> None:
+    """FR-017: `1234567890123` is 13 digits but fails Luhn, so it appears unchanged."""
+    assert_unchanged("1234567890123")
+
+
+def test_fr017_checksum_failure_leaves_surrounding_text_alone() -> None:
+    """FR-017: a rejected candidate is copied through verbatim, not partially redacted."""
+    assert_redaction(
+        "paid with 4111 1111 1111 1111, ref 1234567890123",
+        "paid with [CARD], ref 1234567890123",
+        cards=1,
+    )
+
+
+def test_fr018_an_unbroken_run_of_twenty_or_more_digits_is_never_a_card() -> None:
+    """FR-018: length disqualifies the whole run; no part of it is redacted.
+
+    `"0" * 20` is the sharpest case available: every 13-to-19 digit stretch inside it is
+    Luhn-valid, so only the length rule keeps it out of the output.
+    """
+    assert redact._luhn_valid("0" * 16), "every all-zero stretch is Luhn-valid"
+    assert_unchanged("9" * 25)
+    assert_unchanged("0" * 20)
+
+
+def test_fr018_a_long_run_is_untouched_even_when_it_hides_a_valid_card() -> None:
+    """FR-018: the checksum is never consulted to rescue part of an over-length run."""
+    assert redact._luhn_valid(CARD_16_VALID), "fixture must contain a Luhn-valid 16-digit stretch"
+    assert len(LONG_RUN_HIDING_A_VALID_CARD) == 25
+    assert_unchanged(LONG_RUN_HIDING_A_VALID_CARD)
+
+
+def test_fr018_a_valid_card_flanked_by_a_digit_is_not_redacted() -> None:
+    """FR-018: an immediately preceding or following digit disqualifies the candidate.
+
+    The 16-digit number is Luhn-valid, but with a digit glued to either end the only
+    candidate the grammar admits is the 17-digit run — and that run fails the checksum, so
+    nothing is redacted. The premise is asserted rather than assumed.
+    """
+    assert redact._luhn_valid(CARD_16_VALID)
+    assert not redact._luhn_valid("9" + CARD_16_VALID)
+    assert not redact._luhn_valid(CARD_16_VALID + "9")
+    assert_unchanged("9" + CARD_16_VALID)
+    assert_unchanged(CARD_16_VALID + "9")
+
+
+def test_fr019_the_longest_valid_candidate_at_a_start_position_wins() -> None:
+    """FR-019: with a shorter *and* a longer valid candidate at one start, the longer wins."""
+    assert redact._luhn_valid(CARD_13_VALID), "the 13-digit prefix must itself be Luhn-valid"
+    assert redact._luhn_valid(CARD_16_VALID_FROM_13.replace(" ", "")), "the 16 digits must be valid"
+    # A shortest-first implementation would leave the trailing group behind as `[CARD] 007`.
+    assert_redaction(CARD_16_VALID_FROM_13, "[CARD]", cards=1)
+
+
+def test_fr019_the_earliest_starting_candidate_wins_when_spans_would_overlap() -> None:
+    """FR-019: where candidates would overlap, the one starting earliest in the line wins."""
+    assert_redaction(
+        f"a {CARD_16_VALID} b {CARD_16_VALID} c",
+        "a [CARD] b [CARD] c",
+        cards=2,
+    )
+
+
+def test_fr019a_a_rejected_candidate_does_not_suppress_a_later_valid_one() -> None:
+    """FR-019a: `99 4111 1111 1111 1111` must yield `99 [CARD]`."""
+    assert not redact._luhn_valid("994111111111111111"), "the 18-digit candidate must fail"
+    assert not redact._luhn_valid("99411111111111"), "the 14-digit candidate must fail"
+    assert_redaction("99 4111 1111 1111 1111", "99 [CARD]", cards=1)
+
+
+def test_fr019a_scanning_resumes_one_character_after_a_rejected_start() -> None:
+    """FR-019a: a failing candidate is copied through and the scan continues past it."""
+    assert_redaction(
+        f"1234567890123 then {CARD_16_VALID}",
+        "1234567890123 then [CARD]",
+        cards=1,
+    )
+
+
+def test_fr019a_a_non_separator_inside_the_run_breaks_the_candidate() -> None:
+    """FR-019a: `4111 1111 1111 11x1` has no valid candidate at any eligible start."""
+    assert_unchanged("4111 1111 1111 11x1")
+
+
+# --------------------------------------------------------------------------------------
+# Pass-through (FR-005, FR-006)
+# --------------------------------------------------------------------------------------
+
+
+def test_fr005_text_around_a_match_is_unchanged_and_in_position() -> None:
+    """FR-005: every character not part of a match appears unchanged, in position."""
+    assert_redaction(
+        "2026-11-20 WARN user=jane@example.com ip=10.0.0.7 card=4111111111111111 done\n",
+        "2026-11-20 WARN user=[EMAIL] ip=[IP] card=[CARD] done\n",
+        emails=1,
+        ips=1,
+        cards=1,
+    )
+
+
+def test_fr005_a_date_is_not_mistaken_for_personal_data() -> None:
+    """FR-005: ordinary log furniture around a match is not consumed by it."""
+    assert_unchanged("2026-11-20T06:34:01 INFO started pid=4211 build=1.2.3\n")
+
+
+def test_fr006_a_line_with_nothing_to_redact_is_reproduced_exactly() -> None:
+    """FR-006: including leading and trailing whitespace."""
+    for line in [
+        "   indented and trailing   \n",
+        "\tTAB\tseparated\t\n",
+        "",
+        "\n",
+        "   \n",
+        " \t \t \n",
+        "no trailing newline",
+        "unicode: café über 中文\n",
+    ]:
+        assert_unchanged(line)
+
+
+def test_fr006_a_blank_line_yields_an_empty_tally() -> None:
+    """FR-006: nothing to redact means nothing counted."""
+    out, counts = redact.redact_line("\n")
+    assert out == "\n"
+    assert counts == collections.Counter()
+
+
+# --------------------------------------------------------------------------------------
+# Overlap, precedence, and placeholder handling (FR-020, FR-021, FR-022, FR-026)
+# --------------------------------------------------------------------------------------
+
+
+def test_fr020_each_character_belongs_to_at_most_one_redaction() -> None:
+    """FR-020: redactions do not nest or overlap — spans tile the line in order."""
+    line = f"a jane@example.com b 10.0.0.7 c {CARD_16_VALID} d"
+    out, counts = redact.redact_line(line)
+    assert out == "a [EMAIL] b [IP] c [CARD] d"
+    # Exactly one placeholder per match, and the surviving text is the untouched remainder.
+    assert out.count("[EMAIL]") == 1 and out.count("[IP]") == 1 and out.count("[CARD]") == 1
+    assert sum(counts.values()) == 3
+
+
+def test_fr020_adjacent_matches_do_not_merge_or_swallow_their_neighbour() -> None:
+    """FR-020: two matches separated by a single character stay two matches."""
+    assert_redaction("1.2.3.4 5.6.7.8", "[IP] [IP]", ips=2)
+
+
+def test_fr021_an_address_literal_domain_yields_exactly_one_email() -> None:
+    """FR-021: `admin@1.2.3.4` must produce exactly one `[EMAIL]`, not `admin@[IP]`.
+
+    Both the email and the IPv4 alternative can claim characters here. The email
+    alternative is written first, so at the earliest start position it wins. See research
+    item R-000 for why the email grammar admits an IPv4-literal domain at all.
+    """
+    assert_redaction("admin@1.2.3.4", "[EMAIL]", emails=1)
+    assert_redaction("login admin@1.2.3.4 failed", "login [EMAIL] failed", emails=1)
+
+
+def test_fr021_email_wins_over_card_at_the_same_start_position() -> None:
+    """FR-021: at one start position precedence is email, then IPv4, then card."""
+    assert_redaction("1234567890123@example.com", "[EMAIL]", emails=1)
+
+
+def test_fr021_the_earliest_starting_match_wins() -> None:
+    """FR-021: the earliest-starting match wins regardless of category."""
+    assert_redaction(
+        f"{CARD_16_VALID} jane@example.com 10.0.0.7",
+        "[CARD] [EMAIL] [IP]",
+        emails=1,
+        ips=1,
+        cards=1,
+    )
+
+
+@pytest.mark.parametrize("placeholder", ["[EMAIL]", "[IP]", "[CARD]"])
+def test_fr022_placeholder_text_already_in_the_input_passes_through_uncounted(placeholder: str) -> None:
+    """FR-022: pre-existing placeholder text is passed through unchanged and uncounted."""
+    assert_unchanged(placeholder)
+    assert_unchanged(f"already redacted: {placeholder} here\n")
+
+
+def test_fr022_substituted_placeholder_text_is_not_re_examined() -> None:
+    """FR-022: redacting an already-redacted line is a no-op, so nothing was rescanned."""
+    line = f"a jane@example.com b 10.0.0.7 c {CARD_16_VALID} d [EMAIL] [IP] [CARD]\n"
+    once, first_counts = redact.redact_line(line)
+    twice, second_counts = redact.redact_line(once)
+    assert once == "a [EMAIL] b [IP] c [CARD] d [EMAIL] [IP] [CARD]\n"
+    assert twice == once
+    assert second_counts == collections.Counter()
+    assert (first_counts["emails"], first_counts["ips"], first_counts["cards"]) == (1, 1, 1)
+
+
+def test_fr026_the_per_line_tally_counts_replacements_not_distinct_values() -> None:
+    """FR-026: three addresses on one line contribute 3; an absent category reads as 0."""
+    out, counts = redact.redact_line("a@b.io c@d.io e@f.io 1.2.3.4\n")
+    assert out == "[EMAIL] [EMAIL] [EMAIL] [IP]\n"
+    assert counts["emails"] == 3
+    assert counts["ips"] == 1
+    assert counts["cards"] == 0
+    assert_redaction("a@b.io a@b.io\n", "[EMAIL] [EMAIL]\n", emails=2)
