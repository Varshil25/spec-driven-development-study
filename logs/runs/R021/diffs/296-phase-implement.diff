@@ -0,0 +1,87 @@
+"""SC-004 gate: every requirement identifier is cited by at least one test.
+
+Constitution Principle III requires the requirement-to-test mapping to be *explicit* — the
+test name or a comment on the test cites the requirement identifier — and SC-004 makes that
+mapping a measurable criterion. Checking it here rather than by eye is what keeps it honest
+as the suite changes: deleting the last test that cites a requirement fails this gate.
+
+The human-readable form of the same mapping is the table in
+specs/001-logredact-cli/quickstart.md.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+TESTS_DIR = Path(__file__).resolve().parent
+
+#: FR-001 through FR-031 plus the lettered additions, and SC-001 through SC-009.
+#:
+#: SC-004 enumerates exactly this set: "FR-001 through FR-031, including the lettered
+#: additions FR-005a, FR-007a, FR-019a, FR-030a, and FR-031a". That is 31 + 5 = **36**
+#: identifiers; the figure "32" that appears in plan.md, quickstart.md, and tasks.md is a
+#: miscount of the same enumeration, not a smaller set. The enumeration wins here, because
+#: it is the thing that names which requirements must be covered.
+FUNCTIONAL_REQUIREMENTS = [f"FR-{number:03d}" for number in range(1, 32)] + [
+    "FR-005a",
+    "FR-007a",
+    "FR-019a",
+    "FR-030a",
+    "FR-031a",
+]
+SUCCESS_CRITERIA = [f"SC-{number:03d}" for number in range(1, 10)]
+
+
+def test_the_identifier_lists_match_what_sc004_enumerates() -> None:
+    """SC-004's enumeration is FR-001 - FR-031 plus five lettered additions: 36 in all."""
+    assert len(FUNCTIONAL_REQUIREMENTS) == 36
+    assert len(set(FUNCTIONAL_REQUIREMENTS)) == 36
+    assert len(SUCCESS_CRITERIA) == 9
+
+
+def source_modules() -> dict[str, str]:
+    """The test modules to search. This module is excluded so the gate cannot satisfy itself."""
+    return {
+        path.name: path.read_text(encoding="utf-8")
+        for path in sorted(TESTS_DIR.glob("test_*.py"))
+        if path.name != Path(__file__).name
+    }
+
+
+def citing_modules(identifier: str) -> list[str]:
+    """Modules citing `identifier` in a test's name or in its text (docstring or comment).
+
+    The boundary in both patterns is what stops `FR-031a` from passing for `FR-031`.
+    """
+    in_text = re.compile(rf"{re.escape(identifier)}(?![0-9A-Za-z])")
+    in_name = re.compile(
+        rf"def test_{identifier.lower().replace('-', '')}(?![0-9a-z])"
+    )
+    return [
+        name
+        for name, text in source_modules().items()
+        if in_text.search(text) or in_name.search(text)
+    ]
+
+
+def test_sc004_every_functional_requirement_is_cited_by_a_test() -> None:
+    """SC-004: FR-001 - FR-031 and the lettered additions each have a citing test."""
+    uncited = [
+        identifier
+        for identifier in FUNCTIONAL_REQUIREMENTS
+        if not citing_modules(identifier)
+    ]
+    assert not uncited, f"functional requirements with no citing test: {uncited}"
+
+
+def test_sc004_every_success_criterion_is_cited_by_a_test() -> None:
+    """SC-004: the measurable outcomes are themselves covered."""
+    uncited = [identifier for identifier in SUCCESS_CRITERIA if not citing_modules(identifier)]
+    assert not uncited, f"success criteria with no citing test: {uncited}"
+
+
+def test_the_gate_rejects_an_identifier_nobody_cites() -> None:
+    """A gate that cannot fail is not a gate: an invented identifier must come back uncited."""
+    assert citing_modules("FR-999") == []
+    assert citing_modules("FR-001"), "the gate must still find a real citation"
