+++ b/tests/test_cli.py
@@ -0,0 +1,519 @@
+"""Contract tests for the command-line interface (FR-001 - FR-031a, SC-001, SC-005, SC-009).
+
+Every assertion here compares raw `bytes` and the process exit status, because that is what
+the contract in contracts/cli.md actually promises. See tests/conftest.py for why these run
+the real CLI as a subprocess rather than calling `cli.main()` in-process.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+
+import pytest
+
+from conftest import cli_env, run_cli
+
+CARD_VALID = "4111111111111111"
+
+
+def assert_no_traceback(stderr: bytes) -> None:
+    """SC-005: no failure path may emit a stack trace or other unhandled-error text."""
+    assert b"Traceback" not in stderr, stderr
+    assert b"Exception ignored" not in stderr, stderr
+
+
+# --------------------------------------------------------------------------------------
+# Standard input (FR-002) and the worked examples (SC-001)
+# --------------------------------------------------------------------------------------
+
+
+def test_fr002_input_is_read_from_standard_input_when_no_operand_is_given() -> None:
+    """FR-002: with no FILE operand, input comes from standard input."""
+    stdout, stderr, status = run_cli(stdin=b"user jane@example.com\n")
+    assert stdout == b"user [EMAIL]\n"
+    assert stderr == b""
+    assert status == 0
+
+
+def test_fr002_empty_standard_input_yields_empty_standard_output() -> None:
+    """FR-002: nothing in, nothing out, and still a successful run."""
+    stdout, stderr, status = run_cli(stdin=b"")
+    assert stdout == b""
+    assert stderr == b""
+    assert status == 0
+
+
+def test_sc001_first_worked_example_reproduces_byte_exactly() -> None:
+    """SC-001: `user jane@example.com from 10.0.0.7` -> `user [EMAIL] from [IP]`."""
+    stdout, stderr, status = run_cli(stdin=b"user jane@example.com from 10.0.0.7\n")
+    assert stdout == b"user [EMAIL] from [IP]\n"
+    assert stderr == b""
+    assert status == 0
+
+
+def test_sc001_second_worked_example_reproduces_byte_exactly() -> None:
+    """SC-001: the grouped card is redacted and the Luhn-failing 13-digit number is not."""
+    stdout, stderr, status = run_cli(
+        stdin=b"paid with 4111 1111 1111 1111, ref 1234567890123\n"
+    )
+    assert stdout == b"paid with [CARD], ref 1234567890123\n"
+    assert stderr == b""
+    assert status == 0
+
+
+def test_sc001_third_worked_example_reproduces_byte_exactly() -> None:
+    """SC-001: `a@b.io 1.2.3.4` with `--count` -> `[EMAIL] [IP]` plus the tally."""
+    stdout, stderr, status = run_cli("--count", stdin=b"a@b.io 1.2.3.4\n")
+    assert stdout == b"[EMAIL] [IP]\n"
+    assert stderr == b"emails=1 ips=1 cards=0\n"
+    assert status == 0
+
+
+# --------------------------------------------------------------------------------------
+# Line terminators and byte fidelity (FR-007, FR-007a, FR-005a)
+# --------------------------------------------------------------------------------------
+
+
+def test_fr007_crlf_line_endings_survive_unchanged() -> None:
+    """FR-007: a line read as CRLF is written back as CRLF, not normalized to LF."""
+    stdout, _, status = run_cli(stdin=b"a@b.io\r\nnext\r\n")
+    assert stdout == b"[EMAIL]\r\nnext\r\n"
+    assert status == 0
+
+
+def test_fr007_a_bare_carriage_return_is_ordinary_text_not_a_line_boundary() -> None:
+    """FR-007: a bare CR passes through and does not split the line."""
+    stdout, _, status = run_cli(stdin=b"before\rafter a@b.io\n")
+    assert stdout == b"before\rafter [EMAIL]\n"
+    assert status == 0
+
+
+def test_fr007_mixed_line_endings_each_keep_their_own_form() -> None:
+    """FR-007: endings are not normalized to a single form."""
+    payload = b"lf a@b.io\ncrlf c@d.io\r\nbare\rcr e@f.io\nlast\n"
+    stdout, _, status = run_cli(stdin=payload)
+    assert stdout == b"lf [EMAIL]\ncrlf [EMAIL]\r\nbare\rcr [EMAIL]\nlast\n"
+    assert status == 0
+
+
+def test_fr007a_a_missing_final_newline_stays_missing() -> None:
+    """FR-007a: no trailing newline is added that was absent."""
+    stdout, _, status = run_cli(stdin=b"first\nlast a@b.io")
+    assert stdout == b"first\nlast [EMAIL]"
+    assert status == 0
+
+
+def test_fr007a_a_present_final_newline_stays_present() -> None:
+    """FR-007a: a trailing newline that was present is not removed."""
+    stdout, _, status = run_cli(stdin=b"first\nlast a@b.io\n")
+    assert stdout == b"first\nlast [EMAIL]\n"
+    assert status == 0
+
+
+def test_fr005a_bytes_that_are_not_valid_utf8_pass_through_byte_for_byte() -> None:
+    """FR-005a: an undecodable byte survives, is not replaced, and does not fail the run."""
+    stdout, stderr, status = run_cli(stdin=b"mail \xff jane@example.com\n")
+    assert stdout == b"mail \xff [EMAIL]\n"
+    assert b"\xef\xbf\xbd" not in stdout, "U+FFFD replacement character must not appear"
+    assert stderr == b""
+    assert status == 0
+
+
+def test_fr005a_an_undecodable_byte_matches_no_category_and_counts_nothing() -> None:
+    """FR-005a: such bytes never match a category and never reach the tally."""
+    stdout, stderr, status = run_cli("--count", stdin=b"\xff\xfe\x80 plain\n")
+    assert stdout == b"\xff\xfe\x80 plain\n"
+    assert stderr == b"emails=0 ips=0 cards=0\n"
+    assert status == 0
+
+
+def test_fr005a_a_digit_run_interrupted_by_an_undecodable_byte_is_not_one_candidate() -> None:
+    """FR-005a: an undecodable byte breaks contiguity, so the run is not a card candidate."""
+    stdin = b"4111 1111 \xff1111 1111\n"
+    stdout, _, status = run_cli(stdin=stdin)
+    assert stdout == stdin
+    assert status == 0
+
+
+def test_fr027_a_fully_read_and_fully_written_run_exits_zero() -> None:
+    """FR-027: every source read to completion and all output written means status 0."""
+    stdout, stderr, status = run_cli(stdin=b"a@b.io\n" * 50)
+    assert stdout == b"[EMAIL]\n" * 50
+    assert stderr == b""
+    assert status == 0
+
+
+# --------------------------------------------------------------------------------------
+# FILE operands (FR-001, FR-003, FR-004)
+# --------------------------------------------------------------------------------------
+
+
+def write(path, data: bytes):
+    path.write_bytes(data)
+    return str(path)
+
+
+def test_fr003_named_files_are_read_in_order_and_standard_input_is_not_read(tmp_path) -> None:
+    """FR-003: with operands present, stdin is left alone entirely."""
+    first = write(tmp_path / "a.log", b"first 1.1.1.1\n")
+    second = write(tmp_path / "b.log", b"second a@b.io\n")
+    stdout, stderr, status = run_cli(first, second, stdin=b"STDIN SHOULD NOT APPEAR\n")
+    assert stdout == b"first [IP]\nsecond [EMAIL]\n"
+    assert b"STDIN" not in stdout
+    assert stderr == b""
+    assert status == 0
+
+
+def test_fr004_output_is_one_concatenated_stream_in_operand_order(tmp_path) -> None:
+    """FR-004: source order follows the command line; reversing the operands reverses it."""
+    first = write(tmp_path / "a.log", b"first 1.1.1.1\n")
+    second = write(tmp_path / "b.log", b"second a@b.io\n")
+    forward, _, status_forward = run_cli(first, second)
+    reverse, _, status_reverse = run_cli(second, first)
+    assert forward == b"first [IP]\nsecond [EMAIL]\n"
+    assert reverse == b"second [EMAIL]\nfirst [IP]\n"
+    assert status_forward == status_reverse == 0
+
+
+def test_fr004_a_single_file_reproduces_every_line_in_order(tmp_path) -> None:
+    """FR-004: line order within a source is preserved."""
+    body = b"".join(b"line %d a@b.io\n" % n for n in range(20))
+    path = write(tmp_path / "many.log", body)
+    stdout, _, status = run_cli(path)
+    assert stdout == b"".join(b"line %d [EMAIL]\n" % n for n in range(20))
+    assert status == 0
+
+
+def test_fr004_an_empty_file_as_the_only_operand_yields_empty_output(tmp_path) -> None:
+    """FR-004: an empty source contributes nothing and is still a success."""
+    path = write(tmp_path / "empty.log", b"")
+    stdout, stderr, status = run_cli(path)
+    assert stdout == b""
+    assert stderr == b""
+    assert status == 0
+
+
+@pytest.mark.parametrize("order", [("--count", "a", "b"), ("a", "--count", "b"), ("a", "b", "--count")])
+def test_fr001_the_count_flag_is_accepted_at_any_position(tmp_path, order) -> None:
+    """FR-001: operands and options interleave freely; `--count` is never a file name."""
+    paths = {
+        "a": write(tmp_path / "a.log", b"first 1.1.1.1\n"),
+        "b": write(tmp_path / "b.log", b"second a@b.io\n"),
+    }
+    argv = [paths.get(token, token) for token in order]
+    stdout, stderr, status = run_cli(*argv)
+    assert stdout == b"first [IP]\nsecond [EMAIL]\n"
+    assert stderr == b"emails=1 ips=1 cards=0\n"
+    assert status == 0
+
+
+def test_fr001_a_file_operand_named_dash_is_a_literal_path_not_standard_input(tmp_path) -> None:
+    """FR-001: `-` is an ordinary relative path (spec Assumptions, contracts/cli.md)."""
+    (tmp_path / "-").write_bytes(b"from the dash file a@b.io\n")
+    stdout, stderr, status = run_cli("-", stdin=b"STDIN SHOULD NOT APPEAR\n", cwd=tmp_path)
+    assert stdout == b"from the dash file [EMAIL]\n"
+    assert b"STDIN" not in stdout
+    assert stderr == b""
+    assert status == 0
+
+
+# --------------------------------------------------------------------------------------
+# The tally (FR-023, FR-024, FR-025, FR-026)
+# --------------------------------------------------------------------------------------
+
+
+def test_fr023_the_tally_is_a_single_line_of_the_exact_specified_form() -> None:
+    """FR-023: exactly `emails=N ips=N cards=N` plus a newline, in that fixed key order."""
+    stdout, stderr, status = run_cli(
+        "--count", stdin=f"a@b.io 1.2.3.4 {CARD_VALID}\n".encode()
+    )
+    assert stdout == b"[EMAIL] [IP] [CARD]\n"
+    assert stderr == b"emails=1 ips=1 cards=1\n"
+    assert stderr.count(b"\n") == 1
+    assert status == 0
+
+
+def test_fr023_the_tally_totals_span_lines_and_files(tmp_path) -> None:
+    """FR-023: N is the total across all input read, not per line and not per file."""
+    first = write(tmp_path / "a.log", b"a@b.io\nc@d.io 1.1.1.1\n")
+    second = write(tmp_path / "b.log", f"e@f.io {CARD_VALID}\n2.2.2.2\n".encode())
+    stdout, stderr, status = run_cli("--count", first, second)
+    assert stdout == b"[EMAIL]\n[EMAIL] [IP]\n[EMAIL] [CARD]\n[IP]\n"
+    assert stderr == b"emails=3 ips=2 cards=1\n"
+    assert status == 0
+
+
+def test_fr024_the_tally_is_written_only_after_all_output(tmp_path) -> None:
+    """FR-024: a consumer redirecting the streams separately sees a complete log first."""
+    body = b"".join(b"line %d a@b.io\n" % n for n in range(5000))
+    path = write(tmp_path / "big.log", body)
+    out_file = tmp_path / "clean.log"
+    err_file = tmp_path / "tally.txt"
+    with open(out_file, "wb") as out, open(err_file, "wb") as err:
+        status = subprocess.run(
+            [sys.executable, "-m", "logredact", "--count", path],
+            stdin=subprocess.DEVNULL,
+            stdout=out,
+            stderr=err,
+            env=cli_env(),
+            check=False,
+        ).returncode
+    assert status == 0
+    assert out_file.read_bytes() == b"".join(b"line %d [EMAIL]\n" % n for n in range(5000))
+    assert err_file.read_bytes() == b"emails=5000 ips=0 cards=0\n"
+
+
+def test_fr025_without_the_flag_a_successful_run_writes_nothing_to_standard_error() -> None:
+    """FR-025: zero bytes on stderr, not merely no tally."""
+    stdout, stderr, status = run_cli(stdin=b"a@b.io 1.2.3.4\n")
+    assert stdout == b"[EMAIL] [IP]\n"
+    assert stderr == b""
+    assert len(stderr) == 0
+    assert status == 0
+
+
+def test_fr026_the_tally_counts_replacements_not_distinct_values() -> None:
+    """FR-026: three addresses on one line contribute 3."""
+    stdout, stderr, status = run_cli("--count", stdin=b"a@b.io c@d.io e@f.io 1.2.3.4\n")
+    assert stdout == b"[EMAIL] [EMAIL] [EMAIL] [IP]\n"
+    assert stderr == b"emails=3 ips=1 cards=0\n"
+    assert status == 0
+
+
+def test_fr026_a_category_with_no_replacements_reports_zero() -> None:
+    """FR-026: an absent category is reported as `0`, not omitted."""
+    stdout, stderr, status = run_cli("--count", stdin=b"nothing here\n")
+    assert stdout == b"nothing here\n"
+    assert stderr == b"emails=0 ips=0 cards=0\n"
+    assert status == 0
+
+
+# --------------------------------------------------------------------------------------
+# Unreadable sources (FR-028, FR-029) and stream discipline (FR-031)
+# --------------------------------------------------------------------------------------
+
+
+def test_fr028_a_nonexistent_file_is_named_on_standard_error_and_exits_two(tmp_path) -> None:
+    """FR-028: the diagnostic includes the path as given on the command line; status 2."""
+    missing = str(tmp_path / "does-not-exist.log")
+    stdout, stderr, status = run_cli(missing)
+    assert status == 2
+    assert missing.encode() in stderr
+    assert stdout == b""
+    assert_no_traceback(stderr)
+
+
+def test_fr028_the_diagnostic_uses_the_spelling_from_the_command_line(tmp_path) -> None:
+    """FR-028: a relative operand is reported as spelled, not resolved or made absolute."""
+    stdout, stderr, status = run_cli("nope.log", cwd=tmp_path)
+    assert status == 2
+    assert b"nope.log" in stderr
+    assert str(tmp_path).encode() not in stderr, "the path must not be resolved"
+    assert stdout == b""
+    assert_no_traceback(stderr)
+
+
+@pytest.mark.skipif(
+    hasattr(os, "geteuid") and os.geteuid() == 0,
+    reason="root can read a mode-000 file, so permission denial cannot be provoked",
+)
+def test_fr028_a_file_whose_permissions_deny_reading_is_named_and_exits_two(tmp_path) -> None:
+    """FR-028: "unreadable" covers a permission failure, not only a missing path."""
+    denied = tmp_path / "denied.log"
+    denied.write_bytes(b"secret a@b.io\n")
+    denied.chmod(0o000)
+    stdout, stderr, status = run_cli(str(denied))
+    assert status == 2
+    assert str(denied).encode() in stderr
+    assert b"a@b.io" not in stdout
+    assert_no_traceback(stderr)
+
+
+def test_fr029_earlier_output_remains_written_and_later_sources_are_not_opened(tmp_path) -> None:
+    """FR-029: stop at the first unreadable source; what was written stays written."""
+    readable = write(tmp_path / "a.log", b"first 1.1.1.1\n")
+    missing = str(tmp_path / "missing.log")
+    never_opened = write(tmp_path / "z.log", b"never a@b.io\n")
+    stdout, stderr, status = run_cli(readable, missing, never_opened)
+    assert status == 2
+    assert stdout == b"first [IP]\n"
+    assert b"never" not in stdout, "sources after the failure must not be read"
+    assert missing.encode() in stderr
+    assert_no_traceback(stderr)
+
+
+def test_fr029_no_tally_is_written_when_a_source_is_unreadable(tmp_path) -> None:
+    """FR-029: with `--count`, the error message is the only thing on stderr."""
+    readable = write(tmp_path / "a.log", b"first a@b.io\n")
+    missing = str(tmp_path / "missing.log")
+    stdout, stderr, status = run_cli("--count", readable, missing)
+    assert status == 2
+    assert stdout == b"first [EMAIL]\n"
+    assert b"emails=" not in stderr
+    assert stderr.count(b"\n") == 1, stderr
+    assert missing.encode() in stderr
+    assert_no_traceback(stderr)
+
+
+def test_fr031_no_diagnostic_reaches_stdout_and_no_log_content_reaches_stderr(tmp_path) -> None:
+    """FR-031: the two streams never cross."""
+    readable = write(tmp_path / "a.log", b"secret jane@example.com and 10.0.0.7\n")
+    missing = str(tmp_path / "missing.log")
+    stdout, stderr, status = run_cli("--count", readable, missing)
+    assert status == 2
+    assert b"error" not in stdout and b"missing.log" not in stdout
+    assert b"secret" not in stderr
+    assert b"[EMAIL]" not in stderr and b"[IP]" not in stderr
+    assert_no_traceback(stderr)
+
+
+def test_fr031_the_exit_status_is_only_ever_zero_or_two(tmp_path) -> None:
+    """FR-031 / contracts/cli.md: status 1 is never produced on any path.
+
+    Status 1 is what an unhandled exception would produce, so this is the standing check
+    that no failure path escapes its handler.
+    """
+    readable = write(tmp_path / "a.log", b"a@b.io\n")
+    missing = str(tmp_path / "missing.log")
+    invocations = [
+        ([], b"a@b.io\n"),
+        (["--count"], b"a@b.io\n"),
+        ([readable], b""),
+        (["--count", readable], b""),
+        ([readable, missing], b""),
+        ([missing], b""),
+        (["--nope"], b""),
+        (["--help"], b""),
+        (["-h", "--count", missing], b""),
+        ([str(tmp_path)], b""),  # a directory is an unreadable source, not a crash
+    ]
+    for argv, stdin in invocations:
+        _, stderr, status = run_cli(*argv, stdin=stdin)
+        assert status in (0, 2), f"{argv} exited {status}"
+        assert_no_traceback(stderr)
+
+
+def test_sc005_every_failure_path_reports_a_diagnostic_without_a_traceback(tmp_path) -> None:
+    """SC-005: missing file, unreadable usage, and help are each clean on stderr."""
+    missing = str(tmp_path / "missing.log")
+    for argv in ([missing], ["--nope"]):
+        _, stderr, status = run_cli(*argv)
+        assert status == 2, argv
+        assert stderr.strip(), f"{argv} produced no diagnostic"
+        assert_no_traceback(stderr)
+
+
+# --------------------------------------------------------------------------------------
+# Usage and help (FR-030, FR-030a)
+# --------------------------------------------------------------------------------------
+
+
+def test_fr030_an_unrecognized_option_is_a_usage_error() -> None:
+    """FR-030: diagnostic on stderr, nothing on stdout, exit status 2."""
+    stdout, stderr, status = run_cli("--nope")
+    assert status == 2
+    assert stdout == b""
+    assert b"usage:" in stderr
+    assert b"--nope" in stderr
+    assert_no_traceback(stderr)
+
+
+@pytest.mark.parametrize("flag", ["--help", "-h"])
+def test_fr030a_help_writes_usage_to_stdout_and_exits_zero(flag: str) -> None:
+    """FR-030a: usage and option descriptions on stdout, zero bytes on stderr, status 0."""
+    stdout, stderr, status = run_cli(flag)
+    assert status == 0
+    assert stderr == b""
+    assert b"usage: python -m logredact" in stdout
+    assert b"--count" in stdout and b"FILE" in stdout
+
+
+def test_fr030a_help_wins_over_count_and_over_an_unreadable_operand(tmp_path) -> None:
+    """FR-030a: no tally, no source opened, status 0 — a help request is a success."""
+    missing = str(tmp_path / "does-not-exist.log")
+    stdout, stderr, status = run_cli("--help", "--count", missing)
+    assert status == 0
+    assert stderr == b""
+    assert b"usage: python -m logredact" in stdout
+    assert b"emails=" not in stdout
+    assert missing.encode() not in stdout
+
+
+def test_fr030a_help_reads_no_input_source() -> None:
+    """FR-030a: standard input is not consumed on a help run (FR-002's exception).
+
+    The help text mentions the placeholders itself, so the check is that stdout is the
+    help text and nothing else: identical whether or not input was offered.
+    """
+    with_input, stderr, status = run_cli("--help", stdin=b"a@b.io\n")
+    without_input, _, _ = run_cli("--help", stdin=b"")
+    assert status == 0
+    assert stderr == b""
+    assert with_input == without_input, "the help run consumed its input"
+    assert b"a@b.io" not in with_input
+
+
+# --------------------------------------------------------------------------------------
+# A failed write to standard output (FR-031a, SC-009)
+# --------------------------------------------------------------------------------------
+
+#: Large enough that stdout's block buffer forces real writes while the reader is closing
+#: (quickstart V8 uses the same figure).
+EARLY_CLOSE_LINES = 200_000
+
+
+def _run_into_a_closing_reader(*args: str, tmp_path) -> tuple[bytes, bytes, int]:
+    """Run the tool with its stdout piped into `head -1`, and return the tool's own status."""
+    body = b"".join(b"%d a@b.io\n" % n for n in range(1, EARLY_CLOSE_LINES + 1))
+    source = tmp_path / "big.log"
+    source.write_bytes(body)
+
+    reader = subprocess.Popen(
+        ["head", "-1"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
+    )
+    assert reader.stdin is not None and reader.stdout is not None
+    tool = subprocess.Popen(
+        [sys.executable, "-m", "logredact", *args, str(source)],
+        stdin=subprocess.DEVNULL,
+        stdout=reader.stdin,
+        stderr=subprocess.PIPE,
+        env=cli_env(),
+    )
+    reader.stdin.close()  # only the reader holds the write end now
+    tool_stderr = tool.stderr.read() if tool.stderr else b""
+    tool.wait()
+    reader_stdout = reader.stdout.read()
+    reader.wait()
+    return reader_stdout, tool_stderr, tool.returncode
+
+
+def test_fr031a_a_reader_that_closes_early_makes_the_run_fail(tmp_path) -> None:
+    """FR-031a: one concise diagnostic, no tally, no traceback, exit status 2 — never 0."""
+    reader_stdout, stderr, status = _run_into_a_closing_reader(tmp_path=tmp_path)
+    assert reader_stdout == b"1 [EMAIL]\n"
+    assert status == 2, f"a truncated run must never exit 0 (got {status})"
+    assert stderr.count(b"\n") == 1, stderr
+    assert b"logredact: error:" in stderr
+    assert b"output" in stderr or b"standard output" in stderr
+    assert_no_traceback(stderr)
+
+
+def test_fr031a_a_failed_write_suppresses_the_tally(tmp_path) -> None:
+    """FR-031a: no tally line even though `--count` was passed."""
+    _, stderr, status = _run_into_a_closing_reader("--count", tmp_path=tmp_path)
+    assert status == 2
+    assert b"emails=" not in stderr, stderr
+    assert_no_traceback(stderr)
+
+
+def test_sc009_success_and_truncation_are_distinguishable_by_exit_status_alone(tmp_path) -> None:
+    """SC-009: the reviewer needs no access to the log to tell a complete run from a partial one."""
+    body = b"".join(b"%d a@b.io\n" % n for n in range(1, 101))
+    complete_source = write(tmp_path / "small.log", body)
+    _, _, complete_status = run_cli(complete_source)
+    _, _, truncated_status = _run_into_a_closing_reader(tmp_path=tmp_path)
+    assert complete_status == 0
+    assert truncated_status == 2
+    assert complete_status != truncated_status
