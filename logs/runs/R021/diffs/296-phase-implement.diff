+++ b/src/logredact/redact.py
@@ -0,0 +1,163 @@
+"""Pure text layer: the recognition grammar and the per-line redaction function.
+
+This module knows nothing about streams, files, or exit statuses. `redact_line` takes one
+line of text and returns the redacted text plus a per-line tally, which is what makes every
+recognition rule testable as a string in / string out assertion.
+
+The grammar is specified in contracts/redaction-patterns.md; the fragments below are copied
+from it verbatim so the two cannot drift. Every character class is ASCII, which is what
+guarantees that a lone surrogate standing in for an undecodable byte can never match
+(FR-005a).
+"""
+
+from __future__ import annotations
+
+import collections
+import re
+
+# --------------------------------------------------------------------------------------
+# Shared pattern fragments (contracts/redaction-patterns.md)
+# --------------------------------------------------------------------------------------
+
+#: Email local part: letters, digits, and `. _ % + -` (FR-009).
+_LOCAL = r"[A-Za-z0-9._%+-]+"
+
+#: Domain as two or more dot-separated labels whose final label is 2+ letters (FR-009).
+_HOST = r"(?:[A-Za-z0-9-]+\.)+[A-Za-z]{2,}"
+
+#: One IPv4 octet: any value 0-255, leading-zero forms included. The alternation is what
+#: accepts `010` and `00` (spec Assumptions) while rejecting 256 and above (FR-013).
+_OCTET = r"(?:25[0-5]|2[0-4][0-9]|[01][0-9][0-9]|[0-9][0-9]|[0-9])"
+
+#: Four dot-separated octets.
+_QUAD = rf"{_OCTET}(?:\.{_OCTET}){{3}}"
+
+#: A card group separator: exactly one space or one hyphen (FR-016).
+_SEP = r"[ \-]"
+
+# --------------------------------------------------------------------------------------
+# Category data (data-model.md section 2)
+# --------------------------------------------------------------------------------------
+
+#: Group name -> replacement text. Placeholders are data, not patterns: they are appended
+#: to the output fragment list and never become part of the subject string, which is what
+#: makes FR-022 hold by construction rather than by a guard.
+PLACEHOLDERS = {"email": "[EMAIL]", "ip": "[IP]", "card": "[CARD]"}
+
+#: Group name -> tally key. The rendered key order is fixed by the caller, not by this dict.
+TALLY_KEYS = {"email": "emails", "ip": "ips", "card": "cards"}
+
+# --------------------------------------------------------------------------------------
+# Luhn checksum (FR-017)
+# --------------------------------------------------------------------------------------
+
+#: Everything a card candidate may contain that is not a digit, i.e. its separators.
+_NON_DIGIT = re.compile(r"[^0-9]")
+
+
+def _luhn_valid(digits: str) -> bool:
+    """True when `digits` passes the Luhn checksum (FR-017).
+
+    Walking right to left, every second digit is doubled and 9 subtracted from any product
+    over 9; the candidate is valid when the total is a multiple of 10. One loop over the
+    digit string, no lookup table (research R-004).
+    """
+    total = 0
+    for position, character in enumerate(reversed(digits)):
+        value = int(character)
+        if position % 2 == 1:
+            value *= 2
+            if value > 9:
+                value -= 9
+        total += value
+    return total % 10 == 0
+
+
+# --------------------------------------------------------------------------------------
+# The one compiled alternation (FR-020, FR-021)
+# --------------------------------------------------------------------------------------
+
+#: An email address. The `_QUAD` alternative admits an IPv4-literal domain, which is
+#: research item R-000's resolution of the FR-009 / FR-021 conflict over `admin@1.2.3.4`:
+#: without it the local part would be left exposed next to an `[IP]`. Reversing that
+#: decision means deleting `|{_QUAD}(?![0-9.])` and amending FR-021.
+_EMAIL = rf"{_LOCAL}@(?:{_HOST}|{_QUAD}(?![0-9.]))"
+
+#: An IPv4 address. The lookarounds are FR-014: an adjacent digit or dot disqualifies it.
+_IPV4 = rf"(?<![0-9.]){_QUAD}(?![0-9.])"
+
+#: A card *candidate*: 13-19 digits, single separators, a digit at each end, not flanked by
+#: a digit (FR-016, FR-018). Whether it is redacted is decided afterwards by Luhn.
+_CARD = rf"(?<![0-9])[0-9](?:{_SEP}?[0-9]){{12,18}}(?![0-9])"
+
+#: The single pattern the scanner uses. **The order of the alternatives is the precedence
+#: rule** (FR-021): `re.search` finds the leftmost position at which any alternative
+#: matches and tries the alternatives there in written order, so this must not be
+#: reordered. Every inner group is non-capturing, which is what makes `match.lastgroup`
+#: reliably name the category (research R-003).
+PATTERN = re.compile(rf"(?P<email>{_EMAIL})|(?P<ip>{_IPV4})|(?P<card>{_CARD})")
+
+#: One compiled pattern per candidate length, longest first, for the FR-019 selection.
+#: Built from the *same* `_SEP` fragment as `_CARD` so the two can never disagree about
+#: what a candidate is (plan.md Complexity Tracking).
+_CARD_BY_LENGTH = tuple(
+    re.compile(rf"[0-9](?:{_SEP}?[0-9]){{{length - 1}}}(?![0-9])") for length in range(19, 12, -1)
+)
+
+
+def _longest_valid_card(line: str, start: int) -> int | None:
+    """End offset of the longest Luhn-valid card candidate starting at `start` (FR-019).
+
+    Returns `None` when no candidate at that position passes the checksum, which is the
+    signal for the caller to resume one character later (FR-019a).
+    """
+    for pattern in _CARD_BY_LENGTH:  # 19 digits down to 13: first hit is the longest
+        match = pattern.match(line, start)
+        if match is not None and _luhn_valid(_NON_DIGIT.sub("", match.group())):
+            return match.end()
+    return None
+
+
+# --------------------------------------------------------------------------------------
+# The scan (data-model.md section 3)
+# --------------------------------------------------------------------------------------
+
+
+def redact_line(line: str) -> tuple[str, collections.Counter]:
+    """Redact one line, returning the new text and a per-line tally.
+
+    Two cursors are kept, and the second one is why: `copy_from` is the start of input not
+    yet copied to the output, and `search_from` is where the next search begins. They move
+    together whenever a match is accepted. When a card candidate is *rejected* by the
+    checksum, only `search_from` advances — by a single character — so the rejected text is
+    still copied verbatim later and a valid candidate further along the line is still found
+    (FR-019a). Resuming at `match.end()` there is the exact bug FR-019a forbids.
+
+    `search_from` strictly increases on every iteration, which is what makes this terminate.
+    """
+    counts: collections.Counter = collections.Counter()
+    fragments: list[str] = []
+    copy_from = 0
+    search_from = 0
+
+    while True:
+        match = PATTERN.search(line, search_from)
+        if match is None:
+            break
+        category = match.lastgroup
+        if category == "card":
+            end = _longest_valid_card(line, match.start())
+            if end is None:
+                search_from = match.start() + 1
+                continue
+        else:
+            end = match.end()
+
+        fragments.append(line[copy_from : match.start()])
+        fragments.append(PLACEHOLDERS[category])
+        counts[TALLY_KEYS[category]] += 1
+        copy_from = end
+        search_from = end
+
+    fragments.append(line[copy_from:])
+    return "".join(fragments), counts
