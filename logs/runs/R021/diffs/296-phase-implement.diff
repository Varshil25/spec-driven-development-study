+"""Entry point for `python -m logredact`.
+
+Holds only the entry call so that `cli.main()` stays importable and returns its exit status
+instead of raising SystemExit (contracts/cli.md "Internal entry point").
+"""
+
+import sys
+
+from logredact import cli
+
+sys.exit(cli.main(sys.argv[1:]))
