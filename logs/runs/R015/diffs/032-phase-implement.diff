@@ -0,0 +1,243 @@
+"""Reading and extracting tar archives.
+
+Nothing in here touches ``sys.argv``, prints, or exits; the command-line layer in
+:mod:`tarx.cli` turns the exceptions below into messages and exit statuses.
+"""
+
+from __future__ import annotations
+
+import os
+import tarfile
+import zlib
+from pathlib import Path, PurePosixPath
+from typing import List, NamedTuple, Optional, Tuple
+
+__all__ = [
+    "ArchiveError",
+    "OverwriteError",
+    "TarxError",
+    "UnsafePathError",
+    "extract_archive",
+    "list_members",
+]
+
+
+class TarxError(Exception):
+    """Base class for expected failures, carrying the process exit status."""
+
+    exit_code = 1
+
+
+class ArchiveError(TarxError):
+    """The archive is missing, unreadable, or not a valid tar archive."""
+
+    exit_code = 2
+
+
+class UnsafePathError(ArchiveError):
+    """A member would be written outside the destination directory."""
+
+    exit_code = 2
+
+
+class OverwriteError(TarxError):
+    """Extraction would clobber something that already exists on disk."""
+
+    exit_code = 3
+
+
+# Raised by tarfile/gzip/zlib when a stream turns out to be truncated or corrupt
+# part-way through reading it, rather than at open() time.
+_READ_ERRORS = (tarfile.TarError, EOFError, zlib.error, OSError)
+
+
+def _open_archive(archive: os.PathLike | str) -> tarfile.TarFile:
+    """Open *archive* for reading, auto-detecting plain vs. gzip compression."""
+    path = os.fspath(archive)
+    try:
+        # "r:*" transparently handles .tar, .tar.gz and .tgz (and bz2/xz for free).
+        return tarfile.open(path, mode="r:*")
+    except FileNotFoundError:
+        raise ArchiveError(f"{path}: no such file or directory") from None
+    except IsADirectoryError:
+        raise ArchiveError(f"{path}: is a directory, not a tar archive") from None
+    except (tarfile.ReadError, tarfile.CompressionError, zlib.error, EOFError):
+        raise ArchiveError(f"{path}: not a valid tar archive") from None
+    except OSError as exc:
+        reason = exc.strerror or str(exc)
+        raise ArchiveError(f"{path}: {reason}") from None
+
+
+def _members(tar: tarfile.TarFile, path: str) -> List[tarfile.TarInfo]:
+    """Return every member, in the order it appears in the archive."""
+    try:
+        return tar.getmembers()
+    except _READ_ERRORS:
+        raise ArchiveError(f"{path}: not a valid tar archive") from None
+
+
+def list_members(archive: os.PathLike | str) -> List[str]:
+    """Return the names of the archive's members, in archive order."""
+    path = os.fspath(archive)
+    with _open_archive(path) as tar:
+        return [member.name for member in _members(tar, path)]
+
+
+def _relative_parts(name: str) -> Optional[Tuple[str, ...]]:
+    """Split a member name into safe relative path components.
+
+    Returns ``None`` when the name refers to the destination directory itself
+    (``""``, ``"."``, ``"./"``), and raises :class:`UnsafePathError` for absolute
+    paths or anything containing a ``..`` component.
+    """
+    pure = PurePosixPath(name)
+    if pure.is_absolute():
+        raise UnsafePathError(f"{name}: refusing to extract an absolute path")
+    parts = tuple(part for part in pure.parts if part not in ("", "."))
+    if any(part == ".." for part in parts):
+        raise UnsafePathError(f"{name}: refusing to extract a path containing '..'")
+    return parts or None
+
+
+class _PlannedMember(NamedTuple):
+    member: tarfile.TarInfo
+    target: Path
+    is_dir: bool
+
+
+def _plan(members: List[tarfile.TarInfo], dest: Path) -> List[_PlannedMember]:
+    """Map the archive's files and directories onto paths under *dest*.
+
+    Regular files and directories are extracted. A hard-link member is a second
+    name for a regular file stored elsewhere in the same archive, so it is
+    written out as its own copy of that content rather than dropped. Symlinks
+    and special files (devices, fifos) are skipped: they are not files or
+    directories, and recreating a symlink is a path-escape hazard.
+    """
+    planned: List[_PlannedMember] = []
+    for member in members:
+        is_dir = member.isdir()
+        if not (is_dir or member.isfile() or member.islnk()):
+            continue
+        parts = _relative_parts(member.name)
+        if parts is None:
+            # A "./" entry: the destination directory itself, nothing to create.
+            continue
+        planned.append(_PlannedMember(member, dest.joinpath(*parts), is_dir))
+    return planned
+
+
+def _assert_inside(target: Path, dest_real: str) -> None:
+    """Fail unless *target* really lands inside *dest_real*.
+
+    The ``..`` check in :func:`_relative_parts` is not enough on its own: a
+    symlinked directory that already exists under the destination could
+    otherwise redirect a write outside of it.
+    """
+    parent_real = os.path.realpath(target.parent)
+    if parent_real != dest_real and not parent_real.startswith(dest_real + os.sep):
+        raise UnsafePathError(
+            f"{target}: refusing to write outside the destination directory"
+        )
+
+
+def _check_conflicts(
+    planned: List[_PlannedMember], dest: Path, dest_real: str, overwrite: bool
+) -> None:
+    """Reject clobbering before anything is written, so failures leave no mess."""
+    if os.path.lexists(dest) and not os.path.isdir(dest):
+        raise TarxError(f"{dest}: exists and is not a directory")
+
+    for member, target, is_dir in planned:
+        _assert_inside(target, dest_real)
+        if not os.path.lexists(target):
+            continue
+        if is_dir:
+            # Reusing a real directory is fine; anything else in its place is not.
+            if os.path.islink(target) or not os.path.isdir(target):
+                raise OverwriteError(
+                    f"{target}: exists and is not a directory"
+                )
+        elif os.path.isdir(target) and not os.path.islink(target):
+            raise OverwriteError(
+                f"{target}: exists as a directory, refusing to replace it with a file"
+            )
+        elif not overwrite:
+            raise OverwriteError(
+                f"{target}: already exists (use --overwrite to replace it)"
+            )
+
+
+def _make_dir(target: Path) -> None:
+    try:
+        target.mkdir(parents=True, exist_ok=True)
+    except (FileExistsError, NotADirectoryError):
+        raise OverwriteError(f"{target}: exists and is not a directory") from None
+    except OSError as exc:
+        raise TarxError(f"{target}: {exc.strerror or exc}") from None
+
+
+def _write_file(tar: tarfile.TarFile, member: tarfile.TarInfo, target: Path) -> None:
+    _make_dir(target.parent)
+    # Remove an existing symlink first: writing "through" it would escape dest.
+    if os.path.islink(target):
+        os.unlink(target)
+    try:
+        # For a hard-link member this resolves to the linked member's content.
+        source = tar.extractfile(member)
+    except KeyError:
+        raise ArchiveError(
+            f"{member.name}: link target {member.linkname!r} is not in the archive"
+        ) from None
+    except _READ_ERRORS:
+        raise ArchiveError(f"{member.name}: cannot read member from archive") from None
+    if source is None:  # pragma: no cover - only for non-regular members
+        return
+    try:
+        with source, open(target, "wb") as out:
+            while True:
+                try:
+                    chunk = source.read(1 << 16)
+                except _READ_ERRORS:
+                    # A truncated or corrupt archive, not a problem with the disk.
+                    raise ArchiveError(
+                        f"{member.name}: cannot read member from archive"
+                    ) from None
+                if not chunk:
+                    break
+                out.write(chunk)
+    except OSError as exc:
+        raise TarxError(f"{target}: {exc.strerror or exc}") from None
+
+    if member.mode & 0o111:  # keep the executable bit, if the archive had one
+        os.chmod(target, os.stat(target).st_mode | 0o111)
+    os.utime(target, (member.mtime, member.mtime))
+
+
+def extract_archive(
+    archive: os.PathLike | str, dest: os.PathLike | str, overwrite: bool = False
+) -> int:
+    """Extract files and directories from *archive* into *dest*.
+
+    Relative paths and file contents are preserved. Existing files are only
+    replaced when *overwrite* is true. Returns the number of regular files
+    written.
+    """
+    path = os.fspath(archive)
+    dest_path = Path(dest)
+    dest_real = os.path.realpath(dest_path)
+
+    with _open_archive(path) as tar:
+        planned = _plan(_members(tar, path), dest_path)
+        _check_conflicts(planned, dest_path, dest_real, overwrite)
+
+        _make_dir(dest_path)
+        written = 0
+        for member, target, is_dir in planned:
+            _assert_inside(target, dest_real)
+            if is_dir:
+                _make_dir(target)
+            else:
+                _write_file(tar, member, target)
+                written += 1
+        return written
