+"""Command-line interface for :mod:`tarx`.
+
+Exit statuses:
+    0  success
+    1  unexpected I/O failure while writing to the destination
+    2  the archive is missing, unreadable, or not a valid tar archive
+    3  extraction would overwrite an existing file and ``--overwrite`` was absent
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+from typing import Optional, Sequence
+
+from .core import TarxError, extract_archive, list_members
+
+PROG = "python -m tarx"
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog=PROG,
+        description="List and extract tar archives (.tar, .tar.gz, .tgz).",
+    )
+    subcommands = parser.add_subparsers(dest="command", metavar="COMMAND", required=True)
+
+    list_cmd = subcommands.add_parser(
+        "list",
+        help="print the name of every member of ARCHIVE, one per line",
+        description="Print the name of every member of ARCHIVE, one per line, "
+        "in the order they appear in the archive.",
+    )
+    list_cmd.add_argument("archive", metavar="ARCHIVE", help="tar archive to read")
+    list_cmd.set_defaults(handler=_cmd_list)
+
+    extract_cmd = subcommands.add_parser(
+        "extract",
+        help="extract the files and directories of ARCHIVE into DEST",
+        description="Extract the files and directories of ARCHIVE into DEST, "
+        "keeping their relative paths and file contents.",
+    )
+    extract_cmd.add_argument("archive", metavar="ARCHIVE", help="tar archive to read")
+    extract_cmd.add_argument(
+        "dest", metavar="DEST", help="directory to extract into (created if needed)"
+    )
+    extract_cmd.add_argument(
+        "--overwrite",
+        action="store_true",
+        help="replace existing files instead of failing",
+    )
+    extract_cmd.set_defaults(handler=_cmd_extract)
+
+    return parser
+
+
+def _cmd_list(args: argparse.Namespace) -> int:
+    for name in list_members(args.archive):
+        print(name)
+    return 0
+
+
+def _cmd_extract(args: argparse.Namespace) -> int:
+    count = extract_archive(args.archive, args.dest, overwrite=args.overwrite)
+    print(f"extracted {count} files")
+    return 0
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    args = build_parser().parse_args(list(argv) if argv is not None else None)
+    try:
+        return args.handler(args)
+    except TarxError as err:
+        print(f"{PROG}: error: {err}", file=sys.stderr)
+        return err.exit_code
+    except KeyboardInterrupt:  # pragma: no cover - interactive only
+        print(f"{PROG}: interrupted", file=sys.stderr)
+        return 130
+    except BrokenPipeError:  # pragma: no cover - e.g. `... list big.tar | head`
+        # Keep the interpreter from reporting the broken pipe again on shutdown.
+        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
+        return 0
