+class TestPathSafety(TarxTestCase):
+    def test_absolute_member_is_refused(self) -> None:
+        archive = make_archive(self.tmp / "abs.tar", {"/etc/evil": b"x"})
+        result = run_tarx("extract", str(archive), str(self.tmp / "out"))
+        self.assertEqual(result.returncode, 2)
+        self.assertFalse(Path("/etc/evil").exists())
+
+    def test_parent_traversal_member_is_refused(self) -> None:
+        archive = make_archive(self.tmp / "trav.tar", {"../escaped.txt": b"x"})
+        result = run_tarx("extract", str(archive), str(self.tmp / "out"))
+        self.assertEqual(result.returncode, 2)
+        self.assertFalse((self.tmp / "escaped.txt").exists())
+
+    def test_symlinked_directory_cannot_redirect_a_write(self) -> None:
+        outside = self.tmp / "outside"
+        outside.mkdir()
+        out = self.tmp / "out"
+        out.mkdir()
+        (out / "link").symlink_to(outside)
+        archive = make_archive(self.tmp / "link.tar", {"link/planted.txt": b"x"})
+        result = run_tarx("extract", str(archive), str(out))
+        self.assertEqual(result.returncode, 2)
+        self.assertFalse((outside / "planted.txt").exists())
+
+    def test_hard_link_member_is_written_as_a_copy(self) -> None:
+        archive = self.tmp / "hard.tar"
+        with tarfile.open(archive, "w") as tar:
+            import io
+
+            payload = b"shared contents"
+            info = tarfile.TarInfo("orig.txt")
+            info.size = len(payload)
+            tar.addfile(info, io.BytesIO(payload))
+            link = tarfile.TarInfo("second.txt")
+            link.type = tarfile.LNKTYPE
+            link.linkname = "orig.txt"
+            tar.addfile(link)
+        out = self.tmp / "out"
+        result = run_tarx("extract", str(archive), str(out))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "extracted 2 files\n")
+        self.assertEqual((out / "orig.txt").read_bytes(), b"shared contents")
+        self.assertEqual((out / "second.txt").read_bytes(), b"shared contents")
+
+    def test_dangling_hard_link_member_exits_2(self) -> None:
+        archive = self.tmp / "dangling.tar"
+        with tarfile.open(archive, "w") as tar:
+            link = tarfile.TarInfo("second.txt")
+            link.type = tarfile.LNKTYPE
+            link.linkname = "missing.txt"
+            tar.addfile(link)
+        result = run_tarx("extract", str(archive), str(self.tmp / "out"))
+        self.assertEqual(result.returncode, 2)
+        self.assertTrue(result.stderr.strip())
+
+    def test_symlink_members_are_skipped(self) -> None:
+        archive = self.tmp / "links.tar"
+        with tarfile.open(archive, "w") as tar:
+            import io
+
+            payload = b"real"
+            info = tarfile.TarInfo("real.txt")
+            info.size = len(payload)
+            tar.addfile(info, io.BytesIO(payload))
+            link = tarfile.TarInfo("escape")
+            link.type = tarfile.SYMTYPE
+            link.linkname = "/etc/passwd"
+            tar.addfile(link)
+        out = self.tmp / "out"
+        result = run_tarx("extract", str(archive), str(out))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "extracted 1 files\n")
+        self.assertEqual((out / "real.txt").read_bytes(), b"real")
+        self.assertFalse((out / "escape").exists())
+        # ...but they are still listed, since they are members of the archive.
+        listed = run_tarx("list", str(archive))
+        self.assertEqual(listed.stdout.splitlines(), ["real.txt", "escape"])
+
