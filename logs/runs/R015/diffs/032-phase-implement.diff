index 0000000..01398ca
--- /dev/null
+++ b/tests/test_tarx.py
@@ -0,0 +1,306 @@
+"""End-to-end tests for the tarx command line tool.
+
+Run with:  PYTHONPATH=src python -m unittest discover -s tests
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import tarfile
+import tempfile
+import unittest
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC = REPO_ROOT / "src"
+
+
+def run_tarx(*args: str) -> subprocess.CompletedProcess:
+    env = dict(os.environ, PYTHONPATH=str(SRC))
+    return subprocess.run(
+        [sys.executable, "-m", "tarx", *args],
+        capture_output=True,
+        text=True,
+        env=env,
+        cwd=REPO_ROOT,
+    )
+
+
+def make_archive(path: Path, entries: dict[str, bytes | None], mode: str = "w") -> Path:
+    """Create a tar archive. A ``None`` value means "directory entry"."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with tarfile.open(path, mode) as tar:
+        for name, content in entries.items():
+            info = tarfile.TarInfo(name)
+            if content is None:
+                info.type = tarfile.DIRTYPE
+                info.mode = 0o755
+                tar.addfile(info)
+            else:
+                info.size = len(content)
+                info.mode = 0o644
+                import io
+
+                tar.addfile(info, io.BytesIO(content))
+    return path
+
+
+class TarxTestCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory()
+        self.tmp = Path(self._tmp.name)
+        self.addCleanup(self._tmp.cleanup)
+
+    def photos(self, name: str = "photos.tar.gz", mode: str = "w:gz") -> Path:
+        return make_archive(
+            self.tmp / name,
+            {"photos/a.jpg": b"aaa", "photos/b.jpg": b"bbb"},
+            mode=mode,
+        )
+
+
+class TestList(TarxTestCase):
+    def test_lists_members_in_archive_order(self) -> None:
+        archive = make_archive(
+            self.tmp / "ordered.tar",
+            {"z.txt": b"z", "a.txt": b"a", "m/": None, "m/n.txt": b"n"},
+        )
+        result = run_tarx("list", str(archive))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(
+            result.stdout.splitlines(), ["z.txt", "a.txt", "m", "m/n.txt"]
+        )
+
+    def test_lists_gzip_archive(self) -> None:
+        result = run_tarx("list", str(self.photos()))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "photos/a.jpg\nphotos/b.jpg\n")
+
+    def test_lists_tgz_archive(self) -> None:
+        result = run_tarx("list", str(self.photos("photos.tgz")))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "photos/a.jpg\nphotos/b.jpg\n")
+
+    def test_missing_archive_exits_2(self) -> None:
+        result = run_tarx("list", str(self.tmp / "nope.tar"))
+        self.assertEqual(result.returncode, 2)
+        self.assertEqual(result.stdout, "")
+        self.assertTrue(result.stderr.strip())
+
+    def test_invalid_archive_exits_2(self) -> None:
+        bogus = self.tmp / "bogus.tar"
+        bogus.write_bytes(b"this is not a tar archive at all")
+        result = run_tarx("list", str(bogus))
+        self.assertEqual(result.returncode, 2)
+        self.assertTrue(result.stderr.strip())
+
+    def test_corrupt_gzip_exits_2(self) -> None:
+        archive = self.photos()
+        data = bytearray(archive.read_bytes())
+        del data[len(data) // 2 :]  # truncate mid-stream
+        broken = self.tmp / "broken.tar.gz"
+        broken.write_bytes(bytes(data))
+        result = run_tarx("list", str(broken))
+        self.assertEqual(result.returncode, 2)
+        self.assertTrue(result.stderr.strip())
+
+
+class TestExtract(TarxTestCase):
+    def test_extracts_files_and_reports_count(self) -> None:
+        archive = self.photos()
+        out = self.tmp / "out"
+        result = run_tarx("extract", str(archive), str(out))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "extracted 2 files\n")
+        self.assertEqual((out / "photos/a.jpg").read_bytes(), b"aaa")
+        self.assertEqual((out / "photos/b.jpg").read_bytes(), b"bbb")
+
+    def test_extracts_plain_tar_with_nested_dirs(self) -> None:
+        archive = make_archive(
+            self.tmp / "tree.tar",
+            {
+                "top/": None,
+                "top/one.txt": b"1",
+                "top/sub/": None,
+                "top/sub/two.txt": b"22",
+                "top/sub/deep/three.bin": b"\x00\x01\x02",
+            },
+        )
+        out = self.tmp / "tree-out"
+        result = run_tarx("extract", str(archive), str(out))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "extracted 3 files\n")
+        self.assertTrue((out / "top/sub").is_dir())
+        self.assertEqual((out / "top/sub/two.txt").read_bytes(), b"22")
+        self.assertEqual((out / "top/sub/deep/three.bin").read_bytes(), b"\x00\x01\x02")
+
+    def test_empty_archive_extracts_nothing(self) -> None:
+        archive = make_archive(self.tmp / "empty.tar", {})
+        out = self.tmp / "empty-out"
+        result = run_tarx("extract", str(archive), str(out))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "extracted 0 files\n")
+        self.assertTrue(out.is_dir())
+
+    def test_second_extract_without_overwrite_exits_3(self) -> None:
+        archive = self.photos()
+        out = self.tmp / "out"
+        self.assertEqual(run_tarx("extract", str(archive), str(out)).returncode, 0)
+        result = run_tarx("extract", str(archive), str(out))
+        self.assertEqual(result.returncode, 3)
+        self.assertEqual(result.stdout, "")
+        self.assertTrue(result.stderr.strip())
+
+    def test_overwrite_replaces_existing_files(self) -> None:
+        archive = self.photos()
+        out = self.tmp / "out"
+        (out / "photos").mkdir(parents=True)
+        (out / "photos/a.jpg").write_bytes(b"stale contents")
+        result = run_tarx("extract", str(archive), str(out), "--overwrite")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "extracted 2 files\n")
+        self.assertEqual((out / "photos/a.jpg").read_bytes(), b"aaa")
+
+    def test_conflict_leaves_no_partial_extraction(self) -> None:
+        archive = make_archive(
+            self.tmp / "many.tar",
+            {"a.txt": b"a", "b.txt": b"b", "c.txt": b"c"},
+        )
+        out = self.tmp / "out"
+        out.mkdir()
+        (out / "c.txt").write_bytes(b"mine")  # conflict on the *last* member
+        result = run_tarx("extract", str(archive), str(out))
+        self.assertEqual(result.returncode, 3)
+        self.assertFalse((out / "a.txt").exists())
+        self.assertFalse((out / "b.txt").exists())
+        self.assertEqual((out / "c.txt").read_bytes(), b"mine")
