+"""tarx -- a small command-line tool for listing and extracting tar archives.
+
+Supports plain (``.tar``) and gzip-compressed (``.tar.gz`` / ``.tgz``) archives.
+Run as ``python -m tarx COMMAND ...`` with ``src/`` on ``PYTHONPATH``.
+"""
+
+from .core import (
+    ArchiveError,
+    OverwriteError,
+    TarxError,
+    UnsafePathError,
+    extract_archive,
+    list_members,
+)
+
+__all__ = [
+    "ArchiveError",
+    "OverwriteError",
+    "TarxError",
+    "UnsafePathError",
+    "extract_archive",
+    "list_members",
+]
+
+__version__ = "1.0.0"
