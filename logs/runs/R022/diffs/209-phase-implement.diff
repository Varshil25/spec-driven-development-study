+"""Command-line entry point: input selection, stream I/O, and exit status."""
+
+import io
+import signal
+import sys
+
+from .redact import redact_text
+
+USAGE = "usage: python -m logredact [--count] [FILE ...]"
+
+
+def _flush(stream) -> None:
+    """Flush `stream`, tolerating a reader that has already gone away.
+
+    With SIGPIPE restored to its default disposition a closed stdout kills the
+    process outright, the way it kills `cat`, so this guard only covers the
+    platforms without SIGPIPE and the interpreter's shutdown flush. Catching one
+    specific anticipated exception is permitted by Constitution principle II
+    (research D-010).
+    """
+    try:
+        stream.flush()
+    except BrokenPipeError:
+        pass
+
+
+def _copy_redacted(source, destination) -> tuple[int, int, int]:
+    """Stream `source` through the redactor into `destination`.
+
+    One line is resident at a time, so a 1 MB line works and a 1 GB file does
+    not grow memory (R2.5). Returns the (emails, ips, cards) totals.
+    """
+    emails = 0
+    ips = 0
+    cards = 0
+    for line in source:
+        redacted, counts = redact_text(line)
+        destination.write(redacted)
+        emails += counts.emails
+        ips += counts.ips
+        cards += counts.cards
+    return emails, ips, cards
+
+
+def main(argv: list[str]) -> int:
+    # Python turns SIGPIPE into an exception, which would print a traceback when
+    # stdout is closed early by something like `| head`. Restoring the default
+    # disposition makes the tool terminate with status 141 and an empty stderr
+    # instead (research D-010). Guarded so Windows, which has no SIGPIPE, is
+    # unaffected.
+    if hasattr(signal, "SIGPIPE"):
+        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
+
+    # Hand-written rather than argparse, because argparse with nargs="*"
+    # provably rejects "logredact a.log --count b.log", which FR-001 requires
+    # to work (research D-007). Tokens are classified in one pass, so position
+    # carries no meaning. A bare "-" is an ordinary path named "-", not a stdin
+    # convention.
+    tally = False
+    paths = []
+    for token in argv:
+        if token == "--count":
+            # Accepted before, between, or after FILE arguments (FR-001);
+            # repeating it is equivalent to giving it once.
+            tally = True
+        elif token.startswith("-") and len(token) > 1:
+            # Any other option-shaped token is unrecognised, including -h and
+            # --help, which are deliberately not implemented (FR-024,
+            # research D-007). Nothing is read and nothing reaches stdout.
+            sys.stderr.write(f"{USAGE}\nlogredact: unrecognized option: {token}\n")
+            return 2
+        else:
+            paths.append(token)
+
+    # UTF-8 is forced explicitly on both ends rather than inherited from the
+    # locale, so a C locale cannot crash on non-ASCII passthrough. newline=""
+    # disables newline translation, which keeps each terminator attached to its
+    # line so CRLF and a missing final newline survive (FR-006, research D-008).
+    out = io.TextIOWrapper(
+        sys.stdout.buffer, encoding="utf-8", newline="", errors="strict"
+    )
+
+    # One tally per run, accumulated as the lines stream rather than by a
+    # second pass over the data (R4.1, R4.6).
+    emails = 0
+    ips = 0
+    cards = 0
+
+    if paths:
+        # A non-empty FILE list suppresses stdin entirely: it is not opened or
+        # read at all (R1.2). Duplicate paths are independent sources (R1.1).
+        for path in paths:
+            try:
+                with open(
+                    path, "r", encoding="utf-8", newline="", errors="strict"
+                ) as source:
+                    file_emails, file_ips, file_cards = _copy_redacted(source, out)
+            except (OSError, UnicodeDecodeError) as exc:
+                # Detection is by exception, never by an os.access or
+                # Path.is_file pre-flight check: that would be a TOCTOU race
+                # and a second code path for the same failure, where the
+                # exception already carries a better message (research D-009).
+                #
+                # The reason comes from the OS (strerror) or, for a decode
+                # failure, from the decoder's own message. Output already
+                # written to stdout stays written -- it is already-sanitised
+                # data. The run stops here: no further source is opened and no
+                # tally is printed, so a printed tally always describes a
+                # complete run (FR-023, R4.5).
+                _flush(out)
+                reason = getattr(exc, "strerror", None) or str(exc)
+                sys.stderr.write(f"logredact: {path}: {reason}\n")
+                return 2
+            emails += file_emails
+            ips += file_ips
+            cards += file_cards
+    else:
+        source = io.TextIOWrapper(
+            sys.stdin.buffer, encoding="utf-8", newline="", errors="strict"
+        )
+        emails, ips, cards = _copy_redacted(source, out)
+
+    _flush(out)
+    if tally:
+        # After all stdout output, exactly one line, 0 where nothing occurred
+        # (FR-019, R4.3, R4.4).
+        sys.stderr.write(f"emails={emails} ips={ips} cards={cards}\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
