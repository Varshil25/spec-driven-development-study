+++ b/src/logredact/redact.py
@@ -0,0 +1,127 @@
+"""Redaction engine: the three rule patterns, the Luhn check, and redact_text().
+
+This module performs no I/O. Per the Constitution's validation boundary, callers
+decode input at the point it enters the system, so redact_text() may assume a
+decoded `str` (see data-model.md "Engine interface").
+
+Pattern derivations live in research.md (D-001 email, D-002 IPv4, D-003 cards,
+D-004 pass ordering, D-005 Luhn-failure rescan, D-006 Luhn).
+"""
+
+import re
+from dataclasses import dataclass
+
+# Placeholders are fixed literals, not configurable (R3.1).
+EMAIL_PLACEHOLDER = "[EMAIL]"
+IP_PLACEHOLDER = "[IP]"
+CARD_PLACEHOLDER = "[CARD]"
+
+# FR-008 transcribed: a local part of letters, digits, . _ % + and -, then @,
+# then one or more dot-separated labels, ending in a final label of at least
+# two letters. The required dot is what rejects "jane@localhost" (FR-009).
+#
+# The leading lookbehind is derived, like the IPv4 one below, and is required
+# for SC-006 rather than for correctness: it accepts exactly the same strings
+# but turns an O(n^2) scan into a linear one. Without it, a long run of
+# local-part characters with no "@" (a 1 MB line of text) is rescanned from
+# every offset, because the greedy local part matches to end of line and
+# backtracks a character at a time looking for an "@" -- measured at ~0.4 s for
+# a 16 KB line and growing quadratically. The guard is behaviour-preserving
+# because "@" is not in the local-part class, so every start position inside
+# one run reaches the same "@" and the same domain: if a match succeeds from
+# some offset inside the run it also succeeds from the run's first character,
+# which is the one leftmost-first precedence (FR-017) already prefers.
+_EMAIL = (
+    r"(?<![A-Za-z0-9._%+\-])"
+    r"[A-Za-z0-9._%+\-]+@(?:[A-Za-z0-9\-]+\.)+[A-Za-z]{2,}"
+)
+
+# FR-011's 0-255 range lives inside the pattern, so no candidate needs a
+# Python-side range check. The forward guards are FR-013 verbatim; the
+# (?<!\d\.) lookbehind is derived (research D-002) and load bearing -- without
+# it "1.2.3.4.5" would yield "1.[IP]".
+_OCTET = r"(?:25[0-5]|2[0-4]\d|[01]?\d?\d)"
+_IPV4 = rf"(?<!\d)(?<!\d\.){_OCTET}(?:\.{_OCTET}){{3}}(?!\d)(?!\.\d)"
+
+# Compiled once at import, never per line (R3.5).
+#
+# Email is written first: Python's alternation is leftmost-first, which *is*
+# FR-017's "leftmost position wins; email beats IPv4 at an equal start".
+EMAIL_OR_IPV4 = re.compile(rf"(?P<email>{_EMAIL})|(?P<ip>{_IPV4})")
+
+# The repeated unit is "digit, then an optional single separator", so the bound
+# counts digits rather than characters: 12 units plus a final digit through 18
+# units plus a final digit is exactly 13 to 19 digits (FR-015/FR-016), however
+# the groups are separated. Because every separator must follow a digit, double
+# separators and leading or trailing separators are structurally impossible.
+CARD = re.compile(r"(?<!\d)(?:\d[ \-]?){12,18}\d(?!\d)")
+
+
+@dataclass(frozen=True, slots=True)
+class Counts:
+    """Replacement occurrences for one piece of redacted text (data-model.md §4)."""
+
+    emails: int = 0
+    ips: int = 0
+    cards: int = 0
+
+
+def luhn(digits: str) -> bool:
+    """Whether `digits` passes the Luhn checksum.
+
+    Precondition: `digits` contains only the characters 0-9. Length is NOT
+    checked here -- the 13-to-19-digit bound is the pattern's job (R3.6).
+    """
+    total = 0
+    for position, character in enumerate(reversed(digits)):
+        value = int(character)
+        if position % 2 == 1:
+            value *= 2
+            if value > 9:
+                value -= 9
+        total += value
+    return total % 10 == 0
+
+
+def redact_text(text: str) -> tuple[str, Counts]:
+    """Return `text` with sensitive values replaced, plus the counts for it."""
+    emails = 0
+    ips = 0
+    cards = 0
+
+    # --- Pass A: email and IPv4, one leftmost-first alternation (D-004).
+    # re.sub never rescans its own replacement text, which is FR-018 for free.
+    def replace(match: re.Match) -> str:
+        nonlocal emails, ips
+        if match.group("email") is not None:
+            emails += 1
+            return EMAIL_PLACEHOLDER
+        ips += 1
+        return IP_PLACEHOLDER
+
+    text = EMAIL_OR_IPV4.sub(replace, text)
+
+    # --- Pass B: cards, over pass A's output (R3.10).
+    # A checksum cannot be expressed as a regex, so the regex finds shaped
+    # candidates and Python decides. This is a search loop rather than re.sub
+    # because a candidate that fails Luhn must be left unchanged *and* not
+    # consumed: the scan resumes one character later so a valid card nested
+    # behind a failing window is still found (D-005).
+    pieces = []
+    position = 0
+    while True:
+        match = CARD.search(text, position)
+        if match is None:
+            break
+        digits = match.group(0).replace(" ", "").replace("-", "")
+        if luhn(digits):
+            pieces.append(text[position:match.start()])
+            pieces.append(CARD_PLACEHOLDER)
+            cards += 1
+            position = match.end()
+        else:
+            pieces.append(text[position:match.start() + 1])
+            position = match.start() + 1
+    pieces.append(text[position:])
+
+    return "".join(pieces), Counts(emails=emails, ips=ips, cards=cards)
