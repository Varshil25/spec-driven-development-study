+[project]
+name = "logredact"
+version = "0.1.0"
+description = "Redact email addresses, IPv4 addresses, and payment card numbers from log text"
+requires-python = ">=3.11"
+# Constitution principle I: the runtime depends only on the standard library.
+dependencies = []
+
+# Test tooling is exempt from principle I and is declared separately so the
+# exemption stays visible. pytest >= 7 is required for the built-in
+# `pythonpath` ini setting used below.
+[project.optional-dependencies]
+dev = ["pytest>=7"]
+
+[tool.pytest.ini_options]
+pythonpath = ["src"]
+testpaths = ["tests"]
