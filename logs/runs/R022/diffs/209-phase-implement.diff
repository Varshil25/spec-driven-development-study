+"""CLI-contract tests: FR-001..FR-004, FR-006, FR-019, FR-021..FR-025.
+
+Every test here runs the real command in a subprocess via the run_cli fixture,
+so stdout, stderr, and the exit status are the ones the process actually
+produced. Test ids are fixed by the requirement -> test map in
+specs/001-logredact-cli/quickstart.md (the SC-004 coverage artifact).
+"""
+
+import os
+
+import pytest
+
+
+# --- FR-002, FR-025: stdin ------------------------------------------------
+
+
+def test_fr002_reads_stdin_when_no_file_given(run_cli):
+    result = run_cli(stdin="user jane@example.com from 10.0.0.7\n")
+    assert result.stdout == "user [EMAIL] from [IP]\n"
+    assert result.stderr == ""
+    assert result.returncode == 0
+
+
+def test_fr025_exit_zero_when_all_inputs_read(run_cli):
+    assert run_cli(stdin="plain line\n").returncode == 0
+
+
+def test_empty_stdin_produces_empty_output(run_cli):
+    result = run_cli(stdin="")
+    assert result.stdout == ""
+    assert result.stderr == ""
+    assert result.returncode == 0
+
+
+# --- FR-003, FR-004, FR-006: named files ---------------------------------
+
+
+def test_fr003_reads_files_in_order_and_ignores_stdin(run_cli, tmp_path):
+    first = tmp_path / "a.log"
+    first.write_text("first a@b.io\n", encoding="utf-8")
+    result = run_cli(first, stdin="LEAK x@y.io\n")
+    assert result.stdout == "first [EMAIL]\n"
+    assert "LEAK" not in result.stdout
+    assert result.stderr == ""
+    assert result.returncode == 0
+
+
+def test_fr004_output_concatenated_in_argument_order(run_cli, tmp_path):
+    first = tmp_path / "a.log"
+    second = tmp_path / "b.log"
+    first.write_text("first a@b.io\n", encoding="utf-8")
+    second.write_text("second 1.2.3.4\n", encoding="utf-8")
+
+    assert run_cli(first, second).stdout == "first [EMAIL]\nsecond [IP]\n"
+    # Reversing the arguments reverses the output.
+    assert run_cli(second, first).stdout == "second [IP]\nfirst [EMAIL]\n"
+    # Duplicate paths are independent sources, so the content appears twice (R1.1).
+    assert run_cli(first, first).stdout == "first [EMAIL]\nfirst [EMAIL]\n"
+
+
+def test_fr006_byte_identical_passthrough_crlf_blank_and_no_final_newline(
+    run_cli, tmp_path
+):
+    # Written as bytes so no encoding layer in the test can normalise anything.
+    body = (
+        b"crlf line a@b.io\r\n"
+        b"\r\n"
+        b"\n"
+        b"   leading and trailing whitespace   \n"
+        b"\ttab\tseparated\t10.0.0.7\n"
+        b"non-ascii \xc3\xa9\xc3\xa0 \xe2\x9c\x93 preserved\n"
+        b"last line 4111111111111111 with no trailing newline"
+    )
+    path = tmp_path / "fidelity.log"
+    path.write_bytes(body)
+
+    result = run_cli(path)
+    assert result.returncode == 0
+    assert result.stderr == ""
+    assert result.stdout == (
+        "crlf line [EMAIL]\r\n"
+        "\r\n"
+        "\n"
+        "   leading and trailing whitespace   \n"
+        "\ttab\tseparated\t[IP]\n"
+        "non-ascii éà ✓ preserved\n"
+        "last line [CARD] with no trailing newline"
+    )
+    # No newline is invented for the final line.
+    assert not result.stdout.endswith("\n")
+    # A line with nothing to redact comes back exactly as read.
+    plain = tmp_path / "plain.log"
+    plain.write_bytes(b"GET /health 200 in 4ms\r\nno newline here")
+    assert run_cli(plain).stdout == "GET /health 200 in 4ms\r\nno newline here"
+
+
+# --- FR-001, FR-019..FR-021: the --count tally ---------------------------
+
+
+def test_fr001_count_flag_accepted_before_between_and_after_files(run_cli, tmp_path):
+    first = tmp_path / "a.log"
+    second = tmp_path / "b.log"
+    first.write_text("first a@b.io\n", encoding="utf-8")
+    second.write_text("second 1.2.3.4\n", encoding="utf-8")
+
+    expected_stdout = "first [EMAIL]\nsecond [IP]\n"
+    expected_tally = "emails=1 ips=1 cards=0\n"
+
+    before = run_cli("--count", first, second)
+    # The interspersed form is the case plain argparse gets wrong (research D-007).
+    between = run_cli(first, "--count", second)
+    after = run_cli(first, second, "--count")
+    for result in (before, between, after):
+        assert result.returncode == 0
+        assert result.stdout == expected_stdout
+        assert result.stderr == expected_tally
+
+    # Repeating the flag is equivalent to giving it once.
+    repeated = run_cli("--count", first, "--count", second, "--count")
+    assert repeated.returncode == 0
+    assert repeated.stdout == expected_stdout
+    assert repeated.stderr == expected_tally
+
+
+def test_fr019_count_writes_single_tally_line_after_output(run_cli):
+    result = run_cli("--count", stdin="a@b.io 1.2.3.4\n")
+    assert result.returncode == 0
+    assert result.stdout == "[EMAIL] [IP]\n"
+    # Exactly one line, in exactly this form.
+    assert result.stderr == "emails=1 ips=1 cards=0\n"
+    assert result.stderr.count("\n") == 1
+
+    # With the two streams merged into one pipe, the tally is observably last.
+    merged = run_cli(
+        "--count", stdin="a@b.io\n1.2.3.4\n4111111111111111\n", merge_stderr=True
+    )
+    assert merged.stdout.splitlines() == [
+        "[EMAIL]",
+        "[IP]",
+        "[CARD]",
+        "emails=1 ips=1 cards=1",
+    ]
+
+
+def test_fr020_single_tally_across_all_files(run_cli, tmp_path):
+    first = tmp_path / "a.log"
+    second = tmp_path / "b.log"
+    first.write_text("a@b.io c@d.io 10.0.0.7\n", encoding="utf-8")
+    second.write_text("4111 1111 1111 1111 and 1.2.3.4\n", encoding="utf-8")
+
+    result = run_cli("--count", first, second)
+    assert result.returncode == 0
+    # One tally covering every source combined, not one per file.
+    assert result.stderr == "emails=2 ips=2 cards=1\n"
+
+    # Occurrences, not distinct values.
+    repeats = run_cli("--count", stdin="a@b.io a@b.io a@b.io\n")
+    assert repeats.stderr == "emails=3 ips=0 cards=0\n"
+
+
+def test_fr021_stderr_empty_without_count(run_cli, tmp_path):
+    path = tmp_path / "a.log"
+    path.write_text("first a@b.io\n", encoding="utf-8")
+    assert run_cli(path).stderr == ""
+    assert run_cli(stdin="a@b.io\n").stderr == ""
+
+
+# --- FR-022..FR-024: failure modes ---------------------------------------
+#
+# Each of these asserts the diagnostic *and* the exit status; asserting one
+# without the other does not satisfy SC-005.
+
+
+def test_fr022_diagnostic_names_path_for_missing_denied_directory_and_undecodable(
+    run_cli, tmp_path
+):
+    # The reason text comes from the OS or the decoder, so a stable substring
+    # is asserted rather than the full string (research D-009).
+    missing = tmp_path / "nope.log"
+    result = run_cli(missing)
+    assert result.returncode == 2
+    assert str(missing) in result.stderr
+    assert "No such file or directory" in result.stderr
+    assert result.stdout == ""
+
+    # A directory is a read failure, not an empty input.
+    result = run_cli(tmp_path)
+    assert result.returncode == 2
+    assert str(tmp_path) in result.stderr
+    assert "Is a directory" in result.stderr
+    assert result.stdout == ""
+
+    # Undecodable bytes are refused, not approximated with U+FFFD.
+    binary = tmp_path / "binary.log"
+    binary.write_bytes(b"\xff\xfe\x00bad")
+    result = run_cli(binary)
+    assert result.returncode == 2
+    assert str(binary) in result.stderr
+    assert "codec can't decode byte" in result.stderr
+
+    # A file that cannot be opened. root bypasses permission bits, so this
+    # cause is only provokable as an unprivileged user; the probe below decides
+    # from what the OS actually does rather than from an assumption, and the
+    # strict version of the assertion lives in the companion test.
+    denied = tmp_path / "denied.log"
+    denied.write_text("secret a@b.io\n", encoding="utf-8")
+    denied.chmod(0o000)
+    if _denial_is_enforced(denied):
+        result = run_cli(denied)
+        assert result.returncode == 2
+        assert str(denied) in result.stderr
+        assert "Permission denied" in result.stderr
+        assert result.stdout == ""
+
+
+def _denial_is_enforced(path):
+    """Whether this user is actually denied by `path`'s permission bits."""
+    try:
+        with open(path, "rb"):
+            return False
+    except PermissionError:
+        return True
+
+
+@pytest.mark.skipif(
+    os.geteuid() == 0, reason="root bypasses permission bits, so denial cannot be provoked"
+)
+def test_fr022_permission_denied_names_path_and_exits_2(run_cli, tmp_path):
+    denied = tmp_path / "denied.log"
+    denied.write_text("secret a@b.io\n", encoding="utf-8")
+    denied.chmod(0o000)
+    result = run_cli(denied)
+    assert result.returncode == 2
+    assert str(denied) in result.stderr
+    assert "Permission denied" in result.stderr
+    assert result.stdout == ""
+
+
+def test_fr023_stops_at_first_failure_suppresses_tally_exits_2(run_cli, tmp_path):
+    readable = tmp_path / "a.log"
+    readable.write_text("first a@b.io\n", encoding="utf-8")
+    other = tmp_path / "b.log"
+    other.write_text("second 1.2.3.4\n", encoding="utf-8")
+    missing = tmp_path / "nope.log"
+
+    # Readable, then missing: the first file's output is already on stdout and
+    # is not retracted; the third argument is never opened.
+    result = run_cli(readable, missing, other, "--count")
+    assert result.returncode == 2
+    assert result.stdout == "first [EMAIL]\n"
+    assert str(missing) in result.stderr
+    assert "second" not in result.stdout
+    # No tally, and --count does not change that (R4.5).
+    assert "emails=" not in result.stderr
+    assert result.stderr.count("\n") == 1
+
+    # Missing, then readable: nothing from the second file appears.
+    result = run_cli(missing, other, "--count")
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "emails=" not in result.stderr
+
+
+def test_fr024_unrecognized_option_usage_to_stderr_nothing_processed(run_cli, tmp_path):
+    path = tmp_path / "a.log"
+    path.write_text("first a@b.io\n", encoding="utf-8")
+
+    result = run_cli("--verbose", path)
+    assert result.returncode != 0
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr == (
+        "usage: python -m logredact [--count] [FILE ...]\n"
+        "logredact: unrecognized option: --verbose\n"
+    )
+
+    # Nothing is read: a nonexistent path after the bad option is never opened,
+    # so no read-failure diagnostic naming it appears.
+    missing = tmp_path / "nope.log"
+    result = run_cli("-x", missing)
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert str(missing) not in result.stderr
+    assert "logredact: unrecognized option: -x\n" in result.stderr
+
+    # -h and --help are deliberately not implemented and take this same path.
+    for flag in ("-h", "--help"):
+        result = run_cli(flag)
+        assert result.returncode == 2
+        assert result.stdout == ""
+        assert f"logredact: unrecognized option: {flag}\n" in result.stderr
+
+    # A bare "-" is an ordinary path, not an option and not a stdin convention.
+    result = run_cli("-")
+    assert result.returncode == 2
+    assert "unrecognized option" not in result.stderr
+    assert "No such file or directory" in result.stderr
+
+
+# --- Success criteria spanning the whole tool ----------------------------
+
+
+def test_sc001_worked_examples_reproduce_exactly(run_cli):
+    # The normative E-1, E-2, and E-3 blocks from contracts/cli.md, asserting
+    # byte-for-byte output, which stream each byte goes to, and the status.
+
+    # E-1 -- stdin, mixed values.
+    result = run_cli(stdin="user jane@example.com from 10.0.0.7\n")
+    assert result.stdout == "user [EMAIL] from [IP]\n"
+    assert result.stderr == ""
+    assert result.returncode == 0
+
+    # E-2 -- grouped card redacted, Luhn-invalid run preserved.
+    result = run_cli(stdin="paid with 4111 1111 1111 1111, ref 1234567890123\n")
+    assert result.stdout == "paid with [CARD], ref 1234567890123\n"
+    assert result.stderr == ""
+    assert result.returncode == 0
+
+    # E-3 -- tally on stderr, output unaffected.
+    plain = run_cli(stdin="a@b.io 1.2.3.4\n")
+    counted = run_cli("--count", stdin="a@b.io 1.2.3.4\n")
+    assert counted.stdout == "[EMAIL] [IP]\n"
+    assert counted.stderr == "emails=1 ips=1 cards=0\n"
+    assert counted.returncode == 0
+    # The flag changes stderr only; stdout is byte-identical either way.
+    assert counted.stdout == plain.stdout
+
+
+def test_sc006_streams_large_input_within_budget(run_cli, tmp_path):
+    import time
+
+    path = tmp_path / "big.log"
+    with open(path, "w", encoding="utf-8", newline="") as handle:
+        for index in range(100_000):
+            handle.write(
+                f"{index} user{index}@ex.com 10.0.{index % 256}.1 "
+                f"card 4111 1111 1111 1111\n"
+            )
+
+    started = time.monotonic()
+    result = run_cli("--count", path)
+    elapsed = time.monotonic() - started
+
+    assert result.returncode == 0
+    assert result.stderr == "emails=100000 ips=100000 cards=100000\n"
+    assert result.stdout.count("\n") == 100_000
+    assert elapsed < 10, f"took {elapsed:.2f}s, budget is 10s"
+
+    # A very long single line passes through without truncation: only one line
+    # is ever resident, so memory is bounded by the longest line, not the input.
+    long_line = "x" * 1_000_000 + " a@b.io\n"
+    result = run_cli(stdin=long_line)
+    assert result.returncode == 0
+    assert result.stdout == "x" * 1_000_000 + " [EMAIL]\n"
+    assert len(result.stdout) == 1_000_009
