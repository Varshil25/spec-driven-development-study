+"""Shared test helper: run the real command line in a subprocess.
+
+CLI-contract assertions go through a real process, never through an in-process
+call to main(), so that stream separation and exit status are what the operating
+system actually produced (plan.md "Testing").
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC = REPO_ROOT / "src"
+
+
+def _run(args, stdin, merge_stderr):
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+    # Binary pipes, decoded here. subprocess's text mode has no `newline=""`
+    # option and would translate CRLF to LF on the way out, which is exactly the
+    # fidelity FR-006 asks us to prove; bytes.decode() translates nothing, so
+    # terminators reach the assertions untouched.
+    completed = subprocess.run(
+        [sys.executable, "-m", "logredact", *args],
+        input=stdin.encode("utf-8"),
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT if merge_stderr else subprocess.PIPE,
+        env=env,
+        check=False,
+    )
+    return subprocess.CompletedProcess(
+        completed.args,
+        completed.returncode,
+        completed.stdout.decode("utf-8"),
+        None if merge_stderr else completed.stderr.decode("utf-8"),
+    )
+
+
+@pytest.fixture
+def run_cli():
+    """Return a callable: run_cli(*args, stdin="") -> CompletedProcess of str."""
+
+    def call(*args, stdin="", merge_stderr=False):
+        return _run([str(arg) for arg in args], stdin, merge_stderr)
+
+    return call
