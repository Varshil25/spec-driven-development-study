{"schema_version": "1.0.0", "event_id": "402e5d66-1da7-4f94-8422-bd21ccd1f438", "run_id": "R001", "seq": 19, "ts": "2026-09-17T20:02:05.078Z", "type": "prompt", "actor": "human", "phase": "specify", "condition": "sdd", "task_id": "T-SPLIT-01", "session_id": "38fbb913-c697-4d01-97de-26efec947673", "payload": {"text": "/speckit-specify Build a command-line tool that reads a CSV file of shared group expenses and prints who owes whom in order to settle up. The CSV has a header row with columns payer, amount, description. The participant list is supplied separately as a comma-separated argument. Every participant owes an equal share of the group total. The tool computes each person's net balance and prints a minimal list of payments that settles every balance to zero. All money is handled in whole cents and rounding must never lose or invent money: the payments printed must sum exactly to the total imbalance. Malformed input (missing file, unknown payer not in the participant list, non-numeric or negative amount, empty participant list) must produce a clear error on stderr and a non-zero exit code. Python 3, standard library only.", "chars": 824, "words": 135, "sha256": "8a7518882626e8f53d77f99f3a7c6a9b6eaf118071c6b014b9f6e8f3aa785170", "source": "hook"}}
