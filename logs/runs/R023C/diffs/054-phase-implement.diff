+def _report(name: str, exc: OSError) -> int:
+    """Name a failing file on stderr; returns the exit status to use."""
+    reason = exc.strerror or str(exc)
+    print(f"{PROG}: {name}: {reason}", file=sys.stderr)
+    return 2
+
+
+def _to_stdout(files: Sequence[str], counts: Counts) -> int:
+    """Write every file (or stdin) to standard output, in order."""
+    out = sys.stdout
+    if not files:
+        _copy_redacted(sys.stdin, out, counts)
+    else:
+        for name in files:
+            if name == "-":
+                _copy_redacted(sys.stdin, out, counts)
+                continue
+            try:
+                with open(name, "r", **_STREAM_KWARGS) as handle:
+                    _copy_redacted(handle, out, counts)
+            except BrokenPipeError:
+                raise  # an output problem, not an input one
+            except OSError as exc:
+                out.flush()
+                return _report(name, exc)
+    out.flush()
+    return 0
+
+
+def _to_dir(files: Sequence[str], out_dir: str, counts: Counts) -> int:
+    """Write each file to a file of the same name in ``out_dir``.
+
+    Prints ``wrote N files`` once every file has been processed. The first
+    file that cannot be read (or written) stops the run, as with standard
+    output, so no summary line is printed in that case.
+    """
+    try:
+        os.makedirs(out_dir, exist_ok=True)
+    except OSError as exc:
+        return _report(out_dir, exc)
+
+    written: set[str] = set()
+    for name in files:
+        target = os.path.join(out_dir, os.path.basename(name))
+        try:
+            source = open(name, "r", **_STREAM_KWARGS)
+        except OSError as exc:
+            return _report(name, exc)
+        with source:
+            try:
+                sink = open(target, "w", **_STREAM_KWARGS)
+            except OSError as exc:
+                return _report(target, exc)
+            with sink:
