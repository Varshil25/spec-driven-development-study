+    write_input(tmp_path, "web.log", b"GET / from 10.0.0.7\n")
+    return ("--count", "--out-dir", "clean", "app.log", "web.log"), b""
+
+
+def _setup_success_empty_input(tmp_path) -> tuple[tuple[str, ...], bytes]:
+    write_input(tmp_path, "empty.log", b"")
+    return ("--out-dir", "clean", "empty.log"), b""
+
+
+def _setup_success_nested_dir(tmp_path) -> tuple[tuple[str, ...], bytes]:
+    write_input(tmp_path, "app.log", b"user jane@example.com\n")
+    return ("--out-dir", "reports/clean/today", "app.log"), b""
+
+
+def _setup_fail_no_operand(tmp_path) -> tuple[tuple[str, ...], bytes]:
+    return ("--out-dir", "clean2"), b"x\n"
+
+
+def _setup_fail_dir_is_a_file(tmp_path) -> tuple[tuple[str, ...], bytes]:
