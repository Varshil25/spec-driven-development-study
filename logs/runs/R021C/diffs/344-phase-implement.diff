+    assert_no_traceback(stderr)
+
+
+# --------------------------------------------------------------------------------------
+# FR-048 / FR-049: the shape of every output-side diagnostic (data-model.md section 5)
+# --------------------------------------------------------------------------------------
+
+
+def _setup_diag_dir_unusable(tmp_path) -> tuple[tuple[str, ...], bytes]:
