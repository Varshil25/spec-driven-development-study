--- /dev/null
+++ b/tests/test_out_dir.py
@@ -0,0 +1,746 @@
+"""Contract tests for the output folder (FR-040 - FR-051, FR-054).
+
+The command-line surface under test is specified in
+specs/002-phone-redaction-out-dir/contracts/cli.md, including the FR-054 order of
+operations and the exact diagnostic forms.
+
+Every test here runs the real CLI as a subprocess through `tests/conftest.py::run_cli`,
+because what the acceptance criteria are written in is byte-exact standard output, a
+specific exit status, and what is on disk afterwards — none of which is observable from an
+in-process call (see tests/conftest.py).
+
+Every run uses `cwd=tmp_path` and relative operand spellings. That is not cosmetic: the
+FR-049 collision cases turn on the path *as spelled* reaching the same file on disk, and
+`--out-dir .` only means anything relative to a working directory.
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from conftest import run_cli
+
+
+def write_input(tmp_path, name: str, data: bytes) -> str:
+    """Write an input file at `name` under `tmp_path`; return `name` as the operand spelling.
+
+    The relative name is what goes on the command line, so diagnostics quote the spelling
+    the caller used (FR-028, FR-049) rather than an absolute path.
+    """
+    path = tmp_path / name
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(data)
+    return name
+
+
+def assert_no_traceback(stderr: bytes) -> None:
+    """SC-016: no new failure path may emit a stack trace or other unhandled-error text."""
+    assert b"Traceback" not in stderr, stderr
+    assert b"Exception ignored" not in stderr, stderr
+
+
+# --------------------------------------------------------------------------------------
+# FR-045: the happy path (US2.1, US2.2)
+# --------------------------------------------------------------------------------------
+
+
+def test_fr045_two_files_are_redacted_into_a_directory_that_did_not_exist(tmp_path) -> None:
+    """FR-045 / US2.1 / US2.2: one output file per operand, summary line only on stdout."""
+    write_input(tmp_path, "app.log", b"user jane@example.com\n")
+    write_input(tmp_path, "web.log", b"GET / from 10.0.0.7\n")
+    assert not (tmp_path / "clean").exists(), "the fixture must start with no `clean`"
+
+    stdout, stderr, status = run_cli("--out-dir", "clean", "app.log", "web.log", cwd=tmp_path)
+
+    assert status == 0
+    assert stdout == b"wrote 2 files\n"
+    assert stderr == b""
+    assert (tmp_path / "clean" / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert (tmp_path / "clean" / "web.log").read_bytes() == b"GET / from [IP]\n"
+    # US2.2: no redacted log content reaches standard output at all.
+    assert b"[EMAIL]" not in stdout and b"[IP]" not in stdout
+    assert b"jane" not in stdout
+
+
+# --------------------------------------------------------------------------------------
+# FR-040: the option is accepted anywhere and its value is never an operand (US2.8)
+# --------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "argv",
+    [
+        ("--out-dir", "clean", "a.log", "b.log"),
+        ("a.log", "--out-dir", "clean", "b.log"),
+        ("a.log", "b.log", "--count", "--out-dir", "clean"),
+        ("--out-dir=clean", "a.log"),
+    ],
+    ids=["leading", "interleaved", "trailing-with-count", "equals-form"],
+)
+def test_fr040_the_option_is_recognized_at_any_position(tmp_path, argv) -> None:
+    """FR-040 / US2.8: options and operands interleave; `clean` is never a FILE (research R-104)."""
+    write_input(tmp_path, "a.log", b"a jane@example.com\n")
+    write_input(tmp_path, "b.log", b"b 10.0.0.7\n")
+
+    stdout, _stderr, status = run_cli(*argv, cwd=tmp_path)
+
+    assert status == 0, f"{argv} failed"
+    assert stdout.startswith(b"wrote "), stdout
+    assert (tmp_path / "clean" / "a.log").exists()
+    # The directory value must never have been treated as a FILE operand, which would show
+    # up either as a read diagnostic or as an output file named after it.
