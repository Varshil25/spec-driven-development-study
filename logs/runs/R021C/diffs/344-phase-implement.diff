@@ -0,0 +1,290 @@
+"""Unit tests for the phone category (FR-032, FR-033, FR-033a, FR-034 - FR-037, SC-011).
+
+The grammar under test is specified in
+specs/002-phone-redaction-out-dir/contracts/redaction-patterns.md; the accepted and
+rejected forms tabulated there each have a case here, and the "must not match" rows are
+the look-alikes the specification names.
+
+These tests call `redact.redact_line` directly. It is a pure function — string in, string
+out plus a tally — so no stream, no subprocess, and no capture is involved, which makes a
+failure immediate and precise. The stream-level phone behaviour (the four-field tally, the
+worked examples) lives in tests/test_cli.py.
+
+Every test below cites the requirement identifier it covers in its name or docstring, as
+Constitution Principle III and SC-015 require; `tests/test_requirement_coverage.py` enforces
+that mapping mechanically for FR-032 - FR-054 and SC-010 - SC-019.
+"""
+
+from __future__ import annotations
+
+import collections
+from pathlib import Path
+
+import pytest
+
+from logredact import redact
+
+FIXTURES = Path(__file__).resolve().parent / "fixtures"
+
+
+def assert_redaction(
+    line: str,
+    expected: str,
+    *,
+    emails: int = 0,
+    ips: int = 0,
+    cards: int = 0,
+    phones: int = 0,
+) -> None:
+    """Assert both halves of `redact_line`'s result: the text and the per-line tally.
+
+    Mirrors the helper in tests/test_redact.py, with the fourth category added.
+    """
+    out, counts = redact.redact_line(line)
+    assert out == expected
+    assert isinstance(counts, collections.Counter)
+    assert (counts["emails"], counts["ips"], counts["cards"], counts["phones"]) == (
+        emails,
+        ips,
+        cards,
+        phones,
+    )
+    assert set(counts) <= {"emails", "ips", "cards", "phones"}, (
+        f"unexpected tally keys: {set(counts)}"
+    )
+
+
+def assert_unchanged(line: str) -> None:
+    """Assert the line passes through unchanged and contributes nothing to the tally."""
+    assert_redaction(line, line)
+
+
+# --------------------------------------------------------------------------------------
+# FR-032 and FR-033: `+` followed by 8 to 15 digits
+# --------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("number", ["+14155552671", "+442071838750"])
+def test_fr032_each_phone_number_is_replaced_by_the_placeholder(number: str) -> None:
+    """FR-032: a recognized phone number becomes the literal text `[PHONE]`."""
+    assert_redaction(number, "[PHONE]", phones=1)
+
+
+def test_fr032_the_phone_number_is_replaced_in_place_with_surrounding_text_intact() -> None:
+    """FR-032: only the number is replaced; the rest of the line is untouched."""
+    assert_redaction("call +14155552671 now", "call [PHONE] now", phones=1)
+
+
+@pytest.mark.parametrize(
+    "number",
+    [
+        "+12345678",  # eight digits: "8 to 15 digits, inclusive" — the lower bound
+        "+123456789012345",  # fifteen digits: the upper bound
+    ],
+)
+def test_fr033_both_length_bounds_are_replaced_in_full(number: str) -> None:
+    """FR-033: eight and fifteen digits are both inside the accepted range."""
+    assert_redaction(number, "[PHONE]", phones=1)
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        "+1234567",  # seven digits: one short of the lower bound
+        "+1 415 555 2671",  # spaces between the digits
+        "+1-415-555-2671",  # hyphens between the digits
+        "14155552671",  # no leading `+`
+        "+",  # a `+` with no digits at all
+        "+abc12345678",  # the digits do not immediately follow the `+`
+    ],
+)
+def test_fr033_forms_outside_the_rule_pass_through_unchanged_and_uncounted(line: str) -> None:
+    """FR-033: "no separators, spaces, or other characters between them", and 8 is the floor."""
+    assert_unchanged(line)
+
+
+def test_fr033_nothing_before_the_plus_is_inspected() -> None:
+    """FR-033 / spec Assumptions: the rule constrains only the `+` and what follows it.
+
+    `++14155552671` makes the point twice: the first `+` cannot start a candidate because a
+    `+` is not a digit, and the second one can, even though a `+` precedes it.
+    """
+    assert_redaction("++14155552671", "+[PHONE]", phones=1)
+    assert_redaction("total=5+12345678", "total=5[PHONE]", phones=1)
+
+
+# --------------------------------------------------------------------------------------
+# FR-033a: "digit" means one of the characters 0 to 9 only
+# --------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("script", "line"),
+    [
+        ("Arabic-Indic", "+٠١٢٣٤٥٦٧٨"),
+        ("Devanagari", "+०१२३४५६७८"),
+        ("full-width", "+０１２３４５６７８"),
+    ],
+)
+def test_fr033a_digits_from_another_writing_system_do_not_count_toward_the_length(
+    script: str, line: str
+) -> None:
+    """FR-033a: nine decimal digits from another script are not eight-to-fifteen digits."""
+    assert_unchanged(line)
+    assert script  # the parameter id is the documentation
+
+
+def test_fr033a_a_foreign_digit_after_a_candidate_neither_extends_nor_excludes_it() -> None:
+    """FR-033a: `+12345678٩` is `[PHONE]٩`.
+
+    The trailing Arabic-Indic nine does not lengthen the candidate past fifteen and does not
+    satisfy FR-034's "immediately followed by a further digit" exclusion either, because it
+    is not one of the characters `0` to `9`.
+    """
+    assert_redaction("+12345678٩", "[PHONE]٩", phones=1)
+
+
+# --------------------------------------------------------------------------------------
+# FR-034: a candidate followed by a further digit is not a phone number
+# --------------------------------------------------------------------------------------
+
+
+def test_fr034_a_sixteen_digit_run_produces_no_placeholder_anywhere() -> None:
+    """FR-034: every backtracked length from fifteen down to eight fails the lookahead.
+
+    The expected text, not merely the absence of `[PHONE]`, is asserted: a rule that matched
+    the first fifteen digits would leave a stray trailing digit behind, and only a text
+    comparison catches that.
+    """
+    assert_unchanged("+1234567890123456")
+
+
+def test_fr034_a_twenty_digit_run_produces_no_placeholder_anywhere() -> None:
+    """FR-034: the exclusion does not depend on how far past fifteen the run goes."""
+    assert_unchanged("+12345678901234567890")
+
+
+def test_fr034_a_plus_before_a_luhn_valid_card_still_gives_the_card_placeholder() -> None:
+    """FR-034: `+4111111111111111` is still `+[CARD]`, exactly as before this feature.
+
+    This is the case the requirement exists to protect. The sixteen-digit run cannot be a
+    phone number, so the card rule gets its turn one character to the right and today's
+    output is preserved.
+    """
+    assert_redaction("+4111111111111111", "+[CARD]", cards=1, phones=0)
+
+
+# --------------------------------------------------------------------------------------
+# FR-035, FR-036, FR-037: the single-claim rule, precedence, and no re-examination
+# --------------------------------------------------------------------------------------
+
+
+def test_fr035_all_four_categories_on_one_line_are_each_replaced_once() -> None:
+    """FR-035: each character belongs to at most one redaction (US1.6)."""
+    assert_redaction(
+        "call +14155552671 mail jane@example.com host 10.0.0.7 card 4111111111111111 done",
+        "call [PHONE] mail [EMAIL] host [IP] card [CARD] done",
+        emails=1,
+        ips=1,
+        cards=1,
+        phones=1,
+    )
+
+
+def test_fr036_email_wins_over_phone_at_the_same_start_position() -> None:
+    """FR-036: precedence is email, then IPv4, then card, then phone.
+
+    Both categories start at offset 0 here — the email local part already admits `+` and
+    digits — and email is written first in the alternation.
+    """
+    assert_redaction("+14155552671@example.com", "[EMAIL]", emails=1, phones=0)
+
+
+def test_fr036_an_earlier_starting_phone_candidate_beats_a_later_starting_card() -> None:
+    """FR-036 / FR-021: earliest start wins, and the `+` is one character earlier.
+
+    `+4111111111119` produced `+[CARD]` before this feature and produces `[PHONE]` after
+    it. That is the one input shape whose redaction output changes (SC-012), and it is a
+    different placeholder on text that was already redacted, never a leak.
+    """
+    assert_redaction("+4111111111119", "[PHONE]", cards=0, phones=1)
+
+
+def test_fr037_a_literal_placeholder_in_the_input_passes_through_uncounted() -> None:
+    """FR-037: `[PHONE]` already in the input is ordinary text, copied through and not counted."""
+    assert_unchanged("[PHONE]")
+    assert_unchanged("already redacted: [EMAIL] [IP] [CARD] [PHONE]")
+
+
+def test_fr037_a_rejected_card_candidate_still_resumes_in_time_to_find_a_later_phone() -> None:
+    """FR-037 / FR-019a: the one-character resume after a Luhn failure reaches the `+`.
+
+    `1234567890123` is a Luhn-failing thirteen-digit run, so the card branch rejects it and
+    only the search cursor advances, by one character. The phone number beyond it is still
+    found (contracts/redaction-patterns.md, research R-103).
+    """
+    assert_redaction("1234567890123+12345678", "1234567890123[PHONE]", phones=1)
+
+
+# --------------------------------------------------------------------------------------
+# SC-011: the 50-line corpus
+# --------------------------------------------------------------------------------------
+
+#: Phone numbers planted in tests/fixtures/phone_corpus.log. 100% must be redacted.
+PLANTED_PHONE_COUNT = 20
+
+#: Look-alike tokens planted in the same fixture. 0% may be altered. Each appears twice.
+LOOKALIKE_TOKENS = [
+    "+1234567",  # seven digits
+    "+1234567890123456",  # sixteen digits
+    "+1 415 555 2671",  # space-grouped
+    "+1-415-555-2671",  # hyphen-grouped
+    "14155552671",  # unprefixed digit run
+    "442071838750",  # unprefixed digit run
+    "+٠١٢٣٤٥٦٧٨",  # Arabic-Indic digits
+    "+०१२३४५६७८",  # Devanagari digits
+    "+０１２３４５６７８",  # full-width digits
+]
+
+MIN_CORPUS_LINES = 50
+
+
+def test_sc011_every_planted_phone_is_redacted_and_no_lookalike_is_altered() -> None:
+    """SC-011: 100% of the planted phone numbers redacted, 0% of the look-alikes altered."""
+    source = (FIXTURES / "phone_corpus.log").read_text(encoding="utf-8")
+    lines = source.splitlines(keepends=True)
+    assert len(lines) >= MIN_CORPUS_LINES, f"the fixture is only {len(lines)} lines"
+
+    redacted: list[str] = []
+    total: collections.Counter = collections.Counter()
+    for line in lines:
+        text, counts = redact.redact_line(line)
+        redacted.append(text)
+        total.update(counts)
+    output = "".join(redacted)
+
+    assert total["phones"] == PLANTED_PHONE_COUNT, (
+        f"expected {PLANTED_PHONE_COUNT} planted phone numbers, counted {total['phones']}"
+    )
+    assert output.count("[PHONE]") == PLANTED_PHONE_COUNT + source.count("[PHONE]"), (
+        "the placeholder count must equal the planted count plus the literals already there"
+    )
+    # Every look-alike sits on a line tagged `seen`, and those lines must come back byte
+    # for byte. Whole lines are compared rather than substring occurrences because a
+    # look-alike can be a prefix of a planted number — `+1234567` is a prefix of the
+    # planted `+12345678` — so a raw occurrence count would move for a reason that has
+    # nothing to do with the look-alike being altered.
+    lookalike_lines = [line for line in lines if " seen " in line]
+    assert len(lookalike_lines) == 2 * len(LOOKALIKE_TOKENS), (
+        f"expected each look-alike twice, found {len(lookalike_lines)} look-alike lines"
+    )
+    for line in lookalike_lines:
+        text, counts = redact.redact_line(line)
+        assert text == line, f"look-alike line was altered: {line!r} -> {text!r}"
+        assert counts["phones"] == 0, f"look-alike line was counted: {line!r}"
+
+    for token in LOOKALIKE_TOKENS:
+        assert any(token in line for line in lookalike_lines), (
+            f"look-alike {token!r} is not planted in the fixture"
+        )
+        assert token in output, f"look-alike {token!r} was altered"
