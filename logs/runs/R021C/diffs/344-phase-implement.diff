+    assert_no_traceback(stderr)
+
+
+@pytest.mark.parametrize("setup", SUCCEEDING, ids=[fn.__name__ for fn in SUCCEEDING])
+def test_sc017_the_summary_line_always_appears_on_a_succeeding_out_dir_run(
+    tmp_path, setup
+) -> None:
+    """SC-017: and it always does reach stdout on a run that exits 0."""
+    argv, stdin = setup(tmp_path)
+    stdout, stderr, status = run_cli(*argv, stdin=stdin, cwd=tmp_path)
