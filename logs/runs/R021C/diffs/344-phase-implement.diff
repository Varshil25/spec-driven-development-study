+def test_fr054_a_later_operand_that_would_overwrite_fails_before_any_output(
+    tmp_path,
+) -> None:
+    """FR-054 step 3 / US4.7c: the sweep covers every operand before the first one streams.
+
+    Only the *second* of three operands resolves to its own output path. The run must fail
+    before the first operand's output file has been created, which is the whole point of
+    checking every operand up front rather than discovering the collision in turn.
+    """
+    first = b"first jane@example.com\n"
+    second = b"second 10.0.0.7\n"
+    third = b"third a@b.io\n"
+    write_input(tmp_path, "a/one.log", first)
+    write_input(tmp_path, "two.log", second)  # `--out-dir .` makes this its own output
+    write_input(tmp_path, "b/three.log", third)
+
+    stdout, stderr, status = run_cli(
+        "--out-dir", ".", "a/one.log", "two.log", "b/three.log", cwd=tmp_path
+    )
+
+    assert status == 2
+    assert b"two.log" in stderr, stderr
+    assert b"overwrite" in stderr, stderr
+    assert stdout == b"", "no summary line"
+    assert not (tmp_path / "one.log").exists(), (
+        "the first operand's output file must not have been created"
+    )
+    assert not (tmp_path / "three.log").exists()
+    # No input file was modified.
+    assert (tmp_path / "a" / "one.log").read_bytes() == first
+    assert (tmp_path / "two.log").read_bytes() == second
+    assert (tmp_path / "b" / "three.log").read_bytes() == third
+    assert_no_traceback(stderr)
+
