+
+def _setup_fail_unreadable_file(tmp_path) -> tuple[tuple[str, ...], bytes]:
+    write_input(tmp_path, "app.log", b"user jane@example.com\n")
+    return ("--count", "--out-dir", "clean", "app.log", "missing.log"), b""
+
+
+def _setup_fail_missing_option_value(tmp_path) -> tuple[tuple[str, ...], bytes]:
+    return ("--out-dir",), b""
+
+
+SUCCEEDING = [
+    _setup_success_plain,
+    _setup_success_two_files,
+    _setup_success_empty_input,
+    _setup_success_nested_dir,
+]
+
+FAILING = [
+    _setup_fail_no_operand,
+    _setup_fail_dir_is_a_file,
