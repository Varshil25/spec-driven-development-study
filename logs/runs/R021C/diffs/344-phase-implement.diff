+    return ("--count", "--out-dir", ".", "app.log"), b"output file for "
+
+
+OUTPUT_SIDE_DIAGNOSTICS = [
+    _setup_diag_dir_unusable,
+    _setup_diag_output_file_unusable,
+    _setup_diag_collision,
+]
+
+
+@pytest.mark.parametrize(
+    "setup", OUTPUT_SIDE_DIAGNOSTICS, ids=[fn.__name__ for fn in OUTPUT_SIDE_DIAGNOSTICS]
+)
+def test_fr048_every_output_side_failure_reports_one_error_line_and_exits_two(
+    tmp_path, setup
+) -> None:
+    """FR-048 / FR-049: all three `is_stdout=False` messages reach stderr in their fixed form.
+
+    This is the generalised handler checked end to end, over each of the three message
+    shapes `contracts/cli.md` fixes: one `logredact: error: ` line and nothing else on
+    stderr, no summary line, no tally even with `--count`, and exit 2.
+
+    That standard output is *not* silenced on this path is observable only indirectly, which
+    is worth being explicit about: the evidence is the absence of `Exception ignored` text,
+    which is what a shutdown flush of a broken `sys.stdout` would produce. Nothing is
+    written to stdout before an output-side failure, so there is no truncated stream to
+    inspect.
+    """
+    argv, expected_form = setup(tmp_path)
+    stdout, stderr, status = run_cli(*argv, cwd=tmp_path)
+
+    assert status == 2
+    assert stderr.startswith(b"logredact: error: " + expected_form), stderr
+    assert stderr.count(b"\n") == 1, stderr
+    assert stdout == b"", "no summary line and no redacted content"
+    assert b"emails=" not in stderr, "no tally line, despite --count"
+    assert_no_traceback(stderr)
