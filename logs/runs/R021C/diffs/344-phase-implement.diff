+"""Nothing else changed: FR-052, FR-053, SC-012, and SC-013.
+
+Feature 002 adds a fourth redaction category and an output-folder mode. This module is the
+evidence for the other half of that claim — that the standard-output path is otherwise
+exactly what feature 001 delivered.
+
+**The output-folder option is deliberately absent from this entire module.** FR-052 is a
+statement about runs that do not use it, so a run here that passed it would not be testing
+the requirement. Every invocation below is a plain feature-001 invocation.
+
+Two of the four criteria are demonstrations rather than assertions, which is what SC-012
+asks for: the set of probes whose output now differs is *computed from the run* and then
+constrained, instead of being written down by hand and checked.
+"""
+
+from __future__ import annotations
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+from conftest import cli_env, run_cli
+
+FIXTURES = Path(__file__).resolve().parent / "fixtures"
+
+
+def assert_no_traceback(stderr: bytes) -> None:
+    """No failure path may emit a stack trace or other unhandled-error text."""
+    assert b"Traceback" not in stderr, stderr
+    assert b"Exception ignored" not in stderr, stderr
+
+
+# --------------------------------------------------------------------------------------
+# FR-052: the standard-output path, replayed
+# --------------------------------------------------------------------------------------
+
+
+def test_fr052_multiple_operands_still_concatenate_in_command_line_order(tmp_path) -> None:
+    """FR-052 / FR-004: one concatenated stream on stdout, in operand order, unchanged."""
+    first = tmp_path / "a.log"
+    second = tmp_path / "b.log"
+    first.write_bytes(b"first 1.1.1.1\n")
+    second.write_bytes(b"second a@b.io\n")
+
+    forward, stderr, status = run_cli(str(first), str(second))
+    reverse, _, reverse_status = run_cli(str(second), str(first))
+
+    assert forward == b"first [IP]\nsecond [EMAIL]\n"
+    assert reverse == b"second [EMAIL]\nfirst [IP]\n"
+    assert stderr == b""
+    assert status == reverse_status == 0
+
+
+def test_fr052_standard_input_is_still_the_default_source() -> None:
+    """FR-052 / FR-002: with no operand, stdin is read and stdout carries the result."""
+    stdout, stderr, status = run_cli(stdin=b"user jane@example.com\n")
+    assert stdout == b"user [EMAIL]\n"
+    assert stderr == b""
+    assert status == 0
+
+
+#: Large enough that stdout's block buffer forces real writes while the reader is closing.
+EARLY_CLOSE_LINES = 200_000
+
+
+def _run_into_a_closing_reader(*args: str, tmp_path) -> tuple[bytes, bytes, int]:
+    """Run the tool with its stdout piped into `head -1`; return the tool's own result."""
+    body = b"".join(b"%d a@b.io\n" % n for n in range(1, EARLY_CLOSE_LINES + 1))
+    source = tmp_path / "big.log"
+    source.write_bytes(body)
+
+    reader = subprocess.Popen(
+        ["head", "-1"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
+    )
+    assert reader.stdin is not None and reader.stdout is not None
+    tool = subprocess.Popen(
+        [sys.executable, "-m", "logredact", *args, str(source)],
+        stdin=subprocess.DEVNULL,
+        stdout=reader.stdin,
+        stderr=subprocess.PIPE,
+        env=cli_env(),
+    )
+    reader.stdin.close()
+    tool_stderr = tool.stderr.read() if tool.stderr else b""
+    tool.wait()
+    reader_stdout = reader.stdout.read()
+    reader.wait()
+    return reader_stdout, tool_stderr, tool.returncode
+
+
+def test_fr052_a_failed_write_to_standard_output_reports_the_unchanged_diagnostic(
+    tmp_path,
+) -> None:
+    """FR-052 / FR-031a: byte-exact stderr, still `failed writing to standard output`.
+
+    The generalisation of the output-error channel for this feature moved this message from
+    a hard-coded string in the handler onto the exception. The text is asserted here in
+    full, because FR-052 fixes it: a downstream consumer matching on it must not break.
+    """
+    reader_stdout, stderr, status = _run_into_a_closing_reader(tmp_path=tmp_path)
+
+    assert reader_stdout == b"1 [EMAIL]\n"
+    assert status == 2, f"a truncated run must never exit 0 (got {status})"
+    assert stderr == b"logredact: error: failed writing to standard output\n"
+    assert_no_traceback(stderr)
+
+
+def test_fr031a_a_failed_write_still_suppresses_the_tally(tmp_path) -> None:
+    """FR-031a / FR-052: no tally line even with `--count`, and still exit 2."""
+    _, stderr, status = _run_into_a_closing_reader("--count", tmp_path=tmp_path)
+    assert status == 2
+    assert stderr == b"logredact: error: failed writing to standard output\n"
+    assert b"emails=" not in stderr, stderr
+    assert_no_traceback(stderr)
+
+
+def test_fr052_the_exit_status_is_still_only_ever_zero_or_two(tmp_path) -> None:
+    """FR-052: status 1 is never produced on the standard-output path."""
+    readable = tmp_path / "a.log"
+    readable.write_bytes(b"a@b.io\n")
+    missing = str(tmp_path / "missing.log")
+    invocations = [
+        ([], b"a@b.io\n"),
+        (["--count"], b"call +14155552671 now\n"),
+        ([str(readable)], b""),
+        (["--count", str(readable)], b""),
+        ([str(readable), missing], b""),
+        ([missing], b""),
+        (["--nope"], b""),
+        (["--help"], b""),
+        ([str(tmp_path)], b""),  # a directory is an unreadable source, not a crash
+    ]
+    for argv, stdin in invocations:
+        _, stderr, status = run_cli(*argv, stdin=stdin)
+        assert status in (0, 2), f"{argv} exited {status}"
+        assert_no_traceback(stderr)
+
+
+# --------------------------------------------------------------------------------------
+# FR-053 / SC-013: a corpus with no `+` character is byte-identical
+# --------------------------------------------------------------------------------------
+
+
+def test_sc013_a_corpus_with_no_plus_character_is_byte_identical_to_the_golden_capture() -> None:
+    """FR-053 / SC-013: identical bytes before and after this feature, in 100% of cases.
+
+    `tests/fixtures/no_plus.expected` was captured by running the tool over
+    `tests/fixtures/no_plus.log` while `src/logredact/` was still unmodified, and committed.
+    It is the "before" side of the comparison, so this is a genuine before/after check
+    rather than a restatement of current behaviour.
+    """
+    source = FIXTURES / "no_plus.log"
+    golden = (FIXTURES / "no_plus.expected").read_bytes()
+
+    assert b"+" not in source.read_bytes(), "the corpus must contain no `+` character"
+
+    stdout, stderr, status = run_cli(str(source))
+
+    assert status == 0
+    assert stderr == b""
+    assert stdout == golden, "output over a no-`+` corpus must not have moved"
+
+
+def test_fr053_the_no_plus_corpus_still_exercises_all_three_existing_categories() -> None:
+    """FR-053: a corpus that redacted nothing would make SC-013 vacuous."""
+    golden = (FIXTURES / "no_plus.expected").read_bytes()
+    assert golden.count(b"[EMAIL]") > 0
+    assert golden.count(b"[IP]") > 0
+    assert golden.count(b"[CARD]") > 0
+
+
+# --------------------------------------------------------------------------------------
+# SC-012: the complete list of differing input shapes, computed rather than asserted
+# --------------------------------------------------------------------------------------
+
+#: Probes drawn from the feature-001 acceptance scenarios and look-alike tables, each
+#: paired with the standard output feature 001 produced for it. The last two entries are
+#: the only ones carrying a `+` followed by 8 to 15 digits.
+FEATURE_001_PROBES: list[tuple[bytes, bytes]] = [
+    (b"user jane@example.com\n", b"user [EMAIL]\n"),
+    (b"user jane@example.com from 10.0.0.7\n", b"user [EMAIL] from [IP]\n"),
+    (
+        b"paid with 4111 1111 1111 1111, ref 1234567890123\n",
+        b"paid with [CARD], ref 1234567890123\n",
+    ),
+    (b"a@b.io 1.2.3.4\n", b"[EMAIL] [IP]\n"),
+    (b"a@b.io\r\nnext\r\n", b"[EMAIL]\r\nnext\r\n"),
+    (b"before\rafter a@b.io\n", b"before\rafter [EMAIL]\n"),
+    (b"first\nlast a@b.io", b"first\nlast [EMAIL]"),
+    (b"mail \xff jane@example.com\n", b"mail \xff [EMAIL]\n"),
+    (b"\xff\xfe\x80 plain\n", b"\xff\xfe\x80 plain\n"),
+    (b"4111 1111 \xff1111 1111\n", b"4111 1111 \xff1111 1111\n"),
+    (b"nothing here\n", b"nothing here\n"),
+    (b"a@b.io c@d.io e@f.io 1.2.3.4\n", b"[EMAIL] [EMAIL] [EMAIL] [IP]\n"),
+    (b"999.1.1.1 256.1.1.1\n", b"999.1.1.1 256.1.1.1\n"),
+    (b"1.2.3.4.5 1.2.3 12345.1.1.1\n", b"1.2.3.4.5 1.2.3 12345.1.1.1\n"),
+    (b"jane@localhost jane@example\n", b"jane@localhost jane@example\n"),
+    (b"admin@1.2.3.4 admin@999.1.1.1\n", b"[EMAIL] admin@999.1.1.1\n"),
+    (b"already: [EMAIL] [IP] [CARD]\n", b"already: [EMAIL] [IP] [CARD]\n"),
+    (b"2026-11-20T06:34:01 build=1.2.3 pid=4211\n", b"2026-11-20T06:34:01 build=1.2.3 pid=4211\n"),
+    # `+` present, but never as a `+` followed by 8 to 15 digits:
+    (b"jane.doe+test@mail.example.com\n", b"[EMAIL]\n"),
+    (b"+1234567\n", b"+1234567\n"),
+    (b"+4111111111111111\n", b"+[CARD]\n"),
+    (b"+1234567890123456\n", b"+1234567890123456\n"),
+    # The one differing shape (SC-012):
+    (b"call +14155552671 now\n", b"call +14155552671 now\n"),
+    (b"+4111111111119\n", b"+[CARD]\n"),
+]
+
+#: The shape SC-012 names as the one permitted source of difference. Spelled out here
+#: independently of `src/`, so this test cannot agree with a wrong implementation.
+PHONE_SHAPE = re.compile(rb"\+[0-9]{8,15}(?![0-9])")
+
+
+def test_sc012_the_only_probes_whose_output_differs_are_those_carrying_a_phone_number() -> None:
+    """SC-012: the differing set is computed from the run, then constrained.
+
+    Every probe is replayed and its current stdout compared against what feature 001
+    produced. Nothing says in advance which probes are expected to differ; the set is
+    collected and only then checked against the single shape SC-012 permits. A rule that
+    changed the output of, say, an email address or a card number would land in this set and
+    fail the test, which is what "demonstrated rather than asserted" means.
+    """
+    differing: list[bytes] = []
+    for probe, feature_001_stdout in FEATURE_001_PROBES:
+        stdout, stderr, status = run_cli(stdin=probe)
+        assert status == 0, probe
+        assert stderr == b"", probe
+        if stdout != feature_001_stdout:
+            differing.append(probe)
+
+    unexplained = [probe for probe in differing if not PHONE_SHAPE.search(probe)]
+    assert unexplained == [], (
+        f"these probes changed for a reason SC-012 does not document: {unexplained}"
+    )
+    assert differing, "the probe table must contain at least one differing shape"
+
+    # And the converse, so the claim is two-sided: every probe carrying the shape is in the
+    # differing set. Otherwise a tool that redacted nothing at all would also pass.
+    missed = [
+        probe
+        for probe, _ in FEATURE_001_PROBES
+        if PHONE_SHAPE.search(probe) and probe not in differing
+    ]
+    assert missed == [], f"these probes carry a phone number but did not change: {missed}"
+
+
+def test_sc012_the_tally_line_is_the_one_other_documented_difference() -> None:
+    """SC-012 / FR-053: the tally gained a field and changed in no other way.
+
+    Asserted as a transformation of feature 001's line rather than as a fresh literal: the
+    new line must be the old line with ` phones=N` inserted before the newline, which is
+    precisely "the three existing fields are not disturbed".
+    """
+    for probe, feature_001_tally in [
+        (b"a@b.io 1.2.3.4\n", b"emails=1 ips=1 cards=0\n"),
+        (b"nothing here\n", b"emails=0 ips=0 cards=0\n"),
+        (b"a@b.io c@d.io e@f.io 1.2.3.4\n", b"emails=3 ips=1 cards=0\n"),
+        (b"paid with 4111 1111 1111 1111\n", b"emails=0 ips=0 cards=1\n"),
+    ]:
+        _stdout, stderr, status = run_cli("--count", stdin=probe)
+        assert status == 0, probe
+        assert stderr == feature_001_tally[:-1] + b" phones=0\n", probe
+
+    # With a phone number present the added field carries a non-zero figure, which is the
+    # only way the three existing fields could be read as having moved. They have not.
+    _stdout, stderr, status = run_cli("--count", stdin=b"a@b.io +442071838750\n")
+    assert status == 0
+    assert stderr == b"emails=1 ips=0 cards=0" + b" phones=1\n"
