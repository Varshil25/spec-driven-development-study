+    (tmp_path / "notadir").write_bytes(b"")
+    return ("--count", "--out-dir", "notadir", "app.log"), b"cannot use output directory "
+
+
+def _setup_diag_output_file_unusable(tmp_path) -> tuple[tuple[str, ...], bytes]:
+    write_input(tmp_path, "app.log", b"user jane@example.com\n")
+    (tmp_path / "clean" / "app.log").mkdir(parents=True)
+    return ("--count", "--out-dir", "clean", "app.log"), b"cannot write output file "
+
+
+def _setup_diag_collision(tmp_path) -> tuple[tuple[str, ...], bytes]:
