+@pytest.mark.slow
+@requires_fork
+def test_sc018_out_dir_memory_is_bounded_by_the_longest_line_not_by_the_input(tmp_path) -> None:
+    """SC-018: peak resident memory grows neither with total input size nor with operand count.
+
+    Deselected by default (`-m "not slow"`); run it with `python3 -m pytest -m slow`.
+
+    Two runs are measured: all five operands together (over 1 GB of input in one run) and a
+    single one of those same operands. If anything accumulated per line or per output file,
+    the five-operand peak would be several times the one-operand peak and far above the
+    ceiling, because one line is supposed to be resident and one output file open at a time.
+    """
