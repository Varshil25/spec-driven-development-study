+
+
+@pytest.mark.parametrize("setup", FAILING, ids=[fn.__name__ for fn in FAILING])
+def test_sc017_no_summary_line_appears_on_an_out_dir_run_that_errors(tmp_path, setup) -> None:
+    """SC-017: `wrote ` never reaches stdout on a run that exits 2."""
