+# -- persistence and the CLI ------------------------------------------------
+
+
+def _wait_for_listening(process) -> int:
+    line = process.stdout.readline().strip()
+    assert line.startswith("listening on 127.0.0.1:"), line
+    return int(line.rsplit(":", 1)[1])
+
+
+def test_cli_prints_listening_line_and_persists_pastes(tmp_path):
+    data_dir = tmp_path / "nested" / "data"
+    environment = {**os.environ, "PYTHONPATH": SRC, "PYTHONUNBUFFERED": "1"}
+
+    def start():
+        return subprocess.Popen(
+            [sys.executable, "-m", "pastebin", "serve", "--port", "0", "--data", str(data_dir)],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            env=environment,
+        )
+
+    process = start()
+    try:
+        port = _wait_for_listening(process)
+        assert data_dir.is_dir()
+        created = Client(port).create(content="survive a restart", expires_in=600)
+    finally:
+        process.terminate()
+        process.wait(timeout=10)
+
+    process = start()
+    try:
+        port = _wait_for_listening(process)
+        status, _, paste = Client(port).json_request("GET", f"/pastes/{created['id']}")
+        assert status == 200
+        assert paste["content"] == "survive a restart"
+    finally:
+        process.terminate()
+        process.wait(timeout=10)