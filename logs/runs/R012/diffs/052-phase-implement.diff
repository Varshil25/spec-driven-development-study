+"""HTTP layer: request routing, validation and JSON responses."""
+
+from __future__ import annotations
+
+import json
+import re
+import sys
+from http import HTTPStatus
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from typing import Optional, Tuple
+from urllib.parse import unquote, urlsplit
+
+from .storage import (
+    MAX_CONTENT_BYTES,
+    MAX_EXPIRES_IN,
+    MIN_EXPIRES_IN,
+    Store,
+    to_iso,
+)
+
+#: Bodies larger than this are rejected without being read into memory.  The
+#: content limit is 64 KiB; the slack covers JSON escaping of the payload.
+MAX_BODY_BYTES = 4 * MAX_CONTENT_BYTES + 4096
+
+PASTE_PATH = re.compile(r"\A/pastes/(?P<id>[^/]+)\Z")
+PASTE_RAW_PATH = re.compile(r"\A/pastes/(?P<id>[^/]+)/raw\Z")
+
+
+class HTTPError(Exception):
+    """An error that maps directly onto a status code and JSON message."""
+
+    def __init__(self, status: HTTPStatus, message: str) -> None:
+        super().__init__(message)
+        self.status = status
+        self.message = message
+
+
+def _parse_create_request(body: bytes) -> Tuple[str, Optional[int]]:
+    """Validate a ``POST /pastes`` body, returning ``(content, expires_in)``."""
+    try:
+        payload = json.loads(body.decode("utf-8"))
+    except (ValueError, UnicodeDecodeError):
+        raise HTTPError(HTTPStatus.BAD_REQUEST, "body must be valid JSON")
+
+    if not isinstance(payload, dict):
+        raise HTTPError(HTTPStatus.BAD_REQUEST, "body must be a JSON object")
+
+    content = payload.get("content")
+    if not isinstance(content, str):
+        raise HTTPError(HTTPStatus.BAD_REQUEST, "content must be a string")
+    if len(content.encode("utf-8")) > MAX_CONTENT_BYTES:
+        raise HTTPError(
+            HTTPStatus.REQUEST_ENTITY_TOO_LARGE,
+            f"content must be at most {MAX_CONTENT_BYTES} bytes",
+        )
+
+    if "expires_in" not in payload:
+        return content, None
+
+    # Present but not a usable integer (including ``null`` and booleans) is an
+    # error: the field is optional, but only an integer is accepted for it.
+    expires_in = payload["expires_in"]
+    if isinstance(expires_in, bool) or not isinstance(expires_in, int):
+        raise HTTPError(HTTPStatus.BAD_REQUEST, "expires_in must be an integer")
+    if not MIN_EXPIRES_IN <= expires_in <= MAX_EXPIRES_IN:
+        raise HTTPError(
+            HTTPStatus.BAD_REQUEST,
+            f"expires_in must be between {MIN_EXPIRES_IN} and {MAX_EXPIRES_IN} seconds",
+        )
+    return content, expires_in
+
+
+class PasteRequestHandler(BaseHTTPRequestHandler):
+    """Routes requests for the paste API.
+
+    One instance handles every request on a single (possibly kept-alive)
+    connection, so per-request state is reset in :meth:`_dispatch`.
+    """
+
+    server_version = "pastebin/1.0"
+    protocol_version = "HTTP/1.1"
+    timeout = 30  # drop a client that stops mid-request
+
+    #: Request body, filled in by :meth:`_dispatch` before routing.
+    body: bytes = b""
+    #: True when the body was larger than :data:`MAX_BODY_BYTES` and was skipped.
+    body_oversized: bool = False
+
+    # The store is attached to the server object by :func:`make_server`.
+    @property
+    def store(self) -> Store:
+        return self.server.store  # type: ignore[attr-defined]
+
+    # -- plumbing ----------------------------------------------------------
+
+    def log_message(self, format: str, *args) -> None:  # noqa: A002
+        """Silence per-request logging so stdout/stderr stay clean."""
+
+    def _send(self, status: HTTPStatus, body: bytes, content_type: str) -> None:
+        try:
+            self._send_unguarded(status, body, content_type)
+        except (BrokenPipeError, ConnectionError):
+            # The client hung up before reading the response; nothing to do.
+            self.close_connection = True
+
+    def _send_unguarded(self, status: HTTPStatus, body: bytes, content_type: str) -> None:
+        self.send_response(status)
+        if status == HTTPStatus.NO_CONTENT:
+            # A 204 carries no body, so it gets no entity headers either.
+            self.end_headers()
+            return
+        self.send_header("Content-Type", content_type)
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        if self.command != "HEAD":
+            self.wfile.write(body)
+
+    def _send_no_content(self) -> None:
+        self._send(HTTPStatus.NO_CONTENT, b"", "")
+
+    def _send_json(self, status: HTTPStatus, payload: dict) -> None:
+        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
+        self._send(status, body, "application/json; charset=utf-8")
+
+    def _send_error_json(self, status: HTTPStatus, message: str) -> None:
+        self._send_json(status, {"error": message})
+
+    def send_error(self, code, message=None, explain=None):  # noqa: D102
+        """Make framework-level errors (bad request line, timeouts) JSON too."""
+        try:
+            status = HTTPStatus(code)
+        except ValueError:
+            status = HTTPStatus.BAD_REQUEST
+        self.close_connection = True
+        self._send_error_json(status, message or status.phrase.lower())
+
+    def _read_body(self) -> bytes:
+        """Read the request body, recording whether it was too large to read.
+
+        An over-sized body is not read at all: the unread bytes make the
+        connection unusable for a following request, so it is closed instead.
+        Routing still happens, so a path that is 404 stays 404.
+        """
+        raw_length = self.headers.get("Content-Length")
+        if raw_length is None:
+            if "chunked" in (self.headers.get("Transfer-Encoding") or "").lower():
+                self.close_connection = True
+                raise HTTPError(
+                    HTTPStatus.LENGTH_REQUIRED, "chunked request bodies are not supported"
+                )
+            return b""
+        try:
+            length = int(raw_length)
+        except ValueError:
+            length = -1
+        if length < 0:
+            # The body cannot be framed, so the connection cannot be reused.
+            self.close_connection = True
+            raise HTTPError(HTTPStatus.BAD_REQUEST, "invalid Content-Length header")
+        if length > MAX_BODY_BYTES:
+            self.body_oversized = True
+            self.close_connection = True
+            return b""
+        return self.rfile.read(length)
+
+    # -- verbs -------------------------------------------------------------
+
+    def do_POST(self) -> None:  # noqa: N802
+        self._dispatch(self._route_post)
+
+    def do_GET(self) -> None:  # noqa: N802
+        self._dispatch(self._route_get)
+
+    def do_HEAD(self) -> None:  # noqa: N802
+        self._dispatch(self._route_get)
+
+    def do_DELETE(self) -> None:  # noqa: N802
+        self._dispatch(self._route_delete)
+
+    def _dispatch(self, route) -> None:
+        # One handler instance serves every request on a keep-alive
+        # connection, so per-request state starts from a clean slate.
+        self.body = b""
+        self.body_oversized = False
+        try:
+            # Always consume the request body, even for requests that are
+            # rejected before they would look at it: bytes left unread would be
+            # parsed as the next request on a keep-alive connection.
+            self.body = self._read_body()
+            route(urlsplit(self.path).path)
+        except HTTPError as error:
+            self._send_error_json(error.status, error.message)
+        except (BrokenPipeError, ConnectionError, TimeoutError):
+            # The client went away mid-request; no response can be sent.
+            self.close_connection = True
+        except Exception:  # pragma: no cover - unexpected server-side failure
+            self._send_error_json(
+                HTTPStatus.INTERNAL_SERVER_ERROR, "internal server error"
+            )
+            raise
+
+    # -- routes ------------------------------------------------------------
+
+    def _route_post(self, path: str) -> None:
+        if path != "/pastes":
+            raise HTTPError(HTTPStatus.NOT_FOUND, "not found")
+        if self.body_oversized:
+            raise HTTPError(
+                HTTPStatus.REQUEST_ENTITY_TOO_LARGE,
+                f"content must be at most {MAX_CONTENT_BYTES} bytes",
+            )
+        content, expires_in = _parse_create_request(self.body)
+        paste = self.store.create(content, expires_in)
+        self._send_json(
+            HTTPStatus.CREATED,
+            {
+                "id": paste.id,
+                "delete_token": paste.delete_token,
+                "url": f"/pastes/{paste.id}",
+            },
+        )
+
+    def _route_get(self, path: str) -> None:
+        match = PASTE_RAW_PATH.match(path)
+        if match:
+            paste = self._lookup(match.group("id"))
+            self._send(
+                HTTPStatus.OK,
+                paste.content.encode("utf-8"),
+                "text/plain; charset=utf-8",
+            )
+            return
+
+        match = PASTE_PATH.match(path)
+        if match:
+            paste = self._lookup(match.group("id"))
+            self._send_json(
+                HTTPStatus.OK,
+                {
+                    "id": paste.id,
+                    "content": paste.content,
+                    "created_at": to_iso(paste.created_at),
+                    "expires_at": to_iso(paste.expires_at) if paste.expires_at else None,
+                },
+            )
+            return
+
+        raise HTTPError(HTTPStatus.NOT_FOUND, "not found")
+
+    def _route_delete(self, path: str) -> None:
+        match = PASTE_PATH.match(path)
+        if not match:
+            raise HTTPError(HTTPStatus.NOT_FOUND, "not found")
+        paste_id = unquote(match.group("id"))
+        outcome = self.store.delete(paste_id, self.headers.get("X-Delete-Token"))
+        if outcome == "not_found":
+            raise HTTPError(HTTPStatus.NOT_FOUND, "paste not found")
+        if outcome == "forbidden":
+            raise HTTPError(HTTPStatus.FORBIDDEN, "invalid delete token")
+        self._send_no_content()
+
+    def _lookup(self, raw_id: str):
+        paste = self.store.get(unquote(raw_id))
+        if paste is None:
+            raise HTTPError(HTTPStatus.NOT_FOUND, "paste not found")
+        return paste
+
+
+class PasteServer(ThreadingHTTPServer):
+    daemon_threads = True
+
+    def __init__(self, address, store: Store) -> None:
+        self.store = store
+        super().__init__(address, PasteRequestHandler)
+
+    def handle_error(self, request, client_address) -> None:
+        """Keep client disconnects out of the server's error output."""
+        error = sys.exc_info()[1]
+        if isinstance(error, (ConnectionError, BrokenPipeError, TimeoutError)):
+            return
+        super().handle_error(request, client_address)
+
+
+def make_server(port: int, data_dir: str, host: str = "127.0.0.1") -> PasteServer:
+    """Create (but do not start) a server bound to ``host:port``."""
+    return PasteServer((host, port), Store(data_dir))
