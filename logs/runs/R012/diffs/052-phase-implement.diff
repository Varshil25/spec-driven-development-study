+"""Command line entry point: ``python -m pastebin serve --port P --data DIR``."""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from typing import Optional, Sequence
+
+from .server import make_server
+
+HOST = "127.0.0.1"
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="python -m pastebin",
+        description="A small HTTP service for sharing text snippets.",
+    )
+    subcommands = parser.add_subparsers(dest="command", required=True)
+
+    serve = subcommands.add_parser("serve", help="run the HTTP server")
+    serve.add_argument(
+        "--port",
+        type=int,
+        required=True,
+        help=f"TCP port to listen on (bound to {HOST}; 0 picks a free port)",
+    )
+    serve.add_argument(
+        "--data",
+        required=True,
+        metavar="DIR",
+        help="directory in which pastes are stored (created if needed)",
+    )
+    return parser
+
+
+def serve(port: int, data_dir: str) -> int:
+    if not 0 <= port <= 65535:
+        print(f"error: invalid port {port}", file=sys.stderr)
+        return 2
+    try:
+        server = make_server(port, data_dir, host=HOST)
+    except OSError as error:
+        print(f"error: could not start server: {error}", file=sys.stderr)
+        return 1
+
+    with server:
+        print(f"listening on {HOST}:{server.server_address[1]}", flush=True)
+        try:
+            server.serve_forever()
+        except KeyboardInterrupt:
+            pass
+    return 0
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    args = build_parser().parse_args(argv)
+    if args.command == "serve":
+        return serve(args.port, args.data)
+    return 2  # pragma: no cover - argparse rejects unknown commands
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
