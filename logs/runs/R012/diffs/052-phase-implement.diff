@@ -0,0 +1,367 @@
+"""End-to-end tests for the pastebin service, driven over real HTTP."""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import threading
+import time
+from http.client import HTTPConnection
+from typing import Optional
+
+import pytest
+
+SRC = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src")
+sys.path.insert(0, SRC)
+
+from pastebin.server import make_server  # noqa: E402
+from pastebin.storage import MAX_CONTENT_BYTES  # noqa: E402
+
+
+class Client:
+    def __init__(self, port: int) -> None:
+        self.port = port
+
+    def request(
+        self,
+        method: str,
+        path: str,
+        body: Optional[bytes] = None,
+        headers: Optional[dict] = None,
+    ):
+        connection = HTTPConnection("127.0.0.1", self.port, timeout=10)
+        try:
+            connection.request(method, path, body=body, headers=headers or {})
+            response = connection.getresponse()
+            return response.status, dict(response.getheaders()), response.read()
+        finally:
+            connection.close()
+
+    def json_request(self, method: str, path: str, payload=None, headers=None):
+        body = None if payload is None else json.dumps(payload).encode("utf-8")
+        status, response_headers, raw = self.request(method, path, body, headers)
+        parsed = json.loads(raw) if raw else None
+        return status, response_headers, parsed
+
+    def create(self, **payload):
+        status, _, parsed = self.json_request("POST", "/pastes", payload)
+        assert status == 201, parsed
+        return parsed
+
+
+@pytest.fixture()
+def client(tmp_path):
+    server = make_server(0, str(tmp_path / "data"))
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        yield Client(server.server_address[1])
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=5)
+
+
+# -- creating and reading ---------------------------------------------------
+
+
+def test_create_returns_id_token_and_url(client):
+    created = client.create(content="hello")
+    assert set(created) == {"id", "delete_token", "url"}
+    assert created["url"] == f"/pastes/{created['id']}"
+    assert created["id"] and created["delete_token"]
+
+
+def test_get_paste_without_expiry(client):
+    created = client.create(content="hello")
+    status, _, paste = client.json_request("GET", f"/pastes/{created['id']}")
+    assert status == 200
+    assert paste["id"] == created["id"]
+    assert paste["content"] == "hello"
+    assert paste["expires_at"] is None
+    assert paste["created_at"].endswith("Z") and len(paste["created_at"]) == 20
+    assert "delete_token" not in paste
+
+
+def test_get_paste_with_expiry_has_iso_timestamps(client):
+    created = client.create(content="hello", expires_in=3600)
+    _, _, paste = client.json_request("GET", f"/pastes/{created['id']}")
+    assert paste["expires_at"] is not None
+    assert paste["expires_at"].endswith("Z")
+
+
+def test_raw_endpoint_returns_plain_text(client):
+    created = client.create(content="hello\nworld")
+    status, headers, body = client.request("GET", f"/pastes/{created['id']}/raw")
