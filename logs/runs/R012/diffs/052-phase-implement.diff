+def test_keep_alive_connection_serves_several_requests(client):
+    connection = HTTPConnection("127.0.0.1", client.port, timeout=10)
+    try:
+        ids = []
+        for index in range(5):
+            connection.request(
+                "POST",
+                "/pastes",
+                body=json.dumps({"content": f"paste {index}"}).encode(),
+            )
+            response = connection.getresponse()
+            assert response.status == 201
+            ids.append(json.loads(response.read())["id"])
+        for index, paste_id in enumerate(ids):
+            connection.request("GET", f"/pastes/{paste_id}/raw")
+            response = connection.getresponse()
+            assert response.status == 200
+            assert response.read() == f"paste {index}".encode()
+    finally:
+        connection.close()
+
+
+def test_concurrent_creates_all_get_distinct_ids(client):
+    ids = []
+    lock = threading.Lock()
+
+    def worker(index: int) -> None:
+        created = client.create(content=f"paste {index}")
+        with lock:
+            ids.append(created["id"])
+
+    threads = [threading.Thread(target=worker, args=(i,)) for i in range(20)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=15)
+    assert len(ids) == 20
+    assert len(set(ids)) == 20
+
