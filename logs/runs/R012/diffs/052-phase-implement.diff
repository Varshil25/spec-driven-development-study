@@ -0,0 +1,189 @@
+"""Filesystem-backed storage for pastes.
+
+Each paste is one JSON file named ``<id>.json`` inside the data directory, so
+pastes survive a restart of the server.  Writes go through a temporary file and
+``os.replace`` so a reader never observes a half-written paste.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import secrets
+import tempfile
+import threading
+from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
+from typing import Optional
+
+#: Pastes ids are generated by us; this pattern is also used to reject ids from
+#: request paths that could escape the data directory (e.g. ``../../etc/passwd``).
+ID_PATTERN = re.compile(r"\A[A-Za-z0-9_-]{1,64}\Z")
+
+MAX_CONTENT_BYTES = 65_536
+MIN_EXPIRES_IN = 1
+MAX_EXPIRES_IN = 2_592_000  # 30 days
+
+
+def utcnow() -> datetime:
+    """Current UTC time, truncated to whole seconds."""
+    return datetime.now(timezone.utc).replace(microsecond=0)
+
+
+def to_iso(moment: datetime) -> str:
+    """Format a datetime as ISO 8601 in UTC, e.g. ``2026-10-23T20:15:00Z``."""
+    return moment.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def from_iso(text: str) -> datetime:
+    """Parse a timestamp written by :func:`to_iso`."""
+    moment = datetime.fromisoformat(text)
+    if moment.tzinfo is None:
+        moment = moment.replace(tzinfo=timezone.utc)
+    return moment
+
+
+@dataclass(frozen=True)
+class Paste:
+    id: str
+    content: str
+    created_at: datetime
+    expires_at: Optional[datetime]
+    delete_token: str
+
+    def is_expired(self, now: Optional[datetime] = None) -> bool:
+        if self.expires_at is None:
+            return False
+        return (now or utcnow()) >= self.expires_at
+
+    def to_json(self) -> dict:
+        return {
+            "id": self.id,
+            "content": self.content,
+            "created_at": to_iso(self.created_at),
+            "expires_at": to_iso(self.expires_at) if self.expires_at else None,
+            "delete_token": self.delete_token,
+        }
+
+    @classmethod
+    def from_json(cls, raw: dict) -> "Paste":
+        expires_at = raw.get("expires_at")
+        return cls(
+            id=raw["id"],
+            content=raw["content"],
+            created_at=from_iso(raw["created_at"]),
+            expires_at=from_iso(expires_at) if expires_at else None,
+            delete_token=raw["delete_token"],
+        )
+
+
+class Store:
+    """A directory of pastes."""
+
+    def __init__(self, directory: str | os.PathLike[str]) -> None:
+        self.directory = os.path.abspath(os.fspath(directory))
+        os.makedirs(self.directory, exist_ok=True)
+        self._lock = threading.Lock()
+
+    # -- internals ---------------------------------------------------------
+
+    def _path(self, paste_id: str) -> str:
+        return os.path.join(self.directory, f"{paste_id}.json")
+
+    def _read(self, paste_id: str) -> Optional[Paste]:
+        try:
+            with open(self._path(paste_id), "r", encoding="utf-8") as handle:
+                raw = json.load(handle)
+        except FileNotFoundError:
+            return None
+        except (OSError, ValueError, KeyError):
+            # Unreadable or malformed file: behave as if the paste is absent.
+            return None
+        try:
+            return Paste.from_json(raw)
+        except (KeyError, TypeError, ValueError):
+            return None
+
+    def _unlink(self, paste_id: str) -> bool:
+        try:
+            os.unlink(self._path(paste_id))
+            return True
+        except FileNotFoundError:
+            return False
+
+    def _write(self, paste: Paste) -> None:
+        payload = json.dumps(paste.to_json(), ensure_ascii=False, indent=2)
+        descriptor, temp_path = tempfile.mkstemp(
+            dir=self.directory, prefix=f".{paste.id}.", suffix=".tmp"
+        )
+        try:
+            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
+                handle.write(payload)
+                handle.flush()
+                os.fsync(handle.fileno())
+            os.replace(temp_path, self._path(paste.id))
+        except BaseException:
+            try:
+                os.unlink(temp_path)
+            except OSError:
+                pass
+            raise
+
+    # -- public API --------------------------------------------------------
+
+    def create(self, content: str, expires_in: Optional[int] = None) -> Paste:
+        created_at = utcnow()
+        expires_at = (
+            created_at + timedelta(seconds=expires_in) if expires_in is not None else None
+        )
+        with self._lock:
+            for _ in range(10):
+                paste_id = secrets.token_urlsafe(8)
+                if not os.path.exists(self._path(paste_id)):
+                    break
+            else:  # pragma: no cover - astronomically unlikely
+                raise RuntimeError("could not allocate a unique paste id")
+            paste = Paste(
+                id=paste_id,
+                content=content,
+                created_at=created_at,
+                expires_at=expires_at,
+                delete_token=secrets.token_urlsafe(24),
+            )
+            self._write(paste)
+        return paste
+
+    def get(self, paste_id: str) -> Optional[Paste]:
+        """Return a live paste, or ``None`` if it is unknown or expired."""
+        if not ID_PATTERN.match(paste_id):
+            return None
+        with self._lock:
+            paste = self._read(paste_id)
+            if paste is None:
+                return None
+            if paste.is_expired():
+                self._unlink(paste_id)
+                return None
+            return paste
+
+    def delete(self, paste_id: str, token=[REDACTED:assigned_secret][str]) -> str:
+        """Delete a paste.
+
+        Returns ``"deleted"``, ``"not_found"`` (unknown or expired paste) or
+        ``"forbidden"`` (wrong or missing delete token).  "Not found" wins over
+        "forbidden" so a bad token cannot reveal whether a paste exists.
+        """
+        if not ID_PATTERN.match(paste_id):
+            return "not_found"
+        with self._lock:
+            paste = self._read(paste_id)
+            if paste is None:
+                return "not_found"
+            if paste.is_expired():
+                self._unlink(paste_id)
+                return "not_found"
+            if token is None or not secrets.compare_digest(token, paste.delete_token):
+                return "forbidden"
+            self._unlink(paste_id)
+            return "deleted"
