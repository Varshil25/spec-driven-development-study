+def test_expired_paste_behaves_as_missing(client):
+    created = client.create(content="ephemeral", expires_in=1)
+    status, _, _ = client.request("GET", f"/pastes/{created['id']}")
+    assert status == 200
+
+    time.sleep(1.5)
+    for path in (f"/pastes/{created['id']}", f"/pastes/{created['id']}/raw"):
+        status, _, _ = client.request("GET", path)
+        assert status == 404
+    # 404 wins over 403, and over a valid delete token.
+    status, _, _ = client.request(
+        "DELETE", f"/pastes/{created['id']}", headers={"X-Delete-Token": created["delete_token"]}
+    )
+    assert status == 404
