@@ -0,0 +1,70 @@
+"""SQLite storage for the bookmark manager.
+
+Owns the schema, the connection and every SQL statement. This module never writes to
+``sys.stdout`` or ``sys.stderr`` and never decides an exit status; that is ``cli``'s job
+(plan.md "Structure Decision").
+"""
+
+import sqlite3
+
+# Applied on every connection, so no separate initialisation step is needed (FR-003).
+# AUTOINCREMENT keeps a high-water mark in SQLite's internal sqlite_sequence table, which is
+# what stops a deleted id from being handed out again (FR-008, research.md D1).
+# No index (every read is a full ORDER BY id scan by design, research.md D3) and no UNIQUE on
+# url (duplicate URLs are allowed as distinct bookmarks).
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS bookmarks (
+    id    INTEGER PRIMARY KEY AUTOINCREMENT,
+    url   TEXT NOT NULL,
+    title TEXT NOT NULL DEFAULT '',
+    tags  TEXT NOT NULL DEFAULT ''
+)
+"""
+
+
+def connect(path):
+    """Open the store at `path`, creating the file and the table if absent (FR-002, FR-003).
+
+    The caller owns the returned connection and MUST close it (research.md D8); no connection
+    is cached at module level, so the module holds no state between calls.
+    """
+    conn = sqlite3.connect(path)
+    conn.row_factory = sqlite3.Row
+    conn.execute(SCHEMA)
+    conn.commit()
+    return conn
+
+
+def add_bookmark(conn, url, title, tags):
+    """Insert one bookmark and return the id SQLite assigned to it (FR-007, FR-008).
+
+    `tags` is already normalised (trimmed, de-duplicated, sorted, comma-joined) by the caller,
+    so the stored value is the displayed value (research.md D2).
+    """
+    cursor = conn.execute(
+        "INSERT INTO bookmarks (url, title, tags) VALUES (?, ?, ?)",
+        (url, title, tags),
+    )
+    conn.commit()
+    return cursor.lastrowid
+
+
+def list_bookmarks(conn):
+    """Return every bookmark, ordered by ascending id (FR-012).
+
+    This is the only read query in the tool: there is no WHERE, LIKE or GROUP_CONCAT, because
+    tag filtering and text search are done in Python where there are no wildcard
+    metacharacters to escape (research.md D3).
+    """
+    return conn.execute("SELECT id, url, title, tags FROM bookmarks ORDER BY id").fetchall()
+
+
+def delete_bookmark(conn, bookmark_id):
+    """Delete the bookmark with `bookmark_id` and return how many rows that removed.
+
+    The count lets the caller tell a successful removal (1) from an id that is not in the
+    store (0), which carries its own exit status (FR-017, FR-018).
+    """
+    cursor = conn.execute("DELETE FROM bookmarks WHERE id = ?", (bookmark_id,))
+    conn.commit()
+    return cursor.rowcount
