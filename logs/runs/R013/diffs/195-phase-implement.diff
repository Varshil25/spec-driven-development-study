new file mode 100644
index 0000000..4148caf
--- /dev/null
+++ b/tests/test_delete.py
@@ -0,0 +1,104 @@
+"""The ``delete`` command: FR-017, FR-018 and FR-008's id-retirement clause.
+
+Each test names the requirement it covers (constitution Principle III).
+"""
+
+import pytest
+
+
+@pytest.fixture
+def two_bookmarks(run, db_path):
+    """Bookmarks 1 and 2 in a fresh store."""
+    run("--db", db_path, "add", "https://docs.python.org", "--title", "Python docs",
+        "--tags", "python,docs")
+    run("--db", db_path, "add", "https://example.com")
+    return db_path
+
+
+def test_delete_removes_the_target_and_exits_zero(run, two_bookmarks):
+    """FR-017: the bookmark with that id is removed, status 0, stdout empty."""
+    status, out, err = run("--db", two_bookmarks, "delete", "1")
+
+    assert status == 0
+    assert out == ""
+    assert err == ""
+
+
+def test_delete_leaves_every_other_bookmark_untouched(run, two_bookmarks):
+    """FR-017: deleting one bookmark leaves all the others exactly as they were."""
+    before = run("--db", two_bookmarks, "list")[1].splitlines()
+
+    run("--db", two_bookmarks, "delete", "1")
+
+    after = run("--db", two_bookmarks, "list")[1].splitlines()
+    assert after == [line for line in before if not line.startswith("1\t")]
+    assert after == ["2\thttps://example.com\t\t"]
+
+
+def test_delete_of_an_absent_id_exits_3_and_names_the_id(run, two_bookmarks):
+    """FR-018: an id not in the store gives a stderr diagnostic naming it and status 3."""
+    status, out, err = run("--db", two_bookmarks, "delete", "42")
+
+    assert status == 3
+    assert out == ""
+    assert "42" in err
+
+
+def test_delete_of_an_absent_id_deletes_nothing(run, two_bookmarks):
+    """FR-018 (and SC-007): the listing is identical before and after a failed delete."""
+    before = run("--db", two_bookmarks, "list")[1]
+
+    assert run("--db", two_bookmarks, "delete", "42")[0] == 3
+
+    assert run("--db", two_bookmarks, "list")[1] == before
+
+
+def test_deleting_the_same_id_twice_reports_the_second_as_absent(run, two_bookmarks):
+    """FR-017, FR-018: the first delete succeeds, the repeat exits 3."""
+    assert run("--db", two_bookmarks, "delete", "1")[0] == 0
+
+    status, out, err = run("--db", two_bookmarks, "delete", "1")
+
+    assert status == 3
+    assert "1" in err
+
+
+def test_deleted_ids_are_never_reassigned(run, two_bookmarks):
+    """FR-008: after deleting every bookmark the next add gets an id above all previous ones."""
+    run("--db", two_bookmarks, "delete", "1")
+    run("--db", two_bookmarks, "delete", "2")
+
+    assert run("--db", two_bookmarks, "list")[1] == ""
+    assert run("--db", two_bookmarks, "add", "https://example.net")[1] == "3\n"
+
+
+def test_deleting_the_highest_id_still_advances_the_next_id(run, two_bookmarks):
+    """FR-008: deleting the tail row does not make SQLite hand its id out again."""
+    run("--db", two_bookmarks, "delete", "2")
+
+    assert run("--db", two_bookmarks, "add", "https://example.net")[1] == "3\n"
+
+
+@pytest.mark.parametrize("bad_id", ["two", "1.5", ""])
+def test_delete_with_a_non_integer_id_is_a_usage_error(run, two_bookmarks, bad_id):
+    """FR-006: a malformed ID is a usage error — stderr diagnostic, status 1, nothing deleted."""
+    before = run("--db", two_bookmarks, "list")[1]
+
+    status, out, err = run("--db", two_bookmarks, "delete", bad_id)
+
+    assert status == 1
+    assert out == ""
+    assert err != ""
+    assert run("--db", two_bookmarks, "list")[1] == before
+
+
+def test_delete_without_an_id_is_a_usage_error(run, two_bookmarks):
+    """FR-006: a missing required ID argument exits 1 and deletes nothing."""
+    before = run("--db", two_bookmarks, "list")[1]
+
+    status, out, err = run("--db", two_bookmarks, "delete")
+
+    assert status == 1
+    assert out == ""
+    assert err != ""
+    assert run("--db", two_bookmarks, "list")[1] == before
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..96bd2a6
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,157 @@
+"""The ``export`` command: FR-019, FR-020, FR-021, FR-022 and FR-023.
+
+Each test names the requirement it covers (constitution Principle III).
+"""
+
+import csv
+import io
+import json
+
+import pytest
+
+AWKWARD_TITLE = 'He said "hi", loudly\nand then left'
+NON_ASCII_URL = "https://例え.jp"
+NON_ASCII_TITLE = "日本語のページ — notes"
+NON_ASCII_TAGS = "日本語,ドキュメント"
+
+
+@pytest.fixture
+def collection(run, db_path):
+    """Three bookmarks: tagged, bare, and one whose title holds a comma, a quote and a newline."""
+    run("--db", db_path, "add", "https://docs.python.org", "--title", "Python docs",
+        "--tags", "python,docs")
+    run("--db", db_path, "add", "https://example.com")
+    run("--db", db_path, "add", "https://example.org", "--title", AWKWARD_TITLE,
+        "--tags", "notes")
+    return db_path
+
+
+def test_csv_export_starts_with_the_exact_header(run, collection):
+    """FR-019: line 1 is exactly the header id,url,title,tags."""
+    status, out, err = run("--db", collection, "export", "--format", "csv")
+
+    assert status == 0
+    assert out.splitlines()[0] == "id,url,title,tags"
+
+
+def test_csv_export_has_one_row_per_bookmark_in_ascending_id_order(run, collection):
+    """FR-019: one row per bookmark, ascending id, with alphabetical comma-joined tags."""
+    out = run("--db", collection, "export", "--format", "csv")[1]
+
+    rows = list(csv.DictReader(io.StringIO(out)))
+    assert [row["id"] for row in rows] == ["1", "2", "3"]
+    assert rows[0] == {
+        "id": "1",
+        "url": "https://docs.python.org",
+        "title": "Python docs",
+        "tags": "docs,python",
+    }
+    assert rows[1]["title"] == "" and rows[1]["tags"] == ""
+
+
+def test_csv_export_round_trips_values_containing_commas_quotes_and_newlines(run, collection):
+    """FR-019: standard CSV quoting means the output re-reads as the original values."""
+    out = run("--db", collection, "export", "--format", "csv")[1]
+
+    rows = list(csv.reader(io.StringIO(out)))
+    assert rows[0] == ["id", "url", "title", "tags"]
+    assert rows[3] == ["3", "https://example.org", AWKWARD_TITLE, "notes"]
+
+
+def test_json_export_is_an_array_of_objects_with_exactly_four_keys(run, collection):
+    """FR-020: a JSON array of objects keyed id, url, title, tags, in ascending id order."""
+    status, out, err = run("--db", collection, "export", "--format", "json")
+
+    assert status == 0
+    payload = json.loads(out)
+    assert isinstance(payload, list)
+    assert [entry["id"] for entry in payload] == [1, 2, 3]
+    for entry in payload:
+        assert set(entry) == {"id", "url", "title", "tags"}
+        assert isinstance(entry["id"], int) and not isinstance(entry["id"], bool)
+        assert isinstance(entry["url"], str)
+        assert isinstance(entry["title"], str)
+        assert isinstance(entry["tags"], list)
+
+
+def test_json_export_tags_are_a_sorted_array_and_empty_when_absent(run, collection):
+    """FR-020: tags is an alphabetically sorted array of strings, [] when the bookmark has none."""
+    payload = json.loads(run("--db", collection, "export", "--format", "json")[1])
+
+    assert payload[0]["tags"] == ["docs", "python"]
+    assert payload[1]["tags"] == []
+    assert payload[1]["title"] == ""
+    assert payload[2]["tags"] == ["notes"]
+
+
+def test_json_export_round_trips_awkward_title_text(run, collection):
+    """FR-020: a title containing a comma, a quote and a newline survives the round trip."""
+    payload = json.loads(run("--db", collection, "export", "--format", "json")[1])
+
+    assert payload[2]["title"] == AWKWARD_TITLE
+
+
+@pytest.mark.parametrize("bad_format", ["xml", "CSV", "yaml", ""])
+def test_export_rejects_an_unsupported_format(run, collection, bad_format):
+    """FR-021: any format other than csv or json is reported on stderr with status 1."""
+    status, out, err = run("--db", collection, "export", "--format", bad_format)
+
+    assert status == 1
+    assert out == ""
+    assert err != ""
+
+
+def test_export_without_a_format_is_rejected(run, collection):
+    """FR-021: --format is required; omitting it is a usage error on stderr with status 1."""
+    status, out, err = run("--db", collection, "export")
+
+    assert status == 1
+    assert out == ""
+    assert err != ""
+
+
+def test_csv_export_of_an_empty_store_prints_the_header_alone(run, db_path):
+    """FR-022: exporting an empty store succeeds, printing the header row only."""
+    status, out, err = run("--db", db_path, "export", "--format", "csv")
+
+    assert status == 0
+    assert out == "id,url,title,tags\n"
+
+
+def test_json_export_of_an_empty_store_prints_an_empty_array(run, db_path):
+    """FR-022: exporting an empty store succeeds, printing an empty JSON array."""
+    status, out, err = run("--db", db_path, "export", "--format", "json")
+
+    assert status == 0
+    assert json.loads(out) == []
+
+
+def test_exports_emit_non_ascii_text_literally_and_re_read_identically(run, db_path):
+    """FR-023: non-ASCII URL, title and tags are emitted literally, not escaped."""
+    run("--db", db_path, "add", NON_ASCII_URL, "--title", NON_ASCII_TITLE,
+        "--tags", NON_ASCII_TAGS)
+    expected_tags = sorted(NON_ASCII_TAGS.split(","))
+
+    csv_out = run("--db", db_path, "export", "--format", "csv")[1]
+    json_out = run("--db", db_path, "export", "--format", "json")[1]
+
+    assert NON_ASCII_TITLE in csv_out
+    assert NON_ASCII_TITLE in json_out
+    assert "\\u" not in json_out
+    csv_row = list(csv.DictReader(io.StringIO(csv_out)))[0]
+    assert csv_row["url"] == NON_ASCII_URL
+    assert csv_row["title"] == NON_ASCII_TITLE
+    assert csv_row["tags"] == ",".join(expected_tags)
+    entry = json.loads(json_out)[0]
+    assert entry["url"] == NON_ASCII_URL
+    assert entry["title"] == NON_ASCII_TITLE
+    assert entry["tags"] == expected_tags
+
+
+def test_export_failure_writes_nothing_to_stdout_and_changes_nothing(run, collection):
+    """FR-006: a rejected export leaves the store unchanged (SC-007)."""
+    before = run("--db", collection, "list")[1]
+
+    assert run("--db", collection, "export", "--format", "xml")[0] == 1
+
+    assert run("--db", collection, "list")[1] == before
diff --git a/tests/test_list_search.py b/tests/test_list_search.py
new file mode 100644
index 0000000..2a4518c
--- /dev/null
+++ b/tests/test_list_search.py
@@ -0,0 +1,176 @@
+"""Listing, tag filtering and search: FR-012…FR-016.
+
+Each test names the requirement it covers (constitution Principle III).
+"""
+
+import pytest
+
+LINE_1 = "1\thttps://docs.python.org\tPython docs\tdocs,python\n"
+LINE_2 = "2\thttps://example.com\t\t\n"
+
+
+@pytest.fixture
+def two_bookmarks(run, db_path):
+    """Bookmark 1: titled and tagged. Bookmark 2: neither title nor tags."""
+    run("--db", db_path, "add", "https://docs.python.org", "--title", "Python docs",
+        "--tags", "python,docs")
