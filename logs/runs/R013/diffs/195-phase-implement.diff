@@ -0,0 +1,148 @@
+"""The ``add`` command: FR-007, FR-008, FR-009, FR-010, FR-011 and FR-023.
+
+Each test names the requirement it covers (constitution Principle III).
+"""
+
+import pytest
+
+NON_ASCII_URL = "https://例え.jp"
+NON_ASCII_TITLE = "日本語のページ — notes"
+NON_ASCII_TAGS = "日本語,ドキュメント"
+
+
+def test_add_prints_only_the_assigned_id(run, db_path):
+    """FR-007: stdout is exactly the decimal id and a newline, and nothing else."""
+    status, out, err = run("--db", db_path, "add", "https://example.com")
+
+    assert status == 0
+    assert out == "1\n"
+    assert err == ""
+
+
+def test_add_assigns_id_one_then_strictly_increasing_ids(run, db_path):
+    """FR-008: the first bookmark in a store gets id 1 and each subsequent id increases."""
+    printed = [
+        run("--db", db_path, "add", f"https://example.com/{index}")[1] for index in range(3)
+    ]
+
+    assert printed == ["1\n", "2\n", "3\n"]
+
+
+def test_add_without_title_lists_an_empty_title_field(run, db_path):
+    """FR-010: an omitted --title is stored as the empty string and lists as an empty field."""
+    run("--db", db_path, "add", "https://example.com")
+
+    status, out, err = run("--db", db_path, "list")
+
+    assert status == 0
+    assert out == "1\thttps://example.com\t\t\n"
+
+
+def test_add_keeps_a_supplied_title(run, db_path):
+    """FR-010: a supplied --title is stored and listed verbatim."""
+    run("--db", db_path, "add", "https://docs.python.org", "--title", "Python docs")
+
+    assert run("--db", db_path, "list")[1] == "1\thttps://docs.python.org\tPython docs\t\n"
+
+
+@pytest.mark.parametrize(
+    "supplied,expected",
+    [
+        ("  python , , cli, python ", "cli,python"),
+        ("python,docs", "docs,python"),
+        ("solo", "solo"),
+        (",", ""),
+        ("", ""),
+    ],
+)
+def test_add_normalises_tags(run, db_path, supplied, expected):
+    """FR-011: tags are trimmed, empties dropped, de-duplicated and displayed alphabetically."""
+    run("--db", db_path, "add", "https://example.com", "--tags", supplied)
+
+    assert run("--db", db_path, "list")[1] == f"1\thttps://example.com\t\t{expected}\n"
+
+
+def test_add_without_tags_lists_an_empty_tags_field(run, db_path):
+    """FR-011: an omitted --tags means no tags, which lists as an empty final field."""
+    run("--db", db_path, "add", "https://example.com")
+
+    assert run("--db", db_path, "list")[1].endswith("\t\t\n")
+
+
+@pytest.mark.parametrize(
+    "bad_url",
+    ["ftp://example.com", "example.com", "", "HTTP://example.com", "HTTPS://example.com"],
+)
+def test_add_rejects_a_url_without_an_http_prefix_with_status_2(run, db_path, bad_url):
+    """FR-009: a URL not starting with literal http:// or https:// is rejected, nothing stored.
+
+    Also FR-006: the diagnostic goes to stderr, stdout stays empty, and because validation
+    precedes opening the store (research.md D4) the store file is not even created.
+    """
+    status, out, err = run("--db", db_path, "add", bad_url)
+
+    assert status == 2
+    assert out == ""
+    assert bad_url in err
+    assert "http://" in err
+    assert "https://" in err
+    assert not db_path.exists()
+
+
+def test_add_accepts_both_http_and_https(run, db_path):
+    """FR-009: the two literal accepted prefixes are both stored (status 0)."""
+    assert run("--db", db_path, "add", "http://example.com")[0] == 0
+    assert run("--db", db_path, "add", "https://example.com")[0] == 0
+
+
+def test_add_allows_duplicate_urls_as_distinct_bookmarks(run, db_path):
+    """FR-008: no deduplication — the same URL added twice gets two ids."""
+    assert run("--db", db_path, "add", "https://example.com")[1] == "1\n"
+    assert run("--db", db_path, "add", "https://example.com")[1] == "2\n"
+
+
+def test_add_reproduces_non_ascii_url_title_and_tags_exactly(run, db_path):
+    """FR-023: non-ASCII URL, title and tags are reproduced character for character."""
+    run(
+        "--db",
+        db_path,
+        "add",
+        NON_ASCII_URL,
+        "--title",
+        NON_ASCII_TITLE,
+        "--tags",
+        NON_ASCII_TAGS,
+    )
+
+    expected_tags = ",".join(sorted(NON_ASCII_TAGS.split(",")))
+    status, out, err = run("--db", db_path, "list")
+
+    assert status == 0
+    assert out == f"1\t{NON_ASCII_URL}\t{NON_ASCII_TITLE}\t{expected_tags}\n"
+
+
+def test_add_applies_no_case_folding_or_trimming_to_url_and_title(run, db_path):
+    """FR-023: no normalisation beyond the FR-011 tag trimming."""
+    url = "https://Example.COM/MiXeD/Path"
+    title = "  MiXeD Case  title  "
+    run("--db", db_path, "add", url, "--title", title)
+
+    assert run("--db", db_path, "list")[1] == f"1\t{url}\t{title}\t\n"
+
+
+def test_add_reproduces_non_ascii_text_under_a_c_locale(run_cli, db_path):
+    """FR-023: output does not depend on the process locale (research.md D7)."""
+    c_locale = {"LC_ALL": "C", "LANG": "C"}
+
+    status, out, err = run_cli(
+        "--db", db_path, "add", NON_ASCII_URL,
+        "--title", NON_ASCII_TITLE, "--tags", NON_ASCII_TAGS,
+        env_overrides=c_locale,
+    )
+    assert status == 0, err
+
+    status, out, err = run_cli("--db", db_path, "list", env_overrides=c_locale)
+
+    assert status == 0, err
+    expected_tags = ",".join(sorted(NON_ASCII_TAGS.split(",")))
+    assert out == f"1\t{NON_ASCII_URL}\t{NON_ASCII_TITLE}\t{expected_tags}\n"
diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..1476d6f
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,138 @@
+"""Invocation, store selection, persistence and failure guarantees: FR-001…FR-006.
+
+Each test names the requirement it covers (constitution Principle III).
+"""
+
+
+def test_db_option_selects_the_store(run, db_path, tmp_path):
+    """FR-002: the file given by --db PATH is used as the store."""
+    other = tmp_path / "other.db"
+
+    assert run("--db", db_path, "add", "https://example.com")[0] == 0
+
+    assert db_path.exists()
+    assert not other.exists()
+    assert run("--db", other, "list")[1] == ""
+
+
+def test_default_store_is_bookmarks_db_in_the_current_directory(run, tmp_path, monkeypatch):
+    """FR-002: with --db omitted the store is bookmarks.db in the current working directory."""
+    monkeypatch.chdir(tmp_path)
+
+    status, out, err = run("add", "https://example.com")
+
+    assert status == 0
+    assert (tmp_path / "bookmarks.db").exists()
+    assert run("list")[1] == "1\thttps://example.com\t\t\n"
+
+
+def test_store_is_created_on_first_use_with_no_initialisation_step(run, db_path):
+    """FR-003: the first command against a non-existent path succeeds and creates the file."""
+    assert not db_path.exists()
+
+    status, out, err = run("--db", db_path, "list")
+
+    assert status == 0
+    assert out == ""
+    assert db_path.exists()
+
+
+def test_bookmarks_persist_across_separate_invocations(run_cli, db_path):
+    """FR-004: a bookmark added by one process is readable by another against the same store."""
+    status, out, err = run_cli("--db", db_path, "add", "https://example.com", "--title", "Example")
+    assert (status, out) == (0, "1\n"), err
+
+    status, out, err = run_cli("--db", db_path, "list")
+
+    assert status == 0, err
+    assert out == "1\thttps://example.com\tExample\t\n"
+
+
+def test_every_successful_command_exits_zero(run, db_path):
+    """FR-005: each command that completes its requested work exits with status 0."""
+    assert run("--db", db_path, "add", "https://docs.python.org", "--tags", "docs")[0] == 0
+    assert run("--db", db_path, "list")[0] == 0
+    assert run("--db", db_path, "list", "--tag", "docs")[0] == 0
+    assert run("--db", db_path, "search", "docs")[0] == 0
+    assert run("--db", db_path, "export", "--format", "csv")[0] == 0
+    assert run("--db", db_path, "export", "--format", "json")[0] == 0
+    assert run("--db", db_path, "delete", "1")[0] == 0
+
+
+def test_a_rejected_command_reports_on_stderr_and_leaves_the_store_unchanged(run, db_path):
+    """FR-006 (and SC-007): diagnostics on stderr, empty stdout, non-zero status, no change."""
+    run("--db", db_path, "add", "https://example.com")
+    before = run("--db", db_path, "list")[1]
+
+    status, out, err = run("--db", db_path, "add", "ftp://example.com")
+
+    assert status != 0
+    assert out == ""
+    assert err != ""
+    assert run("--db", db_path, "list")[1] == before
+
+
+def test_an_unopenable_store_is_reported_with_its_path(run, tmp_path):
+    """FR-006: a store that cannot be opened produces a diagnostic naming the path, status 1."""
+    unopenable = tmp_path / "missing-directory" / "bookmarks.db"
+
+    status, out, err = run("--db", unopenable, "add", "https://example.com")
+
+    assert status == 1
+    assert out == ""
+    assert str(unopenable) in err
+
+
+def test_unreadable_store_contents_are_reported_with_the_path(run, db_path):
+    """FR-006: a file that is not a SQLite database is reported, not silently treated as empty."""
+    db_path.write_text("this is not a database\n", encoding="utf-8")
+
+    status, out, err = run("--db", db_path, "list")
+
+    assert status == 1
+    assert out == ""
+    assert str(db_path) in err
+
+
+# --- FR-001 (T035): the full command surface through the real entry point ---------------------
+
+
+def test_all_five_commands_dispatch_through_python_m_bookmarks(run_cli, db_path):
+    """FR-001: add, list, search, delete and export are all invokable as documented."""
+    status, out, err = run_cli(
+        "--db", db_path, "add", "https://docs.python.org", "--title", "Python docs",
+        "--tags", "python,docs",
+    )
+    assert (status, out) == (0, "1\n"), err
+
+    for args in (
+        ("list",),
+        ("list", "--tag", "docs"),
+        ("search", "python"),
+        ("export", "--format", "csv"),
+        ("export", "--format", "json"),
+    ):
+        status, out, err = run_cli("--db", db_path, *args)
+        assert status == 0, f"{args} -> {status}: {err}"
+        assert out != ""
+
+    status, out, err = run_cli("--db", db_path, "delete", "1")
+    assert (status, out) == (0, ""), err
+
+
+def test_an_unknown_command_or_option_fails_loudly_without_changing_the_store(run_cli, db_path):
+    """FR-001, FR-006: an unknown command or option exits non-zero and stores nothing."""
+    run_cli("--db", db_path, "add", "https://example.com")
+    before = db_path.read_bytes()
+
+    for args in (
+        ("--db", db_path, "frobnicate"),
+        ("--db", db_path, "list", "--nonsense"),
+        ("--database", db_path, "list"),
+    ):
+        status, out, err = run_cli(*args)
+        assert status != 0
+        assert out == ""
+        assert err != ""
+
+    assert db_path.read_bytes() == before
