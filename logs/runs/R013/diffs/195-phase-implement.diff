@@ -0,0 +1,62 @@
+"""Shared fixtures: a throwaway store path, an in-process runner and a subprocess runner.
+
+The in-process runner is the fast path for most assertions; the subprocess runner invokes the
+real ``python -m bookmarks`` so that exit statuses, stream separation and persistence across
+invocations are observed exactly as a user sees them (research.md D9).
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from bookmarks import cli
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+SRC = REPO_ROOT / "src"
+
+
+@pytest.fixture
+def db_path(tmp_path):
+    """Path to a store that does not exist yet, inside pytest's tmp_path."""
+    return tmp_path / "bookmarks.db"
+
+
+@pytest.fixture
+def run(capsys):
+    """Call ``cli.main(argv)`` in process; return ``(status, stdout, stderr)``."""
+
+    def _run(*args):
+        status = cli.main([str(arg) for arg in args])
+        captured = capsys.readouterr()
+        return status, captured.out, captured.err
+
+    return _run
+
+
+@pytest.fixture
+def run_cli():
+    """Run ``python -m bookmarks ...`` in a child process; return ``(status, stdout, stderr)``.
+
+    ``cwd`` defaults to the repository root. ``PYTHONPATH`` points at ``src`` absolutely so the
+    runner works whatever directory pytest was started from, and the child's output is decoded
+    as UTF-8 to match the encoding the tool pins (research.md D7).
+    """
+
+    def _run(*args, cwd=None, env_overrides=None):
+        env = dict(os.environ, PYTHONPATH=str(SRC))
+        if env_overrides:
+            env.update(env_overrides)
+        completed = subprocess.run(
+            [sys.executable, "-m", "bookmarks", *[str(arg) for arg in args]],
+            cwd=str(cwd) if cwd is not None else str(REPO_ROOT),
+            env=env,
+            capture_output=True,
+            encoding="utf-8",
+            check=False,
+        )
+        return completed.returncode, completed.stdout, completed.stderr
+
+    return _run
