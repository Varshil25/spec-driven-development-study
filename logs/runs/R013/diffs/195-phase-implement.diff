+"""Command-line interface: argument parsing, dispatch, formatting and exit statuses.
+
+This module issues no SQL (see ``storage``) and is the only place that touches
+``sys.stdout``/``sys.stderr`` or chooses an exit status.
+
+Exit statuses (contracts/cli.md, research.md D5):
+
+===== ============================================================================
+0     the requested work completed (FR-005)
+1     usage error, unsupported export format, or the store could not be used
+2     ``add`` rejected the URL's prefix (FR-009)
+3     ``delete`` was given an id that is not in the store (FR-018)
+===== ============================================================================
+"""
+
+import argparse
+import csv
+import json
+import sqlite3
+import sys
+
+from bookmarks import storage
+
+DEFAULT_DB = "bookmarks.db"
+
+
+class _Parser(argparse.ArgumentParser):
+    """An ``ArgumentParser`` whose usage errors exit 1 instead of argparse's default 2.
+
+    Statuses 2 and 3 carry the single fixed meanings in FR-009 and FR-018, so a mistyped
+    command line must not be able to produce either (research.md D5).
+    """
+
+    def error(self, message):
+        sys.stderr.write(f"{self.prog}: error: {message}\n")
+        raise SystemExit(1)
+
+
+def normalise_tags(raw):
+    """Turn a comma-separated input into the stored tags string (FR-011).
+
+    Trim each entry, drop the empty ones, keep a repeated tag once, sort by code point and
+    join with commas, so the stored value is exactly what every output format prints. An
+    omitted or comma-only input yields ``""``.
+    """
+    return ",".join(sorted({tag.strip() for tag in raw.split(",") if tag.strip()}))
+
+
+def validate_url(url):
+    """Return 0 if `url` is acceptable, else report it on stderr and return status 2 (FR-009).
+
+    A literal, case-sensitive prefix test: no parsing, no network access. Called before any
+    connection is opened, so a rejected `add` cannot create the store (research.md D4).
+    """
+    if url.startswith(("http://", "https://")):
+        return 0
+    sys.stderr.write(
+        f"error: refusing to store the URL {url!r}: "
+        "it must begin with 'http://' or 'https://'\n"
+    )
+    return 2
+
+
+def format_bookmark_line(row):
+    """Format one bookmark as four tab-separated fields: id, URL, title, tags (FR-015).
+
+    No quoting and no escaping — deliberately not ``csv.writer(delimiter="\\t")``, because the
+    documented TSV format defines no escaping (research.md D6).
+    """
+    return "\t".join([str(row["id"]), row["url"], row["title"], row["tags"]])
+
+
+def matches_tag(stored_tags, tag):
+    """Whether `stored_tags` carries `tag` as a whole tag, matched case-sensitively (FR-013).
+
+    An exact membership test rather than a SQL delimiter trick (research.md D3). A bookmark
+    with no tags matches nothing, including the empty tag, which can never be stored.
+    """
+    return bool(stored_tags) and tag in stored_tags.split(",")
+
+
+def matches_text(row, needle):
+    """Whether `needle` occurs in the bookmark's title or URL, ignoring case (FR-014).
+
+    ``str.casefold`` has no wildcard metacharacters, so the search text is matched literally,
+    and it folds Unicode rather than ASCII alone (research.md D3).
+    """
+    folded = needle.casefold()
+    return folded in row["title"].casefold() or folded in row["url"].casefold()
+
+
+def _with_store(path, work):
+    """Open the store at `path`, return ``work(conn)``, and always close the connection.
+
+    The connection is opened only after validation has passed (research.md D4) and released in
+    a ``finally`` block rather than by ``with sqlite3.connect(...)``, which commits or rolls
+    back without closing (research.md D8).
+    """
+    conn = storage.connect(path)
+    try:
+        return work(conn)
+    finally:
+        conn.close()
+
+
+def _add(args):
+    """Store one bookmark and print its id (FR-007, FR-009)."""
+    status = validate_url(args.url)
+    if status != 0:
+        return status
+
+    tags = normalise_tags(args.tags)
+    new_id = _with_store(args.db, lambda conn: storage.add_bookmark(conn, args.url, args.title, tags))
+
+    print(new_id)
+    return 0
+
+
+def _list(args):
+    """Print every bookmark, or only those carrying --tag, in ascending id order (FR-012)."""
+    for row in _with_store(args.db, storage.list_bookmarks):
+        if args.tag is None or matches_tag(row["tags"], args.tag):
+            print(format_bookmark_line(row))
+    return 0
+
+
+def _search(args):
+    """Print bookmarks whose title or URL contains TEXT, in ascending id order (FR-014)."""
+    for row in _with_store(args.db, storage.list_bookmarks):
+        if matches_text(row, args.text):
+            print(format_bookmark_line(row))
+    return 0
+
+
+def export_csv(rows, stream):
+    """Write the collection as CSV: the header row then one row per bookmark (FR-019, FR-022).
+
+    ``csv.writer`` supplies the standard quoting for values containing the delimiter, a double
+    quote or a line break, so the output re-reads as the original values. ``lineterminator``
+    overrides the module's ``\\r\\n`` default (research.md D6).
+    """
+    writer = csv.writer(stream, lineterminator="\n")
+    writer.writerow(["id", "url", "title", "tags"])
+    for row in rows:
+        writer.writerow([row["id"], row["url"], row["title"], row["tags"]])
+
+
+def export_json(rows, stream):
+    """Write the collection as a JSON array of objects (FR-020, FR-022).
+
+    ``id`` is a number, ``tags`` is the alphabetical array obtained by splitting the stored
+    string (``[]`` when it is empty), and non-ASCII characters stay literal (research.md D6).
+    """
+    payload = [
+        {
+            "id": row["id"],
+            "url": row["url"],
+            "title": row["title"],
+            "tags": row["tags"].split(",") if row["tags"] else [],
+        }
+        for row in rows
+    ]
+    json.dump(payload, stream, ensure_ascii=False, indent=2)
+    stream.write("\n")
+
+
+def _delete(args):
+    """Remove one bookmark by id, or report that the id is not in the store (FR-017, FR-018)."""
+    removed = _with_store(args.db, lambda conn: storage.delete_bookmark(conn, args.id))
+
+    if removed == 0:
+        sys.stderr.write(f"error: no bookmark with id {args.id} in {args.db!r}\n")
+        return 3
+    return 0
+
+
+def _export(args):
+    """Write the whole collection to stdout in the requested format (FR-019…FR-022)."""
+    rows = _with_store(args.db, storage.list_bookmarks)
+
+    if args.format == "csv":
+        export_csv(rows, sys.stdout)
+    elif args.format == "json":
+        export_json(rows, sys.stdout)
+    else:
+        # Unreachable: argparse restricts --format to the two choices above. Raising rather
+        # than printing nothing keeps an unreachable state loud (constitution Principle II).
+        raise ValueError(f"unsupported export format {args.format!r}")
+    return 0
+
+
+def build_parser():
+    """Build the parser for ``python -m bookmarks [--db PATH] COMMAND ...`` (FR-001, FR-002)."""
+    parser = _Parser(
+        prog="python -m bookmarks",
+        description="Manage web bookmarks stored in a single SQLite file.",
+    )
+    parser.add_argument(
+        "--db",
+        metavar="PATH",
+        default=DEFAULT_DB,
+        help=f"bookmark store to use (default: {DEFAULT_DB} in the current directory)",
+    )
+    commands = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")
+
+    add = commands.add_parser("add", help="store a bookmark and print its id")
+    add.add_argument("url", metavar="URL", help="must begin with http:// or https://")
+    add.add_argument("--title", default="", help="title to store (default: empty)")
+    add.add_argument("--tags", default="", help="comma-separated tags (default: none)")
+    add.set_defaults(handler=_add)
+
+    listing = commands.add_parser("list", help="print bookmarks in ascending id order")
+    listing.add_argument(
+        "--tag",
+        metavar="TAG",
+        default=None,
+        help="keep only bookmarks carrying TAG as a whole tag (case-sensitive)",
+    )
+    listing.set_defaults(handler=_list)
+
+    search = commands.add_parser(
+        "search", help="print bookmarks whose title or URL contains TEXT"
+    )
+    search.add_argument("text", metavar="TEXT", help="matched literally, letter case ignored")
+    search.set_defaults(handler=_search)
+
+    delete = commands.add_parser("delete", help="remove the bookmark with that id")
+    # type=int turns a non-integer ID into an argparse usage error, which _Parser reports on
+    # stderr with status 1 — never 3, which means only "that id is not in the store".
+    delete.add_argument("id", metavar="ID", type=int, help="id of the bookmark to remove")
+    delete.set_defaults(handler=_delete)
+
+    export = commands.add_parser("export", help="print the whole collection as CSV or JSON")
+    # choices turns any other format into an argparse usage error, reported on stderr with
+    # status 1 by _Parser (FR-021).
+    export.add_argument("--format", required=True, choices=["csv", "json"])
+    export.set_defaults(handler=_export)
+
+    return parser
+
+
+def main(argv=None):
+    """Run one command and return its exit status.
+
+    Arguments are parsed and validated before the store is opened, so a rejected command
+    cannot create or alter the store file (FR-006, research.md D4).
+    """
+    # Pin the output encoding so non-ASCII titles, URLs and tags survive any locale
+    # (FR-023, SC-006, research.md D7).
+    sys.stdout.reconfigure(encoding="utf-8")
+    sys.stderr.reconfigure(encoding="utf-8")
+
+    parser = build_parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        # argparse (via _Parser.error) or --help has already written to stderr/stdout;
+        # convert its SystemExit into this function's explicit status.
+        return exc.code
+
+    try:
+        return args.handler(args)
+    except (sqlite3.Error, OSError) as exc:
+        sys.stderr.write(f"error: cannot use the bookmark store {args.db!r}: {exc}\n")
+        return 1
