index 0000000..8c18016
--- /dev/null
+++ b/tests/test_routing.py
@@ -0,0 +1,133 @@
+"""Routing, the universal error shape, and path-traversal containment.
+
+Covers FR-020 (everything outside the four defined routes is ``404``), FR-022 (every error
+body is exactly ``{"error": "<message>"}``), FR-023 (hostile identifiers never escape the
+storage directory), and SC-008 (no request stops the service).
+"""
+
+import json
+
+import pytest
+
+# The catch-all table from contracts/http-api.md. 405 is deliberately never used: anything
+# outside the four defined routes is 404.
+CATCH_ALL = [
+    ("GET", "/", "undefined path"),
+    ("GET", "/pastes", "no listing route exists"),
+    ("DELETE", "/pastes", "undefined method for this path"),
+    ("PUT", "/pastes/abc", "undefined method on a defined path"),
+    ("PATCH", "/pastes/abc", "undefined method on a defined path"),
+    ("POST", "/pastes/abc", "undefined method on a defined path"),
+    ("GET", "/pastes/abc/", "trailing slash"),
+    ("GET", "/pastes//raw", "empty identifier"),
+    ("GET", "/pastes/abc/raw/extra", "raw is the only sub-resource"),
+    ("GET", "/pastes/abc/anything", "undefined sub-resource"),
+    ("OPTIONS", "/", "undefined method"),
+    ("HEAD", "/pastes", "undefined method"),
+]
+
+
+@pytest.mark.parametrize(
+    "method,path,reason", CATCH_ALL, ids=[f"{m}-{p}" for m, p, _ in CATCH_ALL]
+)
+def test_FR_020_FR_022_undefined_routes_are_404_json(service, method, path, reason):
+    """FR-020/FR-022: every undefined route or method answers 404 with a JSON error body."""
+    response = service.request(method, path)
+    assert response.status == 404, reason
+    assert response.headers["Content-Type"] == "application/json"
+    if method != "HEAD":
+        # A HEAD response legitimately carries no body to inspect; its status and
+        # Content-Type are the whole observable contract.
+        assert sorted(json.loads(response.body)) == ["error"]
+        assert json.loads(response.body)["error"]
+
+
+def test_FR_022_error_body_shape_is_exactly_one_error_key(service):
+    """FR-022: the body is exactly {"error": "<message>"} — no extra keys, message non-empty."""
+    body = json.loads(service.request("GET", "/nope").body)
+    assert list(body) == ["error"]
+    assert isinstance(body["error"], str) and body["error"].strip()
+
+
+# --- T030: FR-023 traversal cases ---------------------------------------------------------
+
+TRAVERSAL_IDS = [
+    "../../etc/passwd",
+    "%2e%2e%2fetc%2fpasswd",
+    "%2Fetc%2Fpasswd",
+    "/etc/passwd",
+    "a" * 65,  # one character over the {1,64} limit
+    "ab%00cd",  # NUL byte
+    "..",
+    ".",
+    "a.b",  # '.' is outside the allow-list alphabet
+    "a/b",
+]
+
+
+@pytest.mark.parametrize("hostile", TRAVERSAL_IDS)
+@pytest.mark.parametrize("suffix", ["", "/raw"])
+def test_FR_023_traversal_identifiers_are_404(service, hostile, suffix):
+    """FR-023: a hostile identifier is refused with 404 and never yields outside content."""
+    response = service.request("GET", f"/pastes/{hostile}{suffix}")
+    assert response.status == 404
+    assert response.headers["Content-Type"] == "application/json"
+    assert b"root:" not in response.body
+    assert sorted(json.loads(response.body)) == ["error"]
+
+
+@pytest.mark.parametrize("hostile", TRAVERSAL_IDS)
+def test_FR_023_traversal_identifiers_are_404_on_delete(service, hostile):
+    """FR-023/FR-021: a hostile identifier on DELETE is 404, never 403."""
+    response = service.request(
+        "DELETE", f"/pastes/{hostile}", headers={"X-Delete-Token": "whatever"}
+    )
+    assert response.status == 404
+
+
+def test_FR_023_hostile_identifier_writes_nothing_to_the_data_directory(service):
+    """FR-023: a refused identifier causes no filesystem access at all."""
+    before = sorted(p.name for p in service.data_dir.iterdir())
+    for hostile in TRAVERSAL_IDS:
+        service.request("GET", f"/pastes/{hostile}")
+    assert sorted(p.name for p in service.data_dir.iterdir()) == before
+
+
+# --- T058: SC-008 soak --------------------------------------------------------------------
+
+
+def test_SC_008_hostile_request_soak_leaves_service_serving(service):
+    """SC-008: the full malformed/oversized/hostile set never stops the service."""
+    # Every undefined route and method.
+    for method, path, _ in CATCH_ALL:
+        service.request(method, path)
+    # Every hostile identifier shape, on all three id-bearing routes.
+    for hostile in TRAVERSAL_IDS:
+        service.request("GET", f"/pastes/{hostile}")
+        service.request("GET", f"/pastes/{hostile}/raw")
+        service.request("DELETE", f"/pastes/{hostile}")
+    # Malformed and ill-typed creation bodies.
+    for body in ["not json", "{", "", '"hello"', "[1,2]", "null", "42", "{}"]:
+        service.request("POST", "/pastes", body=body)
+    for obj in [{"content": 1}, {"content": None}, {"content": []}, {"content": {}}, {}]:
+        service.post_json(obj)
+    for bad in [0, -1, 2_592_001, 1.5, "60", None, True]:
+        service.post_json({"content": "x", "expires_in": bad})
+    # Oversized: content over the limit, and a declared Content-Length over the ceiling.
+    service.post_json({"content": "a" * 65_537})
+    service.request(
+        "POST", "/pastes", body=b"a" * 2_000_000, headers={"Content-Type": "application/json"}
+    )
+    # A lying Content-Length larger than the ceiling, with no body sent at all.
+    service.request(
+        "POST", "/pastes", headers={"Content-Length": str(2_000_000)}, body=b""
+    )
+    # Unknown and already-deleted identifiers.
+    created = service.create(content="doomed")
+    service.delete(created["id"], created["delete_token"])
+    service.delete(created["id"], created["delete_token"])
+
+    # The service must still complete a valid round trip.
+    paste = service.create(content="still alive")
+    assert service.read(paste["id"]).status == 200
+    assert service.read_raw(paste["id"]).body == b"still alive"
