+def test_FR_028_SC_004_fifty_pastes_survive_a_restart_unchanged(launch, tmp_path):
+    """FR-028/SC-004: 50 mixed pastes restore with 100% fidelity across a restart.
+
+    Content, identifier, creation timestamp, expiry timestamp, and delete token are all
+    checked, plus a paste whose lifetime elapsed while the service was stopped.
+    """
+    data_dir = tmp_path / "pastes"
+    first = launch(data_dir=data_dir)
+
+    expected = []
+    for index in range(50):
+        content = [
+            f"plain ascii {index}",
+            f"multi-byte héllo {index} ü ß",
+            f"emoji 🌍🚀 {index}",
+            f"mixed 日本語 {index}\nline two\ttab",
+            "",
+        ][index % 5]
+        fields = {"content": content}
+        if index % 3 == 0:  # a mix of expiring and non-expiring
+            fields["expires_in"] = 2_592_000
+        created = first.create(**fields)
+        body = json.loads(first.read(created["id"]).body)
+        expected.append(
+            {
+                "id": created["id"],
+                "delete_token": created["delete_token"],
+                "content": content,
+                "created_at": body["created_at"],
+                "expires_at": body["expires_at"],
+            }
+        )
+
+    # A paste whose lifetime elapses while the service is stopped.
+    time.sleep(1.0 - (time.time() % 1.0) + 0.02)
+    doomed = first.create(content="gone by restart", expires_in=1)
+    assert first.read(doomed["id"]).status == 200
+
+    assert first.stop() is not None
+    time.sleep(1.3)  # span the doomed paste's expiry while nothing is running
+
+    second = launch(data_dir=data_dir, port=free_port())
+    assert second.port != first.port
+
+    for record in expected:
+        response = second.read(record["id"])
+        assert response.status == 200, record["id"]
+        body = json.loads(response.body)
+        assert body["id"] == record["id"]
+        assert body["content"] == record["content"]
+        assert body["created_at"] == record["created_at"]
+        assert body["expires_at"] == record["expires_at"]
+        assert second.read_raw(record["id"]).body == record["content"].encode("utf-8")
+
+    # FR-019/SC-005: the lifetime that elapsed during the downtime is honoured.
+    assert second.read(doomed["id"]).status == 404
+    assert second.delete(doomed["id"], doomed["delete_token"]).status == 404
+
+    # Every recorded delete token still authorises its own paste.
+    for record in expected:
+        assert second.delete(record["id"], record["delete_token"]).status == 204, record["id"]
+        assert second.read(record["id"]).status == 404
+
