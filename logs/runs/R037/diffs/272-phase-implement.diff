new file mode 100644
index 0000000..9e168bf
--- /dev/null
+++ b/tests/test_storage.py
@@ -0,0 +1,301 @@
+"""The storage layer, exercised directly without an HTTP server.
+
+Covers FR-002 (identifier uniqueness), FR-023 (path containment), FR-028 (durability and
+atomic publish), FR-031 (concurrent read/delete), and FR-032 (unreadable entries).
+"""
+
+import json
+import os
+import threading
+
+import pytest
+
+from pastebin import storage
+
+INVALID_IDS = [
+    "",
+    "..",
+    ".",
+    "a.b",
+    "a/b",
+    "../../etc/passwd",
+    "/etc/passwd",
+    "a" * 65,
+    "ab\x00cd",
+    "a b",
+    "a+b",
+    "a=b",
+    "a%2fb",
+    "café",
+    "\n",
+]
+
+
+def test_FR_002_create_paste_yields_distinct_ids_and_tokens(tmp_path):
+    """FR-002/FR-003: 1,000 creations produce no repeated identifier or delete token."""
+    ids = set()
+    tokens = set()
+    for _ in range(1000):
+        paste = storage.create_paste(str(tmp_path), "x")
+        ids.add(paste.id)
+        tokens.add(paste.delete_token)
+    assert len(ids) == 1000
+    assert len(tokens) == 1000
+    assert ids.isdisjoint(tokens)
+    assert len(list(tmp_path.iterdir())) == 1000
+
+
+def test_FR_002_identifier_and_token_shapes(tmp_path):
+    """FR-002/FR-003: 22-char URL-safe id, 43-char URL-safe token, drawn independently."""
+    paste = storage.create_paste(str(tmp_path), "x")
+    assert storage.is_valid_id(paste.id)
+    assert len(paste.id) == 22
+    assert len(paste.delete_token) == 43
+    assert set(paste.delete_token) <= set(
+        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
+    )
+
+
+def test_FR_028_load_paste_round_trips_every_field(tmp_path):
+    """FR-028: id, content, created_at, expires_at, and delete_token survive unchanged."""
+    content = 'héllo 🌍\nline "two"\ttab\x07bell'
+    created = storage.create_paste(str(tmp_path), content, expires_in=3600)
+    loaded = storage.load_paste(str(tmp_path), created.id)
+    assert loaded == created
+    assert loaded.content == content
+    assert loaded.expires_at == loaded.created_at + 3600
+
+    never = storage.create_paste(str(tmp_path), "")
+    assert storage.load_paste(str(tmp_path), never.id).expires_at is None
+    assert storage.load_paste(str(tmp_path), never.id).content == ""
+
+
+def test_FR_028_record_is_published_atomically_with_no_leftover_temp_file(tmp_path):
+    """FR-028: after a successful create only the final <id>.json remains."""
+    paste = storage.create_paste(str(tmp_path), "hello")
+    names = sorted(p.name for p in tmp_path.iterdir())
+    assert names == [paste.id + ".json"]
+    record = json.loads((tmp_path / f"{paste.id}.json").read_text(encoding="utf-8"))
+    assert record["version"] == storage.RECORD_VERSION
+    assert record["id"] == paste.id
+
+
+@pytest.mark.parametrize("bad", INVALID_IDS)
+def test_FR_023_record_path_refuses_every_invalid_identifier(tmp_path, bad):
+    """FR-023: record_path raises rather than composing an escaping path."""
+    with pytest.raises(ValueError):
+        storage.record_path(str(tmp_path), bad)
+    assert not storage.is_valid_id(bad)
+    assert storage.load_paste(str(tmp_path), bad) is None
+
+
+def test_FR_023_record_path_stays_inside_the_data_directory(tmp_path):
+    """FR-023/S-1: a valid identifier always composes a path directly inside the directory."""
+    path = storage.record_path(str(tmp_path), "Abc-123_xyz")
+    assert os.path.dirname(os.path.abspath(path)) == str(tmp_path)
+
+
+def test_FR_028_stray_tmp_file_is_never_loadable_as_a_paste(tmp_path):
+    """FR-028: a leftover .tmp-* file is not a paste and cannot be read as one."""
+    stray = tmp_path / ".tmp-leftover"
+    stray.write_text(
+        json.dumps(
+            {
+                "version": 1,
+                "id": ".tmp-leftover",
+                "content": "half written",
+                "created_at": 0,
+                "expires_at": None,
+                "delete_token": "t",
+            }
+        ),
+        encoding="utf-8",
+    )
+    assert storage.load_paste(str(tmp_path), ".tmp-leftover") is None
+    assert not storage.is_valid_id(".tmp-leftover")
+
+
+def test_FR_016_delete_record_reports_whether_it_removed_anything(tmp_path):
+    """FR-016: delete_record is True once and False afterwards, never raising."""
+    paste = storage.create_paste(str(tmp_path), "bye")
+    assert storage.delete_record(str(tmp_path), paste.id) is True
+    assert storage.delete_record(str(tmp_path), paste.id) is False
+    assert storage.load_paste(str(tmp_path), paste.id) is None
+
+
+# --- T049: FR-032 unreadable and unrecognised entries -------------------------------------
+
+
+def _plant_bad_entries(data_dir):
+    """Plant one of each kind of unusable entry and return their paths."""
+    stray = data_dir / "notes.txt"
+    stray.write_text("just a note an operator left here", encoding="utf-8")
+
+    bad_json = data_dir / "bbbbbbbbbbbbbbbbbbbbbb.json"
+    bad_json.write_text("{not valid json at all", encoding="utf-8")
+
+    future = data_dir / "cccccccccccccccccccccc.json"
+    future.write_text(
+        json.dumps(
+            {
+                "version": 2,
+                "id": "cccccccccccccccccccccc",
+                "content": "from a later format",
+                "created_at": 0,
+                "expires_at": None,
+                "delete_token": "t",
+            }
+        ),
+        encoding="utf-8",
+    )
+
+    mismatched = data_dir / "dddddddddddddddddddddd.json"
+    mismatched.write_text(
+        json.dumps(
+            {
+                "version": 1,
+                "id": "a-different-identifier",
+                "content": "filename disagrees",
+                "created_at": 0,
+                "expires_at": None,
+                "delete_token": "t",
+            }
+        ),
+        encoding="utf-8",
+    )
+    return [stray, bad_json, future, mismatched]
+
+
+def test_FR_032_scan_directory_reports_every_unusable_entry_on_stderr(tmp_path, capsys):
+    """FR-032: each skipped entry is reported on stderr, and the scan still completes."""
+    good = storage.create_paste(str(tmp_path), "readable")
+    planted = _plant_bad_entries(tmp_path)
+
+    storage.scan_directory(str(tmp_path))
+    captured = capsys.readouterr()
+
+    assert captured.out == "", "FR-030: diagnostics never go to stdout"
+    for path in planted:
+        assert str(path) in captured.err
+    assert captured.err.count("skipping unreadable record:") == len(planted)
+    assert good.id not in captured.err
+
+
+def test_FR_032_unusable_entries_do_not_stop_a_good_paste_being_read(tmp_path, capsys):
+    """FR-032: a readable paste stored alongside unusable entries still loads."""
+    good = storage.create_paste(str(tmp_path), "readable")
+    _plant_bad_entries(tmp_path)
+    assert storage.load_paste(str(tmp_path), good.id) == good
+
+
+@pytest.mark.parametrize(
+    "stem", ["bbbbbbbbbbbbbbbbbbbbbb", "cccccccccccccccccccccc", "dddddddddddddddddddddd"]
+)
+def test_FR_032_reading_an_unusable_record_is_a_miss_and_is_reported(tmp_path, capsys, stem):
+    """FR-032: an unusable record reads as absent and is reported on stderr."""
+    _plant_bad_entries(tmp_path)
+    assert storage.load_paste(str(tmp_path), stem) is None
+    captured = capsys.readouterr()
+    assert "skipping unreadable record:" in captured.err
+    assert captured.out == ""
+
+
+def test_FR_032_service_starts_and_serves_with_unusable_entries_present(service, capsys):
+    """FR-032: the HTTP surface answers 404 for an unusable record and 200 for a good one."""
+    good = service.create(content="readable")
+    _plant_bad_entries(service.data_dir)
+
+    assert service.read("bbbbbbbbbbbbbbbbbbbbbb").status == 404
+    assert service.read("cccccccccccccccccccccc").status == 404
+    assert service.read("dddddddddddddddddddddd").status == 404
+    assert service.read_raw("bbbbbbbbbbbbbbbbbbbbbb").status == 404
+    assert json.loads(service.read(good["id"]).body)["content"] == "readable"
+
+
+def test_FR_032_a_directory_entry_is_reported_not_crashed_on(tmp_path, capsys):
+    """FR-032: a subdirectory in the storage directory is reported and skipped."""
+    (tmp_path / "subdir.json").mkdir()
+    storage.scan_directory(str(tmp_path))
+    captured = capsys.readouterr()
+    assert "not a regular file" in captured.err
+    assert captured.out == ""
+
+
+# --- T056: FR-031 concurrency -------------------------------------------------------------
+
+
+def test_FR_031_concurrent_reads_during_a_delete_are_whole_or_absent(tmp_path):
+    """FR-031: a read racing a delete yields a complete record or a miss, never partial."""
+    content = "the whole record must come back intact " * 100
+    pastes = [storage.create_paste(str(tmp_path), content) for _ in range(40)]
+
+    observed = []
+    errors = []
+    stop = threading.Event()
+
+    def reader():
+        try:
+            while not stop.is_set():
+                for paste in pastes:
+                    loaded = storage.load_paste(str(tmp_path), paste.id)
+                    if loaded is None:
+                        observed.append(None)
+                    else:
+                        # A partially written or torn record would fail one of these.
+                        assert loaded.content == content
+                        assert loaded.id == paste.id
+                        assert loaded.delete_token == paste.delete_token
+                        observed.append(loaded.id)
+        except BaseException as exc:  # recorded and re-asserted on the main thread
+            errors.append(exc)
+
+    readers = [threading.Thread(target=reader) for _ in range(4)]
+    for thread in readers:
+        thread.start()
+    try:
+        for paste in pastes:
+            assert storage.delete_record(str(tmp_path), paste.id) is True
+    finally:
+        stop.set()
+        for thread in readers:
+            thread.join(timeout=30)
+
+    assert not errors, errors
+    assert observed, "the readers never got to run"
+    assert None in observed, "the deletes never raced a read"
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_FR_031_concurrent_creation_never_reuses_an_identifier(tmp_path):
+    """FR-031/FR-002: parallel creations in one directory never collide."""
+    created = []
+    errors = []
+
+    def creator():
+        try:
+            for _ in range(50):
+                created.append(storage.create_paste(str(tmp_path), "x").id)
+        except BaseException as exc:
+            errors.append(exc)
+
+    threads = [threading.Thread(target=creator) for _ in range(6)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=60)
+
+    assert not errors, errors
+    assert len(created) == 300
+    assert len(set(created)) == 300
+    assert len(list(tmp_path.iterdir())) == 300
+
+
+def test_FR_010_iso_z_renders_whole_second_utc_with_trailing_z():
+    """FR-010: the wire format is ...Z, never +00:00, and None becomes JSON null."""
+    assert storage.iso_z(0) == "1970-01-01T00:00:00Z"
+    assert storage.iso_z(1763596800) == "2025-11-20T00:00:00Z"
+    assert storage.iso_z(1795132800) == "2026-11-20T00:00:00Z"
+    assert storage.iso_z(None) is None
+    # isoformat() would emit "+00:00" here, which FR-010 forbids.
+    assert storage.iso_z(1795132800).endswith("Z")
+    assert "+00:00" not in storage.iso_z(1795132800)