@@ -0,0 +1,372 @@
+"""Filesystem persistence for pastes.
+
+One JSON record per paste, named ``<id>.json``, directly in the storage directory (R-006).
+There is no index, no cache, and no lock: the directory contents are the whole truth, and
+isolation comes from ``O_CREAT | O_EXCL`` creation plus atomic ``os.replace`` (R-008,
+invariant S-8).
+
+Standard library only — Constitution I.
+"""
+
+import json
+import os
+import re
+import secrets
+import sys
+import time
+from dataclasses import dataclass
+from datetime import datetime, timezone
+
+# --- T006: module constants ---------------------------------------------------------------
+
+#: On-disk record format marker. A record with any other version is skipped and reported
+#: rather than guessed at (FR-032).
+RECORD_VERSION = 1
+
+#: Maximum ``content`` size, measured on the UTF-8 encoding. Inclusive: exactly 65,536
+#: bytes is accepted (FR-005).
+CONTENT_MAX_BYTES = 65536
+
+#: ``expires_in`` bounds, both inclusive (FR-006).
+EXPIRES_IN_MIN = 1
+EXPIRES_IN_MAX = 2_592_000
+
+#: Identifier allow-list. Applied before any filesystem access, which makes ``..``, ``/``,
+#: ``%2F``, absolute paths, and NUL bytes unrepresentable (FR-023, R-007, V-10).
+ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
+
+
+# --- T007: the entity ---------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Paste:
+    """One submitted piece of text. Plain data, no behaviour (Constitution IV)."""
+
+    #: Opaque URL-safe identifier, 22 characters from ``[A-Za-z0-9_-]``.
+    id: str
+    #: The snippet text. At most ``CONTENT_MAX_BYTES`` when UTF-8 encoded; ``""`` is valid.
+    content: str
+    #: Creation moment, epoch seconds UTC, whole seconds.
+    created_at: int
+    #: Expiry moment, epoch seconds UTC. ``None`` means the paste never expires.
+    expires_at: "int | None"
+    #: 43-character URL-safe secret. Write-only: never serialised into a read response
+    #: (FR-003).
+    delete_token: str
+
+
+class _BadRecord(Exception):
+    """A storage entry exists but is not a usable paste record.
+
+    Carries the reason, which is always reported on stderr before the entry is skipped
+    (FR-032, Constitution II — the failure is converted into a *reported* error, never
+    swallowed).
+    """
+
+
+def _report_skip(path, reason):
+    """Report a skipped storage entry on stderr (FR-032, R-012)."""
+    print(f"skipping unreadable record: {path}: {reason}", file=sys.stderr, flush=True)
+
+
+# --- T008: identifier allow-list and path composition -------------------------------------
+
+
+def is_valid_id(candidate):
+    """Return whether ``candidate`` is a well-formed identifier.
+
+    An allow-list, not a sanitisation: a non-matching identifier is refused, never
+    rewritten (FR-023, R-007; Constitution II forbids coercing questionable input).
+    """
+    return isinstance(candidate, str) and ID_RE.match(candidate) is not None
+
+
+def record_path(data_dir, paste_id):
+    """Return the record path for ``paste_id`` inside ``data_dir``.
+
+    Raises ``ValueError`` for an identifier that fails the allow-list, so no caller can
+    compose a path that escapes ``data_dir`` (FR-023, invariant S-1).
+    """
+    if not is_valid_id(paste_id):
+        raise ValueError(f"invalid paste identifier: {paste_id!r}")
+    return os.path.join(data_dir, paste_id + ".json")
+
+
+# --- T009: identifier and token generation ------------------------------------------------
+
+
+def new_id():
+    """Return a fresh identifier: 128 bits, 22 URL-safe characters (FR-002, R-004)."""
+    return secrets.token_urlsafe(16)
+
+
+def new_delete_token():
+    """Return a fresh deletion token: 256 bits, 43 URL-safe characters (FR-003, R-004).
+
+    Drawn from a ``secrets`` call independent of :func:`new_id`, so neither value yields
+    the other.
+    """
+    return secrets.token_urlsafe(32)
+
+
+# --- T010: wire-format timestamps ---------------------------------------------------------
+
+
+def iso_z(ts):
+    """Render epoch seconds as ``YYYY-MM-DDTHH:MM:SSZ`` in UTC, or ``None`` for ``None``.
+
+    An explicit ``strftime`` rather than ``isoformat()``, which emits ``+00:00`` instead of
+    the required trailing ``Z`` (FR-010, R-009). ``None`` becomes JSON ``null`` on the wire.
+    """
+    if ts is None:
+        return None
+    return datetime.fromtimestamp(ts, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+# --- T011: atomic publish -----------------------------------------------------------------
+
+
+def _write_record(path, record):
+    """Publish ``record`` at ``path`` atomically.
+
+    Writes a uniquely named ``.tmp-<random>`` file in the *same* directory (so the rename
+    stays on one filesystem), flushes, ``fsync``s, then ``os.replace``s it onto ``path``.
+    A reader therefore sees either no file or the complete file — never a half-written one
+    (FR-028, invariant S-2, R-006). The temporary file is removed if any step fails.
+    """
+    directory = os.path.dirname(path) or "."
+    tmp_path = os.path.join(directory, f".tmp-{secrets.token_urlsafe(8)}")
+    try:
+        with open(tmp_path, "w", encoding="utf-8") as handle:
+            json.dump(record, handle)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(tmp_path, path)
+    except BaseException:
+        # Caught only to clean up the partial temp file, then re-raised — the
+        # "add context and re-raise" case Constitution II permits, not a swallow.
+        try:
+            os.remove(tmp_path)
+        except FileNotFoundError:
+            pass
+        raise
+
+
+# --- T012: creation -----------------------------------------------------------------------
+
+
+def create_paste(data_dir, content, expires_in=None):
+    """Store ``content`` as a new paste and return it.
+
+    The final name is reserved with ``os.open(O_CREAT | O_EXCL)`` and a fresh identifier is
+    drawn on collision, so an identifier is never reused across any run against this
+    directory — structural uniqueness rather than probabilistic (FR-002, invariant S-3,
+    R-006, Story 4 scenario 7).
+
+    ``created_at`` is truncated to whole epoch seconds before ``expires_at`` is derived from
+    it, so the rendered ``expires_at`` is exactly ``expires_in`` seconds after the rendered
+    ``created_at`` (FR-017, R-009).
+    """
+    created_at = int(time.time())
+    expires_at = None if expires_in is None else created_at + expires_in
+
+    # The reservation leaves an empty <id>.json until _write_record replaces it. A reader
+    # inside that window sees "not a paste" and answers 404, which is correct — the paste is
+    # not published yet — and invariant S-2 still holds because an empty file is never
+    # readable *as* a paste. The window is unreachable in practice: the identifier is not
+    # returned to anyone until the record is published, and the startup scan runs before the
+    # socket accepts.
+    while True:
+        paste_id = new_id()
+        path = record_path(data_dir, paste_id)
+        try:
+            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+        except FileExistsError:
+            continue
+        os.close(fd)
+        break
+
+    paste = Paste(
+        id=paste_id,
+        content=content,
+        created_at=created_at,
+        expires_at=expires_at,
+        delete_token=new_delete_token(),
+    )
+    _write_record(
+        path,
+        {
+            "version": RECORD_VERSION,
+            "id": paste.id,
+            "content": paste.content,
+            "created_at": paste.created_at,
+            "expires_at": paste.expires_at,
+            "delete_token": paste.delete_token,
+        },
+    )
+    return paste
+
+
+# --- T013: reading ------------------------------------------------------------------------
+
+
+def _is_int(value):
+    """Return whether ``value`` is a real ``int``. JSON ``true``/``false`` are not."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _read_paste(path, stem):
+    """Read and validate one record file.
+
+    Returns the :class:`Paste` on success, or ``None`` when the file does not exist — a
+    normal miss, not an error. Raises :class:`_BadRecord` when the file exists but is not a
+    usable record, so the caller can report and skip it (FR-032, invariant S-4).
+    """
+    try:
+        with open(path, "rb") as handle:
+            raw = handle.read()
+    except FileNotFoundError:
+        return None
+    except OSError as exc:
+        raise _BadRecord(f"cannot be read: {exc.strerror}") from exc
+
+    try:
+        record = json.loads(raw.decode("utf-8"))
+    except UnicodeDecodeError as exc:
+        raise _BadRecord(f"not valid UTF-8: {exc}") from exc
+    except json.JSONDecodeError as exc:
+        raise _BadRecord(f"invalid JSON: {exc}") from exc
+
+    if not isinstance(record, dict):
+        raise _BadRecord("record is not a JSON object")
+
+    version = record.get("version")
+    if not _is_int(version) or version != RECORD_VERSION:
+        raise _BadRecord(f"unrecognised record version: {version!r}")
+
+    record_id = record.get("id")
+    if record_id != stem:
+        raise _BadRecord(f"record id {record_id!r} does not match filename stem {stem!r}")
+
+    content = record.get("content")
+    if not isinstance(content, str):
+        raise _BadRecord(f"content is not a string: {type(content).__name__}")
+
+    created_at = record.get("created_at")
+    if not _is_int(created_at):
+        raise _BadRecord(f"created_at is not an integer: {created_at!r}")
+
+    expires_at = record.get("expires_at")
+    if expires_at is not None and not _is_int(expires_at):
+        raise _BadRecord(f"expires_at is neither null nor an integer: {expires_at!r}")
+
+    delete_token = record.get("delete_token")
+    if not isinstance(delete_token, str):
+        raise _BadRecord(f"delete_token is not a string: {type(delete_token).__name__}")
+
+    return Paste(
+        id=record_id,
+        content=content,
+        created_at=created_at,
+        expires_at=expires_at,
+        delete_token=delete_token,
+    )
+
+
+def is_gone(paste, now):
+    """Return whether ``paste`` has reached its expiry moment.
+
+    The boundary is contractual: a paste is readable *strictly before* ``expires_at`` and
+    gone at or after it, so ``now >= expires_at`` means gone. ``expires_at is None`` means
+    it never expires (FR-018, R-009).
+    """
+    return paste.expires_at is not None and now >= paste.expires_at
+
+
+def load_paste(data_dir, paste_id):
+    """Return the paste stored under ``paste_id``, or ``None``.
+
+    ``None`` is returned — with no filesystem access whatsoever — when the identifier fails
+    the allow-list (FR-023, V-10); when no such record exists; when the record has expired,
+    which is therefore indistinguishable from never having existed on every route
+    (FR-018, FR-019, FR-021); and when the record exists but is unusable, in which case the
+    entry is also reported on stderr (FR-032, invariant S-4).
+
+    Expiry is decided here, from the record's own absolute ``expires_at``, which is why it
+    is unaffected by restarts or by time spent not running (FR-019, invariant S-5). An
+    expired record is left on disk rather than removed as a side effect of a read: no
+    requirement asks for a sweeper, and a mutating GET would be a surprise (Principle IV).
+    """
+    if not is_valid_id(paste_id):
+        return None
+    path = record_path(data_dir, paste_id)
+    try:
+        paste = _read_paste(path, paste_id)
+    except _BadRecord as exc:
+        _report_skip(path, exc)
+        return None
+    if paste is not None and is_gone(paste, int(time.time())):
+        return None
+    return paste
+
+
+# --- T038: token authorisation ------------------------------------------------------------
+
+
+def token_matches(paste, supplied):
+    """Return whether ``supplied`` is ``paste``'s deletion token.
+
+    Compared with ``secrets.compare_digest`` rather than ``==``, which short-circuits per
+    byte and leaks a prefix oracle through response timing (FR-015, R-005). ``None`` and
+    ``""`` are ordinary non-matches: they are handed to the same constant-time comparison
+    instead of being short-circuited on a length test that would leak the stored length.
+    """
+    if not isinstance(supplied, str):
+        supplied = ""
+    return secrets.compare_digest(supplied.encode("utf-8"), paste.delete_token.encode("utf-8"))
+
+
+# --- T014: deletion -----------------------------------------------------------------------
+
+
+def delete_record(data_dir, paste_id):
+    """Remove the record for ``paste_id``. Return whether it was there to remove.
+
+    ``False`` for an absent record; every other ``OSError`` propagates rather than being
+    swallowed (FR-016, invariant S-4, Constitution II).
+    """
+    try:
+        os.remove(record_path(data_dir, paste_id))
+    except FileNotFoundError:
+        return False
+    return True
+
+
+# --- T015: startup report -----------------------------------------------------------------
+
+
+def scan_directory(data_dir):
+    """Report every unreadable or unrecognised entry in ``data_dir`` on stderr.
+
+    One pass, purely for the operator's benefit: **no index or cache is built** from it
+    (FR-032, R-008, R-012, invariant S-8). An unusable entry never blocks startup — it is
+    reported and skipped (invariant S-6).
+    """
+    with os.scandir(data_dir) as entries:
+        for entry in sorted(entries, key=lambda item: item.name):
+            path = entry.path
+            if not entry.is_file(follow_symlinks=False):
+                _report_skip(path, "not a regular file")
+                continue
+            if not entry.name.endswith(".json"):
+                _report_skip(path, "unrecognised filename (expected <id>.json)")
+                continue
+            stem = entry.name[: -len(".json")]
+            if not is_valid_id(stem):
+                _report_skip(path, f"filename stem is not a valid identifier: {stem!r}")
+                continue
+            try:
+                _read_paste(path, stem)
+            except _BadRecord as exc:
+                _report_skip(path, exc)
