+def test_FR_029_unwritable_data_directory_exits_2(launch, tmp_path):
+    """FR-029: a directory that exists but cannot be written is refused with exit 2.
+
+    This is the row `os.access(W_OK)` would get wrong, which is why the implementation
+    probes by actually writing a file (R-013).
+    """
+    data_dir = tmp_path / "readonly"
+    data_dir.mkdir()
+    undo = _make_unwritable(data_dir)
+    try:
+        service = launch(data_dir=data_dir, ready=False)
+        assert service.wait() == 2
+        assert service.stdout == ""
+        assert str(data_dir) in service.stderr
+        assert "writable" in service.stderr
+        assert READY not in service.stdout
+    finally:
+        undo()
+
