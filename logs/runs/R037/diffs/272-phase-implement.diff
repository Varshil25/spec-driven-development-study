@@ -0,0 +1,163 @@
+"""Command-line entry point: argument validation, startup, readiness, shutdown.
+
+Every startup failure prints ``pastebin: <specific message>`` to **stderr** and returns ``2``;
+stdout carries nothing but the readiness line (FR-029, FR-030, R-013). Standard library
+only — Constitution I.
+"""
+
+import argparse
+import errno
+import os
+import secrets
+import signal
+import sys
+import threading
+
+from . import server, storage
+
+#: Returned for every startup failure. ``argparse`` already uses 2 for its own usage errors,
+#: so hand-detected failures use the same status and the contract stays uniform (R-013).
+EXIT_STARTUP_FAILURE = 2
+
+PORT_MIN = 1
+PORT_MAX = 65535
+
+
+class _StartupError(Exception):
+    """Startup cannot proceed. The message is the operator-facing diagnostic."""
+
+
+def _build_parser():
+    parser = argparse.ArgumentParser(
+        prog="pastebin", description="Loopback-only HTTP service for sharing text snippets"
+    )
+    subcommands = parser.add_subparsers(dest="command", required=True)
+    serve = subcommands.add_parser("serve", help="run the HTTP service")
+    # --port is taken as a string and validated below, so the diagnostic can name the
+    # argument and the legal range rather than surfacing an argparse type error (R-013).
+    serve.add_argument("--port", required=True, help=f"TCP port to listen on ({PORT_MIN}-{PORT_MAX})")
+    serve.add_argument("--data", required=True, help="storage directory for pastes")
+    return parser
+
+
+# --- T050: --port validation --------------------------------------------------------------
+
+
+def _validate_port(raw):
+    """Return ``raw`` as a port number, or raise :class:`_StartupError`.
+
+    Validated here rather than deferred to ``bind()`` so that ``--port 99999`` names the
+    offending argument instead of surfacing a socket error (FR-029, R-013).
+    """
+    message = (
+        f"--port must be an integer between {PORT_MIN} and {PORT_MAX}, got {raw}"
+    )
+    try:
+        port = int(raw)
+    except ValueError:
+        raise _StartupError(message) from None
+    if not PORT_MIN <= port <= PORT_MAX:
+        raise _StartupError(message)
+    return port
+
+
+# --- T051: --data preparation -------------------------------------------------------------
+
+
+def _prepare_data_dir(path):
+    """Create ``path`` if needed, confirm it is a writable directory, and return it.
+
+    Writability is probed by actually creating and removing a file, not with
+    ``os.access(W_OK)``, which is advisory and reports the wrong answer under containers and
+    ACLs (FR-026, FR-029, R-013).
+    """
+    # Checked before makedirs so this row of the contract gets the diagnostic it promises
+    # ("names the path") rather than makedirs' bare "File exists".
+    if os.path.exists(path) and not os.path.isdir(path):
+        raise _StartupError(f"storage directory {path} exists but is not a directory")
+
+    try:
+        os.makedirs(path, exist_ok=True)  # creates missing parents (FR-026)
+    except OSError as exc:
+        raise _StartupError(
+            f"cannot create storage directory {path}: {exc.strerror}"
+        ) from None
+
+    if not os.path.isdir(path):
+        # Unreachable in practice; failing loudly beats proceeding on a surprise.
+        raise _StartupError(f"storage directory {path} is not a directory")
+
+    probe = os.path.join(path, f".probe-{secrets.token_urlsafe(8)}")
+    try:
+        with open(probe, "wb"):
+            pass
+    except OSError as exc:
+        raise _StartupError(
+            f"storage directory {path} is not writable: {exc.strerror}"
+        ) from None
+    finally:
+        try:
+            os.remove(probe)
+        except FileNotFoundError:
+            # The probe was never created, which the failure above already reported.
+            pass
+    return path
+
+
+# --- T052 / T054: listening, readiness, and shutdown --------------------------------------
+
+
+def _make_server(port, data_dir):
+    """Bind and listen, or raise :class:`_StartupError` naming the reason (FR-029, R-002)."""
+    try:
+        return server.make_server(port, data_dir)
+    except OSError as exc:
+        if exc.errno == errno.EADDRINUSE:
+            raise _StartupError(f"127.0.0.1:{port} is already in use") from None
+        raise _StartupError(
+            f"cannot listen on 127.0.0.1:{port}: {exc.strerror}"
+        ) from None
+
+
+def _serve(httpd, port):
+    """Announce readiness, serve until signalled, and return ``0`` on a clean shutdown."""
+
+    def request_shutdown(signum, frame):
+        # shutdown() blocks until serve_forever() returns, so it cannot be called from the
+        # signal handler itself — that runs on the main thread, which is *inside*
+        # serve_forever(), and the two would deadlock waiting for each other.
+        threading.Thread(target=httpd.shutdown, daemon=True).start()
+
+    for received in (signal.SIGINT, signal.SIGTERM):
+        signal.signal(received, request_shutdown)
+
+    # The socket is bound and listening by now (R-002), so a request sent immediately after
+    # this line is queued rather than refused. The flush matters because stdout is
+    # block-buffered when piped, which is exactly how a test reads it (FR-027).
+    print(f"listening on 127.0.0.1:{port}", flush=True)
+
+    try:
+        httpd.serve_forever()
+    finally:
+        httpd.server_close()
+    return 0
+
+
+def main(argv):
+    """Run the service. Return the process exit status (FR-025…FR-030)."""
+    # argparse reports its own usage errors on stderr and exits 2, which is the same
+    # contract as the hand-detected failures below.
+    args = _build_parser().parse_args(argv)
+
+    try:
+        port = _validate_port(args.port)
+        data_dir = _prepare_data_dir(args.data)
+        # T053: report unusable entries before announcing readiness, so an operator sees
+        # them at startup. Startup continues regardless (FR-032).
+        storage.scan_directory(data_dir)
+        httpd = _make_server(port, data_dir)
+    except _StartupError as exc:
+        print(f"pastebin: {exc}", file=sys.stderr, flush=True)
+        return EXIT_STARTUP_FAILURE
+
+    return _serve(httpd, port)
