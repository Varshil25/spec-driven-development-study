+def _failure_cases(tmp_path):
+    """Build the FR-029 table. Each entry is (id, argv, expected stderr substring)."""
+    dir_ok = str(tmp_path / "ok")
+    parent_is_file = tmp_path / "afile"
+    parent_is_file.write_text("x", encoding="utf-8")
+    return [
+        ("no-subcommand", [], "serve"),
+        ("missing-port", ["serve", "--data", dir_ok], "--port"),
+        ("missing-data", ["serve", "--port", "8080"], "--data"),
+        ("missing-both", ["serve"], "--port"),
+        ("unknown-subcommand", ["srve", "--port", "8080", "--data", dir_ok], "srve"),
+        ("port-abc", ["serve", "--port", "abc", "--data", dir_ok], "--port"),
+        ("port-zero", ["serve", "--port", "0", "--data", dir_ok], "65535"),
+        ("port-negative", ["serve", "--port", "-1", "--data", dir_ok], "65535"),
+        ("port-65536", ["serve", "--port", "65536", "--data", dir_ok], "65535"),
+        ("port-99999", ["serve", "--port", "99999", "--data", dir_ok], "65535"),
+        ("port-float", ["serve", "--port", "80.5", "--data", dir_ok], "--port"),
+        ("port-empty", ["serve", "--port", "", "--data", dir_ok], "--port"),
+        (
+            "data-parent-is-file",
+            ["serve", "--port", "8080", "--data", str(parent_is_file / "sub")],
+            str(parent_is_file / "sub"),
+        ),
+        (
+            "data-is-a-file",
+            ["serve", "--port", "8080", "--data", str(parent_is_file)],
+            "is not a directory",
