+def test_FR_029_every_startup_failure_exits_2_with_a_stderr_diagnostic(launch, tmp_path):
+    """FR-029: each bad invocation prints to stderr, writes nothing to stdout, exits 2."""
+    failures = []
+    for case_id, argv, expected in _failure_cases(tmp_path):
+        service = launch(args=argv, ready=False)
+        code = service.wait()
+        if code != 2:
+            failures.append(f"{case_id}: exit {code}, expected 2")
+        if service.stdout != "":
+            failures.append(f"{case_id}: stdout was {service.stdout!r}, expected empty")
+        if expected not in service.stderr:
+            failures.append(f"{case_id}: stderr {service.stderr!r} lacks {expected!r}")
+        if READY in service.stdout or READY in service.stderr:
+            failures.append(f"{case_id}: printed a readiness line on a failed start")
