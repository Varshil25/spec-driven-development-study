+"""Shared fixtures and HTTP helpers (R-014).
+
+Two fixtures, because the requirements split in two:
+
+* ``service`` — an in-process :class:`ThreadingHTTPServer` on a kernel-assigned port. Fast,
+  and covers the request/response requirements FR-001…FR-024.
+* ``launch`` / ``process_service`` — a real ``python -m pastebin serve`` subprocess, readiness
+  detected by reading the line from **stdout**. The only honest way to test the process-level
+  requirements FR-025…FR-032: readiness ordering, exit statuses, stream discipline, and
+  restart durability.
+"""
+
+import collections
+import email
+import json
+import os
+import socket
+import subprocess
+import sys
+import threading
+
+import pytest
+
+from pastebin import server as pastebin_server
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SRC_DIR = os.path.join(REPO_ROOT, "src")
+
+Response = collections.namedtuple("Response", "status headers body")
+
+
+# --- T025: HTTP client helper -------------------------------------------------------------
+
+
+def request(port, method, path, body=None, headers=None):
+    """Issue one request and return status, headers, and the **raw body bytes**.
+
+    Raw bytes rather than a decoded string, so tests can assert byte-for-byte content
+    fidelity (FR-012).
+    """
+    import http.client
+
+    payload = body.encode("utf-8") if isinstance(body, str) else body
+    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=15)
+    try:
+        conn.request(method, path, body=payload, headers=headers or {})
+        response = conn.getresponse()
+        return Response(response.status, response.headers, response.read())
+    finally:
+        conn.close()
+
+
+def raw_exchange(port, raw):
+    """Send ``raw`` and return every byte the server writes back, until EOF.
+
+    Returning the *whole* stream rather than one parsed response is what lets a test see
+    whether the server wrote more than one response onto a connection.
+    """
+    chunks = []
+    with socket.create_connection(("127.0.0.1", port), timeout=15) as sock:
+        sock.sendall(raw)
+        while True:
+            chunk = sock.recv(65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+    return b"".join(chunks)
+
+
+def raw_request(port, raw):
+    """Send a hand-built request so tests can omit headers ``http.client`` always adds.
+
+    Needed for the "no ``Content-Length`` at all" case of FR-004: ``http.client`` inserts
+    ``Content-Length: 0`` on a bodyless POST, so that request cannot be built through it.
+    The caller must include ``Connection: close`` for this to terminate.
+    """
+    data = raw_exchange(port, raw)
+    head, _, body = data.partition(b"\r\n\r\n")
+    lines = head.split(b"\r\n")
+    status = int(lines[0].split()[1])
+    headers = email.message_from_bytes(b"\r\n".join(lines[1:]))
+    return Response(status, headers, body)
+
+
+def free_port():
+    """Return a port that was free a moment ago.
+
+    A fixed test port is flaky in parallel runs; port 0 plus the readiness line is
+    deterministic for the in-process fixture, and this helper covers the subprocess
+    fixture, which needs the number up front (R-014).
+    """
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        return probe.getsockname()[1]
+
+
+class ServiceClient:
+    """Request helpers shared by the in-process and subprocess fixtures."""
+
+    port = None
+    data_dir = None
+
+    def request(self, method, path, body=None, headers=None):
+        return request(self.port, method, path, body=body, headers=headers)
+
+    def post_json(self, obj, path="/pastes"):
+        """POST ``obj`` serialised as JSON. ``obj`` may be any JSON value, not just a dict."""
+        return self.request(
+            "POST", path, body=json.dumps(obj), headers={"Content-Type": "application/json"}
+        )
+
+    def create(self, **fields):
+        """Create a paste through the public route and return the parsed ``201`` body."""
+        response = self.post_json(fields)
+        assert response.status == 201, (response.status, response.body)
+        return json.loads(response.body)
+
+    def read(self, paste_id):
+        """``GET /pastes/<id>`` — returns the raw :class:`Response`."""
+        return self.request("GET", f"/pastes/{paste_id}")
+
+    def read_raw(self, paste_id):
+        """``GET /pastes/<id>/raw`` — returns the raw :class:`Response`."""
+        return self.request("GET", f"/pastes/{paste_id}/raw")
+
+    def delete(self, paste_id, token=None):
+        """``DELETE /pastes/<id>``, sending ``X-Delete-Token`` only when ``token`` is given."""
+        headers = {} if token is None else {"X-Delete-Token": token}
+        return self.request("DELETE", f"/pastes/{paste_id}", headers=headers)
+
+
+# --- T023: in-process server fixture ------------------------------------------------------
+
+
+class InProcessService(ServiceClient):
+    def __init__(self, httpd, data_dir):
+        self.httpd = httpd
+        self.port = httpd.server_address[1]
+        self.data_dir = data_dir
+
+
+def _start_in_process(data_dir):
+    httpd = pastebin_server.make_server(0, str(data_dir))
+    thread = threading.Thread(target=httpd.serve_forever, daemon=True)
+    thread.start()
+    return InProcessService(httpd, data_dir), thread
+
+
+def _stop_in_process(service, thread):
+    service.httpd.shutdown()
+    service.httpd.server_close()
+    thread.join(timeout=15)
+
+
+@pytest.fixture
+def service(tmp_path):
+    """An in-process server on a kernel-assigned port, backed by ``tmp_path``."""
+    svc, thread = _start_in_process(tmp_path)
+    try:
+        yield svc
+    finally:
+        _stop_in_process(svc, thread)
+
+
+@pytest.fixture
+def in_process_factory():
+    """Factory for extra in-process servers against a chosen data directory.
+
+    FR-019 needs a *second* server over the same directory to prove expiry is decided from
+    the stored timestamp rather than from process uptime.
+    """
+    started = []
+
+    def start(data_dir):
+        svc, thread = _start_in_process(data_dir)
+        started.append((svc, thread))
+        return svc
+
+    try:
+        yield start
+    finally:
+        for svc, thread in started:
+            _stop_in_process(svc, thread)
+
+
+# --- T024: subprocess server fixture ------------------------------------------------------
+
+
+class ServiceProcess(ServiceClient):
+    """A ``python -m pastebin serve`` subprocess with both streams drained concurrently.
+
+    Both pipes are drained by threads: per-request logs go to stderr continuously, and a
+    full pipe buffer would otherwise block the server mid-test.
+    """
+
+    READY_PREFIX = "listening on 127.0.0.1:"
+
+    def __init__(self, proc, port, data_dir):
+        self.proc = proc
+        self.port = port
+        self.data_dir = data_dir
+        self.stdout_lines = []
+        self.stderr_lines = []
+        self._ready = threading.Event()
+        self._threads = [
+            threading.Thread(target=self._drain_stdout, daemon=True),
+            threading.Thread(target=self._drain_stderr, daemon=True),
+        ]
+        for thread in self._threads:
+            thread.start()
+
+    def _drain_stdout(self):
+        for line in self.proc.stdout:
+            self.stdout_lines.append(line)
+            if line.strip() == f"{self.READY_PREFIX}{self.port}":
+                self._ready.set()
+
+    def _drain_stderr(self):
+        for line in self.proc.stderr:
+            self.stderr_lines.append(line)
+
+    @property
+    def stdout(self):
+        return "".join(self.stdout_lines)
+
+    @property
+    def stderr(self):
+        return "".join(self.stderr_lines)
+
+    def wait_ready(self, timeout=20):
+        """Block until the readiness line is read from stdout (FR-027)."""
+        if not self._ready.wait(timeout):
+            self.stop()
+            raise AssertionError(
+                f"no readiness line within {timeout}s\n"
+                f"exit={self.proc.poll()}\nstdout={self.stdout!r}\nstderr={self.stderr!r}"
+            )
+        return self
+
+    def wait(self, timeout=20):
+        """Wait for exit and for both drain threads to finish. Return the exit status."""
+        code = self.proc.wait(timeout=timeout)
+        for thread in self._threads:
+            thread.join(timeout=timeout)
+        return code
+
+    def stop(self, timeout=20):
+        """Terminate if still running, then collect the exit status and both streams."""
+        if self.proc.poll() is None:
+            self.proc.terminate()
+        return self.wait(timeout)
+
+
+@pytest.fixture
+def launch():
+    """Factory launching ``python -m pastebin serve`` with ``PYTHONPATH=src``.
+
+    ``args`` overrides the argument list entirely, for the FR-029 failure cases. With
+    ``ready=True`` (the default) the call blocks until the readiness line is read, so a
+    request issued on return is guaranteed to be post-readiness.
+    """
+    started = []
+
+    def start(data_dir=None, port=None, args=None, ready=True):
+        if port is None:
+            port = free_port()
+        if args is None:
+            args = ["serve", "--port", str(port), "--data", str(data_dir)]
+        env = dict(os.environ, PYTHONPATH=SRC_DIR)
+        proc = subprocess.Popen(
+            [sys.executable, "-m", "pastebin", *args],
+            cwd=REPO_ROOT,
+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        handle = ServiceProcess(proc, port, data_dir)
+        started.append(handle)
+        if ready:
+            handle.wait_ready()
+        return handle
+
+    try:
+        yield start
+    finally:
+        for handle in started:
+            handle.stop()
+
+
+@pytest.fixture
+def process_service(launch, tmp_path):
+    """A single ready subprocess server backed by ``tmp_path``."""
+    return launch(data_dir=tmp_path)
