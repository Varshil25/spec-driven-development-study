+def _make_unwritable(data_dir):
+    """Make ``data_dir`` genuinely unwritable, returning the undo callable.
+
+    ``chmod`` is enough for an ordinary user but root ignores permission bits, so the
+    immutable attribute is used as the fallback. The result is verified by attempting a
+    real write, because an unwritable-looking directory that is actually writable would
+    make the test pass for the wrong reason.
+    """
+    import subprocess
+
+    def writable():
+        probe = data_dir / ".writable-probe"
+        try:
+            probe.touch()
+        except OSError:
+            return False
+        probe.unlink()
+        return True
+
+    data_dir.chmod(0o500)
+    if not writable():
+        return lambda: data_dir.chmod(0o700)
+
+    immutable = subprocess.run(
+        ["chattr", "+i", str(data_dir)], capture_output=True, text=True
+    )
+    if immutable.returncode == 0 and not writable():
+        return lambda: subprocess.run(["chattr", "-i", str(data_dir)], capture_output=True)
+
+    subprocess.run(["chattr", "-i", str(data_dir)], capture_output=True)
+    data_dir.chmod(0o700)
+    raise AssertionError(
+        "could not make a directory unwritable for this user: "
+        f"chmod left it writable and chattr said {immutable.stderr.strip()!r}"
+    )
+
