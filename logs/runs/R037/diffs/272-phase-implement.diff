index 0000000..efb19d9
--- /dev/null
+++ b/src/pastebin/server.py
@@ -0,0 +1,441 @@
+"""HTTP surface for the pastebin service.
+
+A single :class:`http.server.BaseHTTPRequestHandler` subclass on a
+:class:`http.server.ThreadingHTTPServer` (R-001). Every response — success or error — leaves
+through one of the four helpers below, which is how FR-022's error shape is guaranteed for
+*every* error, including the ones the base class raises on its own (R-010).
+
+Standard library only — Constitution I.
+"""
+
+import functools
+import json
+import sys
+import time
+import traceback
+import urllib.parse
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+from . import storage
+
+#: Request-body ceiling, refused on ``Content-Length`` before a single byte is read
+#: (FR-024, R-003). Chosen so JSON escaping can never make a legal 65,536-byte paste look
+#: too large: worst-case ``\uXXXX`` escaping of valid content is ~393 KiB plus framing.
+PAYLOAD_MAX_BYTES = 1_048_576
+
+#: Bounds for the lingering close after a request is refused with its body unread. The
+#: discard is chunked and thrown away, never buffered, so FR-024 still holds.
+LINGER_SECONDS = 2.0
+LINGER_CHUNK_BYTES = 65536
+LINGER_MAX_BYTES = 4 * 1024 * 1024
+
+#: JSON type names, for diagnostics that name what was actually sent (FR-022). Keyed on the
+#: exact type so ``True`` reads as "boolean" rather than "number".
+_JSON_TYPE_NAMES = {
+    type(None): "null",
+    bool: "boolean",
+    int: "number",
+    float: "number",
+    str: "string",
+    list: "array",
+    dict: "object",
+}
+
+
+def _json_type(value):
+    """Return the JSON type name of ``value``, for use in a rejection message."""
+    return _JSON_TYPE_NAMES.get(type(value), type(value).__name__)
+
+
+class _Rejected(Exception):
+    """A request that fails validation, carrying the status and the diagnostic.
+
+    An explicit error result rather than a sentinel return value a caller could mistake for
+    success (Constitution II).
+    """
+
+    def __init__(self, status, message):
+        super().__init__(message)
+        self.status = status
+        self.message = message
+
+
+class PasteHandler(BaseHTTPRequestHandler):
+    """Routes, validation, and responses for the four defined routes."""
+
+    # --- T016: handler basics -------------------------------------------------------------
+
+    #: Keep-alive is safe only because every response carries an explicit Content-Length.
+    protocol_version = "HTTP/1.1"
+    server_version = "pastebin/1.0"
+
+    #: Belt and braces for any base-class path that formats these directly rather than
+    #: going through the overridden :meth:`send_error` below (R-010, FR-022).
+    error_message_format = '{"error": "%(message)s"}'
+    error_content_type = "application/json"
+
+    def log_message(self, format, *args):
+        """Write per-request logs to stderr only.
+
+        stdout carries nothing but the readiness line, so a test can parse it unambiguously
+        (FR-027, FR-030, R-001).
+        """
+        sys.stderr.write(
+            "%s - - [%s] %s\n"
+            % (self.address_string(), self.log_date_time_string(), format % args)
+        )
+
+    # --- T017: the single response chokepoint ---------------------------------------------
+
+    def _send_bytes(self, status, body, content_type):
+        """Send ``body`` with an explicit Content-Length. The one place bytes go out."""
+        self.send_response(status)
+        if content_type is not None:
+            self.send_header("Content-Type", content_type)
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        if body:
+            self.wfile.write(body)
+
+    def _send_json(self, status, obj):
+        """Send ``obj`` as UTF-8 JSON with ``Content-Type: application/json``."""
+        self._send_bytes(status, json.dumps(obj).encode("utf-8"), "application/json")
+
+    def _send_error(self, status, message):
+        """Send exactly ``{"error": "<message>"}`` (FR-022).
+
+        ``message`` must name what was wrong specifically enough to act on. Route logic
+        never calls :meth:`send_error`; it calls this.
+        """
+        self._send_json(status, {"error": message})
+
+    def _send_text(self, content):
+        """Send ``content`` as the entire body, ``text/plain; charset=utf-8`` (FR-011)."""
+        self._send_bytes(200, content.encode("utf-8"), "text/plain; charset=utf-8")
+
+    def _send_no_content(self):
+        """Send ``204`` with no body and no Content-Type — the only such response (FR-013)."""
+        self._send_bytes(204, b"", None)
+
+    def send_error(self, code, message=None, explain=None):
+        """Route the base class's own errors through the JSON chokepoint (R-010, FR-022).
+
+        ``BaseHTTPRequestHandler`` emits an HTML page by default, which would violate
+        FR-022 for inputs the route logic never sees (an unparsable request line, an
+        over-long header block, an unsupported HTTP version).
+        """
+        self.close_connection = True
+        if message is None:
+            message = self.responses.get(code, ("error",))[0]
+        self._send_error(code, message)
+
+    # --- T018 / T019: dispatch with per-request failure containment -----------------------
+
+    def __getattr__(self, name):
+        """Hand every HTTP verb to :meth:`_dispatch`.
+
+        ``BaseHTTPRequestHandler`` looks up ``do_<METHOD>`` and answers ``501`` when it is
+        missing. FR-020 requires ``404`` for *any* undefined method — including verbs that
+        cannot be enumerated in advance — so every ``do_*`` lookup resolves here instead.
+        """
+        if name.startswith("do_"):
+            return functools.partial(self._dispatch, name[3:])
+        raise AttributeError(name)
+
+    def _dispatch(self, method):
+        """Match one of the four defined routes, or answer ``404``.
+
+        An unexpected exception is printed to stderr and answered ``500`` with the same
+        JSON error shape, and the server keeps accepting requests: the exception is
+        converted into a *reported* error, never swallowed (R-011, SC-008, Constitution II).
+        """
+        try:
+            # The query string is ignored for routing (spec edge case); percent-escapes are
+            # decoded before matching, so an encoded slash splits into extra segments and
+            # fails to match rather than sneaking through (FR-023, R-007).
+            path = urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)
+            segments = path.split("/")
+
+            if method == "POST" and segments == ["", "pastes"]:
+                self._create()
+                return
+            if segments[:2] == ["", "pastes"] and len(segments) >= 3 and segments[2]:
+                paste_id = segments[2]
+                if method == "GET" and len(segments) == 3:
+                    self._read_json(paste_id)
+                    return
+                if method == "GET" and len(segments) == 4 and segments[3] == "raw":
+                    self._read_raw(paste_id)
+                    return
+                if method == "DELETE" and len(segments) == 3:
+                    self._delete(paste_id)
+                    return
+
+            # 405 is deliberately never used: anything outside the four defined routes is
+            # 404 (FR-020, contracts/http-api.md catch-all table).
+            self._send_error(404, f"no route for {method} {path}")
+        except ConnectionError as exc:
+            # The client went away mid-exchange. Reported, not silently swallowed, but it
+            # is not an internal defect and there is no socket left to answer on.
+            self.close_connection = True
+            print(
+                f"client {self.client_address[0]} disconnected during "
+                f"{method} {self.path}: {exc}",
+                file=sys.stderr,
+                flush=True,
+            )
+        except Exception:
+            traceback.print_exc(file=sys.stderr)
+            self._send_error(500, "internal error")
+
+    # --- T031: request body, size-checked before it is read -------------------------------
+
+    def _read_body(self):
+        """Return the request body bytes, or raise :class:`_Rejected`.
+
+        ``Content-Length`` is the only pre-body size signal available, so it is required and
+        is checked *before* a single body byte is read: an oversized request never reaches
+        memory (FR-024, R-003).
+        """
+        if self.headers.get("Transfer-Encoding"):
+            raise self._reject_unread(
+                400,
+                "the service requires a Content-Length header; "
+                "Transfer-Encoding requests are not accepted",
+            )
+
+        declared = self.headers.get("Content-Length")
+        if declared is None:
+            raise self._reject_unread(
+                400, 'request body is empty; a JSON object with a "content" field is required'
+            )
+        try:
+            length = int(declared)
+        except ValueError:
+            raise self._reject_unread(
+                400, f"Content-Length is not an integer: {declared!r}"
+            ) from None
+        if length < 0:
+            raise self._reject_unread(400, f"Content-Length is negative: {length}")
+        if length > PAYLOAD_MAX_BYTES:
+            raise self._reject_unread(
+                413,
+                f"request body of {length} bytes exceeds the "
+                f"{PAYLOAD_MAX_BYTES}-byte limit",
+            )
+        if length == 0:
+            # Nothing was sent, so nothing is left unread: the connection stays reusable.
+            raise _Rejected(
+                400, 'request body is empty; a JSON object with a "content" field is required'
+            )
+
+        body = self.rfile.read(length)
+        if len(body) != length:
+            raise self._reject_unread(
+                400,
+                f"request body ended after {len(body)} bytes "
+                f"but Content-Length declared {length}",
+            )
+        return body
+
+    def _reject_unread(self, status, message):
+        """Build a rejection for a request whose body was left unread.
+
+        The connection is marked for closing because its framing is now unknown: the
+        unconsumed body bytes would otherwise be parsed as the next request line on a
+        keep-alive connection, turning one refused request into a second bogus one.
+        """
+        self.close_connection = True
+        return _Rejected(status, message)
+
+    def _discard_unread_body(self):
+        """Briefly discard unread request bytes before the connection closes.
+
+        Closing straight after the error response makes the kernel answer the client's
+        still-in-flight body with RST, which can destroy the very ``413`` the client was
+        meant to read — so a body larger than the socket buffers would be refused without
+        the client ever seeing why. Bytes are read in fixed-size chunks and dropped, never
+        accumulated, so refusing "without reading the whole body into memory" still holds
+        (FR-024, FR-022). Both bounds below cap the effort a hostile client can demand.
+
+        A timeout or a disconnect is the normal way out of this loop, not a failure: each
+        means there is nothing further to discard.
+        """
+        deadline = time.monotonic() + LINGER_SECONDS
+        discarded = 0
+        try:
+            while discarded < LINGER_MAX_BYTES:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    return
+                self.connection.settimeout(remaining)
+                chunk = self.connection.recv(LINGER_CHUNK_BYTES)
+                if not chunk:
+                    return
+                discarded += len(chunk)
+        except (TimeoutError, ConnectionError):
+            return
+
+    # --- T032 / T044: creation-body validation (V-1…V-8) ----------------------------------
+
+    def _parse_create(self, body_bytes):
+        """Validate a creation body and return ``(content, expires_in)``.
+
+        Applies V-1…V-8 in order. Every rejection names the offending field specifically
+        enough to act on (FR-004, FR-005, FR-006, FR-007, FR-022). Questionable input is
+        refused, never coerced (Constitution II).
+        """
+        try:  # V-1
+            parsed = json.loads(body_bytes.decode("utf-8"))
+        except UnicodeDecodeError:
+            raise _Rejected(400, "request body is not valid UTF-8") from None
+        except json.JSONDecodeError as exc:
+            raise _Rejected(
+                400, f"request body is not valid JSON: {exc.msg} (at position {exc.pos})"
+            ) from None
+
+        if not isinstance(parsed, dict):  # V-2
+            raise _Rejected(
+                400, f"request body must be a JSON object, got {_json_type(parsed)}"
+            )
+        if "content" not in parsed:  # V-3
+            raise _Rejected(400, 'required field "content" is missing')
+
+        content = parsed["content"]
+        if not isinstance(content, str) or isinstance(content, bool):  # V-4
+            raise _Rejected(
+                400, f'field "content" must be a string, got {_json_type(content)}'
+            )
+
+        size = len(content.encode("utf-8"))  # V-5, inclusive, measured on the encoding
+        if size > storage.CONTENT_MAX_BYTES:
+            raise _Rejected(
+                413,
+                f'field "content" is {size} UTF-8 bytes, over the '
+                f"{storage.CONTENT_MAX_BYTES}-byte limit",
+            )
+
+        # V-8: every other key is ignored rather than rejected (FR-007).
+        return content, self._parse_expires_in(parsed)
+
+    def _parse_expires_in(self, parsed):
+        """Validate ``expires_in`` (V-6, V-7) and return it, or ``None`` when absent.
+
+        Absent means "never expires". JSON ``null`` means "present and invalid", not
+        "absent" — as do a float, a boolean, a string, and anything outside the inclusive
+        bounds (FR-006).
+        """
+        if "expires_in" not in parsed:
+            return None
+
+        value = parsed["expires_in"]
+        if not isinstance(value, int) or isinstance(value, bool):  # V-6
+            raise _Rejected(
+                400,
+                f'field "expires_in" must be an integer number of seconds, '
+                f"got {_json_type(value)}",
+            )
+        if not storage.EXPIRES_IN_MIN <= value <= storage.EXPIRES_IN_MAX:  # V-7
+            raise _Rejected(
+                400,
+                f'field "expires_in" must be between {storage.EXPIRES_IN_MIN} and '
+                f"{storage.EXPIRES_IN_MAX} seconds inclusive, got {value}",
+            )
+        return value
+
+    # --- T033 / T034 / T035 / T039: the four routes ---------------------------------------
+
+    def _create(self):
+        """``POST /pastes`` — create a paste (FR-001, FR-002, FR-003, FR-008)."""
+        try:
+            content, expires_in = self._parse_create(self._read_body())
+        except _Rejected as exc:
+            # Validation happens entirely before storage is touched, so nothing is written
+            # on any rejection path (FR-008).
+            self._send_error(exc.status, exc.message)
+            if self.close_connection:
+                self._discard_unread_body()
+            return
+
+        paste = storage.create_paste(self.server.data_dir, content, expires_in)
+        self._send_json(
+            201,
+            {
+                "id": paste.id,
+                "delete_token": paste.delete_token,
+                "url": "/pastes/" + paste.id,
+            },
+        )
+
+    def _load(self, paste_id):
+        """Load a paste for a read or delete, or answer ``404`` and return ``None``.
+
+        A deleted, expired, never-issued, unreadable, or ill-shaped identifier is answered
+        identically, so no response discloses which identifiers exist (FR-021).
+        """
+        paste = storage.load_paste(self.server.data_dir, paste_id)
+        if paste is None:
+            self._send_error(404, "paste not found")
+        return paste
+
+    def _read_json(self, paste_id):
+        """``GET /pastes/<id>`` — read as JSON (FR-009, FR-010, FR-003, FR-023)."""
+        paste = self._load(paste_id)
+        if paste is None:
+            return
+        self._send_json(
+            200,
+            {
+                "id": paste.id,
+                "content": paste.content,
+                "created_at": storage.iso_z(paste.created_at),
+                # JSON null when the paste never expires (FR-010).
+                "expires_at": storage.iso_z(paste.expires_at),
+            },
+        )
+        # delete_token is deliberately absent from this body (FR-003).
+
+    def _read_raw(self, paste_id):
+        """``GET /pastes/<id>/raw`` — read as plain text (FR-011, FR-012)."""
+        paste = self._load(paste_id)
+        if paste is None:
+            return
+        self._send_text(paste.content)
+
+    def _delete(self, paste_id):
+        """``DELETE /pastes/<id>`` — revoke a paste (FR-013, FR-014, FR-016, FR-021).
+
+        The order below is **contractual**. Existence and expiry are resolved first, so
+        ``404`` always takes precedence over ``403`` and the token of a paste that does not
+        exist is never examined — otherwise the status code itself would disclose which
+        identifiers exist (FR-021, R-005, contracts/http-api.md ordering rule).
+        """
+        paste = self._load(paste_id)  # allow-list, then existence/expiry → 404
+        if paste is None:
+            return
+
+        if not storage.token_matches(paste, self.headers.get("X-Delete-Token")):
+            # The record is left in place and stays readable (FR-014).
+            self._send_error(403, "X-Delete-Token is missing or does not match this paste")
+            return
+
+        storage.delete_record(self.server.data_dir, paste.id)
+        self._send_no_content()
+
+
+# --- T020: server construction ------------------------------------------------------------
+
+
+def make_server(port, data_dir):
+    """Return a server bound and listening on ``127.0.0.1:port``.
+
+    Construction performs ``bind()`` and ``listen()``, so the kernel accept queue is already
+    live on return. A client connecting between that moment and ``serve_forever()`` waits in
+    the backlog instead of being refused, which is what makes the readiness line in
+    :mod:`pastebin.cli` honest (FR-025, FR-027, R-001, R-002).
+
+    Loopback only: ``127.0.0.1``, never ``0.0.0.0`` (FR-025).
+    """
+    server = ThreadingHTTPServer(("127.0.0.1", port), PasteHandler)
+    server.data_dir = data_dir
+    return server
