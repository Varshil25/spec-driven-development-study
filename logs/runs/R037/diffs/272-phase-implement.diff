+"""The process contract: invocation, readiness, stream discipline, exits, and durability.
+
+Covers FR-025…FR-030 and SC-004. Every test here drives a real
+``python -m pastebin serve`` subprocess, because that is the only honest way to observe
+readiness ordering, exit statuses, and what lands on which stream.
+"""
+
+import json
+import os
+import socket
+import time
+
+import pytest
+
+from conftest import free_port
+
+READY = "listening on 127.0.0.1:"
+
+
+# --- FR-025 -------------------------------------------------------------------------------
+
+
+def test_FR_025_port_is_reachable_on_loopback(process_service):
+    """FR-025: the service answers on 127.0.0.1 at the chosen port."""
+    assert process_service.create(content="hello")["id"]
+    assert process_service.request("GET", "/").status == 404
+
+
+def _decode_proc_ip(hex_ip, family):
+    """Decode a /proc/net/tcp local_address field into a printable address."""
+    raw = bytes.fromhex(hex_ip)
+    if family == socket.AF_INET:
+        return socket.inet_ntop(family, raw[::-1])
+    # IPv6 appears as four little-endian 32-bit words.
+    return socket.inet_ntop(
+        family, b"".join(raw[offset : offset + 4][::-1] for offset in range(0, 16, 4))
+    )
+
+
+def _listening_addresses(port):
+    """Return the set of addresses the kernel reports as LISTENing on ``port``."""
+    found = set()
+    for proc_file, family in (
+        ("/proc/net/tcp", socket.AF_INET),
+        ("/proc/net/tcp6", socket.AF_INET6),
+    ):
+        if not os.path.exists(proc_file):
+            continue
+        with open(proc_file, encoding="ascii") as handle:
+            for line in handle.read().splitlines()[1:]:
+                fields = line.split()
+                if len(fields) < 4 or fields[3] != "0A":  # 0A == TCP_LISTEN
+                    continue
+                hex_ip, hex_port = fields[1].split(":")
+                if int(hex_port, 16) == port:
+                    found.add(_decode_proc_ip(hex_ip, family))
+    return found
+
+
+def test_FR_025_server_binds_loopback_only_not_all_interfaces(process_service, tmp_path):
+    """FR-025: the listening socket is 127.0.0.1, never a wildcard.
+
+    Checked three ways so the guarantee does not rest on the host happening to have a
+    non-loopback address: the server's own reported bind address, the kernel's view of the
+    real subprocess's socket, and — where such an address exists — an actual refused
+    connection to it.
+    """
+    from pastebin import server as pastebin_server
+
+    httpd = pastebin_server.make_server(0, str(tmp_path))
+    try:
+        assert httpd.server_address[0] == "127.0.0.1"
+    finally:
+        httpd.server_close()
+
