+"""FR-043 ... FR-046: never destroy an existing archive by accident.
+
+The archive target is checked against four states before anything is opened
+(data-model.md *Archive target validation*):
+
+===========================================  ==================  ======
+State of ``ARCHIVE``                         without --overwrite  with
+===========================================  ==================  ======
+does not exist                               create, 0           create, 0
+exists as a directory                        2 (A1)              2 (A1)
+exists as a regular file                     3 (A2)              replace, 0
+exists as something else (FIFO, device, ...)  3 (A2)              2 (A3)
+===========================================  ==================  ======
+
+A1 is checked before A2 because status 2 outranks status 3 (FR-056), which is
+what makes status 3 mean exactly one thing: "re-run with ``--overwrite``".
+
+The bottom row is an asymmetry the specification does not settle, resolved in
+research R20 and pinned by a test here, so a future amendment surfaces as a
+failure rather than silent drift.
+"""
+
+import os
+
+import pytest
+
+from conftest import SOURCE_FILE_COUNT, member_names
+
+
+def assert_clean_failure(result, status, message):
+    """Assert empty stdout, a one-line ``tarx:`` diagnostic, and ``status``."""
+    assert result.returncode == status
+    assert result.stdout == ""
+    assert result.stderr == f"tarx: {message}\n"
+    assert "Traceback (most recent call last)" not in result.stderr
+
+
+# --------------------------------------------------------------------------
+# FR-043: an existing archive path is refused with exit 3 and left alone
+# --------------------------------------------------------------------------
+
+
+def test_fr043_existing_archive_without_overwrite_exits_three(run_tarx, source_tree):
+    """FR-043: exit 3, a one-line diagnostic, and the archive untouched.
+
+    The wording is character-for-character identical to ``extract``'s
+    overwrite conflict, so the two commands' recovery advice reads the same.
+    """
+    first = run_tarx("create", "guard.tar", "notes.txt", cwd=source_tree)
+    assert first.returncode == 0
+    archive = source_tree / "guard.tar"
+    before = archive.read_bytes()
+
+    second = run_tarx("create", "guard.tar", "photos", cwd=source_tree)
+    assert_clean_failure(
+        second, 3, "'guard.tar' already exists; use --overwrite to replace it"
+    )
+    assert archive.read_bytes() == before
+
+
+def test_fr043_refusal_precedes_truncation(run_tarx, source_tree):
+    """FR-043: "byte-for-byte unmodified" holds, not merely "not rewritten".
+
+    ``tarfile.open(path, "w")`` truncates immediately, so this assertion only
+    passes if the check runs *before* the open (research R18). A zero-length
+    archive would satisfy "the new archive was not written" while still having
+    destroyed the user's data.
+    """
+    assert run_tarx("create", "guard.tar", "notes.txt", cwd=source_tree).returncode == 0
+    archive = source_tree / "guard.tar"
+    before = archive.read_bytes()
+    assert len(before) > 0
+
+    run_tarx("create", "guard.tar", "photos", "notes.txt", cwd=source_tree)
+    assert archive.read_bytes() == before
+    assert member_names(archive) == ["notes.txt"]
+
+
+def test_fr043_applies_to_any_existing_path_not_just_archives(run_tarx, source_tree):
+    """FR-043: *any* existing file at ``ARCHIVE`` triggers the refusal."""
+    (source_tree / "notes.tar").write_bytes(b"not an archive at all")
+    result = run_tarx("create", "notes.tar", "notes.txt", cwd=source_tree)
+    assert_clean_failure(
+        result, 3, "'notes.tar' already exists; use --overwrite to replace it"
+    )
+    assert (source_tree / "notes.tar").read_bytes() == b"not an archive at all"
+
+
+# --------------------------------------------------------------------------
+# FR-044, FR-046: --overwrite replaces a regular file, and is otherwise inert
+# --------------------------------------------------------------------------
+
+
+def test_fr044_overwrite_replaces_an_existing_regular_file(run_tarx, source_tree):
+    """FR-044: with the flag, the archive is rebuilt from the named paths."""
+    assert run_tarx("create", "guard.tar", "notes.txt", cwd=source_tree).returncode == 0
+    archive = source_tree / "guard.tar"
+    assert member_names(archive) == ["notes.txt"]
+
+    result = run_tarx(
+        "create", "guard.tar", "photos", "notes.txt", "--overwrite", cwd=source_tree
+    )
+    assert result.returncode == 0
+    assert result.stderr == ""
+    assert result.stdout == f"created guard.tar with {SOURCE_FILE_COUNT} files\n"
+    assert member_names(archive) != ["notes.txt"]
+    assert "photos/a.jpg" in member_names(archive)
+
+
+def test_fr046_overwrite_on_a_missing_path_is_accepted_silently(
+    run_tarx, source_tree
+):
+    """FR-046: ``--overwrite`` naming nothing is not an error."""
+    result = run_tarx(
+        "create", "brand-new.tar", "notes.txt", "--overwrite", cwd=source_tree
+    )
+    assert result.returncode == 0
+    assert result.stderr == ""
+    assert result.stdout == "created brand-new.tar with 1 files\n"
+    assert member_names(source_tree / "brand-new.tar") == ["notes.txt"]
+
+
+# --------------------------------------------------------------------------
+# FR-045: an archive path that is a directory is refused with exit 2
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("flags", [(), ("--overwrite",)])
+def test_fr045_archive_path_that_is_a_directory_exits_two(
+    run_tarx, source_tree, flags
+):
+    """FR-045: exit 2 with *and* without the flag; the directory survives.
+
+    Status 2 rather than 3 because ``--overwrite`` cannot resolve it, and A1
+    is therefore checked ahead of A2 (FR-056).
+    """
+    target = source_tree / "adir"
+    target.mkdir()
+    (target / "keep.txt").write_bytes(b"keep")
+
+    result = run_tarx("create", "adir", "notes.txt", *flags, cwd=source_tree)
+    assert_clean_failure(result, 2, "cannot write archive 'adir': is a directory")
+    assert target.is_dir()
+    assert (target / "keep.txt").read_bytes() == b"keep"
+    assert [p.name for p in target.iterdir()] == ["keep.txt"]
+
+
+# --------------------------------------------------------------------------
+# A3 / research R20: an existing path that is neither a directory nor a file
+# --------------------------------------------------------------------------
+
+
+def test_a3_overwrite_onto_a_fifo_exits_two(run_tarx, source_tree):
+    """A3: ``--overwrite`` onto a non-regular file is refused with exit 2.
+
+    Honouring the flag here would mean opening the FIFO for writing, which
+    blocks until a reader appears -- the command would hang instead of
+    failing. Research R20 chose a named refusal over that.
+    """
+    fifo = source_tree / "pipe.tar"
+    os.mkfifo(fifo)
+
+    result = run_tarx(
+        "create", "pipe.tar", "notes.txt", "--overwrite", cwd=source_tree
+    )
+    assert_clean_failure(
+        result, 2, "cannot replace archive 'pipe.tar': not a regular file"
+    )
+    assert fifo.is_fifo()
+
+
+def test_a3_fifo_without_overwrite_still_exits_three(run_tarx, source_tree):
+    """A2 beats A3 without the flag: FR-043 says *any* existing path exits 3.
+
+    The other half of the asymmetry R20 documents. Pinned deliberately: these
+    two tests together are the only record that the status depends on the flag
+    for a non-regular file, so an amendment cannot change it unnoticed.
+    """
+    fifo = source_tree / "pipe.tar"
+    os.mkfifo(fifo)
+
+    result = run_tarx("create", "pipe.tar", "notes.txt", cwd=source_tree)
+    assert_clean_failure(
+        result, 3, "'pipe.tar' already exists; use --overwrite to replace it"
+    )
+    assert fifo.is_fifo()