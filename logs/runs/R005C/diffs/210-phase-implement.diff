+# --------------------------------------------------------------------------
+# Create-side source-tree fixtures (feature 002)
+#
+# Every fixture above builds an *archive*, which is what ``list`` and
+# ``extract`` consume. ``create`` consumes the opposite -- a source *tree* --
+# so these build directory layouts instead. Each returns the tree root, which
+# tests pass as ``run_tarx(..., cwd=root)``: ``create`` names its members
+# relative to the current directory, so the root must be the cwd for the
+# recorded names to come out as FR-034 requires.
+# --------------------------------------------------------------------------
+
+# The eight members that ``create ARCHIVE photos notes.txt`` must record, in
+# exactly this order, when run from a :func:`source_tree` root (FR-035,
+# data-model.md *Member order*): source paths in command-line order; within a
+# directory, its own member first, then its entries in ``sorted()`` order.
+EXPECTED_PHOTO_MEMBERS = (
+    "photos",
+    "photos/a.jpg",
+    "photos/b.jpg",
+    "photos/empty",
+    "photos/raw",
+    "photos/raw/r.cr2",
+    "photos/zero.bin",
+    "notes.txt",
+)
+
+# Distinct lengths, so a mixed-up member cannot pass a byte-identity
+# assertion. ``photos/zero.bin`` is deliberately zero-length: the spec's Edge
+# Cases require it to be stored *and counted* (FR-039).
+SOURCE_FILES = {
+    "notes.txt": b"notes",
+    "photos/a.jpg": b"AAA",
+    "photos/b.jpg": b"BBBB",
+    "photos/raw/r.cr2": b"R",
+    "photos/zero.bin": b"",
+}
+
+# ``photos/empty`` holds nothing, so it exists only as a directory. It proves
+# an empty directory survives a create-then-extract round trip (FR-033).
+SOURCE_DIRS = ("photos/empty",)
+
+# Regular files in the tree, and therefore the count ``create`` must report.
+SOURCE_FILE_COUNT = len(SOURCE_FILES)
+
+
+def build_source_tree(root):
+    """Create the shared source layout under ``root`` and return ``root``."""
+    for name in SOURCE_DIRS:
+        (root / name).mkdir(parents=True, exist_ok=True)
+    for name, data in SOURCE_FILES.items():
+        target = root / name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(data)
+    return root
+
+
+@pytest.fixture
+def source_tree(tmp_path):
+    """A tree of five regular files, two directories, and one empty directory.
+
+    Layout, which is what :data:`EXPECTED_PHOTO_MEMBERS` describes::
+
+        notes.txt
+        photos/a.jpg
+        photos/b.jpg
+        photos/empty/        <- no entries
+        photos/raw/r.cr2
+        photos/zero.bin      <- zero length, still counted
+
+    Returned as a dedicated subdirectory rather than ``tmp_path`` itself, so a
+    test can create an archive beside the tree without the archive landing in
+    the same directory as pytest's other scratch state.
+    """
+    return build_source_tree(tmp_path / "tree")
+
+
+@pytest.fixture
+def hollow_tree(tmp_path):
+    """A tree holding one empty directory and no regular files at all.
+
+    ``create hollow.tar hollow`` over this tree must still write an archive,
+    record ``hollow`` as a directory member, report ``with 0 files``, and exit
+    0 (US1 scenario 6, FR-039).
+    """
+    root = tmp_path / "hollow-root"
+    (root / "hollow").mkdir(parents=True)
+    return root
+
+
+@pytest.fixture
+def special_tree(tmp_path):
+    """:func:`source_tree`'s layout plus a symbolic link and a FIFO.
+
+    ``photos/link.jpg`` -> ``a.jpg`` and ``photos/pipe`` are members of
+    neither handled kind, so both must be skipped -- not stored, not counted,
+    and not an error -- whether named directly or met while walking (FR-036).
+
+    The FIFO matters beyond the symlink: opening one for reading blocks until
+    a writer appears, so a tool that failed to skip it would hang rather than
+    fail, which no test could distinguish from a slow run.
+    """
+    root = build_source_tree(tmp_path / "special")
+    (root / "photos" / "link.jpg").symlink_to("a.jpg")
+    os.mkfifo(root / "photos" / "pipe")
+    return root
+
+
+# --------------------------------------------------------------------------
+# Archive inspection helpers (feature 002)
+# --------------------------------------------------------------------------
+
+
+def member_names(path):
+    """Return every recorded member name in ``path``, in archive order.
+
+    Uses ``tarfile`` directly rather than this tool's own ``list``, so a
+    member-name assertion never depends on the command under test: a bug
+    shared by the writer and the reader would otherwise cancel out and pass.
+    """
+    with tarfile.open(path, "r:*") as tar:
+        return [member.name for member in tar]
+
+
+def is_gzip(path):
+    """Return whether ``path`` begins with the two-byte gzip magic number.
+
+    Content-level check, deliberately independent of the file's name: FR-040
+    through FR-042 are about what was *written*, and the name is only the
+    input to that choice.
+    """
+    with open(path, "rb") as handle:
+        return handle.read(2) == b"\x1f\x8b"
+
+
