+)
+def test_sc012_system_tar_reads_created_archives(
+    run_tarx, source_tree, tmp_path, name, list_flags, extract_flags
+):
+    """SC-012: system GNU ``tar`` lists and extracts what this tool writes.
+
+    Skipped when ``tar`` is unavailable, following the ``gnu_tar_dir_archive``
