+@pytest.fixture(scope="module")
+def big_tree(tmp_path_factory):
+    """10,000 regular files across 100 directories, built once per module.
+
+    Module-scoped because building it is the slow part, following the
+    convention in tests/test_performance.py. The tree root is the *parent* of
+    ``big/``, so an archive written into the cwd lands beside the tree rather
+    than inside it.
+    """
+    root = tmp_path_factory.mktemp("createperf")
+    payload = b"0123456789"
+    for index in range(PERF_DIR_COUNT):
+        (root / "big" / f"dir{index}").mkdir(parents=True)
+    for index in range(PERF_MEMBER_COUNT):
+        (root / "big" / f"dir{index % PERF_DIR_COUNT}" / f"f{index}.bin").write_bytes(
+            payload
+        )
+    return root
+
+
+@pytest.mark.parametrize("archive", ["big.tar", "big.tar.gz"])
+def test_sc017_ten_thousand_files_within_budget(run_tarx, big_tree, archive):
+    """SC-017: 10,000 files are packed, plain or gzip, inside 30 seconds.
+
+    Research R23 measured 0.97 s plain and 1.98 s gzip for 10,001 files, so
+    the budget is a 15-30x margin -- wide enough not to flake on a loaded
+    machine, tight enough that an accidentally quadratic walk would trip it.
+    """
+    start = time.perf_counter()
+    result = run_tarx("create", archive, "big", cwd=big_tree)
+    elapsed = time.perf_counter() - start
+
+    assert_created(result, archive, PERF_MEMBER_COUNT)
+    assert elapsed < CREATE_BUDGET_SECONDS, f"create took {elapsed:.2f}s"
