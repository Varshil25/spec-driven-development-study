+"""FR-047 ... FR-056: round trips, unchanged behaviour, and every failure path.
+
+Three concerns share this module because they share one question -- "does the
+rest of the tool still behave?":
+
+* FR-047/FR-048 -- archives ``create`` writes round-trip through this tool's
+  own ``list`` and ``extract``.
+* FR-049 -- ``list`` and ``extract`` behave identically to before this
+  feature, for every input. Verified by running 001's suite unmodified *and*
+  by re-asserting its headline outputs here with ``create`` registered.
+* FR-050 ... FR-056 -- every unusable input gives one line on stderr naming
+  the offending path as typed, a non-zero status, and no new archive.
+"""
+
+import os
+import subprocess
+import tarfile
+
+import pytest
+
+from conftest import (
+    EXPECTED_PHOTO_MEMBERS,
+    SOURCE_DIRS,
+    SOURCE_FILES,
+    SOURCE_FILE_COUNT,
+)
+
+# The two archive names whose round trip must be identical: one plain, one
+# gzip-compressed (SC-010).
+ROUND_TRIP_ARCHIVES = ("photos.tar", "photos.tar.gz")
+
+
+def assert_clean_failure(result, status, message):
+    """Assert the shape every ``create`` failure must have (FR-055, FR-056).
+
+    Empty stdout, stderr exactly ``tarx: {message}\\n`` -- one line, no
+    traceback -- and the assigned exit status. The same shape 001 asserts in
+    tests/test_failures.py, kept as a local helper there and here rather than
+    shared, so neither module's expectations can drift into the other's.
+    """
+    assert result.returncode == status
+    assert result.stdout == ""
+    assert result.stderr == f"tarx: {message}\n"
+    assert "Traceback (most recent call last)" not in result.stderr
+
+
+def make_archive(run_tarx, tree, name, *paths):
+    """Create ``name`` from ``paths`` inside ``tree`` and return its path."""
+    if not paths:
+        paths = ("photos", "notes.txt")
+    result = run_tarx("create", name, *paths, cwd=tree)
+    assert result.returncode == 0, result.stderr
+    return tree / name
+
+
+# --------------------------------------------------------------------------
+# FR-047: every archive create writes is readable by list
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("name", ROUND_TRIP_ARCHIVES)
+def test_fr047_created_archive_lists_its_recorded_names(run_tarx, source_tree, name):
+    """FR-047: ``list`` prints the recorded names in archive order.
+
+    Directory members appear *without* a trailing separator: the on-wire
+    header carries tar's conventional ``photos/``, and ``tarfile`` strips it
+    again while parsing, which is what makes FR-008 need no code (research
+    R17, 001 research R3).
+    """
+    archive = make_archive(run_tarx, source_tree, name)
+    result = run_tarx("list", archive)
+
+    assert result.returncode == 0
+    assert result.stderr == ""
+    assert result.stdout.splitlines() == list(EXPECTED_PHOTO_MEMBERS)
+    assert "photos/" not in result.stdout.splitlines()
+    assert "photos/empty/" not in result.stdout.splitlines()
+
+
+# --------------------------------------------------------------------------
+# FR-048: every archive create writes is extractable by extract
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("name", ROUND_TRIP_ARCHIVES)
+def test_fr048_created_archive_extracts_byte_identically(
+    run_tarx, source_tree, tmp_path, name
+):
+    """FR-048: every regular file returns at its recorded path, byte-identical.
+
+    The destination does not exist beforehand, so this also exercises
+    ``extract``'s own directory creation (FR-012) against a created archive.
+    """
+    archive = make_archive(run_tarx, source_tree, name)
+    dest = tmp_path / f"out-{name}"
+    result = run_tarx("extract", archive, dest)
+
+    assert result.returncode == 0
+    assert result.stderr == ""
+    assert result.stdout == f"extracted {SOURCE_FILE_COUNT} files\n"
+
+    for relative, data in SOURCE_FILES.items():
+        assert (dest / relative).read_bytes() == data
+    for relative in SOURCE_DIRS:
+        assert (dest / relative).is_dir()
+        assert list((dest / relative).iterdir()) == []
+
+
+def test_fr048_plain_and_gzip_round_trips_are_identical(
+    run_tarx, source_tree, tmp_path
+):
+    """SC-010: compression changes nothing an acceptance scenario can observe."""
+    results = {}
+    for name in ROUND_TRIP_ARCHIVES:
+        archive = make_archive(run_tarx, source_tree, name)
+        dest = tmp_path / f"cmp-{name}"
+        assert run_tarx("extract", archive, dest).returncode == 0
+        results[name] = {
+            relative: (dest / relative).read_bytes() for relative in SOURCE_FILES
+        }
+    plain, gzipped = ROUND_TRIP_ARCHIVES
+    assert results[plain] == results[gzipped]
+
+
+def test_fr048_count_equality_is_scoped_to_non_overlapping_paths(
+    run_tarx, source_tree, tmp_path
+):
+    """FR-048's count equality holds only when the source paths do not overlap.
+
+    ``create`` counts each stored regular-file member; ``extract`` counts each
+    distinct destination path written (FR-015). For overlapping sources the
+    two numbers therefore diverge, and ``create`` reports the larger. This is
+    a specification-internal conflict resolved in the plan -- see research R22
+    and the contract's *Scope restriction on FR-048's count equality*.
+
+    Both numbers are asserted so the documented divergence cannot drift
+    silently in either direction.
+    """
+    created = run_tarx("create", "dup.tar", "notes.txt", "notes.txt", cwd=source_tree)
+    assert created.stdout == "created dup.tar with 2 files\n"
+
+    extracted = run_tarx("extract", source_tree / "dup.tar", tmp_path / "dup-out")
+    assert extracted.stdout == "extracted 1 files\n"
+    assert extracted.returncode == 0
+
+
+# --------------------------------------------------------------------------
+# FR-049, SC-015: list and extract are unchanged by this feature
+# --------------------------------------------------------------------------
+
+
+def test_fr049_list_output_unchanged_for_pre_existing_archives(
+    run_tarx, plain_archive, gzip_archive, nested_archive
+):
+    """FR-049: ``list`` prints exactly what 001's tests assert, with ``create`` present."""
+    for archive in (plain_archive, gzip_archive):
+        result = run_tarx("list", archive)
+        assert result.returncode == 0
+        assert result.stderr == ""
+        assert result.stdout == "photos/a.jpg\nphotos/b.jpg\n"
+
+    result = run_tarx("list", nested_archive)
+    assert result.returncode == 0
+    assert result.stderr == ""
+    assert result.stdout.splitlines() == [
+        "nest",
+        "nest/a",
+        "nest/a/one.txt",
+        "nest/a/b/c/deep.txt",
+        "nest/empty",
+    ]
+
+
+def test_fr049_extract_output_unchanged_for_pre_existing_archives(
+    run_tarx, plain_archive, gzip_archive, nested_archive, tmp_path
+):
+    """FR-049: ``extract``'s counts, stderr, and statuses are unchanged."""
+    for index, archive in enumerate((plain_archive, gzip_archive)):
+        result = run_tarx("extract", archive, tmp_path / f"photos{index}")
+        assert result.returncode == 0
+        assert result.stderr == ""
+        assert result.stdout == "extracted 2 files\n"
+
+    result = run_tarx("extract", nested_archive, tmp_path / "nest-out")
+    assert result.returncode == 0
+    assert result.stderr == ""
+    assert result.stdout == "extracted 2 files\n"
+    assert (tmp_path / "nest-out" / "nest" / "empty").is_dir()
+
+
+def test_fr049_a_third_subparser_does_not_change_the_usage_line(run_tarx):
+    """FR-049: top-level and per-command usage errors still read ``usage: tarx``.
+
+    The top-level parser uses ``metavar="COMMAND"``, so adding a third
+    subparser cannot widen the usage line into a subcommand list (001
+    research R7).
+    """
+    no_command = run_tarx()
+    assert no_command.returncode == 2
+    assert no_command.stderr.startswith("usage: tarx")
+
+    no_archive = run_tarx("list")
+    assert no_archive.returncode == 2
+    assert no_archive.stderr.startswith("usage: tarx")
+
+
+# --------------------------------------------------------------------------
+# FR-050, FR-051: a source path that does not exist
+# --------------------------------------------------------------------------
+
+
+def test_fr050_missing_source_path_is_named_and_exits_two(run_tarx, source_tree):
+    """FR-050/FR-051: the missing path is named, and no archive is created."""
+    result = run_tarx("create", "other.tar", "missing-folder", cwd=source_tree)
+    assert_clean_failure(
+        result, 2, "cannot add 'missing-folder': No such file or directory"
+    )
+    assert not (source_tree / "other.tar").exists()
+
+
+def test_fr051_one_missing_path_rejects_the_whole_invocation(run_tarx, source_tree):
+    """FR-051: a valid path alongside a missing one changes nothing.
+
+    Validation runs over *all* source paths before the archive is opened, so
+    ``photos`` being perfectly valid does not buy a partial archive.
+    """
+    result = run_tarx(
+        "create", "other.tar", "photos", "missing-folder", cwd=source_tree
+    )
+    assert_clean_failure(
+        result, 2, "cannot add 'missing-folder': No such file or directory"
+    )
+    assert not (source_tree / "other.tar").exists()
+
+
+def test_fr056_missing_source_outranks_the_overwrite_conflict(run_tarx, source_tree):
+    """FR-056: status 2 wins over status 3, and the old archive survives.
+
+    US4 scenario 3. The source paths are validated before the archive target,
+    so a run with both a bad ``PATH`` and an existing ``ARCHIVE`` reports the
+    ``PATH``. With ``--overwrite`` given, a design that opened the archive
+    first would have truncated it before noticing the bad path.
+    """
+    assert run_tarx("create", "keep.tar", "notes.txt", cwd=source_tree).returncode == 0
+    archive = source_tree / "keep.tar"
+    before = archive.read_bytes()
+
+    result = run_tarx(
+        "create", "keep.tar", "missing-folder", "--overwrite", cwd=source_tree
+    )
+    assert_clean_failure(
+        result, 2, "cannot add 'missing-folder': No such file or directory"
+    )
+    assert archive.read_bytes() == before
+
+
+# --------------------------------------------------------------------------
+# FR-052: a source path outside the current directory
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "typed", ["/etc/passwd", "../outside", "a/../../outside"]
+)
+def test_fr052_paths_outside_the_current_directory_are_refused(
+    run_tarx, source_tree, typed
+):
+    """FR-052: absolute and escaping paths exit 2, named exactly as typed.
+
+    ``a/../../outside`` is reported verbatim rather than as its normalised
+    form ``../outside``, so the message matches what the user wrote. The check
+    is purely lexical -- no ``realpath``, no ``resolve()`` -- so it does not
+    depend on whether the path happens to exist.
+    """
+    result = run_tarx("create", "other.tar", typed, cwd=source_tree)
+    assert_clean_failure(
+        result, 2, f"refusing to add '{typed}' outside the current directory"
+    )
+    assert not (source_tree / "other.tar").exists()
+
+
+def test_fr052_path_that_normalises_back_inside_is_accepted(run_tarx, source_tree):
+    """FR-052: ``photos/../photos`` leaves and returns, so it is accepted.
+
+    data-model.md *Accepted forms*. Containment is decided on the normalised
+    path; only the diagnostic uses the typed one.
+    """
+    result = run_tarx("create", "back.tar", "photos/../photos", cwd=source_tree)
+    assert result.returncode == 0
+    assert result.stderr == ""
+    assert result.stdout == "created back.tar with 4 files\n"
+
+
+@pytest.mark.parametrize("typed", [".", ""])
+def test_s3_current_directory_as_a_source_is_refused(run_tarx, source_tree, typed):
+    """S3 / research R19: ``.`` and ``""`` have no FR-034-conformant name.
+
+    The current directory's relative path is empty, so it cannot be recorded
+    as a member name that is neither absolute nor ``.``-prefixed. The
+    specification is silent here; the plan chose a named refusal over
+    inventing a name, and this test pins that choice so an amendment surfaces
+    as a failure (plan *Constitution Check* note 1).
+    """
+    result = run_tarx("create", "other.tar", typed, cwd=source_tree)
+    assert_clean_failure(
+        result,
+        2,
+        f"refusing to add '{typed}': not an entry inside the current directory",
+    )
+    assert not (source_tree / "other.tar").exists()
+
+
+# --------------------------------------------------------------------------
+# FR-031: invocation errors are argparse's own business
+# --------------------------------------------------------------------------
+
+
+def test_fr031_no_path_argument_prints_the_subcommand_usage(run_tarx, source_tree):
+    """FR-031: ``create`` with no ``PATH`` is rejected by its own subparser.
+
+    ``nargs="+"`` requires at least one, so the guidance is ``create``'s own.
+    """
+    result = run_tarx("create", "other.tar", cwd=source_tree)
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "usage: tarx create" in result.stderr
+    assert not (source_tree / "other.tar").exists()
+
+
+def test_fr031_unknown_option_prints_the_top_level_usage(run_tarx, source_tree):
+    """FR-031: an unknown option exits 2 with usage guidance on stderr.
+
+    The guidance is the *top-level* parser's (``usage: tarx [-h] COMMAND
+    ...``), because an unrecognized argument surfaces after subparser
+    dispatch. FR-031 asks only for "usage guidance", which either line
+    satisfies -- the same convention 001 recorded for ``list`` with a surplus
+    positional (tests/test_invocation.py).
+    """
+    result = run_tarx("create", "other.tar", "photos", "--bogus", cwd=source_tree)
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr.startswith("usage: tarx")
+    assert "--bogus" in result.stderr
+    assert not (source_tree / "other.tar").exists()
+
+
+# --------------------------------------------------------------------------
+# FR-053, FR-054: the archive location, and unreadable sources
+# --------------------------------------------------------------------------
+
+
+def test_fr053_missing_parent_directory_is_not_created(run_tarx, source_tree):
+    """FR-053: the archive's containing directory is never created for the user.
+
+    Spec *Assumptions*. Detected at open time rather than pre-checked -- A5
+    in data-model.md -- so the diagnostic carries the OS's own ``strerror``.
+    """
+    result = run_tarx("create", "nodir/other.tar", "photos", cwd=source_tree)
+    assert_clean_failure(
+        result, 2, "cannot write archive 'nodir/other.tar': No such file or directory"
+    )
+    assert not (source_tree / "nodir").exists()
+
+
+def test_fr053_unwritable_archive_directory(run_tarx, source_tree):
+    """FR-053: an archive location that is not writable exits 2, named.
+
+    Skipped under root, which bypasses the permission bits entirely --
+    research R24. test_fr053_unwritable_archive_directory_in_process asserts
+    the same diagnostic without needing the bits to be honoured.
+    """
+    if os.geteuid() == 0:
+        pytest.skip("running as root: mode 0o000 does not deny access")
+    locked = source_tree / "locked"
+    locked.mkdir()
+    locked.chmod(0o500)
+    try:
+        result = run_tarx("create", "locked/out.tar", "notes.txt", cwd=source_tree)
+        assert_clean_failure(
+            result, 2, "cannot write archive 'locked/out.tar': Permission denied"
+        )
+    finally:
+        locked.chmod(0o700)
+
+
+def test_fr054_unreadable_source_file(run_tarx, source_tree):
+    """FR-054: a source that exists but cannot be read exits 2, named.
+
+    Skipped under root (research R24); the in-process companion below covers
+    the same diagnostic unconditionally.
+    """
+    if os.geteuid() == 0:
+        pytest.skip("running as root: mode 0o000 does not deny access")
+    (source_tree / "notes.txt").chmod(0o000)
+    try:
+        result = run_tarx("create", "out.tar", "notes.txt", cwd=source_tree)
+        assert_clean_failure(
+            result, 2, "cannot add 'notes.txt': Permission denied"
+        )
+    finally:
+        (source_tree / "notes.txt").chmod(0o644)
+
+
+# --------------------------------------------------------------------------
+# FR-053, FR-054 again, in-process -- asserted even when running as root
+# --------------------------------------------------------------------------
+
+
+def test_fr053_unwritable_archive_directory_in_process(monkeypatch, source_tree):
+    """FR-053: an ``OSError`` at open time becomes a named diagnostic, exit 2.
+
+    Research R24 calls for this *alongside* the skipping test, not instead of
+    it: the suite runs as root in CI, where mode bits are not honoured, and a
+    requirement whose only test always skips is not covered at all.
+    """
+    from tarx import cli
+
+    monkeypatch.chdir(source_tree)
+    args = cli.build_parser().parse_args(["create", "out.tar", "notes.txt"])
+    monkeypatch.setattr(
+        tarfile,
+        "open",
+        lambda *a, **k: (_ for _ in ()).throw(
+            PermissionError(13, "Permission denied", "out.tar")
+        ),
+    )
+
+    with pytest.raises(cli.TarxError) as caught:
+        cli.cmd_create(args)
+    assert caught.value.message == (
+        "cannot write archive 'out.tar': Permission denied"
+    )
+    assert caught.value.code == 2
+
+
+def test_fr054_unreadable_source_file_in_process(monkeypatch, source_tree):
+    """FR-054: an ``OSError`` during the write pass is attributed to the source.
+
+    The ``OSError``'s own ``filename`` is what distinguishes "cannot add" from
+    "cannot write archive", so patching ``add`` rather than ``open`` proves
+    the attribution branch, not just the conversion (contract *Diagnostics*,
+    rows A5 and S5).
+    """
+    from tarx import cli
+
+    monkeypatch.chdir(source_tree)
+    args = cli.build_parser().parse_args(["create", "out.tar", "notes.txt"])
+
+    def deny(self, *a, **k):
+        raise PermissionError(13, "Permission denied", "notes.txt")
+
+    monkeypatch.setattr(tarfile.TarFile, "add", deny)
+
+    with pytest.raises(cli.TarxError) as caught:
+        cli.cmd_create(args)
+    assert caught.value.message == "cannot add 'notes.txt': Permission denied"
+    assert caught.value.code == 2
+
+
+# --------------------------------------------------------------------------
+# FR-055, FR-056: the shape of every diagnostic, and the status set
+# --------------------------------------------------------------------------
+
+# Every failure this module can provoke without relying on permission bits,
+# as (argv-after-"create", expected status, path the message must name).
+FAILURE_CASES = (
+    (("other.tar", "missing-folder"), 2, "missing-folder"),
+    (("other.tar", "/etc/passwd"), 2, "/etc/passwd"),
+    (("other.tar", "../outside"), 2, "../outside"),
+    (("other.tar", "a/../../outside"), 2, "a/../../outside"),
+    (("other.tar", "."), 2, "."),
+    (("adir", "notes.txt"), 2, "adir"),
+    (("nodir/other.tar", "photos"), 2, "nodir/other.tar"),
+    (("guard.tar", "notes.txt"), 3, "guard.tar"),
+)
+
+
+@pytest.mark.parametrize(("argv", "status", "named"), FAILURE_CASES)
+def test_fr055_every_diagnostic_is_one_named_line(
+    run_tarx, source_tree, argv, status, named
+):
+    """FR-055: one line, ``tarx:``-prefixed, naming the path, no traceback.
+
+    Also FR-056 per case: the status is the one the contract assigns, never a
+    bare 1 and never an uncaught traceback.
+    """
+    (source_tree / "adir").mkdir()
+    assert run_tarx("create", "guard.tar", "notes.txt", cwd=source_tree).returncode == 0
+
+    result = run_tarx("create", *argv, cwd=source_tree)
+    assert result.returncode == status
+    assert result.stdout == ""
+    assert len(result.stderr.splitlines()) == 1
+    assert result.stderr.startswith("tarx: ")
+    assert f"'{named}'" in result.stderr
+    assert "Traceback (most recent call last)" not in result.stderr
+
+
+def test_fr056_create_uses_exactly_three_statuses(run_tarx, source_tree):
+    """FR-056: ``create``'s statuses are exactly ``{0, 2, 3}``.
+
+    And 3 occurs for exactly one condition -- an existing archive path without
+    ``--overwrite`` -- so it always means "re-run with ``--overwrite``".
+    """
+    (source_tree / "adir").mkdir()
+    assert run_tarx("create", "guard.tar", "notes.txt", cwd=source_tree).returncode == 0
+    statuses = {run_tarx("create", "ok.tar", "notes.txt", cwd=source_tree).returncode}
+    for argv, _status, _named in FAILURE_CASES:
+        statuses.add(run_tarx("create", *argv, cwd=source_tree).returncode)
+    assert statuses == {0, 2, 3}
+
+    # The only status-3 case, with and without the flag.
+    assert run_tarx("create", "ok.tar", "notes.txt", cwd=source_tree).returncode == 3
+    assert (
+        run_tarx(
+            "create", "ok.tar", "notes.txt", "--overwrite", cwd=source_tree
+        ).returncode
+        == 0
+    )
+
+
+# --------------------------------------------------------------------------
+# SC-012: a tar reader other than this tool accepts what create writes
+# --------------------------------------------------------------------------
+
+# The three members of EXPECTED_PHOTO_MEMBERS that are directories. GNU tar
+# displays these with a trailing separator, which is tar's universal
+# convention for a directory header and *not* an FR-034 violation: the
+# on-wire header has always carried it, and ``tarfile`` strips it again while
+# parsing, which is why this tool's own ``list`` shows it without (research
