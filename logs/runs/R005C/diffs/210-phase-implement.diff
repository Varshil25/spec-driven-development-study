+    case-insensitively; ``"w"`` for everything else, including a name with no
+    suffix at all (FR-040, FR-041).
+
+    The typed archive path is the **only** input: the names and contents of
+    the source paths are never consulted (FR-042, research R12). This is
+    deliberately asymmetric with :func:`open_archive`, which sniffs
+    compression from content -- and harmless, because a content-sniffing
+    reader accepts a name-driven writer's output.
+    """
+    if path.lower().endswith((".tar.gz", ".tgz")):
+        return "w:gz"
+    return "w"
+
+
+def validate_sources(paths):
+    """Reject any source path that is unusable, before anything is written.
+
+    Implements data-model.md *Source path validation* rules S1-S4 as **two
+    passes over every path** in command-line order -- containment for all of
+    them first, then existence for all of them:
+
+    * **S1** the path is absolute (FR-052).
+    * **S2** it normalises to ``..`` or below (FR-052).
+    * **S3** it normalises to ``.``, which includes the empty string. The
+      current directory's relative path is empty, so it has no member name
+      that satisfies FR-034; the specification is silent, and research R19
+      chose a named refusal over inventing a name.
+    * **S4** it does not exist (FR-050).
+
+    Both passes cover every path before the archive is opened, so one bad
+    path rejects the whole invocation and leaves no archive behind -- new or
+    partially rebuilt (FR-051). That ordering is mandatory, not stylistic:
+    ``tarfile.open(path, "w")`` truncates immediately, so validating after
+    the open would destroy a pre-existing archive in exactly the case FR-050
+    protects (research R18).
+
+    Purely lexical: no ``Path.resolve()``, no ``os.path.realpath``, no
+    ``os.access``. A symbolic link is therefore never followed to decide
+    containment -- it is skipped as a member instead (FR-036), which closes
+    the same hole from the other side (research R19). ``os.path.lexists`` is
+    used rather than ``os.path.exists`` for the same reason: a broken
+    symbolic link exists as an entry, and is skipped rather than reported
+    missing.
+
+    The diagnostic names the path **as typed**, never normalised, so the
+    message matches what the user wrote.
+    """
+    for path in paths:
+        normalized = posixpath.normpath(path)
+        if posixpath.isabs(path) or normalized == ".." or normalized.startswith("../"):
+            raise TarxError(
+                f"refusing to add '{path}' outside the current directory", EXIT_ERROR
+            )
+        if normalized == ".":
+            raise TarxError(
+                f"refusing to add '{path}': not an entry inside the current directory",
+                EXIT_ERROR,
+            )
+    for path in paths:
+        if not os.path.lexists(path):
+            raise TarxError(
+                f"cannot add '{path}': No such file or directory", EXIT_ERROR
+            )
+
+
+def validate_archive_target(path, overwrite):
+    """Reject an archive path that cannot or must not be written.
+
+    Implements data-model.md *Archive target validation* rules A1 -> A2 -> A3
+    in exactly that order, and writes nothing:
+
+    * **A1** it exists as a directory -> exit 2, with and without the flag
+      (FR-045).
+    * **A2** it exists and ``--overwrite`` was not given -> exit 3 (FR-043).
+    * **A3** it exists, ``--overwrite`` was given, and it is not a regular
+      file -> exit 2 (FR-044, research R20).
+
+    A path that does not exist is accepted, with or without the flag
+    (FR-046, A4).
+
+    A1 **must** precede A2: FR-056 gives status 2 priority over status 3, so
+    status 3 means exactly one thing -- "re-run with ``--overwrite``". A3
+    exists because honouring the flag on a FIFO would block on ``open``
+    rather than fail, so the command would hang instead of diagnosing
+    (research R20).
+
+    Called before the archive is opened, because ``tarfile.open(path, "w")``
+    truncates an existing file immediately; FR-043's "byte-for-byte
+    unmodified" is only true if this runs first (research R18).
+    """
+    target = Path(path)
+    if target.is_dir():
+        raise TarxError(f"cannot write archive '{path}': is a directory", EXIT_ERROR)
+    if target.exists():
+        if not overwrite:
+            raise TarxError(
+                f"'{path}' already exists; use --overwrite to replace it",
+                EXIT_CONFLICT,
+            )
+        if not target.is_file():
+            raise TarxError(
+                f"cannot replace archive '{path}': not a regular file", EXIT_ERROR
+            )
+
+
+def cmd_create(args):
+    """Pack the named paths into an archive and print the summary line.
+
+    ``TarFile.add`` supplies the recursion, the relative naming, the
+    ``sorted()`` entry ordering, and the refusal to store the archive inside
+    itself (FR-033, FR-034, FR-035, FR-037), so none of those is implemented
+    here. Research R13, R14, and R15 rejected hand-rolled ``os.walk``
+    traversal, sorting, and self-exclusion for exactly that reason.
+
+    Entries are classified by the ``filter`` callable in exactly three cases
+    -- regular file, directory, or neither -- and ``None`` drops a member
+    without failing the run (FR-036, research R16). The counter is a plain
+    integer closed over by that filter rather than a set of paths: ``create``
+    counts each stored regular-file *member*, so a path named twice counts
+    twice (FR-039, research R22). This differs from :func:`write_members`,
+    which counts distinct destination paths; see the contract's *Scope
+    restriction on FR-048's count equality*.
+
+    No de-duplication of overlapping source paths is applied, and no
+    temporary file or rollback is used: a failure part-way through leaves a
+    partial archive on disk but never prints the summary line (research R21).
+    """
+    count = 0
+
+    def classify(info):
+        """Store regular files and directories, drop every other kind."""
+        nonlocal count
+        if info.isreg():
+            count += 1
+            return info
+        if info.isdir():
+            return info
+        return None
+
+    # This call order is not negotiable. tarfile.open(path, "w") truncates an
+    # existing file immediately, so every check that can reject the run has to
+    # happen above it or FR-043, FR-050, and FR-051 are all unenforceable
+    # (research R18). Sources precede the archive target because status 2
+    # outranks status 3 (FR-056).
+    validate_sources(args.paths)
+    validate_archive_target(args.archive, args.overwrite)
+
+    try:
+        with tarfile.open(args.archive, archive_mode(args.archive)) as tar:
+            # Command-line order is significant: it is the outer level of the
+            # order FR-035 fixes.
+            for path in args.paths:
+                tar.add(
+                    path,
+                    arcname=posixpath.normpath(path),
+                    recursive=True,
+                    filter=classify,
+                )
+    except OSError as exc:
+        # Backstop for everything that can only fail once writing has begun:
+        # a missing parent directory, an unwritable location, an unreadable
+        # source met during the walk. The OS supplies the offending path in
+        # exc.filename, which is what decides whether this is the archive's
+        # problem or a source's (contract *Diagnostics*, rows A5 and S5).
+        # Never swallowed, and the summary line is never printed (FR-053,
+        # FR-054, FR-055). A partial archive is left on disk: no temporary
+        # file, no rename, no rollback (research R21).
+        filename = getattr(exc, "filename", None)
+        reason = exc.strerror or str(exc)
+        if filename is None or filename == args.archive:
+            raise TarxError(
+                f"cannot write archive '{args.archive}': {reason}", EXIT_ERROR
+            )
+        raise TarxError(f"cannot add '{filename}': {reason}", EXIT_ERROR)
+
+    print(f"created {args.archive} with {count} files")
+    return EXIT_OK
+
+
