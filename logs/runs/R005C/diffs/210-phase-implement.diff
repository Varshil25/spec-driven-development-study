+"""FR-029 ... FR-042: the ``create`` subcommand's successful behaviour.
+
+One test module per concern, following the layout 001 established:
+
+* this file  -- invocation, what gets stored, naming, order, counting,
+  compression, and the summary line (FR-029 ... FR-042, SC-017)
+* ``test_create_overwrite.py`` -- overwrite protection (FR-043 ... FR-046)
+* ``test_create_failures.py``  -- round trips and every failure path
+  (FR-047 ... FR-056)
+
+Member names are read with ``conftest.member_names``, which opens the archive
+with ``tarfile`` directly. Asserting against this tool's own ``list`` would
+let a bug shared by the writer and the reader cancel out and pass.
+"""
+
+import tarfile
+import time
+
+import pytest
+
+from conftest import (
+    EXPECTED_PHOTO_MEMBERS,
+    SOURCE_FILE_COUNT,
+    is_gzip,
+    member_names,
+)
+
+# SC-017's budget, named rather than inlined, following the convention in
+# tests/test_performance.py. Research R23 measured 0.97 s plain and 1.98 s
+# gzip for 10,001 files, so this is a 15-30x margin.
+PERF_MEMBER_COUNT = 10_000
+PERF_DIR_COUNT = 100
+CREATE_BUDGET_SECONDS = 30.0
+
+
+def assert_created(result, archive, count):
+    """Assert the shape every successful ``create`` must have (FR-038).
+
+    Exactly one line on stdout, reading ``created ARCHIVE with N files`` with
+    ``ARCHIVE`` echoed as typed; empty stderr; exit status 0. The local-helper
+    convention mirrors ``assert_clean_failure`` in tests/test_failures.py.
+    """
+    assert result.returncode == 0
+    assert result.stdout == f"created {archive} with {count} files\n"
+    assert result.stderr == ""
+
+
+# --------------------------------------------------------------------------
+# FR-029, FR-030: the invocation surface
+# --------------------------------------------------------------------------
+
+
+def test_fr029_create_is_a_third_subcommand(run_tarx, source_tree):
+    """FR-029: ``create`` is accepted alongside ``list`` and ``extract``."""
+    result = run_tarx("create", "notes.tar", "notes.txt", cwd=source_tree)
+    assert_created(result, "notes.tar", 1)
+    assert (source_tree / "notes.tar").is_file()
+
+
+def test_fr029_all_three_subcommands_are_spelled_in_full(run_tarx):
+    """FR-029: the help text advertises exactly ``list``, ``extract``, ``create``."""
+    result = run_tarx("--help")
+    assert result.returncode == 0
+    for command in ("list", "extract", "create"):
+        assert command in result.stdout
+
+
+def test_fr030_archive_first_then_one_path(run_tarx, source_tree):
+    """FR-030: ``ARCHIVE`` is the first positional, then one or more ``PATH``."""
+    result = run_tarx("create", "one.tar", "photos", cwd=source_tree)
+    assert_created(result, "one.tar", 4)
+    # The archive is the *first* argument, so "one.tar" was not treated as a
+    # source path: it must not appear as a member of itself.
+    assert "one.tar" not in member_names(source_tree / "one.tar")
+
+
+def test_fr030_two_paths_in_one_invocation(run_tarx, source_tree):
+    """FR-030: two ``PATH`` arguments in a single invocation are accepted."""
+    result = run_tarx("create", "both.tar", "photos", "notes.txt", cwd=source_tree)
+    assert_created(result, "both.tar", SOURCE_FILE_COUNT)
+    assert member_names(source_tree / "both.tar") == list(EXPECTED_PHOTO_MEMBERS)
+
+
+def test_fr030_overwrite_accepted_on_a_path_that_does_not_exist(
+    run_tarx, source_tree
+):
+    """FR-030/FR-046: ``--overwrite`` parses, and is harmless, when nothing is there."""
+    result = run_tarx(
+        "create", "fresh.tar", "notes.txt", "--overwrite", cwd=source_tree
+    )
+    assert_created(result, "fresh.tar", 1)
+    assert member_names(source_tree / "fresh.tar") == ["notes.txt"]
+
+
+# --------------------------------------------------------------------------
+# FR-032, FR-038, FR-039: a single regular file
+# --------------------------------------------------------------------------
+
+
+def test_fr032_single_file_is_stored_byte_identically(run_tarx, source_tree):
+    """FR-032: a ``PATH`` naming a regular file stores its content verbatim."""
+    result = run_tarx("create", "notes.tar", "notes.txt", cwd=source_tree)
+    assert result.returncode == 0
+
+    archive = source_tree / "notes.tar"
+    assert member_names(archive) == ["notes.txt"]
+    with tarfile.open(archive) as tar:
+        stored = tar.extractfile("notes.txt").read()
+    assert stored == (source_tree / "notes.txt").read_bytes()
+
+
+def test_fr039_count_of_one_still_says_files(run_tarx, source_tree):
+    """FR-039: the word after ``N`` is the literal ``files``, even for ``N == 1``."""
+    result = run_tarx("create", "notes.tar", "notes.txt", cwd=source_tree)
+    assert result.stdout == "created notes.tar with 1 files\n"
+
+
+# --------------------------------------------------------------------------
+# FR-033, FR-034, FR-035: recursion, recorded names, and order
+# --------------------------------------------------------------------------
+
+
+def test_fr033_fr035_directory_recursion_in_specified_order(run_tarx, source_tree):
+    """FR-033/FR-035: every entry at any depth, in the one specified order.
+
+    Source paths in command-line order; within a directory, the directory's
+    own member first, then its entries in ``sorted()`` order with files and
+    subdirectories interleaved by name.
+    """
+    result = run_tarx("create", "photos.tar", "photos", "notes.txt", cwd=source_tree)
+    assert_created(result, "photos.tar", SOURCE_FILE_COUNT)
+    assert member_names(source_tree / "photos.tar") == list(EXPECTED_PHOTO_MEMBERS)
+
+
+def test_fr035_order_is_repeatable(run_tarx, source_tree):
+    """FR-035: the same tree and invocation give the same order every time."""
+    first = run_tarx("create", "a.tar", "photos", "notes.txt", cwd=source_tree)
+    second = run_tarx("create", "b.tar", "photos", "notes.txt", cwd=source_tree)
+    assert first.returncode == 0 and second.returncode == 0
+    assert member_names(source_tree / "a.tar") == member_names(source_tree / "b.tar")
+
+
+def test_fr034_recorded_names_are_normalised_relative_paths(run_tarx, source_tree):
+    """FR-034: no leading ``./``, no leading ``/``, no trailing separator."""
+    run_tarx("create", "photos.tar", "photos", "notes.txt", cwd=source_tree)
+    for name in member_names(source_tree / "photos.tar"):
+        assert not name.startswith("./"), name
+        assert not name.startswith("/"), name
+        assert not name.endswith("/"), name
+
+
+@pytest.mark.parametrize(
+    ("archive", "typed"),
+    [("slash.tar", "photos/"), ("dot.tar", "./photos")],
+)
+def test_fr034_equivalent_typed_forms_record_identical_names(
+    run_tarx, source_tree, archive, typed
+):
+    """FR-034: ``photos/`` and ``./photos`` record exactly what ``photos`` does.
+
+    The typed form is normalised lexically into the ``arcname``, so a trailing
+    separator and a leading ``./`` are both immaterial (data-model.md
+    *Accepted forms*, spec *Edge Cases*).
+    """
+    plain = run_tarx("create", "plain.tar", "photos", cwd=source_tree)
+    variant = run_tarx("create", archive, typed, cwd=source_tree)
+    assert plain.returncode == 0
+    assert_created(variant, archive, 4)
+    assert member_names(source_tree / archive) == member_names(
+        source_tree / "plain.tar"
+    )
+
+
+def test_fr039_directory_tree_counts_only_regular_files(run_tarx, source_tree):
+    """FR-039: ``N`` counts regular-file members, not directory members."""
+    result = run_tarx("create", "photos.tar", "photos", "notes.txt", cwd=source_tree)
+    assert_created(result, "photos.tar", 5)
+    names = member_names(source_tree / "photos.tar")
+    # Eight members recorded, five of them regular files.
+    assert len(names) == 8
+
+
+# --------------------------------------------------------------------------
+# FR-039: counting edge cases
+# --------------------------------------------------------------------------
+
+
+def test_fr039_tree_with_no_files_counts_zero(run_tarx, hollow_tree):
+    """FR-039: a tree of only directories reports ``with 0 files`` and exits 0.
+
+    US1 scenario 6. The directory member is still recorded, so the empty
+    directory survives a round trip.
+    """
+    result = run_tarx("create", "hollow.tar", "hollow", cwd=hollow_tree)
+    assert_created(result, "hollow.tar", 0)
+    assert member_names(hollow_tree / "hollow.tar") == ["hollow"]
+
+
+def test_fr039_zero_length_file_is_counted(run_tarx, source_tree):
+    """FR-039: a zero-length regular file is stored and *counted*.
+
+    Spec *Edge Cases*. ``photos/zero.bin`` holds no bytes; excluding it would
+    report 4 instead of 5.
+    """
+    result = run_tarx("create", "zero.tar", "photos/zero.bin", cwd=source_tree)
+    assert_created(result, "zero.tar", 1)
+    assert member_names(source_tree / "zero.tar") == ["photos/zero.bin"]
+    with tarfile.open(source_tree / "zero.tar") as tar:
+        assert tar.extractfile("photos/zero.bin").read() == b""
+
+
+def test_fr039_overlapping_paths_are_stored_and_counted_twice(run_tarx, source_tree):
+    """FR-039: no de-duplication -- a path named twice is stored twice.
+
+    Research R22: ``create`` counts each stored regular-file member, so the
+    same path named twice reports 2. ``extract`` counts distinct destination
+    paths and so reports 1; that documented divergence is pinned in
+    tests/test_create_failures.py.
+    """
+    result = run_tarx("create", "dup.tar", "notes.txt", "notes.txt", cwd=source_tree)
+    assert_created(result, "dup.tar", 2)
+    assert member_names(source_tree / "dup.tar") == ["notes.txt", "notes.txt"]
+
+
+# --------------------------------------------------------------------------
+# FR-036: entries of neither handled kind are skipped
+# --------------------------------------------------------------------------
+
+
+def test_fr036_symlink_and_fifo_met_while_walking_are_skipped(
+    run_tarx, special_tree
+):
+    """FR-036: a symlink and a FIFO inside a named directory are skipped.
+
+    Not stored, not counted, and *not an error*: the run still succeeds with
+    empty stderr. Note that a FIFO which was opened rather than skipped would
+    block forever waiting for a writer, so this also proves the walk never
+    opens one.
+    """
+    result = run_tarx("create", "special.tar", "photos", "notes.txt", cwd=special_tree)
+    assert_created(result, "special.tar", SOURCE_FILE_COUNT)
+
+    names = member_names(special_tree / "special.tar")
+    assert "photos/link.jpg" not in names
+    assert "photos/pipe" not in names
+    assert names == list(EXPECTED_PHOTO_MEMBERS)
+
+
+@pytest.mark.parametrize("entry", ["photos/link.jpg", "photos/pipe"])
+def test_fr036_entry_named_directly_is_skipped(run_tarx, special_tree, entry):
+    """FR-036: the same skipping applies to a directly-named source path.
+
+    The archive is still created, reports ``with 0 files``, and exits 0 --
+    FR-036 applies "whether named directly or encountered while walking".
+    """
+    result = run_tarx("create", "direct.tar", entry, cwd=special_tree)
+    assert_created(result, "direct.tar", 0)
+    assert member_names(special_tree / "direct.tar") == []
+
+
+# --------------------------------------------------------------------------
+# FR-037: the archive is never stored inside itself
+# --------------------------------------------------------------------------
+
+
+def test_fr037_archive_inside_a_named_directory_excludes_itself(
+    run_tarx, source_tree
+):
+    """FR-037: an archive written inside a named directory is not a member.
+
+    Without this the output would grow while it is being written, so the run
+    could not terminate with a bounded result.
+    """
+    result = run_tarx("create", "photos/inside.tar", "photos", cwd=source_tree)
+    assert result.returncode == 0
+
+    archive = source_tree / "photos" / "inside.tar"
+    assert archive.is_file()
+    assert "photos/inside.tar" not in member_names(archive)
+    assert_created(result, "photos/inside.tar", 4)
+
+
+# --------------------------------------------------------------------------
+# FR-040, FR-041, FR-042: compression chosen from the archive name alone
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "archive", ["photos.tar.gz", "photos.tgz", "photos.TGZ", "photos.TAR.GZ"]
+)
+def test_fr040_recognised_suffixes_are_gzip_compressed(
+    run_tarx, source_tree, archive
+):
+    """FR-040: ``.tar.gz`` and ``.tgz`` are written gzip-compressed.
+
+    The comparison is case-insensitive (spec *Assumptions*), so ``.TGZ`` and
+    ``.TAR.GZ`` are recognised too.
+    """
+    result = run_tarx("create", archive, "photos", "notes.txt", cwd=source_tree)
+    assert_created(result, archive, SOURCE_FILE_COUNT)
+
+    path = source_tree / archive
+    assert is_gzip(path)
+    with tarfile.open(path, "r:gz") as tar:
+        assert [member.name for member in tar] == list(EXPECTED_PHOTO_MEMBERS)
+
+
+@pytest.mark.parametrize("archive", ["photos.tar", "bundle", "bundle.bin"])
+def test_fr041_other_names_are_written_uncompressed(run_tarx, source_tree, archive):
+    """FR-041: any other name, including no suffix at all, is a plain tar."""
+    result = run_tarx("create", archive, "photos", "notes.txt", cwd=source_tree)
+    assert_created(result, archive, SOURCE_FILE_COUNT)
+
+    path = source_tree / archive
+    assert not is_gzip(path)
+    with tarfile.open(path, "r:") as tar:
+        assert [member.name for member in tar] == list(EXPECTED_PHOTO_MEMBERS)
+
+
+def test_fr042_source_names_and_contents_do_not_affect_compression(
+    run_tarx, tmp_path
+):
+    """FR-042: only the typed archive name is consulted, never a source.
+
+    The source tree's single file is named ``blob.tgz`` *and* holds real gzip
+    data. A tool that sniffed the source rather than the archive name would
+    produce a compressed archive here; the archive name has no recognised
+    suffix, so it must be plain.
+    """
+    tree = tmp_path / "gzsource"
+    tree.mkdir()
+    (tree / "blob.tgz").write_bytes(b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\x03")
+
+    result = run_tarx("create", "bundle", "blob.tgz", cwd=tree)
+    assert_created(result, "bundle", 1)
+    assert not is_gzip(tree / "bundle")
+
+
+def test_fr038_archive_path_is_echoed_exactly_as_typed(run_tarx, source_tree):
+    """FR-038: the summary line echoes ``ARCHIVE`` verbatim, unnormalised.
+
+    ``./photos.tar`` is reported as ``./photos.tar``, not ``photos.tar``, so
+    the message matches what the user wrote.
+    """
+    result = run_tarx("create", "./photos.tar", "photos", "notes.txt", cwd=source_tree)
+    assert_created(result, "./photos.tar", SOURCE_FILE_COUNT)
+    assert (source_tree / "photos.tar").is_file()
+
+
+# --------------------------------------------------------------------------
+# SC-017: 10,000 files, compressed and not, inside the stated budget
+# --------------------------------------------------------------------------
+
