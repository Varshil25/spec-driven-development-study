+DIRECTORY_MEMBERS = frozenset({"photos", "photos/empty", "photos/raw"})
+
+GNU_TAR = "/usr/bin/tar"
+
+
+def gnu_tar_names():
+    """The member names GNU ``tar -tf`` must print, in archive order."""
+    return [
