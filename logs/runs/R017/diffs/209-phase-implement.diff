index 0000000..7eb2ee2
--- /dev/null
+++ b/src/pastebin/store.py
@@ -0,0 +1,207 @@
+"""Durable paste storage: one UTF-8 JSON record per paste under the data directory.
+
+The store is keyed by exact identifier only — it never enumerates the directory, so
+foreign files are structurally invisible (data-model.md "Integrity and containment
+rules").
+"""
+
+from __future__ import annotations
+
+import datetime
+import hmac
+import json
+import os
+import secrets
+import threading
+
+from . import models
+
+#: Outcomes of :meth:`PasteStore.delete_record`.
+NOT_FOUND = "not_found"
+FORBIDDEN = "forbidden"
+DELETED = "deleted"
+
+#: Bound on identifier-collision retries before failing closed (SR-010).
+_MAX_ID_ATTEMPTS = 5
+
+
+class PasteStore:
+    """Filesystem-backed collection of pastes under a single data directory."""
+
+    def __init__(self, data_dir: str) -> None:
+        self._dir = os.path.realpath(data_dir)
+        # One lock guards the whole check-and-remove sequence (SR-007, R-09).
+        # Reads deliberately take no lock: ``os.replace`` and a single ``unlink``
+        # already give readers all-or-nothing.
+        self._lock = threading.Lock()
+
+    @property
+    def data_dir(self) -> str:
+        return self._dir
+
+    # --- Path containment ---------------------------------------------------
+
+    def _record_path(self, paste_id: str) -> str | None:
+        """Resolve a paste identifier to its record path, or ``None`` (SR-003, R-07).
+
+        Two layers, in this order:
+
+        1. The identifier must match the allowlist. Anything else returns ``None``
+           without touching the filesystem at all.
+        2. The joined path, once symlinks are resolved, must still lie inside the
+           data directory. On a legitimate request this can never fire — it is
+           defence in depth against a validly-named record that is a symlink out of
+           the directory.
+        """
+        if not isinstance(paste_id, str) or not models.is_valid_id(paste_id):
+            return None
+        candidate = os.path.join(self._dir, paste_id + ".json")
+        resolved = os.path.realpath(candidate)
+        if not resolved.startswith(self._dir + os.sep):
+            return None
+        return candidate
+
+    # --- Write --------------------------------------------------------------
+
+    def write_record(self, record: dict) -> str:
+        """Persist a new paste, assigning it a fresh identifier; returns that id.
+
+        The record is written to an ``O_EXCL`` temp file in the *same* directory with
+        mode ``0600`` set at creation — never ``chmod`` afterwards, which would leave
+        the permissive window SR-008 forbids — then ``fsync``ed and moved into place
+        with ``os.replace`` so a concurrent reader sees the complete file or no file
+        (R-03, SR-007, FR-023).
+        """
+        for _ in range(_MAX_ID_ATTEMPTS):
+            paste_id = models.new_id()
+            final = os.path.join(self._dir, paste_id + ".json")
+            if os.path.exists(final):
+                continue
+
+            stored = dict(record)
+            stored["id"] = paste_id
+            payload = json.dumps(stored, ensure_ascii=False).encode("utf-8")
+
+            tmp = os.path.join(
+                self._dir, f".{paste_id}.json.{secrets.token_hex(8)}.tmp"
+            )
+            try:
+                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+            except FileExistsError:
+                continue
+            try:
+                with os.fdopen(fd, "wb") as handle:
+                    handle.write(payload)
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(tmp, final)
+            except BaseException:
+                # Never leave a temp file behind on any failure path.
+                try:
+                    os.unlink(tmp)
+                except FileNotFoundError:
+                    pass
+                raise
+            return paste_id
+
+        # Fail closed rather than return a paste the caller cannot address (SR-010).
+        raise RuntimeError("could not allocate a unique paste identifier")
+
+    # --- Read ---------------------------------------------------------------
+
+    def _load(self, paste_id: str) -> dict | None:
+        """Read and parse a record, or ``None`` if it is absent or unusable.
+
+        A record that is unreadable, not valid UTF-8, not valid JSON, not a JSON
+        object, or missing any required field is treated as a paste that does not
+        exist: it never raises, never prevents startup, and never affects any other
+        paste (FR-024).
+        """
+        path = self._record_path(paste_id)
+        if path is None:
+            return None
+        try:
+            with open(path, "rb") as handle:
+                raw = handle.read()
+        except (OSError, ValueError):
+            return None
+        try:
+            record = json.loads(raw.decode("utf-8"))
+        except (UnicodeDecodeError, ValueError):
+            return None
+        if type(record) is not dict:
+            return None
+        if any(field not in record for field in models.RECORD_FIELDS):
+            return None
+        return record
+
+    def read_record(self, paste_id: str) -> dict | None:
+        """Return the live record for ``paste_id``, or ``None``.
+
+        ``None`` covers every way a paste can fail to exist: an identifier outside
+        the allowlist, an absent file, a corrupt record, and an expired one.
+        """
+        record = self._load(paste_id)
+        if record is None:
+            return None
+        if not is_live(record, models.now_utc()):
+            return None
+        return record
+
+    # --- Delete -------------------------------------------------------------
+
+    def delete_record(self, paste_id: str, token: str) -> str:
+        """Revoke a paste; returns ``NOT_FOUND``, ``FORBIDDEN``, or ``DELETED``.
+
+        The whole read → liveness-check → token-compare → ``unlink`` sequence is held
+        under one lock so the check and the removal are atomic with respect to
+        concurrent requests (SR-007, R-09).
+
+        Evaluation order is load-bearing: existence and liveness are checked *before*
+        the token, so an unknown or expired identifier is ``NOT_FOUND`` regardless of
+        the token supplied — non-existence is reported in preference to a permission
+        failure (FR-021).
+        """
+        with self._lock:
+            record = self.read_record(paste_id)
+            if record is None:
+                return NOT_FOUND
+
+            stored = record.get("delete_token")
+            if type(stored) is not str:
+                return NOT_FOUND
+            # Constant-time comparison, never ``==`` (SR-002).
+            if not hmac.compare_digest(token, stored):
+                return FORBIDDEN
+
+            path = self._record_path(paste_id)
+            if path is None:
+                return NOT_FOUND
+            try:
+                os.unlink(path)
+            except FileNotFoundError:
+                return NOT_FOUND
+            return DELETED
+
+
+def is_live(record: dict, now: datetime.datetime) -> bool:
+    """The liveness predicate (data-model.md), evaluated against the current clock.
+
+    ``live ⟺ record exists ∧ record parses ∧ (expires_at is null ∨ now <= expires_at)``
+
+    The bound is **inclusive**: a paste is readable up to and including its expiry
+    instant, and not after (FR-017, Edge Case "Expiry exactly now"). Nothing is
+    rewritten or deleted on expiry — an expired record is permitted to linger on disk
+    and simply stops passing this predicate, which is what makes FR-018's restart
+    clause automatic with no startup scan.
+    """
+    expires_at = record.get("expires_at")
+    if expires_at is None:
+        return True
+    if type(expires_at) is not str:
+        return False
+    try:
+        deadline = models.parse_timestamp(expires_at)
+    except ValueError:
+        return False
+    return now <= deadline
