+++ b/tests/test_create.py
@@ -0,0 +1,317 @@
+"""Creation, body validation, framing, and size limits.
+
+Covers FR-005, FR-006, FR-007, FR-009, FR-010, FR-026, FR-027, FR-029, SR-004, SR-005.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+
+import pytest
+
+from conftest import build_head, max_rss_bytes
+from test_security import directory_snapshot
+
+CONTENT_CAP = 65536
+BODY_CAP = 66560
+
+
+def encode(payload) -> bytes:
+    """Compact UTF-8 JSON — ``ensure_ascii=False`` so multi-byte text stays multi-byte."""
+    return json.dumps(payload, ensure_ascii=False).encode("utf-8")
+
+
+def post_compact(server, payload):
+    return server.post_raw(encode(payload), {"Content-Type": "application/json"})
+
+
+# --- FR-005, FR-006, FR-010: the accepted shape -----------------------------------
+
+
+def test_FR_005_content_only_is_accepted(server):
+    """FR-005: an object carrying only ``content`` creates a paste."""
+    response = server.post_json({"content": "hello"})
+
+    assert response.status == 201
+    assert response.header("Content-Type") == "application/json; charset=utf-8"
+
+
+def test_FR_005_content_with_expires_in_is_accepted(server):
+    """FR-005: ``content`` plus a valid ``expires_in`` creates a paste."""
+    assert server.post_json({"content": "hello", "expires_in": 3600}).status == 201
+
+
+def test_FR_010_created_response_has_exactly_id_token_and_url(server):
+    """FR-010, FR-011: the 201 body is exactly ``id``, ``delete_token``, and ``url``."""
+    body = server.post_json({"content": "hello"}).json()
+
+    assert set(body) == {"id", "delete_token", "url"}
+    assert body["url"] == f"/pastes/{body['id']}"
+    assert len(body["id"]) == 22
+    assert len(body["delete_token"]) == 43
+
+
+def test_FR_006_missing_content_is_rejected(server):
+    """FR-006, FR-026: ``content`` is required."""
+    response = server.post_json({"expires_in": 60})
+
+    assert response.status == 400
+    assert response.json() == {"error": "content is required"}
+
+
+@pytest.mark.parametrize("value", [5, 5.0, True, False, None, [], {}, ["a"]])
+def test_FR_006_non_string_content_is_rejected(server, value):
+    """FR-006, FR-026: ``content`` must be a text value, not a number or structure."""
+    response = server.post_json({"content": value})
+
+    assert response.status == 400
+    assert response.json() == {"error": "content must be a string"}
+
+
+def test_FR_006_empty_content_is_accepted_and_stored_as_empty(server):
+    """FR-006: the empty string is valid content, not a missing value."""
+    created = server.create("")
+
+    read = server.get(f"/pastes/{created['id']}")
+    assert read.status == 200
+    assert read.json()["content"] == ""
+
+    raw = server.get(f"/pastes/{created['id']}/raw")
+    assert raw.status == 200
+    assert raw.body == b""
+    assert raw.header("Content-Length") == "0"
+
+
+def test_FR_009_unknown_fields_are_ignored_and_never_stored(server):
+    """FR-009: fields other than ``content`` and ``expires_in`` are ignored."""
+    created = server.create(
+        "hello",
+        colour="green",
+        id="attacker-chosen-id",
+        delete_token="attacker-chosen-token",
+        created_at="1999-01-01T00:00:00Z",
+        expires_at="1999-01-01T00:00:00Z",
+    )
+
+    assert created["id"] != "attacker-chosen-id"
+    assert created["delete_token"] != "attacker-chosen-token"
+
+    read = server.get(f"/pastes/{created['id']}").json()
+    assert set(read) == {"id", "content", "created_at", "expires_at"}
+    assert "colour" not in read
+    assert read["id"] == created["id"]
+    assert read["created_at"] != "1999-01-01T00:00:00Z"
+    assert read["expires_at"] is None
+
+
+# --- FR-026, SR-004: malformed bodies ---------------------------------------------
+
+MALFORMED_BODIES = [
+    (b"", "empty body"),
+    (b"not json at all", "plain text"),
+    (b"{", "truncated object"),
+    (b'{"content": "x",}', "trailing comma"),
+    (b'["content"]', "bare list"),
+    (b"42", "bare number"),
+    (b'"a string"', "bare string"),
+    (b"null", "bare null"),
+    (b"true", "bare true"),
+    (b"false", "bare false"),
+    (b"[]", "empty list"),
+    (b"\xff\xfe\x00bad utf-8", "invalid UTF-8"),
+]
+
+
+@pytest.mark.parametrize("body,label", MALFORMED_BODIES, ids=[l for _, l in MALFORMED_BODIES])
+def test_FR_026_malformed_body_is_400_and_creates_nothing(server, body, label):
+    """FR-026, SR-004: a body that is not a JSON object is 400 and stores nothing."""
+    before = directory_snapshot(server.data_dir)
+
+    response = server.post_raw(body, {"Content-Type": "application/json"})
+
+    assert response.status == 400, (label, response.status)
+    assert set(response.json()) == {"error"}
+    assert response.json()["error"]
+    assert directory_snapshot(server.data_dir) == before, (
+        "SR-004: a rejected body must leave the data directory byte-for-byte unchanged"
+    )
+
+
+def test_FR_026_invalid_utf8_body_names_the_encoding_rule(server):
+    """FR-026: a body that is not valid UTF-8 is rejected before it is parsed."""
+    response = server.post_raw(b'{"content": "\xff\xfe"}')
+
+    assert response.status == 400
+    assert response.json() == {"error": "request body must be valid UTF-8"}
+
+
+def test_FR_026_every_rejection_leaves_the_store_unchanged(server):
+    """SR-004: no rejected creation leaves a temp file or a partial record behind."""
+    server.create("baseline")
+    before = directory_snapshot(server.data_dir)
+
+    for body, _ in MALFORMED_BODIES:
+        server.post_raw(body)
+    server.post_json({"content": 5})
+    server.post_json({"expires_in": 60})
+    server.post_json({"content": "x", "expires_in": 0})
+
+    assert directory_snapshot(server.data_dir) == before
+
+
+# --- FR-007, FR-027: size limits --------------------------------------------------
+
+
+def test_FR_007_content_of_exactly_the_cap_is_accepted(server):
+    """FR-007: content encoding to exactly 65 536 bytes is accepted."""
+    content = "a" * CONTENT_CAP
+    assert len(content.encode("utf-8")) == CONTENT_CAP
+
+    response = post_compact(server, {"content": content})
+
+    assert response.status == 201
+    read = server.get(f"/pastes/{response.json()['id']}/raw")
+    assert read.body == content.encode("utf-8")
+
+
+def test_FR_007_content_one_byte_over_the_cap_is_413(server):
+    """FR-007, FR-027: content encoding to 65 537 bytes is rejected with 413."""
+    response = post_compact(server, {"content": "a" * (CONTENT_CAP + 1)})
+
+    assert response.status == 413
+    assert response.json() == {
+        "error": "content exceeds the maximum size of 65536 bytes"
+    }
+
+
+def test_FR_007_limit_is_encoded_bytes_not_characters(server):
+    """FR-007: the cap counts UTF-8 bytes — a 16 384-character body can still be 64 KiB."""
+    # Each of these characters encodes to four bytes.
+    at_cap = "\U0001f30d" * (CONTENT_CAP // 4)
+    assert len(at_cap) == 16384
+    assert len(at_cap.encode("utf-8")) == CONTENT_CAP
+
+    accepted = post_compact(server, {"content": at_cap})
+    assert accepted.status == 201, "a 16 384-character body within the byte cap"
+
+    over_cap = "\U0001f30d" * (CONTENT_CAP // 4 + 1)
+    assert len(over_cap) == 16385
+    assert len(over_cap.encode("utf-8")) == CONTENT_CAP + 4
+
+    rejected = post_compact(server, {"content": over_cap})
+    assert rejected.status == 413, "16 385 characters is 65 540 bytes — over the cap"
+
+
+def test_FR_027_oversized_but_otherwise_valid_body_is_413_not_400_or_201(server):
+    """FR-027: 413 takes precedence over every other outcome for an oversized body."""
+    before = directory_snapshot(server.data_dir)
+
+    response = post_compact(
+        server, {"content": "a" * (CONTENT_CAP + 1), "expires_in": 3600, "extra": "ok"}
+    )
+
+    assert response.status == 413
+    assert directory_snapshot(server.data_dir) == before
+
+
+# --- SR-005, FR-029: framing and bounded memory -----------------------------------
+
+
+def test_SR_005_missing_content_length_is_400(server):
+    """SR-005: a request that declares no body length is rejected."""
+    response = server.send_raw(build_head("POST", "/pastes", server.port))
+
+    assert response.status == 400
+    assert response.json() == {
+        "error": "request must declare a valid Content-Length"
+    }
+
+
+@pytest.mark.parametrize("value", ["", "abc", "-1", "1 2", "12,13"])
+def test_SR_005_malformed_content_length_is_400(server, value):
+    """SR-005: a ``Content-Length`` that is not a non-negative integer is rejected."""
+    response = server.send_raw(
+        build_head("POST", "/pastes", server.port, {"Content-Length": value})
+    )
+
+    assert response.status == 400
+    assert response.json()["error"] == "request must declare a valid Content-Length"
+
+
+def test_SR_005_chunked_transfer_encoding_is_400(server):
+    """SR-005: chunked framing is rejected rather than streamed."""
+    response = server.send_raw(
+        build_head(
+            "POST", "/pastes", server.port, {"Transfer-Encoding": "chunked"}
+        ),
+        b"5\r\nhello\r\n0\r\n\r\n",
+    )
+
+    assert response.status == 400
+    assert response.json()["error"] == "request must declare a valid Content-Length"
+
+
+def test_SR_005_short_body_is_400_and_does_not_hang(server):
+    """SR-005: a ``Content-Length`` larger than the bytes delivered is 400, not a hang."""
+    started = time.monotonic()
+    response = server.send_raw(
+        build_head("POST", "/pastes", server.port, {"Content-Length": "4096"}),
+        b'{"content": "short"}',
+        timeout=20,
+    )
+    elapsed = time.monotonic() - started
+
+    assert response.status == 400
+    assert response.json() == {
+        "error": "request body was shorter than the declared Content-Length"
+    }
+    assert elapsed < 15, "SR-005: the server must not wait indefinitely for the rest"
+
+
+def test_FR_029_oversized_declaration_is_refused_without_reading_the_body(server):
+    """FR-029, SC-007, SR-005: a 50 MB declaration is 413 with memory left flat.
+
+    Not one byte of the declared body is sent, yet the 413 still arrives — which is
+    direct proof that the server never waited for, nor buffered, the payload.
+    """
+    before = max_rss_bytes()
+
+    response = server.send_raw(
+        build_head("POST", "/pastes", server.port, {"Content-Length": "50000000"})
+    )
+
+    after = max_rss_bytes()
+
+    assert response.status == 413
+    assert response.json() == {
+        "error": "content exceeds the maximum size of 65536 bytes"
+    }
+    assert response.header("Connection") == "close", (
+        "SR-005: an unread body makes connection reuse a smuggling hazard"
+    )
+    assert after - before < 5 * 1024 * 1024, (
+        f"SC-007: resident memory grew by {after - before} bytes"
+    )
+
+
+def test_FR_029_declaration_just_over_the_envelope_cap_is_413(server):
+    """FR-029: the pre-body cap is the content limit plus envelope slack."""
+    assert (
+        server.send_raw(
+            build_head(
+                "POST", "/pastes", server.port, {"Content-Length": str(BODY_CAP + 1)}
+            )
+        ).status
+        == 413
+    )
+
+
+def test_FR_029_service_still_serves_after_an_oversized_submission(server):
+    """FR-029: refusing a huge submission does not disturb the service."""
+    server.send_raw(
+        build_head("POST", "/pastes", server.port, {"Content-Length": "50000000"})
+    )
+
+    created = server.create("still working")
+    assert server.get(f"/pastes/{created['id']}").status == 200
