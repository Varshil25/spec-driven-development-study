new file mode 100644
index 0000000..80da716
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,24 @@
+[build-system]
+requires = ["setuptools>=68"]
+build-backend = "setuptools.build_meta"
+
+[project]
+name = "pastebin"
+version = "1.0.0"
+description = "Loopback-only HTTP service for sharing text snippets"
+requires-python = ">=3.11"
+# Constitution Principle I — Standard Library Only: this list MUST stay empty.
+dependencies = []
+
+[project.optional-dependencies]
+dev = ["pytest"]
+
+[tool.setuptools]
+package-dir = {"" = "src"}
+
+[tool.setuptools.packages.find]
+where = ["src"]
+
+[tool.pytest.ini_options]
+pythonpath = ["src"]
+testpaths = ["tests"]
