@@ -0,0 +1,394 @@
+"""HTTP surface: a threading server over a closed four-route table.
+
+Every stdlib default that would leak internals — the ``Server`` banner, the request
+log, the HTML error pages — is overridden here rather than left to chance (R-11,
+SR-009).
+"""
+
+from __future__ import annotations
+
+import http.server
+import json
+import os
+import threading
+import urllib.parse
+
+from . import models, store
+
+#: The only address this service ever binds (SR-011). There is no option to change it.
+HOST = "127.0.0.1"
+
+_JSON_CONTENT_TYPE = "application/json; charset=utf-8"
+_TEXT_CONTENT_TYPE = "text/plain; charset=utf-8"
+
+
+class PastebinHandler(http.server.BaseHTTPRequestHandler):
+    """Request handler: framing guard, closed routing table, JSON-only errors."""
+
+    protocol_version = "HTTP/1.1"
+
+    #: An idle keep-alive connection is closed after this many seconds. Without it a
+    #: client that opens a connection and never writes holds a thread indefinitely
+    #: (SR-005: bound what a single input may consume).
+    timeout = 30
+
+    # --- Redaction overrides (SR-009, R-11) ---------------------------------
+
+    def version_string(self) -> str:
+        """Fixed ``Server`` header — suppresses the ``BaseHTTP/x.y Python/z`` banner."""
+        return "pastebin"
+
+    def log_message(self, format: str, *args) -> None:  # noqa: A002 - stdlib signature
+        """Request logging is suppressed entirely: identifiers are capability URLs."""
+
+    def log_request(self, code="-", size="-") -> None:
+        """Request logging is suppressed entirely (FR-003, SR-009)."""
+
+    def log_error(self, format: str, *args) -> None:  # noqa: A002 - stdlib signature
+        """Error logging is suppressed entirely (SR-009)."""
+
+    def send_error(self, code, message=None, explain=None) -> None:
+        """Route every stdlib-originated error through the JSON error body.
+
+        Without this override, an unsupported method or a malformed request line
+        would produce the stock HTML error page, which carries the Python version and
+        the request path (SR-009), and a ``501`` rather than the ``404`` FR-028
+        requires. The connection is closed because an unsupported method may have
+        left an unread body on it, and a reused connection would misparse those bytes
+        as the next request.
+        """
+        self._send_json_error(404, models.MSG_NOT_FOUND, {"Connection": "close"})
+
+    # --- Response helpers ---------------------------------------------------
+
+    def _send_bytes(
+        self,
+        status: int,
+        content_type: str | None,
+        body: bytes,
+        extra_headers: dict[str, str] | None = None,
+    ) -> None:
+        extra = dict(extra_headers or {})
+        if self.close_connection and not any(
+            name.lower() == "connection" for name in extra
+        ):
+            # The caller decided this connection must not be reused; tell the client
+            # so, rather than closing under it.
+            extra["Connection"] = "close"
+
+        self.send_response(status)
+        if content_type is not None:
+            self.send_header("Content-Type", content_type)
+        self.send_header("Content-Length", str(len(body)))
+        for name, value in extra.items():
+            self.send_header(name, value)
+        self.end_headers()
+        if body:
+            self.wfile.write(body)
+
+    def _send_json(
+        self, status: int, payload: dict, extra_headers: dict[str, str] | None = None
+    ) -> None:
+        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
+        self._send_bytes(status, _JSON_CONTENT_TYPE, body, extra_headers)
+
+    def _send_json_error(
+        self, status: int, message: str, extra_headers: dict[str, str] | None = None
+    ) -> None:
+        """Every non-2xx response carries exactly ``{"error": "<message>"}`` (FR-025).
+
+        The message names the rule that was broken; it never echoes an input value, a
+        stored value, a path, or internal state (SR-009).
+        """
+        self._send_json(status, {"error": message}, extra_headers)
+
+    # --- Routing ------------------------------------------------------------
+
+    def _segments(self) -> list[str]:
+        """Path segments, each percent-decoded individually (R-07).
+
+        The query string is discarded first. Each segment is unquoted *separately* —
+        unquoting the whole path would let ``%2F`` manufacture new segments and
+        re-enter routing.
+        """
+        path = urllib.parse.urlsplit(self.path).path
+        return [urllib.parse.unquote(part) for part in path.split("/")[1:]]
+
+    def _declares_body(self) -> bool:
+        """True when the request announces a body, however it is framed."""
+        if self.headers.get("Transfer-Encoding"):
+            return True
+        raw = self.headers.get("Content-Length")
+        if raw is None:
+            return False
+        try:
+            return int(raw) > 0
+        except ValueError:
+            return True
+
+    def _dispatch(self, method: str, segments: list[str]) -> None:
+        """The closed route table: exactly four rows, everything else is 404.
+
+        There is no ``405`` and no ``Allow`` header — an unrecognised action on a
+        known address is reported as not found (FR-028).
+        """
+        if method == "POST" and segments == ["pastes"]:
+            self._handle_create()
+            return
+        if len(segments) == 2 and segments[0] == "pastes":
+            paste_id = segments[1]
+            if method == "GET":
+                self._handle_read(paste_id)
+                return
+            if method == "DELETE":
+                self._handle_delete(paste_id)
+                return
+        if (
+            method == "GET"
+            and len(segments) == 3
+            and segments[0] == "pastes"
+            and segments[2] == "raw"
+        ):
+            self._handle_raw(segments[1])
+            return
+
+        self._send_json_error(404, models.MSG_NOT_FOUND)
+
+    def _handle(self, method: str) -> None:
+        self.server.enter_request()
+        try:
+            self._handle_inner(method)
+        finally:
+            self.server.leave_request()
+
+    def _handle_inner(self, method: str) -> None:
+        try:
+            segments = self._segments()
+            if self._declares_body() and not (
+                method == "POST" and segments == ["pastes"]
+            ):
+                # ``POST /pastes`` is the only route that reads a body. If any other
+                # request declares one, the connection must not be reused: the unread
+                # bytes would be misparsed as the next request (request smuggling).
+                self.close_connection = True
+            self._dispatch(method, segments)
+        except Exception:
+            # Fail closed and loud: a generic 500 in the standard shape, with no
+            # content, no partial content, and no diagnostics (SR-010). This is not a
+            # swallowed exception — the failure is reported, never masked as success.
+            try:
+                self._send_json_error(500, models.MSG_INTERNAL)
+            except Exception:
+                self.close_connection = True
+
+    def do_GET(self) -> None:
+        self._handle("GET")
+
+    def do_POST(self) -> None:
+        self._handle("POST")
+
+    def do_DELETE(self) -> None:
+        self._handle("DELETE")
+
+    def do_HEAD(self) -> None:
+        """``HEAD`` is not in the route table, so it is always ``404`` (FR-028).
+
+        It is handled explicitly rather than falling through to ``send_error`` only
+        so that no content is written: RFC 9110 forbids content in a response to
+        ``HEAD``. The status line and headers are exactly those of the corresponding
+        ``GET`` error, including the absence of any ``Allow`` header.
+        """
+        if self._declares_body():
+            self.close_connection = True
+        body = json.dumps({"error": models.MSG_NOT_FOUND}, ensure_ascii=False).encode(
+            "utf-8"
+        )
+        self.send_response(404)
+        self.send_header("Content-Type", _JSON_CONTENT_TYPE)
+        # The length the corresponding GET would send, with no content written.
+        self.send_header("Content-Length", str(len(body)))
+        if self.close_connection:
+            self.send_header("Connection", "close")
+        self.end_headers()
+
+    # --- Handlers -----------------------------------------------------------
+
+    @property
+    def _store(self) -> store.PasteStore:
+        return self.server.store
+
+    def _read_body(self) -> bytes | None:
+        """Framing guard, applied before any body byte is read (R-06, SR-005, FR-029).
+
+        Returns the body, or ``None`` after having already sent the error response.
+        """
+        def reject_framing():
+            # The body's extent is unknown or untrusted, so whatever bytes follow
+            # cannot be skipped safely; the connection must not be reused.
+            self.close_connection = True
+            self._send_json_error(400, models.MSG_BAD_FRAMING)
+            return None
+
+        if self.headers.get("Transfer-Encoding"):
+            return reject_framing()
+
+        raw_length = self.headers.get("Content-Length")
+        if raw_length is None:
+            return reject_framing()
+        try:
+            length = int(raw_length)
+        except ValueError:
+            return reject_framing()
+        if length < 0:
+            return reject_framing()
+
+        if length > models.MAX_BODY_BYTES:
+            # Refuse without reading a single byte, so memory stays bounded however
+            # much the caller attempts to send (FR-029, SC-007). Closing the
+            # connection is mandatory: an unread body on a reused connection could be
+            # misparsed as the next request.
+            self.close_connection = True
+            self._send_json_error(
+                413, models.MSG_TOO_LARGE, {"Connection": "close"}
+            )
+            return None
+
+        body = self.rfile.read(length)
+        if len(body) != length:
+            self.close_connection = True
+            self._send_json_error(400, models.MSG_SHORT_BODY)
+            return None
+        return body
+
+    def _handle_create(self) -> None:
+        body = self._read_body()
+        if body is None:
+            return
+
+        try:
+            content, expires_in = models.validate_create_payload(body)
+        except models.ValidationError as error:
+            self._send_json_error(error.status, error.message)
+            return
+
+        created = models.now_utc()
+        record = {
+            "id": "",  # replaced by the store with the identifier it allocates
+            "content": content,
+            "created_at": models.format_timestamp(created),
+            "expires_at": models.compute_expires_at(created, expires_in),
+            "delete_token": models.new_delete_token(),
+        }
+        paste_id = self._store.write_record(record)
+        self._send_json(
+            201,
+            {
+                "id": paste_id,
+                "delete_token": record["delete_token"],
+                "url": f"/pastes/{paste_id}",
+            },
+        )
+
+    def _handle_read(self, paste_id: str) -> None:
+        record = self._store.read_record(paste_id)
+        if record is None:
+            self._send_json_error(404, models.MSG_NOT_FOUND)
+            return
+        # Exactly four fields. ``delete_token`` is never included in the body or in
+        # any header (FR-012, FR-013, SR-009).
+        self._send_json(
+            200,
+            {
+                "id": record["id"],
+                "content": record["content"],
+                "created_at": record["created_at"],
+                "expires_at": record["expires_at"],
+            },
+        )
+
+    def _handle_raw(self, paste_id: str) -> None:
+        record = self._store.read_record(paste_id)
+        if record is None:
+            # The error shape stays JSON even though the success shape is plain text.
+            self._send_json_error(404, models.MSG_NOT_FOUND)
+            return
+        # Verbatim bytes: no trailing newline, no BOM, no JSON wrapper. The length is
+        # the encoded byte count, never ``len(str)`` (FR-014, FR-016, R-13).
+        body = record["content"].encode("utf-8")
+        self._send_bytes(
+            200,
+            _TEXT_CONTENT_TYPE,
+            body,
+            {"X-Content-Type-Options": "nosniff"},
+        )
+
+    def _handle_delete(self, paste_id: str) -> None:
+        token=[REDACTED:assigned_secret]("X-Delete-Token") or ""
+        # ``compare_digest`` raises TypeError on a non-ASCII ``str``; reject those
+        # characters up front rather than letting the guard itself fail (SR-004).
+        if not token.isascii():
+            token = ""
+
+        outcome = self._store.delete_record(paste_id, token)
+        if outcome == store.DELETED:
+            self._send_bytes(204, None, b"")
+        elif outcome == store.FORBIDDEN:
+            self._send_json_error(403, models.MSG_BAD_TOKEN)
+        else:
+            self._send_json_error(404, models.MSG_NOT_FOUND)
+
+
+class PastebinHTTPServer(http.server.ThreadingHTTPServer):
+    """One thread per request, holding the store handlers reach via ``self.server``."""
+
+    daemon_threads = True
+    # ``allow_reuse_address`` is inherited from ``HTTPServer`` (it sets ``SO_REUSEADDR``,
+    # which only permits rebinding a port left in TIME_WAIT). It does not permit a
+    # second *listener* on an address another process is actively bound to, so a
+    # start against a port already in use still fails — which FR-004 depends on.
+    # ``SO_REUSEPORT``, which would permit that, is never set.
+
+    def __init__(self, port: int, data_dir: str) -> None:
+        self.store = store.PasteStore(data_dir)
+        self._in_flight = 0
+        self._idle = threading.Condition()
+        super().__init__((HOST, port), PastebinHandler)
+
+    # -- shutdown: in-flight requests are allowed to complete (contracts/cli.md) --
+
+    def enter_request(self) -> None:
+        with self._idle:
+            self._in_flight += 1
+
+    def leave_request(self) -> None:
+        with self._idle:
+            self._in_flight -= 1
+            if self._in_flight == 0:
+                self._idle.notify_all()
+
+    def await_idle(self, timeout: float) -> bool:
+        """Block until no request is being processed, or ``timeout`` elapses.
+
+        Handler threads are daemons, so the interpreter would otherwise stop them
+        mid-response. Waiting here is what lets an in-flight request finish. The wait
+        is bounded so a wedged request cannot prevent the process from exiting.
+        """
+        with self._idle:
+            return self._idle.wait_for(lambda: self._in_flight == 0, timeout)
+
+    def handle_error(self, request, client_address) -> None:
+        """Report nothing — this service has no log channel (SR-009, FR-003).
+
+        ``socketserver``'s default writes the peer address and a full traceback to
+        stderr; both are disclosures SR-009 forbids, and FR-003 permits exactly one
+        line of process output in total. Nothing is being swallowed here: a request
+        that failed while a response could still be sent has already been answered
+        with a generic ``500`` by the handler (SR-010), and the caller closes the
+        connection either way. This hook exists only to suppress the stdlib's
+        reporting of what has already been handled.
+        """
+
+
+def make_server(port: int, data_dir: str) -> PastebinHTTPServer:
+    """Bind and listen on ``127.0.0.1:port``; raises ``OSError`` if it cannot."""
+    return PastebinHTTPServer(port, os.path.realpath(data_dir))
