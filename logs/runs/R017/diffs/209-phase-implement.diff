+"""The operator-facing startup contract, driven as a real subprocess.
+
+Covers FR-001, FR-002, FR-003, FR-004, SR-008, SR-011, SC-006.
+"""
+
+from __future__ import annotations
+
+import http.client
+import os
+import re
+import select
+import signal
+import socket
+import subprocess
+import sys
+import time
+
+import pytest
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SRC = os.path.join(REPO_ROOT, "src")
+
+READY_RE = re.compile(r"\Alistening on 127\.0\.0\.1:(\d{1,5})\Z")
+
+
+def launch(*args: str) -> subprocess.Popen:
+    """Run ``python -m pastebin`` exactly as contracts/cli.md documents it."""
+    environment = dict(os.environ, PYTHONPATH=SRC, PYTHONUNBUFFERED="")
+    return subprocess.Popen(
+        [sys.executable, "-m", "pastebin", *args],
+        cwd=REPO_ROOT,
+        env=environment,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+
+
+def read_line(stream, timeout: float = 15.0) -> str:
+    """Read one line, failing the test rather than hanging if none arrives."""
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        ready, _, _ = select.select([stream], [], [], 0.1)
+        if ready:
+            return stream.readline()
+    raise AssertionError("no output arrived within the timeout")
+
+
+def await_ready(process: subprocess.Popen) -> int:
+    """Read the readiness line and return the bound port."""
+    line = read_line(process.stdout).rstrip("\n")
+    match = READY_RE.match(line)
+    assert match, f"FR-003: unexpected readiness line {line!r}"
+    return int(match.group(1))
+
+
+def stop(process: subprocess.Popen) -> tuple[int, str, str]:
+    """Interrupt the service and return ``(exit status, stdout tail, stderr)``."""
+    if process.poll() is None:
+        process.send_signal(signal.SIGINT)
+    try:
+        out, err = process.communicate(timeout=15)
+    except subprocess.TimeoutExpired:  # pragma: no cover - failure diagnostics
+        process.kill()
+        out, err = process.communicate()
+        raise AssertionError("the service did not exit on SIGINT")
+    return process.returncode, out, err
+
+
+def http_status(port: int, method: str = "GET", path: str = "/pastes/" + "A" * 22) -> int:
+    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=10)
+    try:
+        connection.request(method, path)
+        return connection.getresponse().status
+    finally:
+        connection.close()
+
+
+def create_paste(port: int, content: str = "hello") -> dict:
+    import json
+
+    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=10)
+    try:
+        body = json.dumps({"content": content}).encode("utf-8")
+        connection.request(
+            "POST", "/pastes", body, {"Content-Length": str(len(body))}
+        )
+        response = connection.getresponse()
+        assert response.status == 201
+        return json.loads(response.read())
+    finally:
+        connection.close()
+
+
+def non_loopback_ipv4() -> str | None:
+    """An address of this host that is not loopback, if it has one."""
+    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    try:
+        probe.connect(("192.0.2.1", 9))  # TEST-NET-1; no packet is actually sent
+        address = probe.getsockname()[0]
+    except OSError:  # pragma: no cover - host without a default route
+        return None
+    finally:
+        probe.close()
+    return None if address.startswith("127.") else address
+
+
+def listening_addresses(port: int) -> set[str]:
+    """Local addresses with a listening TCP socket on ``port``, from ``/proc``."""
+    addresses = set()
+    for source in ("/proc/net/tcp", "/proc/net/tcp6"):
+        try:
+            with open(source, "r", encoding="ascii") as handle:
+                lines = handle.read().splitlines()[1:]
+        except OSError:  # pragma: no cover - non-Linux
+            continue
+        for line in lines:
+            fields = line.split()
+            local, state = fields[1], fields[3]
+            if state != "0A":  # TCP_LISTEN
+                continue
+            hex_address, hex_port = local.rsplit(":", 1)
+            if int(hex_port, 16) == port:
+                addresses.add(hex_address)
+    return addresses
+
+
+# --- FR-001, FR-003: starting ------------------------------------------------------
+
+
+def test_FR_001_service_starts_from_one_command_and_serves_on_loopback(tmp_path):
+    """FR-001: one command taking a port and a data directory starts the service."""
+    process = launch("serve", "--port", "0", "--data", str(tmp_path / "data"))
+    try:
+        port = await_ready(process)
+        assert http_status(port) == 404
+        created = create_paste(port, "served over loopback")
+        assert len(created["id"]) == 22
+    finally:
+        status, _, err = stop(process)
+    assert status == 0, err
+
+
+def test_FR_003_stdout_carries_exactly_one_readiness_line_and_nothing_else(tmp_path):
+    """FR-003, SR-009: exactly one line on stdout, with no request logging after it."""
+    process = launch("serve", "--port", "0", "--data", str(tmp_path / "data"))
+    port = await_ready(process)
+
+    created = create_paste(port, "logged?")
+    http_status(port, "GET", f"/pastes/{created['id']}")
+    http_status(port, "GET", "/nope")
+    http_status(port, "DELETE", f"/pastes/{created['id']}")
+
+    status, out, err = stop(process)
+
+    assert status == 0
+    assert out == "", f"FR-003: stdout carried more than the readiness line: {out!r}"
+    assert err == "", f"SR-009: nothing may be written to stderr on success: {err!r}"
+
+
+def test_FR_003_port_zero_reports_the_ephemeral_port_actually_bound(tmp_path):
+    """FR-003: ``--port 0`` reports the port the kernel chose, never ``0``."""
+    process = launch("serve", "--port", "0", "--data", str(tmp_path / "data"))
+    try:
+        port = await_ready(process)
+        assert port != 0
+        assert 1024 <= port <= 65535
+        # The reported port is genuinely the one serving.
+        assert http_status(port) == 404
+    finally:
+        stop(process)
+
+
+def test_FR_003_fixed_port_is_reported_verbatim(tmp_path):
+    """FR-003: with an explicit port, the readiness line names that exact port."""
+    with socket.socket() as finder:
+        finder.bind(("127.0.0.1", 0))
+        chosen = finder.getsockname()[1]
+
+    process = launch("serve", "--port", str(chosen), "--data", str(tmp_path / "data"))
+    try:
+        assert await_ready(process) == chosen
+    finally:
+        stop(process)
+
+
+def test_FR_002_data_directory_is_created_with_parents_at_mode_0700(tmp_path):
+    """FR-002, SR-008: a nested, non-existent data directory is created as 0700."""
+    nested = tmp_path / "brand" / "new" / "nested" / "dir"
+    assert not nested.exists()
+
+    process = launch("serve", "--port", "0", "--data", str(nested))
+    try:
+        port = await_ready(process)
+        assert nested.is_dir()
+        assert os.stat(nested).st_mode & 0o777 == 0o700
+        created = create_paste(port, "stored in a fresh tree")
+        record = nested / f"{created['id']}.json"
+        assert record.exists()
+        assert os.stat(record).st_mode & 0o777 == 0o600
+    finally:
+        stop(process)
+
+
+def test_FR_002_existing_data_directory_is_reused(tmp_path):
+    """FR-002: an existing directory is reused, with its pastes still readable."""
+    data = tmp_path / "data"
+    first = launch("serve", "--port", "0", "--data", str(data))
+    port = await_ready(first)
+    created = create_paste(port, "written by the first run")
+    stop(first)
+
+    second = launch("serve", "--port", "0", "--data", str(data))
+    try:
+        port = await_ready(second)
+        assert http_status(second_port := port, "GET", f"/pastes/{created['id']}") == 200
+        assert second_port == port
+    finally:
+        stop(second)
+
+
+# --- FR-004: startup failures ------------------------------------------------------
+
+
+def assert_failed_startup(process: subprocess.Popen, expected: str) -> None:
+    out, err = process.communicate(timeout=20)
+    assert process.returncode != 0, "FR-004: a startup failure must exit non-zero"
+    assert expected in err, f"FR-004: stderr was {err!r}"
+    assert "listening on" not in out, (
+        "FR-004: the readiness line must not be printed on failure"
+    )
+
+
+@pytest.mark.parametrize(
+    "args,expected",
+    [
+        ([], "arguments"),
+        (["serve"], "required"),
+        (["serve", "--port", "0"], "required"),
+        (["serve", "--data", "/tmp/unused-pastebin"], "required"),
+        (["serve", "--port", "not-a-number", "--data", "/tmp/unused-pastebin"], "invalid"),
+        (["brew", "--port", "0", "--data", "/tmp/unused-pastebin"], "invalid choice"),
+    ],
+    ids=["no-args", "no-port-no-data", "no-data", "no-port", "port-not-int", "bad-subcommand"],
+)
+def test_FR_004_invalid_arguments_fail_loudly(args, expected):
+    """FR-004: an unusable command line exits non-zero with a message on stderr."""
+    assert_failed_startup(launch(*args), expected)
+
+
+@pytest.mark.parametrize("port", ["-1", "65536", "99999"], ids=lambda v: v)
+def test_FR_004_out_of_range_port_is_rejected(tmp_path, port):
+    """FR-004: a port outside 0 … 65535 is refused, with no fallback port."""
+    assert_failed_startup(
+        launch("serve", "--port", port, "--data", str(tmp_path / "data")),
+        "error: --port must be between 0 and 65535",
+    )
+
+
+def test_FR_004_port_already_in_use_fails_without_a_fallback(tmp_path):
+    """FR-004: a port already in use is fatal — there is no fallback port."""
+    first = launch("serve", "--port", "0", "--data", str(tmp_path / "first"))
+    try:
+        port = await_ready(first)
+
+        second = launch("serve", "--port", str(port), "--data", str(tmp_path / "second"))
+        out, err = second.communicate(timeout=20)
+
+        assert second.returncode != 0
+        assert f"error: cannot bind 127.0.0.1:{port}:" in err
+        assert "listening on" not in out
+        # The original service is undisturbed.
+        assert http_status(port) == 404
+    finally:
+        stop(first)
+
+
+def test_FR_004_uncreatable_data_directory_fails_without_a_fallback(tmp_path):
+    """FR-004: a data directory that cannot be created is fatal, with no fallback."""
+    blocker = tmp_path / "a-regular-file"
+    blocker.write_text("not a directory", encoding="utf-8")
+
+    assert_failed_startup(
+        launch("serve", "--port", "0", "--data", str(blocker / "sub")),
+        "error: cannot create data directory:",
+    )
+    assert_failed_startup(
+        launch("serve", "--port", "0", "--data", str(blocker)),
+        "error: cannot create data directory:",
+    )
+    assert blocker.read_text(encoding="utf-8") == "not a directory"
+
+
+def test_FR_004_unwritable_data_directory_is_reported_as_such(tmp_path, monkeypatch):
+    """FR-004: an existing but unwritable directory produces its documented message.
+
+    Exercised against ``cli._prepare_data_dir`` directly: a process running as root
+    bypasses the permission bits that would otherwise make a directory unwritable, so
+    a chmod-based subprocess test would not reach this branch on every host.
+    """
+    from pastebin import cli
+
+    target = tmp_path / "read-only"
+    target.mkdir()
+
+    real_access = os.access
+    monkeypatch.setattr(
+        os,
+        "access",
+        lambda path, mode, **kw: False
+        if str(path) == str(target)
+        else real_access(path, mode, **kw),
+    )
+
+    assert cli._prepare_data_dir(str(target)) == "error: data directory is not writable"
+
+
+def test_FR_004_startup_failures_never_create_the_data_directory(tmp_path):
+    """FR-004: a refused start leaves no half-made state behind."""
+    data = tmp_path / "never-created"
+    assert_failed_startup(
+        launch("serve", "--port", "70000", "--data", str(data)),
+        "error: --port must be between 0 and 65535",
+    )
+    assert not data.exists(), "the port is validated before anything is created"
+
+
+# --- SR-011: network exposure ------------------------------------------------------
+
+
+def test_SR_011_there_is_no_host_option(tmp_path):
+    """SR-011: ``--host`` does not exist — the bind address cannot be overridden."""
+    process = launch(
+        "serve", "--port", "0", "--data", str(tmp_path / "data"), "--host", "0.0.0.0"
+    )
+    out, err = process.communicate(timeout=20)
+
+    assert process.returncode != 0
+    assert "unrecognized arguments" in err
+    assert "listening on" not in out
+
+    helptext = subprocess.run(
+        [sys.executable, "-m", "pastebin", "serve", "--help"],
+        cwd=REPO_ROOT,
+        env=dict(os.environ, PYTHONPATH=SRC),
+        capture_output=True,
+        text=True,
+        timeout=20,
+    ).stdout
+    assert "--host" not in helptext
+    assert "--port" in helptext and "--data" in helptext
+
+
+def test_SR_011_only_the_loopback_address_is_bound(tmp_path):
+    """SR-011, FR-001: the listening socket is on 127.0.0.1 and no other interface."""
+    process = launch("serve", "--port", "0", "--data", str(tmp_path / "data"))
+    try:
+        port = await_ready(process)
+
+        addresses = listening_addresses(port)
+        assert addresses, "no listening socket was found for the reported port"
+        assert addresses == {"0100007F"}, (
+            f"SR-011: expected only 127.0.0.1, found {addresses}"
+        )
+
+        external = non_loopback_ipv4()
+        if external is not None:
+            # Nothing answers on the host's routable address...
+            with socket.socket() as probe:
+                probe.settimeout(5)
+                with pytest.raises(OSError):
+                    probe.connect((external, port))
+            # ...and the same port is still free there, which it would not be if the
+            # service had bound 0.0.0.0.
+            with socket.socket() as binder:
+                binder.bind((external, port))
+    finally:
+        stop(process)
+
+
+# --- SC-006: readiness means ready -------------------------------------------------
+
+
+def test_SC_006_a_client_connecting_the_instant_it_sees_readiness_is_served(tmp_path):
+    """SC-006: the socket is listening before the readiness line is printed."""
+    for iteration in range(10):
+        process = launch(
+            "serve", "--port", "0", "--data", str(tmp_path / f"run{iteration}")
+        )
+        try:
+            port = await_ready(process)
+            # No sleep, no retry: the very first connection must be served.
+            assert http_status(port) == 404, f"iteration {iteration}"
+        finally:
+            stop(process)
+
+
+def test_SR_009_abrupt_client_disconnect_writes_nothing_to_stderr(tmp_path):
+    """SR-009: a connection dropped mid-response produces no diagnostic output.
+
+    ``socketserver`` reports a handler exception to stderr with the peer address and
+    a full traceback by default — exactly the disclosure SR-009 forbids, and the
+    extra output FR-003 forbids.
+    """
+    process = launch("serve", "--port", "0", "--data", str(tmp_path / "data"))
+    port = await_ready(process)
+    created = create_paste(port, "x" * 60000)
+
+    for _ in range(10):
+        # Ask for a large body, then vanish without reading a byte of it.
+        raw = socket.create_connection(("127.0.0.1", port), timeout=10)
+        raw.sendall(
+            f"GET /pastes/{created['id']}/raw HTTP/1.1\r\n"
+            f"Host: 127.0.0.1:{port}\r\n\r\n".encode("ascii")
+        )
+        raw.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, b"\x01\x00\x00\x00\x00\x00\x00\x00")
+        raw.close()
+    time.sleep(0.5)
+
+    # The service is still healthy...
+    assert http_status(port, "GET", f"/pastes/{created['id']}") == 200
+
+    status, out, err = stop(process)
+
+    assert status == 0
+    assert out == "", f"FR-003: stdout gained output: {out!r}"
+    assert err == "", f"SR-009: stderr gained output: {err!r}"
+
+
+def test_SR_009_concurrent_load_then_shutdown_stays_silent(tmp_path):
+    """SR-009, FR-003: concurrent traffic produces no log line on either stream."""
+    import threading
+
