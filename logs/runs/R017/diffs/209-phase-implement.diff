+"""Operator-facing command line: argument parsing, data-directory setup, startup.
+
+Failures are fatal — there is no fallback port, no fallback directory, and no
+best-guess coercion of an invalid argument (Constitution Principle II,
+contracts/cli.md "Startup failures").
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+
+from .server import HOST, make_server
+
+#: The bind address is a module constant with no flag and no way to override it
+#: (SR-011). Re-exported from ``server`` so there is exactly one definition.
+__all__ = ["HOST", "main"]
+
+MIN_PORT = 0
+MAX_PORT = 65535
+
+#: How long shutdown waits for requests already being processed to finish.
+SHUTDOWN_GRACE_SECONDS = 10.0
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="pastebin", description="Share text snippets over loopback HTTP."
+    )
+    subparsers = parser.add_subparsers(dest="command", required=True)
+    serve = subparsers.add_parser("serve", help="run the service")
+    serve.add_argument("--port", type=int, required=True, help="0 to 65535; 0 picks a free port")
+    serve.add_argument("--data", required=True, help="directory holding stored pastes")
+    # Deliberately no --host: the bind address is not configurable (SR-011).
+    return parser
+
+
+def _fail(message: str) -> int:
+    print(message, file=sys.stderr, flush=True)
+    return 1
+
+
+def _prepare_data_dir(path: str) -> str | None:
+    """Create and permission-check the data directory; returns an error message or None.
+
+    The directory is created with ``mode=0o700`` including missing parents (FR-002),
+    then ``0700`` is enforced explicitly so that a pre-existing, looser directory is
+    tightened rather than accepted (SR-008).
+    """
+    try:
+        os.makedirs(path, mode=0o700, exist_ok=True)
+    except OSError as error:
+        return f"error: cannot create data directory: {error.strerror or error}"
+
+    try:
+        os.chmod(path, 0o700)
+    except OSError as error:
+        return f"error: cannot create data directory: {error.strerror or error}"
+
+    if not os.path.isdir(path) or not os.access(path, os.W_OK | os.X_OK):
+        return "error: data directory is not writable"
+    return None
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Entry point. Returns the process exit status (0 only on clean shutdown)."""
+    args = _build_parser().parse_args(argv)
+
+    if not (MIN_PORT <= args.port <= MAX_PORT):
+        return _fail(f"error: --port must be between {MIN_PORT} and {MAX_PORT}")
+
+    problem = _prepare_data_dir(args.data)
+    if problem is not None:
+        return _fail(problem)
+
+    # Bind and listen *before* announcing readiness, so a client that connects the
+    # instant it sees the line is queued by the listen backlog rather than refused
+    # (SC-006, contracts/cli.md "Startup sequence").
+    try:
+        server = make_server(args.port, args.data)
+    except OSError as error:
+        return _fail(
+            f"error: cannot bind {HOST}:{args.port}: {error.strerror or error}"
+        )
+
+    # Exactly one line on stdout, and nothing else ever (FR-003, SR-009). The bound
+    # port is reported, so --port 0 shows the ephemeral port rather than 0.
+    # ``flush=True`` matters: stdout is block-buffered when piped.
+    print(f"listening on {HOST}:{server.server_address[1]}", flush=True)
+
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        # A clean stop, not a failure: exit status 0 (contracts/cli.md "Shutdown").
+        pass
+    finally:
+        server.shutdown()
+        # In-flight requests are allowed to complete before the sockets are closed.
+        server.await_idle(SHUTDOWN_GRACE_SECONDS)
+        server.server_close()
+    # No cleanup of the data directory: pastes are durable by design (FR-023).
+    return 0
