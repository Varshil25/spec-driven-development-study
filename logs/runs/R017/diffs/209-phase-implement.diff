index 0000000..64c838a
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,301 @@
+"""Shared fixtures and stdlib-only HTTP helpers.
+
+Tests drive a *real* server bound to an ephemeral port over real HTTP. The client is
+built on ``http.client`` and raw sockets — no third-party HTTP client is used, because
+the runtime has no third-party dependencies and the test suite should not need one
+either (R-15, Constitution Principle I).
+
+Every response produced through these helpers is scanned as it arrives for the
+leakage SR-009 forbids, so the suite-wide guarantee holds no matter which subset of
+tests is run (SC-009).
+"""
+
+from __future__ import annotations
+
+import http.client
+import json
+import os
+import re
+import resource
+import socket
+import sys
+import threading
+
+import pytest
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(__file__)), "src"))
+
+from pastebin import cli, server as server_module  # noqa: E402
+
+# --- Suite-wide leakage scanning (SR-009, SC-009) ---------------------------------
+
+#: Every ``delete_token`` the suite has ever been issued. A token may appear in the
+#: single ``201`` that creates it and nowhere else.
+ISSUED_TOKENS: set[str] = set()
+
+_PYTHON_VERSION_RE = re.compile(r"[Pp]ython/?\d", re.ASCII)
+_ABSOLUTE_PATH_RE = re.compile(r"/(?:tmp|root|home|etc|var|usr|private)/[A-Za-z0-9_.-]")
+
+
+class Response:
+    """A captured HTTP response: status, headers, and the exact body bytes."""
+
+    def __init__(self, status: int, headers: list[tuple[str, str]], body: bytes) -> None:
+        self.status = status
+        self.headers = headers
+        self.body = body
+
+    def header(self, name: str) -> str | None:
+        lowered = name.lower()
+        for key, value in self.headers:
+            if key.lower() == lowered:
+                return value
+        return None
+
+    def has_header(self, name: str) -> bool:
+        return self.header(name) is not None
+
+    def json(self):
+        return json.loads(self.body.decode("utf-8"))
+
+    @property
+    def header_text(self) -> str:
+        return "\n".join(f"{key}: {value}" for key, value in self.headers)
+
+    def __repr__(self) -> str:  # pragma: no cover - diagnostics only
+        return f"<Response {self.status} {self.body[:60]!r}>"
+
+
+def scan_response(response: Response) -> Response:
+    """Assert a single response leaks nothing SR-009 forbids.
+
+    Called on every response the helpers below produce, which is what makes the
+    leakage guarantee suite-wide rather than a single test's observation.
+    """
+    body_text = response.body.decode("utf-8", errors="replace")
+    combined = response.header_text + "\n" + body_text
+
+    assert response.header("Server") == "pastebin", (
+        "SR-009: the Server header must be the fixed string 'pastebin', "
+        f"got {response.header('Server')!r}"
+    )
+    assert "Traceback" not in combined, "SR-009: a traceback escaped to the caller"
+    assert not _PYTHON_VERSION_RE.search(combined), (
+        "SR-009: a Python version string escaped to the caller"
+    )
+    assert not _ABSOLUTE_PATH_RE.search(combined), (
+        "SR-009: a filesystem path escaped to the caller"
+    )
+
+    if response.status == 201:
+        try:
+            ISSUED_TOKENS.add(response.json()["delete_token"])
+        except (ValueError, KeyError, TypeError):  # pragma: no cover - defensive
+            pass
+    else:
+        for token in ISSUED_TOKENS:
+            assert token not in combined, (
+                "SR-009/FR-013: a delete_token appeared outside the 201 that issued it"
+            )
+    return response
+
+
+# --- The running service ----------------------------------------------------------
+
+
+class Service:
+    """A real ``PastebinHTTPServer`` on an ephemeral loopback port."""
+
+    def __init__(self, data_dir: str) -> None:
+        self.data_dir = data_dir
+        self._server: server_module.PastebinHTTPServer | None = None
+        self._thread: threading.Thread | None = None
+
+    # -- lifecycle --
+
+    def start(self) -> None:
+        assert self._server is None, "service is already running"
+        # Use the production data-directory setup, so the fixture exercises the same
+        # creation and permission code the CLI does (FR-002, SR-008).
+        problem = cli._prepare_data_dir(self.data_dir)
+        assert problem is None, problem
+        self._server = server_module.make_server(0, self.data_dir)
+        self._thread = threading.Thread(
+            target=self._server.serve_forever, daemon=True
+        )
+        self._thread.start()
+
+    def stop(self) -> None:
+        if self._server is None:
+            return
+        self._server.shutdown()
+        # Mirror the CLI: let in-flight requests finish before closing the sockets.
+        self._server.await_idle(10.0)
+        self._server.server_close()
+        assert self._thread is not None
+        self._thread.join(timeout=10)
+        self._server = None
+        self._thread = None
+
+    def restart(self) -> None:
+        """Stop the server and start a fresh one against the *same* data directory."""
+        self.stop()
+        self.start()
+
+    # -- address --
+
+    @property
+    def port(self) -> int:
+        assert self._server is not None, "service is not running"
+        return self._server.server_address[1]
+
+    @property
+    def base_url(self) -> str:
+        return f"http://127.0.0.1:{self.port}"
+
+    @property
+    def store(self):
+        """The live ``PasteStore``, so a test can inject a failure into it (SR-010)."""
+        assert self._server is not None, "service is not running"
+        return self._server.store
+
+    def _connect(self, timeout: float = 10.0) -> http.client.HTTPConnection:
+        return http.client.HTTPConnection("127.0.0.1", self.port, timeout=timeout)
+
+    # -- generic request --
+
+    def request(
+        self,
+        method: str,
+        path: str,
+        body: bytes | None = None,
+        headers: dict[str, str] | None = None,
+        timeout: float = 10.0,
+    ) -> Response:
+        connection = self._connect(timeout)
+        try:
+            connection.putrequest(method, path, skip_host=False, skip_accept_encoding=True)
+            sent = {key.lower() for key in (headers or {})}
+            if body is not None and "content-length" not in sent:
+                connection.putheader("Content-Length", str(len(body)))
+            for key, value in (headers or {}).items():
+                connection.putheader(key, value)
+            connection.endheaders()
+            if body:
+                connection.send(body)
+            raw = connection.getresponse()
+            return scan_response(
+                Response(raw.status, raw.getheaders(), raw.read())
+            )
+        finally:
+            connection.close()
+
+    # -- convenience --
+
+    def post_json(self, payload, path: str = "/pastes") -> Response:
+        body = json.dumps(payload).encode("utf-8")
+        return self.request("POST", path, body, {"Content-Type": "application/json"})
+
+    def post_raw(
+        self, body: bytes, headers: dict[str, str] | None = None, path: str = "/pastes"
+    ) -> Response:
+        return self.request("POST", path, body, headers)
+
+    def get(self, path: str) -> Response:
+        return self.request("GET", path)
+
+    def delete(self, path: str, token: str | None = None) -> Response:
+        headers = {} if token is None else {"X-Delete-Token": token}
+        return self.request("DELETE", path, None, headers)
+
+    def create(self, content: str = "hello", **extra) -> dict:
+        """Create a paste and return the parsed ``201`` body. Fails loudly otherwise."""
+        payload = {"content": content}
+        payload.update(extra)
+        response = self.post_json(payload)
+        assert response.status == 201, (response.status, response.body)
+        return response.json()
+
+    # -- raw framing control (SR-005) --
+
+    def send_raw(
+        self,
+        head: bytes,
+        body: bytes = b"",
+        half_close: bool = True,
+        timeout: float = 10.0,
+    ) -> Response:
+        """Send a hand-built request and parse the response.
+
+        Lets a test declare a ``Content-Length`` that disagrees with the bytes it
+        actually delivers, or use chunked framing — neither of which ``http.client``
+        will do willingly.
+        """
+        with socket.create_connection(("127.0.0.1", self.port), timeout=timeout) as sock:
+            sock.sendall(head)
+            if body:
+                sock.sendall(body)
+            if half_close:
+                try:
+                    sock.shutdown(socket.SHUT_WR)
+                except OSError:  # pragma: no cover - platform dependent
+                    pass
+            chunks = []
+            while True:
+                try:
+                    data = sock.recv(65536)
+                except socket.timeout:  # pragma: no cover - failure diagnostics
+                    break
+                if not data:
+                    break
+                chunks.append(data)
+        return scan_response(parse_raw_response(b"".join(chunks)))
+
+
+def parse_raw_response(raw: bytes) -> Response:
+    """Parse raw response bytes into a :class:`Response`."""
+    assert raw, "the server sent no response at all"
+    head, _, body = raw.partition(b"\r\n\r\n")
+    lines = head.decode("latin-1").split("\r\n")
+    status = int(lines[0].split()[1])
+    headers = []
+    for line in lines[1:]:
+        if not line:
+            continue
+        key, _, value = line.partition(":")
+        headers.append((key.strip(), value.strip()))
+    return Response(status, headers, body)
+
+
+def build_head(
+    method: str, path: str, port: int, headers: dict[str, str] | None = None
+) -> bytes:
+    """Build a raw HTTP/1.1 request head with exactly the headers given."""
+    lines = [f"{method} {path} HTTP/1.1", f"Host: 127.0.0.1:{port}"]
+    for key, value in (headers or {}).items():
+        lines.append(f"{key}: {value}")
+    return ("\r\n".join(lines) + "\r\n\r\n").encode("latin-1")
+
+
+def max_rss_bytes() -> int:
+    """High-water-mark resident set size of this process, in bytes.
+
+    A high-water mark is exactly the right measure for "did the server ever buffer
+    this": a transient 50 MB allocation shows up here even after it is freed (SC-007).
+    """
+    value = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    return value if sys.platform == "darwin" else value * 1024
+
+
+# --- Fixtures ---------------------------------------------------------------------
+
+
+@pytest.fixture
+def server(tmp_path) -> Service:
+    """A running service with a fresh data directory, torn down after the test."""
+    service = Service(str(tmp_path / "data"))
+    service.start()
+    try:
+        yield service
+    finally:
+        service.stop()
