+"""Paste record shape, validation rules, timestamp formatting, and identifier generation.
+
+Constants, primitives, and the creation-payload validator. This module touches no
+filesystem and no socket; everything here is pure.
+"""
+
+from __future__ import annotations
+
+import datetime
+import json
+import re
+import secrets
+
+# --- Limits (spec Constraints, data-model.md "Validation rules") ------------------
+
+#: Maximum encoded size of ``content`` in bytes (FR-007).
+MAX_CONTENT_BYTES = 65536
+
+#: Maximum declared ``Content-Length`` accepted before the body is read: the content
+#: cap plus 1 024 bytes of JSON envelope slack (R-06, data-model.md rule 2).
+MAX_BODY_BYTES = 66560
+
+#: Inclusive bounds for ``expires_in``, in seconds (FR-008).
+MIN_EXPIRES_IN = 1
+MAX_EXPIRES_IN = 2_592_000
+
+#: ISO 8601 UTC, whole-second precision, ``Z`` suffix (FR-015).
+TIMESTAMP_FORMAT = "%Y-%m-%dT%H:%M:%SZ"
+
+#: Allowlist every identifier segment must match before it is joined to a path
+#: (SR-003, FR-011). 22 characters is the length of ``token_urlsafe(16)``.
+ID_PATTERN = re.compile(r"[A-Za-z0-9_-]{22}")
+
+#: Fields every stored record must carry to be recognisable as a paste (FR-024).
+RECORD_FIELDS = ("id", "content", "created_at", "expires_at", "delete_token")
+
+
+# --- Error messages ---------------------------------------------------------------
+# Each names the rule that was broken and never echoes an input or stored value
+# (SR-009, contracts/http-api.md "Failure cases").
+
+MSG_BAD_FRAMING = "request must declare a valid Content-Length"
+MSG_SHORT_BODY = "request body was shorter than the declared Content-Length"
+MSG_BAD_UTF8 = "request body must be valid UTF-8"
+MSG_NOT_OBJECT = "request body must be a JSON object"
+MSG_CONTENT_REQUIRED = "content is required"
+MSG_CONTENT_TYPE = "content must be a string"
+MSG_EXPIRES_IN = "expires_in must be an integer between 1 and 2592000"
+MSG_TOO_LARGE = f"content exceeds the maximum size of {MAX_CONTENT_BYTES} bytes"
+MSG_NOT_FOUND = "not found"
+MSG_BAD_TOKEN = "invalid delete token"
+MSG_INTERNAL = "internal error"
+
+
+# --- Time -------------------------------------------------------------------------
+
+
+def now_utc() -> datetime.datetime:
+    """Current UTC instant truncated to whole seconds (R-08).
+
+    Microseconds are dropped *before* any arithmetic so that the stored and reported
+    instants are identical, with no rounding gap.
+    """
+    return datetime.datetime.now(datetime.UTC).replace(microsecond=0)
+
+
+def format_timestamp(value: datetime.datetime) -> str:
+    """Render an aware UTC datetime as ``YYYY-MM-DDTHH:MM:SSZ`` (FR-015).
+
+    ``strftime`` is used rather than ``isoformat()``, which would emit ``+00:00``.
+    """
+    return value.strftime(TIMESTAMP_FORMAT)
+
+
+def parse_timestamp(value: str) -> datetime.datetime:
+    """Parse a ``YYYY-MM-DDTHH:MM:SSZ`` string back to an aware UTC datetime."""
+    return datetime.datetime.strptime(value, TIMESTAMP_FORMAT).replace(
+        tzinfo=datetime.UTC
+    )
+
+
+def compute_expires_at(created_at: datetime.datetime, expires_in: int | None) -> str | None:
+    """Expiry instant for a paste, or ``None`` when it never expires (FR-008, R-08).
+
+    ``created_at`` is already microsecond-truncated, so the sum is exact.
+    """
+    if expires_in is None:
+        return None
+    return format_timestamp(created_at + datetime.timedelta(seconds=expires_in))
+
+
+# --- Identifiers and secrets ------------------------------------------------------
+
+
+def new_id() -> str:
+    """A fresh 22-character, 128-bit URL-safe identifier (FR-011, SR-001).
+
+    Drawn from ``secrets``; not derived from content, time, or a counter.
+    """
+    return secrets.token_urlsafe(16)
+
+
+def new_delete_token() -> str:
+    """A fresh 43-character, 256-bit URL-safe revocation secret (SR-001)."""
+    return secrets.token_urlsafe(32)
+
+
+def is_valid_id(value: str) -> bool:
+    """True when ``value`` matches the identifier allowlist exactly (SR-003)."""
+    return ID_PATTERN.fullmatch(value) is not None
+
+
+# --- Creation payload validation --------------------------------------------------
+
+
+class ValidationError(Exception):
+    """A creation payload was rejected. Carries the HTTP status and the message."""
+
+    def __init__(self, status: int, message: str) -> None:
+        super().__init__(message)
+        self.status = status
+        self.message = message
+
+
+def validate_create_payload(body: bytes) -> tuple[str, int | None]:
+    """Validate a ``POST /pastes`` body and return ``(content, expires_in)``.
+
+    Implements rules 4-11 of the data-model validation table in the documented order;
+    framing rules 1-3 are enforced in ``server`` before any body byte is read.
+    Raises :class:`ValidationError` on the first rule that fails.
+    """
+    # Rule 4 — body decodes as UTF-8.
+    try:
+        text = body.decode("utf-8")
+    except UnicodeDecodeError:
+        raise ValidationError(400, MSG_BAD_UTF8) from None
+
+    # Rule 5 — body parses as JSON.
+    try:
+        payload = json.loads(text)
+    except ValueError:
+        raise ValidationError(400, MSG_NOT_OBJECT) from None
+
+    # Rule 6 — the parsed value is a JSON object, not a list, number, string,
+    # ``null``, or bool.
+    if type(payload) is not dict:
+        raise ValidationError(400, MSG_NOT_OBJECT)
+
+    # Rule 7 — ``content`` is present.
+    if "content" not in payload:
+        raise ValidationError(400, MSG_CONTENT_REQUIRED)
+
+    # Rule 8 — ``content`` is exactly a ``str``. ``type(...) is str`` rather than
+    # ``isinstance`` so that ``str`` subclasses are rejected too.
+    content = payload["content"]
+    if type(content) is not str:
+        raise ValidationError(400, MSG_CONTENT_TYPE)
+
+    # Rules 9 and 10 — ``expires_in``, when present, is an in-range integer.
+    # ``type(...) is int`` rather than ``isinstance``: ``bool`` subclasses ``int`` in
+    # Python, so ``isinstance(True, int)`` is ``True`` and would silently accept
+    # ``true`` as a one-second lifetime (R-10, FR-008). An explicit ``null`` is
+    # rejected rather than treated as absence.
+    expires_in: int | None = None
+    if "expires_in" in payload:
+        candidate = payload["expires_in"]
+        if type(candidate) is not int:
+            raise ValidationError(400, MSG_EXPIRES_IN)
+        if not (MIN_EXPIRES_IN <= candidate <= MAX_EXPIRES_IN):
+            raise ValidationError(400, MSG_EXPIRES_IN)
+        expires_in = candidate
+
+    # Rule 11 — encoded size. Last, so that an oversized-but-otherwise-valid body
+    # still yields 413 rather than 400 (FR-027).
+    if len(content.encode("utf-8")) > MAX_CONTENT_BYTES:
+        raise ValidationError(413, MSG_TOO_LARGE)
+
+    # Keys other than ``content`` and ``expires_in`` are never inspected (FR-009).
+    return content, expires_in
