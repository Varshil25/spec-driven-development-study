index 0000000..6a95ecc
--- /dev/null
+++ b/src/logredact/redact.py
@@ -0,0 +1,116 @@
+"""The redaction engine: pure text in, redacted text plus a tally out.
+
+Normative grammar: specs/001-logredact-cli/contracts/redaction-rules.md. The patterns
+below are that contract verbatim.
+"""
+
+import re
+
+#: One IPv4 component: 1-3 digits with value 0-255. Ordered longest-first; leading zeros
+#: are accepted, so "010.0.0.1" is an address.
+COMPONENT = r"(?:25[0-5]|2[0-4]\d|[01]\d\d|\d\d|\d)"
+
+#: Four dot-separated components, with no boundary guard — reused by both EMAIL and IP.
+IPV4_BODY = COMPONENT + r"(?:\." + COMPONENT + r"){3}"
+
+#: Local part is greedy and unguarded, so adjacent local-part characters are absorbed
+#: into the redaction (errs toward removing more). The domain is either ordinary labels
+#: ending in a >=2-letter label, or a bare IPv4 address — the second branch is what makes
+#: "user@1.2.3.4" one [EMAIL] rather than "user@[IP]" (research R4).
+EMAIL = r"[A-Za-z0-9._%+-]+@(?:" + IPV4_BODY + r"|(?:[A-Za-z0-9-]+\.)*[A-Za-z]{2,})"
+
+#: The (?<![\w.]) lookbehind is what prevents a *fragment* of an invalid run from
+#: matching: without it the engine would match "99.1.1.1" inside "999.1.1.1" starting at
+#: offset 1. It blocks every interior offset, so "999.1.1.1", "256.0.0.1", "1.2.3.4.5"
+#: and "1.2.3.45678" are reproduced whole. The same rule excludes "v1.2.3.4", because \w
+#: is a superset of "digit" (research R3).
+IP = r"(?<![\w.])" + IPV4_BODY + r"(?![\w.])"
+
+#: A *maximal* run of digits joined by single spaces or hyphens. Maximal matters: the run
+#: as a whole is judged against the 13-19 length rule, so a 20-digit run is never a card
+#: even though a 19-digit window inside it might pass Luhn. A single [ -] gives "a doubled
+#: separator ends the number" for free, since the character after a separator must be a
+#: digit. "." is deliberately not a separator, so card matching never spans an address.
+CARD = r"(?<!\d)\d+(?:[ -]\d+)*(?!\d)"
+
+#: THE ALTERNATION ORDER email -> ip -> card IS LOAD-BEARING. Python's re prefers the
+#: leftmost match and, among alternatives starting at the same offset, the first one
+#: listed — which is precisely FR-015's email-then-IPv4-then-card precedence. Rearranging
+#: these three alternatives changes behaviour and breaks the contract.
+COMBINED = re.compile(f"(?P<email>{EMAIL})|(?P<ip>{IP})|(?P<card>{CARD})")
+
+#: Fixed by the spec: three categories, three placeholders, not configurable.
+_PLACEHOLDER = {"email": "[EMAIL]", "ip": "[IP]", "card": "[CARD]"}
+
+_CARD_MIN_DIGITS = 13
+_CARD_MAX_DIGITS = 19
+
+_SEPARATORS = str.maketrans("", "", " -")
+
+
+def luhn(digits: str) -> bool:
+    """Return whether a separator-free digit string passes the Luhn checksum.
+
+    Right to left, every second digit is doubled and 9 subtracted from any doubled value
+    over 9; the total must be a multiple of 10. The 13-19 length rule is the caller's
+    (see ``redact_line``), not this function's.
+    """
+    total = 0
+    for index, char in enumerate(reversed(digits)):
+        value = ord(char) - 48
+        if index % 2:
+            value *= 2
+            if value > 9:
+                value -= 9
+        total += value
+    return total % 10 == 0
+
+
+def _is_card(candidate: str) -> bool:
+    """Whether a matched digit run is a payment card number (FR-013)."""
+    digits = candidate.translate(_SEPARATORS)
+    return _CARD_MIN_DIGITS <= len(digits) <= _CARD_MAX_DIGITS and luhn(digits)
+
+
+def redact_line(line: str) -> tuple[str, tuple[int, int, int]]:
+    """Redact one line, returning ``(redacted_line, (emails, ips, cards))``.
+
+    Pure: no I/O, no global state. Total: every ``str`` returns a ``str`` of the same line
+    count, and a line with no candidate returns a value equal to its input (FR-007,
+    FR-016). The line terminator, if any, is carried through untouched.
+    """
+    emails = ips = cards = 0
+    fragments = []
+    pos = 0
+
+    while True:
+        match = COMBINED.search(line, pos)
+        if match is None:
+            fragments.append(line[pos:])
+            break
+
+        kind = match.lastgroup
+
+        if kind == "card" and not _is_card(match.group()):
+            # A rejected candidate is NOT a replacement, so FR-015 does not permit its
+            # text to be skipped: restart one character *into* the candidate rather than
+            # past it. This is what makes "123 1.2.3.4" yield "123 [IP]" — resuming after
+            # the rejected run "123 1" would eat the 1 that begins the address. Advancing
+            # by one character also guarantees the loop terminates.
+            resume = match.start() + 1
+            fragments.append(line[pos:resume])
+            pos = resume
+            continue
+
+        fragments.append(line[pos:match.start()])
+        fragments.append(_PLACEHOLDER[kind])
+        pos = match.end()
+
+        if kind == "email":
+            emails += 1
+        elif kind == "ip":
+            ips += 1
+        else:
+            cards += 1
+
+    return "".join(fragments), (emails, ips, cards)
