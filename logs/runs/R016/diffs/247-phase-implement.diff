+"""User Story 3 end-to-end: the --count summary.
+
+Covers FR-004 and FR-017 to FR-020 through the real `python -m logredact` process.
+"""
+
+import pytest
+
+
+def write(path, data: bytes):
+    path.write_bytes(data)
+    return str(path)
+
+
+def test_fr017_worked_example_3_summary_on_stderr(run_cli):
+    """FR-017: `a@b.io 1.2.3.4` with --count reports emails=1 ips=1 cards=0."""
+    result = run_cli("--count", input=b"a@b.io 1.2.3.4\n")
+    assert result.stdout == b"[EMAIL] [IP]\n"
+    assert result.stderr == b"emails=1 ips=1 cards=0\n"
+    assert result.returncode == 0
+
+
+def test_fr017_worked_example_7_zero_is_printed_not_omitted(run_cli):
+    """FR-017: empty input still reports every category, with 0 spelled out."""
+    result = run_cli("--count", input=b"")
+    assert result.stdout == b""
+    assert result.stderr == b"emails=0 ips=0 cards=0\n"
+    assert result.returncode == 0
+
+
+def test_fr017_every_replacement_is_counted_not_every_distinct_value(run_cli):
+    """FR-017: the same email three times reports emails=3."""
+    result = run_cli("--count", input=b"a@b.io a@b.io a@b.io\n")
+    assert result.stdout == b"[EMAIL] [EMAIL] [EMAIL]\n"
+    assert result.stderr == b"emails=3 ips=0 cards=0\n"
+    assert result.returncode == 0
+
+
+def test_fr017_counts_accumulate_across_lines(run_cli):
+    """FR-017: the tally spans the whole run, not one line."""
+    result = run_cli(
+        "--count",
+        input=b"a@b.io\n1.2.3.4\n4111111111111111\n1234567890123\na@b.io 1.2.3.4\n",
+    )
+    assert result.stderr == b"emails=2 ips=2 cards=1\n"
+    assert result.returncode == 0
+
+
+def test_fr017_several_files_produce_exactly_one_summary_totalling_all(run_cli, tmp_path):
+    """FR-017: one summary line, totalled across every named file."""
+    a = write(tmp_path / "a.log", b"a@b.io 1.2.3.4\n")
+    b = write(tmp_path / "b.log", b"a@b.io 4111111111111111\n")
+    c = write(tmp_path / "c.log", b"nothing sensitive\n")
+
+    result = run_cli("--count", a, b, c)
+    assert result.stderr == b"emails=2 ips=1 cards=1\n"
+    assert result.stderr.count(b"\n") == 1
+    assert result.returncode == 0
+
+
+def test_fr018_the_stderr_summary_is_exactly_one_line(run_cli):
+    """FR-018/SC-006: exactly one line on stderr, nothing more."""
+    result = run_cli("--count", input=b"a@b.io\n1.2.3.4\n")
+    assert result.stderr.count(b"\n") == 1
+    assert len(result.stderr.splitlines()) == 1
+    assert result.returncode == 0
+
+
+def test_fr018_each_reported_count_equals_the_placeholders_in_stdout(run_cli):
+    """FR-018/SC-006: the tally is verifiable against the output it describes."""
+    result = run_cli(
+        "--count",
+        input=b"a@b.io 1.2.3.4 4111111111111111\n"
+        b"jane@example.com from 10.0.0.7\n"
+        b"4111-1111-1111-1111\n",
+    )
+    reported = dict(
+        field.split(b"=") for field in result.stderr.strip().split(b" ")
+    )
+    assert int(reported[b"emails"]) == result.stdout.count(b"[EMAIL]")
+    assert int(reported[b"ips"]) == result.stdout.count(b"[IP]")
+    assert int(reported[b"cards"]) == result.stdout.count(b"[CARD]")
+    assert (reported[b"emails"], reported[b"ips"], reported[b"cards"]) == (
+        b"2",
+        b"2",
+        b"2",
+    )
+
+
+def test_fr018_the_summary_follows_all_redacted_output(run_cli, tmp_path):
+    """FR-018: stdout is complete and flushed before the summary is written.
+
+    Captured separately, the proof available to a test is that all expected output is
+    present on stdout and the summary describes it in full.
+    """
+    payload = b"a@b.io 1.2.3.4\n" * 5000
+    big = write(tmp_path / "big.log", payload)
+
+    result = run_cli("--count", big)
+    assert result.stdout == b"[EMAIL] [IP]\n" * 5000
+    assert result.stderr == b"emails=5000 ips=5000 cards=0\n"
+    assert result.returncode == 0
+
+
+@pytest.mark.parametrize(
+    "args_builder",
+    [
+        lambda a, b: ("--count", a, b),
+        lambda a, b: (a, b, "--count"),
+        lambda a, b: (a, "--count", b),
+    ],
+    ids=["flag-first", "flag-last", "flag-between-operands"],
+)
+def test_fr004_the_flag_is_accepted_in_any_position(run_cli, tmp_path, args_builder):
+    """FR-004: --count before, among, or after the operands behaves identically."""
+    a = write(tmp_path / "a.log", b"a@b.io\n")
+    b = write(tmp_path / "b.log", b"1.2.3.4\n")
+
+    result = run_cli(*args_builder(a, b))
+    assert result.stdout == b"[EMAIL]\n[IP]\n"
+    assert result.stderr == b"emails=1 ips=1 cards=0\n"
+    assert result.returncode == 0
+
+
+def test_fr004_zero_operands_work_with_and_without_the_flag(run_cli):
+    """FR-004: 0..N operands are allowed either way."""
+    plain = run_cli(input=b"a@b.io\n")
+    counted = run_cli("--count", input=b"a@b.io\n")
+    assert plain.stdout == counted.stdout == b"[EMAIL]\n"
+    assert plain.stderr == b""
+    assert counted.stderr == b"emails=1 ips=0 cards=0\n"
+    assert plain.returncode == counted.returncode == 0
+
+
+def test_fr019_stderr_receives_nothing_without_the_flag(run_cli, tmp_path):
+    """FR-019: a successful run without --count writes nothing at all to stderr."""
+    a = write(tmp_path / "a.log", b"a@b.io 1.2.3.4 4111111111111111\n")
+
+    from_file = run_cli(a)
+    from_stdin = run_cli(input=b"a@b.io 1.2.3.4 4111111111111111\n")
+    assert from_file.stderr == b""
+    assert from_stdin.stderr == b""
+    assert from_file.returncode == from_stdin.returncode == 0
+
+
+def test_fr020_the_summary_never_appears_on_stdout(run_cli):
+    """FR-020: stdout stays pure log text — no tally, no field names."""
+    result = run_cli("--count", input=b"a@b.io 1.2.3.4\n")
+    assert b"emails=" not in result.stdout
+    assert b"ips=" not in result.stdout
+    assert b"cards=" not in result.stdout
+    assert result.stdout == b"[EMAIL] [IP]\n"
+
+
+def test_fr020_an_empty_run_with_the_flag_keeps_stdout_empty(run_cli):
+    """FR-020: the summary is not a substitute for output — stdout stays empty."""
+    result = run_cli("--count", input=b"")
+    assert result.stdout == b""
+    assert result.stderr == b"emails=0 ips=0 cards=0\n"
+
+
+def test_fr017_a_rejected_candidate_is_not_counted(run_cli):
+    """FR-017: Luhn and length near-misses increment nothing."""
+    result = run_cli(
+        "--count", input=b"1234567890123 41111111111111111111 999.1.1.1 v1.2.3.4\n"
+    )
+    assert result.stderr == b"emails=0 ips=0 cards=0\n"
+    assert result.returncode == 0
+
+
+def test_fr017_an_email_with_an_ipv4_domain_counts_only_as_an_email(run_cli):
+    """FR-017: user@1.2.3.4 reports emails=1 ips=0 (Edge Cases, research R4)."""
+    result = run_cli("--count", input=b"user@1.2.3.4\n")
+    assert result.stdout == b"[EMAIL]\n"
+    assert result.stderr == b"emails=1 ips=0 cards=0\n"
