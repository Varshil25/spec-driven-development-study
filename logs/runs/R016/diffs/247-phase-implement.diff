new file mode 100644
index 0000000..e373967
--- /dev/null
+++ b/tests/test_errors.py
@@ -0,0 +1,267 @@
+"""User Story 4 end-to-end: failures are loud.
+
+Covers FR-005, FR-021 and FR-022 through the real `python -m logredact` process. No test
+here is skipped or xfailed (constitution gate 2).
+"""
+
+import os
+import subprocess
+import sys
+
+from conftest import SRC
+
+
+def write(path, data: bytes):
+    path.write_bytes(data)
+    return str(path)
+
+
+def assert_names_path_with_a_reason(stderr: bytes, path: str):
+    """FR-021: the diagnostic carries the operand as typed *and* a non-empty reason.
+
+    The reason text comes from ``OSError.strerror``, so this matches on structure rather
+    than exact OS wording.
+    """
+    assert path.encode() in stderr, stderr
+    line = stderr.decode("utf-8", "surrogateescape").strip()
+    assert line.startswith("logredact: cannot read "), line
+    _, _, reason = line.rpartition(": ")
+    assert reason, line
+    assert reason != path, line
+
+
+def test_fr021_a_missing_file_names_it_and_exits_two(run_cli, tmp_path):
+    """FR-021: a file name that does not exist → diagnostic naming it, exit 2."""
+    missing = str(tmp_path / "does-not-exist.log")
+
+    result = run_cli(missing)
+    assert result.returncode == 2
+    assert result.stdout == b""
+    assert_names_path_with_a_reason(result.stderr, missing)
+
+
+def test_fr021_a_directory_operand_names_it_and_exits_two(run_cli, tmp_path):
+    """FR-021: a directory cannot be read as a log → diagnostic naming it, exit 2."""
+    directory = str(tmp_path)
+
+    result = run_cli(directory)
+    assert result.returncode == 2
+    assert result.stdout == b""
+    assert_names_path_with_a_reason(result.stderr, directory)
+
+
+def test_fr021_an_unreadable_file_mode_is_reported_or_read(run_cli, tmp_path):
+    """FR-021: a file with mode 0o000 → diagnostic naming it, exit 2.
+
+    Runs unconditionally rather than being skipped (constitution gate 2). A process with
+    uid 0 bypasses file permission bits entirely, so mode 0o000 is not unreadable *for
+    that process*; the test therefore asserts the FR-021 failure contract when the file
+    really is unreadable, and the ordinary FR-023 success contract when the running user
+    can read it anyway. Either way the tool must not produce a silent wrong answer.
+    """
+    secret = write(tmp_path / "secret.log", b"a@b.io\n")
+    os.chmod(secret, 0o000)
+
+    try:
+        with open(secret, encoding="utf-8"):
+            readable = True
+    except OSError:
+        readable = False
+
+    result = run_cli(secret)
+    if readable:
+        assert result.returncode == 0
+        assert result.stdout == b"[EMAIL]\n"
+        assert result.stderr == b""
+    else:
+        assert result.returncode == 2
+        assert result.stdout == b""
+        assert_names_path_with_a_reason(result.stderr, secret)
+
+
+def test_fr021_an_unopenable_path_names_it_and_exits_two(run_cli, tmp_path):
+    """FR-021: an open() failure is reported with the path and reason, for any user.
+
+    An over-long component fails with ENAMETOOLONG regardless of privilege, so the
+    open-time OSError path is exercised even when the suite runs as root.
+    """
+    too_long = str(tmp_path / ("x" * 5000))
+
+    result = run_cli(too_long)
+    assert result.returncode == 2
+    assert result.stdout == b""
+    assert_names_path_with_a_reason(result.stderr, too_long)
+
+
+def test_fr021_worked_example_9_earlier_output_is_kept_and_the_run_still_fails(
+    run_cli, tmp_path
+):
+    """FR-021: worked example 9 — first file readable, second missing.
+
+    The redacted first file is already on stdout; the run still exits 2 with a diagnostic
+    naming the second file, so a truncated log cannot be mistaken for a complete one.
+    """
+    a = write(tmp_path / "a.log", b"first a@b.io\n")
+    missing = str(tmp_path / "nope.log")
+
+    result = run_cli(a, missing)
+    assert result.stdout == b"first [EMAIL]\n"
+    assert result.returncode == 2
+    assert_names_path_with_a_reason(result.stderr, missing)
+    assert b"a.log" not in result.stderr
+
+
+def test_fr021_a_later_operand_is_never_opened_after_a_failure(run_cli, tmp_path):
+    """FR-021: the run stops at the first unreadable source."""
+    a = write(tmp_path / "a.log", b"first a@b.io\n")
+    missing = str(tmp_path / "nope.log")
+    c = write(tmp_path / "c.log", b"third 1.2.3.4\n")
+
+    result = run_cli(a, missing, c)
+    assert result.stdout == b"first [EMAIL]\n"
+    assert b"[IP]" not in result.stdout
+    assert result.returncode == 2
+
+
+def test_fr021_the_diagnostic_names_the_path_as_the_user_typed_it(run_cli, tmp_path):
+    """FR-021: a relative operand is echoed back relative, not resolved."""
+    write(tmp_path / "a.log", b"a@b.io\n")
+
+    result = run_cli("nope.log", cwd=tmp_path)
+    assert result.returncode == 2
+    assert b"'nope.log'" in result.stderr
+    assert str(tmp_path).encode() not in result.stderr
+
+
+def test_fr005_an_unrecognised_option_exits_two_with_a_usage_diagnostic(run_cli):
+    """FR-005: --bogus is an error, never a file name."""
+    result = run_cli("--bogus", input=b"a@b.io\n")
+    assert result.returncode == 2
+    assert result.stdout == b""
+    assert b"--bogus" in result.stderr
+    assert b"usage: logredact" in result.stderr
+    # Never treated as a file name: no "cannot read" diagnostic, no redacted output.
+    assert b"cannot read" not in result.stderr
+    assert b"[EMAIL]" not in result.stdout
+
+
+def test_fr005_the_program_name_in_diagnostics_is_logredact(run_cli):
+    """FR-005: diagnostics say `logredact`, not `__main__.py`."""
+    result = run_cli("--bogus")
+    assert b"__main__.py" not in result.stderr
+    assert b"logredact" in result.stderr
+
+
+def test_fr005_an_unrecognised_option_among_valid_operands_still_fails(run_cli, tmp_path):
+    """FR-005: a bad option is fatal even when real files are also named."""
+    a = write(tmp_path / "a.log", b"a@b.io\n")
+
+    result = run_cli(a, "--bogus")
+    assert result.returncode == 2
+    assert result.stdout == b""
+    assert b"--bogus" in result.stderr
+
+
+def test_fr022_a_failing_run_produces_no_summary_even_with_count(run_cli, tmp_path):
+    """FR-022: not all output was written, so no tally is reported."""
+    a = write(tmp_path / "a.log", b"first a@b.io 1.2.3.4\n")
+    missing = str(tmp_path / "nope.log")
+
+    result = run_cli("--count", a, missing)
+    assert result.returncode == 2
+    assert result.stdout == b"first [EMAIL] [IP]\n"
+    assert b"emails=" not in result.stderr
+    assert b"ips=" not in result.stderr
+    assert b"cards=" not in result.stderr
+    assert_names_path_with_a_reason(result.stderr, missing)
+
+
+def test_fr022_a_bad_option_with_count_produces_no_summary(run_cli):
+    """FR-022: an argument error reports no tally either."""
+    result = run_cli("--count", "--bogus")
+    assert result.returncode == 2
+    assert b"emails=" not in result.stderr
+    assert b"emails=" not in result.stdout
+
+
+def test_fr023_all_readable_operands_exit_zero(run_cli, tmp_path):
+    """FR-023: the success path still exits 0 and says nothing on stderr."""
+    a = write(tmp_path / "a.log", b"first a@b.io\n")
+    b = write(tmp_path / "b.log", b"second 1.2.3.4\n")
+
+    result = run_cli(a, b)
+    assert result.returncode == 0
+    assert result.stdout == b"first [EMAIL]\nsecond [IP]\n"
+    assert result.stderr == b""
+
+
+def test_a_failing_run_writes_no_traceback(run_cli, tmp_path):
+    """Principle II: a diagnostic, not a crash dump."""
+    missing = str(tmp_path / "nope.log")
+
+    result = run_cli(missing)
+    assert b"Traceback" not in result.stderr
+    assert b"Error:" not in result.stderr
+    assert result.stderr.count(b"\n") == 1
+
+
+# --- closed standard output (research R7) ----------------------------------------------
+
+
+def _run_into_closed_pipe(tmp_path, *args):
+    """Run the tool with stdout into a `head -1` that exits early.
+
+    Returns ``(logredact_returncode, logredact_stderr_bytes)``. The generated file is large
+    enough that the tool is still writing when `head` goes away.
+    """
+    big = tmp_path / "big.log"
+    with open(big, "w", encoding="utf-8", newline="") as handle:
+        for index in range(200_000):
+            handle.write(f"{index} user jane@example.com from 10.0.0.7\n")
+
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+
+    producer = subprocess.Popen(
+        [sys.executable, "-m", "logredact", *args, str(big)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        env=env,
+    )
+    consumer = subprocess.Popen(
+        ["head", "-1"], stdin=producer.stdout, stdout=subprocess.DEVNULL
+    )
+    # Let the child own the write end, so the pipe really closes when head exits.
+    producer.stdout.close()
+    consumer.wait()
+    stderr = producer.stderr.read()
+    producer.stderr.close()
+    producer.wait()
+    return producer.returncode, stderr
+
+
+def test_the_closed_stdout_path_reports_once_and_exits_two(tmp_path):
+    """Research R7: a closed downstream pipe is a failure, reported in one line.
+
+    Covers the spec's "output cannot be written" edge case: no traceback, no interpreter
+    shutdown noise, exit status 2.
+    """
+    returncode, stderr = _run_into_closed_pipe(tmp_path)
+
+    assert returncode == 2, stderr
+    assert stderr == b"logredact: cannot write to standard output: Broken pipe\n"
+    assert b"Traceback" not in stderr
+    assert b"Exception ignored" not in stderr
+    assert stderr.count(b"\n") == 1
+
+
+def test_the_closed_stdout_path_emits_no_summary_even_with_count(tmp_path):
+    """FR-022: not all output was written, so --count reports no tally."""
+    returncode, stderr = _run_into_closed_pipe(tmp_path, "--count")
+
+    assert returncode == 2, stderr
+    assert b"emails=" not in stderr
+    assert b"ips=" not in stderr
+    assert b"cards=" not in stderr
+    assert stderr == b"logredact: cannot write to standard output: Broken pipe\n"
+    assert b"Exception ignored" not in stderr
