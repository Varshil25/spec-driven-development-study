@@ -0,0 +1,94 @@
+"""SC-008: a 100,000-line log is redacted well inside the budget, with flat memory.
+
+Runs unconditionally (constitution gate 2). The wall-clock margin is wide — the design
+prototype measured ~1.4 s against a 10 s budget — so a slow CI machine does not make this
+flaky.
+"""
+
+import time
+import tracemalloc
+
+from logredact.redact import redact_line
+
+#: The quickstart V8 line: dense, carrying one of each category per line.
+LINE = "{index} WARN user jane@example.com from 10.0.0.7 card 4111 1111 1111 1111\n"
+
+LINE_COUNT = 100_000
+BUDGET_SECONDS = 10.0
+
+
+def _generate(path, line_count):
+    with open(path, "w", encoding="utf-8", newline="") as handle:
+        for index in range(line_count):
+            handle.write(LINE.format(index=index))
+    return str(path)
+
+
+def test_sc008_one_hundred_thousand_lines_redact_within_the_budget(run_cli, tmp_path):
+    """SC-008: 100,000 lines in under 10 seconds, with a tally matching the content."""
+    big = _generate(tmp_path / "big.log", LINE_COUNT)
+
+    start = time.perf_counter()
+    result = run_cli("--count", big)
+    elapsed = time.perf_counter() - start
+
+    assert result.returncode == 0, result.stderr
+    assert result.stderr == (
+        f"emails={LINE_COUNT} ips={LINE_COUNT} cards={LINE_COUNT}\n".encode()
+    )
+    assert result.stdout.count(b"[EMAIL]") == LINE_COUNT
+    assert result.stdout.count(b"[IP]") == LINE_COUNT
+    assert result.stdout.count(b"[CARD]") == LINE_COUNT
+    assert result.stdout.count(b"\n") == LINE_COUNT
+    assert elapsed < BUDGET_SECONDS, f"took {elapsed:.2f}s, budget {BUDGET_SECONDS}s"
+
+
+def _peak_bytes_for(line_count):
+    """Peak allocation while redacting ``line_count`` copies of LINE, line at a time."""
+    line = LINE.format(index=1234)
+    tracemalloc.start()
+    try:
+        tracemalloc.reset_peak()
+        for _ in range(line_count):
+            redact_line(line)
+        return tracemalloc.get_traced_memory()[1]
+    finally:
+        tracemalloc.stop()
+
+
+def test_sc008_memory_does_not_grow_with_line_count():
+    """SC-008: peak memory is bounded by the longest line, not by how many there are.
+
+    Ten times the lines must not cost anything like ten times the peak: the tool holds one
+    line at a time, so the peak is bounded by a small multiple of a single line.
+    """
+    small_peak = _peak_bytes_for(10_000)
+    large_peak = _peak_bytes_for(100_000)
+    line_bytes = len(LINE.format(index=1234).encode())
+
+    # Flat, not merely sublinear: a 10x increase in lines must not move the peak much.
+    assert large_peak < small_peak + 100 * line_bytes, (
+        f"peak grew from {small_peak} to {large_peak} bytes for 10x the lines"
+    )
+    # And the absolute peak stays a small multiple of one line.
+    assert large_peak < 100 * line_bytes, (
+        f"peak {large_peak} bytes is not a small multiple of one {line_bytes}-byte line"
+    )
+
+
+def test_sc008_a_long_single_line_is_the_only_thing_that_bounds_memory(tmp_path):
+    """SC-008: memory scales with the longest line, which is the documented bound."""
+    long_line = ("z" * 50_000) + " jane@example.com 1.2.3.4\n"
+
+    tracemalloc.start()
+    try:
+        tracemalloc.reset_peak()
+        text, counts = redact_line(long_line)
+        peak = tracemalloc.get_traced_memory()[1]
+    finally:
+        tracemalloc.stop()
+
+    assert counts == (1, 1, 0)
+    assert text.startswith("z" * 50_000)
+    # A handful of copies of the line, not an unbounded accumulation.
+    assert peak < 20 * len(long_line.encode())
