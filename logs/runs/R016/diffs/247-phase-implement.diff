+++ b/tests/test_redact_line.py
@@ -0,0 +1,306 @@
+"""Unit tests for the per-line redaction engine.
+
+Covers FR-006 and FR-008 to FR-016, one test (or parametrised case) per row of the tables
+in specs/001-logredact-cli/contracts/redaction-rules.md.
+"""
+
+import pytest
+
+from logredact.redact import redact_line
+
+
+def redacted(line):
+    """The redacted text only, for cases where the tally is asserted separately."""
+    return redact_line(line)[0]
+
+
+def tally(line):
+    """The ``(emails, ips, cards)`` tally only."""
+    return redact_line(line)[1]
+
+
+# --- Email: FR-008, FR-009 -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "line,expected",
+    [
+        ("a@b.io", "[EMAIL]"),
+        ("jane.doe+test@mail.example.com", "[EMAIL]"),
+        ("jane_doe%admin@example.org", "[EMAIL]"),
+        ("contact jane.doe+test@mail.example.com", "contact [EMAIL]"),
+    ],
+)
+def test_fr008_fr009_email_grammar_is_replaced(line, expected):
+    """FR-008, FR-009: an email address becomes [EMAIL]."""
+    assert redacted(line) == expected
+
+
+def test_fr009_a_trailing_sentence_period_is_not_part_of_the_domain():
+    """FR-009: jane@example.com. -> [EMAIL]. — the period is left outside."""
+    assert redacted("jane@example.com.") == "[EMAIL]."
+
+
+def test_fr009_email_with_an_ipv4_domain_is_one_email():
+    """FR-009 (research R4): user@1.2.3.4 is a single email, not user@[IP]."""
+    assert redacted("user@1.2.3.4") == "[EMAIL]"
+
+
+def test_fr008_email_replacement_counts_as_an_email():
+    """FR-008: an email replacement increments only the email counter."""
+    assert tally("a@b.io") == (1, 0, 0)
+
+
+# --- IPv4: FR-010, FR-011 --------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "line",
+    ["1.2.3.4", "10.0.0.7", "255.255.255.255", "010.0.0.1", "0.0.0.0"],
+)
+def test_fr010_fr011_valid_ipv4_is_replaced(line):
+    """FR-010, FR-011: a valid IPv4 address becomes [IP]; leading zeros are accepted."""
+    assert redact_line(line) == ("[IP]", (0, 1, 0))
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        "999.1.1.1",
+        "256.0.0.1",
+        "1.2.3",
+        "1.2.3.4.5",
+        "1.2.3.45678",
+        "v1.2.3.4",
+    ],
+)
+def test_fr011_near_miss_ipv4_is_left_completely_unchanged(line):
+    """FR-011: a not-quite-IPv4 run is reproduced whole, with no fragment redacted.
+
+    In particular no shorter valid-looking fragment inside it (99.1.1.1 inside
+    999.1.1.1, 56.0.0.1 inside 256.0.0.1) may be replaced.
+    """
+    text, counts = redact_line(line)
+    assert text == line
+    assert counts == (0, 0, 0)
+
+
+@pytest.mark.parametrize(
+    "line",
+    ["host 999.1.1.1 unreachable", "see 1.2.3.4.5 for details", "build v1.2.3.4 shipped"],
+)
+def test_fr011_near_miss_ipv4_in_context_leaves_the_whole_line_alone(line):
+    """FR-011: a near-miss surrounded by ordinary text produces no [IP] anywhere."""
+    assert redacted(line) == line
+    assert "[IP]" not in redacted(line)
+
+
+def test_fr011_an_address_followed_by_a_sentence_period_is_left_unredacted():
+    """FR-011, accepted consequence: `connect to 1.2.3.4.` keeps the address.
+
+    The trailing dot fails the boundary rule, which cannot tell it apart from the fifth
+    component of `1.2.3.4.5`. Recorded in the spec's Edge Cases as a knowing
+    under-redaction (research R3), and pinned here so it cannot change unnoticed.
+    """
+    assert redacted("connect to 1.2.3.4.") == "connect to 1.2.3.4."
+    assert tally("connect to 1.2.3.4.") == (0, 0, 0)
+
+
+def test_fr011_ipv4_boundary_rejects_an_adjacent_word_character():
+    """FR-011: an address butted against a word character is not an address."""
+    assert redacted("x1.2.3.4") == "x1.2.3.4"
+    assert redacted("1.2.3.4x") == "1.2.3.4x"
+
+
+# --- Payment card: FR-012, FR-013 ------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        "4111111111111111",
+        "4111 1111 1111 1111",
+        "4111-1111-1111-1111",
+        "4111-1111 1111-1111",
+    ],
+)
+def test_fr012_card_with_any_single_separator_layout_is_one_card(line):
+    """FR-012: single spaces and hyphens are part of the number; mixing is allowed."""
+    assert redact_line(line) == ("[CARD]", (0, 0, 1))
+
+
+def test_fr012_a_doubled_separator_ends_the_number():
+    """FR-012: 4111  1111 1111 1111 splits into runs that each fail the length rule."""
+    line = "4111  1111 1111 1111"
+    assert redacted(line) == line
+
+
+@pytest.mark.parametrize("line", ["1234567890123", "41111111111111111111"])
+def test_fr013_card_near_misses_are_left_unchanged(line):
+    """FR-013: a Luhn failure (13 digits) and a wrong length (20 digits) are not cards."""
+    text, counts = redact_line(line)
+    assert text == line
+    assert counts == (0, 0, 0)
+
+
+def test_fr012_card_in_context_keeps_surrounding_text_and_punctuation():
+    """FR-012: worked example 2 — the card goes, the near-miss and comma stay."""
+    assert redacted("paid with 4111 1111 1111 1111, ref 1234567890123") == (
+        "paid with [CARD], ref 1234567890123"
+    )
+
+
+def test_fr013_two_cards_joined_by_a_single_space_form_one_over_long_run():
+    """FR-013, known consequence: two cards separated by one space are one 32-digit run.
+
+    The spec makes a single space part of the number and requires a run of 20+ digits
+    never to be redacted "even if some 13-to-19-digit window inside them would pass
+    Luhn". Those two rules together mean the joined pair is judged as one over-long run
+    and the first card is left in the clear; the second is still redacted, because
+    scanning resumes one character in and the position after the space is a fresh run
+    start. This is an under-redaction, pinned here so it cannot change silently, and
+    flagged to the spec owner in research.md.
+    """
+    line = "4111111111111111 4111111111111111"
+    text, counts = redact_line(line)
+    assert text == "4111111111111111 [CARD]"
+    assert counts == (0, 0, 1)
+    # Separated by anything that is not a single space or hyphen, both are redacted.
+    assert redact_line("4111111111111111, 4111111111111111")[0] == "[CARD], [CARD]"
+
+
+def test_fr012_a_dot_is_not_a_card_separator():
+    """FR-012: card matching never spans a dot, so it cannot swallow an IPv4 address."""
+    assert redacted("4111.1111.1111.1111") == "4111.1111.1111.1111"
+
+
+# --- FR-014 every occurrence -----------------------------------------------------------
+
+
+def test_fr014_every_occurrence_on_a_line_is_replaced():
+    """FR-014: three emails on one line become three placeholders, counted as 3."""
+    assert redact_line("a@b.io a@b.io a@b.io") == ("[EMAIL] [EMAIL] [EMAIL]", (3, 0, 0))
+
+
+def test_fr014_every_occurrence_across_categories_is_replaced():
+    """FR-014: repeats of each category are all replaced and all counted."""
+    line = "1.2.3.4 a@b.io 1.2.3.4 4111111111111111 a@b.io"
+    text, counts = redact_line(line)
+    assert text == "[IP] [EMAIL] [IP] [CARD] [EMAIL]"
+    assert counts == (2, 2, 1)
+
+
+# --- FR-015 precedence and no re-use ---------------------------------------------------
+
+
+def test_fr015_email_wins_over_the_ipv4_inside_its_domain():
+    """FR-015: user@1.2.3.4 counts as 1 email and 0 ips — the IP is not re-redacted."""
+    text, (emails, ips, cards) = redact_line("user@1.2.3.4")
+    assert text == "[EMAIL]"
+    assert (emails, ips, cards) == (1, 0, 0)
+
+
+def test_fr015_a_rejected_card_candidate_does_not_consume_a_following_address():
+    """FR-015 (research R2): 123 1.2.3.4 -> 123 [IP].
+
+    The card pattern first matches the maximal run "123 1"; it fails the length rule, so
+    scanning restarts one character *into* that run rather than past it, leaving the
+    address still eligible.
+    """
+    text, counts = redact_line("123 1.2.3.4")
+    assert text == "123 [IP]"
+    assert counts == (0, 1, 0)
+
+
+def test_fr015_a_rejected_card_candidate_increments_nothing():
+    """FR-015: a rejected candidate is not a replacement, so no counter moves."""
+    assert tally("1234567890123") == (0, 0, 0)
+
+
+def test_fr015_a_rejected_card_candidate_does_not_consume_a_following_email():
+    """FR-015: a rejected digit run must not hide an email that follows it."""
+    text, counts = redact_line("123 a@b.io")
+    assert text == "123 [EMAIL]"
+    assert counts == (1, 0, 0)
+
+
+def test_fr015_adjacent_values_of_different_categories_both_replaced():
+    """FR-015: a@b.io,1.2.3.4 -> [EMAIL],[IP] with the comma preserved."""
+    text, counts = redact_line("a@b.io,1.2.3.4")
+    assert text == "[EMAIL],[IP]"
+    assert counts == (1, 1, 0)
+
+
+def test_fr006_a_line_that_is_one_sensitive_value_becomes_exactly_the_placeholder():
+    """FR-006: the whole line is the value, so the whole line is the placeholder."""
+    assert redacted("a@b.io") == "[EMAIL]"
+    assert redacted("1.2.3.4") == "[IP]"
+    assert redacted("4111111111111111") == "[CARD]"
+
+
+def test_fr006_a_line_with_several_categories_is_fully_redacted_in_place():
+    """FR-006: worked example 1 plus a card — spacing and wording are untouched."""
+    line = "user jane@example.com from 10.0.0.7 card 4111 1111 1111 1111\n"
+    text, counts = redact_line(line)
+    assert text == "user [EMAIL] from [IP] card [CARD]\n"
+    assert counts == (1, 1, 1)
+
+
+# --- FR-007 / FR-016 totality and determinism ------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        "",
+        "\n",
+        "   \t  \n",
+        "nothing sensitive here\n",
+        "ordinary text with no values\r\n",
+        "last line without a newline",
+    ],
+)
+def test_fr007_a_line_with_nothing_to_redact_is_returned_unchanged(line):
+    """FR-007: a line with no candidate is returned equal to its input."""
+    text, counts = redact_line(line)
+    assert text == line
+    assert counts == (0, 0, 0)
+
+
+def test_fr007_the_line_terminator_is_preserved_exactly():
+    """FR-007: redaction never alters or invents a line terminator."""
+    assert redacted("a@b.io\n") == "[EMAIL]\n"
+    assert redacted("a@b.io\r\n") == "[EMAIL]\r\n"
+    assert redacted("a@b.io") == "[EMAIL]"
+
+
+def test_fr016_two_calls_on_the_same_input_return_equal_results():
+    """FR-016: output depends only on input text."""
+    line = "a@b.io 1.2.3.4 4111111111111111 1234567890123 999.1.1.1\n"
+    assert redact_line(line) == redact_line(line)
+
+
+def test_fr016_redact_line_returns_a_str_and_a_three_int_tally():
+    """FR-016/FR-017: the contract shape is (str, (emails, ips, cards))."""
+    text, counts = redact_line("a@b.io 1.2.3.4\n")
+    assert isinstance(text, str)
+    assert isinstance(counts, tuple) and len(counts) == 3
+    assert all(isinstance(n, int) for n in counts)
+
+
+def test_fr007_redact_line_preserves_line_count():
+    """FR-007: a str in, a str of the same line count out."""
+    line = "a@b.io 1.2.3.4\n"
+    assert redacted(line).count("\n") == line.count("\n")
+
+
+def test_the_tally_matches_the_placeholders_added():
+    """SC-006: each reported N equals the number of that placeholder in the output."""
+    # The digit runs are comma-separated: a single space between two of them would make
+    # the pair one long run, which the length rule then rejects as a whole.
+    line = "a@b.io a@b.io 1.2.3.4 4111111111111111, 4111-1111-1111-1111, 1234567890123"
+    text, (emails, ips, cards) = redact_line(line)
+    assert emails == text.count("[EMAIL]")
+    assert ips == text.count("[IP]")
+    assert cards == text.count("[CARD]")
+    assert (emails, ips, cards) == (2, 1, 2)
diff --git a/tests/test_stdin.py b/tests/test_stdin.py
new file mode 100644
index 0000000..c8845ed
--- /dev/null
+++ b/tests/test_stdin.py
@@ -0,0 +1,95 @@
+"""User Story 1 end-to-end: standard input to standard output.
+
+Covers FR-001, FR-003, FR-006 and FR-023 through the real `python -m logredact` process.
+Every assertion compares bytes exactly.
+"""
+
+
+def test_fr001_the_tool_is_runnable_as_python_dash_m_logredact(run_cli):
+    """FR-001: the tool is reachable as `python -m logredact` with src/ on PYTHONPATH."""
+    result = run_cli(input=b"")
+    assert result.returncode == 0
+    assert result.stdout == b""
+    assert result.stderr == b""
+
+
+def test_fr006_worked_example_1_email_and_ipv4(run_cli):
+    """FR-006: worked example 1 — `user jane@example.com from 10.0.0.7`."""
+    result = run_cli(input=b"user jane@example.com from 10.0.0.7\n")
+    assert result.stdout == b"user [EMAIL] from [IP]\n"
+    assert result.stderr == b""
+    assert result.returncode == 0
+
+
+def test_fr006_worked_example_2_card_and_luhn_near_miss(run_cli):
+    """FR-006: worked example 2 — the card goes, the Luhn near-miss stays."""
+    result = run_cli(input=b"paid with 4111 1111 1111 1111, ref 1234567890123\n")
+    assert result.stdout == b"paid with [CARD], ref 1234567890123\n"
+    assert result.stderr == b""
+    assert result.returncode == 0
+
+
+def test_fr006_worked_example_4_long_email(run_cli):
+    """FR-006: worked example 4 — `contact jane.doe+test@mail.example.com`."""
+    result = run_cli(input=b"contact jane.doe+test@mail.example.com\n")
+    assert result.stdout == b"contact [EMAIL]\n"
+    assert result.stderr == b""
+    assert result.returncode == 0
+
+
+def test_fr006_worked_example_5_invalid_ipv4_is_untouched(run_cli):
+    """FR-006: worked example 5 — `host 999.1.1.1 unreachable` is unchanged."""
+    payload = b"host 999.1.1.1 unreachable\n"
+    result = run_cli(input=payload)
+    assert result.stdout == payload
+    assert result.stderr == b""
+    assert result.returncode == 0
+
+
+def test_fr023_worked_example_6_empty_stdin_gives_empty_stdout(run_cli):
+    """FR-023: worked example 6 — empty input, empty output, exit 0."""
+    result = run_cli(input=b"")
+    assert result.stdout == b""
+    assert result.stderr == b""
+    assert result.returncode == 0
+
+
+def test_fr006_several_categories_on_one_line_keep_spacing_and_punctuation(run_cli):
+    """FR-006: every value is replaced in place; nothing else on the line moves."""
+    result = run_cli(
+        input=b"  WARN  a@b.io; 1.2.3.4, 4111-1111-1111-1111 -- done\t\n"
+    )
+    assert result.stdout == b"  WARN  [EMAIL]; [IP], [CARD] -- done\t\n"
+    assert result.stderr == b""
+    assert result.returncode == 0
+
+
+def test_fr006_every_line_of_a_multi_line_stream_is_written_in_order(run_cli):
+    """FR-006: all lines appear, in input order, with redactions applied."""
+    result = run_cli(
+        input=b"user jane@example.com from 10.0.0.7\n"
+        b"paid with 4111 1111 1111 1111, ref 1234567890123\n"
+        b"host 999.1.1.1 unreachable\n"
+    )
+    assert result.stdout == (
+        b"user [EMAIL] from [IP]\n"
+        b"paid with [CARD], ref 1234567890123\n"
+        b"host 999.1.1.1 unreachable\n"
+    )
+    assert result.stderr == b""
+    assert result.returncode == 0
+
+
+def test_fr003_standard_input_is_read_when_no_operand_is_given(run_cli):
+    """FR-003: with zero FILE operands, standard input is the input consumed."""
+    result = run_cli(input=b"a@b.io\n")
+    assert result.stdout == b"[EMAIL]\n"
+    assert result.returncode == 0
+
+
+def test_fr023_a_fully_readable_stream_exits_zero(run_cli):
+    """FR-023: all requested input read and written means exit status 0."""
+    result = run_cli(input=b"nothing sensitive\n")
+    assert result.returncode == 0
+    assert result.stdout == b"nothing sensitive\n"
+    assert result.stderr == b""