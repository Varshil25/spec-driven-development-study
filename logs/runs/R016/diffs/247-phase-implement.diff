+++ b/tests/conftest.py
@@ -0,0 +1,47 @@
+"""Shared test fixtures.
+
+Puts the repository's ``src/`` on ``sys.path`` so unit tests can import ``logredact``
+directly, and provides the subprocess helper the end-to-end tests drive the real CLI
+through. This file is test code, not configuration: plain ``pytest`` from the repository
+root must work with no ``pytest.ini`` or ``pyproject.toml`` (research R8).
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC = REPO_ROOT / "src"
+
+# Resolved from __file__, never from the working directory, so the suite imports the same
+# package no matter where pytest was invoked from.
+if str(SRC) not in sys.path:
+    sys.path.insert(0, str(SRC))
+
+import pytest  # noqa: E402  (import after the sys.path setup above, deliberately)
+
+
+def _run_cli(*args, input=None, cwd=None, env_extra=None):
+    """Invoke ``python -m logredact`` in a child process.
+
+    stdout and stderr come back as ``bytes`` — never text — so tests can assert byte
+    fidelity (FR-007). ``input`` is likewise ``bytes`` or None.
+    """
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+    if env_extra:
+        env.update(env_extra)
+    return subprocess.run(
+        [sys.executable, "-m", "logredact", *args],
+        input=input,
+        capture_output=True,
+        env=env,
+        cwd=str(cwd) if cwd is not None else None,
+    )
+
+
+@pytest.fixture
+def run_cli():
+    """Return the ``python -m logredact`` runner; results carry ``bytes`` streams."""
+    return _run_cli
