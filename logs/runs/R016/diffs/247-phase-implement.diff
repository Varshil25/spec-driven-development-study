index 0000000..46ece28
--- /dev/null
+++ b/tests/test_fidelity.py
@@ -0,0 +1,173 @@
+"""Byte fidelity across both the stdin path and the file path.
+
+Covers FR-007 and SC-004: output is byte-identical to input except for redactions.
+"""
+
+import pytest
+
+
+def write(path, data: bytes):
+    path.write_bytes(data)
+    return str(path)
+
+
+def both_paths(run_cli, tmp_path, payload: bytes):
+    """Run the same bytes through stdin and through a file; both results must agree."""
+    path = write(tmp_path / "fidelity.log", payload)
+    from_stdin = run_cli(input=payload)
+    from_file = run_cli(path)
+    assert from_stdin.returncode == 0, from_stdin.stderr
+    assert from_file.returncode == 0, from_file.stderr
+    assert from_stdin.stderr == b""
+    assert from_file.stderr == b""
+    assert from_stdin.stdout == from_file.stdout
+    return from_stdin.stdout
+
+
+def test_fr007_crlf_line_endings_are_preserved(run_cli, tmp_path):
+    """FR-007: \\r\\n survives untranslated."""
+    payload = b"first line\r\nsecond a@b.io\r\nthird\r\n"
+    assert both_paths(run_cli, tmp_path, payload) == (
+        b"first line\r\nsecond [EMAIL]\r\nthird\r\n"
+    )
+
+
+def test_fr007_a_lone_carriage_return_is_line_content(run_cli, tmp_path):
+    """FR-007: a \\r before the line ending is content and is preserved as-is."""
+    payload = b"has a carriage return\r\r\nnext\n"
+    assert both_paths(run_cli, tmp_path, payload) == payload
+
+
+def test_sc004_untouched_input_is_reproduced_byte_for_byte(run_cli, tmp_path):
+    """SC-004: nothing to redact means stdout is byte-identical to the input."""
+    payload = (
+        b"no secrets here\r\n"
+        b"\n"
+        b"   \t trailing spaces   \n"
+        b"999.1.1.1 1.2.3.4.5 v1.2.3.4 1234567890123\n"
+        b"last line without newline"
+    )
+    assert both_paths(run_cli, tmp_path, payload) == payload
+
+
+def test_fr007_a_final_line_without_a_newline_gets_none_invented(run_cli, tmp_path):
+    """FR-007: no trailing newline in, no trailing newline out."""
+    payload = b"first\nlast line a@b.io"
+    out = both_paths(run_cli, tmp_path, payload)
+    assert out == b"first\nlast line [EMAIL]"
+    assert not out.endswith(b"\n")
+
+
+def test_fr007_a_single_line_without_a_newline_gets_none_invented(run_cli, tmp_path):
+    """FR-007: the single-line case of the same rule."""
+    assert both_paths(run_cli, tmp_path, b"a@b.io") == b"[EMAIL]"
+
+
+def test_fr007_non_utf8_bytes_pass_through_unchanged(run_cli, tmp_path):
+    """FR-007: undecodable bytes are reproduced, never replaced, dropped, or fatal.
+
+    The email on the same line is still redacted, so the surrogate round-trip does not
+    disable recognition.
+    """
+    payload = b"caf\xe9 jane@example.com\n"
+    out = both_paths(run_cli, tmp_path, payload)
+    assert out == b"caf\xe9 [EMAIL]\n"
+    assert b"\xe9" in out
+
+
+def test_fr007_a_line_of_only_non_utf8_bytes_is_reproduced(run_cli, tmp_path):
+    """FR-007: a wholly undecodable line is still passed through intact."""
+    payload = b"\xff\xfe\x80\x81\n\xe9\xe9\xe9"
+    assert both_paths(run_cli, tmp_path, payload) == payload
+
+
+def test_fr007_non_utf8_bytes_are_never_themselves_redacted(run_cli, tmp_path):
+    """FR-007: no pattern can match a surrogate, so such bytes never become a placeholder."""
+    payload = b"\xe9\xe9\xe9 1.2.3.4 \xe9\xe9\xe9\n"
+    out = both_paths(run_cli, tmp_path, payload)
+    assert out == b"\xe9\xe9\xe9 [IP] \xe9\xe9\xe9\n"
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [b"\n", b"\r\n", b"\n\n\n", b"   \n", b"\t\t\n", b"  \t \r\n", b"\r\n\n\r\n"],
+    ids=["lf", "crlf", "three-lf", "spaces", "tabs", "mixed-ws-crlf", "mixed-endings"],
+)
+def test_fr007_blank_and_whitespace_only_lines_are_reproduced_exactly(
+    run_cli, tmp_path, payload
+):
+    """FR-007: blank and whitespace-only lines keep their trailing spaces and tabs."""
+    assert both_paths(run_cli, tmp_path, payload) == payload
+
+
+#: A long line shaped like a real one: 100,000 characters broken into word-sized runs.
+_LONG_FILLER = (b"x" * 79 + b" ") * 1250
+
+
+def test_fr007_a_very_long_line_is_redacted_and_reproduced_in_full(run_cli, tmp_path):
+    """FR-007: a line far longer than a typical log line is handled whole."""
+    assert len(_LONG_FILLER) == 100_000
+    payload = _LONG_FILLER + b"a@b.io " + _LONG_FILLER + b"1.2.3.4\n"
+    out = both_paths(run_cli, tmp_path, payload)
+    assert out == _LONG_FILLER + b"[EMAIL] " + _LONG_FILLER + b"[IP]\n"
+    assert len(out) == 2 * 100_000 + len(b"[EMAIL] ") + len(b"[IP]\n")
+
+
+def test_fr007_a_very_long_line_with_nothing_to_redact_is_byte_identical(
+    run_cli, tmp_path
+):
+    """FR-007/SC-004: length alone does not perturb fidelity."""
+    payload = _LONG_FILLER + b"999.1.1.1 1234567890123 v1.2.3.4\n"
+    assert both_paths(run_cli, tmp_path, payload) == payload
+
+
+def test_fr007_a_very_long_unbroken_run_is_still_correct(run_cli, tmp_path):
+    """FR-007: a 100,000-character line that is one unbroken token is handled whole.
+
+    This is the pathological shape for the contract's email pattern: the local-part class
+    is unanchored, so every offset inside an unbroken run of local-part characters starts
+    its own greedy attempt, making the scan O(n^2) in the run length (measured ~12 s for
+    one 100,000-character run, against SC-008's 10 s whole-log budget). Correctness is
+    unaffected, which is what this test pins; the cost is recorded for the spec owner in
+    research.md. Runs through the file path only, to pay that cost once.
+    """
+    payload = b"y" * 100_000 + b" a@b.io\n"
+    path = tmp_path / "unbroken.log"
+    path.write_bytes(payload)
+
+    result = run_cli(str(path))
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == b"y" * 100_000 + b" [EMAIL]\n"
+    assert result.stderr == b""
+
+
+def test_a_value_split_across_a_line_ending_is_not_redacted(run_cli, tmp_path):
+    """Recognition is line-local: a value broken by a newline stays in the clear.
+
+    Each half must be a non-value on its own, or the test would prove nothing: "jane@"
+    has no domain, "example.com" has no local part, "1.2." and "3.4" are not four
+    components, and each 8-digit card half fails the 13-19 length rule.
+    """
+    payload = b"jane@\nexample.com\n1.2.\n3.4\n4111 1111\n1111 1111\n"
+    assert both_paths(run_cli, tmp_path, payload) == payload
+
+
+def test_a_value_split_across_a_crlf_is_not_redacted(run_cli, tmp_path):
+    """Recognition is line-local, with \\r\\n endings too."""
+    payload = b"jane@\r\nexample.com\r\n"
+    assert both_paths(run_cli, tmp_path, payload) == payload
+
+
+def test_sc004_concatenated_files_are_byte_identical_to_their_concatenation(
+    run_cli, tmp_path
+):
+    """SC-004: multi-file output equals the concatenated inputs when nothing matches."""
+    first = b"nothing here\r\nno trailing newline"
+    second = b"also nothing\nsecond last\n"
+    a = write(tmp_path / "a.log", first)
+    b = write(tmp_path / "b.log", second)
+
+    result = run_cli(a, b)
+    assert result.stdout == first + second
+    assert result.stderr == b""
+    assert result.returncode == 0
