+"""Command-line driver: argument parsing, stream handling, summary, exit statuses."""
+
+import argparse
+import os
+import sys
+
+from logredact.redact import redact_line
+
+
+def _build_parser():
+    # prog must be set explicitly: under `python -m logredact` argparse would otherwise
+    # name the program "__main__.py" in every usage and error message (research R6).
+    parser = argparse.ArgumentParser(
+        prog="logredact",
+        description="Replace email addresses, IPv4 addresses, and payment card numbers "
+        "in log text with [EMAIL], [IP], and [CARD].",
+    )
+    parser.add_argument(
+        "--count",
+        action="store_true",
+        help="after all output, print a tally of replacements to standard error",
+    )
+    parser.add_argument(
+        "files",
+        nargs="*",
+        metavar="FILE",
+        help="files to read in the order given; standard input if none are named",
+    )
+    return parser
+
+
+#: Stream mode shared by stdin and every file operand, so a pipe and a file behave
+#: identically. newline="" disables universal-newline translation, so "\r\n" and a lone
+#: "\r" survive into the string and back out unchanged; surrogateescape round-trips bytes
+#: that are not valid UTF-8 instead of crashing or replacing them (research R5).
+_STREAM_KWARGS = {
+    "encoding": "utf-8",
+    "errors": "surrogateescape",
+    "newline": "",
+}
+
+
+def _run(args) -> int:
+    sys.stdin.reconfigure(**_STREAM_KWARGS)
+    sys.stdout.reconfigure(**_STREAM_KWARGS)
+
+    emails = ips = cards = 0
+
+    for name in args.files or [None]:
+        # Each source is opened lazily at its turn and closed before the next is opened —
+        # never two at once. There is deliberately no pre-flight readability check across
+        # all operands: earlier files must already have been written when a later one
+        # fails (data-model Entity 1; US4 scenario 4).
+        #
+        # The open *and* the read loop are both inside the try, so a mid-read I/O error is
+        # reported exactly like a failed open.
+        source = None
+        try:
+            if name is None:
+                # Zero operands: standard input, and only standard input (FR-003).
+                source = sys.stdin
+            else:
+                source = open(name, **_STREAM_KWARGS)
+
+            for line in source:
+                # Each line arrives including its terminator, and is written with write()
+                # rather than print(), which would invent a trailing newline on a final
+                # line that had none. No per-line flush: the only ordering requirement is
+                # FR-018, satisfied by one flush before the summary (research R9).
+                text, (line_emails, line_ips, line_cards) = redact_line(line)
+                sys.stdout.write(text)
+                emails += line_emails
+                ips += line_ips
+                cards += line_cards
+        except BrokenPipeError:
+            # Not an input failure: stdout went away. BrokenPipeError is an OSError, so it
+            # must be re-raised ahead of the handler below, or a closed downstream pipe
+            # would be misreported as an unreadable input file. Handled by main's caller
+            # (research R7).
+            raise
+        except OSError as exc:
+            # Name both the operand as the user typed it and the reason: Principle II
+            # forbids a diagnostic that omits the offending value (FR-021). Returning
+            # here, before the summary block, is what suppresses the tally on a failed
+            # run even with --count (FR-022).
+            label = "<stdin>" if name is None else name
+            sys.stderr.write(
+                f"logredact: cannot read '{label}': {exc.strerror or exc}\n"
+            )
+            return 2
+        finally:
+            if source is not None and source is not sys.stdin:
+                source.close()
+
+    if args.count:
+        # This single flush is what satisfies FR-018's ordering guarantee: all redacted
+        # output reaches stdout before the summary reaches stderr. No per-line flush is
+        # needed, and one would dominate runtime (research R9).
+        sys.stdout.flush()
+        # Always stderr, never stdout, so stdout stays pure log text (FR-020).
+        sys.stderr.write(f"emails={emails} ips={ips} cards={cards}\n")
+
+    return 0
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = _build_parser()
+    # parse_intermixed_args, not parse_args: with a nargs="*" positional, parse_args
+    # rejects `a.log --count b.log` as unrecognized arguments, which FR-004 forbids.
+    args = parser.parse_intermixed_args(argv)
+
+    try:
+        return _run(args)
+    except BrokenPipeError:
+        # Standard output went away mid-run, e.g. a downstream `head` exited. The
+        # redaction is incomplete, so this is a failure: exit 2 with a diagnostic and no
+        # summary, never a silent success (research R7, Principle II).
+        #
+        # The dup2 is required, not tidying: without it CPython tries to flush the dead
+        # stdout during interpreter shutdown and prints "Exception ignored in:
+        # <_io.TextIOWrapper name='<stdout>'>", which is traceback-shaped output on
+        # stderr. Pointing fd 1 at os.devnull makes that final flush succeed silently.
+        try:
+            devnull = os.open(os.devnull, os.O_WRONLY)
+            try:
+                os.dup2(devnull, 1)
+            finally:
+                os.close(devnull)
+        except OSError:
+            pass
+        try:
+            sys.stderr.write(
+                "logredact: cannot write to standard output: Broken pipe\n"
+            )
+        except OSError:
+            # stderr is gone too; the exit status is then the only report available.
+            pass
+        return 2
