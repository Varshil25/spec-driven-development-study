@@ -0,0 +1,78 @@
+"""Unit tests for the Luhn checksum and the 13-19 digit length rule (FR-013)."""
+
+import pytest
+
+from logredact.redact import luhn, redact_line
+
+
+def test_fr013_luhn_accepts_a_valid_card_number():
+    """FR-013: 4111111111111111 passes the Luhn checksum."""
+    assert luhn("4111111111111111") is True
+
+
+def test_fr013_luhn_rejects_a_card_length_number_that_fails_the_checksum():
+    """FR-013: 1234567890123 has a card-like length (13) but fails Luhn."""
+    assert luhn("1234567890123") is False
+
+
+def test_fr013_luhn_subtracts_nine_from_a_doubled_digit_over_nine():
+    """FR-013: the doubled-digit-over-9 rule.
+
+    79927398713 is the textbook Luhn example; it only validates when a doubled digit
+    greater than 9 has 9 subtracted from it (equivalently, its digits summed).
+    """
+    assert luhn("79927398713") is True
+    # Its neighbours must fail, which pins the arithmetic rather than a constant.
+    assert luhn("79927398710") is False
+    assert luhn("79927398711") is False
+    assert luhn("79927398712") is False
+
+
+def test_fr013_luhn_is_pure_checksum_and_applies_no_length_rule():
+    """FR-013: luhn() judges the checksum only; length is the caller's rule (T011/T012)."""
+    assert luhn("0") is True
+    assert luhn("18") is True
+
+
+# --- the 13 <= digit count <= 19 bound, enforced by redact_line ------------------------
+#
+# A digit run is only a card when the *whole run* is 13-19 digits long. These cases all
+# pass Luhn, so only the length rule can be deciding them.
+
+_LUHN_VALID_BY_LENGTH = {
+    12: "444444444442",
+    13: "4444444444448",
+    19: "4444444444444444442",
+    20: "44444444444444444444",
+}
+
+
+@pytest.mark.parametrize("length", sorted(_LUHN_VALID_BY_LENGTH))
+def test_fr013_length_fixtures_all_pass_luhn(length):
+    """Guard: each boundary fixture passes Luhn, so length alone decides the outcome."""
+    digits = _LUHN_VALID_BY_LENGTH[length]
+    assert len(digits) == length
+    assert luhn(digits) is True
+
+
+@pytest.mark.parametrize("length,expected_cards", [(12, 0), (13, 1), (19, 1), (20, 0)])
+def test_fr013_length_rule_at_each_boundary(length, expected_cards):
+    """FR-013: 12 rejected, 13 accepted, 19 accepted, 20 rejected."""
+    digits = _LUHN_VALID_BY_LENGTH[length]
+    text, (emails, ips, cards) = redact_line(digits)
+    assert cards == expected_cards
+    assert text == ("[CARD]" if expected_cards else digits)
+
+
+def test_fr013_a_twenty_digit_run_is_never_a_card_even_with_a_valid_window_inside():
+    """FR-013: a 20-digit run is not a card, even though a 16-digit window passes Luhn.
+
+    41111111111111111111 contains the Luhn-valid 4111111111111111 as a prefix, but the
+    run as a whole is judged, so nothing is redacted.
+    """
+    run = "41111111111111111111"
+    assert len(run) == 20
+    assert luhn("4111111111111111") is True
+    text, (_, _, cards) = redact_line(run)
+    assert text == run
+    assert cards == 0
