+"""User Story 2 end-to-end: named file operands.
+
+Covers FR-002, FR-003 and FR-023 through the real `python -m logredact` process.
+"""
+
+
+def write(path, data: bytes):
+    path.write_bytes(data)
+    return str(path)
+
+
+def test_fr002_two_files_are_written_in_the_order_named(run_cli, tmp_path):
+    """FR-002: worked example 8 — operands are read in command-line order."""
+    a = write(tmp_path / "a.log", b"first a@b.io\n")
+    b = write(tmp_path / "b.log", b"second 1.2.3.4\n")
+
+    result = run_cli(a, b)
+    assert result.stdout == b"first [EMAIL]\nsecond [IP]\n"
+    assert result.stderr == b""
+    assert result.returncode == 0
+
+
+def test_fr002_reversing_the_operands_reverses_the_output(run_cli, tmp_path):
+    """FR-002: the order is the user's, not sorted or otherwise rearranged."""
+    a = write(tmp_path / "a.log", b"first a@b.io\n")
+    b = write(tmp_path / "b.log", b"second 1.2.3.4\n")
+
+    result = run_cli(b, a)
+    assert result.stdout == b"second [IP]\nfirst [EMAIL]\n"
+    assert result.returncode == 0
+
+
+def test_fr003_standard_input_is_not_read_at_all_when_a_file_is_named(run_cli, tmp_path):
+    """FR-003: with one or more operands, standard input is not consumed."""
+    a = write(tmp_path / "a.log", b"from the file a@b.io\n")
+
+    result = run_cli(a, input=b"from stdin 1.2.3.4 SHOULD-NOT-APPEAR\n")
+    assert result.stdout == b"from the file [EMAIL]\n"
+    assert b"SHOULD-NOT-APPEAR" not in result.stdout
+    assert b"[IP]" not in result.stdout
+    assert result.stderr == b""
+    assert result.returncode == 0
+
+
+def test_fr002_the_same_file_named_twice_is_read_twice(run_cli, tmp_path):
+    """FR-002: sources are never deduplicated."""
+    a = write(tmp_path / "a.log", b"first a@b.io\n")
+
+    result = run_cli(a, a)
+    assert result.stdout == b"first [EMAIL]\nfirst [EMAIL]\n"
+    assert result.returncode == 0
+
+
+def test_fr023_an_empty_file_produces_empty_output_and_exit_zero(run_cli, tmp_path):
+    """FR-023: a readable but empty file is a successful run with no output."""
+    empty = write(tmp_path / "empty.log", b"")
+
+    result = run_cli(empty)
+    assert result.stdout == b""
+    assert result.stderr == b""
+    assert result.returncode == 0
+
+
+def test_fr023_an_empty_file_among_others_contributes_nothing(run_cli, tmp_path):
+    """FR-023: an empty operand neither adds output nor interrupts the concatenation."""
+    a = write(tmp_path / "a.log", b"first a@b.io\n")
+    empty = write(tmp_path / "empty.log", b"")
+    b = write(tmp_path / "b.log", b"second 1.2.3.4\n")
+
+    result = run_cli(a, empty, b)
+    assert result.stdout == b"first [EMAIL]\nsecond [IP]\n"
+    assert result.returncode == 0
+
+
+def test_fr002_a_file_without_a_trailing_newline_is_followed_immediately(run_cli, tmp_path):
+    """FR-002: the operands form one stream — no newline is invented between files."""
+    a = write(tmp_path / "a.log", b"no trailing newline a@b.io")
+    b = write(tmp_path / "b.log", b"second 1.2.3.4\n")
+
+    result = run_cli(a, b)
+    assert result.stdout == b"no trailing newline [EMAIL]second [IP]\n"
+    assert result.returncode == 0
+
+
+def test_fr002_files_behave_identically_to_the_same_bytes_on_stdin(run_cli, tmp_path):
+    """FR-002/FR-003: a file and a pipe carrying the same bytes give the same output."""
+    payload = b"user jane@example.com from 10.0.0.7\r\nref 1234567890123\nlast line"
+    a = write(tmp_path / "a.log", payload)
+
+    from_file = run_cli(a)
+    from_stdin = run_cli(input=payload)
+    assert from_file.stdout == from_stdin.stdout
+    assert from_file.returncode == from_stdin.returncode == 0
+
+
+def test_fr023_all_readable_operands_exit_zero(run_cli, tmp_path):
+    """FR-023: every requested source read and written means exit status 0."""
+    paths = [
+        write(tmp_path / f"{index}.log", b"nothing sensitive\n") for index in range(5)
+    ]
+
+    result = run_cli(*paths)
+    assert result.returncode == 0
+    assert result.stdout == b"nothing sensitive\n" * 5
+    assert result.stderr == b""
