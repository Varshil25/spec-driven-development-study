+++ b/tests/test_errors.py
@@ -0,0 +1,592 @@
+"""Failure-path tests (User Story 4).
+
+Covers FR-001, FR-012, FR-013, FR-014, FR-017, FR-019, FR-022, FR-023 and FR-025.
+"""
+
+import os
+import shutil
+import tarfile
+
+import pytest
+
+
+# ----------------------------------------------------------------------------------------
+# T032 -- archive-level failures: FR-012, FR-013
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_012_missing_archive_names_the_path_and_exits_two_for_list(tmp_path, run_cli):
+    """FR-012: a non-existent archive makes ``list`` exit 2 with the path named on stderr."""
+    missing = tmp_path / "nope.tar"
+
+    status, out, err = run_cli("list", missing)
+
+    assert status == 2
+    assert out == ""
+    assert err == "tarx: cannot open archive '{0}': No such file or directory\n".format(missing)
+
+
+def test_fr_012_missing_archive_names_the_path_and_exits_two_for_extract(tmp_path, run_cli):
+    """FR-012: a non-existent archive makes ``extract`` exit 2 as well."""
+    missing = tmp_path / "nope.tar"
+    dest = tmp_path / "out"
+
+    status, out, err = run_cli("extract", missing, dest)
+
+    assert status == 2
+    assert out == ""
+    assert str(missing) in err
+    assert not dest.exists()
+
+
+def test_fr_012_message_echoes_the_path_exactly_as_passed_not_normalised(tmp_path, run_cli):
+    """FR-012: the diagnostic echoes the path as the user typed it, never a normalised form."""
+    awkward = "{0}/./sub/../nope.tar".format(tmp_path)
+
+    status, _, err = run_cli("list", awkward)
+
+    assert status == 2
+    assert "'{0}'".format(awkward) in err
+
+
+def test_fr_013_file_that_is_not_a_tar_archive_exits_two(tmp_path, run_cli):
+    """FR-013: a file that exists but is not a tar archive exits 2 with a diagnostic."""
+    not_tar = tmp_path / "plain.txt"
+    not_tar.write_bytes(b"not a tar archive at all")
+
+    status, out, err = run_cli("list", not_tar)
+
+    assert status == 2
+    assert out == ""
+    assert err.startswith("tarx: '{0}' is not a readable tar archive: ".format(not_tar))
+    assert len(err.splitlines()) == 1
+
+
+def test_fr_013_truncated_archive_exits_two_and_leaves_no_partial_tree(
+    make_archive, tmp_path, run_cli
+):
+    """FR-013: a truncated archive exits 2, and ``extract`` leaves no partially extracted tree."""
+    archive = make_archive(
+        [("a.txt", "file", "a" * 4096), ("b.txt", "file", "b" * 4096)]
+    )
+    truncated = tmp_path / "truncated.tar"
+    truncated.write_bytes(archive.read_bytes()[:3000])
+    dest = tmp_path / "out"
+
+    status, out, err = run_cli("extract", truncated, dest)
+
+    assert status == 2
+    assert out == ""
+    assert err.strip() != ""
+    assert not dest.exists() or list(dest.rglob("*")) == []
+
+
+def test_fr_013_non_tar_file_exits_two_for_extract_too(tmp_path, run_cli):
+    """FR-013: ``extract`` rejects a non-tar archive and creates nothing."""
+    not_tar = tmp_path / "plain.txt"
+    not_tar.write_bytes(b"not a tar")
+    dest = tmp_path / "out"
+
+    status, out, err = run_cli("extract", not_tar, dest)
+
+    assert status == 2
+    assert out == ""
+    assert err.strip() != ""
+    assert not dest.exists()
+
+
+# ----------------------------------------------------------------------------------------
+# T033 -- invocation-level failures: FR-001, FR-017
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_001_unknown_command_is_rejected_with_a_usage_diagnostic(run_module):
+    """FR-001: a command name other than ``list``/``extract`` is rejected with usage output."""
+    result = run_module("frobnicate", "some.tar")
+
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "usage:" in result.stderr
+
+
+def test_fr_001_both_commands_dispatch(make_archive, tmp_path, run_cli):
+    """FR-001: the tool exposes exactly two commands and both dispatch to real work."""
+    archive = make_archive([("a.txt", "file", "a")])
+
+    list_status, list_out, _ = run_cli("list", archive)
+    extract_status, extract_out, _ = run_cli("extract", archive, tmp_path / "out")
+
+    assert (list_status, list_out) == (0, "a.txt\n")
+    assert (extract_status, extract_out) == (0, "extracted 1 files\n")
+
+
+@pytest.mark.parametrize(
+    "argv",
+    [
+        ("extract",),
+        ("extract", "only-archive.tar"),
+        ("list",),
+    ],
+)
+def test_fr_017_missing_required_operand_exits_non_zero_with_usage(argv, run_module):
+    """FR-017: a missing required operand produces usage on stderr and a non-zero status."""
+    result = run_module(*argv)
+
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "usage:" in result.stderr
+
+
+def test_fr_017_unrecognised_option_exits_non_zero_with_usage(run_module):
+    """FR-017: an unrecognised option produces usage on stderr and a non-zero status."""
+    result = run_module("extract", "a.tar", "out", "--clobber")
+
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "usage:" in result.stderr
+
+
+def test_fr_017_invalid_invocation_reads_and_writes_nothing(make_archive, tmp_path, run_module):
+    """FR-017: an invalid invocation touches neither the archive nor the destination.
+
+    A sentinel archive's mtime and bytes are compared across the run, and the destination is
+    asserted never to have been created.
+    """
+    archive = make_archive([("a.txt", "file", "a")])
+    dest = tmp_path / "out"
+    before_bytes = archive.read_bytes()
+    before_mtime = archive.stat().st_mtime_ns
+
+    result = run_module("extract", archive, dest, "--clobber")
+
+    assert result.returncode == 2
+    assert archive.read_bytes() == before_bytes
+    assert archive.stat().st_mtime_ns == before_mtime
+    assert not dest.exists()
+
+
+def test_fr_017_argparse_exits_in_process_without_main_returning(run_cli):
+    """FR-017: argparse's own ``SystemExit(2)`` propagates unmodified (template D12).
+
+    ``main`` deliberately does not catch it: the usage text and the status are argparse's.
+    """
+    with pytest.raises(SystemExit) as excinfo:
+        run_cli("frobnicate")
+
+    assert excinfo.value.code == 2
+
+
+def test_sc_009_top_level_help_names_both_commands_and_every_operand(run_module):
+    """SC-009: ``--help`` prints usage to stdout with status 0, naming the whole interface.
+
+    The top-level help is the discovery entry point, so it must name both commands, both
+    operands and ``--overwrite`` without the user having to drill into a subcommand.
+    """
+    result = run_module("--help")
+
+    assert result.returncode == 0
+    assert result.stderr == ""
+    for token in ("list", "extract", "ARCHIVE", "DEST", "--overwrite"):
+        assert token in result.stdout
+
+
+def test_sc_009_extract_help_names_its_operands_and_the_overwrite_option(run_module):
+    """SC-009: ``extract --help`` prints usage to stdout with status 0."""
+    result = run_module("extract", "--help")
+
+    assert result.returncode == 0
+    assert result.stderr == ""
+    for token in ("extract", "ARCHIVE", "DEST", "--overwrite"):
+        assert token in result.stdout
+
+
+# ----------------------------------------------------------------------------------------
+# T034 -- destination-level failures: FR-019
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_019_dest_is_an_existing_regular_file(make_archive, tmp_path, run_cli):
+    """FR-019: DEST existing as a regular file is exact template D3, exit 2, file untouched."""
+    archive = make_archive([("a.txt", "file", "a")])
+    dest = tmp_path / "blocker"
+    dest.write_bytes(b"original bytes")
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 2
+    assert out == ""
+    assert err == "tarx: destination '{0}' exists but is not a directory\n".format(dest)
+    assert dest.read_bytes() == b"original bytes"
+
+
+def test_fr_019_an_ancestor_of_dest_is_a_regular_file(make_archive, tmp_path, run_cli):
+    """FR-019 / FR-020: a regular file occupying a parent of DEST is exact template D4."""
+    archive = make_archive([("a.txt", "file", "a")])
+    blocker = tmp_path / "blocker"
+    blocker.write_bytes(b"in the way")
+    dest = blocker / "nested" / "out"
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 2
+    assert out == ""
+    assert err == "tarx: cannot create destination '{0}': '{1}' is not a directory\n".format(
+        dest, blocker
+    )
+    assert blocker.read_bytes() == b"in the way"
+    assert not os.path.lexists(dest)
+
+
+# ----------------------------------------------------------------------------------------
+# T035 -- type mismatches, identical with and without --overwrite: FR-023
+# ----------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("flags", [(), ("--overwrite",)], ids=["no-flag", "with-overwrite"])
+def test_fr_023_d6_existing_directory_where_a_file_member_goes(
+    make_archive, tmp_path, run_cli, snapshot_tree, flags
+):
+    """FR-023 (D6): a directory already at a file member's target is class 2 under both flags."""
+    archive = make_archive([("x", "file", "payload"), ("other.txt", "file", "o")])
+    dest = tmp_path / "out"
+    (dest / "x").mkdir(parents=True)
+    before = snapshot_tree(dest)
+
+    status, out, err = run_cli("extract", archive, dest, *flags)
+
+    assert status == 2
+    assert out == ""
+    assert err == "tarx: '{0}' is an existing directory but member 'x' is a regular file\n".format(
+        dest / "x"
+    )
+    assert snapshot_tree(dest) == before
+
+
+@pytest.mark.parametrize("flags", [(), ("--overwrite",)], ids=["no-flag", "with-overwrite"])
+def test_fr_023_d7_existing_non_directory_where_a_directory_member_goes(
+    make_archive, tmp_path, run_cli, snapshot_tree, flags
+):
+    """FR-023 (D7): a regular file already at a directory member's target is class 2."""
+    archive = make_archive([("x/", "dir", None), ("other.txt", "file", "o")])
+    dest = tmp_path / "out"
+    dest.mkdir()
+    (dest / "x").write_bytes(b"i am a file")
+    before = snapshot_tree(dest)
+
+    status, out, err = run_cli("extract", archive, dest, *flags)
+
+    assert status == 2
+    assert out == ""
+    assert err == "tarx: '{0}' is not a directory but member 'x' is a directory\n".format(
+        dest / "x"
+    )
+    assert snapshot_tree(dest) == before
+
+
+@pytest.mark.parametrize("flags", [(), ("--overwrite",)], ids=["no-flag", "with-overwrite"])
+def test_fr_023_d7_existing_symlink_where_a_directory_member_goes(
+    make_archive, tmp_path, run_cli, flags
+):
+    """FR-023 (D7): a symlink is a non-directory too -- ``--overwrite`` consents to files only."""
+    archive = make_archive([("x/", "dir", None)])
+    dest = tmp_path / "out"
+    dest.mkdir()
+    (dest / "x").symlink_to(tmp_path / "elsewhere")
+
+    status, out, err = run_cli("extract", archive, dest, *flags)
+
+    assert status == 2
+    assert out == ""
+    assert err == "tarx: '{0}' is not a directory but member 'x' is a directory\n".format(
+        dest / "x"
+    )
+
+
+@pytest.mark.parametrize("flags", [(), ("--overwrite",)], ids=["no-flag", "with-overwrite"])
+def test_fr_023_d8_existing_file_blocking_a_members_parent_directory(
+    make_archive, tmp_path, run_cli, snapshot_tree, flags
+):
+    """FR-023 (D8): an existing regular file where a member needs a parent directory."""
+    archive = make_archive([("a/b.txt", "file", "payload")])
+    dest = tmp_path / "out"
+    dest.mkdir()
+    (dest / "a").write_bytes(b"i block the parent")
+    before = snapshot_tree(dest)
+
+    status, out, err = run_cli("extract", archive, dest, *flags)
+
+    assert status == 2
+    assert out == ""
+    assert err == (
+        "tarx: '{0}' is not a directory but is needed as a parent of member 'a/b.txt'\n".format(
+            dest / "a"
+        )
+    )
+    assert snapshot_tree(dest) == before
+
+
+@pytest.mark.parametrize("flags", [(), ("--overwrite",)], ids=["no-flag", "with-overwrite"])
+def test_fr_023_d9_archive_stores_a_file_where_another_member_needs_a_directory(
+    make_archive, tmp_path, run_cli, flags
+):
+    """FR-023 (D9): the archive's own contents contradict each other.
+
+    A regular-file member at ``a`` and another member at ``a/b.txt`` cannot both be created.
+    Without this check the archive would pass validation and then die mid-write, leaving the
+    partial tree FR-020 exists to prevent.
+    """
+    archive = make_archive([("a", "file", "blocker"), ("a/b.txt", "file", "payload")])
+    dest = tmp_path / "out"
+
+    status, out, err = run_cli("extract", archive, dest, *flags)
+
+    assert status == 2
+    assert out == ""
+    assert err == (
+        "tarx: archive member 'a' is a regular file but member 'a/b.txt' requires it to be "
+        "a directory\n"
+    )
+    assert not dest.exists() or list(dest.rglob("*")) == []
+
+
+# ----------------------------------------------------------------------------------------
+# T036 -- mid-write filesystem failure: FR-022
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_022_mid_write_failure_names_the_member_and_suppresses_the_summary(
+    make_archive, tmp_path, run_cli, monkeypatch
+):
+    """FR-022 (D11): an OSError once writing has begun is reported against the member in hand.
+
+    Validation passes, then the *second* member's copy is made to fail. The summary line must
+    not appear, the status must be 2, and the member and target path must be named.
+    """
+    archive = make_archive(
+        [("first.txt", "file", "one"), ("second.txt", "file", "two"), ("third.txt", "file", "3")]
+    )
+    dest = tmp_path / "out"
+    real_copyfileobj = shutil.copyfileobj
+    calls = {"n": 0}
+
+    def flaky_copyfileobj(source, target, *args, **kwargs):
+        calls["n"] += 1
+        if calls["n"] == 2:
+            raise OSError(28, "No space left on device")
+        return real_copyfileobj(source, target, *args, **kwargs)
+
+    monkeypatch.setattr(shutil, "copyfileobj", flaky_copyfileobj)
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 2
+    assert out == ""
+    assert "extracted" not in out
+    assert err == "tarx: failed while writing member 'second.txt' to '{0}': {1}\n".format(
+        dest / "second.txt", "No space left on device"
+    )
+
+
+def test_fr_022_files_written_before_the_failure_remain_on_disk(
+    make_archive, tmp_path, run_cli, monkeypatch
+):
+    """FR-022: the tool does not roll back; this test pins that documented limit.
+
+    Clarification Q1 chose validation over rollback, so a partial tree after an *unexpected*
+    failure is the specified outcome rather than a defect.
+    """
+    archive = make_archive(
+        [("first.txt", "file", "one"), ("second.txt", "file", "two")]
+    )
+    dest = tmp_path / "out"
+    real_copyfileobj = shutil.copyfileobj
+    calls = {"n": 0}
+
+    def flaky_copyfileobj(source, target, *args, **kwargs):
+        calls["n"] += 1
+        if calls["n"] == 2:
+            raise OSError(13, "Permission denied")
+        return real_copyfileobj(source, target, *args, **kwargs)
+
+    monkeypatch.setattr(shutil, "copyfileobj", flaky_copyfileobj)
+
+    status, out, _ = run_cli("extract", archive, dest)
+
+    assert status == 2
+    assert out == ""
+    assert (dest / "first.txt").read_bytes() == b"one"
+
+
+def test_fr_022_revoked_directory_permission_mid_write_is_reported_not_crashed(
+    make_archive, tmp_path, run_cli
+):
+    """FR-022: a real revoked write permission surfaces as D11, not as a traceback."""
+    if os.geteuid() == 0:
+        pytest.skip("running as root: mode bits do not deny access")
+    archive = make_archive([("locked/a.txt", "file", "payload")])
+    dest = tmp_path / "out"
+    locked = dest / "locked"
+    locked.mkdir(parents=True)
+    locked.chmod(0o500)
+    try:
+        status, out, err = run_cli("extract", archive, dest)
+    finally:
+        locked.chmod(0o700)
+
+    assert status == 2
+    assert out == ""
+    assert err.startswith("tarx: failed while writing member 'locked/a.txt' to ")
+
+
+# ----------------------------------------------------------------------------------------
+# T037 -- aggregation end to end: FR-014, FR-025
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_025_several_independent_problems_are_all_reported_one_per_line(
+    make_archive, tmp_path, run_cli
+):
+    """FR-025: validation reports every problem it found rather than stopping at the first."""
+    archive = make_archive(
+        [
+            ("a.txt", "file", "archive-a"),
+            ("b.txt", "file", "archive-b"),
+            ("c.txt", "file", "archive-c"),
+        ]
+    )
+    dest = tmp_path / "out"
+    dest.mkdir()
+    for name in ("a.txt", "b.txt", "c.txt"):
+        (dest / name).write_bytes(b"mine")
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 3
+    assert out == ""
+    assert err.splitlines() == [
+        "tarx: refusing to overwrite existing file '{0}' (re-run with --overwrite)".format(
+            dest / name
+        )
+        for name in ("a.txt", "b.txt", "c.txt")
+    ]
+
+
+def test_fr_025_mixed_classes_exit_two_not_three_with_both_lines_present(
+    make_archive, tmp_path, run_cli, snapshot_tree
+):
+    """FR-025: class 2 outranks class 3 when an archive exhibits both.
+
+    Status 3 means "re-run with ``--overwrite``", which would be false advice here.
+    """
+    archive = make_archive(
+        [
+            ("../escape.txt", "file", "hostile"),
+            ("a.txt", "file", "archive-a"),
+        ]
+    )
+    dest = tmp_path / "out"
+    dest.mkdir()
+    (dest / "a.txt").write_bytes(b"mine")
+    before = snapshot_tree(dest)
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 2
+    assert out == ""
+    assert err.splitlines() == [
+        "tarx: unsafe member path '../escape.txt': resolves outside destination '{0}'".format(
+            dest
+        ),
+        "tarx: refusing to overwrite existing file '{0}' (re-run with --overwrite)".format(
+            dest / "a.txt"
+        ),
+    ]
+    assert snapshot_tree(dest) == before
+
+
+def test_fr_014_escaping_members_write_nothing_and_are_each_named(
+    make_archive, tmp_path, run_cli
+):
+    """FR-014 end to end: every offending member is named via D5, nothing is written, exit 2."""
+    archive = make_archive(
+        [
+            ("/etc/passwd", "file", "hostile"),
+            ("good.txt", "file", "fine"),
+            ("../../escape.txt", "file", "hostile"),
+        ]
+    )
+    dest = tmp_path / "out"
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 2
+    assert out == ""
+    assert err.splitlines() == [
+        "tarx: unsafe member path '/etc/passwd': resolves outside destination '{0}'".format(dest),
+        "tarx: unsafe member path '../../escape.txt': resolves outside destination '{0}'".format(
+            dest
+        ),
+    ]
+    assert not dest.exists()
+
+
+def test_fr_014_hostile_symlink_member_refuses_the_whole_archive(
+    make_archive, tmp_path, run_cli
+):
+    """FR-014: the check applies to members extraction would skip anyway.
+
+    FR-014 names "any member" with no type qualifier, so an escaping symlink entry refuses the
+    archive rather than being quietly skipped.
+    """
+    archive = make_archive(
+        [("good.txt", "file", "fine"), ("../evil", "symlink", "/etc/passwd")]
+    )
+    dest = tmp_path / "out"
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 2
+    assert out == ""
+    assert "unsafe member path '../evil'" in err
+    assert not dest.exists()
+
+
+def test_fr_025_destination_problem_is_reported_before_member_problems(
+    make_archive, tmp_path, run_cli
+):
+    """FR-025: reporting order is destination-level problems first, then archive order."""
+    archive = make_archive([("../escape.txt", "file", "hostile")])
+    dest = tmp_path / "blocker"
+    dest.write_bytes(b"not a directory")
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 2
+    assert out == ""
+    assert err.splitlines() == [
+        "tarx: destination '{0}' exists but is not a directory".format(dest),
+        "tarx: unsafe member path '../escape.txt': resolves outside destination '{0}'".format(
+            dest
+        ),
+    ]
+
+
+def test_fr_025_member_rejected_by_d5_is_not_reported_again_under_later_checks(
+    make_archive, tmp_path, run_cli
+):
+    """FR-025: a member rejected for path safety contributes exactly one problem line.
+
+    ``../a`` would also collide with an existing file once joined, but the D5 rejection excludes
+    it from every later check.
+    """
+    archive = make_archive([("../a", "file", "hostile")])
+    dest = tmp_path / "out"
+    dest.mkdir()
+    (tmp_path / "a").write_bytes(b"would be clobbered")
+
+    status, _, err = run_cli("extract", archive, dest)
+
+    assert status == 2
+    assert len(err.splitlines()) == 1
+    assert "unsafe member path '../a'" in err
+    assert (tmp_path / "a").read_bytes() == b"would be clobbered"
