+"""Tests for ``extract ARCHIVE DEST`` happy paths (User Story 2) and the SC-008 scale checks.
+
+Covers FR-004, FR-005, FR-006, FR-007, FR-008, FR-011, FR-015, FR-016 and FR-018.
+"""
+
+import io
+import os
+import tarfile
+import time
+import tracemalloc
+
+import pytest
+
+
+NESTED = [
+    ("photos/", "dir", None),
+    ("photos/a.jpg", "file", "alpha"),
+    ("photos/nested/", "dir", None),
+    ("photos/nested/b.jpg", "file", "beta"),
+]
+
+
+# ----------------------------------------------------------------------------------------
+# T018 -- core extraction: FR-005, FR-006, FR-007, FR-008
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_005_nested_archive_relative_paths_reproduced_under_dest(
+    make_archive, tmp_path, run_cli
+):
+    """FR-005: each member's archive-relative path is reproduced beneath DEST."""
+    archive = make_archive(NESTED)
+    dest = tmp_path / "out"
+
+    status, _, _ = run_cli("extract", archive, dest)
+
+    assert status == 0
+    assert (dest / "photos" / "a.jpg").is_file()
+    assert (dest / "photos" / "nested" / "b.jpg").is_file()
+    assert (dest / "photos" / "nested").is_dir()
+
+
+def test_fr_006_extracted_bytes_are_identical_to_the_archive_copy(
+    make_archive, tmp_path, run_cli
+):
+    """FR-006: extracted file contents are byte-for-byte identical to the archive's."""
+    payload = bytes(range(256)) * 8
+    archive = make_archive(
+        [
+            ("data/blob.bin", "file", payload),
+            ("data/text.txt", "file", "hello\nworld\n"),
+        ]
+    )
+    dest = tmp_path / "out"
+
+    status, _, _ = run_cli("extract", archive, dest)
+
+    assert status == 0
+    assert (dest / "data" / "blob.bin").read_bytes() == payload
+    assert (dest / "data" / "text.txt").read_bytes() == b"hello\nworld\n"
+
+
+def test_fr_006_zero_length_member_becomes_an_empty_file_and_is_counted(
+    make_archive, tmp_path, run_cli
+):
+    """FR-006 / FR-008: a zero-length member is created as an empty file and counted in N."""
+    archive = make_archive([("empty.txt", "file", b""), ("full.txt", "file", "x")])
+    dest = tmp_path / "out"
+
+    status, out, _ = run_cli("extract", archive, dest)
+
+    assert status == 0
+    assert (dest / "empty.txt").is_file()
+    assert (dest / "empty.txt").read_bytes() == b""
+    assert out == "extracted 2 files\n"
+
+
+def test_fr_007_missing_dest_with_missing_parents_is_created(make_archive, tmp_path, run_cli):
+    """FR-007: a missing DEST, including missing parent directories, is created."""
+    archive = make_archive([("a.txt", "file", "a")])
+    dest = tmp_path / "deeply" / "nested" / "out"
+    assert not dest.parent.exists()
+
+    status, _, _ = run_cli("extract", archive, dest)
+
+    assert status == 0
+    assert dest.is_dir()
+    assert (dest / "a.txt").read_bytes() == b"a"
+
+
+def test_fr_007_existing_dest_directory_is_reused(make_archive, tmp_path, run_cli):
+    """FR-007: an existing DEST directory is reused, not rejected."""
+    archive = make_archive([("a.txt", "file", "a")])
+    dest = tmp_path / "out"
+    dest.mkdir()
+
+    status, out, _ = run_cli("extract", archive, dest)
+
+    assert status == 0
+    assert out == "extracted 1 files\n"
+    assert (dest / "a.txt").read_bytes() == b"a"
+
+
+def test_fr_008_summary_is_the_only_stdout_line_and_files_stays_plural(
+    make_archive, tmp_path, run_cli
+):
+    """FR-008: stdout is exactly ``extracted N files``, plural at N = 0, 1 and 2.
+
+    The literal ``extracted 1 files`` at a count of one is the contract (clarification Q5): the
+    line's shape never varies for a script parsing it.
+    """
+    cases = {
+        0: [],
+        1: [("one.txt", "file", "1")],
+        2: [("one.txt", "file", "1"), ("two.txt", "file", "2")],
+    }
+    for count, entries in cases.items():
+        archive = make_archive(entries)
+        dest = tmp_path / "out{0}".format(count)
+
+        status, out, err = run_cli("extract", archive, dest)
+
+        assert status == 0
+        assert out == "extracted {0} files\n".format(count)
+        assert err == ""
+
+
+# ----------------------------------------------------------------------------------------
+# T019 -- surrounding behaviour: FR-004, FR-011, FR-015, FR-016, FR-018
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_004_extraction_from_gzip_and_misnamed_archives_matches_the_plain_case(
+    make_archive, tmp_path, run_cli
+):
+    """FR-004: gzip and misnamed archives extract exactly like the plain equivalent."""
+    plain = make_archive(NESTED, compress=False, filename="plain.tar")
+    gzipped = make_archive(NESTED, compress=True, filename="gz.tar.gz")
+    misnamed = make_archive(NESTED, compress=True, filename="misnamed.tar")
+
+    results = {}
+    for label, archive in (("plain", plain), ("gzip", gzipped), ("misnamed", misnamed)):
+        dest = tmp_path / label
+        status, out, _ = run_cli("extract", archive, dest)
+        assert status == 0
+        results[label] = (
+            out,
+            (dest / "photos" / "a.jpg").read_bytes(),
+            (dest / "photos" / "nested" / "b.jpg").read_bytes(),
+        )
+
+    assert results["plain"] == results["gzip"] == results["misnamed"]
+    assert results["plain"][0] == "extracted 2 files\n"
+
+
+def test_fr_011_existing_directory_at_a_directory_member_is_not_a_conflict(
+    make_archive, tmp_path, run_cli
+):
+    """FR-011: a directory already present where the archive stores a directory is fine."""
+    archive = make_archive(NESTED)
+    dest = tmp_path / "out"
+    (dest / "photos" / "nested").mkdir(parents=True)
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 0
+    assert out == "extracted 2 files\n"
+    assert err == ""
+
+
+def test_fr_015_non_regular_members_are_skipped_named_on_stderr_and_excluded_from_n(
+    make_archive, tmp_path, run_cli
+):
+    """FR-015: symlink, hard-link and FIFO members are not created, only reported.
+
+    Their presence alone keeps the exit status at 0, and they do not count toward N.
+    """
+    archive = make_archive(
+        [
+            ("real.txt", "file", "data"),
+            ("link.txt", "symlink", "real.txt"),
+            ("hard.txt", "hardlink", "real.txt"),
+            ("pipe", "fifo", None),
+        ]
+    )
+    dest = tmp_path / "out"
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 0
+    assert out == "extracted 1 files\n"
+    assert err.splitlines() == [
+        "tarx: skipping non-regular member 'link.txt' (symbolic link)",
+        "tarx: skipping non-regular member 'hard.txt' (hard link)",
+        "tarx: skipping non-regular member 'pipe' (FIFO)",
+    ]
+    assert not os.path.lexists(dest / "link.txt")
+    assert not os.path.lexists(dest / "hard.txt")
+    assert not os.path.lexists(dest / "pipe")
+    assert (dest / "real.txt").read_bytes() == b"data"
+
+
+def test_fr_015_device_members_are_skipped_with_their_own_labels(
+    make_archive, tmp_path, run_cli
+):
+    """FR-015: character and block device members are skipped with the contract's labels."""
+    archive = make_archive([("dev/zero", "chardev", None), ("dev/sda", "blockdev", None)])
+    dest = tmp_path / "out"
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 0
+    assert out == "extracted 0 files\n"
+    assert err.splitlines() == [
+        "tarx: skipping non-regular member 'dev/zero' (character device)",
+        "tarx: skipping non-regular member 'dev/sda' (block device)",
+    ]
+
+
+def test_fr_018_empty_archive_extracts_zero_files_and_exits_zero(
+    empty_archive, tmp_path, run_cli
+):
+    """FR-016 / FR-018: an empty archive is a success -- ``extracted 0 files``, exit 0."""
+    dest = tmp_path / "out"
+
+    status, out, err = run_cli("extract", empty_archive, dest)
+
+    assert status == 0
+    assert out == "extracted 0 files\n"
+    assert err == ""
+
+
+def test_fr_005_unrelated_pre_existing_destination_file_is_left_untouched(
+    make_archive, tmp_path, run_cli
+):
+    """US2 scenario 4: a destination file the archive does not contain is not touched."""
+    archive = make_archive([("a.txt", "file", "alpha")])
+    dest = tmp_path / "out"
+    dest.mkdir()
+    unrelated = dest / "mine.txt"
+    unrelated.write_bytes(b"do not touch")
+
+    status, out, _ = run_cli("extract", archive, dest)
+
+    assert status == 0
+    assert out == "extracted 1 files\n"
+    assert unrelated.read_bytes() == b"do not touch"
+
+
+def test_fr_016_python_m_tarx_extract_works_as_a_real_process(
+    make_archive, tmp_path, run_module
+):
+    """FR-016: ``python -m tarx extract`` exits 0 as a real process, covering ``__main__``."""
+    archive = make_archive(NESTED)
+    dest = tmp_path / "out"
+
+    result = run_module("extract", archive, dest)
+
+    assert result.returncode == 0
+    assert result.stdout == "extracted 2 files\n"
+    assert result.stderr == ""
+    assert (dest / "photos" / "nested" / "b.jpg").read_bytes() == b"beta"
+
+
+# ----------------------------------------------------------------------------------------
+# T044 -- SC-008 scale checks
+# ----------------------------------------------------------------------------------------
+
+
+@pytest.mark.slow
+def test_sc_008_listing_ten_thousand_members_completes_under_five_seconds(tmp_path, run_cli):
+    """SC-008: ``list`` on a 10,000-member archive emits 10,000 lines in under 5 seconds.
+
+    Met by iterating member headers and never reading a member body (quickstart.md -> Scale
+    checks).
+    """
+    archive = tmp_path / "many.tar"
+    with tarfile.open(archive, "w") as handle:
+        for index in range(10_000):
+            info = tarfile.TarInfo("d{0}/f{1}.txt".format(index // 100, index))
+            info.size = 1
+            handle.addfile(info, io.BytesIO(b"x"))
+
+    started = time.monotonic()
+    status, out, err = run_cli("list", archive)
+    elapsed = time.monotonic() - started
+
+    assert status == 0
+    assert err == ""
+    assert len(out.splitlines()) == 10_000
+    assert elapsed < 5.0, "listing took {0:.2f}s, budget is 5s".format(elapsed)
+
+
+@pytest.mark.slow
+def test_sc_008_extraction_streams_a_large_member_without_buffering_it(tmp_path, run_cli):
+    """SC-008: a member far larger than any plausible buffer is streamed, not held in memory.
+
+    ``shutil.copyfileobj`` uses one fixed-size buffer, so peak resident memory is independent of
+    the member's size. The assertion here is behavioural -- the member is reproduced
+    byte-for-byte at a size that would be obvious if it were buffered whole -- plus a direct
+    check that the write phase never reads the member into a single object.
+    """
+    size = 64 * 1024 * 1024
+    chunk = b"0123456789abcdef" * 4096
+    archive = tmp_path / "large.tar"
+    with tarfile.open(archive, "w") as handle:
+        info = tarfile.TarInfo("large.bin")
+        info.size = size
+
+        class _Chunks(io.RawIOBase):
+            """Feeds ``size`` bytes without ever materialising them all at once."""
+
+            def __init__(self):
+                self.remaining = size
+
+            def readinto(self, buffer):
+                if not self.remaining:
+                    return 0
+                count = min(len(buffer), len(chunk), self.remaining)
+                buffer[:count] = chunk[:count]
+                self.remaining -= count
+                return count
+
+            def readable(self):
+                return True
+
+        handle.addfile(info, io.BufferedReader(_Chunks()))
+
+    dest = tmp_path / "out"
+    tracemalloc.start()
+    try:
+        status, out, err = run_cli("extract", archive, dest)
+        _, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+
+    assert status == 0
+    assert out == "extracted 1 files\n"
+    assert err == ""
+    assert (dest / "large.bin").stat().st_size == size
+
+    extracted = dest / "large.bin"
+    with extracted.open("rb") as handle:
+        assert handle.read(len(chunk)) == chunk
+        handle.seek(size - len(chunk))
+        assert handle.read(len(chunk)) == chunk
+
+    # The member is 64 MiB; peak Python allocation must stay orders of magnitude below it, which
+    # is only true if the body was streamed through a fixed buffer rather than read whole.
+    assert peak < 8 * 1024 * 1024, "peak allocation {0} bytes for a {1}-byte member".format(
+        peak, size
+    )
