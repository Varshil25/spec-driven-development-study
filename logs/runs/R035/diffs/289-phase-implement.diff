+def test_fr_025_resolve_exit_status_precedence():
+    """FR-025: 2-only -> 2, 3-only -> 3, mixed -> 2, empty -> 0."""
+    class_two = core.Problem(core.EXIT_INPUT, "two")
+    class_three = core.Problem(core.EXIT_REFUSED_OVERWRITE, "three")
+
+    assert core.resolve_exit_status([class_two]) == core.EXIT_INPUT
+    assert core.resolve_exit_status([class_three]) == core.EXIT_REFUSED_OVERWRITE
+    assert core.resolve_exit_status([class_three, class_two]) == core.EXIT_INPUT
+    assert core.resolve_exit_status([class_two, class_three]) == core.EXIT_INPUT
+    assert core.resolve_exit_status([]) == core.EXIT_OK
+
