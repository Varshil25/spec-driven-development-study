+        (dest / name).write_bytes(b"mine")
+
+    _, problems = _plan_for(
+        make_archive,
+        dest,
+        [
+            ("zebra.txt", "file", "z"),
+            ("../escape.txt", "file", "hostile"),
+            ("alpha.txt", "file", "a"),
+        ],
+    )
+
+    assert [p.message for p in problems] == [
+        "tarx: refusing to overwrite existing file '{0}' (re-run with --overwrite)".format(
+            dest / "zebra.txt"
+        ),
+        "tarx: unsafe member path '../escape.txt': resolves outside destination '{0}'".format(
+            dest
+        ),
+        "tarx: refusing to overwrite existing file '{0}' (re-run with --overwrite)".format(
+            dest / "alpha.txt"
+        ),
+    ]
