+"""Argument parsing, command dispatch, stream writing and exit statuses for ``tarx``.
+
+This is the only module that writes to stdout/stderr or decides an exit status. It holds no
+archive logic of its own -- everything about archives lives in :mod:`tarx.core`.
+"""
+
+import argparse
+import sys
+
+from . import core
+
+
+def build_parser():
+    """Build the ``tarx`` argument parser.
+
+    Two subcommands, three operands, one option -- nothing else (FR-001, contracts/cli.md ->
+    Invocation). The help strings name both commands, both operands and ``--overwrite`` so a new
+    user can discover the whole interface from the tool's own output (SC-009).
+
+    No ``type=`` converter touches the filesystem: argument validation stays purely syntactic,
+    which is what makes FR-017's "nothing is read or written" hold by construction
+    (research.md section 7).
+    """
+    parser = argparse.ArgumentParser(
+        prog="tarx",
+        description=(
+            "List and extract tar archives. Plain and gzip-compressed archives are both "
+            "accepted and are told apart by content, not by filename."
+        ),
+    )
+    subparsers = parser.add_subparsers(dest="command", metavar="COMMAND", required=True)
+
+    list_parser = subparsers.add_parser(
+        "list",
+        help="list ARCHIVE: print the name of every member, one per line, in archive order",
+        description=(
+            "Print the name of every member of ARCHIVE to standard output, one name per line, "
+            "in the order the archive stores them. Nothing is written to disk."
+        ),
+    )
+    list_parser.add_argument(
+        "archive",
+        metavar="ARCHIVE",
+        help="path to a tar archive, plain or gzip-compressed",
+    )
+
+    extract_parser = subparsers.add_parser(
+        "extract",
+        help=(
+            "extract ARCHIVE DEST [--overwrite]: write the archive's files and directories "
+            "under DEST"
+        ),
+        description=(
+            "Write ARCHIVE's regular-file and directory members beneath DEST, keeping each "
+            "member's archive-relative path, then report 'extracted N files'. DEST is created "
+            "with any missing parents if it does not exist."
+        ),
+    )
+    extract_parser.add_argument(
+        "archive",
+        metavar="ARCHIVE",
+        help="path to a tar archive, plain or gzip-compressed",
+    )
+    extract_parser.add_argument(
+        "dest",
+        metavar="DEST",
+        help="destination directory; created with missing parents if it does not exist",
+    )
+    extract_parser.add_argument(
+        "--overwrite",
+        action="store_true",
+        default=False,
+        help=(
+            "consent to replacing existing regular files with the archive's versions; "
+            "without it, a would-be replacement refuses the whole run (exit 3)"
+        ),
+    )
+
+    return parser
+
+
+def _run_list(archive):
+    """``list ARCHIVE``: one member name per line, no header, footer, count or separator.
+
+    Failures propagate as :class:`core.TarxError` and are handled by :func:`main`; there is no
+    ``try`` block here (contracts/cli.md -> ``list ARCHIVE``).
+    """
+    for name in core.iter_member_names(archive):
+        print(name)
+    return core.EXIT_OK
+
+
+def _run_extract(archive, dest, overwrite):
+    """``extract ARCHIVE DEST [--overwrite]``: problems to stderr, or the summary to stdout.
+
+    On problems, every problem line goes to stderr and **nothing** goes to stdout (SC-006). On
+    success, the skip notices go to stderr in archive order and the single summary line goes to
+    stdout. The summary is written only on success, so a failing run never looks successful
+    (Constitution Principle II).
+    """
+    problems, skipped, count = core.extract(archive, dest, overwrite)
+
+    if problems:
+        for problem in problems:
+            print(problem.message, file=sys.stderr)
+        return core.resolve_exit_status(problems)
+
+    for name, label in skipped:
+        print(
+            "tarx: skipping non-regular member '{0}' ({1})".format(name, label),
+            file=sys.stderr,
+        )
+    print("extracted {0} files".format(count))
+    return core.EXIT_OK
+
+
+def main(argv=None):
+    """Entry point. Returns the process exit status; never calls ``sys.exit`` itself.
+
+    Both streams are reconfigured with ``errors="surrogateescape"`` before anything is written,
+    so a member name that is not valid UTF-8 round-trips to the exact bytes recorded in the
+    archive instead of raising (research.md section 8).
+
+    Returning rather than exiting is what lets the test suite assert statuses in-process. The
+    one exception is an invalid invocation, where ``argparse`` raises ``SystemExit(2)`` with its
+    own unmodified usage output (template D12, FR-017).
+    """
+    sys.stdout.reconfigure(errors="surrogateescape")
+    sys.stderr.reconfigure(errors="surrogateescape")
+
+    args = build_parser().parse_args(argv)
+
+    try:
+        if args.command == "list":
+            return _run_list(args.archive)
+        return _run_extract(args.archive, args.dest, args.overwrite)
+    except core.TarxError as err:
+        print(err.message, file=sys.stderr)
+        return err.exit_class
diff --git a/src/tarx/core.py b/src/tarx/core.py
new file mode 100644
index 0000000..387767b
--- /dev/null
+++ b/src/tarx/core.py
@@ -0,0 +1,515 @@
+"""Archive reading, validation and writing for the ``tarx`` CLI.
+
+This module never prints and never calls ``sys.exit``. It reports fatal conditions by raising
+:class:`TarxError` and non-fatal (but run-stopping) conditions by returning :class:`Problem`
+objects, which leaves ``tarx.cli`` as the single place that touches the streams and the exit
+status. That split is what lets validation be asserted in-process by the test suite
+(Constitution Principle III).
+"""
+
+import contextlib
+import os
+import os.path
+import shutil
+import tarfile
+
+# --------------------------------------------------------------------------------------
+# Exit statuses (data-model.md -> Outcome; contracts/cli.md -> Exit statuses)
+#
+# These three values are the whole status vocabulary. No other status may ever be returned.
+# --------------------------------------------------------------------------------------
+
+EXIT_OK = 0
+EXIT_INPUT = 2
+EXIT_REFUSED_OVERWRITE = 3
+
+
+class TarxError(Exception):
+    """A fatal condition, carrying the finished diagnostic and the status to exit with.
+
+    ``message`` is the complete stderr line, already formatted and already carrying the
+    ``tarx: `` prefix. ``exit_class`` is either :data:`EXIT_INPUT` or
+    :data:`EXIT_REFUSED_OVERWRITE`. Raising rather than printing keeps ``core`` free of stream
+    and exit handling (Constitution Principle II: nothing is swallowed, nothing is silent).
+    """
+
+    def __init__(self, message, exit_class):
+        super().__init__(message)
+        self.message = message
+        self.exit_class = exit_class
+
+
+# --------------------------------------------------------------------------------------
+# Member interpretation (data-model.md -> Member)
+# --------------------------------------------------------------------------------------
+
+KIND_FILE = "file"
+KIND_DIR = "dir"
+KIND_OTHER = "other"
+
+#: Labels for the member types extraction refuses to create (contracts/cli.md ->
+#: Skipped members). Anything absent from this mapping is reported as the fallback below.
+KIND_LABELS = {
+    tarfile.SYMTYPE: "symbolic link",
+    tarfile.LNKTYPE: "hard link",
+    tarfile.CHRTYPE: "character device",
+    tarfile.BLKTYPE: "block device",
+    tarfile.FIFOTYPE: "FIFO",
+}
+
+UNSUPPORTED_LABEL = "unsupported member type"
+
+
+def member_kind(info):
+    """Classify a ``TarInfo`` as :data:`KIND_FILE`, :data:`KIND_DIR` or :data:`KIND_OTHER`."""
+    if info.isreg():
+        return KIND_FILE
+    if info.isdir():
+        return KIND_DIR
+    return KIND_OTHER
+
+
+def kind_label(info):
+    """Human-readable label for a :data:`KIND_OTHER` member, used in the skip notice."""
+    return KIND_LABELS.get(info.type, UNSUPPORTED_LABEL)
+
+
+def display_name(name):
+    """The form ``list`` prints: the member name with trailing ``/`` characters stripped.
+
+    Falls back to the unchanged name when stripping would leave an empty string, so a
+    pathological name made only of slashes still produces a line rather than a blank one
+    (research.md section 9, FR-024).
+    """
+    stripped = name.rstrip("/")
+    return stripped if stripped else name
+
+
+# --------------------------------------------------------------------------------------
+# Opening the archive (research.md section 1)
+# --------------------------------------------------------------------------------------
+
+
+def _reason(exc):
+    """The trailing ``{reason}`` of a diagnostic template, flattened to a single line.
+
+    ``tarfile`` reports a failed ``"r:*"`` probe as a multi-line string listing every
+    compression method it tried. Diagnostics are one problem per line (contracts/cli.md ->
+    Stream discipline), so whitespace runs are collapsed: the detail is kept, the line count is
+    not.
+    """
+    strerror = getattr(exc, "strerror", None)
+    text = strerror if strerror else str(exc)
+    return " ".join(text.split())
+
+
+@contextlib.contextmanager
+def open_archive(path):
+    """Open ``path`` as a tar archive, detecting format and compression from its content.
+
+    ``"r:*"`` sniffs the stream, so a gzip archive named ``.tar`` and a plain archive named
+    ``.tar.gz`` both work with no extension inspection anywhere (FR-004). ``{path}`` is echoed
+    into diagnostics exactly as the caller supplied it, never normalised.
+
+    Raises :class:`TarxError` with template D1 when the path cannot be opened (FR-012) and with
+    template D2 when the content is not a readable tar archive (FR-013). A truncated archive
+    that only fails once its members are walked surfaces as D2 as well, because the body of the
+    ``with`` block runs inside the same narrow ``tarfile.TarError`` guard.
+    """
+    try:
+        archive = tarfile.open(path, "r:*")
+    except OSError as exc:
+        raise TarxError(
+            "tarx: cannot open archive '{0}': {1}".format(path, _reason(exc)),
+            EXIT_INPUT,
+        ) from exc
+    except tarfile.TarError as exc:
+        raise TarxError(
+            "tarx: '{0}' is not a readable tar archive: {1}".format(path, _reason(exc)),
+            EXIT_INPUT,
+        ) from exc
+
+    try:
+        with archive:
+            yield archive
+    except tarfile.TarError as exc:
+        raise TarxError(
+            "tarx: '{0}' is not a readable tar archive: {1}".format(path, _reason(exc)),
+            EXIT_INPUT,
+        ) from exc
+
+
+# --------------------------------------------------------------------------------------
+# list (User Story 1)
+# --------------------------------------------------------------------------------------
+
+
+def iter_member_names(archive_path):
+    """Yield the display name of every member, in archive order, for every member type.
+
+    Only member *headers* are read -- no member body is ever touched, which is what keeps
+    listing a 10,000-member archive well inside SC-008's 5-second budget. No filtering and no
+    reordering (FR-002, FR-003).
+    """
+    with open_archive(archive_path) as archive:
+        for info in archive:
+            yield display_name(info.name)
+
+
+# --------------------------------------------------------------------------------------
+# Validation vocabulary (data-model.md -> Problem, MemberTarget, WritePlan)
+# --------------------------------------------------------------------------------------
+
+
+class Problem:
+    """One detected reason the run cannot proceed.
+
+    Validation accumulates these in a list and never raises on the first, which is what lets
+    every problem in one archive be reported together (FR-025).
+    """
+
+    def __init__(self, exit_class, message):
+        self.exit_class = exit_class
+        self.message = message
+
+    def __repr__(self):
+        return "Problem({0!r}, {1!r})".format(self.exit_class, self.message)
+
+
+class MemberTarget:
+    """A member name paired with where it would land under the destination.
+
+    data-model.md names the first field ``member``; it is ``name`` here because
+    :func:`check_member_path` is handed the name rather than the ``TarInfo`` (and the ``TarInfo``
+    itself is already carried by :attr:`WritePlan.files`, so storing it twice would be
+    redundant structure).
+    """
+
+    def __init__(self, name, relative, target):
+        self.name = name
+        self.relative = relative
+        self.target = target
+
+    def __repr__(self):
+        return "MemberTarget({0!r}, {1!r}, {2!r})".format(self.name, self.relative, self.target)
+
+
+class WritePlan:
+    """What validation hands to the write phase. Empty-but-valid is a success case (FR-018).
+
+    ``files`` is keyed by target path and insertion-ordered, so a duplicated member name is
+    written exactly once with the **last** member winning, and ``len(files)`` is both ``N`` and
+    the number of files actually on disk afterwards (research.md section 6, SC-003).
+
+    ``directories`` holds ``(member name, target path)`` pairs rather than data-model.md's bare
+    target paths: template D11 names the member it was writing, so the write phase needs a
+    member in hand for a failed ``makedirs`` too (FR-022).
+    """
+
+    def __init__(self):
+        self.directories = []
+        self.files = {}
+        self.skipped = []
+
+
+def resolve_exit_status(problems):
+    """Collapse a problem list to the single status for the run (FR-025).
+
+    Class 2 outranks class 3: status 3 means "re-run with ``--overwrite``", which would be false
+    advice when the archive or destination is unusable.
+    """
+    for problem in problems:
+        if problem.exit_class == EXIT_INPUT:
+            return EXIT_INPUT
+    if problems:
+        return EXIT_REFUSED_OVERWRITE
+    return EXIT_OK
+
+
+# --------------------------------------------------------------------------------------
+# Member path safety (research.md section 3)
+# --------------------------------------------------------------------------------------
+
+
+def _is_real_dir(path):
+    """True for an actual directory -- a symlink pointing at one does not count."""
+    return os.path.isdir(path) and not os.path.islink(path)
+
+
+def _is_real_file(path):
+    """True for an actual regular file -- a symlink pointing at one does not count.
+
+    The distinction matters: ``--overwrite`` consents to replacing a regular file, so a symlink
+    at the target path is a type mismatch (class 2), not a refused overwrite (class 3).
+    """
+    return os.path.isfile(path) and not os.path.islink(path)
+
+
+def check_member_path(name, kind, dest):
+    """Return a :class:`MemberTarget`, or a class-2 :class:`Problem` if the name escapes ``dest``.
+
+    The three rules of data-model.md -> MemberTarget are applied **lexically**: no ``realpath``
+    or ``resolve`` call, so the verdict is a property of the archive rather than of whatever
+    symlinks happen to exist under the destination, and is therefore reproducible in tests
+    (FR-014, research.md section 3). The check applies to every member kind, including the
+    non-regular members extraction would skip anyway.
+    """
+    unsafe = Problem(
+        EXIT_INPUT,
+        "tarx: unsafe member path '{0}': resolves outside destination '{1}'".format(name, dest),
+    )
+
+    if os.path.isabs(name):
+        return unsafe
+
+    relative = os.path.normpath(name)
+    if relative == ".." or relative.startswith(".." + os.sep):
+        return unsafe
+
+    if kind == KIND_FILE and relative in (".", ""):
+        return unsafe
+
+    return MemberTarget(name, relative, os.path.join(dest, relative))
+
+
+# --------------------------------------------------------------------------------------
+# extract: validation phase (FR-020)
+# --------------------------------------------------------------------------------------
+
+
+def _check_destination(dest):
+    """Destination-level problems, found before any member is walked (FR-019, FR-020).
+
+    Uses ``os.path.lexists``/``os.path.isdir`` only -- no write, no ``makedirs``. Walking up
+    from ``dest`` stops at the first ancestor that exists: if that one is a directory everything
+    above it is too, and if it is not, it is the specific path to name (template D4).
+    """
+    if os.path.lexists(dest) and not _is_real_dir(dest):
+        return [
+            Problem(
+                EXIT_INPUT,
+                "tarx: destination '{0}' exists but is not a directory".format(dest),
+            )
+        ]
+
+    current = os.path.dirname(dest)
+    seen = set()
+    while current and current not in seen:
+        seen.add(current)
+        if os.path.lexists(current):
+            if not _is_real_dir(current):
+                return [
+                    Problem(
+                        EXIT_INPUT,
+                        "tarx: cannot create destination '{0}': '{1}' is not a directory".format(
+                            dest, current
+                        ),
+                    )
+                ]
+            break
+        current = os.path.dirname(current)
+
+    return []
+
+
+def _ancestors_between(dest, relative):
+    """Every path strictly between ``dest`` and the member's target, outermost first.
+
+    ``dest`` itself is excluded: it is governed by :func:`_check_destination`, so including it
+    here would report the same problem once per member.
+    """
+    parts = [part for part in relative.split(os.sep) if part and part != "."]
+    ancestors = []
+    current = dest
+    for part in parts[:-1]:
+        current = os.path.join(current, part)
+        ancestors.append(current)
+    return ancestors
+
+
+def build_plan(archive, dest, overwrite):
+    """Walk every member and return ``(WritePlan, list[Problem])``, writing nothing at all.
+
+    Members are examined through their headers only -- no body is read in this phase.
+
+    Each member is run through :func:`check_member_path` first; a member rejected there is
+    excluded from every later check. More generally each member contributes **at most one**
+    problem line: the first check it fails stops the rest for that member (FR-025).
+
+    Problems come back in the deterministic order the contract specifies: destination-level
+    problems (D3, D4) first, then member problems in archive order. The archive-internal D9
+    check can only run once the whole plan is known -- a blocking member may appear *after* the
+    member it blocks -- so its problems are slotted back into archive order by the index of the
+    member that required the directory.
+
+    FR-020 is the hard rule for this function: it performs **no** filesystem writes whatsoever.
+    """
+    plan = WritePlan()
+    dest_problems = _check_destination(dest)
+    member_problems = []
+    flagged = set()
+    required_dirs = []
+
+    def record(index, message, exit_class=EXIT_INPUT):
+        """Attach one problem to member ``index`` and stop checking that member."""
+        member_problems.append((index, Problem(exit_class, message)))
+        flagged.add(index)
+
+    for index, info in enumerate(archive):
+        kind = member_kind(info)
+        name = info.name
+
+        checked = check_member_path(name, kind, dest)
+        if isinstance(checked, Problem):
+            member_problems.append((index, checked))
+            flagged.add(index)
+            continue
+
+        if kind == KIND_OTHER:
+            plan.skipped.append((name, kind_label(info)))
+            continue
+
+        ancestors = _ancestors_between(dest, checked.relative)
+        target = checked.target
+
+        blocked = [path for path in ancestors if os.path.lexists(path) and not _is_real_dir(path)]
+        if blocked:
+            record(
+                index,
+                "tarx: '{0}' is not a directory but is needed as a parent of member "
+                "'{1}'".format(blocked[0], name),
+            )
+            continue
+
+        for ancestor in ancestors:
+            required_dirs.append((index, name, ancestor))
+
+        if kind == KIND_DIR:
+            required_dirs.append((index, name, target))
+            if os.path.lexists(target) and not _is_real_dir(target):
+                record(
+                    index,
+                    "tarx: '{0}' is not a directory but member '{1}' is a directory".format(
+                        target, name
+                    ),
+                )
+                continue
+            plan.directories.append((name, target))
+            continue
+
+        if os.path.lexists(target):
+            if _is_real_dir(target):
+                record(
+                    index,
+                    "tarx: '{0}' is an existing directory but member '{1}' is a regular "
+                    "file".format(target, name),
+                )
+                continue
+            if not _is_real_file(target):
+                record(
+                    index,
+                    "tarx: '{0}' is an existing non-regular file but member '{1}' is a regular "
+                    "file".format(target, name),
+                )
+                continue
+            if not overwrite:
+                record(
+                    index,
+                    "tarx: refusing to overwrite existing file '{0}' "
+                    "(re-run with --overwrite)".format(target),
+                    EXIT_REFUSED_OVERWRITE,
+                )
+                continue
+
+        plan.files[target] = info
+
+    for index, name, path in required_dirs:
+        if index in flagged:
+            continue
+        blocking = plan.files.get(path)
+        if blocking is not None:
+            record(
+                index,
+                "tarx: archive member '{0}' is a regular file but member '{1}' requires it to "
+                "be a directory".format(blocking.name, name),
+            )
+
+    member_problems.sort(key=lambda item: item[0])
+    return plan, dest_problems + [problem for _, problem in member_problems]
+
+
+# --------------------------------------------------------------------------------------
+# extract: write phase, entered only when validation found nothing (FR-020)
+# --------------------------------------------------------------------------------------
+
+
+def _makedirs_or_fail(name, path):
+    """``os.makedirs`` with the FR-022 diagnostic attached, naming the member in hand."""
+    try:
+        os.makedirs(path, exist_ok=True)
+    except OSError as exc:
+        raise TarxError(
+            "tarx: failed while writing member '{0}' to '{1}': {2}".format(
+                name, path, _reason(exc)
+            ),
+            EXIT_INPUT,
+        ) from exc
+
+
+def write_plan(archive, dest, plan):
+    """Create the planned directories and stream the planned files. Returns the file count.
+
+    ``DEST`` is created with any missing parents (FR-007). Each file is streamed through
+    ``shutil.copyfileobj``, whose fixed-size buffer bounds memory by the buffer rather than by
+    the member's size (SC-008, research.md section 2).
+
+    Opening ``"wb"`` truncates and replaces an existing regular file in place, so one write path
+    serves both the newly-created and the ``--overwrite``-replaced case; the returned count is
+    ``len(plan.files)``, which counts replaced files alongside new ones (FR-010, SC-003).
+
+    Permissions, ownership and timestamps are deliberately **not** restored -- metadata
+    preservation is out of scope (spec Assumptions).
+    """
+    try:
+        os.makedirs(dest, exist_ok=True)
+    except OSError as exc:
+        raise TarxError(
+            "tarx: cannot create destination '{0}': {1}".format(dest, _reason(exc)),
+            EXIT_INPUT,
+        ) from exc
+
+    for name, path in plan.directories:
+        _makedirs_or_fail(name, path)
+
+    for target, info in plan.files.items():
+        parent = os.path.dirname(target)
+        if parent:
+            _makedirs_or_fail(info.name, parent)
+        try:
+            with archive.extractfile(info) as source, open(target, "wb") as handle:
+                shutil.copyfileobj(source, handle)
+        except OSError as exc:
+            raise TarxError(
+                "tarx: failed while writing member '{0}' to '{1}': {2}".format(
+                    info.name, target, _reason(exc)
+                ),
+                EXIT_INPUT,
+            ) from exc
+
+    return len(plan.files)
+
+
+def extract(archive_path, dest, overwrite):
+    """Run both phases. Returns ``(problems, skipped, count)``.
+
+    A non-empty ``problems`` list means the write phase was **not** entered and the destination
+    is exactly as it was; the caller turns the list into stderr lines and a status via
+    :func:`resolve_exit_status`. The boundary between the phases is FR-020 and is not softened
+    by any early write.
+    """
+    with open_archive(archive_path) as archive:
+        plan, problems = build_plan(archive, dest, overwrite)
+        if problems:
+            return problems, [], 0
+        count = write_plan(archive, dest, plan)
+        return [], plan.skipped, count
