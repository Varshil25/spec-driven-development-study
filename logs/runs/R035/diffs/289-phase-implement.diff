index 0000000..9944c42
--- /dev/null
+++ b/tests/test_traceability.py
@@ -0,0 +1,81 @@
+"""FR-021 / SC-007 audit: every functional requirement is referenced by at least one test.
+
+Constitution Principle III makes the requirement-to-test mapping auditable rather than assumed,
+and FR-021 makes the mapping itself a requirement -- so it gets a test. This file is the audit:
+it parses every ``FR-###`` identifier out of ``spec.md`` and fails with the list of uncovered
+identifiers if any is not referenced somewhere under ``tests/``.
+"""
+
+import pathlib
+import re
+
+REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
+TESTS_DIR = REPO_ROOT / "tests"
+SPEC = REPO_ROOT / "specs" / "001-tarx-cli" / "spec.md"
+
+REQUIREMENT_PATTERN = re.compile(r"\bFR-(\d{3})\b")
+
+# Test files reference requirements with an underscore (``test_fr_014_...``) and documents with a
+# hyphen (``FR-014``); both forms count as a reference.
+REFERENCE_FORMS = ("FR-{0}", "fr_{0}")
+
+
+def _spec_requirement_ids():
+    """Every distinct ``FR-###`` identifier defined in the specification."""
+    assert SPEC.is_file(), "spec.md not found at {0}".format(SPEC)
+    return sorted(set(REQUIREMENT_PATTERN.findall(SPEC.read_text(encoding="utf-8"))))
+
+
+def _test_corpus():
+    """The concatenated text of every test module, which is where references must appear."""
+    chunks = []
+    for path in sorted(TESTS_DIR.rglob("*.py")):
+        chunks.append(path.read_text(encoding="utf-8"))
+    return "\n".join(chunks)
+
+
+def test_fr_021_spec_defines_requirements_to_audit():
+    """FR-021: the audit is only meaningful if the spec actually yields requirement IDs."""
+    identifiers = _spec_requirement_ids()
+
+    assert identifiers, "no FR-### identifiers found in spec.md -- the audit would pass vacuously"
+    assert identifiers[0] == "001"
+
+
+def test_fr_021_every_requirement_is_referenced_by_at_least_one_test():
+    """FR-021 / SC-007: no functional requirement is left without a covering test.
+
+    Fails with the explicit list of uncovered identifiers so the gap is actionable rather than
+    a bare assertion failure.
+    """
+    corpus = _test_corpus()
+
+    uncovered = [
+        "FR-{0}".format(number)
+        for number in _spec_requirement_ids()
+        if not any(form.format(number) in corpus for form in REFERENCE_FORMS)
+    ]
+
+    assert uncovered == [], "requirements with no referencing test: {0}".format(
+        ", ".join(uncovered)
+    )
+
+
+def test_fr_021_requirement_to_test_map_in_data_model_is_not_stale():
+    """FR-021: cross-check the audit against the requirement-to-test map in data-model.md.
+
+    The map is the human-readable half of the same claim, so a requirement present in the spec
+    but missing from the map (or vice versa) means one of the two documents is wrong.
+    """
+    data_model = (REPO_ROOT / "specs" / "001-tarx-cli" / "data-model.md").read_text(
+        encoding="utf-8"
+    )
+    mapped = set(REQUIREMENT_PATTERN.findall(data_model))
+    specified = set(_spec_requirement_ids())
+
+    assert specified - mapped == set(), "in spec.md but absent from the map: {0}".format(
+        sorted("FR-{0}".format(n) for n in specified - mapped)
+    )
+    assert mapped - specified == set(), "in the map but absent from spec.md: {0}".format(
+        sorted("FR-{0}".format(n) for n in mapped - specified)
+    )
diff --git a/tests/test_validation.py b/tests/test_validation.py
