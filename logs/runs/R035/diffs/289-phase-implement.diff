+"""Tests for ``list ARCHIVE`` (User Story 1).
+
+Covers FR-002, FR-003, FR-004, FR-016, FR-018 and FR-024.
+"""
+
+import tarfile
+
+
+# ----------------------------------------------------------------------------------------
+# T013 -- happy path: FR-002, FR-016, FR-018
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_002_every_member_printed_one_per_line_in_archive_order(make_archive, run_cli):
+    """FR-002: every member is printed, one name per line, in the order the archive stores them.
+
+    The members are deliberately built out of alphabetical order so an accidental sort fails.
+    """
+    archive = make_archive(
+        [
+            ("zebra.txt", "file", "z"),
+            ("alpha.txt", "file", "a"),
+            ("middle.txt", "file", "m"),
+        ]
+    )
+
+    status, out, err = run_cli("list", archive)
+
+    assert status == 0
+    assert out == "zebra.txt\nalpha.txt\nmiddle.txt\n"
+    assert err == ""
+
+
+def test_fr_016_success_puts_results_on_stdout_only_and_exits_zero(make_archive, run_cli):
+    """FR-016: a completed run exits 0, results go to stdout, stderr stays empty."""
+    archive = make_archive([("only.txt", "file", "data")])
+
+    status, out, err = run_cli("list", archive)
+
+    assert status == 0
+    assert out == "only.txt\n"
+    assert err == ""
+
+
+def test_fr_018_empty_archive_produces_no_stdout_and_exits_zero(empty_archive, run_cli):
+    """FR-018: an archive with no members produces completely empty stdout and exit 0."""
+    status, out, err = run_cli("list", empty_archive)
+
+    assert status == 0
+    assert out == ""
+    assert err == ""
+
+
+# ----------------------------------------------------------------------------------------
+# T014 -- member forms: FR-003, FR-024
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_003_all_member_types_listed_unfiltered_and_unreordered(make_archive, run_cli):
+    """FR-003: directories and non-regular members are listed too, unfiltered and unreordered."""
+    archive = make_archive(
+        [
+            ("photos/", "dir", None),
+            ("photos/link.jpg", "symlink", "a.jpg"),
+            ("photos/a.jpg", "file", "alpha"),
+            ("dev/null", "chardev", None),
+            ("pipe", "fifo", None),
+            ("photos/hard.jpg", "hardlink", "photos/a.jpg"),
+        ]
+    )
+
+    status, out, err = run_cli("list", archive)
+
+    assert status == 0
+    assert out.splitlines() == [
+        "photos",
+        "photos/link.jpg",
+        "photos/a.jpg",
+        "dev/null",
+        "pipe",
+        "photos/hard.jpg",
+    ]
+    assert err == ""
+
+
+def test_fr_003_duplicate_member_name_appears_once_per_occurrence(make_archive, run_cli):
+    """FR-003: a duplicated member name is printed once per occurrence, not deduplicated."""
+    archive = make_archive(
+        [
+            ("dup.txt", "file", "first"),
+            ("other.txt", "file", "other"),
+            ("dup.txt", "file", "second"),
+        ]
+    )
+
+    status, out, _ = run_cli("list", archive)
+
+    assert status == 0
+    assert out.splitlines() == ["dup.txt", "other.txt", "dup.txt"]
+
+
+def test_fr_024_directory_member_printed_without_trailing_slash(make_archive, run_cli):
+    """FR-024: a directory member recorded as ``photos/`` prints as ``photos``."""
+    archive = make_archive([("photos/", "dir", None), ("photos/a.jpg", "file", "alpha")])
+
+    status, out, _ = run_cli("list", archive)
+
+    assert status == 0
+    assert out.splitlines() == ["photos", "photos/a.jpg"]
+
+
+def test_fr_024_dot_slash_member_prints_as_dot(make_archive, run_cli):
+    """FR-024: a member recorded as ``./`` prints as ``.`` -- a valid relative path."""
+    archive = make_archive([("./", "dir", None)])
+
+    status, out, _ = run_cli("list", archive)
+
+    assert status == 0
+    assert out.splitlines() == ["."]
+
+
+def test_fr_024_name_of_only_slashes_printed_unchanged_not_as_blank_line(
+    make_archive, run_cli
+):
+    """FR-024: a pathological all-slashes name is printed unchanged, never as a blank line.
+
+    Stripping would empty it, so the unchanged name is used instead (research.md section 9).
+    The member is recorded as a regular file because ``tarfile`` strips trailing slashes from
+    *directory* names itself while reading the header, so a directory named ``///`` never
+    reaches our code with its slashes intact -- a regular-file member is what actually
+    exercises the guard.
+    """
+    archive = make_archive([("///", "file", "")])
+
+    status, out, _ = run_cli("list", archive)
+
+    assert status == 0
+    assert out == "///\n"
+    assert out.strip() != ""
+
+
+def test_fr_024_non_ascii_member_name_printed_with_archive_bytes(make_archive, run_cli):
+    """FR-024 / FR-002: a non-ASCII member name is printed as the archive records it."""
+    archive = make_archive([("fotos/été.jpg", "file", "x"), ("漢字", "file", "y")])
+
+    status, out, _ = run_cli("list", archive)
+
+    assert status == 0
+    assert out.splitlines() == ["fotos/été.jpg", "漢字"]
+
+
+def test_fr_024_surrogate_escaped_member_name_round_trips(tmp_path, run_module):
+    """FR-002: a member name that is not valid UTF-8 round-trips to the archive's exact bytes.
+
+    Asserted through a subprocess so the real stdout bytes are observable: the name is written
+    back with ``errors="surrogateescape"`` rather than raising (research.md section 8).
+    """
+    raw_name = b"caf\xe9.txt"
+    archive = tmp_path / "surrogate.tar"
+    with tarfile.open(archive, "w") as handle:
+        info = tarfile.TarInfo(raw_name.decode("utf-8", "surrogateescape"))
+        info.size = 0
+        handle.addfile(info)
+
+    result = run_module("list", archive)
+
+    assert result.returncode == 0
+    assert result.stdout.encode("utf-8", "surrogateescape") == raw_name + b"\n"
+
+
+# ----------------------------------------------------------------------------------------
+# T015 -- format detection and the documented invocation: FR-004
+# ----------------------------------------------------------------------------------------
+
+
+ENTRIES = [("photos/", "dir", None), ("photos/a.jpg", "file", "alpha"), ("photos/b.jpg", "file", "beta")]
+EXPECTED = ["photos", "photos/a.jpg", "photos/b.jpg"]
+
+
+def test_fr_004_plain_and_gzip_archives_list_identically(make_archive, run_cli):
+    """FR-004: a gzip archive lists exactly like its plain equivalent."""
+    plain = make_archive(ENTRIES, compress=False, filename="plain.tar")
+    gzipped = make_archive(ENTRIES, compress=True, filename="gz.tar.gz")
+
+    plain_status, plain_out, _ = run_cli("list", plain)
+    gzip_status, gzip_out, _ = run_cli("list", gzipped)
+
+    assert (plain_status, plain_out.splitlines()) == (0, EXPECTED)
+    assert (gzip_status, gzip_out.splitlines()) == (0, EXPECTED)
+    assert plain_out == gzip_out
+
+
+def test_fr_004_detection_is_by_content_not_by_extension(make_archive, run_cli):
+    """FR-004: a gzip archive named ``.tar`` and a plain archive named ``.tar.gz`` both work.
+
+    This is the test that fails if detection ever branches on the filename.
+    """
+    gzip_named_tar = make_archive(ENTRIES, compress=True, filename="misnamed.tar")
+    plain_named_gz = make_archive(ENTRIES, compress=False, filename="misnamed.tar.gz")
+
+    gzip_status, gzip_out, gzip_err = run_cli("list", gzip_named_tar)
+    plain_status, plain_out, plain_err = run_cli("list", plain_named_gz)
+
+    assert (gzip_status, gzip_out.splitlines(), gzip_err) == (0, EXPECTED, "")
+    assert (plain_status, plain_out.splitlines(), plain_err) == (0, EXPECTED, "")
+
+
+def test_fr_002_python_m_tarx_list_works_as_a_real_process(make_archive, run_module):
+    """FR-002 / FR-016: ``python -m tarx list ARCHIVE`` with ``PYTHONPATH=src`` exits 0.
+
+    Covers ``src/tarx/__main__.py`` and the real process exit status, which in-process tests
+    cannot reach.
+    """
+    archive = make_archive(ENTRIES)
+
+    result = run_module("list", archive)
+
+    assert result.returncode == 0
+    assert result.stdout.splitlines() == EXPECTED
+    assert result.stderr == ""
