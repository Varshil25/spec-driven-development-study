@@ -0,0 +1,158 @@
+"""Shared fixtures: archive building, CLI invocation, and destination-tree snapshots.
+
+Archives are built at test time with ``tarfile`` into ``tmp_path``; no binary fixture archives
+are committed to the repository (research.md section 10).
+"""
+
+import io
+import itertools
+import os
+import pathlib
+import subprocess
+import sys
+import tarfile
+
+import pytest
+
+REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
+SRC_DIR = REPO_ROOT / "src"
+
+# Member kinds accepted by the ``make_archive`` factory, mapped to their tar type byte.
+# "file" and "dir" are handled separately because they carry a size / contents.
+_OTHER_TYPES = {
+    "symlink": tarfile.SYMTYPE,
+    "hardlink": tarfile.LNKTYPE,
+    "fifo": tarfile.FIFOTYPE,
+    "chardev": tarfile.CHRTYPE,
+    "blockdev": tarfile.BLKTYPE,
+}
+
+
+@pytest.fixture
+def make_archive(tmp_path):
+    """Factory building a tar archive from an explicit, ordered list of member entries.
+
+    Each entry is ``(name, kind, contents)``:
+
+    * ``kind="file"``   -- ``contents`` is ``str`` or ``bytes`` (``b""``/``""`` gives a
+      zero-length member); ``name`` is recorded verbatim, so non-ASCII and surrogate-escaped
+      names are supported.
+    * ``kind="dir"``    -- ``contents`` is ignored; pass the name with or without a trailing
+      ``/`` to control exactly what the archive records.
+    * ``kind`` in ``symlink``/``hardlink``/``fifo``/``chardev``/``blockdev`` -- ``contents`` is
+      the link target where one applies, ignored otherwise.
+
+    Members are written in the order given, so archive order (including duplicate names and
+    deliberately non-alphabetical order) is under the test's control.
+
+    ``compress=True`` writes gzip; ``filename=`` overrides the generated name so a gzip archive
+    can be given a ``.tar`` name and vice versa (FR-004).
+    """
+    counter = itertools.count()
+
+    def _make(entries, compress=False, filename=None):
+        if filename is None:
+            suffix = ".tar.gz" if compress else ".tar"
+            filename = "archive{0}{1}".format(next(counter), suffix)
+        path = tmp_path / filename
+        path.parent.mkdir(parents=True, exist_ok=True)
+        mode = "w:gz" if compress else "w"
+        with tarfile.open(path, mode) as archive:
+            for name, kind, contents in entries:
+                info = tarfile.TarInfo(name)
+                if kind == "file":
+                    data = contents.encode() if isinstance(contents, str) else (contents or b"")
+                    info.type = tarfile.REGTYPE
+                    info.size = len(data)
+                    archive.addfile(info, io.BytesIO(data))
+                elif kind == "dir":
+                    info.type = tarfile.DIRTYPE
+                    info.size = 0
+                    archive.addfile(info)
+                elif kind in _OTHER_TYPES:
+                    info.type = _OTHER_TYPES[kind]
+                    info.size = 0
+                    if kind in ("symlink", "hardlink"):
+                        info.linkname = contents or "target"
+                    archive.addfile(info)
+                else:
+                    raise ValueError("unknown member kind: {0!r}".format(kind))
+        return path
+
+    return _make
+
+
+@pytest.fixture
+def empty_archive(make_archive):
+    """A valid tar archive with no members at all (FR-018)."""
+    return make_archive([], filename="empty.tar")
+
+
+@pytest.fixture
+def run_cli(capsys):
+    """Call ``tarx.cli.main`` in process; return ``(status, stdout, stderr)``.
+
+    ``main`` returns its status rather than exiting, so the status is assertable directly.
+    Arguments are stringified, so ``pathlib.Path`` objects can be passed through.
+    """
+    from tarx import cli
+
+    def _run(*argv):
+        status = cli.main([str(arg) for arg in argv])
+        captured = capsys.readouterr()
+        return status, captured.out, captured.err
+
+    return _run
+
+
+@pytest.fixture
+def run_module():
+    """Run ``python -m tarx`` as a real subprocess with ``src`` on ``PYTHONPATH``.
+
+    This is the only way to cover ``src/tarx/__main__.py``, the documented invocation, and the
+    real process exit status; in-process calls cannot reach any of the three.
+    """
+
+    def _run(*argv):
+        env = dict(os.environ)
+        env["PYTHONPATH"] = str(SRC_DIR)
+        return subprocess.run(
+            [sys.executable, "-m", "tarx", *[str(arg) for arg in argv]],
+            capture_output=True,
+            text=True,
+            # Decode the child's streams the same way the tool encodes them, so a member name
+            # that is not valid UTF-8 reaches the test instead of crashing the harness.
+            errors="surrogateescape",
+            env=env,
+            cwd=str(REPO_ROOT),
+        )
+
+    return _run
+
+
+@pytest.fixture
+def snapshot_tree():
+    """Snapshot a directory tree as ``{relative path: bytes | None}`` for before/after compares.
+
+    Directories map to ``None``, regular files to their exact bytes. A missing root snapshots as
+    an empty dict, so "nothing was created" and "nothing was changed" are the same assertion
+    (FR-009, FR-020).
+    """
+
+    def _snapshot(root):
+        root = pathlib.Path(root)
+        if not root.exists():
+            return {}
+        captured = {}
+        for current, dirnames, filenames in os.walk(root):
+            dirnames.sort()
+            filenames.sort()
+            for dirname in dirnames:
+                full = pathlib.Path(current) / dirname
+                captured[str(full.relative_to(root))] = None
+            for filename in filenames:
+                full = pathlib.Path(current) / filename
+                captured[str(full.relative_to(root))] = full.read_bytes()
+        return captured
+
+    return _snapshot
