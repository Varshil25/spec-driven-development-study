index 0000000..8ad5d6e
--- /dev/null
+++ b/tests/test_validation.py
@@ -0,0 +1,442 @@
+"""Unit-level tests of ``core``'s validation, called directly rather than through the CLI.
+
+Covers FR-014 path safety here; FR-023 and FR-025 classification is added by T038.
+"""
+
+import os
+
+import pytest
+
+from tarx import core
+
+
+def _check(name, kind, dest="/dest"):
+    """Run the path-safety check and return the result for a type assertion."""
+    return core.check_member_path(name, kind, dest)
+
+
+def _is_problem(result):
+    return isinstance(result, core.Problem)
+
+
+# ----------------------------------------------------------------------------------------
+# T021 -- FR-014 path safety, applied lexically and to every member kind
+# ----------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "/etc/passwd",
+        "/",
+        "..",
+        "../escape.txt",
+        "../../escape.txt",
+        "a/../../b",
+        "./../b",
+    ],
+)
+def test_fr_014_escaping_member_names_are_rejected(name):
+    """FR-014: absolute names and names resolving outside DEST are refused."""
+    result = _check(name, core.KIND_FILE)
+
+    assert _is_problem(result)
+    assert result.exit_class == core.EXIT_INPUT
+    assert result.message == (
+        "tarx: unsafe member path '{0}': resolves outside destination '/dest'".format(name)
+    )
+
+
+@pytest.mark.parametrize("name", [".", "", "./", "a/.."])
+def test_fr_014_path_with_no_name_of_its_own_is_rejected_for_a_regular_file(name):
+    """FR-014: a regular-file member normalising to ``.`` or empty has no path of its own."""
+    result = _check(name, core.KIND_FILE)
+
+    assert _is_problem(result)
+    assert result.exit_class == core.EXIT_INPUT
+
+
+@pytest.mark.parametrize(
+    "name, expected_relative",
+    [
+        ("a.txt", "a.txt"),
+        ("photos/a.jpg", "photos/a.jpg"),
+        ("a/./b", "a/b"),
+        ("a/b/../c", "a/c"),
+        ("./a.txt", "a.txt"),
+        ("deep/nested/path/file.bin", "deep/nested/path/file.bin"),
+    ],
+)
+def test_fr_014_ordinary_relative_names_are_accepted(name, expected_relative):
+    """FR-014: harmless interior ``.``/``..`` segments that stay inside DEST are accepted."""
+    result = _check(name, core.KIND_FILE)
+
+    assert not _is_problem(result)
+    assert result.relative == expected_relative
+    assert result.target == os.path.join("/dest", expected_relative)
+
+
+def test_fr_014_dot_is_accepted_for_a_directory_member():
+    """FR-014: a directory member normalising to ``.`` is DEST itself, which is legitimate.
+
+    Archives commonly record a root entry as ``./``; rule 3 deliberately applies to regular
+    files only (data-model.md -> MemberTarget).
+    """
+    result = _check("./", core.KIND_DIR)
+
+    assert not _is_problem(result)
+    assert result.relative == "."
+
+
+@pytest.mark.parametrize("kind", [core.KIND_FILE, core.KIND_DIR, core.KIND_OTHER])
+def test_fr_014_check_applies_to_every_member_kind_including_skipped_ones(kind):
+    """FR-014 names "any member" with no type qualifier.
+
+    A hostile symlink entry refuses the whole archive even though extraction would never have
+    created it (research.md section 3).
+    """
+    result = _check("../../etc/passwd", kind)
+
+    assert _is_problem(result)
+    assert result.exit_class == core.EXIT_INPUT
+    assert "../../etc/passwd" in result.message
+
+
+def test_fr_014_check_is_lexical_and_does_not_touch_the_filesystem(tmp_path):
+    """FR-014: the verdict is a property of the archive, not of live filesystem state.
+
+    A symlink inside the destination that points elsewhere must not change the answer, and no
+    path is created by asking.
+    """
+    dest = tmp_path / "dest"
+    dest.mkdir()
+    (dest / "link").symlink_to(tmp_path / "elsewhere")
+
+    result = _check("link/file.txt", core.KIND_FILE, str(dest))
+
+    assert not _is_problem(result)
+    assert result.relative == "link/file.txt"
+    assert not (tmp_path / "elsewhere").exists()
+
+
+def test_fr_014_message_echoes_the_member_name_exactly_as_recorded():
+    """FR-014: the diagnostic names the offending member verbatim, unnormalised."""
+    result = _check("a/../../b", core.KIND_FILE, "out")
+
+    assert _is_problem(result)
+    assert result.message == (
+        "tarx: unsafe member path 'a/../../b': resolves outside destination 'out'"
+    )
+
+
+# ----------------------------------------------------------------------------------------
+# T038 -- classification and reporting rules, asserted against core directly
+#
+# One case per row of data-model.md -> "State transitions of a destination path", plus the
+# ancestor rules below that table, resolve_exit_status precedence, and reporting order.
+# ----------------------------------------------------------------------------------------
+
+
+def _plan_for(make_archive, dest, entries, overwrite=False):
+    """Build a plan for ``entries`` against ``dest`` and return ``(plan, problems)``."""
+    archive_path = make_archive(entries)
+    with core.open_archive(str(archive_path)) as archive:
+        return core.build_plan(archive, str(dest), overwrite)
+
+
+def _existing(dest, state):
+    """Materialise one of the existing-entry states from the data-model table at ``dest/x``."""
+    dest.mkdir(parents=True, exist_ok=True)
+    target = dest / "x"
+    if state == "nothing":
+        return target
+    if state == "directory":
+        target.mkdir()
+    elif state == "regular file":
+        target.write_bytes(b"existing")
+    elif state == "other":
+        target.symlink_to(dest / "somewhere-else")
+    else:
+        raise ValueError("unknown state: {0!r}".format(state))
+    return target
+
+
