@@ -0,0 +1,202 @@
+"""Tests for overwrite refusal (User Story 2) and opt-in replacement (User Story 3).
+
+Covers FR-009, FR-010, FR-011 and FR-020.
+"""
+
+
+# ----------------------------------------------------------------------------------------
+# T020 -- refusal without the flag: FR-009, FR-020
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_009_conflict_without_flag_writes_nothing_and_exits_three(
+    make_archive, tmp_path, run_cli, snapshot_tree
+):
+    """FR-009: a would-be replacement refuses the whole run -- zero files written, exit 3.
+
+    The non-conflicting members are asserted absent too: the refusal is archive-wide, not
+    per-member.
+    """
+    archive = make_archive(
+        [
+            ("a.txt", "file", "archive-a"),
+            ("b.txt", "file", "archive-b"),
+        ]
+    )
+    dest = tmp_path / "out"
+    dest.mkdir()
+    (dest / "a.txt").write_bytes(b"mine")
+    before = snapshot_tree(dest)
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 3
+    assert out == ""
+    assert err.splitlines() == [
+        "tarx: refusing to overwrite existing file '{0}' (re-run with --overwrite)".format(
+            dest / "a.txt"
+        )
+    ]
+    assert snapshot_tree(dest) == before
+    assert not (dest / "b.txt").exists()
+
+
+def test_fr_009_every_conflicting_path_is_named_one_per_line(
+    make_archive, tmp_path, run_cli, snapshot_tree
+):
+    """FR-009: *every* conflicting destination path is named, one per line, in archive order."""
+    archive = make_archive(
+        [
+            ("a.txt", "file", "archive-a"),
+            ("sub/c.txt", "file", "archive-c"),
+            ("b.txt", "file", "archive-b"),
+        ]
+    )
+    dest = tmp_path / "out"
+    (dest / "sub").mkdir(parents=True)
+    (dest / "a.txt").write_bytes(b"mine-a")
+    (dest / "sub" / "c.txt").write_bytes(b"mine-c")
+    before = snapshot_tree(dest)
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 3
+    assert out == ""
+    assert err.splitlines() == [
+        "tarx: refusing to overwrite existing file '{0}' (re-run with --overwrite)".format(
+            dest / "a.txt"
+        ),
+        "tarx: refusing to overwrite existing file '{0}' (re-run with --overwrite)".format(
+            dest / "sub" / "c.txt"
+        ),
+    ]
+    assert snapshot_tree(dest) == before
+
+
+def test_fr_020_conflict_at_the_last_member_still_writes_nothing(
+    make_archive, tmp_path, run_cli, snapshot_tree
+):
+    """FR-020: validation completes before the first write.
+
+    The only conflict sits at the *last* member of the archive, so an implementation that wrote
+    as it walked would already have created the earlier members. The destination must be
+    byte-identical to its pre-run snapshot.
+    """
+    archive = make_archive(
+        [
+            ("first.txt", "file", "1"),
+            ("second.txt", "file", "2"),
+            ("third.txt", "file", "3"),
+            ("last.txt", "file", "4"),
+        ]
+    )
+    dest = tmp_path / "out"
+    dest.mkdir()
+    (dest / "last.txt").write_bytes(b"mine")
+    before = snapshot_tree(dest)
+
+    status, out, err = run_cli("extract", archive, dest)
+
+    assert status == 3
+    assert out == ""
+    assert "last.txt" in err
+    assert snapshot_tree(dest) == before
+    assert sorted(p.name for p in dest.iterdir()) == ["last.txt"]
+
+
+# ----------------------------------------------------------------------------------------
+# T028 -- opt-in replacement with the flag: FR-010, FR-011
+# ----------------------------------------------------------------------------------------
+
+
+def test_fr_010_second_extraction_with_overwrite_succeeds_and_reports_full_count(
+    make_archive, tmp_path, run_cli
+):
+    """FR-010: re-extracting into a populated destination with ``--overwrite`` exits 0.
+
+    The reported count is the *full* file count, replaced files included.
+    """
+    archive = make_archive([("a.txt", "file", "alpha"), ("b.txt", "file", "beta")])
+    dest = tmp_path / "out"
+
+    first_status, first_out, _ = run_cli("extract", archive, dest)
+    second_status, second_out, second_err = run_cli("extract", archive, dest, "--overwrite")
+
+    assert (first_status, first_out) == (0, "extracted 2 files\n")
+    assert (second_status, second_out) == (0, "extracted 2 files\n")
+    assert second_err == ""
+    assert (dest / "a.txt").read_bytes() == b"alpha"
+    assert (dest / "b.txt").read_bytes() == b"beta"
+
+
+def test_fr_010_existing_file_with_different_contents_matches_the_archive_afterwards(
+    make_archive, tmp_path, run_cli
+):
+    """FR-010: a differing existing file ends up byte-identical to the archive's version."""
+    archive = make_archive([("a.txt", "file", "archive-version")])
+    dest = tmp_path / "out"
+    dest.mkdir()
+    (dest / "a.txt").write_bytes(b"a much longer pre-existing body that must be truncated")
+
+    status, out, _ = run_cli("extract", archive, dest, "--overwrite")
+
+    assert status == 0
+    assert out == "extracted 1 files\n"
+    assert (dest / "a.txt").read_bytes() == b"archive-version"
+
+
+def test_fr_011_existing_directory_is_not_a_conflict_with_the_flag_set(
+    make_archive, tmp_path, run_cli
+):
+    """FR-011: an existing directory at a directory member's path is fine under ``--overwrite``."""
+    archive = make_archive(
+        [("photos/", "dir", None), ("photos/a.jpg", "file", "alpha")]
+    )
+    dest = tmp_path / "out"
+    (dest / "photos").mkdir(parents=True)
+
+    status, out, err = run_cli("extract", archive, dest, "--overwrite")
+
+    assert status == 0
+    assert out == "extracted 1 files\n"
+    assert err == ""
+
+
+def test_fr_010_with_no_conflicts_overwrite_behaves_identically_to_omitting_it(
+    make_archive, tmp_path, run_cli, snapshot_tree
+):
+    """US3 scenario 3: with nothing to replace, ``--overwrite`` changes nothing at all."""
+    archive = make_archive(
+        [("photos/", "dir", None), ("photos/a.jpg", "file", "alpha"), ("b.txt", "file", "beta")]
+    )
+    without = tmp_path / "without"
+    with_flag = tmp_path / "with"
+
+    plain_status, plain_out, plain_err = run_cli("extract", archive, without)
+    flag_status, flag_out, flag_err = run_cli("extract", archive, with_flag, "--overwrite")
+
+    assert (plain_status, plain_out, plain_err) == (flag_status, flag_out, flag_err)
+    assert plain_out == "extracted 2 files\n"
+    assert snapshot_tree(without) == snapshot_tree(with_flag)
+
+
+def test_fr_010_destination_file_absent_from_the_archive_survives_the_flag(
+    make_archive, tmp_path, run_cli
+):
+    """FR-010: extraction merges into DEST; it never deletes files the archive lacks.
+
+    Asserted with ``--overwrite`` set, since that is the only mode where deletion could be
+    mistaken for intended behaviour (contracts/cli.md -> Guarantees).
+    """
+    archive = make_archive([("a.txt", "file", "alpha")])
+    dest = tmp_path / "out"
+    dest.mkdir()
+    (dest / "keep.txt").write_bytes(b"keep me")
+    (dest / "a.txt").write_bytes(b"replace me")
+
+    status, out, _ = run_cli("extract", archive, dest, "--overwrite")
+
+    assert status == 0
+    assert out == "extracted 1 files\n"
+    assert (dest / "keep.txt").read_bytes() == b"keep me"
+    assert (dest / "a.txt").read_bytes() == b"alpha"
