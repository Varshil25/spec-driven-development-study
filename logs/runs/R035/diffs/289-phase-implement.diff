diff --git a/pyproject.toml b/pyproject.toml
new file mode 100644
index 0000000..f617553
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,20 @@
+[project]
+name = "tarx"
+version = "0.1.0"
+description = "List and extract tar archives from the command line"
+requires-python = ">=3.11"
+# Constitution Principle I — Standard Library Only: runtime requirements MUST remain empty.
+dependencies = []
+
+# Test tooling is declared separately from runtime requirements so the distinction
+# stays visible (Constitution Principle I, Additional Constraints).
+[dependency-groups]
+test = ["pytest"]
+
+[tool.pytest.ini_options]
+# `import tarx` works with no editable install; tests are not installed.
+pythonpath = ["src"]
+testpaths = ["tests"]
+markers = [
+    "slow: SC-008 scale checks (10,000-member listing, larger-than-buffer streaming)",
+]
