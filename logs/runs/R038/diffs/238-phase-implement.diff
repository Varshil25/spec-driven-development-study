+++ b/tests/security/test_security_injection.py
@@ -0,0 +1,74 @@
+"""SR-001: user text is data, never SQL -- every statement is parameterised."""
+
+from __future__ import annotations
+
+import csv
+import io
+import json
+import sqlite3
+
+PAYLOAD = "'); DROP TABLE bookmarks;--"
+assert "," not in PAYLOAD  # so it survives tag parsing as one tag
+
+
+def _table_names(path: str) -> set[str]:
+    connection = sqlite3.connect(path)
+    try:
+        rows = connection.execute(
+            "SELECT name FROM sqlite_master WHERE type = 'table'"
+        ).fetchall()
+    finally:
+        connection.close()
+    return {row[0] for row in rows}
+
+
+def test_sql_metacharacters_are_literal_text(run, db, stored_bookmarks, stored_tag_links):
+    run("--db", db, "add", "https://kept.example", "--title", "kept", "--tags", "keep")
+
+    status, out, err = run(
+        "--db", db,
+        "add", f"https://a.example/{PAYLOAD}",
+        "--title", PAYLOAD,
+        "--tags", PAYLOAD,
+    )
+
+    assert status == 0
+    assert out == "2\n"
+
+    # The schema survived and the first bookmark is still there.
+    assert {"bookmarks", "bookmark_tags"} <= _table_names(db)
+    assert [row[0] for row in stored_bookmarks(db)] == [1, 2]
+    assert stored_bookmarks(db)[0] == (1, "https://kept.example", "kept")
+
+    # The payload came back verbatim, as data.
+    assert stored_bookmarks(db)[1] == (2, f"https://a.example/{PAYLOAD}", PAYLOAD)
+    assert (2, PAYLOAD) in stored_tag_links(db)
+
+    status, out, err = run("--db", db, "search", PAYLOAD)
+    assert status == 0
+    fields = out.rstrip("\n").split("\t")
+    assert fields[0] == "2"
+    assert fields[2] == PAYLOAD
+
+
+def test_payload_in_a_tag_filter_matches_nothing_and_breaks_nothing(run, db):
+    run("--db", db, "add", "https://kept.example", "--tags", "keep")
+
+    status, out, err = run("--db", db, "list", "--tag", PAYLOAD)
+
+    assert (status, out, err) == (0, "", "")
+    assert {"bookmarks", "bookmark_tags"} <= _table_names(db)
+    assert run("--db", db, "list")[1] == "1\thttps://kept.example\t\tkeep\n"
+
+
+def test_payload_exports_as_data(run, db):
+    run("--db", db, "add", "https://a.example", "--title", PAYLOAD)
+
+    status, out, err = run("--db", db, "export", "--format", "csv")
+    assert status == 0
+    assert list(csv.reader(io.StringIO(out)))[1][2] == PAYLOAD
+
+    status, out, err = run("--db", db, "export", "--format", "json")
+    assert status == 0
+    assert json.loads(out)[0]["title"] == PAYLOAD
+    assert {"bookmarks", "bookmark_tags"} <= _table_names(db)
diff --git a/tests/security/test_security_limits.py b/tests/security/test_security_limits.py
new file mode 100644
index 0000000..a9bd0aa
--- /dev/null
+++ b/tests/security/test_security_limits.py
@@ -0,0 +1,106 @@
+"""SR-006: every input has an enforced maximum size, and one character over is refused.
+
+Each case violates exactly one limit, so the test names the control it exercises.
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from bookmarks import cli
+
+URL_PREFIX = "https://a.example/"
+
+
+def _url_of_length(total: int) -> str:
+    return URL_PREFIX + "u" * (total - len(URL_PREFIX))
+
+
+def _tags_string_of_length(total: int) -> str:
+    """A ``--tags`` string of exactly ``total`` characters within every other limit."""
+    count = cli.MAX_TAG_COUNT
+    body = total - (count - 1)  # characters left for the tag text itself
+    base, extra = divmod(body, count)
+    tags = []
+    for index in range(count):
+        length = base + (1 if index < extra else 0)
+        label = f"{index:03d}"
+        tags.append(label + "t" * (length - len(label)))
+    raw = ",".join(tags)
+    assert len(raw) == total
+    assert len(set(tags)) == count
+    assert max(len(tag) for tag in tags) <= cli.MAX_TAG_LENGTH
+    return raw
+
+
+def _tag_list_of_count(count: int) -> str:
+    return ",".join(f"t{index}" for index in range(count))
+
+
+OVER_LIMIT = {
+    "url": ("add", _url_of_length(cli.MAX_URL_LENGTH + 1)),
+    "title": ("add", "https://a.example", "--title", "t" * (cli.MAX_TITLE_LENGTH + 1)),
+    "tag list": (
+        "add", "https://a.example", "--tags", _tags_string_of_length(cli.MAX_TAGS_LENGTH + 1)
+    ),
+    "tag count": (
+        "add", "https://a.example", "--tags", _tag_list_of_count(cli.MAX_TAG_COUNT + 1)
+    ),
+    "tag length": ("add", "https://a.example", "--tags", "t" * (cli.MAX_TAG_LENGTH + 1)),
+    "search text": ("search", "s" * (cli.MAX_SEARCH_LENGTH + 1)),
+}
+
+AT_LIMIT = {
+    "url": ("add", _url_of_length(cli.MAX_URL_LENGTH)),
+    "title": ("add", "https://a.example", "--title", "t" * cli.MAX_TITLE_LENGTH),
+    "tag list": (
+        "add", "https://a.example", "--tags", _tags_string_of_length(cli.MAX_TAGS_LENGTH)
+    ),
+    "tag count": ("add", "https://a.example", "--tags", _tag_list_of_count(cli.MAX_TAG_COUNT)),
+    "tag length": ("add", "https://a.example", "--tags", "t" * cli.MAX_TAG_LENGTH),
+    "search text": ("search", "s" * cli.MAX_SEARCH_LENGTH),
+}
+
+
+def test_the_limits_are_the_specified_numbers():
+    assert cli.MAX_URL_LENGTH == 8192
+    assert cli.MAX_TITLE_LENGTH == 4096
+    assert cli.MAX_TAGS_LENGTH == 4096
+    assert cli.MAX_TAG_COUNT == 64
+    assert cli.MAX_TAG_LENGTH == 128
+    assert cli.MAX_SEARCH_LENGTH == 1024
+
+
+@pytest.mark.parametrize("name", list(OVER_LIMIT))
+def test_one_char_over_each_limit_is_rejected(
+    name, run, db, stored_bookmarks, stored_tag_links
+):
+    status, out, err = run("--db", db, *OVER_LIMIT[name])
+
+    assert status == 2
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert stored_bookmarks(db) == []
+    assert stored_tag_links(db) == []
+    # Refused before the collection was opened, so the file does not even exist.
+    assert not os.path.exists(db)
+
+
+@pytest.mark.parametrize("name", list(AT_LIMIT))
+def test_boundary_exact_values_are_accepted(name, run, db, stored_bookmarks):
+    status, out, err = run("--db", db, *AT_LIMIT[name])
+
+    assert status == 0, err
+    assert err == ""
+    if AT_LIMIT[name][0] == "add":
+        assert len(stored_bookmarks(db)) == 1
+
+
+def test_oversized_url_is_refused_before_the_shape_check(run, db):
+    """Validation order: the size limit decides first, and the collection stays unopened."""
+    status, out, err = run("--db", db, "add", "ftp://" + "x" * cli.MAX_URL_LENGTH)
+
+    assert status == 2
+    assert not os.path.exists(db)
