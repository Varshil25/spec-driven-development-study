--- /dev/null
+++ b/tests/security/test_security_atomicity.py
@@ -0,0 +1,81 @@
+"""SR-009: a rejected or failed command leaves the collection exactly as it was."""
+
+from __future__ import annotations
+
+from bookmarks import storage
+
+
+def test_failed_add_leaves_no_partial_row_or_orphan_tag(
+    run, db, monkeypatch, stored_bookmarks, stored_tag_links
+):
+    # 1. A refusal during validation never reaches the collection at all.
+    status, out, err = run("--db", db, "add", "ftp://example.com", "--tags", "a,b")
+    assert status == 2
+    assert stored_bookmarks(db) == []
+    assert stored_tag_links(db) == []
+
+    # 2. A write that fails part-way through rolls the whole bookmark back: the tag insert
+    #    is pointed at a table that does not exist, so it raises after the bookmark row has
+    #    been inserted inside the same transaction.
+    monkeypatch.setattr(
+        storage,
+        "INSERT_TAG_SQL",
+        "INSERT INTO no_such_table(bookmark_id, tag) VALUES (?, ?)",
+    )
+
+    status, out, err = run("--db", db, "add", "https://a.example", "--tags", "a,b")
+
+    assert status == 1
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert stored_bookmarks(db) == []
+    assert stored_tag_links(db) == []
+
+    monkeypatch.undo()
+
+    # 3. And the collection is still usable afterwards.
+    status, out, err = run("--db", db, "add", "https://a.example", "--tags", "a,b")
+    assert status == 0
+    assert len(stored_bookmarks(db)) == 1
+    assert len(stored_tag_links(db)) == 2
+
+
+def test_failed_add_after_existing_rows_keeps_them(
+    run, db, monkeypatch, stored_bookmarks, stored_tag_links
+):
+    run("--db", db, "add", "https://kept.example", "--title", "kept", "--tags", "keep")
+    before = stored_bookmarks(db)
+    before_tags = stored_tag_links(db)
+
+    monkeypatch.setattr(
+        storage,
+        "INSERT_TAG_SQL",
+        "INSERT INTO no_such_table(bookmark_id, tag) VALUES (?, ?)",
+    )
+
+    assert run("--db", db, "add", "https://b.example", "--tags", "a")[0] == 1
+
+    assert stored_bookmarks(db) == before
+    assert stored_tag_links(db) == before_tags
+
+
+def test_delete_of_a_missing_id_commits_nothing(run, db, stored_bookmarks, stored_tag_links):
+    run("--db", db, "add", "https://a.example", "--tags", "x")
+    before = stored_bookmarks(db)
+    before_tags = stored_tag_links(db)
+
+    status, out, err = run("--db", db, "delete", "999")
+
+    assert status == 3
+    assert stored_bookmarks(db) == before
+    assert stored_tag_links(db) == before_tags
+
+
+def test_tag_associations_never_outlive_their_bookmark(run, db, stored_tag_links):
+    """The declared cascade is live, so no orphan association can survive a removal."""
+    run("--db", db, "add", "https://a.example", "--tags", "x,y")
+    run("--db", db, "add", "https://b.example", "--tags", "y,z")
+
+    assert run("--db", db, "delete", "1")[0] == 0
+
+    assert stored_tag_links(db) == [(2, "y"), (2, "z")]
