+++ b/tests/security/test_security_file_mode.py
@@ -0,0 +1,48 @@
+"""SR-005: the database file is owner-read/write only, set at creation time."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from bookmarks import storage
+
+posix_only = pytest.mark.skipif(
+    os.name != "posix", reason="file mode bits are a POSIX concept (plan.md Target Platform)"
+)
+
+
+@posix_only
+def test_file_mode_is_0600(run, db, tmp_path):
+    status, out, err = run("--db", db, "list")
+
+    assert status == 0
+    path = tmp_path / "bookmarks.db"
+    assert path.exists()
+    assert path.stat().st_mode & 0o777 == 0o600
+
+
+@posix_only
+def test_mode_is_set_at_creation_and_not_rechmodded(tmp_path):
+    path = tmp_path / "fresh.db"
+
+    connection = storage.connect(str(path))
+    try:
+        # Asserted before any schema is written, i.e. at creation time, not afterwards.
+        assert path.stat().st_mode & 0o777 == 0o600
+        storage.init_schema(connection)
+        assert path.stat().st_mode & 0o777 == 0o600
+    finally:
+        connection.close()
+
+
+@posix_only
+def test_existing_file_mode_is_left_untouched(tmp_path):
+    path = tmp_path / "existing.db"
+    path.touch(mode=0o640)
+
+    connection = storage.connect(str(path))
+    connection.close()
+
+    assert path.stat().st_mode & 0o777 == 0o640
