@@ -0,0 +1,72 @@
+"""Rendering of bookmarks: listing lines, CSV rows and a streaming JSON array."""
+
+from __future__ import annotations
+
+import csv
+import json
+from typing import Iterable
+
+from .storage import Bookmark
+
+CSV_HEADER = ("id", "url", "title", "tags")
+
+
+def join_tags(tags: tuple[str, ...]) -> str:
+    """Join tags with commas in ascending code-point order (FR-017, FR-023, FR-024).
+
+    Code-point order rather than locale collation, so uppercase sorts before lowercase:
+    ``{python, Docs}`` renders as ``Docs,python``. An empty tag set renders as ``""``.
+    """
+    return ",".join(sorted(tags))
+
+
+def format_listing_line(bookmark: Bookmark) -> str:
+    """Render one listing line: exactly four tab-separated fields (FR-017).
+
+    The title is reproduced verbatim, tabs and newlines included, and an absent title or tag
+    set is an empty field -- so a bookmark with neither ends the line in two tabs.
+    """
+    return (
+        f"{bookmark.id}\t{bookmark.url}\t{bookmark.title}\t{join_tags(bookmark.tags)}\n"
+    )
+
+
+def write_csv(bookmarks: Iterable[Bookmark], stream) -> None:
+    """Write the header row then one row per bookmark, as each one arrives (FR-023, SR-007).
+
+    Quoting is left entirely to the csv writer, which is what makes a field containing a
+    comma, a double quote or a newline round-trip through any standard parser (FR-025).
+    Fields are deliberately not spreadsheet-hardened -- see plan.md Complexity Tracking.
+    """
+    writer = csv.writer(stream, lineterminator="\n")
+    writer.writerow(CSV_HEADER)
+    for bookmark in bookmarks:
+        writer.writerow(
+            (bookmark.id, bookmark.url, bookmark.title, join_tags(bookmark.tags))
+        )
+
+
+def write_json(bookmarks: Iterable[Bookmark], stream) -> None:
+    """Write one JSON array, encoding each bookmark as it arrives (FR-024, SR-007).
+
+    The array punctuation is emitted directly and each element is encoded on its own, so the
+    whole collection is never held in memory at once. Escaping is left to the JSON encoder
+    (FR-025); non-ASCII text is written literally, which is valid UTF-8 JSON.
+    """
+    stream.write("[")
+    separator = ""
+    for bookmark in bookmarks:
+        stream.write(separator)
+        stream.write(
+            json.dumps(
+                {
+                    "id": bookmark.id,
+                    "url": bookmark.url,
+                    "title": bookmark.title,
+                    "tags": sorted(bookmark.tags),
+                },
+                ensure_ascii=False,
+            )
+        )
+        separator = ","
+    stream.write("]\n")
diff --git a/src/bookmarks/storage.py b/src/bookmarks/storage.py
