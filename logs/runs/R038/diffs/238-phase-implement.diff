index 0000000..bceed0c
--- /dev/null
+++ b/tests/contract/test_exit_statuses.py
@@ -0,0 +1,141 @@
+"""Contract: the exit-status and stream mapping of contracts/cli-contract.md.
+
+Started by User Story 2 with the empty-result rule (FR-018); the full mapping is appended in
+the Polish phase.
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from bookmarks import cli
+
+NO_MATCH_COMMANDS = (
+    ("list",),
+    ("list", "--tag", "absent"),
+    ("search", "zzzznothing"),
+)
+
+
+@pytest.mark.parametrize(
+    "command", NO_MATCH_COMMANDS, ids=[" ".join(c) for c in NO_MATCH_COMMANDS]
+)
+def test_no_match_prints_nothing_and_exits_zero(command, run, db):
+    """US2 AS3 / FR-018: an empty collection, then a populated one that still matches none."""
+    status, out, err = run("--db", db, *command)
+    assert (status, out, err) == (0, "", "")
+
+    run("--db", db, "add", "https://a.example", "--title", "A", "--tags", "x")
+
+    status, out, err = run("--db", db, *command)
+    if command == ("list",):
+        assert (status, err) == (0, "")
+        assert out == "1\thttps://a.example\tA\tx\n"
+    else:
+        assert (status, out, err) == (0, "", "")
+
+
+SUCCESSFUL_COMMANDS = (
+    ("add", "https://new.example", "--title", "T", "--tags", "a,b"),
+    ("list",),
+    ("list", "--tag", "x"),
+    ("search", "a"),
+    ("delete", "1"),
+    ("export", "--format", "csv"),
+    ("export", "--format", "json"),
+)
+
+
+@pytest.mark.parametrize(
+    "command", SUCCESSFUL_COMMANDS, ids=[" ".join(c) for c in SUCCESSFUL_COMMANDS]
+)
+def test_every_successful_command_exits_zero(command, run, db):
+    """FR-004: all five commands return 0 on valid input."""
+    run("--db", db, "add", "https://a.example", "--title", "A", "--tags", "x")
+
+    status, out, err = run("--db", db, *command)
+
+    assert status == 0
+    assert err == ""
+
+
+# (database key, argv after the database option, expected status). The keys are resolved by
+# the `paths` fixture below; "db" is a usable collection holding one bookmark.
+ERROR_CASES = {
+    "unknown command": ("db", ("frobnicate",), 2),
+    "no command": ("db", (), 2),
+    "unknown option": ("db", ("list", "--nope"), 2),
+    "missing argument": ("db", ("add",), 2),
+    "invalid url": ("db", ("add", "ftp://example.com"), 2),
+    "malformed id": ("db", ("delete", "abc"), 2),
+    "zero id": ("db", ("delete", "0"), 2),
+    "missing format": ("db", ("export",), 2),
+    "unsupported format": ("db", ("export", "--format", "xml"), 2),
+    "oversized url": ("db", ("add", "https://a.example/" + "x" * 8192), 2),
+    "oversized title": ("db", ("add", "https://a.example", "--title", "t" * 4097), 2),
+    "oversized search": ("db", ("search", "s" * 1025), 2),
+    "absent id": ("db", ("delete", "999"), 3),
+    "missing parent directory": ("missing_parent", ("list",), 1),
+    "not a database": ("corrupt", ("list",), 1),
+    "database is a directory": ("directory", ("list",), 1),
+}
+
+
+@pytest.fixture
+def paths(tmp_path, run):
+    usable = str(tmp_path / "bookmarks.db")
+    run("--db", usable, "add", "https://a.example", "--title", "A", "--tags", "x")
+
+    corrupt = tmp_path / "corrupt.db"
+    corrupt.write_bytes(b"this file is not a database at all\n" * 32)
+
+    directory = tmp_path / "a-directory"
+    directory.mkdir()
+
+    return {
+        "db": usable,
+        "missing_parent": str(tmp_path / "no-such-directory" / "x.db"),
+        "corrupt": str(corrupt),
+        "directory": str(directory),
+    }
+
+
+@pytest.mark.parametrize("name", list(ERROR_CASES))
+def test_error_status_and_stream_mapping(name, run, paths):
+    """FR-005 / SC-005: the status, the stream and the single-line message of every failure."""
+    key, argv, expected = ERROR_CASES[name]
+
+    status, out, err = run("--db", paths[key], *argv)
+
+    assert status == expected
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert err.endswith("\n")
+
+
+def test_malformed_id_is_two_and_absent_id_is_three(run, db):
+    """The status 2 versus status 3 distinction of the contract."""
+    run("--db", db, "add", "https://a.example")
+
+    assert run("--db", db, "delete", "abc")[0] == 2
+    assert run("--db", db, "delete", "999")[0] == 3
+    assert run("--db", db, "delete", "1")[0] == 0
+
+
+def test_statuses_are_only_zero_one_two_three(run, paths):
+    seen = {run("--db", paths["db"], "list")[0]}
+    for key, argv, _expected in ERROR_CASES.values():
+        seen.add(run("--db", paths[key], *argv)[0])
+
+    assert seen <= {0, 1, 2, 3}
+
+
+def test_main_returns_a_status_and_never_exits(db):
+    """The entry point returns; only __main__ exits (FR-004, research.md R5)."""
+    assert cli.main(["--db", db, "add", "https://a.example"]) == 0
+    assert cli.main(["--db", db, "list"]) == 0
+    assert cli.main(["--db", db, "delete", "999"]) == 3
+    assert cli.main(["--db", db, "add", "ftp://x"]) == 2
+    assert os.path.exists(db)
