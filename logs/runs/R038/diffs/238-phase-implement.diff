+++ b/tests/security/test_security_args.py
@@ -0,0 +1,115 @@
+"""SR-003 / FR-022: every argument is validated before use, and a refusal writes nothing.
+
+The export half of this module is appended by User Story 4.
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+MALFORMED_IDS = (
+    "abc",
+    "1.5",
+    "-1",
+    "0",
+    "",
+    " 1",
+    "+1",
+    "0x1",
+    "1e3",
+    "١٢",  # Arabic-Indic digits: not decimal ASCII
+    "9223372036854775808",  # 2**63, one past the supported range
+    "999999999999999999999999",
+)
+
+MALFORMED_COMMANDS = (
+    ("delete", "abc"),
+    ("delete",),
+    ("frobnicate",),
+    (),
+    ("list", "--nope"),
+    ("add",),
+    ("add", "https://a.example", "--nope", "x"),
+    ("search",),
+    ("list", "--tag"),
+)
+
+
+def _fingerprint(path: str):
+    if not os.path.exists(path):
+        return None
+    info = os.stat(path)
+    return (info.st_size, info.st_mtime_ns)
+
+
+@pytest.mark.parametrize("identifier", MALFORMED_IDS)
+def test_malformed_delete_id_exits_two(identifier, run, db, stored_bookmarks):
+    run("--db", db, "add", "https://a.example", "--title", "A", "--tags", "x")
+    before = _fingerprint(db)
+
+    status, out, err = run("--db", db, "delete", identifier)
+
+    assert status == 2
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert _fingerprint(db) == before
+    assert [row[0] for row in stored_bookmarks(db)] == [1]
+
+
+@pytest.mark.parametrize(
+    "command", MALFORMED_COMMANDS, ids=[" ".join(c) or "(no command)" for c in MALFORMED_COMMANDS]
+)
+def test_every_malformed_argument_exits_two_without_writing(command, run, db):
+    """The refusal happens before the collection is opened, so the file is never created."""
+    status, out, err = run("--db", db, *command)
+
+    assert status == 2
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert not os.path.exists(db)
+
+
+@pytest.mark.parametrize(
+    "command", MALFORMED_COMMANDS, ids=[" ".join(c) or "(no command)" for c in MALFORMED_COMMANDS]
+)
+def test_malformed_argument_leaves_an_existing_file_untouched(command, run, db):
+    run("--db", db, "add", "https://a.example")
+    before = _fingerprint(db)
+
+    status, out, err = run("--db", db, *command)
+
+    assert status == 2
+    assert _fingerprint(db) == before
+
+
+BAD_FORMATS = ("xml", "CSV", "JSON", "", "csv,json", "Csv", "yaml")
+
+
+@pytest.mark.parametrize("value", BAD_FORMATS, ids=[value or "(empty)" for value in BAD_FORMATS])
+def test_export_format_required_and_restricted(value, run, db):
+    """FR-026 / SR-003: --format is required and accepts only csv or json."""
+    status, out, err = run("--db", db, "export", "--format", value)
+
+    assert status == 2
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert not os.path.exists(db)
+
+
+def test_export_without_format_exits_two(run, db):
+    status, out, err = run("--db", db, "export")
+
+    assert status == 2
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert not os.path.exists(db)
+
+
+def test_db_option_must_precede_the_command(run, db):
+    status, out, err = run("add", "https://a.example", "--db", db)
+
+    assert status == 2
+    assert out == ""
+    assert not os.path.exists(db)
