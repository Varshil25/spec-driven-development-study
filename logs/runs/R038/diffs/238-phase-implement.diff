+"""SR-002: URL acceptance is allow-list based; every other shape is refused.
+
+Negative cases are the exact list the specification names, plus the mixed-case prefixes.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+ATTACK_URLS = (
+    "javascript:alert(1)",
+    "file:///etc/passwd",
+    "data:text/html,x",
+    "ftp://host/",
+    "HTTPS://host/",
+    "example.com",
+    "//example.com",
+    "http:/example.com",
+    "",
+    "   ",
+)
+
+
+@pytest.mark.parametrize("url", ATTACK_URLS)
+def test_url_allowlist_rejects(url, run, db, stored_bookmarks, stored_tag_links):
+    # A collection that already holds one bookmark, so "unchanged" is a real assertion.
+    run("--db", db, "add", "https://kept.example", "--title", "kept", "--tags", "keep")
+    before = stored_bookmarks(db)
+    before_tags = stored_tag_links(db)
+
+    status, out, err = run("--db", db, "add", url, "--tags", "attack")
+
+    assert status == 2
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert stored_bookmarks(db) == before
+    assert stored_tag_links(db) == before_tags
+
+
+@pytest.mark.parametrize("url", ATTACK_URLS)
+def test_rejection_consumes_no_identifier(url, run, db):
+    status, out, err = run("--db", db, "add", url)
+    assert status == 2
+
+    status, out, err = run("--db", db, "add", "https://a.example")
+    assert (status, out) == (0, "1\n")
+
+
+def test_no_reachability_check_is_performed(run, db):
+    """FR-011: a syntactically acceptable but unresolvable host is still stored."""
+    status, out, err = run("--db", db, "add", "https://this-host-does-not-exist.invalid/x")
+
+    assert (status, out, err) == (0, "1\n", "")
