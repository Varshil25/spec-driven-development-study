+"""Argument parsing, input validation and the five commands.
+
+Validation order is fixed: argparse-level parsing, then the size limits below (SR-006), then
+the URL shape (FR-008), and only then is the database touched. Every status-2 case is
+therefore decided before the collection is opened, so a rejected command performs no read and
+no write (SR-009).
+"""
+
+from __future__ import annotations
+
+import argparse
+import contextlib
+import sys
+
+from . import output, storage
+from .storage import BookmarksError
+
+# --- limits (SR-006) ---------------------------------------------------------------------
+
+MAX_URL_LENGTH = 8192
+MAX_TITLE_LENGTH = 4096
+MAX_TAGS_LENGTH = 4096
+MAX_TAG_COUNT = 64
+MAX_TAG_LENGTH = 128
+MAX_SEARCH_LENGTH = 1024
+
+# Supported identifier range: a decimal positive integer up to SQLite's maximum (SR-003).
+MIN_ID = 1
+MAX_ID = 2**63 - 1
+
+DEFAULT_DB = "bookmarks.db"
+URL_PREFIXES = ("http://", "https://")
+
+
+# --- argparse-level validators -----------------------------------------------------------
+
+
+def positive_id(value: str) -> int:
+    """Accept only a decimal positive integer in 1 ... 2^63-1 (FR-022, SR-003)."""
+    if not (value.isascii() and value.isdigit()):
+        raise argparse.ArgumentTypeError(
+            "identifier must be a positive whole number written in decimal digits"
+        )
+    number = int(value)
+    if not MIN_ID <= number <= MAX_ID:
+        raise argparse.ArgumentTypeError(
+            f"identifier must be between {MIN_ID} and {MAX_ID}"
+        )
+    return number
+
+
+class _Parser(argparse.ArgumentParser):
+    """An argparse parser whose errors are a single line on standard error.
+
+    argparse's status 2 and its stderr destination are kept exactly; only the multi-line
+    usage block is dropped, because SR-008 requires every expected failure to be one line.
+    """
+
+    def error(self, message: str) -> None:
+        self.exit(2, f"{self.prog}: error: {message}\n")
+
+
+def build_parser() -> _Parser:
+    """Build the command surface described in contracts/cli-contract.md (FR-001)."""
+    parser = _Parser(
+        prog="bookmarks",
+        description="Save, find, remove and export bookmarks.",
+    )
+    parser.add_argument(
+        "--db",
+        metavar="PATH",
+        default=DEFAULT_DB,
+        help=f"database file to use (default: {DEFAULT_DB} in the current directory)",
+    )
+    commands = parser.add_subparsers(dest="command", metavar="COMMAND", required=True)
+
+    add = commands.add_parser("add", help="store a bookmark and print its identifier")
+    add.add_argument("url", metavar="URL")
+    add.add_argument("--title", default="", metavar="TITLE")
+    add.add_argument("--tags", default=None, metavar="TAGS")
+
+    listing = commands.add_parser("list", help="print stored bookmarks")
+    listing.add_argument("--tag", default=None, metavar="TAG")
+
+    search = commands.add_parser("search", help="print bookmarks matching a substring")
+    search.add_argument("text", metavar="TEXT")
+
+    remove = commands.add_parser("delete", help="remove a bookmark by identifier")
+    remove.add_argument("id", metavar="ID", type=positive_id)
+
+    export = commands.add_parser("export", help="print the whole collection")
+    export.add_argument("--format", required=True, choices=("csv", "json"), dest="fmt")
+
+    return parser
+
+
+# --- input validation (SR-006) -----------------------------------------------------------
+
+
+def _check_length(value: str, limit: int, what: str) -> None:
+    if len(value) > limit:
+        raise BookmarksError(
+            f"{what} is too long: {len(value)} characters, at most {limit} allowed", 2
+        )
+
+
+def validate_url(value: str) -> str:
+    """Accept a URL only on an exact lowercase ``http://``/``https://`` prefix.
+
+    Allow-list only: no reachability check, no name lookup, no network access of any kind
+    (FR-008, FR-011, SR-002). The size limit is checked first (SR-006), and the whole check
+    happens before the collection is opened, so a refusal stores nothing.
+    """
+    _check_length(value, MAX_URL_LENGTH, "URL")
+    if not value.startswith(URL_PREFIXES):
+        raise BookmarksError(
+            "invalid URL: it must begin with the lowercase prefix 'http://' or 'https://'", 2
+        )
+    return value
+
+
+def parse_tags(raw: str | None) -> tuple[str, ...]:
+    """Parse ``--tags`` into the bookmark's set of distinct tags (FR-010, FR-012).
+
+    Split on commas, trim each entry, drop entries that are then empty, keep each distinct
+    entry once. The size limits of SR-006 are enforced here, before anything is stored.
+    """
+    if raw is None:
+        return ()
+    _check_length(raw, MAX_TAGS_LENGTH, "tag list")
+
+    tags: list[str] = []
+    for entry in raw.split(","):
+        tag = entry.strip()
+        if tag and tag not in tags:
+            tags.append(tag)
+
+    if len(tags) > MAX_TAG_COUNT:
+        raise BookmarksError(
+            f"too many tags: {len(tags)}, at most {MAX_TAG_COUNT} allowed", 2
+        )
+    for tag in tags:
+        _check_length(tag, MAX_TAG_LENGTH, "tag")
+    return tuple(tags)
+
+
+# --- commands ----------------------------------------------------------------------------
+
+
+def _open_collection(path: str):
+    connection = storage.connect(path)
+    storage.init_schema(connection)
+    return contextlib.closing(connection)
+
+
+def _write_listing(cursor) -> None:
+    for bookmark in storage.iter_bookmarks(cursor):
+        sys.stdout.write(output.format_listing_line(bookmark))
+
+
+def cmd_add(args: argparse.Namespace) -> int:
+    """Store one bookmark and print its identifier, and nothing else (FR-006).
+
+    Validation runs in the fixed order -- size limits, then URL shape -- and completes before
+    the collection is opened.
+    """
+    _check_length(args.title, MAX_TITLE_LENGTH, "title")
+    tags = parse_tags(args.tags)
+    url = validate_url(args.url)
+
+    with _open_collection(args.db) as connection:
+        bookmark_id = storage.add_bookmark(connection, url, args.title, tags)
+    sys.stdout.write(f"{bookmark_id}\n")
+    return 0
+
+
+def cmd_list(args: argparse.Namespace) -> int:
+    """Print stored bookmarks, filtered by ``--tag`` if given (FR-013, FR-014, FR-018)."""
+    with _open_collection(args.db) as connection:
+        if args.tag is None:
+            cursor = storage.list_bookmarks(connection)
+        else:
+            cursor = storage.list_bookmarks_with_tag(connection, args.tag)
+        _write_listing(cursor)
+    return 0
+
+
+def cmd_search(args: argparse.Namespace) -> int:
+    """Print bookmarks whose title or URL contains TEXT, case-insensitively (FR-015)."""
+    _check_length(args.text, MAX_SEARCH_LENGTH, "search text")
+
+    with _open_collection(args.db) as connection:
+        _write_listing(storage.search_bookmarks(connection, args.text))
+    return 0
+
+
+def cmd_delete(args: argparse.Namespace) -> int:
+    """Remove one bookmark; the identifier was validated by argparse (FR-019, FR-022)."""
+    with _open_collection(args.db) as connection:
+        storage.delete_bookmark(connection, args.id)
+    return 0
+
+
+def cmd_export(args: argparse.Namespace) -> int:
+    """Print the whole collection in the chosen format (FR-023, FR-024, FR-027).
+
+    The format was already restricted to ``csv``/``json`` by argparse.
+    """
+    write = output.write_csv if args.fmt == "csv" else output.write_json
+    with _open_collection(args.db) as connection:
+        write(storage.iter_bookmarks(storage.list_bookmarks(connection)), sys.stdout)
+    return 0
+
+
+COMMANDS = {
+    "add": cmd_add,
+    "list": cmd_list,
+    "search": cmd_search,
+    "delete": cmd_delete,
+    "export": cmd_export,
+}
+
+
+# --- entry point -------------------------------------------------------------------------
+
+
+def _configure_stdout() -> None:
+    """Write UTF-8 with ``\\n`` line endings, whatever the platform default is."""
+    reconfigure = getattr(sys.stdout, "reconfigure", None)
+    if reconfigure is not None:
+        reconfigure(encoding="utf-8", newline="\n")
+
+
+def main(argv: list[str]) -> int:
+    """Run one command and return its exit status; never calls ``sys.exit`` (FR-004, FR-005)."""
+    _configure_stdout()
+    parser = build_parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return exc.code if isinstance(exc.code, int) else 2
+
+    try:
+        return COMMANDS[args.command](args)
+    except BookmarksError as exc:
+        sys.stderr.write(f"{exc.message}\n")
+        return exc.status
