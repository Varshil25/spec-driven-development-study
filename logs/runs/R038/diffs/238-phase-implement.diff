+"""User Story 4 (P4) acceptance scenarios AS1-AS4: hand the collection to another tool."""
+
+from __future__ import annotations
+
+import csv
+import io
+import json
+
+import pytest
+
+AWKWARD_TITLE = 'Comma, "quote" and\nnewline -- ünïcödé ✓'
+
+
+@pytest.fixture
+def seeded(run, db):
+    run("--db", db, "add", "https://docs.python.org", "--title", "Python docs",
+        "--tags", "python,docs")
+    run("--db", db, "add", "https://example.com")
+    run("--db", db, "add", "https://b.example", "--title", "B only tags",
+        "--tags", "zebra,Apple")
+    return db
+
+
+def test_csv_header_and_rows(seeded, run):
+    """US4 AS1 / FR-023."""
+    status, out, err = run("--db", seeded, "export", "--format", "csv")
+
+    assert status == 0
+    assert err == ""
+    assert out.splitlines()[0] == "id,url,title,tags"
+
+    rows = list(csv.reader(io.StringIO(out)))
+    assert rows[0] == ["id", "url", "title", "tags"]
+    assert rows[1] == ["1", "https://docs.python.org", "Python docs", "docs,python"]
+    assert rows[2] == ["2", "https://example.com", "", ""]
+    assert rows[3] == ["3", "https://b.example", "B only tags", "Apple,zebra"]
+    assert [row[0] for row in rows[1:]] == ["1", "2", "3"]
+
+
+def test_csv_tags_are_one_quoted_field(seeded, run):
+    status, out, err = run("--db", seeded, "export", "--format", "csv")
+
+    assert '"docs,python"' in out
+    assert len(list(csv.reader(io.StringIO(out)))[1]) == 4
+
+
+def test_json_array_shape(seeded, run):
+    """US4 AS2 / FR-024."""
+    status, out, err = run("--db", seeded, "export", "--format", "json")
+
+    assert status == 0
+    assert err == ""
+    parsed = json.loads(out)
+    assert isinstance(parsed, list)
+    assert [type(item) for item in parsed] == [dict, dict, dict]
+    assert [item["id"] for item in parsed] == [1, 2, 3]
+    for item in parsed:
+        assert set(item) == {"id", "url", "title", "tags"}
+        assert isinstance(item["id"], int) and not isinstance(item["id"], bool)
+        assert isinstance(item["url"], str)
+        assert isinstance(item["title"], str)
+        assert isinstance(item["tags"], list)
+        assert all(isinstance(tag, str) for tag in item["tags"])
+        assert item["tags"] == sorted(item["tags"])
+    assert parsed[0]["tags"] == ["docs", "python"]
+    assert parsed[1] == {"id": 2, "url": "https://example.com", "title": "", "tags": []}
+    assert parsed[2]["tags"] == ["Apple", "zebra"]
+
+
+def test_special_characters_round_trip(run, db):
+    """US4 AS3 / FR-025: a comma, a double quote, a newline and non-ASCII all survive."""
+    run("--db", db, "add", "https://x.example/a,b", "--title", AWKWARD_TITLE, "--tags", "b,a")
+
+    status, out, err = run("--db", db, "export", "--format", "csv")
+    assert status == 0
+    row = list(csv.reader(io.StringIO(out)))[1]
+    assert row == ["1", "https://x.example/a,b", AWKWARD_TITLE, "a,b"]
+
+    status, out, err = run("--db", db, "export", "--format", "json")
+    assert status == 0
+    item = json.loads(out)[0]
+    assert item["title"] == AWKWARD_TITLE
+    assert item["url"] == "https://x.example/a,b"
+    assert item["tags"] == ["a", "b"]
+
+
+def test_non_ascii_is_emitted_literally_in_json(run, db):
+    run("--db", db, "add", "https://x.example", "--title", "ünïcödé")
+
+    status, out, err = run("--db", db, "export", "--format", "json")
+
+    assert "ünïcödé" in out
+    assert "\\u00fc" not in out
+
+
+def test_empty_collection_exports(run, db):
+    """US4 AS4 / FR-027."""
+    status, out, err = run("--db", db, "export", "--format", "csv")
+    assert (status, err) == (0, "")
+    assert out == "id,url,title,tags\n"
+
+    status, out, err = run("--db", db, "export", "--format", "json")
+    assert (status, err) == (0, "")
+    assert out.strip() == "[]"
+    assert json.loads(out) == []
diff --git a/tests/security/test_security_args.py b/tests/security/test_security_args.py
