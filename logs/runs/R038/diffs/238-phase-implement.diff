@@ -0,0 +1,56 @@
+"""FR-008: a URL is accepted only on an exact lowercase http:// or https:// prefix."""
+
+from __future__ import annotations
+
+import pytest
+
+ACCEPTED = (
+    "http://example.com",
+    "https://example.com",
+    "https://example.com/path?query=1&x=2#fragment",
+    "http://localhost:8000/",
+    "https://xn--bcher-kva.example/",
+    "http://user:pass@example.com/",
+    "https://example.com/a,b;c'd\"e",
+)
+
+REJECTED = (
+    "ftp://example.com",
+    "HTTP://example.com",
+    "HTTPS://example.com",
+    "Http://example.com",
+    "hTTps://example.com",
+    "javascript:alert(1)",
+    "file:///etc/passwd",
+    "data:text/html,x",
+    "example.com",
+    "//example.com",
+    "http:/example.com",
+    "https:/example.com",
+    "http//example.com",
+    " http://example.com",
+    "",
+    "   ",
+)
+
+
+@pytest.mark.parametrize("url", ACCEPTED)
+def test_only_lowercase_http_https_prefix_accepted(url, run, db, stored_bookmarks):
+    status, out, err = run("--db", db, "add", url)
+
+    assert status == 0
+    assert err == ""
+    assert [row[1] for row in stored_bookmarks(db)] == [url]
+
+
+@pytest.mark.parametrize("url", REJECTED)
+def test_rejected_url_exits_two_and_stores_nothing(
+    url, run, db, stored_bookmarks, stored_tag_links
+):
+    status, out, err = run("--db", db, "add", url, "--title", "t", "--tags", "a,b")
+
+    assert status == 2
+    assert out == ""
+    assert err.strip() != ""
+    assert stored_bookmarks(db) == []
+    assert stored_tag_links(db) == []