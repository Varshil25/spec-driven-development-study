index 0000000..c925a79
--- /dev/null
+++ b/src/bookmarks/storage.py
@@ -0,0 +1,242 @@
+"""SQLite storage for one bookmark collection.
+
+Every statement in this module is a fixed string with ``?``/``:name`` placeholders; no SQL is
+ever assembled from user-supplied text (SR-001). Reads return a cursor that is iterated
+lazily, so memory does not grow with the collection (SR-007).
+"""
+
+from __future__ import annotations
+
+import os
+import sqlite3
+from dataclasses import dataclass
+from typing import Iterator
+
+# --- error carrier -----------------------------------------------------------------------
+
+
+class BookmarksError(Exception):
+    """A failure that maps to one of the specified exit statuses.
+
+    ``status`` is 1 for an unusable database or other failure, 2 for invalid input and 3 for
+    a removal naming an identifier that does not exist (FR-005).
+    """
+
+    def __init__(self, message: str, status: int = 1) -> None:
+        super().__init__(message)
+        self.message = message
+        self.status = status
+
+
+# --- entity ------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Bookmark:
+    """One stored bookmark with its tag set already in display order."""
+
+    id: int
+    url: str
+    title: str
+    tags: tuple[str, ...]
+
+
+# --- schema ------------------------------------------------------------------------------
+
+SCHEMA_STATEMENTS: tuple[str, ...] = (
+    """
+    CREATE TABLE IF NOT EXISTS bookmarks (
+        id    INTEGER PRIMARY KEY AUTOINCREMENT,
+        url   TEXT NOT NULL,
+        title TEXT NOT NULL DEFAULT ''
+    )
+    """,
+    """
+    CREATE TABLE IF NOT EXISTS bookmark_tags (
+        bookmark_id INTEGER NOT NULL REFERENCES bookmarks(id) ON DELETE CASCADE,
+        tag         TEXT NOT NULL,
+        PRIMARY KEY (bookmark_id, tag)
+    ) WITHOUT ROWID
+    """,
+    "CREATE INDEX IF NOT EXISTS idx_bookmark_tags_tag ON bookmark_tags(tag)",
+)
+
+UNUSABLE_DATABASE = "cannot use the database file"
+
+
+def connect(path: str) -> sqlite3.Connection:
+    """Open (creating if absent) the collection at ``path``.
+
+    A file that does not exist yet is created with owner-only permissions *before* SQLite
+    first opens it, so the mode is set at creation time rather than by a later change
+    (SR-005). An existing file's mode is left untouched. Any path that cannot be used is an
+    error with status 1 -- never a silent fallback to the default path and never an empty
+    collection (FR-002, FR-003).
+    """
+    if not os.path.exists(path):
+        try:
+            handle = os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
+        except FileExistsError:
+            pass  # appeared between the check and the create; its mode is left untouched
+        except (FileNotFoundError, NotADirectoryError) as exc:
+            raise BookmarksError(
+                f"cannot create the database file {path!r}: its directory does not exist",
+                1,
+            ) from exc
+        except IsADirectoryError as exc:
+            raise BookmarksError(
+                f"cannot use the database file {path!r}: it is a directory", 1
+            ) from exc
+        except PermissionError as exc:
+            raise BookmarksError(
+                f"cannot create the database file {path!r}: permission denied", 1
+            ) from exc
+        except OSError as exc:
+            raise BookmarksError(f"cannot create the database file {path!r}", 1) from exc
+        else:
+            os.close(handle)
+
+    try:
+        connection = sqlite3.connect(path)
+        # Forces the file header to be read, so a file that is not a database (or a path
+        # that cannot be opened at all) fails here rather than mid-command.
+        connection.execute("SELECT count(*) FROM sqlite_master").fetchone()
+    except sqlite3.Error as exc:
+        raise BookmarksError(f"{UNUSABLE_DATABASE} {path!r}", 1) from exc
+    return connection
+
+
+def init_schema(connection: sqlite3.Connection) -> None:
+    """Enable foreign keys on this connection and apply the schema if it is absent."""
+    try:
+        connection.execute("PRAGMA foreign_keys = ON")
+        with connection:
+            for statement in SCHEMA_STATEMENTS:
+                connection.execute(statement)
+    except sqlite3.Error as exc:
+        raise BookmarksError(UNUSABLE_DATABASE, 1) from exc
+
+
+# --- statements --------------------------------------------------------------------------
+
+INSERT_BOOKMARK_SQL = "INSERT INTO bookmarks(url, title) VALUES (?, ?)"
+INSERT_TAG_SQL = "INSERT INTO bookmark_tags(bookmark_id, tag) VALUES (?, ?)"
+REMOVE_BOOKMARK_SQL = "DELETE FROM bookmarks WHERE id = ?"
+
+_READ_SELECT = (
+    "SELECT b.id, b.url, b.title, t.tag "
+    "FROM bookmarks b LEFT JOIN bookmark_tags t ON t.bookmark_id = b.id"
+)
+_READ_ORDER = " ORDER BY b.id, t.tag"
+
+LIST_SQL = _READ_SELECT + _READ_ORDER
+
+# The subquery selects which bookmarks match; the LEFT JOIN still returns every tag of each
+# matched bookmark, which is what FR-014 and FR-017 together require.
+LIST_BY_TAG_SQL = (
+    _READ_SELECT
+    + " WHERE b.id IN (SELECT bookmark_id FROM bookmark_tags WHERE tag = ?)"
+    + _READ_ORDER
+)
+
+# instr() has no pattern language, so '%' and '_' in the needle are literal by construction
+# (FR-016, SR-004); lower() on both sides gives the case-insensitive match of FR-015.
+SEARCH_SQL = (
+    _READ_SELECT
+    + " WHERE instr(lower(b.title), lower(:text)) > 0"
+    + " OR instr(lower(b.url), lower(:text)) > 0"
+    + _READ_ORDER
+)
+
+
+# --- writes ------------------------------------------------------------------------------
+
+
+def add_bookmark(
+    connection: sqlite3.Connection, url: str, title: str, tags: tuple[str, ...]
+) -> int:
+    """Store one bookmark and its tags in a single transaction, returning its identifier.
+
+    The bookmark row and every tag association commit together or not at all (SR-009). The
+    identifier comes from the engine's own monotonic sequence, so it is never reused after a
+    removal (FR-007).
+    """
+    try:
+        with connection:
+            cursor = connection.execute(INSERT_BOOKMARK_SQL, (url, title))
+            bookmark_id = cursor.lastrowid
+            for tag in tags:
+                connection.execute(INSERT_TAG_SQL, (bookmark_id, tag))
+    except sqlite3.Error as exc:
+        raise BookmarksError("could not store the bookmark; nothing was changed", 1) from exc
+    return int(bookmark_id)
+
+
+def delete_bookmark(connection: sqlite3.Connection, bookmark_id: int) -> None:
+    """Remove one bookmark and, by the declared cascade, its tag associations.
+
+    The affected-row count is read inside the transaction, so an identifier that no bookmark
+    holds raises before anything commits (FR-019, FR-021, SR-009).
+    """
+    try:
+        with connection:
+            cursor = connection.execute(REMOVE_BOOKMARK_SQL, (bookmark_id,))
+            if cursor.rowcount == 0:
+                raise BookmarksError(f"no bookmark has identifier {bookmark_id}", 3)
+    except BookmarksError:
+        raise
+    except sqlite3.Error as exc:
+        raise BookmarksError("could not change the collection; nothing was changed", 1) from exc
+
+
+# --- reads -------------------------------------------------------------------------------
+
+
+def list_bookmarks(connection: sqlite3.Connection) -> sqlite3.Cursor:
+    """Return a cursor over every bookmark's rows, ordered by identifier then tag."""
+    return _read(connection, LIST_SQL, ())
+
+
+def list_bookmarks_with_tag(connection: sqlite3.Connection, tag: str) -> sqlite3.Cursor:
+    """Return a cursor over the bookmarks carrying ``tag`` exactly (FR-014)."""
+    return _read(connection, LIST_BY_TAG_SQL, (tag,))
+
+
+def search_bookmarks(connection: sqlite3.Connection, text: str) -> sqlite3.Cursor:
+    """Return a cursor over the bookmarks whose title or URL contains ``text`` (FR-015)."""
+    return _read(connection, SEARCH_SQL, {"text": text})
+
+
+def _read(connection: sqlite3.Connection, statement: str, parameters) -> sqlite3.Cursor:
+    try:
+        return connection.execute(statement, parameters)
+    except sqlite3.Error as exc:
+        raise BookmarksError(UNUSABLE_DATABASE, 1) from exc
+
+
+# --- row streaming -----------------------------------------------------------------------
+
+
+def iter_bookmarks(cursor: sqlite3.Cursor) -> Iterator[Bookmark]:
+    """Group adjacent ``(id, url, title, tag)`` rows into bookmarks, lazily.
+
+    The engine supplies the rows ordered by ``(id, tag)``, so a bookmark is complete as soon
+    as the identifier changes and at most one bookmark's tags are held in memory (SR-007). A
+    bookmark with no tags arrives as one row whose ``tag`` is NULL and yields an empty tag
+    set, which renders as an empty fourth field (FR-017).
+    """
+    current_id: int | None = None
+    url = ""
+    title = ""
+    tags: list[str] = []
+
+    for row_id, row_url, row_title, tag in cursor:
+        if row_id != current_id:
+            if current_id is not None:
+                yield Bookmark(current_id, url, title, tuple(tags))
+            current_id, url, title, tags = row_id, row_url, row_title, []
+        if tag is not None:
+            tags.append(tag)
+
+    if current_id is not None:
+        yield Bookmark(current_id, url, title, tuple(tags))
