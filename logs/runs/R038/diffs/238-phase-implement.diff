+++ b/tests/conftest.py
@@ -0,0 +1,98 @@
+"""Shared fixtures: the in-process command runner and a temporary database path.
+
+Commands are invoked by calling ``bookmarks.cli.main(argv)`` directly, which returns an exit
+status instead of exiting, so a whole scenario costs microseconds. No test in this suite runs
+another process (research.md R10).
+"""
+
+from __future__ import annotations
+
+import os
+import sqlite3
+
+import pytest
+
+from bookmarks import cli, storage
+
+
+@pytest.fixture
+def run(capsys):
+    """Return ``run(*argv) -> (status, stdout, stderr)``."""
+
+    def _run(*argv: str) -> tuple[int, str, str]:
+        status = cli.main(list(argv))
+        captured = capsys.readouterr()
+        return status, captured.out, captured.err
+
+    return _run
+
+
+@pytest.fixture
+def db(tmp_path) -> str:
+    """A database path inside a fresh temporary directory; the file is not created yet."""
+    return str(tmp_path / "bookmarks.db")
+
+
+@pytest.fixture
+def bulk_seed():
+    """Return ``bulk_seed(path, count, tags_per=2)`` for the scale cases.
+
+    Seeding goes straight to SQL because the scale tests measure the read path, not the
+    cost of ``count`` separate invocations.
+    """
+
+    def _seed(path: str, count: int, tags_per: int = 2) -> None:
+        connection = storage.connect(path)
+        storage.init_schema(connection)
+        try:
+            with connection:
+                connection.executemany(
+                    storage.INSERT_BOOKMARK_SQL,
+                    ((f"https://example.com/{n}", f"Title {n}") for n in range(count)),
+                )
+                connection.executemany(
+                    storage.INSERT_TAG_SQL,
+                    (
+                        (bookmark_id, f"tag{index}")
+                        for bookmark_id in range(1, count + 1)
+                        for index in range(tags_per)
+                    ),
+                )
+        finally:
+            connection.close()
+
+    return _seed
+
+
+def _query(path: str, statement: str) -> list[tuple]:
+    if not os.path.exists(path):
+        return []
+    connection = sqlite3.connect(path)
+    try:
+        return connection.execute(statement).fetchall()
+    except sqlite3.DatabaseError:  # not a readable collection at all
+        return []
+    finally:
+        connection.close()
+
+
+@pytest.fixture
+def stored_bookmarks():
+    """Return ``stored_bookmarks(path) -> [(id, url, title), ...]`` read straight from SQL."""
+
+    def _stored(path: str) -> list[tuple]:
+        return _query(path, "SELECT id, url, title FROM bookmarks ORDER BY id")
+
+    return _stored
+
+
+@pytest.fixture
+def stored_tag_links():
+    """Return ``stored_tag_links(path) -> [(bookmark_id, tag), ...]`` read straight from SQL."""
+
+    def _stored(path: str) -> list[tuple]:
+        return _query(
+            path, "SELECT bookmark_id, tag FROM bookmark_tags ORDER BY bookmark_id, tag"
+        )
+
+    return _stored
