@@ -0,0 +1,63 @@
+"""SR-011: the database file is the only persistent state any command leaves behind."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+COMMANDS = (
+    ("add", "https://new.example", "--title", "T", "--tags", "a,b"),
+    ("list",),
+    ("list", "--tag", "x"),
+    ("search", "a"),
+    ("delete", "1"),
+    ("export", "--format", "csv"),
+    ("export", "--format", "json"),
+)
+
+FAILING_COMMANDS = (
+    ("add", "ftp://example.com"),
+    ("delete", "999"),
+    ("delete", "abc"),
+    ("export", "--format", "xml"),
+)
+
+
+@pytest.mark.parametrize("command", COMMANDS, ids=[" ".join(c) for c in COMMANDS])
+def test_no_temp_or_journal_files_remain(command, run, tmp_path):
+    db = str(tmp_path / "bookmarks.db")
+    run("--db", db, "add", "https://a.example", "--title", "A", "--tags", "x")
+
+    status, out, err = run("--db", db, *command)
+
+    assert status == 0
+    assert sorted(os.listdir(tmp_path)) == ["bookmarks.db"]
+
+
+@pytest.mark.parametrize("command", FAILING_COMMANDS, ids=[" ".join(c) for c in FAILING_COMMANDS])
+def test_a_failing_command_leaves_no_residue_either(command, run, tmp_path):
+    db = str(tmp_path / "bookmarks.db")
+    run("--db", db, "add", "https://a.example", "--title", "A", "--tags", "x")
+
+    status, out, err = run("--db", db, *command)
+
+    assert status != 0
+    assert sorted(os.listdir(tmp_path)) == ["bookmarks.db"]
+
+
+def test_journal_mode_is_not_wal(run, tmp_path):
+    """WAL would leave -wal and -shm files beside the collection (research.md R2)."""
+    import sqlite3
+
+    db = str(tmp_path / "bookmarks.db")
+    run("--db", db, "add", "https://a.example")
+
+    connection = sqlite3.connect(db)
+    try:
+        mode = connection.execute("PRAGMA journal_mode").fetchone()[0]
+    finally:
+        connection.close()
+
+    assert mode == "delete"
+    assert sorted(os.listdir(tmp_path)) == ["bookmarks.db"]
diff --git a/tests/security/test_security_no_traceback.py b/tests/security/test_security_no_traceback.py
new file mode 100644
index 0000000..7dc15a7
--- /dev/null
+++ b/tests/security/test_security_no_traceback.py
@@ -0,0 +1,68 @@
+"""SR-008: an expected failure is one informative line and discloses nothing internal."""
+
+from __future__ import annotations
+
+import pytest
+
+# Internal detail that must never reach the user. The SQL keywords are matched as written in
+# the source (upper case) so that the subcommand named "delete" appearing in an argparse
+# choice list is not mistaken for SQL text.
+SQL_TEXT = ("SELECT", "INSERT", "DELETE", "UPDATE", "PRAGMA", "FROM bookmarks", "VALUES (")
+INTERNALS = ("traceback", "sqlite", 'file "', "line ", ".py")
+
+
+@pytest.fixture
+def paths(tmp_path, run):
+    usable = str(tmp_path / "bookmarks.db")
+    run("--db", usable, "add", "https://a.example", "--title", "A")
+
+    corrupt = tmp_path / "corrupt.db"
+    corrupt.write_bytes(b"not a database\n" * 64)
+
+    return {
+        "db": usable,
+        "corrupt": str(corrupt),
+        "missing_parent": str(tmp_path / "no-such-directory" / "x.db"),
+    }
+
+
+FAILURE_PATHS = {
+    "invalid url": ("db", ("add", "ftp://example.com")),
+    "missing identifier": ("db", ("delete", "999")),
+    "bad argument": ("db", ("delete", "abc")),
+    "unknown command": ("db", ("frobnicate",)),
+    "unusable database": ("corrupt", ("list",)),
+    "missing parent directory": ("missing_parent", ("list",)),
+    "oversized input": ("db", ("search", "s" * 2000)),
+    "unsupported format": ("db", ("export", "--format", "xml")),
+}
+
+
+@pytest.mark.parametrize("name", list(FAILURE_PATHS))
+def test_expected_failures_are_single_line_and_disclose_nothing(name, run, paths):
+    key, argv = FAILURE_PATHS[name]
+
+    status, out, err = run("--db", paths[key], *argv)
+
+    assert status != 0
+    assert out == ""
+    assert len(err.splitlines()) == 1, err
+    assert err.endswith("\n")
+    assert err.strip() != ""
+
+    for keyword in SQL_TEXT:
+        assert keyword not in err, f"{name} message contains SQL text {keyword!r}: {err!r}"
+
+    lowered = err.lower()
+    for internal in INTERNALS:
+        assert internal not in lowered, f"{name} message discloses {internal!r}: {err!r}"
+
+
+@pytest.mark.parametrize("name", list(FAILURE_PATHS))
+def test_failure_messages_say_what_was_wrong(name, run, paths):
+    """Principle II: the one line has to be actionable, not just short."""
+    key, argv = FAILURE_PATHS[name]
+
+    status, out, err = run("--db", paths[key], *argv)
+
+    assert len(err.split()) >= 3, err
