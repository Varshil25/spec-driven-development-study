@@ -0,0 +1,48 @@
+"""SC-004: every command on a 10,000-bookmark collection completes in under one second."""
+
+from __future__ import annotations
+
+import sys
+from time import perf_counter
+
+import pytest
+
+from bookmarks import cli
+
+COUNT = 10_000
+LIMIT_SECONDS = 1.0
+
+COMMANDS = (
+    ("add", "https://new.example", "--title", "T", "--tags", "a,b"),
+    ("list",),
+    ("list", "--tag", "tag0"),
+    ("search", "Title 9999"),
+    ("delete", "5000"),
+    ("export", "--format", "csv"),
+    ("export", "--format", "json"),
+)
+
+
+class _DiscardingStream:
+    """Output is discarded so the measurement is the command, not the capture buffer."""
+
+    def write(self, text: str) -> int:
+        return len(text)
+
+    def flush(self) -> None:
+        pass
+
+
+@pytest.mark.slow
+@pytest.mark.parametrize("command", COMMANDS, ids=[" ".join(c) for c in COMMANDS])
+def test_each_command_under_one_second_at_10k(command, tmp_path, bulk_seed, monkeypatch):
+    path = str(tmp_path / "big.db")
+    bulk_seed(path, COUNT)
+    monkeypatch.setattr(sys, "stdout", _DiscardingStream())
+
+    started = perf_counter()
+    status = cli.main(["--db", path, *command])
+    elapsed = perf_counter() - started
+
+    assert status == 0
+    assert elapsed < LIMIT_SECONDS, f"{' '.join(command)} took {elapsed:.3f}s"
