+"""FR-009 / FR-017: titles default to empty, tags render in code-point order."""
+
+from __future__ import annotations
+
+import pytest
+
+from bookmarks import output
+from bookmarks.storage import Bookmark
+
+
+def test_absent_title_defaults_to_empty_string(run, db, stored_bookmarks):
+    status, out, err = run("--db", db, "add", "https://a.example")
+
+    assert status == 0
+    assert stored_bookmarks(db) == [(1, "https://a.example", "")]
+
+    status, out, err = run("--db", db, "list")
+    assert status == 0
+    assert out == "1\thttps://a.example\t\t\n"
+
+
+@pytest.mark.parametrize(
+    "tags,expected",
+    (
+        ((), ""),
+        (("python",), "python"),
+        (("python", "Docs"), "Docs,python"),
+        (("b", "a", "c"), "a,b,c"),
+        (("Z", "a", "B"), "B,Z,a"),
+        (("é", "a"), "a,é"),
+    ),
+)
+def test_tags_joined_in_code_point_order(tags, expected):
+    assert output.join_tags(tags) == expected
+
+
+def test_listing_line_is_four_fields_with_trailing_newline():
+    line = output.format_listing_line(
+        Bookmark(7, "https://a.example", "Title", ("python", "Docs"))
+    )
+
+    assert line == "7\thttps://a.example\tTitle\tDocs,python\n"
+    assert line.rstrip("\n").split("\t") == ["7", "https://a.example", "Title", "Docs,python"]
+
+
+def test_empty_title_and_tags_render_as_empty_fields():
+    line = output.format_listing_line(Bookmark(1, "https://a.example", "", ()))
+
+    assert line == "1\thttps://a.example\t\t\n"
+    assert line.endswith("\t\t\n")
+
+
+def test_title_is_reproduced_verbatim():
+    awkward = 'a\tb\nc "d" é'
+    line = output.format_listing_line(Bookmark(1, "https://a.example", awkward, ()))
+
+    assert awkward in line
