+"""FR-010 / FR-012: comma-separated tag parsing, including the degenerate inputs."""
+
+from __future__ import annotations
+
+import pytest
+
+from bookmarks import cli
+
+
+def test_comma_list_parsed_and_absent_means_no_tags(run, db, stored_tag_links):
+    assert cli.parse_tags("python,cli") == ("python", "cli")
+    assert cli.parse_tags(None) == ()
+
+    status, out, err = run("--db", db, "add", "https://a.example", "--tags", "python,cli")
+    assert status == 0
+    assert stored_tag_links(db) == [(1, "cli"), (1, "python")]
+
+    status, out, err = run("--db", db, "add", "https://b.example")
+    assert status == 0
+    assert [link for link in stored_tag_links(db) if link[0] == 2] == []
+
+
+DEGENERATE_CASES = (
+    ("", set()),
+    (",", set()),
+    (",,,", set()),
+    ("a,,b", {"a", "b"}),
+    (" a , b ", {"a", "b"}),
+    ("a,a", {"a"}),
+    ("a,b,a", {"a", "b"}),
+    ("Python,python", {"Python", "python"}),
+    ("  ", set()),
+    ("\ta\t,\tb", {"a", "b"}),
+)
+
+
+@pytest.mark.parametrize("raw,expected", DEGENERATE_CASES)
+def test_degenerate_tag_inputs(raw, expected, run, db, stored_tag_links):
+    assert set(cli.parse_tags(raw)) == expected
+
+    status, out, err = run("--db", db, "add", "https://a.example", "--tags", raw)
+
+    assert status == 0
+    assert {link[1] for link in stored_tag_links(db)} == expected
