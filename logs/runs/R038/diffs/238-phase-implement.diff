+"""Contract: the listing format (FR-017, SC-006) and the export formats (SC-006).
+
+The export half of this module is appended by User Story 4.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import json
+
+
+def test_listing_is_four_tab_separated_fields(run, db):
+    run("--db", db, "add", "https://docs.python.org", "--title", "Python docs",
+        "--tags", "python,docs")
+    run("--db", db, "add", "https://example.com")
+
+    status, out, err = run("--db", db, "list")
+
+    assert status == 0
+    assert err == ""
+    lines = out.split("\n")
+    assert lines[-1] == ""  # exactly one trailing newline, no blank final line
+    assert lines[:-1] == [
+        "1\thttps://docs.python.org\tPython docs\tdocs,python",
+        "2\thttps://example.com\t\t",
+    ]
+
+
+def test_listing_splits_into_four_fields(run, db):
+    run("--db", db, "add", "https://a.example", "--title", "A", "--tags", "x")
+    run("--db", db, "add", "https://b.example")
+
+    status, out, err = run("--db", db, "list")
+
+    assert status == 0
+    for line in out.splitlines():
+        assert len(line.split("\t")) == 4
+    assert out.splitlines()[1].endswith("\t\t")
+    assert "id\turl" not in out  # no header row
+
+
+def test_tags_sorted_by_code_point(run, db):
+    run("--db", db, "add", "https://a.example", "--tags", "python,Docs,zebra,Apple")
+
+    status, out, err = run("--db", db, "list")
+
+    assert status == 0
+    assert out.rstrip("\n").split("\t")[3] == "Apple,Docs,python,zebra"
+
+
+def test_export_parses_with_stdlib_parsers(run, db):
+    """SC-006: both formats parse with the standard parsers on the first attempt."""
+    run("--db", db, "add", "https://a.example", "--title", 'He said "hi", then\nleft',
+        "--tags", "b,a")
+    run("--db", db, "add", "https://b.example")
+
+    status, out, err = run("--db", db, "export", "--format", "csv")
+    assert status == 0
+    rows = list(csv.reader(io.StringIO(out)))
+    assert len(rows) == 3
+    assert all(len(row) == 4 for row in rows)
+    assert "\r" not in out  # \n line terminators, not the csv module's default \r\n
+
+    status, out, err = run("--db", db, "export", "--format", "json")
+    assert status == 0
+    assert len(json.loads(out)) == 2
