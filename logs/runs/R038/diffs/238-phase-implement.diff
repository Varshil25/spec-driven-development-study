@@ -0,0 +1,81 @@
+"""FR-002 and the spec's Edge Cases: an unusable --db path is an error, never a fallback.
+
+``--db`` is a first-party operator argument with no allowed base directory to confine it to
+(plan.md's documented path-containment deviation), so what is asserted here is that a path
+that cannot be used fails loudly: status 1, one line on standard error, no directory tree
+created, and never a quiet switch to the default collection.
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+
+def test_missing_parent_directory_is_an_error(run, tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    target = tmp_path / "no-such-directory" / "x.db"
+
+    status, out, err = run("--db", str(target), "list")
+
+    assert status == 1
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert not (tmp_path / "no-such-directory").exists()
+    assert not (tmp_path / "bookmarks.db").exists()  # no silent fallback
+    assert sorted(os.listdir(tmp_path)) == []
+
+
+def test_path_that_is_a_directory_is_an_error(run, tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    target = tmp_path / "a-directory"
+    target.mkdir()
+
+    status, out, err = run("--db", str(target), "list")
+
+    assert status == 1
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert target.is_dir()
+    assert sorted(os.listdir(target)) == []
+    assert not (tmp_path / "bookmarks.db").exists()
+
+
+def test_file_that_is_not_a_database_is_an_error(run, tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    target = tmp_path / "not-a-db.txt"
+    original = b"just some text, definitely not a database\n" * 64
+    target.write_bytes(original)
+
+    status, out, err = run("--db", str(target), "list")
+
+    assert status == 1
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert target.read_bytes() == original  # not rewritten, not truncated
+    assert not (tmp_path / "bookmarks.db").exists()  # never an empty collection instead
+
+
+@pytest.mark.parametrize(
+    "command",
+    (("list",), ("search", "x"), ("add", "https://a.example"), ("delete", "1"),
+     ("export", "--format", "csv")),
+    ids=lambda command: command[0],
+)
+def test_every_command_reports_an_unusable_path(command, run, tmp_path):
+    target = tmp_path / "no-such-directory" / "x.db"
+
+    status, out, err = run("--db", str(target), *command)
+
+    assert status == 1
+    assert out == ""
+    assert len(err.splitlines()) == 1
+
+
+def test_a_usable_path_still_works_after_a_failure(run, tmp_path):
+    """The error path leaves no state that would spoil the next, valid invocation."""
+    assert run("--db", str(tmp_path / "nope" / "x.db"), "list")[0] == 1
+
+    good = str(tmp_path / "good.db")
+    assert run("--db", good, "add", "https://a.example") == (0, "1\n", "")
