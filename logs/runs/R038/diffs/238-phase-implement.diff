+"""User Story 2 (P2) acceptance scenarios AS1-AS4: find a bookmark among many."""
+
+from __future__ import annotations
+
+import pytest
+
+
+@pytest.fixture
+def seeded(run, db):
+    """A collection with mixed-case titles, URLs and tags."""
+    run("--db", db, "add", "https://PYTHON.org/downloads", "--title", "Downloads",
+        "--tags", "python")
+    run("--db", db, "add", "https://example.org/x", "--title", "Python Tutorial",
+        "--tags", "Python,docs")
+    run("--db", db, "add", "https://example.org/y", "--title", "100% coverage",
+        "--tags", "Testing")
+    run("--db", db, "add", "https://example.org/z", "--title", "nothing relevant")
+    return db
+
+
+def test_search_is_case_insensitive_substring(seeded, run):
+    """US2 AS1 / FR-015: PYTHON matches mixed-case titles and URLs, in id order."""
+    status, out, err = run("--db", seeded, "search", "PYTHON")
+
+    assert status == 0
+    assert err == ""
+    assert [line.split("\t")[0] for line in out.splitlines()] == ["1", "2"]
+
+    # The same two rows whatever the case of the needle.
+    for needle in ("python", "Python", "pYtHoN"):
+        status, out, err = run("--db", seeded, "search", needle)
+        assert [line.split("\t")[0] for line in out.splitlines()] == ["1", "2"]
+
+
+def test_search_matches_url_only_rows(seeded, run):
+    status, out, err = run("--db", seeded, "search", "downloads")
+
+    assert status == 0
+    assert [line.split("\t")[0] for line in out.splitlines()] == ["1"]
+
+
+def test_tag_filter_is_exact_and_case_sensitive(seeded, run):
+    """US2 AS2 / FR-014: --tag python excludes the bookmark tagged Python."""
+    status, out, err = run("--db", seeded, "list", "--tag", "python")
+
+    assert status == 0
+    assert err == ""
+    assert out == "1\thttps://PYTHON.org/downloads\tDownloads\tpython\n"
+
+    status, out, err = run("--db", seeded, "list", "--tag", "Python")
+    assert out == "2\thttps://example.org/x\tPython Tutorial\tPython,docs\n"
+
+
+def test_tag_filtered_row_shows_all_of_its_tags(seeded, run):
+    """FR-014 + FR-017: filtering selects bookmarks, it does not hide their other tags."""
+    status, out, err = run("--db", seeded, "list", "--tag", "docs")
+
+    assert status == 0
+    assert out.rstrip("\n").split("\t")[3] == "Python,docs"
+
+
+def test_tag_filter_is_not_a_substring_match(seeded, run):
+    status, out, err = run("--db", seeded, "list", "--tag", "py")
+
+    assert (status, out, err) == (0, "", "")
+
+
+def test_search_and_filter_results_are_in_id_order(seeded, run):
+    run("--db", seeded, "add", "https://aaa.example/python", "--tags", "python")
+
+    status, out, err = run("--db", seeded, "search", "python")
+    assert [line.split("\t")[0] for line in out.splitlines()] == ["1", "2", "5"]
+
+    status, out, err = run("--db", seeded, "list", "--tag", "python")
+    assert [line.split("\t")[0] for line in out.splitlines()] == ["1", "5"]
+
+
+def test_no_match_is_a_success(seeded, run):
+    """US2 AS3 / FR-018."""
+    status, out, err = run("--db", seeded, "search", "zzzznothing")
+    assert (status, out, err) == (0, "", "")
+
+    status, out, err = run("--db", seeded, "list", "--tag", "zzzznothing")
+    assert (status, out, err) == (0, "", "")
diff --git a/tests/integration/test_story3_delete.py b/tests/integration/test_story3_delete.py
new file mode 100644
index 0000000..5c22ec1
--- /dev/null
+++ b/tests/integration/test_story3_delete.py
@@ -0,0 +1,86 @@
+"""User Story 3 (P3) acceptance scenarios AS1-AS4: remove a bookmark."""
+
+from __future__ import annotations
+
+import pytest
+
+
+@pytest.fixture
+def three(run, db):
+    run("--db", db, "add", "https://a.example", "--title", "A", "--tags", "x,y")
+    run("--db", db, "add", "https://b.example", "--title", "B", "--tags", "y,z")
+    run("--db", db, "add", "https://c.example", "--title", "C")
+    return db
+
+
+def test_delete_removes_bookmark_and_its_tags(three, run, stored_bookmarks, stored_tag_links):
+    """US3 AS1 / FR-019: the bookmark and its tag associations go, and only those."""
+    status, out, err = run("--db", three, "delete", "2")
+
+    assert status == 0
+    assert out == ""
+    assert err == ""
+    assert [row[0] for row in stored_bookmarks(three)] == [1, 3]
+    assert stored_tag_links(three) == [(1, "x"), (1, "y")]
+    assert all(link[0] != 2 for link in stored_tag_links(three))
+
+
+def test_delete_leaves_others_unchanged(three, run):
+    """US3 AS1 / FR-020: survivors keep their identifiers, URLs, titles and tags."""
+    before = run("--db", three, "list")[1].splitlines()
+
+    status, out, err = run("--db", three, "delete", "2")
+    assert status == 0
+
+    after = run("--db", three, "list")[1].splitlines()
+    assert after == [line for line in before if not line.startswith("2\t")]
+    assert after == ["1\thttps://a.example\tA\tx,y", "3\thttps://c.example\tC\t"]
+
+
+def test_delete_missing_id_exits_three(three, run, stored_bookmarks, stored_tag_links):
+    """US3 AS2 / FR-021: a well-formed but absent identifier is status 3 and changes nothing."""
+    run("--db", three, "delete", "2")
+    before = stored_bookmarks(three)
+    before_tags = stored_tag_links(three)
+
+    status, out, err = run("--db", three, "delete", "2")
+
+    assert status == 3
+    assert out == ""
+    assert len(err.splitlines()) == 1
+    assert stored_bookmarks(three) == before
+    assert stored_tag_links(three) == before_tags
+
+    status, out, err = run("--db", three, "delete", "999")
+    assert status == 3
+    assert stored_bookmarks(three) == before
+
+
+def test_delete_on_empty_collection_exits_three(run, db):
+    status, out, err = run("--db", db, "delete", "1")
+
+    assert status == 3
+    assert out == ""
+    assert len(err.splitlines()) == 1
+
+
+def test_ids_increase_and_are_never_reused(three, run):
+    """US3 AS3 / FR-007: ids 1,2,3 -> delete 3 -> the next add is 4."""
+    status, out, err = run("--db", three, "delete", "3")
+    assert status == 0
+
+    status, out, err = run("--db", three, "add", "https://d.example")
+    assert (status, out) == (0, "4\n")
+
+    # And after removing every bookmark, allocation still moves forward.
+    for identifier in ("1", "2", "4"):
+        assert run("--db", three, "delete", identifier)[0] == 0
+    assert run("--db", three, "list")[1] == ""
+    assert run("--db", three, "add", "https://e.example")[1] == "5\n"
+
+
+def test_delete_of_each_id_in_turn_keeps_the_rest(three, run, stored_bookmarks):
+    assert run("--db", three, "delete", "1")[0] == 0
+    assert [row[0] for row in stored_bookmarks(three)] == [2, 3]
+    assert run("--db", three, "delete", "3")[0] == 0
+    assert [row[0] for row in stored_bookmarks(three)] == [2]
