+"""SR-004 / FR-016: search text is literal -- pattern metacharacters match only themselves."""
+
+from __future__ import annotations
+
+import pytest
+
+
+def test_percent_and_underscore_are_literal(run, db):
+    """US2 AS4: searching % returns only the row whose title literally contains %."""
+    run("--db", db, "add", "https://a.example", "--title", "100% coverage")
+    run("--db", db, "add", "https://b.example", "--title", "plain title")
+    run("--db", db, "add", "https://c.example/a_b", "--title", "underscored")
+
+    status, out, err = run("--db", db, "search", "%")
+    assert status == 0
+    assert [line.split("\t")[0] for line in out.splitlines()] == ["1"]
+
+    status, out, err = run("--db", db, "search", "_")
+    assert status == 0
+    assert [line.split("\t")[0] for line in out.splitlines()] == ["3"]
+
+
+@pytest.mark.parametrize("needle", ("%", "_", "%%", "_%_", "%cover%", "a_b", "[a-z]", "*"))
+def test_search_for_percent_does_not_match_row_without_percent(needle, run, db):
+    """A pattern-looking needle must not match rows that do not literally contain it."""
+    run("--db", db, "add", "https://a.example", "--title", "plain title")
+    run("--db", db, "add", "https://b.example", "--title", "another one")
+
+    status, out, err = run("--db", db, "search", needle)
+
+    assert status == 0
+    assert out == ""
+    assert err == ""
+
+
+def test_literal_needle_still_matches_when_present(run, db):
+    run("--db", db, "add", "https://a.example", "--title", "50%_off [sale] *now*")
+
+    for needle in ("%_", "[sale]", "*now*", "50%"):
+        status, out, err = run("--db", db, "search", needle)
+        assert status == 0
+        assert out.split("\t")[0] == "1", needle
diff --git a/tests/security/test_security_stdlib_only.py b/tests/security/test_security_stdlib_only.py
new file mode 100644
index 0000000..3cfa123
--- /dev/null
+++ b/tests/security/test_security_stdlib_only.py
@@ -0,0 +1,96 @@
+"""SR-010 / FR-011 / SC-007: the shipped package imports nothing outside the standard
+library, and never shells out, spawns a process, opens a network connection or reads
+environment-driven configuration.
+
+The check walks the abstract syntax tree of every shipped module, so comments and strings
+cannot create a false positive and unusual formatting cannot create a false negative
+(research.md R9).
+"""
+
+from __future__ import annotations
+
+import ast
+import pathlib
+import sys
+
+import pytest
+
+from bookmarks import cli
+
+SOURCE_DIR = pathlib.Path(cli.__file__).parent
+SOURCE_FILES = sorted(SOURCE_DIR.glob("*.py"))
+
+# Spelled in pieces so this test file's own text cannot be what the scan finds.
+FORBIDDEN_FRAGMENTS = (
+    "sub" + "process",
+    "soc" + "ket",
+    "urllib." + "request",
+    "os." + "system",
+    "os." + "popen",
+    "os." + "environ",
+    "eval(",
+    "exec(",
+)
+
+
+def test_shipped_files_are_the_five_planned_modules():
+    assert [path.name for path in SOURCE_FILES] == [
+        "__init__.py",
+        "__main__.py",
+        "cli.py",
+        "output.py",
+        "storage.py",
+    ]
+
+
+def _imported_top_level_names(path: pathlib.Path) -> set[str]:
+    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+    names: set[str] = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                names.add(alias.name.split(".")[0])
+        elif isinstance(node, ast.ImportFrom):
+            if node.level:
+                continue  # a relative import of this package's own modules
+            assert node.module is not None
+            names.add(node.module.split(".")[0])
+    return names
+
+
+@pytest.mark.parametrize("path", SOURCE_FILES, ids=lambda path: path.name)
+def test_no_network_or_subprocess_imports(path):
+    imported = _imported_top_level_names(path)
+
+    outside_stdlib = sorted(imported - set(sys.stdlib_module_names))
+    assert outside_stdlib == [], f"{path.name} imports non-standard-library modules"
+
+    for module in ("sub" + "process", "soc" + "ket", "urllib"):
+        assert module not in imported, f"{path.name} imports {module}"
+
+
+@pytest.mark.parametrize("path", SOURCE_FILES, ids=lambda path: path.name)
+def test_no_shell_subprocess_socket_or_env_config(path):
+    text = path.read_text(encoding="utf-8")
+
+    for fragment in FORBIDDEN_FRAGMENTS:
+        assert fragment not in text, f"{path.name} mentions {fragment!r}"
+
+
+def test_whole_package_imports_only_these_standard_modules():
+    imported: set[str] = set()
+    for path in SOURCE_FILES:
+        imported |= _imported_top_level_names(path)
+
+    assert imported <= {
+        "__future__",
+        "argparse",
+        "contextlib",
+        "csv",
+        "dataclasses",
+        "json",
+        "os",
+        "sqlite3",
+        "sys",
+        "typing",
+    }
diff --git a/tests/security/test_security_streaming.py b/tests/security/test_security_streaming.py
new file mode 100644
index 0000000..0d04c8b
--- /dev/null
+++ b/tests/security/test_security_streaming.py
@@ -0,0 +1,87 @@
+"""SR-007: reading the collection is bounded in memory, whatever the collection size.
+
+The export is run with a discarding output stream so what is measured is the program's own
+working set rather than the test's copy of the output.
+"""
+
+from __future__ import annotations
+
+import sys
+import tracemalloc
+
+import pytest
+
+from bookmarks import cli
+
+SMALL = 5_000
+LARGE = 50_000
+
+# Peak allocation ceiling for a 50,000-bookmark export. A design that materialised the
+# collection would need tens of megabytes here.
+PEAK_CEILING_BYTES = 2 * 1024 * 1024
+
+
+class _DiscardingStream:
+    """A write-only sink: no buffer grows as the export streams through it."""
+
+    def __init__(self) -> None:
+        self.written = 0
+
+    def write(self, text: str) -> int:
+        self.written += len(text)
+        return len(text)
+
+    def flush(self) -> None:
+        pass
+
+
+def _export_peak(path: str, fmt: str, monkeypatch) -> tuple[int, int]:
+    sink = _DiscardingStream()
+    monkeypatch.setattr(sys, "stdout", sink)
+    tracemalloc.start()
+    try:
+        status = cli.main(["--db", path, "export", "--format", fmt])
+        _, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+    assert status == 0
+    assert sink.written > 0
+    return peak, sink.written
+
+
+@pytest.mark.slow
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_export_of_50k_bookmarks_is_memory_bounded(fmt, tmp_path, bulk_seed, monkeypatch):
+    small_path = str(tmp_path / "small.db")
+    large_path = str(tmp_path / "large.db")
+    bulk_seed(small_path, SMALL)
+    bulk_seed(large_path, LARGE)
+
+    small_peak, small_bytes = _export_peak(small_path, fmt, monkeypatch)
+    large_peak, large_bytes = _export_peak(large_path, fmt, monkeypatch)
+
+    # The output really did grow ten-fold ...
+    assert large_bytes > small_bytes * 8
+    # ... while the memory held to produce it did not grow with it.
+    assert large_peak < PEAK_CEILING_BYTES, f"{fmt}: peak {large_peak} bytes"
+    assert large_peak < small_peak * 2, f"{fmt}: {small_peak} -> {large_peak} bytes"
+
+
+@pytest.mark.slow
+def test_list_and_search_are_also_streamed(tmp_path, bulk_seed, monkeypatch):
+    path = str(tmp_path / "large.db")
+    bulk_seed(path, LARGE)
+
+    for argv in (["--db", path, "list"], ["--db", path, "search", "Title"]):
+        sink = _DiscardingStream()
+        monkeypatch.setattr(sys, "stdout", sink)
+        tracemalloc.start()
+        try:
+            status = cli.main(argv)
+            _, peak = tracemalloc.get_traced_memory()
+        finally:
+            tracemalloc.stop()
+
+        assert status == 0
+        assert sink.written > 0
+        assert peak < PEAK_CEILING_BYTES, f"{argv[-1]}: peak {peak} bytes"
