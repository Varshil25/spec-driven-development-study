@@ -0,0 +1,104 @@
+"""FR-003 and SC-003: the collection persists, and a long run of commands stays exact."""
+
+from __future__ import annotations
+
+import os
+import random
+import sqlite3
+
+
+def _schema_objects(path: str) -> set[str]:
+    connection = sqlite3.connect(path)
+    try:
+        rows = connection.execute("SELECT name FROM sqlite_master").fetchall()
+    finally:
+        connection.close()
+    return {row[0] for row in rows}
+
+
+def test_missing_file_is_created_with_schema(run, tmp_path):
+    path = str(tmp_path / "fresh.db")
+    assert not os.path.exists(path)
+
+    status, out, err = run("--db", path, "list")
+
+    assert (status, out, err) == (0, "", "")
+    assert os.path.exists(path)
+    objects = _schema_objects(path)
+    assert {"bookmarks", "bookmark_tags", "idx_bookmark_tags_tag"} <= objects
+
+
+def test_existing_file_is_reused(run, db):
+    run("--db", db, "add", "https://a.example", "--title", "A", "--tags", "x,y")
+    first = os.stat(db).st_ino
+
+    # A later, independent invocation sees the earlier one's rows ...
+    status, out, err = run("--db", db, "list")
+    assert out == "1\thttps://a.example\tA\tx,y\n"
+
+    # ... and adds to the same file rather than replacing it.
+    run("--db", db, "add", "https://b.example")
+    assert os.stat(db).st_ino == first
+    assert len(run("--db", db, "list")[1].splitlines()) == 2
+
+
+def test_two_paths_are_two_independent_collections(run, tmp_path):
+    one = str(tmp_path / "one.db")
+    two = str(tmp_path / "two.db")
+
+    run("--db", one, "add", "https://a.example")
+    run("--db", one, "add", "https://b.example")
+    run("--db", two, "add", "https://c.example")
+
+    assert run("--db", one, "list")[1].count("\n") == 2
+    assert run("--db", two, "list")[1] == "1\thttps://c.example\t\t\n"
+
+
+def test_thousand_mixed_commands_leave_expected_collection(run, db):
+    """SC-003: 1,000 scripted operations against a Python-side model of the collection."""
+    rng = random.Random(20261120)
+    model: dict[int, tuple[str, str, tuple[str, ...]]] = {}
+    next_id = 1
+    adds = deletes = misses = 0
+
+    for step in range(1000):
+        if not model or rng.random() < 0.7:
+            url = f"https://example.com/{step}"
+            title = f"Title {step}" if step % 3 else ""
+            tags = tuple(sorted({f"tag{rng.randrange(5)}" for _ in range(rng.randrange(4))}))
+            argv = ["--db", db, "add", url]
+            if title:
+                argv += ["--title", title]
+            if tags:
+                argv += ["--tags", ",".join(tags)]
+
+            status, out, err = run(*argv)
+            assert (status, err) == (0, ""), (step, err)
+            assert out == f"{next_id}\n", step
+            model[next_id] = (url, title, tags)
+            next_id += 1
+            adds += 1
+        elif rng.random() < 0.85:
+            identifier = rng.choice(sorted(model))
+            status, out, err = run("--db", db, "delete", str(identifier))
+            assert (status, out, err) == (0, "", ""), (step, err)
+            del model[identifier]
+            deletes += 1
+        else:
+            absent = next_id + rng.randrange(1, 100)
+            status, out, err = run("--db", db, "delete", str(absent))
+            assert status == 3, step
+            misses += 1
+
+    assert adds + deletes + misses == 1000
+    assert adds and deletes and misses  # all three kinds really occurred
+
+    expected = "".join(
+        f"{identifier}\t{url}\t{title}\t{','.join(sorted(tags))}\n"
+        for identifier, (url, title, tags) in sorted(model.items())
+    )
+    status, out, err = run("--db", db, "list")
+
+    assert (status, err) == (0, "")
+    assert out == expected
+    assert len(out.splitlines()) == len(model)
