+"""User Story 1 (P1) acceptance scenarios AS1-AS5: save a bookmark and see it again later."""
+
+from __future__ import annotations
+
+import os
+
+
+def test_add_prints_only_the_identifier(run, db):
+    """US1 AS1 / FR-006: stdout is exactly the identifier and a newline."""
+    status, out, err = run(
+        "--db", db, "add", "https://docs.python.org", "--title", "Python docs",
+        "--tags", "python,docs",
+    )
+
+    assert status == 0
+    assert out == "1\n"
+    assert err == ""
+
+    status, out, err = run("--db", db, "add", "https://example.com")
+    assert status == 0
+    assert out == "2\n"
+    assert err == ""
+
+
+def test_db_option_is_used(run, tmp_path):
+    """FR-002: the collection lives in the file named by --db."""
+    first = str(tmp_path / "one.db")
+    second = str(tmp_path / "two.db")
+
+    run("--db", first, "add", "https://a.example")
+    run("--db", second, "add", "https://b.example")
+
+    assert os.path.exists(first) and os.path.exists(second)
+
+    status, out, err = run("--db", first, "list")
+    assert out == "1\thttps://a.example\t\t\n"
+    status, out, err = run("--db", second, "list")
+    assert out == "1\thttps://b.example\t\t\n"
+
+
+def test_default_db_is_cwd_bookmarks_db(run, tmp_path, monkeypatch):
+    """FR-002: with no --db, the collection is bookmarks.db in the current directory."""
+    monkeypatch.chdir(tmp_path)
+
+    status, out, err = run("add", "https://a.example")
+
+    assert status == 0
+    assert (tmp_path / "bookmarks.db").exists()
+    assert not (tmp_path / "one.db").exists()
+
+    status, out, err = run("list")
+    assert out == "1\thttps://a.example\t\t\n"
+
+
+def test_list_prints_all_in_id_order(run, db):
+    """US1 AS3 / FR-013: every stored bookmark, ascending identifier order."""
+    for name in ("c", "a", "b"):
+        run("--db", db, "add", f"https://{name}.example", "--title", name.upper())
+
+    status, out, err = run("--db", db, "list")
+
+    assert status == 0
+    assert err == ""
+    assert out == (
+        "1\thttps://c.example\tC\t\n"
+        "2\thttps://a.example\tA\t\n"
+        "3\thttps://b.example\tB\t\n"
+    )
+
+
+def test_data_survives_process_exit(run, db):
+    """US1 AS2 / FR-003: a later invocation sees what an earlier one stored."""
+    run("--db", db, "add", "https://a.example", "--title", "A", "--tags", "x,y")
+    run("--db", db, "add", "https://b.example")
+
+    # Each run() is a complete, independent invocation of main(): nothing is carried in
+    # memory between them.
+    status, out, err = run("--db", db, "list")
+
+    assert status == 0
+    assert out == (
+        "1\thttps://a.example\tA\tx,y\n"
+        "2\thttps://b.example\t\t\n"
+    )
+
+
+def test_first_add_needs_no_setup(run, tmp_path):
+    """SC-001: a fresh directory, one command, no initialisation step."""
+    path = str(tmp_path / "fresh.db")
+
+    status, out, err = run("--db", path, "add", "https://a.example")
+
+    assert (status, out, err) == (0, "1\n", "")
+
+
+def test_rejected_add_leaves_the_collection_unchanged(run, db):
+    """US1 AS5 / FR-008: an unsupported scheme is refused with status 2 and stores nothing."""
+    run("--db", db, "add", "https://a.example")
+    run("--db", db, "add", "https://b.example")
+
+    status, out, err = run("--db", db, "add", "ftp://example.com")
+
+    assert status == 2
+    assert out == ""
+    assert len(err.splitlines()) == 1
+
+    status, out, err = run("--db", db, "list")
+    assert len(out.splitlines()) == 2
+
+
+def test_empty_collection_lists_nothing_and_succeeds(run, db):
+    """FR-018: nothing to show is a success, not an error."""
+    status, out, err = run("--db", db, "list")
+
+    assert (status, out, err) == (0, "", "")
