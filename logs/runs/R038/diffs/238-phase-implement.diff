@@ -0,0 +1,43 @@
+"""FR-001: the command surface is exactly the five documented subcommands, run as a module."""
+
+from __future__ import annotations
+
+import pathlib
+import runpy
+
+import pytest
+
+from bookmarks import cli
+
+SOURCE_DIR = pathlib.Path(cli.__file__).parent
+
+INVOCATIONS = (
+    ("add", "https://example.com"),
+    ("list",),
+    ("search", "text"),
+    ("delete", "1"),
+    ("export", "--format", "csv"),
+)
+
+
+@pytest.mark.parametrize("argv", INVOCATIONS, ids=[argv[0] for argv in INVOCATIONS])
+def test_five_subcommands_exist(argv):
+    args = cli.build_parser().parse_args(list(argv))
+    assert args.command == argv[0]
+    assert args.db == "bookmarks.db"
+
+
+def test_no_sixth_subcommand():
+    with pytest.raises(SystemExit) as raised:
+        cli.build_parser().parse_args(["frobnicate"])
+    assert raised.value.code == 2
+
+
+def test_module_is_runnable():
+    # Executed under a name other than "__main__" so the guarded entry call does not run:
+    # this proves the module imports cleanly and holds the entry point.
+    namespace = runpy.run_module("bookmarks.__main__", run_name="not_main")
+    assert callable(namespace["cli"].main)
+    source = (SOURCE_DIR / "__main__.py").read_text(encoding="utf-8")
+    assert 'if __name__ == "__main__":' in source
+    assert "sys.exit(cli.main(sys.argv[1:]))" in source
