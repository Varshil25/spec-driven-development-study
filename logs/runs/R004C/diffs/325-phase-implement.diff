+
+# --- feature 002: SC-022, the two new operations at 1 000 accounts -----------
+#
+# Flagged note 1 of plan.md: ``reset`` performs two deliberate scrypt
+# derivations -- verify the token, hash the new password -- and so leaves only
+# about 1.2x headroom against the absolute bound on the development host.  That
+# is the same position ``passwd`` records above and has the same single lever,
+# the work factor, which SR-013 fixes at the password parameters.  If the
+# absolute assertion below binds on slower hardware, report it: lowering the
+# work factor would be an SR-013/SR-004 amendment, not an implementation fix.
+
+
+@pytest.mark.slow
+def test_sc022_reset_operations_under_one_second(run, store_path, build_store):
+    """``reset-token`` and ``reset`` each finish inside the budget (SC-022)."""
+    from conftest import issue_token
+
+    _populate(build_store, store_path, 999)
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    assert len(read_store(store_path)["accounts"]) == 1000
+
+    issuance = _timed(
+        run, ["--store", store_path, "reset-token", "alice"], None, 0
+    )
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    redemption = _timed(
+        run,
+        ["--store", store_path, "reset", "alice"],
+        lines(token, NEW_PASSWORD),
+        0,
+    )
+
+    measured = {"reset-token": issuance, "reset": redemption}
+    over_budget = {k: v for k, v in measured.items() if v >= ABSOLUTE_BUDGET}
+    assert not over_budget, (over_budget, measured)
+    # The new password took effect, so the measurement was of real work.
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+
+
+@pytest.mark.slow
+def test_sc022_store_scaling_component_negligible(run, tmp_path, build_store):
+    """The store-size component of both operations is negligible (SC-022).
+
+    The hardware-independent half of the claim: the ~0.4 s per derivation
+    dominates, and the cost of carrying 1 000 accounts instead of 1 is
+    milliseconds.
+    """
+    from conftest import issue_token
+
+    small = tmp_path / "small.store"
+    large = tmp_path / "large.store"
+    build_store(small, {})
+    _populate(build_store, large, 999)
+    for path in (small, large):
+        assert run(["--store", path, "register", "alice"], lines(PASSWORD))[0] == 0
+
+    def best_issue(path):
+        return min(
+            _timed(run, ["--store", path, "reset-token", "alice"], None, 0)
+            for _ in range(3)
+        )
+
+    def best_redeem(path):
+        times = []
+        for _ in range(3):
+            token=[REDACTED:assigned_secret](path, "alice")
+            times.append(
+                _timed(
+                    run,
+                    ["--store", path, "reset", "alice"],
+                    lines(token, PASSWORD),
+                    0,
+                )
+            )
+        return min(times)
+
+    for label, measure in (("reset-token", best_issue), ("reset", best_redeem)):
+        small_time = measure(small)
+        large_time = measure(large)
+        assert large_time - small_time < SCALING_BUDGET, (
+            label,
+            small_time,
+            large_time,
+        )
+
+    # And the material a full store carries stays inside the existing cap: a
+    # fixed 174 bytes per record (FR-043), so 10 000 accounts all holding a
+    # token is 3 440 027 bytes against the 8 388 608-byte limit.
+    assert 10000 * 174 + 1700027 < 8388608
diff --git a/tests/test_reset.py b/tests/test_reset.py
new file mode 100644
index 0000000..644c197
--- /dev/null
+++ b/tests/test_reset.py
@@ -0,0 +1,633 @@
+"""User Story 1 (redemption), User Story 3 and User Story 4 for ``reset``.
+
+FR-023, FR-024, FR-030, FR-033 … FR-039 plus SC-013, SC-014 and SC-017.  Every
+token value is read at runtime through ``conftest.issue_token``; none is a
+literal (SR-013, SC-015).
+"""
+
+import time
+
+from conftest import (
+    MIN_PASSWORD,
+    NEW_PASSWORD,
+    OTHER_PASSWORD,
+    OVERLONG_TOKEN_LINE,
+    PASSWORD,
+    SHORT_PASSWORD,
+    SYNTHETIC_TOKEN,
+    WRONG_PASSWORD,
+    failed_logins,
+    issue_token,
+    lines,
+    read_store,
+    write_store,
+)
+
+
+def _register(run, store_path, username="alice", password=[REDACTED:assigned_secret]):
+    assert run(["--store", store_path, "register", username], lines(password))[0] == 0
+
+
+def _lock(run, store_path, username="alice"):
+    for _ in range(5):
+        assert run(
+            ["--store", store_path, "login", username], lines(WRONG_PASSWORD)
+        )[0] == 1
+    assert failed_logins(store_path, username) == 5
+
+
+def _reset_of(store_path, username="alice"):
+    return read_store(store_path)["accounts"][username].get("reset")
+
+
+def _set_expiry(store_path, expires_ms, username="alice"):
+    """Rewrite one account's recorded expiry, leaving its digest alone."""
+    document = read_store(store_path)
+    document["accounts"][username]["reset"]["expires_ms"] = expires_ms
+    write_store(store_path, document["accounts"], version=document["version"])
+
+
+# --- User Story 1: redemption happy path -------------------------------------
+
+
+def test_sc013_issue_and_redeem_across_invocations(run, store_path):
+    """Issued in one invocation, redeemed in a separate one (SC-013)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    assert run(["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)) == (
+        0,
+        "password reset\n",
+        "",
+    )
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
+
+
+def test_fr025_password_reset_on_stdout(run, store_path):
+    """``password reset`` and one newline on stdout, stderr empty (FR-025)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    status, out, err = run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )
+    assert status == 0
+    assert out == "password reset\n"
+    assert err == ""
+    # The token value itself appears on neither stream (SR-018).
+    assert token not in out
+    assert token not in err
+
+
+def test_fr023_two_lines_in_order(run, store_path):
+    """Exactly two lines, token first then new password (FR-023)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    # The reverse order is a wrong token, not a success: the order is fixed.
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(NEW_PASSWORD, token)
+    ) == (1, "", "invalid token\n")
+    # The old password still works, so nothing was changed by the refusal.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+    # And the documented order succeeds, with the token still outstanding.
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    ) == (0, "password reset\n", "")
+
+
+def test_fr023_extra_lines_ignored(run, store_path):
+    """Lines beyond the second are never read and are not an error (FR-023)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    status, out, err = run(
+        ["--store", store_path, "reset", "alice"],
+        lines(token, NEW_PASSWORD, "a third line", "a fourth"),
+    )
+    assert (status, out, err) == (0, "password reset\n", "")
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+
+
+def test_fr034_reset_replaces_password_and_clears_lock(run, store_path):
+    """Sets the password, zeroes the count, clears the lock (FR-034, 1.3/1.4/1.7)."""
+    _register(run, store_path)
+    _lock(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    ) == (0, "password reset\n", "")
+
+    # The new password works immediately, with no unlock step (scenario 1.7).
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
+    # The old password is dead (scenario 1.4).
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        1,
+        "",
+        "invalid credentials\n",
+    )
+    # The count was returned to 0 by the reset; the failed login above moved it
+    # to 1, so compare against that rather than re-reading a stale expectation.
+    assert failed_logins(store_path, "alice") == 1
+    # The token was consumed: the record carries no reset material (FR-035).
+    assert _reset_of(store_path) is None
+
+
+def test_fr034_other_accounts_byte_identical(run, store_path):
+    """A successful reset leaves every other account byte-identical (SC-021)."""
+    _register(run, store_path, "alice", PASSWORD)
+    _register(run, store_path, "bob", OTHER_PASSWORD)
+    _register(run, store_path, "carol", MIN_PASSWORD)
+    before = read_store(store_path)["accounts"]
+
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )[0] == 0
+
+    after = read_store(store_path)["accounts"]
+    assert after["bob"] == before["bob"]
+    assert after["carol"] == before["carol"]
+    assert after["alice"] != before["alice"]
+    assert set(after) == set(before)
+    # The untouched accounts still verify their own passwords (FR-034).
+    assert run(["--store", store_path, "login", "bob"], lines(OTHER_PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "carol"], lines(MIN_PASSWORD))[0] == 0
+
+
+def test_fr037_no_current_password_required(run, store_path):
+    """Recovery needs the token and the new password only (FR-037).
+
+    The point of the feature: the holder of the account cannot supply the
+    current password, because not knowing it is why they are here.
+    """
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    # Two lines and no more -- the stream is closed after them, so a third read
+    # would be a status-2 failure rather than a success.
+    status, out, err = run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )
+    assert (status, out, err) == (0, "password reset\n", "")
+
+
+def test_fr030_valid_before_expiry(run, store_path):
+    """A token is accepted at any point before its validity elapses (FR-030)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice", ttl="86400")
+    assert _reset_of(store_path)["expires_ms"] > int(time.time() * 1000)
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    ) == (0, "password reset\n", "")
+
+
+def test_sc014_validity_boundary_explicit(run, store_path):
+    """An explicit short validity is honoured on both sides (SC-014, 1.5)."""
+    _register(run, store_path)
+    # Accepted before it elapses: issued for 5 s and redeemed at once.
+    token=[REDACTED:assigned_secret](store_path, "alice", ttl="5")
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    ) == (0, "password reset\n", "")
+
+    # Refused once it has: the recorded expiry is moved into the past rather
+    # than waited out, so the assertion is about the stored instant and not
+    # about this host's clock speed.  The expired case with a real wait is
+    # `test_reset_invalid_token.py::test_fr030_expired_token_refused`.
+    second = issue_token(store_path, "alice", ttl="5")
+    _set_expiry(store_path, int(time.time() * 1000) - 1)
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(second, OTHER_PASSWORD)
+    ) == (1, "", "invalid token\n")
+    # The password the first redemption set is still the live one.
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+
+
+def test_sc014_validity_boundary_default(run, store_path):
+    """The default validity behaves the same way, 900 s out (SC-014)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    expiry = _reset_of(store_path)["expires_ms"]
+    now_ms = int(time.time() * 1000)
+    # 900 seconds ahead, allowing a few seconds for the derivation itself.
+    assert 890_000 <= expiry - now_ms <= 900_000, (expiry, now_ms)
+
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    ) == (0, "password reset\n", "")
+
+
+def test_sr016_expiry_read_at_attempt_not_cached(run, store_path):
+    """Expiry is read from the store at the attempt, never carried over (SR-016).
+
+    The token below was valid when it was issued.  Moving its recorded expiry
+    into the past and then into the future flips the answer, which is only
+    possible if the attempting invocation reads the stored instant and compares
+    it against its own clock.
+    """
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice", ttl="86400")
+
+    _set_expiry(store_path, 1)  # 1 ms after the epoch: long past
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    ) == (1, "", "invalid token\n")
+
+    _set_expiry(store_path, 4102444800000)  # 2100-01-01: far future
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    ) == (0, "password reset\n", "")
+
+
+# --- User Story 3: a refused new password does not burn the token -------------
+
+
+def test_fr036_short_password_keeps_token(run, store_path):
+    """An 11-character new password is status 2 and the token survives (SC-017).
+
+    Scenarios 3.1 and 3.2: the refusal is a bad request, not a spent token, so
+    the holder simply retries rather than going back to the administrator.
+    """
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    status, out, err = run(
+        ["--store", store_path, "reset", "alice"], lines(token, SHORT_PASSWORD)
+    )
+    assert status == 2
+    assert out == ""
+    assert err == (
+        "error: new password too short: expected at least 12 characters,"
+        " received 11\n"
+    )
+    # Her existing password still verifies: nothing was changed.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+    # Scenario 3.2: the same token, retried with a conforming password.
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, MIN_PASSWORD)
+    ) == (0, "password reset\n", "")
+    assert run(["--store", store_path, "login", "alice"], lines(MIN_PASSWORD))[0] == 0
+
+
+def test_fr036_long_password_keeps_token(run, store_path):
+    """A new password over the maximum is status 2 and the token survives (3.3)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    status, out, err = run(
+        ["--store", store_path, "reset", "alice"], lines(token, "x" * 1025)
+    )
+    assert (status, out) == (2, "")
+    assert err == (
+        "error: new password too long: expected at most 1024 characters,"
+        " received 1025\n"
+    )
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+    # Still usable afterwards, including at the maximum itself.
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, "y" * 1024)
+    ) == (0, "password reset\n", "")
+    assert run(["--store", store_path, "login", "alice"], lines("y" * 1024))[0] == 0
+
+
+def test_fr036_expiry_unchanged_after_refusal(run, store_path):
+    """A refused password leaves the reset object byte-identical (FR-036)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    before_bytes = store_path.read_bytes()
+    before_reset = _reset_of(store_path)
+
+    for bad in (SHORT_PASSWORD, "", "x" * 1025, "short"):
+        status, out, _ = run(
+            ["--store", store_path, "reset", "alice"], lines(token, bad)
+        )
+        assert (status, out) == (2, ""), bad
+        # Not merely the same expiry: the whole store is untouched, because
+        # nothing is written before the final step.
+        assert store_path.read_bytes() == before_bytes, bad
+        assert _reset_of(store_path) == before_reset, bad
+
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )[0] == 0
+
+
+def test_fr033_check_order_precedence(run, store_path):
+    """The checks apply in exactly the documented order (FR-033)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    # 1. username (2) outranks everything, including a missing input stream.
+    status, out, err = run(["--store", store_path, "reset", "ab"], None)
+    assert (status, out) == (2, "")
+    assert err.startswith("error: invalid username ")
+
+    # 2. the input lines (2) outrank the store, so a malformed store that is
+    #    never opened cannot be reported first.
+    malformed = store_path.parent / "malformed.store"
+    malformed.write_text("not json at all", encoding="utf-8")
+    status, out, err = run(["--store", malformed, "reset", "alice"], None)
+    assert (status, out) == (2, "")
+    assert err.startswith("error: missing reset input:")
+
+    # 3. the store (5) outranks the account's existence.
+    status, out, err = run(
+        ["--store", malformed, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )
+    assert (status, out) == (5, "")
+    assert "is malformed" in err
+
+    # 4. the account's existence (3) outranks the token.
+    assert run(
+        ["--store", store_path, "reset", "nobody"], lines(token, NEW_PASSWORD)
+    ) == (3, "", "error: no such account 'nobody'\n")
+
+    # 5. the token (1) outranks the new password's length -- scenario 3.4: an
+    #    expired token with an 11-character password answers `invalid token`,
+    #    not a password error.  Reversing this would leak whether a token is
+    #    outstanding.
+    _set_expiry(store_path, 1)
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, SHORT_PASSWORD)
+    ) == (1, "", "invalid token\n")
+    # And with no token ever issued, likewise.
+    _register(run, store_path, "bob", OTHER_PASSWORD)
+    assert run(
+        ["--store", store_path, "reset", "bob"], lines(token, SHORT_PASSWORD)
+    ) == (1, "", "invalid token\n")
+
+    # 6. the new password (2) is judged last, once the token is accepted.
+    _set_expiry(store_path, 4102444800000)
+    status, _, err = run(
+        ["--store", store_path, "reset", "alice"], lines(token, SHORT_PASSWORD)
+    )
+    assert status == 2
+    assert err.startswith("error: new password too short:")
+
+
+def test_fr036_exactly_twelve_characters_succeeds(run, store_path):
+    """A new password of exactly 12 characters is accepted (scenario 3.5)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    assert len(MIN_PASSWORD) == 12
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, MIN_PASSWORD)
+    ) == (0, "password reset\n", "")
+    assert run(["--store", store_path, "login", "alice"], lines(MIN_PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
+
+
+# --- User Story 4: bad requests are refused without touching the store -------
+
+
+def test_fr023_missing_input_is_status_2(run, store_path):
+    """Too few input lines is a bad request naming how many arrived (FR-023)."""
+    _register(run, store_path)
+    issue_token(store_path, "alice")
+
+    # An empty stream: no token line at all.
+    assert run(["--store", store_path, "reset", "alice"], None) == (
+        2,
+        "",
+        "error: missing reset input: expected a token line then a new password"
+        " line on stdin, received 0 line(s)\n",
+    )
+    # Closed after the token line: the password line never arrived.
+    assert run(["--store", store_path, "reset", "alice"], lines(SYNTHETIC_TOKEN)) == (
+        2,
+        "",
+        "error: missing reset input: expected a token line then a new password"
+        " line on stdin, received 1 line(s)\n",
+    )
+    # A final line without a terminator still counts as a line, so this is the
+    # second message and not the first.
+    status, out, err = run(["--store", store_path, "reset", "alice"], SYNTHETIC_TOKEN)
+    assert (status, out) == (2, "")
+    assert err.endswith("received 1 line(s)\n")
+
+
+def test_sr015_overlong_token_line_refused_not_truncated(run, store_path, tmp_path):
+    """A 4 097-byte token line is refused, never truncated (SR-015, FR-043)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    before = store_path.read_bytes()
+
+    expected = (
+        "error: token line too long: expected at most 4096 bytes before the"
+        " line terminator\n"
+    )
+    assert run(
+        ["--store", store_path, "reset", "alice"],
+        OVERLONG_TOKEN_LINE + "\n" + NEW_PASSWORD + "\n",
+    ) == (2, "", expected)
+    assert store_path.read_bytes() == before
+
+    # Decided before the store is opened: against a store that does not exist
+    # the answer is still 2, not the 3 a loaded store would have given -- so the
+    # over-long line was never compared against a record.
+    absent = tmp_path / "absent.store"
+    assert run(
+        ["--store", absent, "reset", "alice"],
+        OVERLONG_TOKEN_LINE + "\n" + NEW_PASSWORD + "\n",
+    ) == (2, "", expected)
+    assert not absent.exists()
+
+    # A line inside the cap is compared rather than truncated: it comes back as
+    # an ordinary wrong token, not a length error.
+    assert run(
+        ["--store", store_path, "reset", "alice"],
+        "T" * 4095 + "\n" + NEW_PASSWORD + "\n",
+    ) == (1, "", "invalid token\n")
+
+    # Boundary note, pinned so it stays a decision: the reader asks for
+    # ``MAX_LINE_BYTES + 1`` bytes *including* the terminator, so a line of
+    # exactly 4 096 bytes followed by ``\n`` is refused as too long.  This is
+    # feature 001's reader, which this feature only extracted, and FR-040
+    # requires its behaviour to be preserved byte for byte -- the five existing
+    # commands answer a 4 096-byte password line the same way.
+    assert run(
+        ["--store", store_path, "reset", "alice"],
+        "T" * 4096 + "\n" + NEW_PASSWORD + "\n",
+    ) == (2, "", expected)
+    assert run(
+        ["--store", store_path, "login", "alice"], "p" * 4096 + "\n"
+    ) == (
+        2,
+        "",
+        "error: password line too long: expected at most 4096 bytes before the"
+        " line terminator\n",
+    )
+
+    # And the real token still works.
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )[0] == 0
+
+
+def test_sr015_non_utf8_token_line_refused(run, store_path):
+    """A token line that is not valid UTF-8 names the token line (FR-023)."""
+    _register(run, store_path)
+    issue_token(store_path, "alice")
+    before = store_path.read_bytes()
+
+    assert run(
+        ["--store", store_path, "reset", "alice"], b"\xff\xfe\n" + b"anything\n"
+    ) == (2, "", "error: token line is not valid UTF-8 text\n")
+    # The *second* line's diagnostic still says "password" (A-025: only two
+    # strings changed, and this is not one of them).
+    status, out, err = run(
+        ["--store", store_path, "reset", "alice"],
+        SYNTHETIC_TOKEN.encode("ascii") + b"\n" + b"\xff\xfe\n",
+    )
+    assert (status, out) == (2, "")
+    assert err == "error: password line is not valid UTF-8 text\n"
+    assert store_path.read_bytes() == before
+
+
+def test_fr038_creates_no_file_when_store_absent(run, store_path, tmp_path):
+    """``reset`` never creates the store (FR-038)."""
+    assert not store_path.exists()
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(SYNTHETIC_TOKEN, NEW_PASSWORD)
+    ) == (3, "", "error: no such account 'alice'\n")
+    assert not store_path.exists()
+    # Not the store, not a temporary, not a lock sidecar.
+    assert sorted(p.name for p in tmp_path.iterdir()) == []
+
+
+def test_fr038_malformed_store_is_status_5_changing_nothing(run, store_path):
+    """An unreadable or malformed store is status 5 and is left alone (FR-038)."""
+    malformed = store_path.parent / "broken.store"
+    cases = (
+        "not json at all",
+        "{",
+        '{"version":2,"accounts":{}}',
+        '{"version":1,"accounts":{"alice":{}}}',
+        '{"version":1}',
+    )
+    for text in cases:
+        malformed.write_text(text, encoding="utf-8")
+        before = malformed.read_bytes()
+        status, out, err = run(
+            ["--store", malformed, "reset", "alice"],
+            lines(SYNTHETIC_TOKEN, NEW_PASSWORD),
+        )
+        assert (status, out) == (5, ""), (text, status, out, err)
+        assert err.count("\n") == 1
+        assert malformed.read_bytes() == before, text
+
+    # A directory in place of the store is a read failure, not a traceback.
+    status, out, err = run(
+        ["--store", store_path.parent, "reset", "alice"],
+        lines(SYNTHETIC_TOKEN, NEW_PASSWORD),
+    )
+    assert (status, out) == (5, "")
+    assert "Traceback" not in err
+
+
+def test_fr024_every_status_reachable(run, store_path, tmp_path):
+    """Every documented status is reachable from ``reset``; 4 is not (SC-012)."""
+    reached = {}
+
+    # 3: against a store that does not exist.
+    absent = tmp_path / "absent.store"
+    reached[3] = run(
+        ["--store", absent, "reset", "alice"], lines(SYNTHETIC_TOKEN, NEW_PASSWORD)
+    )
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    # 2: a bad request.
+    reached[2] = run(["--store", store_path, "reset", "alice"], None)
+    # 1: a refused token.
+    reached[1] = run(
+        ["--store", store_path, "reset", "alice"], lines(WRONG_PASSWORD, NEW_PASSWORD)
+    )
+    # 5: a malformed store.
+    malformed = store_path.parent / "broken.store"
+    malformed.write_text("not json at all", encoding="utf-8")
+    reached[5] = run(
+        ["--store", malformed, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )
+    # 0: the operation itself.
+    reached[0] = run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )
+
+    for expected, (status, out, err) in reached.items():
+        assert status == expected, (expected, status, out, err)
+        if expected == 0:
+            assert (out, err) == ("password reset\n", "")
+        else:
+            assert out == "", expected
+            assert err.count("\n") == 1, expected
+    assert sorted(reached) == [0, 1, 2, 3, 5]
+    assert 4 not in reached
+
+
+def test_fr039_lockout_does_not_restrict_reset(run, store_path):
+    """A locked account can still be recovered, and 4 never appears (FR-039)."""
+    _register(run, store_path)
+    _lock(run, store_path)
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 4
+
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    # A refused attempt against a locked account is 1, not 4.
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(WRONG_PASSWORD, NEW_PASSWORD)
+    ) == (1, "", "invalid token\n")
+    assert failed_logins(store_path, "alice") == 5
+    # And the real token works, clearing the lock as it goes.
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    ) == (0, "password reset\n", "")
+    assert failed_logins(store_path, "alice") == 0
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+
+
+def test_fr024_reset_invalid_username_is_status_2(run, store_path):
+    """Username rules are unchanged for ``reset`` too (FR-011, FR-033)."""
+    _register(run, store_path)
+    for name in ("ab", "a" * 33, "alice!", "al ice"):
+        status, out, err = run(
+            ["--store", store_path, "reset", name], lines(SYNTHETIC_TOKEN, NEW_PASSWORD)
+        )
+        assert (status, out) == (2, ""), (name, status, out, err)
+        assert err.startswith("error: invalid username "), (name, err)
+
+
+def test_sc013_tokens_are_account_specific(run, store_path):
+    """Two outstanding tokens each work only against their own account (1.8)."""
+    _register(run, store_path, "alice", PASSWORD)
+    _register(run, store_path, "bob", OTHER_PASSWORD)
+    alice_token = issue_token(store_path, "alice")
+    bob_token = issue_token(store_path, "bob")
+
+    # Crossed over, each is simply a wrong token.
+    assert run(
+        ["--store", store_path, "reset", "bob"], lines(alice_token, NEW_PASSWORD)
+    ) == (1, "", "invalid token\n")
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(bob_token, NEW_PASSWORD)
+    ) == (1, "", "invalid token\n")
+
+    # Both are still outstanding and both still work against their own account.
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(alice_token, NEW_PASSWORD)
+    ) == (0, "password reset\n", "")
+    assert run(
+        ["--store", store_path, "reset", "bob"], lines(bob_token, MIN_PASSWORD)
+    ) == (0, "password reset\n", "")
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "bob"], lines(MIN_PASSWORD))[0] == 0
