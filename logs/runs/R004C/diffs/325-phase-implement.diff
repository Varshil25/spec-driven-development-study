+"""User Story 2: a token that should not work does not work.
+
+All ten acceptance scenarios, plus FR-026, FR-027, FR-029, FR-030, FR-035,
+FR-037, FR-039 and SC-018.  The answer under test is one fixed string with one
+fixed status and empty standard output, identical across every reason a token
+can be refused -- the indistinguishability is the requirement, so these tests
+assert the *sameness* as much as the individual answers.
+"""
+
+import time
+
+import pytest
+
+from conftest import (
+    MIN_PASSWORD,
+    NEW_PASSWORD,
+    OTHER_PASSWORD,
+    PASSWORD,
+    SYNTHETIC_TOKEN,
+    WRONG_PASSWORD,
+    WRONG_TOKEN,
+    failed_logins,
+    issue_token,
+    lines,
+    read_store,
+)
+
+REFUSED = (1, "", "invalid token\n")
+
+
+def _register(run, store_path, username="alice", password=[REDACTED:assigned_secret]):
+    assert run(["--store", store_path, "register", username], lines(password))[0] == 0
+
+
+def _attempt(run, store_path, token, password=[REDACTED:assigned_secret], username="alice"):
+    return run(["--store", store_path, "reset", username], lines(token, password))
+
+
+def _reset_of(store_path, username="alice"):
+    return read_store(store_path)["accounts"][username].get("reset")
+
+
+# --- FR-026: the shape of the refusal ----------------------------------------
+
+
+def test_fr026_failure_streams(run, store_path):
+    """One line to stderr, nothing to stdout (FR-026)."""
+    _register(run, store_path)
+    issue_token(store_path, "alice")
+    status, out, err = _attempt(run, store_path, WRONG_TOKEN)
+    assert status == 1
+    assert out == ""
+    assert err.count("\n") == 1
+    assert err.endswith("\n")
+
+
+def test_fr026_invalid_token_is_exact_and_detail_free(run, store_path):
+    """``invalid token`` carries no further detail at all (FR-026, SR-018)."""
+    _register(run, store_path)
+    issue_token(store_path, "alice")
+    status, out, err = _attempt(run, store_path, WRONG_TOKEN)
+    assert (status, out, err) == REFUSED
+    # Nothing about the account, the supplied value, the expiry or whether a
+    # token exists leaks into the text.
+    for fragment in ("alice", WRONG_TOKEN, "expire", "token line", "issued"):
+        assert fragment not in err, fragment
+
+
+# --- the ten acceptance scenarios --------------------------------------------
+
+
+def test_scenario_1_never_issued(run, store_path):
+    """No token was ever issued: any value is refused and nothing changes."""
+    _register(run, store_path)
+    before = store_path.read_bytes()
+    for value in (WRONG_TOKEN, SYNTHETIC_TOKEN, "", "x", "y" * 22):
+        assert _attempt(run, store_path, value) == REFUSED, value
+        assert store_path.read_bytes() == before, value
+    # Her existing password still verifies.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
+
+
+def test_scenario_2_wrong_value_leaves_token_usable(run, store_path):
+    """A different value is refused and the issued token still works."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    assert _attempt(run, store_path, WRONG_TOKEN) == REFUSED
+    # Near misses are refused too: compared exactly as supplied (A-022).
+    for near in (token.upper(), token.lower(), " " + token, token + " ", token[:-1]):
+        if near == token:
+            continue
+        assert _attempt(run, store_path, near) == REFUSED, near
+    # And the real token is still outstanding.
+    assert _attempt(run, store_path, token) == (0, "password reset\n", "")
+
+
+def test_fr035_second_use_refused(run, store_path):
+    """A redeemed token is refused on its second use (FR-035, SC-013)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    assert _attempt(run, store_path, token, NEW_PASSWORD) == (
+        0,
+        "password reset\n",
+        "",
+    )
+    assert _attempt(run, store_path, token, OTHER_PASSWORD) == REFUSED
+    # The password the first redemption set still verifies.
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+    assert run(["--store", store_path, "login", "alice"], lines(OTHER_PASSWORD))[0] == 1
+
+
+@pytest.mark.slow
+def test_fr030_expired_token_refused(run, store_path):
+    """A token issued for 1 s is refused once more than 1 s has passed (FR-030)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice", ttl="1")
+    expiry = _reset_of(store_path)["expires_ms"]
+    # Wait past the recorded instant rather than for a fixed interval, so the
+    # test is about the expiry and not about this host's speed.
+    while int(time.time() * 1000) <= expiry:
+        time.sleep(0.2)
+
+    assert _attempt(run, store_path, token) == REFUSED
+    # The expired material is left in place -- never swept -- and the original
+    # password still works.
+    assert _reset_of(store_path) is not None
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+
+def test_fr029_replaced_token_refused(run, store_path):
+    """A token a later issuance replaced is refused; the newer one works."""
+    _register(run, store_path)
+    first = issue_token(store_path, "alice")
+    second = issue_token(store_path, "alice")
+    assert first != second
+
+    assert _attempt(run, store_path, first) == REFUSED
+    assert _attempt(run, store_path, second, NEW_PASSWORD) == (
+        0,
+        "password reset\n",
+        "",
+    )
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+
+
+def test_scenario_6_token_dead_after_passwd(run, store_path):
+    """A successful ``passwd`` leaves the token refused (scenario 2.6, A-019)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    )[0] == 0
+    assert _attempt(run, store_path, token, OTHER_PASSWORD) == REFUSED
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+
+
+def test_scenario_7_empty_token_line(run, store_path):
+    """An empty token line is a wrong token, not a missing input (scenario 2.7)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    # The line is present and empty: two lines were supplied, so this is a
+    # refusal and not the status-2 "missing reset input".
+    assert _attempt(run, store_path, "") == REFUSED
+    assert _attempt(run, store_path, token) == (0, "password reset\n", "")
+
+
+def test_fr039_wrong_token_does_not_increment_count(run, store_path):
+    """Guesses neither raise the failure count nor are slowed by it (FR-039)."""
+    _register(run, store_path)
+    # Start from a non-zero count, so an accidental reset to 0 would show too.
+    for _ in range(3):
+        assert run(
+            ["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD)
+        )[0] == 1
+    assert failed_logins(store_path, "alice") == 3
+    issue_token(store_path, "alice")
+
+    for _ in range(10):
+        assert _attempt(run, store_path, WRONG_TOKEN) == REFUSED
+        assert failed_logins(store_path, "alice") == 3
+
+    # The account is not locked by any number of token guesses.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+
+
+def test_scenario_9_token_of_another_account_refused(run, store_path):
+    """``bob``'s token is refused for ``alice``, who has one of her own (2.9)."""
+    _register(run, store_path, "alice", PASSWORD)
+    _register(run, store_path, "bob", OTHER_PASSWORD)
+    alice_token = issue_token(store_path, "alice")
+    bob_token = issue_token(store_path, "bob")
+
+    assert _attempt(run, store_path, bob_token, username="alice") == REFUSED
+    assert _attempt(run, store_path, alice_token, username="bob") == REFUSED
+    # Both are still outstanding against their own accounts.
+    assert _attempt(run, store_path, alice_token, MIN_PASSWORD, "alice") == (
+        0,
+        "password reset\n",
+        "",
+    )
+    assert _attempt(run, store_path, bob_token, MIN_PASSWORD, "bob") == (
+        0,
+        "password reset\n",
+        "",
+    )
+
+
+def test_fr037_current_password_not_accepted_as_token(run, store_path):
+    """The current password is never accepted in place of a token (FR-037, 2.10)."""
+    _register(run, store_path)
+    issue_token(store_path, "alice")
+    assert _attempt(run, store_path, PASSWORD, NEW_PASSWORD) == REFUSED
+    # Nor with no token outstanding at all.
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, OTHER_PASSWORD)
+    )[0] == 0
+    assert _attempt(run, store_path, OTHER_PASSWORD, NEW_PASSWORD) == REFUSED
+    assert run(["--store", store_path, "login", "alice"], lines(OTHER_PASSWORD))[0] == 0
+
+
+# --- FR-027 / SC-021: a refusal changes nothing ------------------------------
+
+
+def test_fr027_store_byte_identical_after_each_failure(run, store_path):
+    """Every refused attempt leaves the store byte-identical (FR-027, SC-021)."""
+    _register(run, store_path, "alice", PASSWORD)
+    _register(run, store_path, "bob", OTHER_PASSWORD)
+    issue_token(store_path, "alice")
+    before = store_path.read_bytes()
+
+    attempts = (
+        WRONG_TOKEN,
+        SYNTHETIC_TOKEN,
+        "",
+        PASSWORD,
+        "z" * 22,
+        "\t",
+    )
+    for value in attempts:
+        assert _attempt(run, store_path, value) == REFUSED, value
+        assert store_path.read_bytes() == before, value
+
+    # Including an attempt against the account with no token at all.
+    assert _attempt(run, store_path, WRONG_TOKEN, username="bob") == REFUSED
+    assert store_path.read_bytes() == before
