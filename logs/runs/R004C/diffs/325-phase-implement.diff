     assert sorted(read_store(store_path)["accounts"]) == sorted(names)
     assert store_path.stat().st_mode & 0o777 == 0o600
+
+
+# --- feature 002: the reset path under interleaving --------------------------
+
+
+@pytest.mark.slow
+def test_sc023_simultaneous_redemption_one_success(run, store_path):
+    """Two simultaneous redemptions of one token: exactly one succeeds (SC-023).
+
+    One token can never set two passwords, because verification, the password
+    replacement and the token's consumption all happen inside the one
+    ``flock``-held critical section -- so the loser of the race finds the key
+    already gone and takes the ordinary no-token path (FR-035, SR-016).
+    """
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    children = [
+        (
+            _launch(["--store", store_path, "reset", "alice"], None),
+            lines(token, password),
+        )
+        for password in (NEW_PASSWORD, OTHER_PASSWORD)
+    ]
+    results = _drain(children)
+
+    statuses = sorted(status for status, _, _ in results)
+    assert statuses == [0, 1], results
+    successes = [r for r in results if r[0] == 0]
+    failures = [r for r in results if r[0] == 1]
+    assert successes[0] == (0, "password reset\n", "")
+    assert failures[0] == (1, "", "invalid token\n")
+
+    # The live password is the one the single success set -- not a mixture, and
+    # not both.
+    winner = NEW_PASSWORD if results[0][0] == 0 else OTHER_PASSWORD
+    loser = OTHER_PASSWORD if winner == NEW_PASSWORD else NEW_PASSWORD
+    assert run(["--store", store_path, "login", "alice"], lines(winner)) == (
+        0,
+        "ok\n",
+        "",
+    )
+    assert run(["--store", store_path, "login", "alice"], lines(loser))[0] == 1
+    # The token was consumed exactly once.
+    assert "reset" not in read_store(store_path)["accounts"]["alice"]
+
+
+@pytest.mark.slow
+def test_sr016_concurrent_issuance_leaves_one_token(run, store_path):
+    """Simultaneous issuances leave exactly one outstanding token (FR-029, A-015).
+
+    The issuances serialise on the same lock and each assigns the single
+    ``reset`` key, so the last writer's token is the only one that can be
+    redeemed -- two tokens are never outstanding for one account.
+    """
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+
+    children = [
+        (_launch(["--store", store_path, "reset-token", "alice"], None), None)
+        for _ in range(6)
+    ]
+    results = _drain(children)
+
+    assert [status for status, _, _ in results] == [0] * 6, results
+    tokens = [out[:-1] for _, out, _ in results]
+    assert len(set(tokens)) == 6, tokens
+
+    # Exactly one ``reset`` key, so exactly one token survives, and exactly one
+    # of the six issued values is the one it belongs to.
+    record = read_store(store_path)["accounts"]["alice"]
+    assert "reset" in record
+    accepted = []
+    for token in tokens:
+        status, _, _ = run(
+            ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+        )
+        if status == 0:
+            accepted.append(token)
+            break
+        assert status == 1
+    assert len(accepted) == 1, (accepted, tokens)
diff --git a/tests/test_crash_safety.py b/tests/test_crash_safety.py
index db66099..7658124 100644
--- a/tests/test_crash_safety.py
+++ b/tests/test_crash_safety.py
@@ -141,3 +141,100 @@ def test_fr009_store_old_or_new_never_mixed(run, store_path):
         assert present == [store_path.name], (trial, present)
 
     assert 0 < landed < TRIALS, landed
+
+
+# --- feature 002: SC-024, killing an issuance or a redemption ----------------
+
+
+def _kill_during(store_path, argv, payload, delay):
+    """Start one invocation, feed it ``payload``, and SIGKILL it after ``delay``."""
+    child = subprocess.Popen(
+        command(["--store", store_path, *argv]),
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        env=child_env(),
+    )
+    child.stdin.write(payload)
+    child.stdin.flush()
+    child.stdin.close()
+    try:
+        child.wait(timeout=delay)
+    except subprocess.TimeoutExpired:
+        child.kill()
+        child.wait(timeout=60)
+    out = child.stdout.read()
+    child.stdout.close()
+    child.stderr.close()
+    return child.returncode, out
+
+
+@pytest.mark.slow
+def test_sc024_sigkill_during_issue_and_redeem(run, store_path):
+    """A kill during issuance or redemption leaves a store that still works.
+
+    SC-024: never a mixture.  Every account the store held before the kill
+    still parses and still verifies a password afterwards -- either the one it
+    had or the one the interrupted redemption was setting, never neither.
+    """
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD))[0] == 0
+    assert run(["--store", store_path, "register", "bob_42"], lines(PASSWORD))[0] == 0
+    accounts = ["alice", "bob_42"]
+
+    generator = random.Random(20261105)
+
+    # --- issuance -----------------------------------------------------------
+    issues_landed = 0
+    for trial in range(TRIALS):
+        delay = generator.uniform(0.0, 0.8)
+        _kill_during(store_path, ["reset-token", "alice"], "", delay)
+
+        document = _store_is_intact(store_path, accounts)
+        record = document["accounts"]["alice"]
+        # Either the token was recorded whole or not at all.
+        if "reset" in record:
+            issues_landed += 1
+            assert sorted(record["reset"]) == [
+                "dklen", "expires_ms", "hash", "kdf", "n", "p", "r", "salt",
+            ], (trial, record["reset"])
+        # Both passwords still verify, whatever happened.
+        for name in accounts:
+            assert run(["--store", store_path, "login", name], lines(PASSWORD)) == (
+                0,
+                "ok\n",
+                "",
+            ), (trial, name)
+        present = sorted(p.name for p in store_path.parent.iterdir())
+        assert present == [store_path.name], (trial, present)
+    assert issues_landed > 0, "no trial reached the issuance write"
+
+    # --- redemption ---------------------------------------------------------
+    current = PASSWORD
+    redeems_landed = 0
+    for trial in range(TRIALS):
+        # A fresh token for each trial, issued without interruption.
+        status, out, _ = run(["--store", store_path, "reset-token", "alice"], None)
+        assert status == 0
+        token = out[:-1]
+
+        delay = generator.uniform(0.0, 1.2)
+        _kill_during(
+            store_path, ["reset", "alice"], lines(token, NEW_PASSWORD), delay
+        )
+
+        _store_is_intact(store_path, accounts)
+        old = run(["--store", store_path, "login", "alice"], lines(current))[0]
+        new = run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0]
+        # Fully old or fully new, never neither and never a mixture.
+        assert {old, new} in ({0, 1}, {0}), (trial, old, new)
+        assert run(["--store", store_path, "login", "bob_42"], lines(PASSWORD))[0] == 0
+
+        if new == 0 and current != NEW_PASSWORD:
+            redeems_landed += 1
+            current = NEW_PASSWORD
+        assert run(["--store", store_path, "unlock", "alice"], None)[0] == 0
+        present = sorted(p.name for p in store_path.parent.iterdir())
+        assert present == [store_path.name], (trial, present)
+
+    assert redeems_landed > 0, "no trial reached the redemption write"
