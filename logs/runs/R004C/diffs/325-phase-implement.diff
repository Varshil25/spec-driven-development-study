@@ -0,0 +1,704 @@
+"""The nine security requirements of feature 002, as negatives and positives.
+
+SR-010 … SR-018 plus SC-015, SC-016 and SC-018.  Every token value is read at
+runtime through ``conftest.issue_token``; the only token-shaped literals in the
+repository are ``conftest``'s synthetic ones, which have never been issued
+(SR-013, SC-015).
+"""
+
+import json
+import os
+import stat
+import string
+import time
+
+import pytest
+
+from conftest import (
+    NEW_PASSWORD,
+    OTHER_PASSWORD,
+    PASSWORD,
+    REPO_ROOT,
+    SYNTHETIC_TOKEN,
+    WRONG_TOKEN,
+    issue_token,
+    lines,
+    read_store,
+    write_store,
+)
+
+# The URL-safe base64 alphabet, assembled rather than spelled out: a literal
+# run of the lowercase letters would collide with ``conftest.TIMING_PASSWORD``
+# and so trip the suite's own secrets-hygiene scan.
+TOKEN_CHARS = set(string.ascii_letters + string.digits + "-_")
+
+# The delivered tree, as ``test_security.py`` defines it, plus this feature's
+# own documents.  ``logs/`` is the study harness's transcripts and ``.git`` its
+# history; neither is part of the delivered feature.
+SCANNED_PATHS = (
+    "src",
+    "tests",
+    "pytest.ini",
+    "requirements-dev.txt",
+    "specs/001-user-accounts-cli",
+    "specs/002-password-reset",
+)
+
+
+def _register(run, store_path, username="alice", password=[REDACTED:assigned_secret]):
+    assert run(["--store", store_path, "register", username], lines(password))[0] == 0
+
+
+def _scanned_files():
+    for entry in SCANNED_PATHS:
+        target = REPO_ROOT / entry
+        if target.is_file():
+            yield target
+        for path in sorted(target.rglob("*")) if target.is_dir() else ():
+            if path.is_file() and "__pycache__" not in path.parts:
+                yield path
+
+
+def _reset_of(store_path, username="alice"):
+    return read_store(store_path)["accounts"][username].get("reset")
+
+
+# --- SR-013: the token is never stored, logged or echoed ---------------------
+
+
+def test_sr013_token_absent_from_store_bytes(run, store_path):
+    """No issued token appears anywhere in the store file (SR-013, SC-015)."""
+    _register(run, store_path)
+    tokens = [issue_token(store_path, "alice") for _ in range(3)]
+    raw = store_path.read_bytes()
+    for token in tokens:
+        assert token.encode("utf-8") not in raw, token
+        # Nor any substantial fragment of it, which would be a partial leak.
+        assert token[:12].encode("utf-8") not in raw, token
+
+    # Still absent after it has been redeemed.
+    final = issue_token(store_path, "alice")
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(final, NEW_PASSWORD)
+    )[0] == 0
+    assert final.encode("utf-8") not in store_path.read_bytes()
+
+
+def test_sr013_fresh_salt_per_issuance(run, store_path):
+    """Each issuance draws its own salt, never the account's password salt."""
+    _register(run, store_path)
+    password_salt = read_store(store_path)["accounts"]["alice"]["salt"]
+
+    salts = []
+    for _ in range(5):
+        issue_token(store_path, "alice")
+        reset = _reset_of(store_path)
+        salts.append(reset["salt"])
+        assert reset["salt"] != password_salt
+        assert reset["hash"] != read_store(store_path)["accounts"]["alice"]["hash"]
+    assert len(set(salts)) == len(salts), salts
+
+
+def test_sr013_token_digest_uses_current_parameters(run, store_path):
+    """The token digest is held at the password work factor, not a cheaper one."""
+    _register(run, store_path)
+    issue_token(store_path, "alice")
+    reset = _reset_of(store_path)
+    assert reset["kdf"] == "scrypt"
+    assert reset["n"] == 131072
+    assert reset["r"] == 8
+    assert reset["p"] == 1
+    assert reset["dklen"] == 32
+    # The same parameters the account's own password is held at (SR-004).
+    record = read_store(store_path)["accounts"]["alice"]
+    assert {k: reset[k] for k in ("kdf", "n", "r", "p", "dklen")} == {
+        k: record[k] for k in ("kdf", "n", "r", "p", "dklen")
+    }
+
+
+def test_sr013_no_token_literal_in_repo_fixtures():
+    """The suite's token-shaped literals occur only where they are defined."""
+    conftest = REPO_ROOT / "tests" / "conftest.py"
+    for literal in (SYNTHETIC_TOKEN, WRONG_TOKEN):
+        offenders = [
+            path
+            for path in _scanned_files()
+            if literal in path.read_text(encoding="utf-8", errors="replace")
+        ]
+        assert offenders == [conftest], (literal, offenders)
+
+
+def test_sc015_token_in_no_temp_file_or_stderr(run, store_path, tmp_path):
+    """A token reaches one stdout line and nothing else in the filesystem."""
+    _register(run, store_path)
+    status, out, err = run(["--store", store_path, "reset-token", "alice"], None)
+    assert status == 0
+    token = out[:-1]
+    assert err == ""
+
+    # Only the store exists in the directory: no spool, no sidecar, no leftover
+    # temporary file.
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["accounts.store"]
+    for path in tmp_path.rglob("*"):
+        if path.is_file():
+            assert token.encode("utf-8") not in path.read_bytes(), path
+
+
+# --- SR-014: CSPRNG, entropy, constant-time comparison -----------------------
+
+
+def test_sr014_token_entropy_is_at_least_128_bits(run, store_path):
+    """22 characters of a 64-symbol alphabet is 128 bits of entropy (SR-014)."""
+    _register(run, store_path)
+    for _ in range(5):
+        token=[REDACTED:assigned_secret](store_path, "alice")
+        assert len(token) == 22, token
+        assert set(token) <= TOKEN_CHARS, token
+    # The mechanism itself: 16 random bytes, rendered unpadded.
+    from accounts import crypto
+
+    assert crypto.TOKEN_BYTES == 16
+    assert crypto.TOKEN_BYTES * 8 >= 128
+
+
+@pytest.mark.slow
+def test_sr014_ten_thousand_tokens_distinct():
+    """10 000 tokens are all different and all well-formed (SC-016)."""
+    from accounts import crypto
+
+    tokens = {crypto.new_token() for _ in range(10000)}
+    assert len(tokens) == 10000
+    for token in tokens:
+        assert len(token) == 22
+        assert set(token) <= TOKEN_CHARS
+
+
+def test_sr014_package_never_imports_random():
+    """No shipped module reaches for a non-cryptographic generator (SR-014)."""
+    for path in sorted((REPO_ROOT / "src").rglob("*.py")):
+        text = path.read_text(encoding="utf-8")
+        assert "import random" not in text, path
+        assert "from random" not in text, path
+    # The generator in use is the ``secrets`` module's, which draws from the
+    # operating system's cryptographically secure source.
+    from accounts import crypto
+
+    assert crypto.new_token.__globals__["secrets"].__name__ == "secrets"
+
+
+def test_sr014_token_compared_in_constant_time(monkeypatch, store_path):
+    """Token verification routes its comparison through ``hmac.compare_digest``."""
+    import hmac
+
+    from accounts import cli, crypto
+
+    calls = []
+    real = hmac.compare_digest
+
+    def recording(left, right):
+        calls.append((len(left), len(right)))
+        return real(left, right)
+
+    monkeypatch.setattr(crypto.hmac, "compare_digest", recording)
+    token=[REDACTED:assigned_secret]()
+    reset = cli._new_reset(token, 900)
+    assert cli._reset_is_valid(token, {"reset": reset}, 0) is True
+    assert calls == [(32, 32)], calls
+
+    calls.clear()
+    assert cli._reset_is_valid(WRONG_TOKEN, {"reset": reset}, 0) is False
+    assert calls == [(32, 32)], calls
+
+
+# --- SR-011: nothing printed can forge a line or a control sequence ----------
+
+
+def test_sr011_token_alphabet_is_safe_printable_ascii(run, store_path):
+    """The token alphabet is ``[A-Za-z0-9_-]`` and nothing else (SR-011)."""
+    _register(run, store_path)
+    seen = set()
+    for _ in range(20):
+        seen |= set(issue_token(store_path, "alice"))
+    assert seen <= TOKEN_CHARS, seen - TOKEN_CHARS
+    # No whitespace, quote, backslash, newline or escape introducer can occur.
+    assert not (seen & set(" \t\r\n\"'\\\x1b/+="))
+
+
+def test_sr011_token_output_is_exactly_one_line(run, store_path):
+    """stdout holds one line: no second line can be forged into it (SR-011)."""
+    _register(run, store_path)
+    status, out, err = run(["--store", store_path, "reset-token", "alice"], None)
+    assert (status, err) == (0, "")
+    assert out.count("\n") == 1
+    assert out.endswith("\n")
+    assert out[:-1].count("\n") == 0
+    assert "\r" not in out
+
+
+# --- SR-017: least-privilege files, and no other file written ----------------
+
+
+def test_sr017_store_mode_600_after_issue_and_redeem(run, store_path):
+    """The store stays owner-only across both new writes (SR-017)."""
+    _register(run, store_path)
+    assert stat.S_IMODE(os.stat(store_path).st_mode) == 0o600
+
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    assert stat.S_IMODE(os.stat(store_path).st_mode) == 0o600
+
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )[0] == 0
+    assert stat.S_IMODE(os.stat(store_path).st_mode) == 0o600
+
+
+def test_sr017_no_sidecar_spool_or_log_created(run, store_path, tmp_path):
+    """Neither operation writes any file but the store (SR-017, A-027)."""
+    _register(run, store_path)
+    expected = ["accounts.store"]
+    assert sorted(p.name for p in tmp_path.iterdir()) == expected
+
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    assert sorted(p.name for p in tmp_path.iterdir()) == expected
+
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )[0] == 0
+    assert sorted(p.name for p in tmp_path.iterdir()) == expected
+
+    # Including on the failure paths.
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(WRONG_TOKEN, OTHER_PASSWORD)
+    )[0] == 1
+    assert run(["--store", store_path, "reset-token", "nobody"], None)[0] == 3
+    assert sorted(p.name for p in tmp_path.iterdir()) == expected
+
+
+# --- SR-018: every refusal is indistinguishable ------------------------------
+
+
+def _five_refusal_families(run, store_path):
+    """Set up and attempt all five ways a token can be refused (SC-018).
+
+    Returns one ``(status, stdout, stderr)`` triple per family, in the order the
+    contract lists them.  The expired family's recorded instant is moved into
+    the past rather than waited out, so this test needs no sleep; the refusal
+    with a real elapsed validity is
+    ``test_reset_invalid_token.py::test_fr030_expired_token_refused``.
+    """
+    answers = {}
+
+    # 1. an account for which no token was ever issued.
+    _register(run, store_path, "never", PASSWORD)
+    answers["never_issued"] = run(
+        ["--store", store_path, "reset", "never"], lines(WRONG_TOKEN, NEW_PASSWORD)
+    )
+
+    # 2. a value that was never issued, against an account that has a token.
+    _register(run, store_path, "wrongval", PASSWORD)
+    issue_token(store_path, "wrongval")
+    answers["wrong_value"] = run(
+        ["--store", store_path, "reset", "wrongval"], lines(WRONG_TOKEN, NEW_PASSWORD)
+    )
+
+    # 3. a token already redeemed.
+    _register(run, store_path, "redeemed", PASSWORD)
+    used = issue_token(store_path, "redeemed")
+    assert run(
+        ["--store", store_path, "reset", "redeemed"], lines(used, NEW_PASSWORD)
+    )[0] == 0
+    answers["redeemed"] = run(
+        ["--store", store_path, "reset", "redeemed"], lines(used, OTHER_PASSWORD)
+    )
+
+    # 4. a token replaced by a later issuance.
+    _register(run, store_path, "replaced", PASSWORD)
+    first = issue_token(store_path, "replaced")
+    issue_token(store_path, "replaced")
+    answers["replaced"] = run(
+        ["--store", store_path, "reset", "replaced"], lines(first, NEW_PASSWORD)
+    )
+
+    # 5. a token whose validity has elapsed.
+    _register(run, store_path, "expired", PASSWORD)
+    stale = issue_token(store_path, "expired")
+    document = read_store(store_path)
+    document["accounts"]["expired"]["reset"]["expires_ms"] = 1
+    write_store(store_path, document["accounts"], version=document["version"])
+    answers["expired"] = run(
+        ["--store", store_path, "reset", "expired"], lines(stale, NEW_PASSWORD)
+    )
+    return answers
+
+
+def test_sr018_all_refusal_paths_byte_identical(run, store_path):
+    """All five refusal families give one byte-identical answer (SR-018, SC-018)."""
+    answers = _five_refusal_families(run, store_path)
+    assert len(answers) == 5
+    for family, answer in answers.items():
+        assert answer == (1, "", "invalid token\n"), (family, answer)
+    # Stated as sameness as well as as a value: one distinct answer in total.
+    assert len(set(answers.values())) == 1, answers
+
+
+def test_sr018_refusal_timing_parity(run, store_path):
+    """No refusal family can be told from another by stopwatch (SR-018, SC-018).
+
+    Each spends exactly one scrypt derivation, so the families must not separate
+    by a derivation's worth of wall clock.  Compared as the 001 timing tests are:
+    the minimum of repeated runs, against a fraction of the measurement itself,
+    so the assertion does not depend on this host's speed.
+    """
+
+    def elapsed(argv, stdin):
+        start = time.monotonic()
+        answer = run(argv, stdin)
+        assert answer == (1, "", "invalid token\n"), answer
+        return time.monotonic() - start
+
+    _register(run, store_path, "withtok", PASSWORD)
+    issue_token(store_path, "withtok")
+    _register(run, store_path, "notok", PASSWORD)
+
+    wrong_value = min(
+        elapsed(
+            ["--store", store_path, "reset", "withtok"],
+            lines(WRONG_TOKEN, NEW_PASSWORD),
+        )
+        for _ in range(2)
+    )
+    never_issued = min(
+        elapsed(
+            ["--store", store_path, "reset", "notok"],
+            lines(WRONG_TOKEN, NEW_PASSWORD),
+        )
+        for _ in range(2)
+    )
+    assert abs(wrong_value - never_issued) < 0.5 * min(wrong_value, never_issued), (
+        wrong_value,
+        never_issued,
+    )
+    # And neither is a short-circuit: both cost about a derivation, so neither
+    # can be the near-instant answer a missing check would give.
+    assert min(wrong_value, never_issued) > 0.05, (wrong_value, never_issued)
+
+
+def test_sr018_no_secret_material_in_either_stream(run, store_path):
+    """No token, digest, salt or password reaches a stream on these paths."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    reset = _reset_of(store_path)
+    record = read_store(store_path)["accounts"]["alice"]
+    needles = [
+        reset["salt"],
+        reset["hash"],
+        record["salt"],
+        record["hash"],
+        str(reset["expires_ms"]),
+        PASSWORD,
+        NEW_PASSWORD,
+    ]
+
+    cases = (
+        (["reset", "alice"], lines(WRONG_TOKEN, NEW_PASSWORD)),
+        (["reset", "alice"], lines(PASSWORD, NEW_PASSWORD)),
+        (["reset", "alice"], lines(token, "short")),
+        (["reset", "nobody"], lines(token, NEW_PASSWORD)),
+        (["reset-token", "nobody"], None),
+        (["reset-token", "alice", "--ttl", "0"], None),
+        (["reset", "alice"], lines(token, NEW_PASSWORD)),
+    )
+    for argv, stdin in cases:
+        _, out, err = run(["--store", store_path, *argv], stdin)
+        for needle in needles:
+            assert needle not in out, (argv, needle)
+            assert needle not in err, (argv, needle)
+
+
+def test_sr018_token_only_on_reset_token_stdout_on_success(run, store_path):
+    """The token is written by one command, on success, to stdout only."""
+    _register(run, store_path)
+    status, out, err = run(["--store", store_path, "reset-token", "alice"], None)
+    assert status == 0
+    token = out[:-1]
+    assert err == ""
+
+    # No other invocation echoes it, on any path.
+    cases = (
+        (["reset", "alice"], lines(token, "short")),
+        (["reset", "alice"], lines(WRONG_TOKEN, NEW_PASSWORD)),
+        (["reset", "nobody"], lines(token, NEW_PASSWORD)),
+        (["login", "alice"], lines(token)),
+        (["reset", "alice"], lines(token, NEW_PASSWORD)),
+        (["reset", "alice"], lines(token, OTHER_PASSWORD)),
+    )
+    for argv, stdin in cases:
+        _, out, err = run(["--store", store_path, *argv], stdin)
+        assert token not in out, argv
+        assert token not in err, argv
+
+    # And a failed issuance prints no token at all.
+    _, out, err = run(["--store", store_path, "reset-token", "nobody"], None)
+    assert out == ""
+
+
+def test_sr018_no_traceback_on_any_new_failure_path(run, store_path):
+    """No failure path of either new operation lets a traceback escape (SR-018)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    malformed = store_path.parent / "malformed.store"
+    malformed.write_text('{"version":1,"accounts":{"alice":{"reset":{}}}}')
+
+    cases = (
+        (["--store", store_path, "reset", "alice"], lines(WRONG_TOKEN, NEW_PASSWORD)),
+        (["--store", store_path, "reset", "alice"], None),
+        (["--store", store_path, "reset", "alice"], lines(token)),
+        (["--store", store_path, "reset", "alice"], b"\xff\xfe\n" + b"pw\n"),
+        (["--store", store_path, "reset", "ab"], lines(token, NEW_PASSWORD)),
+        (["--store", store_path, "reset-token", "alice", "--ttl", "x"], None),
+        (["--store", store_path, "reset-token", "ab"], None),
+        (["--store", malformed, "reset", "alice"], lines(token, NEW_PASSWORD)),
+        (["--store", malformed, "reset-token", "alice"], None),
+        (["--store", store_path.parent, "reset-token", "alice"], None),
+    )
+    for argv, stdin in cases:
+        status, out, err = run(argv, stdin)
+        assert status in (1, 2, 3, 5), (argv, status, err)
+        assert "Traceback" not in err, (argv, err)
+        assert err.count("\n") == 1, (argv, err)
+        assert out == "", (argv, out)
+
+
+def test_sr011_control_chars_in_token_line_not_echoed(run, store_path):
+    """Nothing from the supplied token line reaches a stream (SR-011, SR-018)."""
+    _register(run, store_path)
+    issue_token(store_path, "alice")
+    hostile = (
+        "\x1b[31mred",
+        "tok\x07bell",
+        "tok\x00nul",
+        "../../etc/passwd",
+        "'; DROP TABLE accounts; --",
+        "%s%n",
+        "{{7*7}}",
+    )
+    for value in hostile:
+        status, out, err = run(
+            ["--store", store_path, "reset", "alice"], lines(value, NEW_PASSWORD)
+        )
+        assert (status, out, err) == (1, "", "invalid token\n"), (value, err)
+
+
+# --- SR-012: no new path is derived from input -------------------------------
+
+
+def test_sr010_reset_field_allowlist(run, store_path):
+    """The record's field set stays a closed allow-list (SR-010)."""
+    from conftest import reset_material, synthetic_record
+
+    # The two accepted field sets: the eight keys, or those eight plus `reset`.
+    for record in (
+        synthetic_record(),
+        dict(synthetic_record(), reset=reset_material()),
+    ):
+        write_store(store_path, {"alice": record})
+        # Loads: the answer is a credential failure, not a malformed store.
+        assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 1
+
+    # Anything else is malformed -- a ninth key, or a plausible near-miss name.
+    for extra in ("reset_token", "resets", "reset_expires_ms", "token", "version"):
+        write_store(
+            store_path,
+            {"alice": dict(synthetic_record(), reset=reset_material(), **{extra: 1})},
+        )
+        status, out, err = run(["--store", store_path, "login", "alice"], lines(PASSWORD))
+        assert (status, out) == (5, ""), (extra, status, out, err)
+        assert "is malformed" in err, (extra, err)
+
+    # And a required key removed in favour of `reset` is still malformed: the
+    # set is not a minimum.
+    record = dict(synthetic_record(), reset=reset_material())
+    del record["failed_logins"]
+    write_store(store_path, {"alice": record})
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 5
+
+
+def test_sr010_malformed_expires_ms_is_status_5_not_unexpired(run, store_path):
+    """The trap case: a malformed expiry must never read as "not expired".
+
+    ``json`` accepts and emits ``NaN``, and every comparison with ``NaN`` is
+    false -- so a floating-point expiry field would make a hand-edited ``NaN``
+    read as *never expiring*, which is exactly the silent wrong answer SR-010
+    forbids.  The field is an integer checked with ``type(v) is int`` and a
+    range, which has no such value: the store is refused instead.
+    """
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    document = read_store(store_path)
+
+    # Establish the premise rather than assuming it: `NaN` survives a JSON
+    # round trip, and comparing it would answer "not expired".
+    assert json.loads("NaN") != json.loads("NaN")
+    assert not (float("nan") < 1)
+
+    for broken in (float("nan"), float("inf"), float("-inf")):
+        document["accounts"]["alice"]["reset"]["expires_ms"] = broken
+        write_store(store_path, document["accounts"])
+        before = store_path.read_bytes()
+        # The *real* token, which would otherwise be accepted: the answer is
+        # the malformed store, not a successful reset.
+        status, out, err = run(
+            ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+        )
+        assert (status, out) == (5, ""), (broken, status, out, err)
+        assert "is malformed" in err, (broken, err)
+        assert store_path.read_bytes() == before, broken
+
+    # A missing expiry is likewise refused, not defaulted to "no expiry".
+    del document["accounts"]["alice"]["reset"]["expires_ms"]
+    write_store(store_path, document["accounts"])
+    status, out, err = run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )
+    assert (status, out) == (5, "")
+    assert "is malformed" in err
+
+
+def test_sr010_invalid_reset_never_repaired_or_skipped(run, store_path):
+    """An invalid reset object is refused whole, never patched up (SR-010)."""
+    from conftest import reset_material, synthetic_record
+
+    write_store(
+        store_path,
+        {
+            "alice": dict(synthetic_record(), reset=reset_material(n=3)),
+            "bob": synthetic_record(),
+        },
+    )
+    before = store_path.read_bytes()
+
+    # Every operation fails, including ones that touch only the valid account,
+    # and including the ones that would otherwise rewrite the file.
+    for argv, stdin in (
+        (["login", "bob"], lines(PASSWORD)),
+        (["unlock", "bob"], None),
+        (["register", "carol"], lines(PASSWORD)),
+        (["passwd", "bob"], lines(PASSWORD, NEW_PASSWORD)),
+        (["delete", "bob"], lines(PASSWORD)),
+        (["reset-token", "bob"], None),
+        (["reset", "bob"], lines(WRONG_TOKEN, NEW_PASSWORD)),
+    ):
+        status, out, err = run(["--store", store_path, *argv], stdin)
+        assert (status, out) == (5, ""), (argv, status, out, err)
+        assert "is malformed" in err, (argv, err)
+
+    # Not repaired, not partially loaded, not rewritten: byte for byte as it
+    # was, with the invalid material still in place.
+    assert store_path.read_bytes() == before
+    assert read_store(store_path)["accounts"]["alice"]["reset"]["n"] == 3
+
+
+def test_sr015_reset_material_is_fixed_size(run, store_path):
+    """Reset material is a fixed 174 bytes per record (FR-043, SR-015).
+
+    Independent of the token, the username and how many times a token has been
+    issued, so no account record can grow without limit and the existing store
+    caps still bound the file.  The 174 bytes are the field's whole contribution
+    to the serialised record: the 165-byte object plus its ``,"reset":`` key.
+    """
+    sizes = set()
+    for username in ("abc", "alice", "u" * 32):
+        _register(run, store_path, username, PASSWORD)
+        without = store_path.stat().st_size
+        issue_token(store_path, username)
+        sizes.add(store_path.stat().st_size - without)
+
+        # Re-issuing does not grow it either: one key, replaced in place.
+        for _ in range(3):
+            issued = store_path.stat().st_size
+            issue_token(store_path, username)
+            assert store_path.stat().st_size == issued, username
+
+    assert sizes == {174}, sizes
+
+    # The documented worst case stays inside the existing 8 MiB cap.
+    assert 10000 * 174 + 1700027 == 3440027
+    assert 3440027 < 8388608
+
+
+def test_sr012_no_temp_file_survives_a_failed_reset(
+    monkeypatch, capsys, run, store_path, tmp_path
+):
+    """A failed write on either new operation leaves no temporary behind (SR-012).
+
+    The write is made to fail in-process, as ``test_security.py``'s SR-003 pair
+    does: the suite runs with enough privilege that a mode-based failure is not
+    reachable, and a full device cannot be arranged.  The store and the token
+    are still produced by the real executable, so only the failure itself is
+    synthetic.
+    """
+    import io
+
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    before = store_path.read_bytes()
+
+    from accounts import cli as cli_module
+    from accounts import store as store_module
+
+    def failing_replace(source, target):
+        raise OSError(28, "No space left on device")
+
+    class FakeStdin:
+        def __init__(self, payload):
+            self.buffer = io.BytesIO(payload)
+
+    monkeypatch.setattr(store_module.os, "replace", failing_replace)
+
+    # Redemption: the token was accepted, so this fails at the write itself.
+    monkeypatch.setattr(
+        cli_module.sys,
+        "stdin",
+        FakeStdin(("%s\n%s\n" % (token, NEW_PASSWORD)).encode("utf-8")),
+    )
+    assert cli_module.main(["--store", str(store_path), "reset", "alice"]) == 5
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.startswith("error: cannot write store ")
+    assert "No space left on device" in captured.err
+    assert "Traceback" not in captured.err
+
+    # Issuance fails the same way.
+    monkeypatch.setattr(cli_module.sys, "stdin", FakeStdin(b""))
+    assert cli_module.main(["--store", str(store_path), "reset-token", "alice"]) == 5
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.startswith("error: cannot write store ")
+
+    monkeypatch.undo()
+
+    # Nothing survives but the untouched store: no temporary, no partial write.
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["accounts.store"]
+    assert store_path.read_bytes() == before
+    # And no token value reached any file that does survive.
+    assert token.encode("utf-8") not in store_path.read_bytes()
+
+
+def test_sr012_no_new_path_derived_from_input(run, store_path, tmp_path):
+    """No filesystem path comes from a username, a token or a ``--ttl`` (SR-012)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    before = sorted(p.name for p in tmp_path.iterdir())
+
+    # Inputs that would be dangerous if any of them reached a path.
+    assert run(["--store", store_path, "reset-token", "alice_etc_passwd"], None)[0] == 3
+    assert run(
+        ["--store", store_path, "reset", "alice"],
+        lines("../../etc/passwd", OTHER_PASSWORD),
+    )[0] == 1
+    assert run(
+        ["--store", store_path, "reset-token", "alice", "--ttl", "../60"], None
+    )[0] == 2
+
+    assert sorted(p.name for p in tmp_path.iterdir()) == before
+    assert token != ""
