+    reset.update(overrides)
+    return reset
+
+
+def issue_token(store_path, username, ttl=None):
+    """Issue a real token through ``reset-token`` and return its value.
+
+    The single place in the suite where an issued token value is obtained, so
+    no such value ever becomes a literal in the repository (SR-013, SC-015).
+    Asserts the issuance succeeded, because every caller depends on it.
+    """
+    args = ["--store", store_path, "reset-token", username]
+    if ttl is not None:
+        args += ["--ttl", ttl]
+    status, out, err = invoke(args, None)
+    assert (status, err) == (0, ""), (status, out, err)
+    assert out.endswith("\n"), out
+    return out[:-1]
+
+
 def write_store(path, accounts, version=1, mode=0o600):
     """Write a store document verbatim, byte-deterministically."""
     document = {"version": version, "accounts": accounts}
