+# --- feature 002: the optional `reset` field (contracts/store-format.md) ------
+#
+# One invalid `reset` object fails the *whole* load with status 5.  It is never
+# repaired, never defaulted, never skipped, and the record it belongs to is
+# never loaded without it (SR-010).
+
+
+def _store_with_reset(store_path, reset):
+    """A store whose only account carries ``reset`` verbatim."""
+    record = synthetic_record()
+    record["reset"] = reset
+    write_store(store_path, {"alice": record})
+    return store_path
+
+
+def _assert_malformed(run, store_path, label):
+    """Every operation on this store answers 5, and the file is untouched."""
+    before = store_path.read_bytes()
+    for argv, stdin in (
+        (["login", "alice"], lines(PASSWORD)),
+        (["unlock", "alice"], None),
+        (["reset-token", "alice"], None),
+        (["reset", "alice"], lines("tok", NEW_PASSWORD)),
+    ):
+        status, out, err = run(["--store", store_path, *argv], stdin)
+        assert status == 5, (label, argv, status, out, err)
+        assert out == "", (label, argv, out)
+        assert "is malformed" in err, (label, argv, err)
+        assert "Traceback" not in err, (label, argv, err)
+        assert store_path.read_bytes() == before, (label, argv)
+
+
+def test_sr010_reset_not_an_object_is_status_5(run, store_path):
+    """``reset`` present but not a JSON object is malformed (SR-010)."""
+    for value in (None, 1, "scrypt", [], True, 1.5):
+        _store_with_reset(store_path, value)
+        _assert_malformed(run, store_path, repr(value))
+
+
+def test_sr010_reset_field_set_is_closed(run, store_path):
+    """Exactly eight keys: a missing one or a ninth is malformed (SR-010)."""
+    from conftest import reset_material
+
+    for missing in sorted(reset_material()):
+        material = reset_material()
+        del material[missing]
+        _store_with_reset(store_path, material)
+        _assert_malformed(run, store_path, "missing %s" % missing)
+
+    for extra in ("version", "token", "failed_logins", ""):
+        material = reset_material()
+        material[extra] = 1
+        _store_with_reset(store_path, material)
+        _assert_malformed(run, store_path, "extra %s" % extra)
+
+    # The eight-key object itself loads, which is what makes the above a closed
+    # set rather than a blanket refusal.
+    _store_with_reset(store_path, reset_material())
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 1
+
+
+def test_sr015_expires_ms_out_of_range_is_status_5(run, store_path):
+    """``expires_ms`` is an integer in 1 … 253402300799000 (SR-015)."""
+    from conftest import reset_material
+
+    refused = (
+        "1762300000000",            # a string
+        1762300000000.0,            # a float, even a whole-valued one
+        True,                       # bool subclasses int, and is refused
+        False,
+        -1,
+        0,
+        253402300799001,
+        None,
+        [],
+    )
+    for value in refused:
+        _store_with_reset(store_path, reset_material(expires_ms=value))
+        _assert_malformed(run, store_path, "expires_ms=%r" % value)
+
+    # The boundaries themselves load.
+    for value in (1, 253402300799000):
+        _store_with_reset(store_path, reset_material(expires_ms=value))
+        assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 1
+
+
+def test_sr010_reset_salt_and_hash_lengths_enforced(run, store_path):
+    """``reset.salt`` is 16 bytes and ``reset.hash`` is ``dklen`` bytes (SR-010)."""
+    import base64
+
+    from conftest import reset_material
+
+    def b64(raw):
+        return base64.b64encode(raw).decode("ascii")
+
+    for salt in (
+        b64(b"fifteen-bytes!!"),
+        b64(b"seventeen-bytes!!"),
+        b64(b""),
+        "not base64 at all!!!!!!!",
+        "U1lOVEhFVElDLVNBTFQtMTZC=",   # bad padding
+        "U1lOVEhFVElDLVNBTFQtMTZ$",   # outside the alphabet
+        16,
+        None,
+    ):
+        _store_with_reset(store_path, reset_material(salt=salt))
+        _assert_malformed(run, store_path, "salt=%r" % salt)
+
+    for digest in (
+        b64(b"thirty-one-bytes-is-one-short!!"),
+        b64(b"thirty-three-bytes-is-one-too-max"),
+        b64(b""),
+        "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%=",
+        None,
+    ):
+        _store_with_reset(store_path, reset_material(hash=digest))
+        _assert_malformed(run, store_path, "hash=%r" % digest)
+
+    # `hash` is measured against the object's own `dklen`, not against 32.
+    _store_with_reset(
+        store_path, reset_material(dklen=16, hash=b64(b"sixteen-bytes-ok"))
+    )
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 1
+
+
+def test_sr010_reset_kdf_and_parameters_enforced(run, store_path):
+    """``reset.kdf`` is ``scrypt`` and every parameter is in range (SR-010, SR-015)."""
+    from conftest import reset_material
+
+    for kdf in ("Scrypt", "bcrypt", "argon2id", "", None, 1):
+        _store_with_reset(store_path, reset_material(kdf=kdf))
+        _assert_malformed(run, store_path, "kdf=%r" % kdf)
+
+    out_of_range = (
+        ("n", 0), ("n", 1), ("n", 3), ("n", 131073), ("n", 2097152),
+        ("n", True), ("n", "131072"), ("n", 131072.0),
+        ("r", 0), ("r", 33), ("r", True), ("r", "8"),
+        ("p", 0), ("p", 17), ("p", True), ("p", "1"),
+        ("dklen", 15), ("dklen", 65), ("dklen", True), ("dklen", "32"),
+    )
+    for field, value in out_of_range:
+        _store_with_reset(store_path, reset_material(**{field: value}))
+        _assert_malformed(run, store_path, "%s=%r" % (field, value))
+
+    # The `n * r` memory rule applies to `reset` exactly as to the record: a
+    # parameter pair demanding more than the enforced bound is malformed rather
+    # than an unbounded allocation (SR-015).
+    _store_with_reset(store_path, reset_material(n=1048576, r=32))
+    _assert_malformed(run, store_path, "maxmem")
+
+
+def test_sr010_invalid_reset_never_loaded_without_it(run, store_path):
+    """A record is never loaded with its invalid ``reset`` quietly dropped."""
+    from conftest import reset_material
+
+    record = synthetic_record()
+    record["reset"] = reset_material(expires_ms="not a number")
+    write_store(store_path, {"alice": record, "bob": synthetic_record()})
+    before = store_path.read_bytes()
+
+    # `bob` is perfectly valid, but one invalid reset object fails the whole
+    # load: there is no partial or best-effort read.
+    for argv, stdin in (
+        (["login", "bob"], lines(PASSWORD)),
+        (["unlock", "bob"], None),
+        (["register", "carol"], lines(PASSWORD)),
+        (["delete", "bob"], lines(PASSWORD)),
+    ):
+        status, out, err = run(["--store", store_path, *argv], stdin)
+        assert status == 5, (argv, status, out, err)
+        assert "is malformed" in err, (argv, err)
+    assert store_path.read_bytes() == before