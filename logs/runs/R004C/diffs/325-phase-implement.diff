+# --- feature 002: SC-025, the new worked sequence ----------------------------
+
+
+def test_sc025_reset_worked_sequence(run, store_path, tmp_path):
+    """Every line and every status of feature 002's worked sequence (SC-025).
+
+    The sequence is the one in
+    ``specs/002-password-reset/contracts/cli-contract.md`` ("Worked example
+    sequence").  The three token values shown there are illustrative strings of
+    the right shape; every token used here is captured at runtime through
+    ``conftest.issue_token`` and is never a literal (SC-015).
+    """
+    # Imported here rather than at the top of the file so that feature 001's
+    # own import line is left exactly as it was (FR-040, SC-019).
+    import time
+
+    from conftest import MIN_PASSWORD, OTHER_PASSWORD, issue_token, read_store
+
+    usage = (
+        "usage: python -m accounts --store PATH"
+        " {register|login|unlock|passwd|delete|reset-token|reset} USERNAME"
+        " [--ttl SECONDS]\n"
+    )
+    steps = []
+
+    # $ register alice                  -> registered alice, exit 0
+    steps.append(
+        (
+            run(["--store", store_path, "register", "alice"], lines(PASSWORD)),
+            (0, "registered alice\n", ""),
+        )
+    )
+    # $ reset-token nobody < /dev/null  -> error: no such account 'nobody', exit 3
+    steps.append(
+        (
+            run(["--store", store_path, "reset-token", "nobody"], None),
+            (3, "", "error: no such account 'nobody'\n"),
+        )
+    )
+    # $ reset-token alice < /dev/null   -> the token on stdout, exit 0
+    status, out, err = run(["--store", store_path, "reset-token", "alice"], None)
+    assert (status, err) == (0, "")
+    assert len(out) == 23 and out.endswith("\n")
+    token = out[:-1]
+
+    # $ reset alice  (token, new password) -> password reset, exit 0
+    steps.append(
+        (
+            run(["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)),
+            (0, "password reset\n", ""),
+        )
+    )
+    # $ login alice  (new password)     -> ok, exit 0
+    steps.append(
+        (
+            run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD)),
+            (0, "ok\n", ""),
+        )
+    )
+    # $ login alice  (old password)     -> invalid credentials, exit 1
+    steps.append(
+        (
+            run(["--store", store_path, "login", "alice"], lines(PASSWORD)),
+            (1, "", "invalid credentials\n"),
+        )
+    )
+    # $ reset alice  (same token again) -> invalid token, exit 1 (single use)
+    steps.append(
+        (
+            run(
+                ["--store", store_path, "reset", "alice"],
+                lines(token, OTHER_PASSWORD),
+            ),
+            (1, "", "invalid token\n"),
+        )
+    )
+
+    # $ reset-token alice --ttl 1 < /dev/null -> a second token, exit 0
+    second = issue_token(store_path, "alice", ttl="1")
+    # $ sleep 2
+    expiry = read_store(store_path)["accounts"]["alice"]["reset"]["expires_ms"]
+    while int(time.time() * 1000) <= expiry:
+        time.sleep(0.2)
+    # $ reset alice  (expired token)    -> invalid token, exit 1
+    steps.append(
+        (
+            run(
+                ["--store", store_path, "reset", "alice"],
+                lines(second, OTHER_PASSWORD),
+            ),
+            (1, "", "invalid token\n"),
+        )
+    )
+
+    # $ reset-token alice < /dev/null   -> a third token, exit 0
+    third = issue_token(store_path, "alice")
+    # $ reset alice  (11-character new password) -> too short, exit 2
+    steps.append(
+        (
+            run(
+                ["--store", store_path, "reset", "alice"],
+                lines(third, SHORT_PASSWORD),
+            ),
+            (
+                2,
+                "",
+                "error: new password too short: expected at least 12"
+                " characters, received 11\n",
+            ),
+        )
+    )
+    # $ reset alice  (12-character new password) -> the token survived, exit 0
+    steps.append(
+        (
+            run(
+                ["--store", store_path, "reset", "alice"], lines(third, MIN_PASSWORD)
+            ),
+            (0, "password reset\n", ""),
+        )
+    )
+
+    # $ reset-token alice --ttl 0 < /dev/null -> invalid ttl, exit 2
+    steps.append(
+        (
+            run(
+                ["--store", store_path, "reset-token", "alice", "--ttl", "0"], None
+            ),
+            (
+                2,
+                "",
+                "error: invalid ttl: expected a whole number of seconds from 1"
+                " to 86400, received '0'\n",
+            ),
+        )
+    )
+    # $ reset-token alice --ttl 60 --ttl 60 < /dev/null -> the usage line, exit 2
+    steps.append(
+        (
+            run(
+                [
+                    "--store", store_path, "reset-token", "alice",
+                    "--ttl", "60", "--ttl", "60",
+                ],
+                None,
+            ),
+            (2, "", usage),
+        )
+    )
+
+    # $ reset alice --store ./missing   -> error: no such account 'alice', exit 3
+    missing = tmp_path / "missing"
+    steps.append(
+        (
+            run(["--store", missing, "reset", "alice"], lines(third, NEW_PASSWORD)),
+            (3, "", "error: no such account 'alice'\n"),
+        )
+    )
+    # $ ls ./missing                    -> created nothing
+    assert not missing.exists()
+
+    for index, (observed, expected) in enumerate(steps):
+        assert observed == expected, (index, observed, expected)
+
+    # The account is left on the password the last successful reset set.
+    assert run(["--store", store_path, "login", "alice"], lines(MIN_PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
