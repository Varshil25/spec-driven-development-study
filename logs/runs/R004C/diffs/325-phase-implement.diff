index 0000000..94e5a21
--- /dev/null
+++ b/tests/test_reset_token.py
@@ -0,0 +1,351 @@
+"""User Story 1 (issuance) and User Story 4 (bad requests) for ``reset-token``.
+
+FR-021 … FR-025, FR-028, FR-029, FR-031, FR-032 plus SR-010 and SR-015 on the
+``--ttl`` surface.  Every token value here is read at runtime through
+``conftest.issue_token``; none is a literal (SR-013, SC-015).
+"""
+
+import string
+
+from conftest import (
+    PASSWORD,
+    WRONG_PASSWORD,
+    failed_logins,
+    issue_token,
+    lines,
+    read_store,
+)
+
+USAGE = (
+    "usage: python -m accounts --store PATH"
+    " {register|login|unlock|passwd|delete|reset-token|reset} USERNAME"
+    " [--ttl SECONDS]\n"
+)
+
+# Assembled rather than spelled out: a literal run of the lowercase letters
+# would collide with ``conftest.TIMING_PASSWORD`` and trip the suite's own
+# secrets-hygiene scan.
+TOKEN_CHARS = set(string.ascii_letters + string.digits + "-_")
+
+RESET_KEYS = {"kdf", "n", "r", "p", "dklen", "salt", "hash", "expires_ms"}
+
+
+def _register(run, store_path, username="alice", password=[REDACTED:assigned_secret]):
+    assert run(["--store", store_path, "register", username], lines(password))[0] == 0
+
+
+def _echoed(text):
+    """The contract's rendering of an echoed value: printable ASCII or ``\\xNN``.
+
+    Spelled out here rather than imported, so the test asserts the documented
+    rule instead of agreeing with the implementation of it (SR-011, SR-018).
+    """
+    out = []
+    for byte in text.encode("utf-8"):
+        out.append(chr(byte) if 0x20 <= byte <= 0x7E else "\\x%02x" % byte)
+    return "".join(out)[:64]
+
+
+def _invalid_ttl(value):
+    return (
+        "error: invalid ttl: expected a whole number of seconds from 1 to"
+        " 86400, received '%s'\n" % _echoed(value)
+    )
+
+
+def _reset_of(store_path, username="alice"):
+    return read_store(store_path)["accounts"][username].get("reset")
+
+
+# --- User Story 1: issuance happy path ---------------------------------------
+
+
+def test_fr028_issue_records_material_and_prints_token(run, store_path):
+    """Generate, record, persist, print -- in one invocation (FR-028)."""
+    _register(run, store_path)
+    before = read_store(store_path)["accounts"]["alice"]
+    assert "reset" not in before
+
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    reset = _reset_of(store_path)
+    assert reset is not None
+    assert set(reset) == RESET_KEYS
+    assert reset["kdf"] == "scrypt"
+    assert reset["expires_ms"] > 0
+    # The password material is untouched: only the new key appeared.
+    after = read_store(store_path)["accounts"]["alice"]
+    assert {k: after[k] for k in after if k != "reset"} == before
+    # The old password still works -- issuing a token is not a change of
+    # credentials, only the offer of one.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
+    assert len(token) == 22
+
+
+def test_fr025_token_is_the_only_stdout_line(run, store_path):
+    """stdout is the token and one newline; stderr is empty; status 0 (FR-025)."""
+    _register(run, store_path)
+    status, out, err = run(["--store", store_path, "reset-token", "alice"], None)
+    assert status == 0
+    assert err == ""
+    assert out.count("\n") == 1
+    assert out.endswith("\n")
+    token = out[:-1]
+    assert len(token) == 22, token
+    assert set(token) <= TOKEN_CHARS, token
+
+
+def test_fr021_default_validity_is_900(run, store_path):
+    """Absent ``--ttl``, validity is 900 seconds (FR-021, A-016)."""
+    _register(run, store_path)
+    issue_token(store_path, "alice")
+    default_expiry = _reset_of(store_path)["expires_ms"]
+
+    issue_token(store_path, "alice", ttl="900")
+    explicit_expiry = _reset_of(store_path)["expires_ms"]
+
+    # Issued seconds apart at most, so the two expiries agree to within a few
+    # seconds -- which is what pins the default at 900 and not, say, 300.
+    assert abs(explicit_expiry - default_expiry) < 5000, (
+        default_expiry,
+        explicit_expiry,
+    )
+
+    # And a different explicit value visibly moves it, so the comparison above
+    # is not vacuous.
+    issue_token(store_path, "alice", ttl="86400")
+    assert _reset_of(store_path)["expires_ms"] - default_expiry > 80000 * 1000
+
+
+def test_fr023_succeeds_with_stdin_closed(run, store_path):
+    """``reset-token`` reads nothing and works with stdin closed (scenario 1.6)."""
+    _register(run, store_path)
+    # ``stdin=None`` in the runner is /dev/null: the stream is closed.
+    status, out, err = run(["--store", store_path, "reset-token", "alice"], None)
+    assert (status, err) == (0, "")
+    assert out.endswith("\n")
+
+    # Input offered anyway is ignored, not read: the token is still the only
+    # output and no diagnostic appears.
+    status, out, err = run(
+        ["--store", store_path, "reset-token", "alice"], lines("ignored", "also")
+    )
+    assert (status, err) == (0, "")
+    assert out.count("\n") == 1
+
+
+def test_fr029_reissue_replaces(run, store_path):
+    """At most one token is outstanding: issuing replaces (FR-029, A-015)."""
+    _register(run, store_path)
+    first = issue_token(store_path, "alice")
+    first_reset = _reset_of(store_path)
+    second = issue_token(store_path, "alice")
+    second_reset = _reset_of(store_path)
+
+    assert first != second
+    # One key, so one token: the record cannot hold two.
+    assert set(read_store(store_path)["accounts"]["alice"]) == {
+        "kdf", "n", "r", "p", "dklen", "salt", "hash", "failed_logins", "reset",
+    }
+    assert second_reset != first_reset
+    assert second_reset["salt"] != first_reset["salt"]
+    assert second_reset["hash"] != first_reset["hash"]
+
+
+def test_fr031_issue_on_locked_account_changes_nothing(run, store_path):
+    """Issuing works on a locked account and alters neither count nor lock.
+
+    Scenario 1.7: the lock restricts ``login`` only, so recovery is reachable
+    exactly when it is most needed (FR-031, FR-024, A-018).
+    """
+    _register(run, store_path)
+    for _ in range(5):
+        assert run(
+            ["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD)
+        )[0] == 1
+    assert failed_logins(store_path, "alice") == 5
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        4,
+        "",
+        "account locked\n",
+    )
+
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    assert failed_logins(store_path, "alice") == 5
+    # Still locked for login, and the count has not moved in either direction.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 4
+    assert token != ""
+
+
+def test_fr024_no_status_4_ever(run, store_path):
+    """No ``reset-token`` invocation can exit 4 (FR-024, FR-031, A-018)."""
+    _register(run, store_path)
+    for _ in range(5):
+        run(["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD))
+
+    attempts = (
+        (["--store", store_path, "reset-token", "alice"], None),
+        (["--store", store_path, "reset-token", "alice", "--ttl", "60"], None),
+        (["--store", store_path, "reset-token", "nobody"], None),
+        (["--store", store_path, "reset-token", "ab"], None),
+        (["--store", store_path, "reset-token", "alice", "--ttl", "0"], None),
+        (["--store", store_path, "reset-token", "alice", "--ttl", "x"], None),
+        (["--store", store_path, "reset-token"], None),
+    )
+    for argv, stdin in attempts:
+        status, out, err = run(argv, stdin)
+        assert status != 4, (argv, status, out, err)
+
+
+# --- User Story 4: bad requests ----------------------------------------------
+
+
+def test_fr022_ttl_allowlist(run, store_path):
+    """Only ``[0-9]{1,5}`` naming 1-86400 is accepted (FR-022, SR-010)."""
+    _register(run, store_path)
+    refused = (
+        "-5",
+        "+60",
+        "0",
+        "1.5",
+        "6e1",
+        "100000",
+        "99999",
+        "",
+        " 60",
+        "60 ",
+        "١٢",  # Arabic-Indic digits: int() would accept them
+    )
+    for value in refused:
+        status, out, err = run(
+            ["--store", store_path, "reset-token", "alice", "--ttl", value], None
+        )
+        assert status == 2, (value, status, out, err)
+        assert out == "", (value, out)
+        assert err == _invalid_ttl(value), (value, err)
+
+    # The boundaries themselves are accepted.
+    for value in ("1", "86400", "0060"):
+        assert issue_token(store_path, "alice", ttl=value) != ""
+
+
+def test_fr022_invalid_ttl_issues_no_token(run, store_path):
+    """A refused ``--ttl`` leaves the store byte-identical (FR-022, FR-027)."""
+    _register(run, store_path)
+    before = store_path.read_bytes()
+    for value in ("0", "86401", "abc", "-1"):
+        status, out, _ = run(
+            ["--store", store_path, "reset-token", "alice", "--ttl", value], None
+        )
+        assert (status, out) == (2, ""), value
+        assert store_path.read_bytes() == before, value
+    assert _reset_of(store_path) is None
+
+
+def test_sr010_int_does_not_accept_unicode_digits(run, store_path):
+    """The allow-list runs before ``int()``, which is laxer (SR-010, research R15)."""
+    # Establish the premise rather than assuming it: these are exactly the
+    # strings ``int()`` would have accepted.
+    assert int("١٢") == 12
+    assert int(" +60 ") == 60
+    assert int("6_0") == 60
+
+    _register(run, store_path)
+    for value in ("١٢", " +60 ", "6_0", "６０"):
+        status, out, err = run(
+            ["--store", store_path, "reset-token", "alice", "--ttl", value], None
+        )
+        assert (status, out) == (2, ""), (value, status, out, err)
+        assert err.startswith("error: invalid ttl:"), (value, err)
+    assert _reset_of(store_path) is None
+
+
+def test_sr015_ttl_bounded_at_five_digits(run, store_path):
+    """Five digits is the most that can be presented at all (SR-015)."""
+    _register(run, store_path)
+    for value in ("100000", "9" * 6, "9" * 100, "0" * 20):
+        status, out, err = run(
+            ["--store", store_path, "reset-token", "alice", "--ttl", value], None
+        )
+        assert (status, out) == (2, ""), (value, status, out, err)
+        assert err == _invalid_ttl(value), (value, err)
+
+
