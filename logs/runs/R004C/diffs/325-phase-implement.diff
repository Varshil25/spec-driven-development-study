diff --git a/tests/test_compatibility.py b/tests/test_compatibility.py
new file mode 100644
index 0000000..d1a7c9b
--- /dev/null
+++ b/tests/test_compatibility.py
@@ -0,0 +1,424 @@
+"""User Story 5: the existing five operations are untouched.
+
+FR-040, FR-041, FR-042 plus SC-019 and SC-020.  The claim under test is a
+negative one -- that nothing this feature adds is observable in ``register``,
+``login``, ``unlock``, ``passwd`` or ``delete`` -- so most of the evidence is
+the eleven feature-001 test files continuing to pass unchanged.  What is here
+is the part that needs a token to exist in order to be stated at all.
+"""
+
+import subprocess
+import sys
+
+import pytest
+
+from conftest import (
+    NEW_PASSWORD,
+    OTHER_PASSWORD,
+    PASSWORD,
+    REPO_ROOT,
+    WRONG_PASSWORD,
+    child_env,
+    issue_token,
+    lines,
+    read_store,
+    synthetic_record,
+    write_store,
+)
+
+USAGE = (
+    "usage: python -m accounts --store PATH"
+    " {register|login|unlock|passwd|delete|reset-token|reset} USERNAME"
+    " [--ttl SECONDS]\n"
+)
+
+# The eight keys of a feature-001 record: a store written before this feature
+# holds exactly these and no ``reset`` (contracts/store-format.md).
+RECORD_KEYS_001 = {
+    "kdf", "n", "r", "p", "dklen", "salt", "hash", "failed_logins",
+}
+
+# The feature-001 suite, unchanged by this feature apart from the two A-025
+# strings in ``test_cli_contract.py`` (SC-019).
+SUITE_001 = (
+    "tests/test_cli_contract.py",
+    "tests/test_register.py",
+    "tests/test_login_lockout.py",
+    "tests/test_passwd.py",
+    "tests/test_delete.py",
+    "tests/test_security.py",
+    "tests/test_store_format.py",
+    "tests/test_concurrency.py",
+    "tests/test_crash_safety.py",
+    "tests/test_performance.py",
+    "tests/test_example_sequence.py",
+)
+
+
+def _register(run, store_path, username="alice", password=[REDACTED:assigned_secret]):
+    assert run(["--store", store_path, "register", username], lines(password))[0] == 0
+
+
+def _reset_of(store_path, username="alice"):
+    return read_store(store_path)["accounts"][username].get("reset")
+
+
+def _pre_feature_store(store_path, passwords):
+    """A store as feature 001 would have written it: real digests, no ``reset``.
+
+    Built through the same module feature 001 used, so the records are genuine
+    derivations rather than fixtures, and the password of each account is known
+    to the test (FR-041, SC-020).
+    """
+    from accounts import crypto
+
+    accounts = {}
+    for username, password in passwords.items():
+        salt = crypto.new_salt()
+        digest = crypto.hash_password(
+            password, salt, crypto.N, crypto.R, crypto.P, crypto.DKLEN
+        )
+        accounts[username] = {
+            "kdf": crypto.KDF_NAME,
+            "n": crypto.N,
+            "r": crypto.R,
+            "p": crypto.P,
+            "dklen": crypto.DKLEN,
+            "salt": crypto.b64encode(salt),
+            "hash": crypto.b64encode(digest),
+            "failed_logins": 0,
+        }
+    write_store(store_path, accounts)
+    return accounts
+
+
+# --- FR-040: the five operations are unchanged -------------------------------
+
+
+def test_fr040_existing_five_unchanged(run, store_path):
+    """Every output, message and status of the five operations still holds."""
+    # register
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD)) == (
+        0,
+        "registered alice\n",
+        "",
+    )
+    assert run(["--store", store_path, "register", "alice"], lines(PASSWORD)) == (
+        3,
+        "",
+        "error: account 'alice' already exists\n",
+    )
+    # login
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        0,
+        "ok\n",
+        "",
+    )
+    assert run(["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD)) == (
+        1,
+        "",
+        "invalid credentials\n",
+    )
+    assert run(["--store", store_path, "login", "nobody"], lines(PASSWORD)) == (
+        1,
+        "",
+        "invalid credentials\n",
+    )
+    # lockout, and the lock's own message and status
+    for _ in range(5):
+        run(["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD))
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        4,
+        "",
+        "account locked\n",
+    )
+    # unlock
+    assert run(["--store", store_path, "unlock", "alice"], None) == (0, "", "")
+    assert run(["--store", store_path, "unlock", "nobody"], None) == (
+        3,
+        "",
+        "error: no such account 'nobody'\n",
+    )
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+    # passwd
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    ) == (0, "", "")
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, OTHER_PASSWORD)
+    ) == (1, "", "invalid credentials\n")
+    # delete
+    assert run(["--store", store_path, "delete", "alice"], lines(NEW_PASSWORD)) == (
+        0,
+        "",
+        "",
+    )
+    assert run(["--store", store_path, "delete", "alice"], lines(NEW_PASSWORD)) == (
+        3,
+        "",
+        "error: no such account 'alice'\n",
+    )
+
+
+def test_a025_only_two_diagnostics_changed(run, store_path):
+    """Exactly two strings changed, both about the set of accepted names (A-025)."""
+    # Changed: the usage line.
+    assert run(["--store", store_path, "login"], None) == (2, "", USAGE)
+    # Changed: the unknown-command enumeration.
+    status, out, err = run(["--store", store_path, "frobnicate", "alice"], None)
+    assert (status, out) == (2, "")
+    assert err == (
+        "error: unknown command 'frobnicate': expected one of register, login,"
+        " unlock, passwd, delete, reset-token, reset\n"
+    )
+
+    # Unchanged: every other diagnostic the five operations can emit.  The
+    # password-line pair in particular still says "password", even though the
+    # reader behind it is now shared with the token line (research R16).
+    _register(run, store_path)
+    unchanged = (
+        (
+            ["--store", store_path, "login", "alice"],
+            None,
+            "error: missing password input: expected 1 password line(s) on"
+            " stdin, received 0\n",
+        ),
+        (
+            ["--store", store_path, "passwd", "alice"],
+            lines(PASSWORD),
+            "error: missing password input: expected 2 password line(s) on"
+            " stdin, received 1\n",
+        ),
+        (
+            ["--store", store_path, "login", "alice"],
+            "x" * 4097 + "\n",
+            "error: password line too long: expected at most 4096 bytes before"
+            " the line terminator\n",
+        ),
+        (
+            ["--store", store_path, "register", "bob"],
+            lines("elevenchar"),
+            "error: new password too short: expected at least 12 characters,"
+            " received 10\n",
+        ),
+        (
+            ["--store", store_path, "register", "bob"],
+            lines("x" * 1025),
+            "error: new password too long: expected at most 1024 characters,"
+            " received 1025\n",
+        ),
+        (
+            ["--store", store_path, "login", "ab"],
+            lines(PASSWORD),
+            "error: invalid username 'ab': expected 3-32 characters of letters,"
+            " digits or underscore, received 2 characters\n",
+        ),
+        (
+            ["--store", store_path, "login", "al!ce"],
+            lines(PASSWORD),
+            "error: invalid username 'al!ce': expected only letters, digits or"
+            " underscore\n",
+        ),
+    )
+    for argv, stdin, expected in unchanged:
+        status, out, err = run(argv, stdin)
+        assert out == "", (argv, out)
+        assert err == expected, (argv, err)
+        assert status == 2, (argv, status)
+
+    # And the non-UTF-8 password line still names the password.
+    status, out, err = run(
+        ["--store", store_path, "login", "alice"], b"\xff\xfe\n"
+    )
+    assert (status, out) == (2, "")
+    assert err == "error: password line is not valid UTF-8 text\n"
+
+
+# --- FR-041 / SC-020: a store written before this feature ---------------------
+
+
+def test_fr041_pre_feature_store_loads(run, store_path):
+    """A store with no ``reset`` anywhere loads and is operated on normally."""
+    write_store(
+        store_path,
+        {"alice": synthetic_record(), "bob": synthetic_record(failed_logins=3)},
+    )
+    before = store_path.read_bytes()
+
+    # It loads: the answer is a credential failure, not a malformed store.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD)) == (
+        1,
+        "",
+        "invalid credentials\n",
+    )
+    # Every operation reaches its own logic rather than a status 5.
+    assert run(["--store", store_path, "unlock", "bob"], None) == (0, "", "")
+    assert run(["--store", store_path, "register", "carol"], lines(PASSWORD))[0] == 0
+    assert run(["--store", store_path, "reset-token", "alice"], None)[0] == 0
+    assert run(["--store", store_path, "reset-token", "nobody"], None)[0] == 3
+
+    # A record with no ``reset`` means "no outstanding token", not "malformed".
+    assert set(synthetic_record()) == RECORD_KEYS_001
+    assert b"reset" not in before
+
+
+def test_fr041_passwords_still_verify(run, store_path):
+    """Every password in a pre-feature store still verifies (FR-041, SC-020)."""
+    passwords = {
+        "alice": PASSWORD,
+        "bob": OTHER_PASSWORD,
+        "carol": NEW_PASSWORD,
+    }
+    _pre_feature_store(store_path, passwords)
+
+    for username, password in passwords.items():
+        assert run(["--store", store_path, "login", username], lines(password)) == (
+            0,
+            "ok\n",
+            "",
+        ), username
+        assert run(
+            ["--store", store_path, "login", username], lines(WRONG_PASSWORD)
+        ) == (1, "", "invalid credentials\n"), username
+
+    # And such an account can be recovered by the new path, which is the point
+    # of keeping ``version`` at 1.
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, OTHER_PASSWORD)
+    ) == (0, "password reset\n", "")
+    assert run(["--store", store_path, "login", "alice"], lines(OTHER_PASSWORD))[0] == 0
+
+
+def test_sc020_no_token_outstanding_is_byte_identical_to_001(run, store_path):
+    """With no token outstanding, this build writes what the old one would."""
+    _register(run, store_path, "alice", PASSWORD)
+    _register(run, store_path, "bob", OTHER_PASSWORD)
+    records = read_store(store_path)["accounts"]
+    for username, record in records.items():
+        assert set(record) == RECORD_KEYS_001, username
+    assert b"reset" not in store_path.read_bytes()
+
+    # A redeemed token leaves the store in that same shape: the key is gone,
+    # not left empty (scenario 5.3).
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    )[0] == 0
+    for username, record in read_store(store_path)["accounts"].items():
+        assert set(record) == RECORD_KEYS_001, username
+    assert b"reset" not in store_path.read_bytes()
+
+
+# --- FR-042: what the five operations do to an outstanding token -------------
+
+
+def test_fr042_passwd_invalidates_token(run, store_path):
+    """A successful ``passwd`` drops any outstanding token (A-019, 2.6)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    assert _reset_of(store_path) is not None
+
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(PASSWORD, NEW_PASSWORD)
+    )[0] == 0
+    assert _reset_of(store_path) is None
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, OTHER_PASSWORD)
+    ) == (1, "", "invalid token\n")
+    # The password `passwd` set is still the live one.
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+
+
+def test_fr042_failed_passwd_leaves_token(run, store_path):
+    """A *failed* ``passwd`` writes nothing, so the token survives (FR-042)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    before = store_path.read_bytes()
+
+    assert run(
+        ["--store", store_path, "passwd", "alice"], lines(WRONG_PASSWORD, NEW_PASSWORD)
+    ) == (1, "", "invalid credentials\n")
+    assert store_path.read_bytes() == before
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    ) == (0, "password reset\n", "")
+
+
+def test_fr042_delete_removes_token(run, store_path):
+    """``delete`` takes the token with the account; re-registering is clean (5.5)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+
+    assert run(["--store", store_path, "delete", "alice"], lines(PASSWORD))[0] == 0
+    assert b"reset" not in store_path.read_bytes()
+
+    # Re-registering the same username does not inherit the old token.
+    _register(run, store_path, "alice", NEW_PASSWORD)
+    assert _reset_of(store_path) is None
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, OTHER_PASSWORD)
+    ) == (1, "", "invalid token\n")
+    assert run(["--store", store_path, "login", "alice"], lines(NEW_PASSWORD))[0] == 0
+
+
+def test_fr042_login_and_unlock_leave_token(run, store_path):
+    """``login`` and ``unlock`` leave an outstanding token untouched (5.4)."""
+    _register(run, store_path)
+    token=[REDACTED:assigned_secret](store_path, "alice")
+    issued = _reset_of(store_path)
+
+    # A successful login.
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 0
+    assert _reset_of(store_path) == issued
+    # Failing logins, all the way to the lock.
+    for _ in range(5):
+        assert run(
+            ["--store", store_path, "login", "alice"], lines(WRONG_PASSWORD)
+        )[0] == 1
+    assert _reset_of(store_path) == issued
+    assert run(["--store", store_path, "login", "alice"], lines(PASSWORD))[0] == 4
+    assert _reset_of(store_path) == issued
+    # And an unlock.
+    assert run(["--store", store_path, "unlock", "alice"], None)[0] == 0
+    assert _reset_of(store_path) == issued
+
+    # Still redeemable at the end of all of that.
+    assert run(
+        ["--store", store_path, "reset", "alice"], lines(token, NEW_PASSWORD)
+    ) == (0, "password reset\n", "")
+
+
+# --- SC-019: the feature-001 suite itself ------------------------------------
+
+
+@pytest.mark.slow
+def test_sc019_feature_001_suite_passes():
+    """Feature 001's own suite passes against the extended tool (SC-019).
+
+    Run as a separate process over exactly the eleven feature-001 files, so the
+    claim is about those files rather than about whichever subset of the suite
+    happens to be selected around this test.  The long-running checks inside
+    them are skipped here; the full-suite gate (task T038) covers those.
+    """
+    completed = subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "pytest",
+            "-q",
+            "-p",
+            "no:cacheprovider",
+            "-m",
+            "not slow",
+            *SUITE_001,
+        ],
+        cwd=str(REPO_ROOT),
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+        env=child_env(),
+        timeout=1800,
+    )
+    assert completed.returncode == 0, completed.stdout[-4000:]
+    assert " failed" not in completed.stdout, completed.stdout[-4000:]
