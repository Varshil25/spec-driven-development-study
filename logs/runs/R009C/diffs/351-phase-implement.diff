+    commands_run = []
+
+    status, token_out, err = call(run, store_path, ["reset-token", "alice"])
+    commands_run.append("reset-token")
+    assert status == 0 and err == ""
+    token=[REDACTED:assigned_secret][:-1]
+
+    status, out, err = call(
+        run, store_path, ["reset", "alice"], f"{token}\n{NEW_PASSWORD}\n"
+    )
+    commands_run.append("reset")
+    assert (status, out, err) == (0, "password reset\n", "")
+
+    status, out, err = call(run, store_path, ["login", "alice"], NEW_PASSWORD + "\n")
+    commands_run.append("login")
+    assert (status, out, err) == (0, "ok\n", "")
+
+    assert commands_run == ["reset-token", "reset", "login"]
+    assert "unlock" not in commands_run, "SC-011: the reset itself cleared the lock"
+
+
+def test_sc011_an_outstanding_token_alone_does_not_unlock_an_account(
+    run, store_path, account
+):
+    """SC-011/FR-032: while the token is merely outstanding, ``login`` still reports 4."""
+    account()
+    for _ in range(5):
+        call(run, store_path, ["login", "alice"], WRONG_PASSWORD + "\n")
+
+    status, out, err = call(run, store_path, ["reset-token", "alice"])
