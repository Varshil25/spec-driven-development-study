+# =====================================================================================
+# FR-037 — the global check order, including "a corrupt store outranks everything"
+# =====================================================================================
+
+
+@pytest.mark.parametrize("command", NEW_COMMANDS)
+def test_fr037_a_corrupt_store_is_exit_5_even_for_an_unknown_username(
