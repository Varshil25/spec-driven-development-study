+    )
+    assert (status, out, err) == (0, "password reset\n", "")
+
+    status, out, err = call(run, store_path, ["login", "alice"], NEW_PASSWORD + "\n")
+    assert (status, out, err) == (0, "ok\n", "")
+
+
+def test_sc011_the_same_three_commands_recover_a_locked_account(
+    run, store_path, account, read_store
+):
+    """SC-011/FR-036b: identical sequence on a locked account — no ``unlock`` among them."""
+    account()
+    for _ in range(5):
+        call(run, store_path, ["login", "alice"], WRONG_PASSWORD + "\n")
+    assert read_store(store_path)["accounts"]["alice"]["locked"] is True
