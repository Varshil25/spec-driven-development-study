+    """FR-034: end-of-input is not ``missing password input`` — no line is required."""
+    registered()
+
+    status, out, err = run(["--store", str(store_path), "reset-token", "alice"], "")
+
+    assert status == 0
+    assert err == ""
+
+
+def test_fr032_issuing_succeeds_on_a_locked_account_without_unlocking_it(
+    run, store_path, registered, read_store
