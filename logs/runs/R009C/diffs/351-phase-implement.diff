+# =====================================================================================
+# FR-036f / SC-017 — a too-short new password, with the token surviving (User Story 3)
+# =====================================================================================
+
+
+def test_fr036f_a_short_new_password_is_rejected_and_nothing_is_written(
+    run, store_path, registered, issued_token, read_store
+):
+    """FR-036f/acceptance 3.1: ``password too short`` / 2, store **unchanged**.
+
+    The token is still present with the same ``token_hash``, ``issued_at`` and
+    ``ttl_seconds``, and the password material, the tally and the lock are all as they
+    were — because the branch returns before any ``store.save``.
+    """
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+    before = read_store(store_path)
+    armed = before["accounts"]["alice"]["reset_token"]
+
+    status, out, err = do_reset(run, store_path, "alice", token, SHORT_PASSWORD)
+
+    assert status == 2
+    assert out == ""
+    assert err == "password too short\n"
+    after = read_store(store_path)
+    assert after == before, "FR-036f: the rejection writes nothing at all"
+    assert after["accounts"]["alice"]["reset_token"] == armed
+    # Named field by field, as acceptance 3.1 requires.
+    assert armed["token_hash"] == after["accounts"]["alice"]["reset_token"]["token_hash"]
+    assert armed["issued_at"] == after["accounts"]["alice"]["reset_token"]["issued_at"]
+    assert armed["ttl_seconds"] == after["accounts"]["alice"]["reset_token"]["ttl_seconds"]
+
+
+def test_fr036f_the_same_token_then_works_with_a_long_enough_password(
+    run, store_path, registered, issued_token
+):
