+
+@pytest.mark.parametrize("command", NEW_COMMANDS)
+def test_fr037_an_unreadable_store_is_exit_5(run, store_path, write_store, command):
+    """FR-037: an unusable path is exit 5 with the cause named (inherited FR-029).
+
+    A missing parent directory is used rather than a mode-0 file, because root ignores
+    file modes and the suite must not depend on the user it runs as.
+    """
+    missing = Path(store_path).parent / "no-such-directory" / "accounts.json"
+
