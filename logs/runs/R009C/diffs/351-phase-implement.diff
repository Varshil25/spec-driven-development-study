+# =====================================================================================
+# FR-043 — status 4 is never produced by either new command
+# =====================================================================================
+
+
+def test_fr043_neither_new_command_ever_produces_status_4(
+    run, store_path, registered, issued_token, write_store
+):
+    """FR-043: asserted on a **locked** account, for every outcome of both commands."""
+    registered()
+    for _ in range(5):
+        run(["--store", str(store_path), "login", "alice"], WRONG_PASSWORD + "\n")
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], GOOD_PASSWORD + "\n"
+    )
+    assert status == 4, "the account must be locked for this test to mean anything"
+
+    token=[REDACTED:assigned_secret]("alice")
+    invocations = [
+        # reset-token: success, unknown account, usage error.
+        (["reset-token", "alice"], ""),
+        (["reset-token", "nobody"], ""),
+        (["reset-token", "alice", "--ttl", "x"], ""),
+        # reset: refused token, missing input, unknown account, too-short password,
+        # usage error, and finally the success that clears the lock.
+        (["reset", "alice"], "wrong\n" + NEW_PASSWORD + "\n"),
+        (["reset", "alice"], ""),
+        (["reset", "nobody"], "t\n" + NEW_PASSWORD + "\n"),
+        (["reset", "alice", "extra"], "t\n" + NEW_PASSWORD + "\n"),
+    ]
+    for argv, stdin in invocations:
+        actual, out, err = run(["--store", str(store_path), *argv], stdin)
+        assert actual != 4, f"{argv}: FR-043 forbids status 4 from a new command"
+
+    # The locked account is still locked, and the final success is still not a 4.
+    token=[REDACTED:assigned_secret]("alice")
+    actual, out, err = run(
+        ["--store", str(store_path), "reset", "alice"], f"{token}\n{NEW_PASSWORD}\n"
+    )
