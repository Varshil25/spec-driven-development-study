+def test_fr034b_the_fingerprint_is_a_one_way_transformation():
+    """FR-034b: ``token_fingerprint`` is SHA-256 hex — deterministic and not reversible."""
+    token=[REDACTED:assigned_secret]()
+
+    first = hashing.token_fingerprint(token)
+    assert first == hashing.token_fingerprint(token), "must be deterministic"
+    assert first == hashlib.sha256(token.encode("utf-8")).hexdigest()
+    assert len(first) == 64
+    assert set(first) <= frozenset("0123456789abcdef")
+    assert token not in first
