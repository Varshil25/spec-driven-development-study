+def test_sc018_a_rejected_password_performs_zero_derivations(
+    run, store_path, registered, issued_token, monkeypatch
+):
+    """SC-018/FR-036f: the length guard returns before ``new_password_material`` is called.
+
+    Asserted by making the derivation raise: if the too-short path still exits 2 with the
+    documented message, no derivation was attempted (contracts/store-file.md "reset
+    failure → none, no write at all").
+    """
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+
+    from accounts import hashing as hashing_module
+
+    def explode(*args, **kwargs):  # pragma: no cover - must never be reached
+        raise AssertionError("SC-018: a rejected password must cost zero derivations")
+
+    monkeypatch.setattr(hashing_module, "new_password_material", explode)
+
+    status, out, err = do_reset(run, store_path, "alice", token, SHORT_PASSWORD)
+
+    assert status == 2
+    assert err == "password too short\n"
+
+
+def test_sc018_a_refused_token_performs_zero_derivations(
+    run, store_path, registered, issued_token, monkeypatch
+):
+    """SC-018/FR-036e: a refused token costs no derivation either."""
+    registered()
+    issued_token("alice")
+
+    from accounts import hashing as hashing_module
+
+    def explode(*args, **kwargs):  # pragma: no cover - must never be reached
+        raise AssertionError("SC-018: a refused token must cost zero derivations")
+
+    monkeypatch.setattr(hashing_module, "new_password_material", explode)
+
+    status, out, err = do_reset(run, store_path, "alice", "wrong", NEW_PASSWORD)
+
