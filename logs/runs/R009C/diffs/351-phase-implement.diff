+"""Tests for reset-token state in the store file — FR-039, and the store half of SC-019.
+
+Contract: ``specs/002-password-reset/contracts/store-file.md``; meaning:
+``specs/002-password-reset/data-model.md`` rules A-7 and T-10.
+
+Two properties are asserted here and nowhere else:
+
+* **Malformed token state is a corrupt store** (FR-039, T-10) — ``store unusable: <cause>``
+  on stderr with exit 5, for **all seven** commands including ``login``, which never reads a
+  token.  It is never silently ignored and never read as "no token" (Principle II).
+* **An absent ``reset_token`` is the normal state** (A-7) — a store written before this
+  feature existed loads and works for all seven commands with no migration and no marker
+  change (SC-019).
+
+Message strings are asserted for equality everywhere except ``store unusable: ``, which is
+asserted as a **prefix** plus the specific cause.  The store is compared as parsed JSON.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from accounts import store
+
+GOOD_PASSWORD = "correct horse battery"
+NEW_PASSWORD = "brand new passphrase"
+STORE_UNUSABLE = "store unusable: "
+
+#: A well-formed fingerprint: 64 lowercase hexadecimal characters (store-file.md).
+VALID_HASH = "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
+
+#: A well-formed ``reset_token`` object, used as the base every corruption row mutates.
+def valid_token(**overrides) -> dict:
+    token = {"token_hash": VALID_HASH, "issued_at": 1794427356.867, "ttl_seconds": 900}
+    token.update(overrides)
+    return token
+
+
+#: Every command word, with enough standard-input lines for the ones that read any.
+#: ``reset-token`` and ``unlock`` read nothing; the store is loaded before any line is
+#: read, so the input is irrelevant to the exit-5 rows and is supplied only for clarity.
+ALL_SEVEN_COMMANDS = [
+    ("register", "bob", GOOD_PASSWORD + "\n"),
+    ("login", "alice", GOOD_PASSWORD + "\n"),
+    ("unlock", "alice", ""),
+    ("passwd", "alice", GOOD_PASSWORD + "\n" + NEW_PASSWORD + "\n"),
+    ("delete", "alice", GOOD_PASSWORD + "\n"),
+    ("reset-token", "alice", ""),
+    ("reset", "alice", "sometoken\n" + NEW_PASSWORD + "\n"),
+]
+
+
+@pytest.fixture()
+def seeded(run, store_path, read_store, low_iterations):
+    """Register ``alice`` and return the parsed store document, ready to be mutated.
+
+    ``low_iterations`` keeps this file inside the SC-018 suite budget: it is read by 250+
+    parametrized cases, and nothing here asserts a derivation cost.  Sound because every
+    record carries its own iteration count (FR-026b).
+    """
+
+    def _seed(username: str = "alice") -> dict:
+        status, out, err = run(
+            ["--store", str(store_path), "register", username], GOOD_PASSWORD + "\n"
+        )
+        assert status == 0, err
+        return read_store(store_path)
+
+    return _seed
+
+
+# =====================================================================================
+# FR-039 / T-10 — every corruption row of contracts/store-file.md
+# =====================================================================================
+
+#: (id, the value placed at ``accounts["alice"]["reset_token"]``).
+#: Each row makes the store unusable: exit 5 with a named cause, for every command.
+CORRUPT_TOKEN_ROWS = [
+    # `reset_token` present but not a JSON object. `null` is **not** "absent" (FR-039).
+    ("not-an-object-null", None),
+    ("not-an-object-string", "abc"),
+    ("not-an-object-number", 5),
+    ("not-an-object-float", 5.5),
+    ("not-an-object-boolean", True),
+    ("not-an-object-array", []),
+    # A required field missing (a *missing* required key is corruption; only unknown
+    # *extra* keys are tolerated — S-6 precedent).
+    ("missing-token-hash", {"issued_at": 1.0, "ttl_seconds": 900}),
+    ("missing-issued-at", {"token_hash": VALID_HASH, "ttl_seconds": 900}),
+    ("missing-ttl-seconds", {"token_hash": VALID_HASH, "issued_at": 1.0}),
+    # `token_hash`: a string of exactly 64 lowercase hex characters, or corruption.
+    ("token-hash-number", valid_token(token_hash=5)),
+    ("token-hash-null", valid_token(token_hash=None)),
+    ("token-hash-boolean", valid_token(token_hash=True)),
+    ("token-hash-63-characters", valid_token(token_hash=VALID_HASH[:-1])),
+    ("token-hash-65-characters", valid_token(token_hash=VALID_HASH + "a")),
+    ("token-hash-empty", valid_token(token_hash="")),
+    # Uppercase hex is corruption: nothing this tool writes produces it.
+    ("token-hash-uppercase", valid_token(token_hash=VALID_HASH.upper())),
+    ("token-hash-mixed-case", valid_token(token_hash="A" + VALID_HASH[1:])),
+    ("token-hash-non-hex-letters", valid_token(token_hash="z" * 64)),
+    ("token-hash-non-hex-punctuation", valid_token(token_hash="-" * 64)),
+    # `issued_at`: a finite, non-boolean number.
+    ("issued-at-string", valid_token(issued_at="now")),
+    ("issued-at-boolean-true", valid_token(issued_at=True)),
+    ("issued-at-boolean-false", valid_token(issued_at=False)),
+    ("issued-at-null", valid_token(issued_at=None)),
+    ("issued-at-array", valid_token(issued_at=[1.0])),
+    # json.loads accepts these three by default, so this tool must reject them (FR-039).
+    ("issued-at-nan", valid_token(issued_at=float("nan"))),
+    ("issued-at-infinity", valid_token(issued_at=float("inf"))),
+    ("issued-at-negative-infinity", valid_token(issued_at=float("-inf"))),
+    # `ttl_seconds`: a non-boolean integer within 1…86400. A float is corruption even
+    # when integral, and a numeric string is never a number here.
+    ("ttl-zero", valid_token(ttl_seconds=0)),
+    ("ttl-negative", valid_token(ttl_seconds=-5)),
+    ("ttl-float", valid_token(ttl_seconds=1.5)),
+    ("ttl-integral-float", valid_token(ttl_seconds=900.0)),
+    ("ttl-boolean", valid_token(ttl_seconds=True)),
+    ("ttl-above-maximum", valid_token(ttl_seconds=86401)),
+    ("ttl-far-above-maximum", valid_token(ttl_seconds=99999999999999999999)),
+    ("ttl-string", valid_token(ttl_seconds="900")),
+    ("ttl-null", valid_token(ttl_seconds=None)),
+]
+
+
+@pytest.mark.parametrize(
+    "token", [row[1] for row in CORRUPT_TOKEN_ROWS], ids=[row[0] for row in CORRUPT_TOKEN_ROWS]
+)
+def test_fr039_malformed_token_state_makes_the_store_unusable(
+    run, store_path, seeded, write_store, token
+):
+    """FR-039/T-10: malformed token state is ``store unusable: <cause>`` / 5."""
+    document = seeded()
+    document["accounts"]["alice"]["reset_token"] = token
+    write_store(store_path, document)
+
+    status, out, err = run(["--store", str(store_path), "reset-token", "alice"])
+
+    assert status == 5
+    assert out == ""
+    assert err.startswith(STORE_UNUSABLE), err
+    # The cause is named, not merely signalled (Principle II).
+    assert err.rstrip("\n") != STORE_UNUSABLE.rstrip()
+    assert "alice" in err
+
+
+@pytest.mark.parametrize(
+    "token", [row[1] for row in CORRUPT_TOKEN_ROWS], ids=[row[0] for row in CORRUPT_TOKEN_ROWS]
+)
+@pytest.mark.parametrize(
+    "command,username,stdin",
+    ALL_SEVEN_COMMANDS,
+    ids=[row[0] for row in ALL_SEVEN_COMMANDS],
+)
+def test_fr039_malformed_token_state_is_exit_5_for_all_seven_commands(
+    run, store_path, seeded, write_store, token, command, username, stdin
+):
+    """FR-039: every command exits 5, **including ``login``**, which never reads a token.
+
+    This is plan.md consequence 3: the check lives at load because FR-039 makes malformed
+    token state a corrupt store for *every* command.  Validating lazily inside ``reset``
+    would let ``login`` succeed against a store FR-039 calls corrupt.
+    """
+    document = seeded()
+    document["accounts"]["alice"]["reset_token"] = token
+    write_store(store_path, document)
+
+    status, out, err = run(["--store", str(store_path), command, username], stdin)
+
+    assert status == 5, f"{command}: expected 5, got {status} ({err!r})"
+    assert out == ""
+    assert err.startswith(STORE_UNUSABLE), err
+
+
+def test_fr039_corrupt_token_state_is_never_read_as_no_token(
+    run, store_path, seeded, write_store
+):
+    """FR-039: ``"reset_token": null`` is corruption, not "no outstanding token".
+
+    The difference is observable: read as "no token" it would be ``invalid token`` / 1.
+    """
+    document = seeded()
+    document["accounts"]["alice"]["reset_token"] = None
+    write_store(store_path, document)
+
+    status, out, err = run(
+        ["--store", str(store_path), "reset", "alice"],
+        "anything\n" + NEW_PASSWORD + "\n",
+    )
+
+    assert status == 5
+    assert err.startswith(STORE_UNUSABLE)
+    assert err.rstrip("\n") != "invalid token"
+
+
+def test_fr039_corruption_in_one_account_condemns_the_whole_store(
+    run, store_path, seeded, write_store
+):
+    """FR-039: the store is validated whole, so a second account's bad token is still 5."""
+    document = seeded()
+    status, out, err = run(
+        ["--store", str(store_path), "register", "bob"], GOOD_PASSWORD + "\n"
+    )
+    assert status == 0, err
+    document = json.loads(Path(store_path).read_text(encoding="utf-8"))
+    document["accounts"]["bob"]["reset_token"] = {"token_hash": VALID_HASH}
+    write_store(store_path, document)
+
+    status, out, err = run(["--store", str(store_path), "reset-token", "alice"])
+
+    assert status == 5
+    assert err.startswith(STORE_UNUSABLE)
+    assert "bob" in err
+
+
+# =====================================================================================
+# FR-039 — well-formed token state is accepted and preserved
+# =====================================================================================
+
+
+@pytest.mark.parametrize(
+    "token",
+    [
+        valid_token(),
+        # An integer `issued_at` is accepted: JSON does not distinguish, and a float is
+        # merely what this version writes (store-file.md).
+        valid_token(issued_at=1794427356),
+        valid_token(issued_at=0),
+        # Both edges of the ttl range are valid state.
+        valid_token(ttl_seconds=1),
+        valid_token(ttl_seconds=86400),
+        # Unknown extra keys inside the object are not an error (S-6 precedent).
+        valid_token(note="written by a later version"),
+    ],
+    ids=["canonical", "integer-issued-at", "zero-issued-at", "ttl-min", "ttl-max", "extra-key"],
+)
+def test_fr039_well_formed_token_state_loads(run, store_path, seeded, write_store, token):
+    """FR-039: valid token state is not corruption — the command runs normally."""
+    document = seeded()
+    document["accounts"]["alice"]["reset_token"] = token
+    write_store(store_path, document)
+
+    status, out, err = run(["--store", str(store_path), "unlock", "alice"])
+
+    assert status == 0
+    assert err == ""
+
+
+def test_fr039_well_formed_token_state_round_trips_through_load_and_save(
+    store_path, seeded, write_store, read_store
+):
+    """FR-039/SC-019: ``store.load`` → ``store.save`` preserves token state exactly."""
+    document = seeded()
+    document["accounts"]["alice"]["reset_token"] = valid_token()
+    write_store(store_path, document)
+
+    loaded = store.load(store_path)
+    assert loaded["accounts"]["alice"]["reset_token"] == valid_token()
+    store.save(store_path, loaded)
+
+    assert read_store(store_path)["accounts"]["alice"]["reset_token"] == valid_token()
+    # The marker never changes: an optional key inside a record needs no version bump.
+    assert read_store(store_path)["format"] == "accounts-store-v1"
+
+
+def test_fr039_unknown_extra_keys_inside_the_token_object_survive_a_rewrite(
+    run, store_path, seeded, write_store, read_store
+):
+    """FR-039: extra keys inside ``reset_token`` are preserved on rewrite (S-6 precedent)."""
+    document = seeded()
+    document["accounts"]["alice"]["reset_token"] = valid_token(note="keep me", count=3)
+    write_store(store_path, document)
+
+    # `register bob` rewrites the whole document without touching alice.
+    status, out, err = run(
+        ["--store", str(store_path), "register", "bob"], GOOD_PASSWORD + "\n"
+    )
+    assert status == 0, err
+
+    token=[REDACTED:assigned_secret](store_path)["accounts"]["alice"]["reset_token"]
+    assert token == valid_token(note="keep me", count=3)
+
+
+def test_sc019_token_state_of_untouched_accounts_is_preserved_by_every_command(
+    run, store_path, seeded, write_store, read_store
+):
+    """SC-019: a command that rewrites the store preserves other accounts' token state."""
+    document = seeded()
+    status, out, err = run(
+        ["--store", str(store_path), "register", "bob"], GOOD_PASSWORD + "\n"
+    )
+    assert status == 0, err
+    document = json.loads(Path(store_path).read_text(encoding="utf-8"))
+    document["accounts"]["bob"]["reset_token"] = valid_token()
+    write_store(store_path, document)
+
+    # Commands that write, all acting on `alice` only.
+    for argv, stdin in [
+        (["login", "alice"], "wrong password here\n"),  # tally increment
+        (["unlock", "alice"], ""),
+        (["passwd", "alice"], GOOD_PASSWORD + "\n" + NEW_PASSWORD + "\n"),
+        (["reset-token", "alice"], ""),
+        (["delete", "alice"], NEW_PASSWORD + "\n"),
+    ]:
+        status, out, err = run(["--store", str(store_path), *argv], stdin)
+        assert status in (0, 1), f"{argv}: {status} {err!r}"
+        assert read_store(store_path)["accounts"]["bob"]["reset_token"] == valid_token(), (
+            f"SC-019: {argv[0]} disturbed bob's token state"
+        )
+
+
+# =====================================================================================
+# A-7 / SC-019 — a store written before this feature existed
+# =====================================================================================
+
+#: Exactly what a record looked like before this feature: no `reset_token` key at all.
+PRE_FEATURE_STORE = {
+    "format": "accounts-store-v1",
+    "accounts": {
+        "alice": {
+            "algorithm": "pbkdf2_hmac_sha256",
+            "iterations": 1000,
+            "salt": "zrVPHbwBiSfnSOTRXr6Lgw==",
+            "key": "o9u9lqkxUoM2v6+8pfnNKzMq0CqNdsMxtPaSQNDJVbE=",
+            "failed_logins": 0,
+            "locked": False,
+        }
+    },
+}
+
+
+@pytest.fixture()
+def pre_feature_store(store_path, write_store, low_iterations):
+    """A store file whose records carry no token state, with real derivation material."""
+    from accounts import hashing
+
+    record = hashing.new_password_material(GOOD_PASSWORD)
+    record["failed_logins"] = 0
+    record["locked"] = False
+    document = {"format": "accounts-store-v1", "accounts": {"alice": record}}
+    write_store(store_path, document)
+    return document
+
+
+def test_fr039_a_pre_feature_store_document_loads_with_no_token_state(
+    store_path, write_store
+):
+    """FR-039/A-7: a record with no ``reset_token`` key is valid — absence is normal."""
+    write_store(store_path, PRE_FEATURE_STORE)
+
+    loaded = store.load(store_path)
+
+    assert "reset_token" not in loaded["accounts"]["alice"]
+    assert loaded["format"] == "accounts-store-v1"
+
+
+@pytest.mark.parametrize(
+    "command,username,stdin",
+    ALL_SEVEN_COMMANDS,
+    ids=[row[0] for row in ALL_SEVEN_COMMANDS],
+)
+def test_sc019_all_seven_commands_work_on_a_pre_feature_store(
+    run, store_path, pre_feature_store, command, username, stdin
+):
+    """SC-019: no migration step — every command runs, and none exits 5."""
+    status, out, err = run(["--store", str(store_path), command, username], stdin)
+
+    assert status != 5, f"{command}: pre-feature store rejected ({err!r})"
+    assert not err.startswith(STORE_UNUSABLE), err
+
+
+def test_sc019_a_pre_feature_store_needs_no_migration_and_keeps_its_marker(
+    run, store_path, pre_feature_store, read_store
+):
+    """SC-019/FR-039: the format marker is unchanged by using or rewriting the store."""
+    assert read_store(store_path)["format"] == "accounts-store-v1"
+
+    status, out, err = run(["--store", str(store_path), "reset-token", "alice"])
+    assert status == 0, err
+
+    document = read_store(store_path)
+    assert document["format"] == "accounts-store-v1"
+    # The key appeared because a token was issued, not because of any migration.
+    assert set(document["accounts"]["alice"]) == {
+        "algorithm",
+        "iterations",
+        "salt",
+        "key",
+        "failed_logins",
+        "locked",
+        "reset_token",
+    }
+
+
+def test_sc019_an_account_from_a_pre_feature_store_has_no_token_to_present(
+    run, store_path, pre_feature_store
+):
+    """SC-019: ``reset`` on an account with no token state is ``invalid token`` / 1."""
+    status, out, err = run(
+        ["--store", str(store_path), "reset", "alice"],
+        "any token at all\n" + NEW_PASSWORD + "\n",
+    )
+
+    assert status == 1
+    assert out == ""
+    assert err == "invalid token\n"
