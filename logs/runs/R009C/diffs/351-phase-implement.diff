+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+    age_token(read_store, write_store, store_path, "alice", 899)
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+    assert status == 0, "accepted at 899 seconds old"
+
+    token=[REDACTED:assigned_secret]("alice")
