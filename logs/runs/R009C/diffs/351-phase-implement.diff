+# =====================================================================================
+# FR-042 — stream discipline under every outcome
+# =====================================================================================
+
+#: (id, setup, argv tail for the command under test, stdin, expected status, stream,
+#: exact message).  ``setup`` is a list of (argv tail, stdin) run first on the same store.
+OUTCOME_ROWS = [
+    (
+        "reset-token-success",
+        [(["register", "alice"], GOOD_PASSWORD + "\n")],
+        (["reset-token", "alice"], ""),
+        0,
+        "out",
+        None,  # the token itself — asserted as "one line, non-empty"
+    ),
+    (
+        "reset-token-no-such-account",
+        [],
+        (["reset-token", "nobody"], ""),
+        3,
+        "err",
+        "no such account\n",
+    ),
+    (
+        "reset-token-usage",
+        [],
+        (["reset-token", "alice", "--ttl", "0"], ""),
+        2,
+        "err",
+        USAGE,
+    ),
+    (
+        "reset-no-such-account",
+        [],
+        (["reset", "nobody"], "token\n" + NEW_PASSWORD + "\n"),
+        3,
+        "err",
+        "no such account\n",
+    ),
+    (
+        "reset-invalid-token",
+        [(["register", "alice"], GOOD_PASSWORD + "\n")],
+        (["reset", "alice"], "not-the-token\n" + NEW_PASSWORD + "\n"),
+        1,
+        "err",
+        "invalid token\n",
