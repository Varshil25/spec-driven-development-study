+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+
+    status, out, err = do_reset(run, store_path, "alice", token, SHORT_PASSWORD)
+    assert (status, out, err) == (2, "", "password too short\n")
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+
+    assert status == 0
+    assert out == "password reset\n"
+    assert err == ""
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], NEW_PASSWORD + "\n"
+    )
+    assert status == 0 and out == "ok\n"
+
+
+@pytest.mark.parametrize(
+    "password",
+    [
+        pytest.param("", id="empty"),
