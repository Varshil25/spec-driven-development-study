+        [(["register", "alice"], GOOD_PASSWORD + "\n")],
+        (["reset", "nobody"], "t\n" + NEW_PASSWORD + "\n"),
+        3,
+        "err",
+        "no such account\n",
+    ),
+    (
+        "reset-invalid-token",
+        [(["register", "alice"], GOOD_PASSWORD + "\n")],
+        (["reset", "alice"], "not-the-token\n" + NEW_PASSWORD + "\n"),
+        1,
+        "err",
+        "invalid token\n",
+    ),
+    (
+        "reset-password-too-short",
+        [(["register", "alice"], GOOD_PASSWORD + "\n"), (["reset-token", "alice"], "")],
+        (["reset", "alice"], "\u0000TOKEN\n" + SHORT_PASSWORD + "\n"),
