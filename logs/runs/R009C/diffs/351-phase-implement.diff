+def test_fr041_passwd_keeps_every_observable_behaviour(
+    run, store_path, account, read_store
+):
+    """FR-041/FR-038a: ``passwd``'s only change is a store effect on token state."""
+    account()
+
+    # Unknown account → 3, before any password check (FR-022).
+    status, out, err = call(
+        run, store_path, ["passwd", "nobody"], f"{GOOD_PASSWORD}\n{NEW_PASSWORD}\n"
+    )
+    assert (status, out, err) == (3, "", "no such account\n")
+
+    # Wrong current password → 1, judged before the new one's length (FR-021).
+    status, out, err = call(
+        run, store_path, ["passwd", "alice"], f"{WRONG_PASSWORD}\n{SHORT_PASSWORD}\n"
+    )
+    assert (status, out, err) == (1, "", "invalid credentials\n")
+
+    # Too-short new password → 2.
+    status, out, err = call(
+        run, store_path, ["passwd", "alice"], f"{GOOD_PASSWORD}\n{SHORT_PASSWORD}\n"
+    )
+    assert (status, out, err) == (2, "", "password too short\n")
+
+    # Missing input → 2 (only one line given).
+    status, out, err = call(run, store_path, ["passwd", "alice"], GOOD_PASSWORD + "\n")
+    assert (status, out, err) == (2, "", "missing password input\n")
+
+    # Success → 0 and silence on both streams.
+    status, out, err = call(
+        run, store_path, ["passwd", "alice"], f"{GOOD_PASSWORD}\n{NEW_PASSWORD}\n"
+    )
+    assert (status, out, err) == (0, "", "")
+    status, out, err = call(run, store_path, ["login", "alice"], NEW_PASSWORD + "\n")
+    assert status == 0 and out == "ok\n"
+
