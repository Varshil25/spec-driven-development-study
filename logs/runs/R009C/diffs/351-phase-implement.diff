+        "MSG_INVALID_CREDENTIALS",
+        "MSG_ACCOUNT_LOCKED",
+        "MSG_INVALID_USERNAME",
+        "MSG_PASSWORD_TOO_SHORT",
+        "MSG_USERNAME_EXISTS",
+        "MSG_NO_SUCH_ACCOUNT",
+        "MSG_MISSING_PASSWORD_INPUT",
+        "MSG_PASSWORD_RESET",
