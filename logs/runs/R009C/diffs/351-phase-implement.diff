+
+def age_token(read_store, write_store, store_path, username, seconds):
+    """Rewrite ``issued_at`` so the token is ``seconds`` old (research.md D-015).
+
+    No clock seam is added to runtime code: the store file is the input the real code path
+    reads, so this exercises the shipped comparison rather than a test-only one.
+    """
+    document = read_store(store_path)
+    state = document["accounts"][username]["reset_token"]
+    state["issued_at"] = time.time() - seconds
+    write_store(store_path, document)
+    return state["ttl_seconds"]
+
+
+@pytest.mark.parametrize("ttl", [1, 2, 60, 900, 86400])
+def test_fr036d_a_token_is_accepted_just_before_its_lifetime_elapses(
+    run, store_path, registered, issued_token, read_store, write_store, ttl
+):
+    """FR-036d/SC-013: valid while ``now < issued_at + ttl_seconds``."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice", ttl=ttl)
+    age_token(read_store, write_store, store_path, "alice", ttl - 1)
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+
+    assert status == 0, f"ttl={ttl}: expected acceptance at {ttl - 1}s old ({err!r})"
+    assert out == "password reset\n"
+
+
+@pytest.mark.parametrize("ttl", [1, 2, 60, 900, 86400])
+@pytest.mark.parametrize("extra", [0, 1, 5, 100000])
+def test_fr036d_a_token_is_refused_at_and_after_its_lifetime(
+    run, store_path, registered, issued_token, read_store, write_store, ttl, extra
+):
+    """FR-036d/D-015: the boundary is **exclusive** — at exactly ``ttl`` it is expired."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice", ttl=ttl)
+    age_token(read_store, write_store, store_path, "alice", ttl + extra)
+    before = read_store(store_path)
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+
+    assert status == 1, f"ttl={ttl}, aged {ttl + extra}s: expected refusal"
+    assert out == ""
+    assert err == "invalid token\n"
+    assert read_store(store_path) == before, "FR-036d: expiry needs no write"
+
+
+def test_fr036d_the_default_lifetime_expires_at_900_seconds(
+    run, store_path, registered, issued_token, read_store, write_store
+):
