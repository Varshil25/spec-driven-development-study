+
+# =====================================================================================
+# FR-036d / SC-013 — expiry, in both directions (research.md D-015)
+# =====================================================================================
+
+
+def test_fr036d_a_token_whose_lifetime_elapsed_is_refused_in_real_time(
+    run, store_path, registered, issued_token
+):
+    """FR-036d/acceptance 2.3: ``--ttl 1``, wait, refused. The only test that sleeps."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice", ttl=1)
+
+    time.sleep(1.1)
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+
+    assert status == 1
+    assert out == ""
+    assert err == "invalid token\n"
