+def test_fr034b_verify_token_accepts_only_the_token_behind_the_fingerprint():
+    """FR-034b/T-4: constant-time comparison of fingerprints, not of tokens."""
+    token=[REDACTED:assigned_secret]()
+    fingerprint = hashing.token_fingerprint(token)
+
+    assert hashing.verify_token(fingerprint, token) is True
+    assert hashing.verify_token(fingerprint, hashing.new_token()) is False
+    assert hashing.verify_token(fingerprint, "") is False
+    assert hashing.verify_token(fingerprint, token + " ") is False
+    assert hashing.verify_token(fingerprint, " " + token) is False
+    assert hashing.verify_token(fingerprint, token.upper()) is False
+    # The fingerprint itself is not the token (T-3).
+    assert hashing.verify_token(fingerprint, fingerprint) is False
+
