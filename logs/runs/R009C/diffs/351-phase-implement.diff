+    others = [
+        (["register", "alice"], GOOD_PASSWORD + "\n"),
+        (["register", "bob"], GOOD_PASSWORD + "\n"),
+        (["login", "alice"], GOOD_PASSWORD + "\n"),
+        (["login", "alice"], WRONG_PASSWORD + "\n"),
+        (["unlock", "alice"], ""),
+        (["passwd", "alice"], WRONG_PASSWORD + "\n" + NEW_PASSWORD + "\n"),
+        (["delete", "alice"], WRONG_PASSWORD + "\n"),
+        (["reset", "alice"], "wrong-token\n" + NEW_PASSWORD + "\n"),
+        (["reset", "alice"], f"{token}\n{SHORT_PASSWORD}\n"),
+        (["reset", "nobody"], f"{token}\n{NEW_PASSWORD}\n"),
+        (["reset", "alice", "extra"], f"{token}\n{NEW_PASSWORD}\n"),
+        (["reset", "alice"], f"{token}\n{NEW_PASSWORD}\n"),
+    ]
+    for argv, stdin in others:
+        status, out, err = run(["--store", str(store_path), *argv], stdin)
+        assert token not in out, f"FR-044: {argv} printed the token on stdout"
+        assert token not in err, f"FR-044: {argv} printed the token on stderr"
+
+
+def test_fr044_the_invalid_token_message_does_not_echo_the_presented_token(
+    run, store_path, registered
+):
+    """FR-044: ``invalid token`` is the whole message — the attempt is not echoed."""
+    registered()
+
+    status, out, err = run(
+        ["--store", str(store_path), "reset", "alice"],
+        "a-very-distinctive-attempt\n" + NEW_PASSWORD + "\n",
+    )
