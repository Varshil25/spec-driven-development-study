+"""The success criteria of this feature — SC-010 … SC-020.
+
+Spec: ``specs/002-password-reset/spec.md``.
+
+Criteria already asserted in full elsewhere are **referenced** here rather than duplicated:
+
+* **SC-010** — the shipped suite still passes.  Not a test but a property of the whole run:
+  the only edits to the shipped suite are the two usage-line literals in
+  ``tests/test_cli_contract.py`` and ``tests/test_success_criteria.py`` (research.md D-019),
+  and ``test_sc010_the_shipped_suite_was_edited_in_exactly_two_places`` below pins that.
+* **SC-012** — the 100× single-use sweep lives in
+  ``test_token_lifecycle.py::test_sc012_one_hundred_tokens_each_work_exactly_once``.
+* **SC-013** — expiry in both directions lives in
+  ``test_reset.py::test_fr036d_a_token_is_accepted_just_before_its_lifetime_elapses`` and
+  ``test_reset.py::test_fr036d_a_token_is_refused_at_and_after_its_lifetime``.
+* **SC-014** — the byte search of the store and the fingerprint replay live in
+  ``test_reset_token.py::test_sc014_no_issued_token_appears_in_the_store_bytes_in_any_form``
+  and ``test_reset_token.py::test_sc014_the_recorded_fingerprint_is_not_a_usable_token``.
+* **SC-015** — the 1,000-token entropy and alphabet sweep lives in
+  ``test_reset_token.py::test_fr034a_a_thousand_tokens_are_distinct_long_enough_and_in_the_alphabet``.
+
+What is asserted here: SC-011, SC-016, SC-017, SC-018, SC-019 and SC-020.
+"""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import pytest
+
+from accounts import cli, hashing, store
+
+GOOD_PASSWORD = "correct horse battery"
+WRONG_PASSWORD = "definitely wrong pw!"
+NEW_PASSWORD = "brand new passphrase"
+SHORT_PASSWORD = "elevenchars"
+USAGE = (
+    "usage: python -m accounts --store PATH "
+    "{register|login|unlock|passwd|delete|reset-token|reset} USERNAME "
+    "[--ttl SECONDS]\n"
+)
+STORE_UNUSABLE = "store unusable: "
+REPO_ROOT = Path(__file__).resolve().parent.parent
+
+
+@pytest.fixture()
+def account(run, store_path, low_iterations):
+    def _register(username: str = "alice", password: str = GOOD_PASSWORD) -> None:
+        status, out, err = run(
+            ["--store", str(store_path), "register", username], password + "\n"
+        )
+        assert status == 0, err
+
+    return _register
+
+
+def call(run, store_path, argv, stdin=""):
+    return run(["--store", str(store_path), *argv], stdin)
+
+
+# =====================================================================================
+# SC-010 — the shipped suite is edited in exactly two places
+# =====================================================================================
+
+#: The eight shipped test modules that must not change at all (D-019).
+UNTOUCHED_SHIPPED_MODULES = [
+    "test_register.py",
+    "test_login_lockout.py",
+    "test_unlock.py",
+    "test_passwd.py",
+    "test_delete.py",
+    "test_hashing.py",
+    "test_store_file.py",
+    "conftest.py",
+]
+
+
+@pytest.mark.parametrize("module", UNTOUCHED_SHIPPED_MODULES)
+def test_sc010_no_shipped_module_carries_a_stale_usage_literal(module):
+    """SC-010/D-019: only the two permitted files hold the usage line as a literal.
+
+    A third edit would mean the change had leaked past FR-041; the guard is that no other
+    shipped module pins the usage text at all.  ``test_store_file.py`` asserts it with
+    ``startswith("usage: python -m accounts")``, which the new line still satisfies.
+    """
+    text = (REPO_ROOT / "tests" / module).read_text(encoding="utf-8")
+
+    assert "{register|login|unlock|passwd|delete}" not in text, (
