+"""Tests for ``reset-token`` — FR-032, FR-033, FR-034, FR-034a, FR-034b.
+
+Contract: ``specs/002-password-reset/contracts/cli.md``.
+
+``reset-token USERNAME [--ttl SECONDS]`` prints a fresh single-use token alone on a line of
+stdout and records only its fingerprint.  It reads nothing, derives nothing, touches no
+password material and no lock state, and succeeds whether or not the account is locked.
+
+Message strings are asserted for **equality**, never containment.  The store is compared as
+parsed JSON, with one deliberate exception: SC-014 searches the raw **bytes**, because the
+absence of the token from them is the point.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import time
+from pathlib import Path
+
+import pytest
+
+from accounts import cli, hashing
+
+GOOD_PASSWORD = "correct horse battery"
+WRONG_PASSWORD = "definitely wrong pw!"
+NEW_PASSWORD = "brand new passphrase"
+USAGE = (
+    "usage: python -m accounts --store PATH "
+    "{register|login|unlock|passwd|delete|reset-token|reset} USERNAME "
+    "[--ttl SECONDS]\n"
+)
+
+#: The six fields `reset-token` must leave byte-for-byte alone (FR-032, FR-038).
+UNTOUCHED_FIELDS = (
+    "algorithm",
+    "iterations",
+    "salt",
+    "key",
+    "failed_logins",
+    "locked",
+)
+
+
+@pytest.fixture()
+def registered(run, store_path, low_iterations):
+    """Register an account and return its parsed record getter."""
+
+    def _register(username: str = "alice", password: str = GOOD_PASSWORD) -> None:
+        status, out, err = run(
+            ["--store", str(store_path), "register", username], password + "\n"
+        )
+        assert status == 0, err
+
+    return _register
+
+
+# =====================================================================================
+# FR-032 / FR-034 — issuing a token
+# =====================================================================================
+
+
+def test_fr032_reset_token_prints_exactly_one_line_and_exits_0(
+    run, store_path, registered
+):
+    """FR-032: success is exit 0, one stdout line, nothing on stderr."""
+    registered()
+
+    status, out, err = run(["--store", str(store_path), "reset-token", "alice"])
+
+    assert status == 0
+    assert err == ""
+    assert out.endswith("\n")
+    assert out.count("\n") == 1, f"FR-032: exactly one line, got {out!r}"
+    # No label, no expiry, no blank line — the line is exactly the token.
+    assert out[:-1] == out[:-1].strip()
+    assert out[:-1] != ""
+
+
+def test_fr032_the_record_gains_the_fingerprint_of_the_printed_token(
+    run, store_path, registered, read_store
+):
+    """FR-032/FR-034b: ``token_hash`` is the SHA-256 hex of the printed token."""
+    registered()
+    before = time.time()
+
+    status, out, err = run(["--store", str(store_path), "reset-token", "alice"])
+    after = time.time()
+    assert status == 0, err
+    token = out[:-1]
+
+    record = read_store(store_path)["accounts"]["alice"]
+    state = record["reset_token"]
+    assert state["token_hash"] == hashlib.sha256(token.encode("utf-8")).hexdigest()
+    assert len(state["token_hash"]) == 64
+    assert before - 1 <= state["issued_at"] <= after + 1
+    assert state["ttl_seconds"] == 900, "FR-033: the default lifetime is 900 seconds"
+    assert set(state) == {"token_hash", "issued_at", "ttl_seconds"}
+
+
+def test_fr032_issuing_touches_nothing_else_in_the_record(
+    run, store_path, registered, read_store
+):
+    """FR-032/FR-038: password material, the tally and the lock state are not touched."""
+    registered()
+    before = read_store(store_path)["accounts"]["alice"]
+
+    status, out, err = run(["--store", str(store_path), "reset-token", "alice"])
+    assert status == 0, err
+
+    after = read_store(store_path)["accounts"]["alice"]
+    for field in UNTOUCHED_FIELDS:
+        assert after[field] == before[field], f"FR-032: {field} changed"
+    assert set(after) == set(before) | {"reset_token"}
+
+
+def test_fr032_issuing_leaves_other_accounts_alone(
+    run, store_path, registered, read_store
+):
+    """FR-032: only the named account gains token state."""
+    registered("alice")
+    registered("bob")
+
+    status, out, err = run(["--store", str(store_path), "reset-token", "alice"])
+    assert status == 0, err
+
+    accounts = read_store(store_path)["accounts"]
+    assert "reset_token" in accounts["alice"]
+    assert "reset_token" not in accounts["bob"]
+
+
+def test_fr034_reset_token_reads_nothing_from_standard_input(
+    run, store_path, registered
+):
+    """FR-034: ``reset-token`` reads **0** input lines — a non-empty stdin is untouched."""
+    import io
+
+    registered()
+    stream = io.StringIO("this line must not be read\nnor this one\n", newline=None)
+    out, err = io.StringIO(), io.StringIO()
+
+    status = cli.main(
+        ["--store", str(store_path), "reset-token", "alice"], stream, out, err
+    )
+
+    assert status == 0, err.getvalue()
+    # Nothing was consumed: the first line is still there to read.
+    assert stream.readline() == "this line must not be read\n"
+
+
+def test_fr034_reset_token_succeeds_with_empty_standard_input(
+    run, store_path, registered
