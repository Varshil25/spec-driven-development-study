+"""Tests for ``reset`` — FR-035, FR-036, FR-036a…FR-036f.
+
+Contract: ``specs/002-password-reset/contracts/cli.md``.
+
+``reset USERNAME`` reads two standard-input lines — the token, then the new password — and
+applies FR-036a's check order: existence (3) → token (1) → length (2) → success (0).  On
+success it replaces the password material, clears the lock and the tally, spends the token
+and prints ``password reset``.
+
+Message strings are asserted for **equality**, never containment.
+"""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import pytest
+
+from accounts import hashing
+
+GOOD_PASSWORD = "correct horse battery"
+WRONG_PASSWORD = "definitely wrong pw!"
+NEW_PASSWORD = "brand new passphrase"
+OTHER_PASSWORD = "yet another good one"
+#: Exactly 11 characters — one below MIN_PASSWORD_LENGTH (FR-008).
+SHORT_PASSWORD = "elevenchars"
+
+#: The four fields a successful reset replaces with fresh material (FR-036b).
+MATERIAL_FIELDS = ("algorithm", "iterations", "salt", "key")
+
+
+@pytest.fixture()
+def registered(run, store_path, low_iterations):
+    """Register an account at a low derivation cost (sound because of FR-026b)."""
+
+    def _register(username: str = "alice", password: str = GOOD_PASSWORD) -> None:
+        status, out, err = run(
+            ["--store", str(store_path), "register", username], password + "\n"
+        )
+        assert status == 0, err
+
+    return _register
+
+
+@pytest.fixture()
+def lock_out(run, store_path):
+    """Lock an account by five failed logins (FR-015, L-1)."""
+
+    def _lock(username: str = "alice") -> None:
+        for _ in range(5):
+            status, out, err = run(
+                ["--store", str(store_path), "login", username], WRONG_PASSWORD + "\n"
+            )
+            assert status == 1
+        status, out, err = run(
+            ["--store", str(store_path), "login", username], GOOD_PASSWORD + "\n"
+        )
+        assert status == 4 and err == "account locked\n"
+
+    return _lock
+
+
+def do_reset(run, store_path, username, token, password):
+    """Run ``reset USERNAME`` with the two documented input lines."""
+    return run(
+        ["--store", str(store_path), "reset", username], f"{token}\n{password}\n"
+    )
+
+
+# =====================================================================================
+# FR-035 / FR-036b — the happy path
+# =====================================================================================
+
+
+def test_fr036b_a_valid_token_and_a_good_password_print_password_reset(
+    run, store_path, registered, issued_token
+):
+    """FR-036b: exactly ``password reset\\n`` on stdout, nothing on stderr, exit 0."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+
+    assert status == 0
+    assert out == "password reset\n"
+    assert err == ""
+
+
+def test_fr036b_the_record_is_rewritten_with_fresh_material(
+    run, store_path, registered, issued_token, read_store, low_iterations
+):
+    """FR-036b: new salt and current iterations; tally 0, unlocked, token removed."""
+    registered()
+    before = read_store(store_path)["accounts"]["alice"]
+    token=[REDACTED:assigned_secret]("alice")
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+    assert status == 0, err
+
+    after = read_store(store_path)["accounts"]["alice"]
+    assert after["salt"] != before["salt"], "FR-036b: a fresh salt is drawn"
+    assert after["key"] != before["key"]
+    assert after["iterations"] == hashing.DEFAULT_ITERATIONS
+    assert after["algorithm"] == hashing.ALGORITHM
+    assert after["failed_logins"] == 0
+    assert after["locked"] is False
+    assert "reset_token" not in after, "FR-036b/T-7: the token is spent by removal"
+    assert set(after) == {
+        "algorithm",
+        "iterations",
+        "salt",
+        "key",
+        "failed_logins",
+        "locked",
+    }
+
+
+def test_fr036b_the_new_password_logs_in_and_the_previous_one_does_not(
+    run, store_path, registered, issued_token
+):
+    """FR-036b: ``login`` with the new password is ``ok`` / 0; with the old, 1."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+    assert status == 0, err
+
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], NEW_PASSWORD + "\n"
+    )
+    assert status == 0
+    assert out == "ok\n"
+
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], GOOD_PASSWORD + "\n"
+    )
+    assert status == 1
+    assert err == "invalid credentials\n"
+
+
+def test_fr036b_a_reset_recovers_a_locked_account_with_no_unlock(
+    run, store_path, registered, issued_token, lock_out, read_store
+):
+    """FR-036b/acceptance 1.6/SC-011: the lock is cleared by the reset itself."""
+    registered()
+    lock_out()
+    token=[REDACTED:assigned_secret]("alice")
+    assert read_store(store_path)["accounts"]["alice"]["locked"] is True
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+
+    assert status == 0
+    assert out == "password reset\n"
+    assert err == ""
+    record = read_store(store_path)["accounts"]["alice"]
+    assert record["locked"] is False
+    assert record["failed_logins"] == 0
+
+    # No `unlock` was run anywhere in this test.
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], NEW_PASSWORD + "\n"
+    )
+    assert status == 0
+    assert out == "ok\n"
+
+
+def test_fr036b_a_reset_leaves_other_accounts_alone(
+    run, store_path, registered, issued_token, read_store
+):
+    """FR-036b/SC-019: only the named account is rewritten."""
+    registered("alice")
+    registered("bob")
+    token=[REDACTED:assigned_secret]("alice")
+    before_bob = read_store(store_path)["accounts"]["bob"]
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+    assert status == 0, err
+
+    assert read_store(store_path)["accounts"]["bob"] == before_bob
+
+
+# =====================================================================================
+# FR-035 — the standard-input protocol for the two lines
+# =====================================================================================
+
+
+def test_fr035_input_beyond_the_two_lines_is_ignored(
+    run, store_path, registered, issued_token
+):
+    """FR-035: a third and further line is ignored, not an error."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+
+    status, out, err = run(
+        ["--store", str(store_path), "reset", "alice"],
+        f"{token}\n{NEW_PASSWORD}\nthird line\nfourth line\n",
+    )
+
+    assert status == 0
+    assert out == "password reset\n"
+    assert err == ""
+
+
+def test_fr035_the_two_lines_need_no_trailing_newline_on_the_last(
+    run, store_path, registered, issued_token
+):
+    """FR-035: a final line without a break is still a line (inherited FR-003)."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+
+    status, out, err = run(
+        ["--store", str(store_path), "reset", "alice"], f"{token}\n{NEW_PASSWORD}"
+    )
+
+    assert status == 0
+    assert out == "password reset\n"
+
+
+def test_fr035_a_crlf_terminated_token_line_is_accepted(
+    run, store_path, registered, issued_token
+):
+    """FR-035: ``\\r\\n`` terminates a line exactly as ``\\n`` does (inherited FR-003)."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+
+    status, out, err = run(
+        ["--store", str(store_path), "reset", "alice"],
+        f"{token}\r\n{NEW_PASSWORD}\r\n",
+    )
+
+    assert status == 0
+    assert out == "password reset\n"
+
+
+@pytest.mark.parametrize(
+    "mangle",
+    [
+        pytest.param(lambda t: " " + t, id="leading-space"),
+        pytest.param(lambda t: t + " ", id="trailing-space"),
+        pytest.param(lambda t: " " + t + " ", id="surrounded-by-spaces"),
+        pytest.param(lambda t: "\t" + t, id="leading-tab"),
+    ],
+)
+def test_fr035_a_token_line_with_whitespace_is_taken_verbatim(
+    run, store_path, registered, issued_token, read_store, mangle
+):
+    """FR-035: nothing is stripped, so a padded token is **not** the issued token."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+    before = read_store(store_path)
+
+    status, out, err = do_reset(run, store_path, "alice", mangle(token), NEW_PASSWORD)
+
+    assert status == 1
+    assert out == ""
+    assert err == "invalid token\n"
+    assert read_store(store_path) == before
+
+
+def test_fr035_the_new_password_keeps_its_surrounding_whitespace(
+    run, store_path, registered, issued_token
+):
+    """FR-035: the new password is taken verbatim, spaces included (inherited FR-003)."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+    padded = "  " + NEW_PASSWORD + "  "
+
+    status, out, err = do_reset(run, store_path, "alice", token, padded)
+    assert status == 0, err
+
+    status, out, err = run(["--store", str(store_path), "login", "alice"], padded + "\n")
+    assert status == 0 and out == "ok\n"
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], NEW_PASSWORD + "\n"
+    )
+    assert status == 1, "FR-035: the stripped form is a different password"
+
+
+# =====================================================================================
+# FR-036a / FR-036c / FR-036e — every way a token can be refused (User Story 2)
+# =====================================================================================
+
+
+def test_fr036a_a_different_string_as_the_token_is_refused(
+    run, store_path, registered, issued_token, read_store
+):
+    """FR-036a/acceptance 2.1: ``invalid token`` / 1, stored password unchanged."""
+    registered()
+    issued_token("alice")
+    before = read_store(store_path)
+
+    status, out, err = do_reset(run, store_path, "alice", "not-the-token", NEW_PASSWORD)
+
+    assert status == 1
+    assert out == ""
+    assert err == "invalid token\n"
+    assert read_store(store_path) == before, "FR-036e: a refusal writes nothing at all"
+
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], GOOD_PASSWORD + "\n"
+    )
+    assert status == 0 and out == "ok\n", "the password in force is unchanged"
+
+
+def test_fr036c_a_token_already_used_is_refused_on_a_second_presentation(
+    run, store_path, registered, issued_token
+):
+    """FR-036c/acceptance 2.2: single use — and the first reset's password still stands."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+    assert status == 0, err
+
+    status, out, err = do_reset(run, store_path, "alice", token, OTHER_PASSWORD)
+    assert status == 1
+    assert out == ""
+    assert err == "invalid token\n"
+
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], NEW_PASSWORD + "\n"
+    )
+    assert status == 0 and out == "ok\n", "FR-036c: the second password never took effect"
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], OTHER_PASSWORD + "\n"
+    )
+    assert status == 1
+
+
+def test_fr036a_any_token_on_an_account_that_never_had_one_is_refused(
+    run, store_path, registered, read_store
+):
+    """FR-036a/acceptance 2.4: no outstanding token → ``invalid token`` / 1."""
+    registered()
+    before = read_store(store_path)
+    assert "reset_token" not in before["accounts"]["alice"]
+
+    status, out, err = do_reset(run, store_path, "alice", "anything at all", NEW_PASSWORD)
+
+    assert status == 1
+    assert err == "invalid token\n"
+    assert read_store(store_path) == before
+
+
+def test_fr035_an_empty_token_line_is_invalid_token_not_missing_input(
+    run, store_path, registered, issued_token
+):
+    """FR-035 edge case: an empty line is a token of length 0, which is not the token."""
+    registered()
+    issued_token("alice")
+
+    status, out, err = run(
+        ["--store", str(store_path), "reset", "alice"], f"\n{NEW_PASSWORD}\n"
+    )
+
+    assert status == 1
+    assert out == ""
+    assert err == "invalid token\n", "FR-035: not `missing password input`"
+
+
+def test_fr036a_a_wrong_token_with_a_short_password_exits_1_not_2(
+    run, store_path, registered, issued_token, read_store
+):
+    """FR-036a/acceptance 3.3/D-018: the token is judged **before** the password length."""
+    registered()
+    issued_token("alice")
+    before = read_store(store_path)
+
+    status, out, err = do_reset(run, store_path, "alice", "wrong", SHORT_PASSWORD)
+
+    assert status == 1, "FR-036a: the token decides, so this is 1 and not 2"
+    assert err == "invalid token\n"
+    assert read_store(store_path) == before
+
+
+def test_fr036e_a_refused_attempt_leaves_the_outstanding_token_usable(
+    run, store_path, registered, issued_token, read_store
+):
+    """FR-036e/acceptance 2.5: a failed attempt does not disarm the correct token."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+    armed = read_store(store_path)["accounts"]["alice"]
+
+    for attempt in ("wrong", "", token + "x", token[:-1], token.upper()):
+        status, out, err = do_reset(run, store_path, "alice", attempt, NEW_PASSWORD)
+        assert status == 1, f"{attempt!r}: expected 1, got {status}"
+        assert err == "invalid token\n"
+        after = read_store(store_path)["accounts"]["alice"]
+        assert after == armed, "FR-036e: nothing changed — not the password, tally, lock"
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+    assert status == 0
+    assert out == "password reset\n"
+
+
+def test_fr036e_repeated_wrong_tokens_never_lock_the_account(
+    run, store_path, registered, issued_token, read_store
+):
+    """FR-036e/FR-038: the token path cannot advance the tally or lock anything."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+
+    for index in range(20):
+        status, out, err = do_reset(run, store_path, "alice", f"wrong-{index}", NEW_PASSWORD)
+        assert status == 1
+
+    record = read_store(store_path)["accounts"]["alice"]
+    assert record["failed_logins"] == 0, "FR-038: the tally is not the token's business"
+    assert record["locked"] is False
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], GOOD_PASSWORD + "\n"
+    )
+    assert status == 0, "the account is still usable"
+    # And the token is still armed.
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+    assert status == 0
+
+
+def test_fr032_a_replaced_token_is_refused(run, store_path, registered, issued_token):
+    """FR-032/T-6: issuing again invalidates the older token from that moment."""
+    registered()
+    first = issued_token("alice")
+    second = issued_token("alice")
+
+    status, out, err = do_reset(run, store_path, "alice", first, NEW_PASSWORD)
+    assert status == 1
+    assert err == "invalid token\n"
+
+    status, out, err = do_reset(run, store_path, "alice", second, NEW_PASSWORD)
+    assert status == 0
+    assert out == "password reset\n"
