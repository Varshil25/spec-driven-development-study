@@ -0,0 +1,468 @@
+"""The token lifecycle, row by row — FR-036g, FR-038, FR-038a, FR-038b, FR-041, SC-020.
+
+Contract: the "Token lifecycle, as assertable rows" table of
+``specs/002-password-reset/contracts/cli.md``; meaning: rules T-8 and T-9 of
+``specs/002-password-reset/data-model.md``.
+
+Every row reads "after X, ``reset`` with the token issued earlier yields …".  There are
+exactly five ways a token ends — a successful ``reset`` spends it, a later ``reset-token``
+replaces it, a successful ``passwd`` cancels it, a ``delete`` discards it with the account,
+and its lifetime elapses — and everything else leaves it exactly as it was (T-8, SC-020).
+
+This file also pins FR-041: ``passwd`` and ``delete`` gain a store effect on token state and
+**nothing else** — their arguments, input lines, messages, streams, statuses and effect on
+the password, the tally and the lock state are all unchanged.
+"""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import pytest
+
+GOOD_PASSWORD = "correct horse battery"
+WRONG_PASSWORD = "definitely wrong pw!"
+NEW_PASSWORD = "brand new passphrase"
+OTHER_PASSWORD = "yet another good one"
+THIRD_PASSWORD = "a third fine secret"
+SHORT_PASSWORD = "elevenchars"
+
+
+@pytest.fixture()
+def account(run, store_path, low_iterations):
+    """Register ``alice`` at a low derivation cost (sound because of FR-026b)."""
+
+    def _register(username: str = "alice", password: str = GOOD_PASSWORD) -> None:
+        status, out, err = run(
+            ["--store", str(store_path), "register", username], password + "\n"
+        )
+        assert status == 0, err
+
+    return _register
+
+
+def call(run, store_path, argv, stdin=""):
+    return run(["--store", str(store_path), *argv], stdin)
+
+
+def present(run, store_path, token, username="alice", password=[REDACTED:assigned_secret]):
+    """Present ``token`` to ``reset`` with a valid new password."""
+    return call(run, store_path, ["reset", username], f"{token}\n{password}\n")
+
+
+# =====================================================================================
+# SC-020 / T-8 — the events that END a token
+# =====================================================================================
+#
+# Each event function runs against a store where `alice` exists and `token` is her
+# outstanding token.  It returns nothing; the row's expectation is asserted afterwards.
+
+
+def _event_successful_reset(run, store_path, token, read_store, write_store):
+    status, out, err = present(run, store_path, token, password=[REDACTED:assigned_secret])
+    assert status == 0 and out == "password reset\n", err
+
+
+def _event_later_reset_token(run, store_path, token, read_store, write_store):
+    status, out, err = call(run, store_path, ["reset-token", "alice"])
+    assert status == 0, err
+
+
+def _event_successful_passwd(run, store_path, token, read_store, write_store):
+    status, out, err = call(
+        run, store_path, ["passwd", "alice"], f"{GOOD_PASSWORD}\n{OTHER_PASSWORD}\n"
+    )
+    assert status == 0, err
+
+
+def _event_lifetime_elapsed(run, store_path, token, read_store, write_store):
+    # research.md D-015: the store file is rewritten rather than the clock faked, so the
+    # shipped comparison is the one under test.
+    document = read_store(store_path)
+    state = document["accounts"]["alice"]["reset_token"]
+    state["issued_at"] = time.time() - state["ttl_seconds"] - 1
+    write_store(store_path, document)
+
+
+ENDING_EVENTS = [
+    ("a-successful-reset-spends-it", _event_successful_reset, "FR-036c / T-7"),
+    ("a-later-reset-token-replaces-it", _event_later_reset_token, "FR-032 / T-6"),
+    ("a-successful-passwd-cancels-it", _event_successful_passwd, "FR-038a / A-9"),
+    ("its-lifetime-elapses", _event_lifetime_elapsed, "FR-036d / T-5"),
+]
+
+
+@pytest.mark.parametrize(
+    "event", [row[1] for row in ENDING_EVENTS], ids=[row[0] for row in ENDING_EVENTS]
+)
+def test_sc020_an_ended_token_is_refused(
+    run, store_path, account, issued_token, read_store, write_store, event
+):
+    """SC-020/T-8: each of the four non-``delete`` endings yields ``invalid token`` / 1."""
+    account()
+    token=[REDACTED:assigned_secret]("alice")
+
+    event(run, store_path, token, read_store, write_store)
+    before = read_store(store_path)
+
+    status, out, err = present(run, store_path, token, password=[REDACTED:assigned_secret])
+
+    assert status == 1
+    assert out == ""
+    assert err == "invalid token\n"
+    assert read_store(store_path) == before, "a refusal writes nothing at all"
+
+
+def test_fr036g_a_delete_takes_the_token_with_the_account(
+    run, store_path, account, issued_token
+):
+    """FR-036g/A-8: the account is gone, so the token is reported as ``no such account``.
+
+    The token does not survive its account in any form: with the username absent this is
+    ``no such account`` / 3, and once the username is registered again it is
+    ``invalid token`` / 1 (the next test).  Either way the token never works.
+    """
+    account()
+    token=[REDACTED:assigned_secret]("alice")
+
+    status, out, err = call(run, store_path, ["delete", "alice"], GOOD_PASSWORD + "\n")
+    assert status == 0, err
+
+    status, out, err = present(run, store_path, token)
+
+    assert status == 3
+    assert out == ""
+    assert err == "no such account\n"
+
+
+def test_fr036g_a_token_does_not_survive_a_delete_and_re_register(
+    run, store_path, account, issued_token, read_store
+):
+    """FR-036g/acceptance 4.3: re-registering gives an account with no token state."""
+    account()
+    token=[REDACTED:assigned_secret]("alice")
+    call(run, store_path, ["delete", "alice"], GOOD_PASSWORD + "\n")
+    account("alice", OTHER_PASSWORD)
+
+    record = read_store(store_path)["accounts"]["alice"]
+    assert "reset_token" not in record, "A-8: a fresh account carries no token state"
+
+    status, out, err = present(run, store_path, token)
+
+    assert status == 1
+    assert out == ""
+    assert err == "invalid token\n"
+
+
+# =====================================================================================
+# SC-020 / T-9 — the events that LEAVE a token armed
+# =====================================================================================
+
+
+def _event_refused_reset(run, store_path, token, read_store, write_store):
+    status, out, err = present(run, store_path, "not-the-token")
+    assert status == 1 and err == "invalid token\n"
+
+
+def _event_reset_with_a_short_password(run, store_path, token, read_store, write_store):
+    status, out, err = present(run, store_path, token, password=[REDACTED:assigned_secret])
+    assert status == 2 and err == "password too short\n"
+
+
+def _event_failed_passwd_wrong_current(run, store_path, token, read_store, write_store):
+    status, out, err = call(
+        run, store_path, ["passwd", "alice"], f"{WRONG_PASSWORD}\n{OTHER_PASSWORD}\n"
+    )
+    assert status == 1 and err == "invalid credentials\n"
+
+
+def _event_failed_passwd_short_new(run, store_path, token, read_store, write_store):
+    status, out, err = call(
+        run, store_path, ["passwd", "alice"], f"{GOOD_PASSWORD}\n{SHORT_PASSWORD}\n"
+    )
+    assert status == 2 and err == "password too short\n"
+
+
+def _event_failed_delete(run, store_path, token, read_store, write_store):
+    status, out, err = call(run, store_path, ["delete", "alice"], WRONG_PASSWORD + "\n")
+    assert status == 1 and err == "invalid credentials\n"
+
+
+def _event_register_another_account(run, store_path, token, read_store, write_store):
+    status, out, err = call(
+        run, store_path, ["register", "bob"], GOOD_PASSWORD + "\n"
+    )
+    assert status == 0, err
+
+
+def _event_successful_login(run, store_path, token, read_store, write_store):
+    status, out, err = call(run, store_path, ["login", "alice"], GOOD_PASSWORD + "\n")
+    assert status == 0 and out == "ok\n"
+
+
+def _event_failed_login(run, store_path, token, read_store, write_store):
+    status, out, err = call(run, store_path, ["login", "alice"], WRONG_PASSWORD + "\n")
+    assert status == 1 and err == "invalid credentials\n"
+
+
+def _event_lockout_by_failed_logins(run, store_path, token, read_store, write_store):
+    for _ in range(5):
+        status, out, err = call(
+            run, store_path, ["login", "alice"], WRONG_PASSWORD + "\n"
+        )
+        assert status == 1
+    assert read_store(store_path)["accounts"]["alice"]["locked"] is True
+
+
+def _event_unlock(run, store_path, token, read_store, write_store):
+    _event_lockout_by_failed_logins(run, store_path, token, read_store, write_store)
+    status, out, err = call(run, store_path, ["unlock", "alice"])
+    assert status == 0, err
+
+
+ARMING_EVENTS = [
+    ("a-reset-refused-with-invalid-token", _event_refused_reset, "FR-036e / T-9"),
+    ("a-reset-refused-with-password-too-short", _event_reset_with_a_short_password, "FR-036f"),
+    ("a-failed-passwd-wrong-current", _event_failed_passwd_wrong_current, "FR-038a"),
+    ("a-failed-passwd-short-new", _event_failed_passwd_short_new, "FR-038a"),
+    ("a-failed-delete", _event_failed_delete, "FR-038"),
+    ("a-register-of-another-account", _event_register_another_account, "FR-038"),
+    ("a-successful-login", _event_successful_login, "FR-038"),
+    ("a-failed-login", _event_failed_login, "FR-038"),
+    ("a-lockout-by-failed-logins", _event_lockout_by_failed_logins, "FR-038"),
+    ("an-unlock", _event_unlock, "FR-038"),
+]
+
+
+@pytest.mark.parametrize(
+    "event", [row[1] for row in ARMING_EVENTS], ids=[row[0] for row in ARMING_EVENTS]
+)
+def test_sc020_an_event_that_does_not_end_the_token_leaves_it_usable(
+    run, store_path, account, issued_token, read_store, write_store, event
+):
+    """SC-020/T-9/FR-038: the token still succeeds, and the reset still clears the lock."""
+    account()
+    token=[REDACTED:assigned_secret]("alice")
+    fingerprint = read_store(store_path)["accounts"]["alice"]["reset_token"]
+
+    event(run, store_path, token, read_store, write_store)
+
+    # The token state itself is untouched by the event.
+    assert read_store(store_path)["accounts"]["alice"]["reset_token"] == fingerprint
+
+    status, out, err = present(run, store_path, token, password=[REDACTED:assigned_secret])
+
+    assert status == 0, f"SC-020: the token should still work ({err!r})"
+    assert out == "password reset\n"
+    assert err == ""
+    record = read_store(store_path)["accounts"]["alice"]
+    assert "reset_token" not in record
+    assert record["locked"] is False
+    assert record["failed_logins"] == 0
+
+    status, out, err = call(run, store_path, ["login", "alice"], THIRD_PASSWORD + "\n")
+    assert status == 0 and out == "ok\n"
+
+
+def test_fr038_a_wrong_token_presented_many_times_never_locks_the_account(
+    run, store_path, account, issued_token, read_store
+):
+    """FR-038: the token path cannot advance ``failed_logins`` or set ``locked``."""
+    account()
+    token=[REDACTED:assigned_secret]("alice")
+
+    for index in range(25):
+        status, out, err = present(run, store_path, f"wrong-attempt-{index}")
+        assert status == 1 and err == "invalid token\n"
+
+    record = read_store(store_path)["accounts"]["alice"]
+    assert record["failed_logins"] == 0
+    assert record["locked"] is False
+    assert record["reset_token"] is not None
+
+    status, out, err = present(run, store_path, token)
+    assert status == 0, "the token is still armed after 25 refusals"
+
+
+# =====================================================================================
+# SC-012 / FR-038b — the single-use sweep
+# =====================================================================================
+
+
+def test_sc012_one_hundred_tokens_each_work_exactly_once(
+    run, store_path, account, issued_token, low_iterations
+):
+    """SC-012/FR-038b: 100 first uses succeed, 100 second uses are refused.
+
+    Each invocation runs to completion before the next begins, which is the whole of the
+    concurrency scope FR-038b claims: no inter-process locking is provided and overlapping
+    runs stay out of scope, but no sequence can revive a token whose ``reset`` committed.
+    """
+    account()
+
+    for index in range(100):
+        password = f"passphrase number {index:04d}"
+        token=[REDACTED:assigned_secret]("alice")
+
+        status, out, err = present(run, store_path, token, password=[REDACTED:assigned_secret])
+        assert status == 0, f"{index}: first use must succeed ({err!r})"
+        assert out == "password reset\n"
+
+        status, out, err = present(run, store_path, token, password=[REDACTED:assigned_secret] + "x")
+        assert status == 1, f"{index}: second use must be refused"
+        assert err == "invalid token\n"
+
+        status, out, err = call(run, store_path, ["login", "alice"], password + "\n")
