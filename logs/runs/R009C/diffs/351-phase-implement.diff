+"""The invocation surface of the two new commands — FR-031, FR-037, FR-040, FR-042,
+FR-043, FR-044.
+
+Contract: ``specs/002-password-reset/contracts/cli.md``.
+
+This file asserts the properties that belong to the command-line surface rather than to
+either command's own rules: that all seven command words are accepted and dispatched, that
+the global check order holds, that the stream discipline holds under every outcome, that
+status 4 is never produced, and that a token is printed by exactly one invocation and
+appears in no other output.
+
+Message strings are asserted for **equality**; ``store unusable: `` is asserted as a
+**prefix** plus the specific cause.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from accounts import cli
+
+GOOD_PASSWORD = "correct horse battery"
+WRONG_PASSWORD = "definitely wrong pw!"
+NEW_PASSWORD = "brand new passphrase"
+SHORT_PASSWORD = "elevenchars"
+USAGE = (
+    "usage: python -m accounts --store PATH "
+    "{register|login|unlock|passwd|delete|reset-token|reset} USERNAME "
+    "[--ttl SECONDS]\n"
+)
+STORE_UNUSABLE = "store unusable: "
+NEW_COMMANDS = ["reset-token", "reset"]
+ALL_COMMANDS = [
+    "register",
+    "login",
+    "unlock",
+    "passwd",
+    "delete",
+    "reset-token",
+    "reset",
+]
+
+
+@pytest.fixture()
+def registered(run, store_path, low_iterations):
+    def _register(username: str = "alice", password: str = GOOD_PASSWORD) -> None:
+        status, out, err = run(
+            ["--store", str(store_path), "register", username], password + "\n"
+        )
+        assert status == 0, err
+
+    return _register
+
+
+def stdin_for(command: str, token: str = "sometoken") -> str:
+    """Enough standard input for ``command`` to get past the input-reading stage."""
+    return {
+        "register": GOOD_PASSWORD + "\n",
+        "login": GOOD_PASSWORD + "\n",
+        "unlock": "",
+        "passwd": GOOD_PASSWORD + "\n" + NEW_PASSWORD + "\n",
+        "delete": GOOD_PASSWORD + "\n",
+        "reset-token": "",
+        "reset": token + "\n" + NEW_PASSWORD + "\n",
+    }[command]
+
+
+# =====================================================================================
+# FR-031 — the seven command words
+# =====================================================================================
+
+
+@pytest.mark.parametrize("command", ALL_COMMANDS)
+def test_fr031_all_seven_command_words_are_accepted_by_the_parser(command):
+    """FR-031: each of the seven words parses; nothing else is a command."""
+    parsed = cli._parse_args(["--store", "/tmp/x", command, "alice"])
+
+    assert parsed is not None, f"FR-031: {command!r} was rejected"
+    assert parsed[1] == command
+    assert command in cli.INPUT_LINES
+
+
+@pytest.mark.parametrize("command", ALL_COMMANDS)
+def test_fr031_every_command_word_has_a_handler(command):
+    """FR-031: a parsed command word is a dispatched command word."""
+    assert command in cli._HANDLERS
+    assert callable(cli._HANDLERS[command])
+
+
+@pytest.mark.parametrize(
+    "word",
+    ["reset_token", "resettoken", "Reset", "RESET", "reset-tokens", "resets", "token"],
+)
+def test_fr031_near_misses_are_usage_errors(run, store_path, word):
+    """FR-031: the command words are exact — no aliases and no case folding."""
+    status, out, err = run(["--store", str(store_path), word, "alice"], "x\ny\n")
+
+    assert status == 2
+    assert err == USAGE
+    assert out == ""
+    assert not Path(store_path).exists()
+
+
+@pytest.mark.parametrize("command", NEW_COMMANDS)
+def test_fr034_fr035_the_input_line_counts_are_zero_and_two(command):
+    """FR-034/FR-035: ``reset-token`` reads 0 lines, ``reset`` reads 2."""
+    assert cli.INPUT_LINES["reset-token"] == 0
+    assert cli.INPUT_LINES["reset"] == 2
+
+
+# =====================================================================================
+# FR-040 — the usage line, asserted in full
+# =====================================================================================
+
+
+def test_fr040_the_usage_constant_is_exactly_the_contract_string():
+    """FR-040: the one and only change visible in an existing command's output."""
+    assert cli.USAGE + "\n" == USAGE
+
+
+@pytest.mark.parametrize("command", NEW_COMMANDS)
+@pytest.mark.parametrize(
+    "tail",
+    [
+        pytest.param(["extra"], id="third-positional"),
+        pytest.param(["--nope"], id="unknown-flag"),
+        pytest.param(["--store"], id="dangling-store"),
+        pytest.param([], id="missing-username"),
+    ],
+)
+def test_fr040_a_malformed_invocation_prints_the_full_usage_line(
+    run, store_path, command, tail
+):
+    """FR-040: the exact line on stderr, exit 2, nothing on stdout, no store written."""
+    argv = ["--store", str(store_path), command, "alice", *tail]
+    if tail == []:
+        argv = ["--store", str(store_path), command]
+
+    status, out, err = run(argv, stdin_for(command))
+
+    assert status == 2
+    assert err == USAGE
+    assert out == ""
+    assert not Path(store_path).exists(), "FR-040: no store file created or modified"
+
+
+@pytest.mark.parametrize("command", ALL_COMMANDS)
+def test_fr040_the_new_usage_line_is_what_every_command_prints(run, store_path, command):
+    """FR-040/FR-041: the usage text changed for all seven; the status and stream did not."""
+    status, out, err = run(
+        ["--store", str(store_path), command, "alice", "surplus"], stdin_for(command)
+    )
