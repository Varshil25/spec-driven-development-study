+def test_fr041_delete_keeps_every_observable_behaviour(
+    run, store_path, account, issued_token, read_store
+):
+    """FR-041/FR-036g: ``delete``'s only change is that the token goes with the record."""
+    account()
+    issued_token("alice")
+
+    # Unknown account → 3.
+    status, out, err = call(run, store_path, ["delete", "nobody"], GOOD_PASSWORD + "\n")
+    assert (status, out, err) == (3, "", "no such account\n")
+
+    # Wrong password → 1; the account is retained and the tally is not advanced (L-6).
+    before = read_store(store_path)
+    status, out, err = call(run, store_path, ["delete", "alice"], WRONG_PASSWORD + "\n")
+    assert (status, out, err) == (1, "", "invalid credentials\n")
+    assert read_store(store_path) == before
+
+    # Missing input → 2.
+    status, out, err = call(run, store_path, ["delete", "alice"], "")
+    assert (status, out, err) == (2, "", "missing password input\n")
+
+    # Success → 0, silence, and the record is gone with its token.
+    status, out, err = call(run, store_path, ["delete", "alice"], GOOD_PASSWORD + "\n")
+    assert (status, out, err) == (0, "", "")
+    assert "alice" not in read_store(store_path)["accounts"]
