+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+    assert status == 1, "refused at exactly 900 seconds old"
+    assert err == "invalid token\n"
+
+
+def test_fr036d_an_expired_token_record_stays_on_disk_until_the_account_is_written(
+    run, store_path, registered, issued_token, read_store, write_store
+):
+    """FR-036d/plan.md consequence 2: no sweep — expiry makes no read-only command write."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+    age_token(read_store, write_store, store_path, "alice", 10000)
+    hash_on_disk = read_store(store_path)["accounts"]["alice"]["reset_token"]["token_hash"]
+
+    status, out, err = do_reset(run, store_path, "alice", token, NEW_PASSWORD)
+    assert status == 1
+
+    state = read_store(store_path)["accounts"]["alice"]["reset_token"]
+    assert state["token_hash"] == hash_on_disk, "the stale record is honoured by nothing"
+
+    # "Expired" and "absent" are indistinguishable to a user: a fresh token works.
+    fresh = issued_token("alice")
+    status, out, err = do_reset(run, store_path, "alice", fresh, NEW_PASSWORD)
+    assert status == 0
+
