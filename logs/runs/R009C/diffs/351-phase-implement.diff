+    assert out == ""
+    assert err == "account locked\n"
+
+
+# =====================================================================================
+# SC-016 — every outcome of the two new commands, asserted exactly
+# =====================================================================================
+
+#: (id, setup, (argv tail, stdin), status, stream, exact message or None for "the token").
