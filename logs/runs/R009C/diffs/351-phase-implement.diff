+        ),
+    ],
+)
+def test_sc017_the_correct_token_still_works_after_any_ordering_of_refusals(
+    run, store_path, registered, issued_token, sequence
+):
+    """SC-017: neither refusal mode disarms the token, in any order or combination."""
+    registered()
+    token=[REDACTED:assigned_secret]("alice")
+
+    for step in sequence:
