+def test_sc014_no_issued_token_appears_in_the_store_bytes_in_any_form(
+    run, store_path, registered, issued_token
+):
+    """SC-014/FR-034b: a byte search of the store finds no token, plain, hex or base64.
+
+    One of the two places in the suite where the raw **bytes** are the point (the other is
+    SC-005, no plaintext password).
+    """
+    tokens = []
+    for username in ("alice", "bob", "carol"):
+        registered(username)
+        tokens.append(issued_token(username))
+
+    raw = Path(store_path).read_bytes()
+
+    for token in tokens:
+        encoded = token.encode("utf-8")
+        assert encoded not in raw, "SC-014: the token is in the store in plain form"
+        assert encoded.hex().encode("ascii") not in raw, "SC-014: hex of the token"
+        assert base64.b64encode(encoded) not in raw, "SC-014: base64 of the token"
+        assert base64.b64encode(encoded).rstrip(b"=") not in raw
+        assert base64.urlsafe_b64encode(encoded) not in raw
+        assert base64.b32encode(encoded) not in raw
+        # The raw 32 secret bytes behind the token must not be there either.
+        assert base64.urlsafe_b64decode(token + "=" * (-len(token) % 4)) not in raw
+
