+def test_fr042_each_outcome_writes_to_one_stream_only(
+    run, store_path, low_iterations, setup, under_test, status, stream, message
+):
+    """FR-042: success writes nothing to stderr; failure writes nothing to stdout."""
+    for argv, stdin in setup:
+        run(["--store", str(store_path), *argv], stdin)
+
+    argv, stdin = under_test
+    actual, out, err = run(["--store", str(store_path), *argv], stdin)
+
+    assert actual == status, f"expected {status}, got {actual} ({err!r})"
+    if stream == "out":
+        assert err == "", "FR-042: a success writes nothing to stderr"
+        if message is None:
+            assert out.count("\n") == 1 and out != "\n"
+        else:
+            assert out == message
+    else:
+        assert out == "", "FR-042: a failure writes nothing to stdout"
+        assert err == message
