+    # Passing it as a third positional is a usage error, not an alternative form.
+    status, out, err = run(["--store", str(store_path), "reset", "alice", token], "")
+
+    assert status == 2
+    assert err == USAGE
+
+
+def test_fr044_nothing_new_reads_an_environment_variable_or_writes_outside_the_store(
+    run, store_path, registered, issued_token, monkeypatch, tmp_path
+):
+    """FR-044: ``--ttl`` comes from ``argv``; no hidden I/O and no other file written."""
+    monkeypatch.setenv("ACCOUNTS_TTL", "1")
+    monkeypatch.setenv("TTL", "1")
+    registered()
+
+    before = set(tmp_path.iterdir())
+    token=[REDACTED:assigned_secret]("alice")
