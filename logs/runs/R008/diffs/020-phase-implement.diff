+"""Command-line interface for the bookmark manager."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import sqlite3
+import sys
+from typing import Sequence
+
+from .storage import Bookmark, Store, parse_tags
+
+DEFAULT_DB = "bookmarks.db"
+ALLOWED_SCHEMES = ("http://", "https://")
+
+EXIT_OK = 0
+EXIT_ERROR = 1
+EXIT_BAD_URL = 2
+EXIT_NO_SUCH_BOOKMARK = 3
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="python -m bookmarks",
+        description="Store and query bookmarks in an SQLite database.",
+    )
+    parser.add_argument(
+        "--db",
+        metavar="PATH",
+        default=DEFAULT_DB,
+        help=f"database file to use (default: {DEFAULT_DB})",
+    )
+    commands = parser.add_subparsers(dest="command", metavar="COMMAND")
+    commands.required = True
+
+    add = commands.add_parser("add", help="add a bookmark and print its id")
+    add.add_argument("url", metavar="URL")
+    add.add_argument("--title", default="", help="bookmark title (default: empty)")
+    add.add_argument("--tags", default="", help="comma-separated tags, e.g. python,cli")
+
+    listing = commands.add_parser("list", help="list bookmarks")
+    listing.add_argument("--tag", help="only bookmarks carrying this tag")
+
+    search = commands.add_parser("search", help="search titles and urls")
+    search.add_argument("text", metavar="TEXT")
+
+    delete = commands.add_parser("delete", help="delete a bookmark by id")
+    delete.add_argument("id", metavar="ID", type=int)
+
+    export = commands.add_parser("export", help="export every bookmark")
+    export.add_argument("--format", required=True, choices=("csv", "json"))
+
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = build_parser()
+    args = parser.parse_args(argv)
+
+    try:
+        with Store(args.db) as store:
+            return dispatch(args, store)
+    except sqlite3.Error as exc:
+        print(f"error: could not use database {args.db!r}: {exc}", file=sys.stderr)
+        return EXIT_ERROR
+    except BrokenPipeError:  # e.g. piping into `head`
+        return EXIT_OK
+
+
+def dispatch(args: argparse.Namespace, store: Store) -> int:
+    if args.command == "add":
+        return cmd_add(args, store)
+    if args.command == "list":
+        return print_lines(store.all(args.tag))
+    if args.command == "search":
+        return print_lines(store.search(args.text))
+    if args.command == "delete":
+        return cmd_delete(args, store)
+    if args.command == "export":
+        return cmd_export(args, store)
+    raise AssertionError(f"unhandled command {args.command!r}")
+
+
+def cmd_add(args: argparse.Namespace, store: Store) -> int:
+    if not args.url.startswith(ALLOWED_SCHEMES):
+        print(
+            f"error: url must start with http:// or https://: {args.url}",
+            file=sys.stderr,
+        )
+        return EXIT_BAD_URL
+    bookmark_id = store.add(args.url, args.title, parse_tags(args.tags))
+    print(bookmark_id)
+    return EXIT_OK
+
+
+def cmd_delete(args: argparse.Namespace, store: Store) -> int:
+    if not store.delete(args.id):
+        print(f"error: no bookmark with id {args.id}", file=sys.stderr)
+        return EXIT_NO_SUCH_BOOKMARK
+    return EXIT_OK
+
+
+def cmd_export(args: argparse.Namespace, store: Store) -> int:
+    bookmarks = store.all()
+    if args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("id", "url", "title", "tags"))
+        writer.writerows(bookmark.as_row() for bookmark in bookmarks)
+    else:
+        json.dump([bookmark.as_dict() for bookmark in bookmarks], sys.stdout, indent=2)
+        print()
+    return EXIT_OK
+
+
+def print_lines(bookmarks: list[Bookmark]) -> int:
+    """Print one tab-separated line per bookmark."""
+    for bookmark in bookmarks:
+        print("\t".join(bookmark.as_row()))
+    return EXIT_OK
