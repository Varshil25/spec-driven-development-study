index 0000000..079e2a4
--- /dev/null
+++ b/src/bookmarks/storage.py
@@ -0,0 +1,158 @@
+"""SQLite persistence for bookmarks.
+
+A bookmark is a row in ``bookmarks`` plus zero or more rows in ``tags``.
+Ids are assigned by SQLite with ``AUTOINCREMENT`` so that they start at 1
+and keep increasing even after the most recent bookmark is deleted.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Iterable, Iterator
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS bookmarks (
+    id    INTEGER PRIMARY KEY AUTOINCREMENT,
+    url   TEXT NOT NULL,
+    title TEXT NOT NULL DEFAULT ''
+);
+
+CREATE TABLE IF NOT EXISTS tags (
+    bookmark_id INTEGER NOT NULL REFERENCES bookmarks(id) ON DELETE CASCADE,
+    tag         TEXT NOT NULL,
+    PRIMARY KEY (bookmark_id, tag)
+);
+
+CREATE INDEX IF NOT EXISTS tags_by_tag ON tags(tag);
+"""
+
+
+@dataclass(frozen=True)
+class Bookmark:
+    """One stored bookmark, with its tags in alphabetical order."""
+
+    id: int
+    url: str
+    title: str = ""
+    tags: tuple[str, ...] = field(default=())
+
+    @property
+    def tag_string(self) -> str:
+        """The tags joined with commas, alphabetically."""
+        return ",".join(self.tags)
+
+    def as_row(self) -> tuple[str, str, str, str]:
+        """The four fields used by ``list``, ``search`` and CSV output."""
+        return (str(self.id), self.url, self.title, self.tag_string)
+
+    def as_dict(self) -> dict[str, object]:
+        """The JSON shape: a numeric id and the tags as a list."""
+        return {
+            "id": self.id,
+            "url": self.url,
+            "title": self.title,
+            "tags": list(self.tags),
+        }
+
+
+def parse_tags(raw: str | None) -> tuple[str, ...]:
+    """Turn a comma-separated string such as ``"python, cli"`` into tags.
+
+    Surrounding whitespace is stripped, empty entries are dropped and
+    duplicates are collapsed.  The result is sorted alphabetically.
+    """
+    if not raw:
+        return ()
+    seen = {tag.strip() for tag in raw.split(",")}
+    seen.discard("")
+    return tuple(sorted(seen))
+
+
+class Store:
+    """A bookmark database.  Use it as a context manager."""
+
+    def __init__(self, path: str | Path) -> None:
+        self.path = str(path)
+        self._conn = sqlite3.connect(self.path)
+        self._conn.row_factory = sqlite3.Row
+        self._conn.execute("PRAGMA foreign_keys = ON")
+        with self._conn:
+            self._conn.executescript(SCHEMA)
+
+    def __enter__(self) -> "Store":
+        return self
+
+    def __exit__(self, *exc_info: object) -> None:
+        self.close()
+
+    def close(self) -> None:
+        self._conn.close()
+
+    def add(self, url: str, title: str = "", tags: Iterable[str] = ()) -> int:
+        """Store a bookmark and return its new id."""
+        tags = sorted(set(tags))
+        with self._conn:
+            cursor = self._conn.execute(
+                "INSERT INTO bookmarks (url, title) VALUES (?, ?)", (url, title)
+            )
+            bookmark_id = int(cursor.lastrowid)
+            self._conn.executemany(
+                "INSERT INTO tags (bookmark_id, tag) VALUES (?, ?)",
+                [(bookmark_id, tag) for tag in tags],
+            )
+        return bookmark_id
+
+    def delete(self, bookmark_id: int) -> bool:
+        """Delete a bookmark; return whether it existed."""
+        with self._conn:
+            cursor = self._conn.execute(
+                "DELETE FROM bookmarks WHERE id = ?", (bookmark_id,)
+            )
+        return cursor.rowcount > 0
+
+    def all(self, tag: str | None = None) -> list[Bookmark]:
+        """Every bookmark ordered by id, or only those carrying ``tag``."""
+        if tag is None:
+            rows = self._conn.execute(
+                "SELECT id, url, title FROM bookmarks ORDER BY id"
+            ).fetchall()
+        else:
+            rows = self._conn.execute(
+                "SELECT b.id, b.url, b.title FROM bookmarks AS b "
+                "JOIN tags AS t ON t.bookmark_id = b.id "
+                "WHERE t.tag = ? ORDER BY b.id",
+                (tag,),
+            ).fetchall()
+        return list(self._with_tags(rows))
+
+    def search(self, text: str) -> list[Bookmark]:
+        """Bookmarks whose title or url contains ``text``, ignoring case."""
+        needle = text.casefold()
+        return [
+            bookmark
+            for bookmark in self.all()
+            if needle in bookmark.title.casefold()
+            or needle in bookmark.url.casefold()
+        ]
+
+    def _with_tags(self, rows: Iterable[sqlite3.Row]) -> Iterator[Bookmark]:
+        """Attach each row's tags, using a single extra query."""
+        rows = list(rows)
+        if not rows:
+            return
+        tags: dict[int, list[str]] = {row["id"]: [] for row in rows}
+        placeholders = ",".join("?" * len(tags))
+        for tag_row in self._conn.execute(
+            f"SELECT bookmark_id, tag FROM tags WHERE bookmark_id IN ({placeholders})",
+            tuple(tags),
+        ):
+            tags[tag_row["bookmark_id"]].append(tag_row["tag"])
+        for row in rows:
+            yield Bookmark(
+                id=row["id"],
+                url=row["url"],
+                title=row["title"],
+                tags=tuple(sorted(tags[row["id"]])),
+            )
diff --git a/tests/test_bookmarks.py b/tests/test_bookmarks.py
new file mode 100644
index 0000000..fa5ee0a
