+++ b/tests/test_bookmarks.py
@@ -0,0 +1,287 @@
+"""End-to-end tests for the bookmarks CLI.
+
+Each test drives the real command line (``python -m bookmarks``) in a
+temporary directory, so exit statuses and stream separation are covered
+exactly as a user would see them.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[1] / "src"
+TAB = "\t"
+
+
+@pytest.fixture
+def run(tmp_path):
+    """Return a helper that runs the CLI inside a fresh temporary cwd."""
+    env = dict(os.environ)
+    existing = env.get("PYTHONPATH")
+    env["PYTHONPATH"] = str(SRC) + (os.pathsep + existing if existing else "")
+
+    def _run(*args: str) -> subprocess.CompletedProcess:
+        return subprocess.run(
+            [sys.executable, "-m", "bookmarks", *args],
+            cwd=tmp_path,
+            env=env,
+            capture_output=True,
+            text=True,
+        )
+
+    _run.tmp_path = tmp_path
+    return _run
+
+
+@pytest.fixture
+def db(run):
+    """A helper bound to an explicit ``--db`` path."""
+
+    def _db(*args: str) -> subprocess.CompletedProcess:
+        return run("--db", "b.db", *args)
+
+    return _db
+
+
+def ok(result: subprocess.CompletedProcess) -> str:
+    assert result.returncode == 0, result.stderr
+    return result.stdout
+
+
+# --- add ----------------------------------------------------------------
+
+
+def test_add_prints_ids_starting_at_one(db):
+    assert ok(db("add", "https://a.example")) == "1\n"
+    assert ok(db("add", "http://b.example")) == "2\n"
+    assert ok(db("add", "https://c.example")) == "3\n"
+
+
+@pytest.mark.parametrize(
+    "url",
+    ["ftp://example.com", "example.com", "javascript:alert(1)", "", "//example.com"],
+)
+def test_add_rejects_non_http_urls(db, url):
+    result = db("add", url)
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr.strip() != ""
+
+
+def test_rejected_url_is_not_stored(db):
+    db("add", "ftp://example.com")
+    assert ok(db("list")) == ""
+    assert ok(db("add", "https://a.example")) == "1\n"
+
+
+def test_title_defaults_to_empty_and_tags_optional(db):
+    db("add", "https://a.example")
+    assert ok(db("list")) == f"1{TAB}https://a.example{TAB}{TAB}\n"
+
+
+# --- list ---------------------------------------------------------------
+
+
+def test_list_is_ordered_by_id_with_sorted_tags(db):
+    db("add", "https://docs.python.org", "--title", "Python docs",
+       "--tags", "python,docs")
+    db("add", "https://example.com")
+    assert ok(db("list")) == (
+        f"1{TAB}https://docs.python.org{TAB}Python docs{TAB}docs,python\n"
+        f"2{TAB}https://example.com{TAB}{TAB}\n"
+    )
+
+
+def test_list_filters_by_tag(db):
+    db("add", "https://a.example", "--title", "A", "--tags", "python,cli")
+    db("add", "https://b.example", "--title", "B", "--tags", "docs")
+    db("add", "https://c.example", "--title", "C", "--tags", "cli")
+    assert ok(db("list", "--tag", "cli")) == (
+        f"1{TAB}https://a.example{TAB}A{TAB}cli,python\n"
+        f"3{TAB}https://c.example{TAB}C{TAB}cli\n"
+    )
+    assert ok(db("list", "--tag", "nothing")) == ""
+
+
+def test_list_on_empty_database_succeeds(db):
+    assert ok(db("list")) == ""
+
+
+def test_tags_are_trimmed_deduplicated_and_blanks_dropped(db):
+    db("add", "https://a.example", "--tags", " python , docs ,, python,")
+    assert ok(db("list")).endswith(f"{TAB}docs,python\n")
+
+
+# --- search -------------------------------------------------------------
+
+
+def test_search_is_case_insensitive_over_title_and_url(db):
+    db("add", "https://docs.python.org", "--title", "Python docs",
+       "--tags", "python,docs")
+    db("add", "https://example.com", "--title", "Example")
+    expected = f"1{TAB}https://docs.python.org{TAB}Python docs{TAB}docs,python\n"
+    assert ok(db("search", "PYTHON")) == expected
+    assert ok(db("search", "python")) == expected
+    assert ok(db("search", "DOCS.PYTHON")) == expected  # matches the url
+    assert ok(db("search", "exam")) == f"2{TAB}https://example.com{TAB}Example{TAB}\n"
+
+
+def test_search_orders_by_id_and_can_match_nothing(db):
+    for host in ("c", "a", "b"):
+        db("add", f"https://{host}.example", "--title", "shared")
+    assert [line.split(TAB)[0] for line in ok(db("search", "shared")).splitlines()] == [
+        "1",
+        "2",
+        "3",
+    ]
+    assert ok(db("search", "absent")) == ""
+
+
+# --- delete -------------------------------------------------------------
+
+
+def test_delete_removes_bookmark(db):
+    db("add", "https://a.example")
+    db("add", "https://b.example")
+    assert ok(db("delete", "1")) == ""
+    assert ok(db("list")) == f"2{TAB}https://b.example{TAB}{TAB}\n"
+
+
+def test_delete_unknown_id_exits_three(db):
+    db("add", "https://a.example")
+    result = db("delete", "99")
+    assert result.returncode == 3
+    assert result.stdout == ""
+    assert result.stderr.strip() != ""
+
+
+def test_delete_twice_reports_missing(db):
+    db("add", "https://a.example")
+    assert db("delete", "1").returncode == 0
+    assert db("delete", "1").returncode == 3
+
+
+def test_ids_keep_increasing_after_delete(db):
+    db("add", "https://a.example")
+    db("add", "https://b.example")
+    db("delete", "2")
+    assert ok(db("add", "https://c.example")) == "3\n"
+
+
+def test_delete_removes_tags_so_they_stop_matching(db):
+    db("add", "https://a.example", "--tags", "python")
+    db("delete", "1")
+    db("add", "https://b.example")
+    assert ok(db("list", "--tag", "python")) == ""
+    assert ok(db("export", "--format", "json")).count("python") == 0
+
+
+# --- export -------------------------------------------------------------
+
+
+def test_export_csv(db):
+    db("add", "https://docs.python.org", "--title", "Python docs",
+       "--tags", "python,docs")
+    db("add", "https://example.com")
+    rows = list(csv.reader(io.StringIO(ok(db("export", "--format", "csv")))))
+    assert rows == [
+        ["id", "url", "title", "tags"],
+        ["1", "https://docs.python.org", "Python docs", "docs,python"],
+        ["2", "https://example.com", "", ""],
+    ]
+
+
+def test_export_csv_header_only_when_empty(db):
+    assert ok(db("export", "--format", "csv")).splitlines() == ["id,url,title,tags"]
+
+
+def test_export_csv_quotes_commas_and_titles(db):
+    db("add", "https://a.example", "--title", 'He said "hi", loudly',
+       "--tags", "b,a")
+    rows = list(csv.reader(io.StringIO(ok(db("export", "--format", "csv")))))
+    assert rows[1] == ["1", "https://a.example", 'He said "hi", loudly', "a,b"]
+
+
+def test_export_json(db):
+    db("add", "https://docs.python.org", "--title", "Python docs",
+       "--tags", "python,docs")
+    db("add", "https://example.com")
+    assert json.loads(ok(db("export", "--format", "json"))) == [
+        {
+            "id": 1,
+            "url": "https://docs.python.org",
+            "title": "Python docs",
+            "tags": ["docs", "python"],
+        },
+        {"id": 2, "url": "https://example.com", "title": "", "tags": []},
+    ]
+
+
+def test_export_json_empty_is_empty_array(db):
+    assert json.loads(ok(db("export", "--format", "json"))) == []
+
+
+def test_export_requires_a_known_format(db):
+    assert db("export").returncode != 0
+    assert db("export", "--format", "yaml").returncode != 0
+
+
+# --- database handling --------------------------------------------------
+
+
+def test_default_database_is_created_in_cwd(run):
+    assert ok(run("add", "https://a.example")) == "1\n"
+    assert (run.tmp_path / "bookmarks.db").is_file()
+
+
+def test_bookmarks_persist_between_runs_and_databases_are_separate(run):
+    ok(run("--db", "one.db", "add", "https://one.example"))
+    ok(run("--db", "two.db", "add", "https://two.example"))
+    assert ok(run("--db", "one.db", "list")) == f"1{TAB}https://one.example{TAB}{TAB}\n"
+    assert ok(run("--db", "two.db", "list")) == f"1{TAB}https://two.example{TAB}{TAB}\n"
+
+
+def test_database_in_nested_missing_directory_reports_error(run):
+    result = run("--db", "no/such/dir/b.db", "add", "https://a.example")
+    assert result.returncode != 0
+    assert result.stderr.strip() != ""
+
+
+def test_unknown_command_fails(run):
+    assert run("frobnicate").returncode != 0
+    assert run().returncode != 0
+
+
+# --- unicode / odd input ------------------------------------------------
+
+
+def test_search_handles_unicode_case_folding(db):
+    db("add", "https://a.example", "--title", "Straße Übung")
+    assert ok(db("search", "übung")).startswith("1" + TAB)
+
+
+def test_title_and_tags_with_unicode_round_trip(db):
+    db("add", "https://a.example", "--title", "日本語", "--tags", "日本,語")
+    assert ok(db("list")) == f"1{TAB}https://a.example{TAB}日本語{TAB}日本,語\n"
+
+
+# --- storage unit tests -------------------------------------------------
+
+
+def test_parse_tags():
+    sys.path.insert(0, str(SRC))
+    from bookmarks.storage import parse_tags
+
+    assert parse_tags(None) == ()
+    assert parse_tags("") == ()
+    assert parse_tags(",,") == ()
+    assert parse_tags("b,a") == ("a", "b")
+    assert parse_tags(" b , a , a ") == ("a", "b")