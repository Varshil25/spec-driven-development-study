+def add_bookmarks(conn, records):
+    """Insert every ``(url, title, tags)`` in `records` and return how many rows that added.
+
+    One ``executemany`` and one ``commit`` — deliberately not a loop over ``add_bookmark``,
+    which commits per row: a ``sqlite3.Error`` part way through therefore cannot leave half an
+    import behind, and rolling the transaction back restores ``sqlite_sequence`` as well, so the
+    highest id ever used is unchanged (FR-037, research.md D10).
+
+    `records` is ordered as the imported file orders its bookmarks, so the ids SQLite assigns
+    follow file order (FR-025). Each `tags` value is already normalised by the caller, exactly
+    as for ``add_bookmark`` (FR-032). An empty `records` inserts nothing and returns 0 (FR-038).
+    """
+    cursor = conn.executemany(
+        "INSERT INTO bookmarks (url, title, tags) VALUES (?, ?, ?)",
+        records,
+    )
+    conn.commit()
+    return cursor.rowcount
+
