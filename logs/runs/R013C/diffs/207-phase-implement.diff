+"""Tests for the ``import`` command: FR-024…FR-038.
+
+Covers the command surface (FR-024, FR-026), the CSV input shape (FR-027, FR-028, FR-029),
+the JSON input shape (FR-030, FR-031), add-equivalence and id assignment (FR-025, FR-032,
+FR-033), every rejection path with an untouched store (FR-034, FR-035, FR-036, FR-037) and the
+empty-input success (FR-038).
+
+Fixtures ``db_path``, ``run`` and ``run_cli`` come from ``tests/conftest.py`` unmodified
+(research.md D19); import files are written into pytest's ``tmp_path``.
+"""
+
+import json
+import os
+
+HEADER = "id,url,title,tags\n"
+
+TWO_ROW_CSV = HEADER + (
+    "1,https://docs.python.org,Python docs,\"docs,python\"\n"
+    "2,https://example.com,Example,\n"
+)
+
+TWO_ELEMENT_JSON = json.dumps(
+    [
+        {"url": "https://docs.python.org", "title": "Python docs", "tags": ["docs", "python"]},
+        {"url": "https://example.com", "title": "Example", "tags": []},
+    ]
+)
+
+
+def write_file(tmp_path, name, text):
+    """Write `text` to `name` inside `tmp_path` as UTF-8 and return the path."""
+    path = tmp_path / name
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+def exported(run, db_path):
+    """The store as ``export --format json`` sees it: a list of id/url/title/tags dicts."""
+    status, out, err = run("--db", db_path, "export", "--format", "json")
+    assert status == 0, err
+    return json.loads(out)
+
+
+def listing(run, db_path):
+    """The raw bytes of ``list`` for this store, used for before/after comparisons."""
+    status, out, err = run("--db", db_path, "list")
+    assert status == 0, err
+    return out
+
+
+# --------------------------------------------------------------------------------------------
+# T006 — command surface (FR-024, FR-026)
+# --------------------------------------------------------------------------------------------
+
+
+def test_import_accepts_csv_and_json_formats(run_cli, tmp_path):
+    """FR-024, FR-026: ``import FILE --format csv|json`` is accepted and prints only the count.
+
+    Run through the real ``python -m bookmarks`` so the exit status and the separation of
+    stdout from stderr are observed exactly as a user sees them.
+    """
+    csv_file = write_file(tmp_path, "two.csv", TWO_ROW_CSV)
+    json_file = write_file(tmp_path, "two.json", TWO_ELEMENT_JSON)
+
+    for import_file, fmt, store in [
+        (csv_file, "csv", tmp_path / "from-csv.db"),
+        (json_file, "json", tmp_path / "from-json.db"),
+    ]:
+        status, out, err = run_cli("--db", store, "import", import_file, "--format", fmt)
+        assert status == 0
+        assert out == "imported 2\n"
+        assert err == ""
+
+
+def test_import_requires_file_and_format(run_cli, tmp_path):
+    """FR-024: a missing FILE and a missing --format are usage errors exiting 1."""
+    csv_file = write_file(tmp_path, "two.csv", TWO_ROW_CSV)
+    store = tmp_path / "unused.db"
+
+    status, out, err = run_cli("--db", store, "import", "--format", "csv")
+    assert status == 1
+    assert out == ""
+    assert err != ""
+
+    status, out, err = run_cli("--db", store, "import", csv_file)
+    assert status == 1
+    assert out == ""
+    assert err != ""
+
+
+def test_import_format_html_and_xml_are_usage_errors(run_cli, tmp_path):
+    """FR-024: ``--format html``/``xml`` exit 1 — a usage error, not a rejected file.
+
+    HTML is export-only (contracts/import-command.md "Invocation"), so the value never reaches
+    the handler and cannot produce status 2.
+    """
+    csv_file = write_file(tmp_path, "two.csv", TWO_ROW_CSV)
+    store = tmp_path / "unused.db"
+
+    for fmt in ["html", "xml"]:
+        status, out, err = run_cli("--db", store, "import", csv_file, "--format", fmt)
+        assert status == 1
+        assert out == ""
+        assert err != ""
+    assert not store.exists()
+
+
+# --------------------------------------------------------------------------------------------
+# T007 — CSV input (FR-027, FR-028, FR-029)
+# --------------------------------------------------------------------------------------------
+
+
+def test_csv_header_must_be_exact(run, db_path, tmp_path):
+    """FR-027, FR-035: only the exact header ``id,url,title,tags`` is accepted."""
+    good = write_file(tmp_path, "good.csv", TWO_ROW_CSV)
+    status, out, err = run("--db", db_path, "import", good, "--format", "csv")
+    assert status == 0
+    assert out == "imported 2\n"
+
+    bad_headers = {
+        "missing-id.csv": "url,title,tags\nhttps://example.com,Example,\n",
+        "spaced.csv": "id, url, title, tags\n1,https://example.com,Example,\n",
+        "empty.csv": "",
+    }
+    for name, text in bad_headers.items():
+        path = write_file(tmp_path, name, text)
+        store = tmp_path / f"{name}.db"
+        status, out, err = run("--db", store, "import", path, "--format", "csv")
+        assert status == 2, name
+        assert out == ""
+        assert "id,url,title,tags" in err
+
+
+def test_csv_row_must_have_exactly_four_fields(run, tmp_path):
+    """FR-027, FR-035: a 3-field and a 5-field row are rejected, naming row and count."""
+    three = write_file(tmp_path, "three.csv", HEADER + "1,https://example.com,Example\n")
+    status, out, err = run("--db", tmp_path / "a.db", "import", three, "--format", "csv")
+    assert status == 2
+    assert out == ""
+    assert "row 2" in err and "3" in err
+
+    five = write_file(tmp_path, "five.csv", HEADER + "1,https://example.com,Example,,extra\n")
+    status, out, err = run("--db", tmp_path / "b.db", "import", five, "--format", "csv")
+    assert status == 2
+    assert out == ""
+    assert "row 2" in err and "5" in err
+
+
+def test_csv_blank_line_is_rejected_and_trailing_newline_is_accepted(run, tmp_path):
+    """FR-027, FR-035: a blank line is a zero-field row; one trailing newline is normal."""
+    blank = write_file(
+        tmp_path,
+        "blank.csv",
+        HEADER + "1,https://example.com,Example,\n\n2,https://other.com,Other,\n",
+    )
+    status, out, err = run("--db", tmp_path / "a.db", "import", blank, "--format", "csv")
+    assert status == 2
+    assert out == ""
+    assert "row 3" in err and "0" in err
+
+    status, out, err = run("--db", tmp_path / "b.db", "import",
+                           write_file(tmp_path, "trailing.csv", TWO_ROW_CSV), "--format", "csv")
+    assert status == 0
+    assert out == "imported 2\n"
+
+
+def test_csv_id_column_is_ignored(run, db_path, tmp_path):
+    """FR-027, FR-033: the id column is parsed and discarded; the store assigns ids."""
+    path = write_file(
+        tmp_path,
+        "ids.csv",
+        HEADER + "99,https://a.com,A,\n100,https://b.com,B,\n",
+    )
+    status, out, _ = run("--db", db_path, "import", path, "--format", "csv")
+    assert status == 0
+    assert out == "imported 2\n"
+    assert [row["id"] for row in exported(run, db_path)] == [1, 2]
+
+
+def test_csv_tags_follow_the_add_rules(run, db_path, tmp_path):
+    """FR-028: CSV tags are trimmed, emptied, de-duplicated and stored alphabetically."""
+    path = write_file(
+        tmp_path,
+        "tags.csv",
+        HEADER
+        + '1,https://a.com,A," python , , docs "\n'
+        + '2,https://b.com,B,"notes,notes"\n'
+        + '3,https://c.com,C,""\n',
+    )
+    status, _, err = run("--db", db_path, "import", path, "--format", "csv")
+    assert status == 0, err
+    assert [row["tags"] for row in exported(run, db_path)] == [
+        ["docs", "python"],
+        ["notes"],
+        [],
+    ]
+
+
+def test_csv_quoting_round_trips_field_values(run, db_path, tmp_path):
+    """FR-029: a title holding a comma, a doubled quote and a newline reads back verbatim."""
+    title = 'A, "quoted"\nsecond line'
+    path = write_file(
+        tmp_path,
+        "quoted.csv",
+        HEADER + '1,https://a.com,"A, ""quoted""\nsecond line",\n',
+    )
+    status, out, err = run("--db", db_path, "import", path, "--format", "csv")
+    assert status == 0, err
+    assert out == "imported 1\n"
+    assert exported(run, db_path)[0]["title"] == title
+
+
+# --------------------------------------------------------------------------------------------
+# T008 — JSON input (FR-030, FR-031)
+# --------------------------------------------------------------------------------------------
+
+
+def test_json_array_of_objects_is_accepted(run, db_path, tmp_path):
+    """FR-030: an array of objects with url, title and tags imports."""
+    path = write_file(tmp_path, "two.json", TWO_ELEMENT_JSON)
+    status, out, err = run("--db", db_path, "import", path, "--format", "json")
+    assert status == 0, err
+    assert out == "imported 2\n"
+    rows = exported(run, db_path)
+    assert [(r["url"], r["title"], r["tags"]) for r in rows] == [
+        ("https://docs.python.org", "Python docs", ["docs", "python"]),
+        ("https://example.com", "Example", []),
+    ]
+
+
+def test_json_ill_shaped_input_is_rejected(run, tmp_path):
+    """FR-030, FR-035: a wrong top level, element or key type exits 2 with an empty stdout."""
+    cases = {
+        "object.json": '{"url": "https://a.com", "title": "A", "tags": []}',
+        "scalar.json": "42",
+        "string.json": '"hello"',
+        "null.json": "null",
+        "element-scalar.json": '["https://a.com"]',
+        "no-url.json": '[{"title": "A", "tags": []}]',
+        "no-title.json": '[{"url": "https://a.com", "tags": []}]',
+        "no-tags.json": '[{"url": "https://a.com", "title": "A"}]',
+        "url-number.json": '[{"url": 7, "title": "A", "tags": []}]',
+        "title-number.json": '[{"url": "https://a.com", "title": 7, "tags": []}]',
+        "tags-string.json": '[{"url": "https://a.com", "title": "A", "tags": "docs"}]',
+        "tags-number.json": '[{"url": "https://a.com", "title": "A", "tags": ["ok", 7]}]',
+        "truncated.json": '[{"url": "https://a.com"',
+    }
+    for name, text in cases.items():
+        path = write_file(tmp_path, name, text)
+        store = tmp_path / f"{name}.db"
+        status, out, err = run("--db", store, "import", path, "--format", "json")
+        assert status == 2, name
+        assert out == "", name
+        assert err.startswith("error: "), name
+        assert "Traceback" not in err
+        assert not store.exists(), name
+
+
+def test_json_element_diagnostic_names_index_and_key(run, tmp_path):
+    """FR-030, FR-035: the diagnostic names the zero-based element index and the key at fault."""
+    path = write_file(
+        tmp_path,
+        "second-bad.json",
+        '[{"url": "https://a.com", "title": "A", "tags": []},'
+        ' {"url": "https://b.com", "title": "B", "tags": "docs"}]',
+    )
+    status, _, err = run("--db", tmp_path / "a.db", "import", path, "--format", "json")
+    assert status == 2
+    assert "1" in err and "tags" in err
+
+
+def test_json_malformed_text_names_line_and_column(run, tmp_path):
+    """FR-035: a JSON parse error is reported with its line and column."""
+    path = write_file(tmp_path, "broken.json", "[{,}]")
+    status, _, err = run("--db", tmp_path / "a.db", "import", path, "--format", "json")
+    assert status == 2
+    assert "line" in err and "column" in err
+
+
+def test_json_ignores_id_and_unknown_keys(run, db_path, tmp_path):
+    """FR-031: an element carrying ``id`` plus an unknown key imports, the id ignored."""
+    path = write_file(
+        tmp_path,
+        "extra.json",
+        json.dumps(
+            [
+                {
+                    "id": 99,
+                    "url": "https://a.com",
+                    "title": "A",
+                    "tags": ["docs"],
+                    "favourite": True,
+                }
+            ]
+        ),
+    )
+    status, out, err = run("--db", db_path, "import", path, "--format", "json")
+    assert status == 0, err
+    assert out == "imported 1\n"
+    assert exported(run, db_path) == [
+        {"id": 1, "url": "https://a.com", "title": "A", "tags": ["docs"]}
+    ]
+
+
+def test_json_tags_follow_the_add_rules(run, db_path, tmp_path):
+    """FR-028, FR-032: JSON tag arrays are de-duplicated and stored alphabetically."""
+    path = write_file(
+        tmp_path,
+        "tags.json",
+        json.dumps(
+            [
+                {"url": "https://a.com", "title": "A", "tags": ["python", "docs"]},
+                {"url": "https://b.com", "title": "B", "tags": ["docs", "docs"]},
+                {"url": "https://c.com", "title": "C", "tags": []},
+            ]
+        ),
+    )
+    status, _, err = run("--db", db_path, "import", path, "--format", "json")
+    assert status == 0, err
+    assert [row["tags"] for row in exported(run, db_path)] == [
+        ["docs", "python"],
+        ["docs"],
+        [],
+    ]
+
+
+# --------------------------------------------------------------------------------------------
+# T009 — add-equivalence and ids (FR-025, FR-032, FR-033)
+# --------------------------------------------------------------------------------------------
+
+
+def test_import_assigns_ids_in_file_order(run, db_path, tmp_path):
+    """FR-025: bookmarks are added in the order the file lists them."""
+    path = write_file(
+        tmp_path,
+        "order.csv",
+        HEADER + "1,https://zebra.com,Zebra,\n2,https://apple.com,Apple,\n",
+    )
+    status, _, err = run("--db", db_path, "import", path, "--format", "csv")
+    assert status == 0, err
+    assert [(r["id"], r["url"]) for r in exported(run, db_path)] == [
+        (1, "https://zebra.com"),
+        (2, "https://apple.com"),
+    ]
+
+
+def test_import_continues_after_the_highest_id_used(run, db_path, tmp_path):
+    """FR-033: a store holding ids 1–2 continues at 3, 4, whatever ids the file carries."""
+    assert run("--db", db_path, "add", "https://one.com")[0] == 0
+    assert run("--db", db_path, "add", "https://two.com")[0] == 0
+
+    path = write_file(
+        tmp_path,
+        "continue.csv",
+        HEADER + "99,https://three.com,Three,\n100,https://four.com,Four,\n",
+    )
+    status, _, err = run("--db", db_path, "import", path, "--format", "csv")
+    assert status == 0, err
+    assert [r["id"] for r in exported(run, db_path)] == [1, 2, 3, 4]
+
+
+def test_import_never_reuses_a_deleted_id(run, db_path, tmp_path):
+    """FR-032, FR-033: after deleting the highest id, a later import does not reuse it."""
+    assert run("--db", db_path, "add", "https://one.com")[0] == 0
+    assert run("--db", db_path, "add", "https://two.com")[0] == 0
+    assert run("--db", db_path, "delete", "2")[0] == 0
+
+    path = write_file(tmp_path, "after-delete.csv", HEADER + "1,https://three.com,Three,\n")
+    status, _, err = run("--db", db_path, "import", path, "--format", "csv")
+    assert status == 0, err
+    assert [r["id"] for r in exported(run, db_path)] == [1, 3]
+
+
+def test_imported_bookmark_equals_the_added_one_field_for_field(run, tmp_path):
+    """FR-032: an imported bookmark is identical to the one ``add`` would have created.
+
+    Covers the verbatim title (blank, whitespace-only, non-ASCII), the tag rules and duplicate
+    URLs kept as distinct bookmarks.
+    """
+    bookmarks = [
+        ("https://a.com", "", ""),
+        ("https://b.com", "   ", "python, docs"),
+        ("https://c.com", "Café ☕ — notes", "café"),
+        ("https://a.com", "A again", ""),
+    ]
+
+    added_store = tmp_path / "added.db"
+    for url, title, tags in bookmarks:
+        status, _, err = run("--db", added_store, "add", url, "--title", title, "--tags", tags)
+        assert status == 0, err
+
+    imported_store = tmp_path / "imported.db"
+    path = write_file(
+        tmp_path,
+        "equivalence.json",
+        json.dumps(
+            [
+                {
+                    "url": url,
+                    "title": title,
+                    "tags": [tag.strip() for tag in tags.split(",") if tag.strip()],
+                }
+                for url, title, tags in bookmarks
+            ]
+        ),
+    )
+    status, out, err = run("--db", imported_store, "import", path, "--format", "json")
+    assert status == 0, err
+    assert out == "imported 4\n"
+
+    assert exported(run, imported_store) == exported(run, added_store)
+
+
+def test_import_rejects_a_url_add_would_reject(run, db_path, tmp_path):
+    """FR-032, FR-036: the URL prefix rule is the same rule ``add`` applies."""
+    path = write_file(tmp_path, "bad-url.csv", HEADER + "1,ftp://nope.com,Nope,\n")
+    status, out, err = run("--db", db_path, "import", path, "--format", "csv")
+    assert status == 2
+    assert out == ""
+    assert "ftp://nope.com" in err
+    assert "http://" in err and "https://" in err
+
+
+# --------------------------------------------------------------------------------------------
+# T010 — rejections leave the store untouched (FR-034, FR-035, FR-036, FR-037)
+# --------------------------------------------------------------------------------------------
+
+
+def test_unreadable_file_exits_two_and_names_the_path(run, tmp_path):
+    """FR-034: a missing path, a directory and an unreadable file exit 2 naming the file."""
+    directory = tmp_path / "a-directory"
+    directory.mkdir()
+
+    loop = tmp_path / "loop.csv"
+    loop.symlink_to(loop)  # a self-referencing symlink is unreadable for every user
+
+    unreadable_parent = tmp_path / "plain.txt"
+    unreadable_parent.write_text("not a directory\n", encoding="utf-8")
+
+    cases = [
+        tmp_path / "does-not-exist.csv",
+        directory,
+        loop,
+        unreadable_parent / "inside.csv",
+    ]
+    for path in cases:
+        store = tmp_path / "untouched.db"
+        status, out, err = run("--db", store, "import", path, "--format", "csv")
+        assert status == 2, path
+        assert out == "", path
+        assert str(path) in err, path
+        assert "Traceback" not in err
+        assert not store.exists(), path
+
+    # chmod 000 is only a real restriction for a non-root user: root bypasses the permission
+    # bits entirely, so this case is asserted only where the operating system enforces it.
+    if os.geteuid() != 0:
+        no_permission = tmp_path / "no-permission.csv"
+        no_permission.write_text(TWO_ROW_CSV, encoding="utf-8")
+        no_permission.chmod(0o000)
+        store = tmp_path / "untouched2.db"
+        status, out, err = run("--db", store, "import", no_permission, "--format", "csv")
+        assert status == 2
+        assert out == ""
+        assert str(no_permission) in err
+        assert not store.exists()
+
+
+def test_non_utf8_file_exits_two(run, tmp_path):
+    """FR-034: bytes that do not decode as UTF-8 are reported, not guessed at."""
+    path = tmp_path / "latin.csv"
+    path.write_bytes(b"\xff\xfe")
+    store = tmp_path / "untouched.db"
+
+    status, out, err = run("--db", store, "import", path, "--format", "csv")
+    assert status == 2
+    assert out == ""
+    assert str(path) in err
+    assert "Traceback" not in err
+    assert not store.exists()
+
+
+def test_one_bad_url_rejects_the_whole_file(run, db_path, tmp_path):
+    """FR-036, FR-037: a valid first bookmark is not added when a later URL is refused."""
+    path = write_file(
+        tmp_path,
+        "second-bad.csv",
+        HEADER + "1,https://good.com,Good,\n2,ftp://nope.com,Nope,\n",
+    )
+    status, out, err = run("--db", db_path, "import", path, "--format", "csv")
+    assert status == 2
+    assert out == ""
+    assert "ftp://nope.com" in err
+    assert not db_path.exists()
+
+
+def test_every_rejection_leaves_the_store_and_the_next_id_unchanged(run, db_path, tmp_path):
+    """FR-037 (SC-010, SC-011): the listing is byte-identical and the next add keeps its id."""
+    assert run("--db", db_path, "add", "https://one.com", "--title", "One")[0] == 0
+    assert run("--db", db_path, "add", "https://two.com", "--title", "Two")[0] == 0
+    before = listing(run, db_path)
+
+    rejections = [
+        (write_file(tmp_path, "r1.csv", "url,title,tags\n"), "csv"),
+        (write_file(tmp_path, "r2.csv", HEADER + "1,https://a.com,A\n"), "csv"),
+        (write_file(tmp_path, "r3.csv", HEADER + "1,ftp://nope.com,Nope,\n"), "csv"),
+        (write_file(tmp_path, "r4.json", '{"url": "https://a.com"}'), "json"),
+        (write_file(tmp_path, "r5.json", '[{"url": "https://a.com", "title": "A"}]'), "json"),
+        (write_file(tmp_path, "r6.json", "not json at all"), "json"),
+        (tmp_path / "r7-missing.csv", "csv"),
+    ]
+    for path, fmt in rejections:
+        status, out, err = run("--db", db_path, "import", path, "--format", fmt)
+        assert status == 2, path
+        assert out == "", path
+        assert err != "", path
+        assert "Traceback" not in err, path
+        assert listing(run, db_path) == before, path
+
+    status, out, err = run("--db", db_path, "add", "https://three.com")
+    assert status == 0, err
+    assert out == "3\n"
+
+
+# --------------------------------------------------------------------------------------------
+# T011 — empty input is a success (FR-038)
+# --------------------------------------------------------------------------------------------
+
+
+def test_header_only_csv_and_empty_json_array_import_nothing(run, tmp_path):
+    """FR-038: a header-only CSV and ``[]`` print ``imported 0`` and exit 0."""
+    for name, text, fmt in [("only-header.csv", HEADER, "csv"), ("empty.json", "[]", "json")]:
+        path = write_file(tmp_path, name, text)
+        store = tmp_path / f"{name}.db"
+        status, out, err = run("--db", store, "import", path, "--format", fmt)
+        assert status == 0, err
+        assert out == "imported 0\n"
+        assert err == ""
+        assert listing(run, store) == ""
