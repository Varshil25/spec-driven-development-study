diff --git a/tests/test_compatibility.py b/tests/test_compatibility.py
new file mode 100644
index 0000000..a63f45b
--- /dev/null
+++ b/tests/test_compatibility.py
@@ -0,0 +1,310 @@
+"""Tests that nothing built before this feature changed: FR-045, FR-046, FR-047.
+
+Covers the unchanged bytes, stderr behaviour and exit statuses of ``add``, ``list``,
+``list --tag``, ``search``, ``delete``, ``export --format csv`` and ``export --format json``
+(FR-045), two-directions store compatibility with feature 001's schema and no schema drift
+(FR-046), and the whole tool's exit-status table including status 2's second meaning (FR-047).
+
+Fixtures ``db_path``, ``run`` and ``run_cli`` come from ``tests/conftest.py`` unmodified
+(research.md D19).
+"""
+
+import sqlite3
+
+# Feature 001's schema text, copied literally rather than imported from ``storage``: the point
+# of FR-046 is that a store created by the *previous* version is usable unchanged, which a test
+# reading today's SCHEMA constant could not demonstrate.
+FEATURE_001_SCHEMA = """
+CREATE TABLE IF NOT EXISTS bookmarks (
+    id    INTEGER PRIMARY KEY AUTOINCREMENT,
+    url   TEXT NOT NULL,
+    title TEXT NOT NULL DEFAULT '',
+    tags  TEXT NOT NULL DEFAULT ''
+)
+"""
+
+EXPECTED_CSV = (
+    "id,url,title,tags\n"
+    '1,https://docs.python.org,Python docs,"docs,python"\n'
+    "2,https://example.com,Example,\n"
+)
+
+EXPECTED_JSON = """[
+  {
+    "id": 1,
+    "url": "https://docs.python.org",
+    "title": "Python docs",
+    "tags": [
+      "docs",
+      "python"
+    ]
+  },
+  {
+    "id": 2,
+    "url": "https://example.com",
+    "title": "Example",
+    "tags": []
+  }
+]
+"""
+
+EXPECTED_LISTING = (
+    "1\thttps://docs.python.org\tPython docs\tdocs,python\n"
+    "2\thttps://example.com\tExample\t\n"
+)
+
+
+def populate(run, store):
+    """The two-bookmark collection every expected-bytes constant above describes."""
+    status, out, err = run(
+        "--db", store, "add", "https://docs.python.org",
+        "--title", "Python docs", "--tags", "python,docs",
+    )
+    assert (status, out, err) == (0, "1\n", "")
+
+    status, out, err = run("--db", store, "add", "https://example.com", "--title", "Example")
+    assert (status, out, err) == (0, "2\n", "")
+
+
+# --------------------------------------------------------------------------------------------
+# T033 — the five original commands are byte-identical (FR-045, SC-014)
+# --------------------------------------------------------------------------------------------
+
+
+def test_add_and_list_bytes_are_unchanged(run, db_path):
+    """FR-045: ``add`` prints the bare id and ``list`` the documented TSV, byte for byte."""
+    populate(run, db_path)
+
+    assert run("--db", db_path, "list") == (0, EXPECTED_LISTING, "")
+
+
+def test_list_tag_filter_bytes_are_unchanged(run, db_path):
+    """FR-045: ``list --tag`` keeps its whole-tag, case-sensitive filter and its bytes."""
+    populate(run, db_path)
+
+    assert run("--db", db_path, "list", "--tag", "python") == (
+        0, "1\thttps://docs.python.org\tPython docs\tdocs,python\n", "",
+    )
+    assert run("--db", db_path, "list", "--tag", "Python") == (0, "", "")
+    assert run("--db", db_path, "list", "--tag", "absent") == (0, "", "")
+
+
+def test_search_bytes_are_unchanged(run, db_path):
+    """FR-045: ``search`` still matches title and URL literally, ignoring letter case."""
+    populate(run, db_path)
+
+    assert run("--db", db_path, "search", "PYTHON") == (
+        0, "1\thttps://docs.python.org\tPython docs\tdocs,python\n", "",
+    )
+    assert run("--db", db_path, "search", "example") == (
+        0, "2\thttps://example.com\tExample\t\n", "",
+    )
+    assert run("--db", db_path, "search", "nothing here") == (0, "", "")
+
+
+def test_csv_and_json_export_bytes_are_unchanged(run, db_path):
+    """FR-045: the CSV and JSON exports write exactly the bytes they wrote before."""
+    populate(run, db_path)
+
+    assert run("--db", db_path, "export", "--format", "csv") == (0, EXPECTED_CSV, "")
+    assert run("--db", db_path, "export", "--format", "json") == (0, EXPECTED_JSON, "")
+
+
+def test_delete_bytes_and_statuses_are_unchanged(run, db_path):
+    """FR-045, FR-047: ``delete`` stays silent on success (0) and reports an absent id (3)."""
+    populate(run, db_path)
+
+    assert run("--db", db_path, "delete", "1") == (0, "", "")
+
+    status, out, err = run("--db", db_path, "delete", "1")
+    assert status == 3
+    assert out == ""
+    assert err == f"error: no bookmark with id 1 in {str(db_path)!r}\n"
+
+
+def test_add_rejects_a_bad_url_with_the_same_message_and_status(run, db_path):
+    """FR-045, FR-047: ``add``'s URL rejection keeps its exact diagnostic and status 2."""
+    status, out, err = run("--db", db_path, "add", "ftp://nope.com")
+    assert status == 2
+    assert out == ""
+    assert err == (
+        "error: refusing to store the URL 'ftp://nope.com': "
+        "it must begin with 'http://' or 'https://'\n"
+    )
+    assert not db_path.exists()
+
+
+def test_original_commands_are_unchanged_in_a_real_process(run_cli, tmp_path):
+    """FR-045 (SC-014): the same bytes and statuses through the real ``python -m bookmarks``."""
+    store = tmp_path / "subprocess.db"
+    assert run_cli("--db", store, "add", "https://docs.python.org",
+                   "--title", "Python docs", "--tags", "python,docs") == (0, "1\n", "")
+    assert run_cli("--db", store, "add", "https://example.com", "--title", "Example") == (
+        0, "2\n", "",
+    )
+    assert run_cli("--db", store, "list") == (0, EXPECTED_LISTING, "")
+    assert run_cli("--db", store, "export", "--format", "csv") == (0, EXPECTED_CSV, "")
+    assert run_cli("--db", store, "export", "--format", "json") == (0, EXPECTED_JSON, "")
+
+
+# --------------------------------------------------------------------------------------------
+# T034 — store compatibility in both directions (FR-046)
+# --------------------------------------------------------------------------------------------
+
+
+def test_a_store_built_by_feature_001_needs_no_migration(run, tmp_path):
+    """FR-046: a store created with feature 001's schema text is read and written as it is."""
+    store = tmp_path / "legacy.db"
+    legacy = sqlite3.connect(store)
+    try:
+        legacy.execute(FEATURE_001_SCHEMA)
+        legacy.execute(
+            "INSERT INTO bookmarks (url, title, tags) VALUES (?, ?, ?)",
+            ("https://legacy.example", "Legacy", "old"),
+        )
+        legacy.commit()
+    finally:
+        legacy.close()
+
+    assert run("--db", store, "list") == (
+        0, "1\thttps://legacy.example\tLegacy\told\n", "",
+    )
+
+    import_file = tmp_path / "new.csv"
+    import_file.write_text(
+        "id,url,title,tags\n1,https://fresh.example,Fresh,new\n", encoding="utf-8"
+    )
+    status, out, err = run("--db", store, "import", import_file, "--format", "csv")
+    assert (status, out, err) == (0, "imported 1\n", "")
+
+    status, _, err = run("--db", store, "export", "--format", "html")
+    assert status == 0, err
+
+    assert run("--db", store, "list")[1] == (
+        "1\thttps://legacy.example\tLegacy\told\n"
+        "2\thttps://fresh.example\tFresh\tnew\n"
+    )
+
+
+def test_the_new_commands_leave_the_schema_exactly_as_it_was(run, tmp_path):
+    """FR-046: after an import and an HTML export the store is still the one-table store."""
+    store = tmp_path / "schema.db"
+    import_file = tmp_path / "rows.csv"
+    import_file.write_text(
+        "id,url,title,tags\n1,https://a.example,A,x\n2,https://b.example,B,\n",
+        encoding="utf-8",
+    )
+
+    status, out, err = run("--db", store, "import", import_file, "--format", "csv")
+    assert (status, out, err) == (0, "imported 2\n", "")
+    status, _, err = run("--db", store, "export", "--format", "html")
+    assert status == 0, err
+
+    conn = sqlite3.connect(store)
+    try:
+        objects = conn.execute(
+            "SELECT name, sql FROM sqlite_master ORDER BY name"
+        ).fetchall()
+    finally:
+        conn.close()
+
+    # Exactly the one bookmarks table, plus SQLite's own AUTOINCREMENT bookkeeping table.
+    names = [name for name, _ in objects]
+    assert names == ["bookmarks", "sqlite_sequence"]
+    bookmarks_sql = dict(objects)["bookmarks"]
+    assert bookmarks_sql == FEATURE_001_SCHEMA.strip().replace("IF NOT EXISTS ", "")
+
+    conn = sqlite3.connect(store)
+    try:
+        columns = [row[1] for row in conn.execute("PRAGMA table_info(bookmarks)").fetchall()]
+    finally:
+        conn.close()
+    assert columns == ["id", "url", "title", "tags"]
+
+
+def test_a_store_the_new_commands_wrote_stays_readable_by_the_old_schema(run, tmp_path):
+    """FR-046: the previous version's own queries still work on a store ``import`` wrote."""
+    store = tmp_path / "written.db"
+    import_file = tmp_path / "rows.json"
+    import_file.write_text(
+        '[{"url": "https://a.example", "title": "A", "tags": ["x"]}]', encoding="utf-8"
+    )
+    status, out, err = run("--db", store, "import", import_file, "--format", "json")
+    assert (status, out, err) == (0, "imported 1\n", "")
+
+    old = sqlite3.connect(store)
+    try:
+        old.execute(FEATURE_001_SCHEMA)  # the old connect() ran this on every connection
+        rows = old.execute(
+            "SELECT id, url, title, tags FROM bookmarks ORDER BY id"
+        ).fetchall()
+    finally:
+        old.close()
+    assert rows == [(1, "https://a.example", "A", "x")]
+
+
+# --------------------------------------------------------------------------------------------
+# T035 — the exit-status table (FR-047)
+# --------------------------------------------------------------------------------------------
+
+
+def test_usage_errors_exit_one(run_cli, tmp_path):
+    """FR-047: an unknown command, an unknown option and a bad argument type all exit 1."""
+    store = tmp_path / "unused.db"
+    for args in [
+        ("frobnicate",),
+        ("list", "--nope"),
+        ("delete", "not-a-number"),
+        ("export", "--format", "xml"),
+        ("import", "--format", "csv"),
+    ]:
+        status, out, err = run_cli("--db", store, *args)
+        assert status == 1, args
+        assert out == "", args
+        assert err != "", args
+
+
+def test_a_store_that_cannot_be_created_exits_one_not_two(run, tmp_path):
+    """FR-047: an unusable store is status 1 even for an otherwise valid ``import``."""
+    import_file = tmp_path / "rows.csv"
+    import_file.write_text("id,url,title,tags\n1,https://a.example,A,\n", encoding="utf-8")
+    unusable = tmp_path / "no-such-directory" / "store.db"
+
+    status, out, err = run("--db", unusable, "import", import_file, "--format", "csv")
+    assert status == 1
+    assert out == ""
+    assert str(unusable) in err
+
+
+def test_a_rejected_import_and_a_rejected_url_exit_two(run, tmp_path):
+    """FR-047: status 2 means "an input value was refused" — a bad URL or a refused file."""
+    store = tmp_path / "store.db"
+
+    status, out, err = run("--db", store, "add", "ftp://nope.com")
+    assert (status, out) == (2, "")
+    assert err != ""
+
+    malformed = tmp_path / "malformed.csv"
+    malformed.write_text("url,title,tags\n", encoding="utf-8")
+    status, out, err = run("--db", store, "import", malformed, "--format", "csv")
+    assert (status, out) == (2, "")
+    assert err != ""
+
+    status, out, err = run("--db", store, "import", tmp_path / "absent.csv", "--format", "csv")
+    assert (status, out) == (2, "")
+    assert err != ""
+
+
+def test_status_three_still_belongs_to_delete_alone(run, tmp_path):
+    """FR-047: only ``delete`` with an id that is not in the store exits 3."""
+    store = tmp_path / "store.db"
+    status, _, err = run("--db", store, "add", "https://a.example")
+    assert status == 0, err
+
+    assert run("--db", store, "delete", "99")[0] == 3
+
+    import_file = tmp_path / "rows.csv"
+    import_file.write_text("id,url,title,tags\n1,ftp://nope.com,A,\n", encoding="utf-8")
+    assert run("--db", store, "import", import_file, "--format", "csv")[0] == 2
+    assert run("--db", store, "export", "--format", "html")[0] == 0
+    assert run("--db", store, "delete", "1")[0] == 0
