@@ -0,0 +1,243 @@
+"""Tests for ``export --format html``: FR-039…FR-044.
+
+Covers the fixed page skeleton and ascending id order (FR-039, FR-040), the bookmark item
+format and the empty store (FR-041, FR-043), the escaping of exactly ``&``, ``<``, ``>`` and
+``"`` (FR-042) and the rejection of any other format as a usage error (FR-044).
+
+Fixtures ``db_path``, ``run`` and ``run_cli`` come from ``tests/conftest.py`` unmodified
+(research.md D19).
+"""
+
+from html.parser import HTMLParser
+
+SKELETON_HEAD = [
+    "<!DOCTYPE html>",
+    "<html>",
+    '<head><meta charset="utf-8"><title>Bookmarks</title></head>',
+    "<body>",
+    "<ul>",
+]
+SKELETON_TAIL = ["</ul>", "</body>", "</html>"]
+
+
+def page(run, db_path):
+    """``export --format html`` for this store: returns the exact stdout bytes."""
+    status, out, err = run("--db", db_path, "export", "--format", "html")
+    assert status == 0, err
+    assert err == ""
+    return out
+
+
+def add(run, db_path, url, title="", tags=""):
+    """Add one bookmark through the real command, asserting it succeeded."""
+    status, _, err = run("--db", db_path, "add", url, "--title", title, "--tags", tags)
+    assert status == 0, err
+
+
+class _Collector(HTMLParser):
+    """Collects the start tags and the text a real HTML parser sees in the page."""
+
+    def __init__(self):
+        super().__init__()
+        self.start_tags = []
+        self.data = []
+
+    def handle_starttag(self, tag, attrs):
+        self.start_tags.append((tag, dict(attrs)))
+
+    def handle_data(self, data):
+        self.data.append(data)
+
+
+# --------------------------------------------------------------------------------------------
+# T020 — page shape (FR-039, FR-040)
+# --------------------------------------------------------------------------------------------
+
+
+def test_html_page_is_exactly_the_documented_skeleton(run, db_path):
+    """FR-040: stdout is the nine fixed lines plus one per bookmark, with a trailing newline."""
+    add(run, db_path, "https://docs.python.org", "Python docs", "python,docs")
+    add(run, db_path, "https://example.com", "Example")
+
+    assert page(run, db_path) == (
+        "<!DOCTYPE html>\n"
+        "<html>\n"
+        '<head><meta charset="utf-8"><title>Bookmarks</title></head>\n'
+        "<body>\n"
+        "<ul>\n"
+        '<li><a href="https://docs.python.org">Python docs</a> '
+        "<small>docs,python</small></li>\n"
+        '<li><a href="https://example.com">Example</a> <small></small></li>\n'
+        "</ul>\n"
+        "</body>\n"
+        "</html>\n"
+    )
+
+
+def test_html_page_carries_no_decoration(run, db_path):
+    """FR-040: no CSS, timestamp, count, id, lang attribute, blank line or indentation."""
+    add(run, db_path, "https://docs.python.org", "Python docs", "python")
+    lines = page(run, db_path).split("\n")
+
+    assert lines[:5] == SKELETON_HEAD
+    assert lines[6:] == SKELETON_TAIL + [""]
+    assert all(line == line.lstrip() for line in lines), "no line is indented"
+    assert "" not in lines[:-1], "no blank line inside the page"
+    for absent in ["<style", "<link", "<!--", "lang=", "<html lang"]:
+        assert absent not in page(run, db_path)
+
+
+def test_html_items_follow_ascending_id_order(run, db_path):
+    """FR-039: items are in ascending id order even when the titles sort differently."""
+    add(run, db_path, "https://zebra.com", "Zebra")
+    add(run, db_path, "https://apple.com", "Apple")
+    add(run, db_path, "https://middle.com", "Middle")
+
+    items = [line for line in page(run, db_path).split("\n") if line.startswith("<li>")]
+    assert items == [
+        '<li><a href="https://zebra.com">Zebra</a> <small></small></li>',
+        '<li><a href="https://apple.com">Apple</a> <small></small></li>',
+        '<li><a href="https://middle.com">Middle</a> <small></small></li>',
+    ]
+
+
+def test_html_export_leaves_the_store_unchanged(run, db_path):
+    """FR-039: the HTML export is read-only — the listing is identical afterwards."""
+    add(run, db_path, "https://a.com", "A", "x")
+    before = run("--db", db_path, "list")[1]
+    page(run, db_path)
+    assert run("--db", db_path, "list")[1] == before
+
+
+# --------------------------------------------------------------------------------------------
+# T021 — item format and the empty store (FR-041, FR-043)
+# --------------------------------------------------------------------------------------------
+
+
+def test_html_item_format_is_one_line_per_bookmark(run, db_path):
+    """FR-041: one line ``<li><a href=URL>TITLE</a> <small>TAGS</small></li>`` per bookmark."""
+    add(run, db_path, "https://a.com", "A title", "zeta,alpha")
+    add(run, db_path, "https://b.com", "", "")
+
+    lines = page(run, db_path).split("\n")
+    items = [line for line in lines if line.startswith("<li>")]
+    assert len(items) == 2
+    assert items[0] == '<li><a href="https://a.com">A title</a> <small>alpha,zeta</small></li>'
+    # exactly one space between </a> and <small>, and no other whitespace in the markup
+    assert items[0].count("</a> <small>") == 1
+    assert "  " not in items[0]
+    assert "\t" not in items[0]
+    # an empty title gives an empty link text; no tags gives an empty <small>
+    assert items[1] == '<li><a href="https://b.com"></a> <small></small></li>'
+
+
+def test_html_tags_are_the_stored_alphabetical_string(run, db_path):
+    """FR-041: TAGS is the stored tags string — comma-joined, alphabetical, de-duplicated."""
+    add(run, db_path, "https://a.com", "A", " python , , docs , python ")
+    items = [line for line in page(run, db_path).split("\n") if line.startswith("<li>")]
+    assert items == ['<li><a href="https://a.com">A</a> <small>docs,python</small></li>']
+
+
+def test_html_export_of_an_empty_store_is_the_bare_skeleton(run, db_path):
+    """FR-043: an empty store prints the skeleton with zero items and exits 0."""
+    out = page(run, db_path)
+    assert out == "\n".join(SKELETON_HEAD + SKELETON_TAIL) + "\n"
+    assert "<li>" not in out
+
+
+# --------------------------------------------------------------------------------------------
+# T022 — escaping (FR-042, SC-012)
+# --------------------------------------------------------------------------------------------
+
+
+def test_html_escapes_exactly_the_four_markup_characters(run, db_path):
+    """FR-042: ``&``, ``<``, ``>`` and ``"`` are escaped in the URL, the title and the tags."""
+    add(
+        run,
+        db_path,
+        "https://example.com/?a=1&b=2",
+        'Tom\'s "A&B" <notes>',
+        "a&b,c<d",
+    )
+    items = [line for line in page(run, db_path).split("\n") if line.startswith("<li>")]
+    assert items == [
+        '<li><a href="https://example.com/?a=1&amp;b=2">'
+        "Tom's &quot;A&amp;B&quot; &lt;notes&gt;</a> "
+        "<small>a&amp;b,c&lt;d</small></li>"
+    ]
+
+
+def test_html_leaves_the_apostrophe_and_non_ascii_verbatim(run, db_path):
+    """FR-042: text free of the four characters appears verbatim — ``'`` is not escaped."""
+    add(run, db_path, "https://café.example/ünïcode", "Bob's links — Café ☕", "naïve")
+    out = page(run, db_path)
+
+    assert "&#x27;" not in out
+    assert "&#39;" not in out
+    assert "Bob's links — Café ☕" in out
+    assert "https://café.example/ünïcode" in out
+    assert "naïve" in out
+
+
+def test_html_does_not_double_escape_an_ampersand(run, db_path):
+    """FR-042: the ``&`` inside ``&quot;`` is not escaped again."""
+    add(run, db_path, "https://a.com", 'He said "hi" & left')
+    out = page(run, db_path)
+
+    assert "&amp;quot;" not in out
+    assert "&amp;amp;" not in out
+    assert "&quot;hi&quot; &amp; left" in out
+
+
+def test_html_page_parses_as_html(run, db_path):
+    """FR-042 (SC-012): the whole page feeds through ``html.parser`` and reads back the text."""
+    title = 'Tom\'s "A&B" <notes>'
+    add(run, db_path, "https://example.com/?a=1&b=2", title, "a&b")
+
+    collector = _Collector()
+    collector.feed(page(run, db_path))
+    collector.close()
+
+    assert [tag for tag, _ in collector.start_tags] == [
+        "html",
+        "head",
+        "meta",
+        "title",
+        "body",
+        "ul",
+        "li",
+        "a",
+        "small",
+    ]
+    attrs = dict(collector.start_tags)
+    assert attrs["meta"] == {"charset": "utf-8"}
+    # the parser resolves the escapes back to exactly the stored values (SC-012: no mangling)
+    assert attrs["a"] == {"href": "https://example.com/?a=1&b=2"}
+    assert title in collector.data
+    assert "a&b" in collector.data
+
+
+# --------------------------------------------------------------------------------------------
+# T023 — format rejection (FR-044)
+# --------------------------------------------------------------------------------------------
+
+
+def test_export_rejects_an_unknown_format_with_status_one(run_cli, db_path):
+    """FR-044: ``--format xml`` and a missing ``--format`` exit 1, not 2."""
+    for args in [("export", "--format", "xml"), ("export",)]:
+        status, out, err = run_cli("--db", db_path, *args)
+        assert status == 1
+        assert out == ""
+        assert err != ""
+
+
+def test_export_still_accepts_csv_and_json(run_cli, db_path):
+    """FR-044, FR-045: the two original formats keep working alongside html."""
+    status, _, err = run_cli("--db", db_path, "add", "https://a.com", "--title", "A")
+    assert status == 0, err
+
+    for fmt in ["csv", "json", "html"]:
+        status, out, err = run_cli("--db", db_path, "export", "--format", fmt)
+        assert status == 0, err
+        assert out != ""
+        assert err == ""
