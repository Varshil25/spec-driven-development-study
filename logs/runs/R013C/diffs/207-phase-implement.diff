+"""Tests for User Story 3 — moving a collection between stores: SC-009.
+
+An export of store A imported into an empty store B reproduces every bookmark's URL, title and
+tag set exactly, in both the CSV and the JSON format (SC-009, FR-031), and importing the same
+file twice leaves two independent copies with distinct ids (no deduplication).
+
+Fixtures ``db_path``, ``run`` and ``run_cli`` come from ``tests/conftest.py`` unmodified
+(research.md D19).
+"""
+
+import json
+
+# A collection chosen to exercise every lossy spot: no tags, several tags, a title holding a
+# comma and a double quote, and non-ASCII text (quickstart.md Scenario 7).
+COLLECTION = [
+    ("https://plain.example", "No tags here", ""),
+    ("https://tagged.example", "Several tags", "python,docs,reference"),
+    ("https://awkward.example", 'Notes, "quoted" and, more', "notes"),
+    ("https://unicode.example/ünïcode", "Café ☕ — naïve résumé", "café,naïve"),
+]
+
+
+def populate(run, store):
+    """Build store A by adding every bookmark in COLLECTION through the real command."""
+    for url, title, tags in COLLECTION:
+        status, _, err = run("--db", store, "add", url, "--title", title, "--tags", tags)
+        assert status == 0, err
+
+
+def export_to_file(run, store, fmt, path):
+    """Write ``export --format fmt`` for `store` into `path` and return the path."""
+    status, out, err = run("--db", store, "export", "--format", fmt)
+    assert status == 0, err
+    path.write_text(out, encoding="utf-8")
+    return path
+
+
+def fields(run, store):
+    """The store's bookmarks as ``(id, url, title, tags)`` tuples, in ascending id order."""
+    status, out, err = run("--db", store, "export", "--format", "json")
+    assert status == 0, err
+    return [(row["id"], row["url"], row["title"], row["tags"]) for row in json.loads(out)]
+
+
+def test_csv_export_imports_losslessly_into_an_empty_store(run, tmp_path):
+    """SC-009: a CSV export of store A imported into empty store B reproduces every field."""
+    store_a = tmp_path / "a.db"
+    store_b = tmp_path / "b.db"
+    populate(run, store_a)
+
+    dump = export_to_file(run, store_a, "csv", tmp_path / "a.csv")
+    status, out, err = run("--db", store_b, "import", dump, "--format", "csv")
+    assert status == 0, err
+    assert out == f"imported {len(COLLECTION)}\n"
+
+    assert fields(run, store_b) == fields(run, store_a)
+
+
+def test_json_export_imports_losslessly_and_ignores_its_id_key(run, tmp_path):
+    """SC-009, FR-031: the JSON export round-trips; the ``id`` it writes is ignored on the way in."""
+    store_a = tmp_path / "a.db"
+    store_c = tmp_path / "c.db"
+    populate(run, store_a)
+
+    dump = export_to_file(run, store_a, "json", tmp_path / "a.json")
+    assert '"id"' in dump.read_text(encoding="utf-8")
+
+    status, out, err = run("--db", store_c, "import", dump, "--format", "json")
+    assert status == 0, err
+    assert out == f"imported {len(COLLECTION)}\n"
+
+    assert fields(run, store_c) == fields(run, store_a)
+    # ids are the receiving store's own, renumbered from 1 in A's ascending id order
+    assert [row[0] for row in fields(run, store_c)] == list(range(1, len(COLLECTION) + 1))
+
+
+def test_round_trip_renumbers_ids_from_the_receiving_store(run, tmp_path):
+    """SC-009: field values survive; ids come from the receiving store, not the file."""
+    store_a = tmp_path / "a.db"
+    store_d = tmp_path / "d.db"
+    populate(run, store_a)
+
+    # store D already holds a bookmark, so the imported ids must continue after it
+    status, _, err = run("--db", store_d, "add", "https://existing.example", "--title", "Old")
+    assert status == 0, err
+
+    dump = export_to_file(run, store_a, "csv", tmp_path / "a.csv")
+    status, out, err = run("--db", store_d, "import", dump, "--format", "csv")
+    assert status == 0, err
+    assert out == f"imported {len(COLLECTION)}\n"
+
+    rows = fields(run, store_d)
+    assert [row[0] for row in rows] == [1, 2, 3, 4, 5]
+    assert [row[1:] for row in rows[1:]] == [row[1:] for row in fields(run, store_a)]
+
+
+def test_importing_the_same_file_twice_makes_independent_copies(run, tmp_path):
+    """User Story 3 scenario 3: import never deduplicates, just as ``add`` does not."""
+    store_a = tmp_path / "a.db"
+    store_b = tmp_path / "b.db"
+    populate(run, store_a)
+    dump = export_to_file(run, store_a, "json", tmp_path / "a.json")
+
+    for _ in range(2):
+        status, out, err = run("--db", store_b, "import", dump, "--format", "json")
+        assert status == 0, err
+        assert out == f"imported {len(COLLECTION)}\n"
+
+    rows = fields(run, store_b)
+    assert len(rows) == 2 * len(COLLECTION)
+    assert [row[0] for row in rows] == list(range(1, 2 * len(COLLECTION) + 1))
+    first_copy = [row[1:] for row in rows[: len(COLLECTION)]]
+    second_copy = [row[1:] for row in rows[len(COLLECTION) :]]
+    assert first_copy == second_copy == [row[1:] for row in fields(run, store_a)]