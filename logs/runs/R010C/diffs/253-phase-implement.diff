@@ -0,0 +1,386 @@
+"""The SC-105 adversarial corpus for ``create``.
+
+Covers SR-101, SR-102, SR-103, SR-104, SR-107, SR-109, SR-110 and SR-111 of
+``specs/002-create-archive-command/spec.md``. Every case asserts the same three
+things SC-105 demands: nothing is created, nothing outside ARCHIVE is modified,
+and no temporary file remains.
+"""
+
+import os
+import sys
+import tarfile
+import tempfile
+from pathlib import Path
+
+import pytest
+
+import helpers
+from tarx import create
+from tarx.paths import escape_name
+
+#: Strings that would betray a leaked traceback (SR-111).
+TRACEBACK_MARKERS = ("Traceback (most recent call last)", 'File "', ", line ")
+
+
+def _leftovers(directory="."):
+    return [name for name in os.listdir(directory) if name.startswith(".tarx-")]
+
+
+# --- SR-101: every PATH must be a relative location inside the current dir ---
+
+
+@pytest.mark.parametrize(
+    "given",
+    [
+        pytest.param("/etc", id="absolute"),
+        pytest.param("/", id="root"),
+        pytest.param("../outside", id="parent-prefix"),
+        pytest.param("photos/../../outside", id="parent-inside"),
+        pytest.param("..", id="parent"),
+        pytest.param(".", id="dot"),
+        pytest.param("./", id="dot-slash"),
+        pytest.param("C:\\photos", id="drive-prefix"),
+        pytest.param("\\\\server\\share", id="unc-prefix"),
+        pytest.param("\\photos", id="leading-backslash"),
+    ],
+)
+def test_sr_101_an_unsafe_path_is_refused_never_repaired(
+    run_cli, photos_source, monkeypatch, given
+):
+    """SR-101: an absolute PATH, a PATH containing ``..``, a PATH of ``.`` or
+    ``..``, a drive-letter prefix, a UNC prefix, and a leading-backslash path are
+    each refused naming the PATH as given — refused, never silently repaired
+    into something safe."""
+    monkeypatch.chdir(photos_source)
+    result = run_cli(["create", "out.tar", given])
+    assert result.status == 2
+    assert result.stdout == ""
+    # The PATH is named in its display form, which for a backslash path is the
+    # escaped one (SR-110).
+    assert escape_name(given) in result.stderr
+    assert not Path("out.tar").exists()
+    assert _leftovers() == []
+
+
+def test_sr_101_an_unsafe_path_is_refused_even_beside_valid_paths(
+    run_cli, photos_source, monkeypatch
+):
+    """SR-101, FR-118: one unsafe PATH refuses the whole command, so no part of
+    the valid PATHs is archived."""
+    monkeypatch.chdir(photos_source)
+    result = run_cli(["create", "out.tar", "photos", "/etc"])
+    assert result.status == 2
+    assert not Path("out.tar").exists()
+
+
+# --- SR-102, SR-103: only regular files and directories -------------------
+
+
+def _special_entries(root):
+    """Every special entry that can be created here, as ``{name: kind}``."""
+    entries = {}
+    helpers.add_symlink(root, "sl", "a.jpg")
+    entries["sl"] = "symbolic link"
+    (root / "plain.bin").write_bytes(b"plain")
+    helpers.add_hardlink(root, "hl", "plain.bin")
+    entries["hl"] = "hard link"
+    try:
+        helpers.add_fifo(root, "fifo")
+        entries["fifo"] = "FIFO"
+    except OSError:  # pragma: no cover - platform dependent
+        pass
+    try:
+        helpers.add_socket(root, "sock")
+        entries["sock"] = "socket"
+    except OSError:  # pragma: no cover - platform dependent
+        pass
+    try:
+        helpers.add_device(root, "dev")
+        entries["dev"] = "device"
+    except OSError:  # pragma: no cover - needs privilege
+        pass
+    return entries
+
+
+def test_sr_102_a_special_entry_named_directly_as_a_path_is_refused(
+    run_cli, photos_source, monkeypatch
+):
+    """SR-102: a symbolic link, a hard link, a FIFO, and — where creatable — a
+    socket or device named directly as a PATH is refused, naming the member and
+    its kind, with no archive and status 2."""
+    monkeypatch.chdir(photos_source)
+    entries = _special_entries(photos_source / "photos")
+
+    for name, kind in entries.items():
+        result = run_cli(["create", "out.tar", f"photos/{name}"])
+        assert result.status == 2, (name, result.stderr)
+        assert result.stdout == ""
+        assert f"photos/{name}" in result.stderr, name
+        assert kind in result.stderr, (name, result.stderr)
+        assert not Path("out.tar").exists()
+        assert _leftovers() == []
+
+
+def test_sr_102_a_special_entry_beneath_a_directory_path_is_refused(
+    run_cli, photos_source, monkeypatch
+):
+    """SR-102: the same entries found *beneath* a directory PATH refuse the whole
+    command — never silently skipped, so a tree containing one cannot be
+    archived at all."""
+    monkeypatch.chdir(photos_source)
+    entries = _special_entries(photos_source / "photos")
+
+    for name in entries:
+        result = run_cli(["create", "out.tar", "photos"])
+        assert result.status == 2, (name, result.stderr)
+        assert not Path("out.tar").exists()
+        os.unlink(photos_source / "photos" / name)
+
+    # With every special entry gone the same tree is archived happily, which is
+    # what shows the refusals were about those entries and nothing else.
+    assert run_cli(["create", "out.tar", "photos"]).status == 0
+
+
+def test_sr_102_a_symlink_is_never_followed_or_its_target_archived(
+    run_cli, photos_source, monkeypatch
+):
+    """SR-102: a symbolic link's target contents are never archived — the link is
+    refused instead of being resolved."""
+    monkeypatch.chdir(photos_source)
+    outside = photos_source.parent / "outside-secret.txt"
+    outside.write_bytes(b"OUTSIDE-SECRET-PAYLOAD")
+    helpers.add_symlink(photos_source, "photos/escape.jpg", str(outside))
+
+    result = run_cli(["create", "out.tar", "photos"])
+    assert result.status == 2
+    assert "photos/escape.jpg" in result.stderr
+    assert "symbolic link" in result.stderr
+    assert "OUTSIDE-SECRET-PAYLOAD" not in result.stderr
+    assert not Path("out.tar").exists()
+
+
+def test_sr_103_a_symlinked_subdirectory_is_refused_not_descended_into(
+    run_cli, photos_source, monkeypatch
+):
+    """SR-103: traversal never follows a symbolic link, so a symlinked
