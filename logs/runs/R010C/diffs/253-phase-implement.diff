+++ b/tests/test_create_failures.py
@@ -0,0 +1,331 @@
+"""All-or-nothing: every failure leaves nothing half-made.
+
+Covers FR-117, FR-118, FR-119, FR-120 and FR-122 (and SC-104, SC-106) of
+``specs/002-create-archive-command/spec.md``, including the unreadable-input
+edge cases.
+"""
+
+import os
+from pathlib import Path
+
+import pytest
+
+import helpers
+from tarx import create
+from tarx.errors import TarxError
+
+#: Failures that every FR-119 state must survive, as ``(id, argv-tail)``.
+FAILING_INVOCATIONS = [
+    pytest.param(["missing-folder"], id="missing-path"),
+    pytest.param(["photos", "missing-folder"], id="one-missing-path"),
+    pytest.param(["/etc"], id="absolute-path"),
+    pytest.param([".."], id="parent-path"),
+    pytest.param(["."], id="dot-path"),
+    pytest.param(["photos", "photos"], id="duplicate-path"),
+    pytest.param(["photos", "photos/a.jpg"], id="nested-path"),
+    pytest.param(["photos/link"], id="symlink-path"),
+    pytest.param(["photos"], id="symlink-in-tree"),
+]
+
+
+def _leftovers(directory="."):
+    """Any ``.tarx-*`` temporary file the command failed to clean up."""
+    return [name for name in os.listdir(directory) if name.startswith(".tarx-")]
+
+
+def _stamps(root):
+    """``{relative path: (mode, size, mtime_ns)}`` for everything beneath ``root``.
+
+    Recorded with ``lstat`` so a symlink is measured as itself, and including
+    modification times, which is what makes FR-122's "read only" assertion
+    stronger than a contents comparison.
+    """
+    root = Path(root)
+    found = {}
+    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
+        for name in list(dirnames) + list(filenames):
+            path = Path(dirpath) / name
+            info = os.lstat(path)
+            found[str(path.relative_to(root))] = (
+                info.st_mode,
+                info.st_size,
+                info.st_mtime_ns,
+            )
+    return found
+
+
+# --- FR-117: a missing PATH -------------------------------------------------
+
+
+def test_fr_117_a_missing_path_is_named_and_nothing_is_created(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-117: a non-existent PATH is named on stderr, no archive is created,
+    and the status is 2."""
+    monkeypatch.chdir(photos_source)
+    result = run_cli(["create", "other.tar", "missing-folder"])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "missing-folder" in result.stderr
+    assert not Path("other.tar").exists()
+    assert _leftovers() == []
+
+
+def test_fr_117_a_missing_path_fails_even_when_other_paths_exist(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-117, FR-118: a missing PATH fails the whole command — the PATHs that do
+    exist are not archived."""
+    monkeypatch.chdir(photos_source)
+    result = run_cli(["create", "other.tar", "notes.txt", "photos", "missing-folder"])
+    assert result.status == 2
+    assert "missing-folder" in result.stderr
+    assert not Path("other.tar").exists()
+    assert _leftovers() == []
+
+
+# --- FR-118: validation finishes before any content is written --------------
+
+
+def test_fr_118_no_content_is_written_before_validation_ends(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-118: with several PATHs of which the last is missing, neither an
+    archive nor a temporary file ever appears in the archive's directory."""
+    monkeypatch.chdir(photos_source)
+    os.mkdir("outdir")
+    result = run_cli(
+        ["create", "outdir/out.tar", "notes.txt", "photos", "missing-folder"]
+    )
+    assert result.status == 2
+    assert os.listdir("outdir") == []
+
+
+def test_fr_118_a_refused_member_deep_in_a_tree_writes_nothing(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-118, FR-119: a member refused part-way through enumeration stops the
+    command before the write pass begins."""
+    monkeypatch.chdir(photos_source)
+    helpers.build_source_tree(photos_source / "photos" / "sub", {"c.jpg": b"gamma"})
+    helpers.add_symlink(photos_source, "photos/sub/link", "c.jpg")
+    os.mkdir("outdir")
+
+    result = run_cli(["create", "outdir/out.tar", "photos"])
+    assert result.status == 2
+    assert "photos/sub/link" in result.stderr
+    assert os.listdir("outdir") == []
+
+
+# --- FR-119, SC-106: the archive path is left exactly as it was -------------
+
+
+@pytest.mark.parametrize("tail", FAILING_INVOCATIONS)
+def test_fr_119_an_absent_archive_path_stays_absent(
+    run_cli, photos_source, monkeypatch, tail
+):
+    """FR-119 (SC-106): for every failure mode, an archive path that was absent
+    before the command is still absent after it, with no temporary left."""
+    monkeypatch.chdir(photos_source)
+    helpers.add_symlink(photos_source, "photos/link", "a.jpg")
+
+    result = run_cli(["create", "out.tar", *tail])
+    assert result.status == 2, result.stderr
+    assert result.stdout == ""
+    assert not Path("out.tar").exists()
+    assert _leftovers() == []
+
+
+@pytest.mark.parametrize("tail", FAILING_INVOCATIONS)
+@pytest.mark.parametrize("overwrite", [False, True], ids=["plain", "overwrite"])
+def test_fr_119_a_pre_existing_archive_is_byte_for_byte_unchanged(
+    run_cli, photos_source, monkeypatch, snapshot_bytes, tail, overwrite
+):
+    """FR-119 (SC-106): for every failure mode, a pre-existing regular file at
+    ARCHIVE is byte-for-byte unchanged afterwards — including when the failing
+    command passed ``--overwrite`` — and no temporary file remains."""
+    monkeypatch.chdir(photos_source)
+    helpers.add_symlink(photos_source, "photos/link", "a.jpg")
+    Path("out.tar").write_bytes(b"the previous archive's bytes")
+    before = snapshot_bytes("out.tar")
+
+    argv = ["create", "out.tar", *tail] + (["--overwrite"] if overwrite else [])
+    result = run_cli(argv)
+    assert result.status in (2, 3), result.stderr
+    assert result.stdout == ""
+    assert snapshot_bytes("out.tar") == before
+    assert _leftovers() == []
+
+
+# --- FR-120: a file that changes size while it is read ----------------------
+
+
+def test_fr_120_a_file_that_shrinks_between_the_passes_fails_cleanly(
+    photos_source, monkeypatch
+):
+    """FR-120: a file that shrinks between enumeration and writing fails with no
+    archive, naming the member, rather than recording contents that do not match
+    the size recorded for it."""
+    monkeypatch.chdir(photos_source)
+    big = photos_source / "photos" / "big.bin"
+    big.write_bytes(b"x" * 4096)
+
+    target = create.classify_target("out.tar", False)
+    plan = create.plan_members(["photos"], "out.tar")
+    big.write_bytes(b"x" * 10)
+
+    with pytest.raises(TarxError) as refused:
+        create.write_archive(plan, target)
+    assert "photos/big.bin" in refused.value.message
+    assert refused.value.exit_code == 2
+    assert not Path("out.tar").exists()
+    assert _leftovers() == []
+
+
+def test_fr_120_a_file_that_grows_between_the_passes_fails_cleanly(
+    photos_source, monkeypatch
+):
+    """FR-120: a file that grows between enumeration and writing fails the same
+    way, naming the member and leaving no archive."""
+    monkeypatch.chdir(photos_source)
+    big = photos_source / "photos" / "big.bin"
+    big.write_bytes(b"x" * 10)
+
+    target = create.classify_target("out.tar", False)
+    plan = create.plan_members(["photos"], "out.tar")
+    big.write_bytes(b"x" * 4096)
+
+    with pytest.raises(TarxError) as refused:
+        create.write_archive(plan, target)
+    assert "photos/big.bin" in refused.value.message
+    assert not Path("out.tar").exists()
+    assert _leftovers() == []
+
+
+def test_fr_120_a_short_read_is_reported_with_the_member_named(tmp_path):
+    """FR-120, FR-113: reaching the end of a file before the declared number of
+    bytes has been delivered raises our own message naming the member, not
+    ``tarfile``'s bare "unexpected end of data" (R-110)."""
+    source = tmp_path / "short.bin"
+    source.write_bytes(b"only fifty bytes" )
+    fd = os.open(source, os.O_RDONLY)
+    try:
+        reader = create._ExactReader(fd, 4096, "tree/short.bin")
+        with pytest.raises(TarxError) as refused:
+            reader.read(4096)
+    finally:
+        os.close(fd)
+    assert "tree/short.bin" in refused.value.message
+    assert refused.value.exit_code == 2
+
+
+def test_fr_113_an_unwritable_archive_directory_names_the_archive_path(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-113, FR-119: when the archive cannot be written at all — an unwritable
+    directory, a full disk, a read-only filesystem — the message names ARCHIVE
+    rather than the temporary file that could not be created, the status is 2,
+    and nothing is left behind (contracts/create-cli.md failure case 13)."""
+    monkeypatch.chdir(photos_source)
+
+    def refuse(*args, **kwargs):
+        raise OSError(28, "No space left on device")
+
+    monkeypatch.setattr(create.tempfile, "mkstemp", refuse)
+    result = run_cli(["create", "out.tar", "photos"])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "out.tar" in result.stderr
+    assert "No space left on device" in result.stderr
+    assert ".tarx-" not in result.stderr
+    assert not Path("out.tar").exists()
+    assert _leftovers() == []
+
+
+# --- FR-122: nothing outside ARCHIVE is touched -----------------------------
+
+
+def test_fr_122_a_successful_run_touches_nothing_outside_the_archive(
+    run_cli, photos_source, monkeypatch, snapshot_tree
+):
+    """FR-122: on success, every PATH is read only — the source tree's contents,
+    kinds, and modification times are all unchanged."""
+    monkeypatch.chdir(photos_source)
+    tree = photos_source / "photos"
+    before_contents = snapshot_tree(tree)
+    before_stamps = _stamps(tree)
+
+    assert run_cli(["create", "out.tar", "photos", "notes.txt"]).status == 0
+
+    assert snapshot_tree(tree) == before_contents
+    assert _stamps(tree) == before_stamps
+    assert sorted(os.listdir(".")) == ["notes.txt", "out.tar", "photos"]
+
+
+def test_fr_122_a_failing_run_touches_nothing_at_all(
+    run_cli, photos_source, monkeypatch, snapshot_tree
+):
+    """FR-122, FR-119: on failure, nothing anywhere is created, modified, or
+    deleted — not the source tree, and not the archive's directory."""
+    monkeypatch.chdir(photos_source)
+    helpers.add_symlink(photos_source, "photos/link", "a.jpg")
+    tree = photos_source / "photos"
+    before_contents = snapshot_tree(tree)
+    before_stamps = _stamps(tree)
+    before_listing = sorted(os.listdir("."))
+
+    result = run_cli(["create", "out.tar", "photos"])
+    assert result.status == 2
+
+    assert snapshot_tree(tree) == before_contents
+    assert _stamps(tree) == before_stamps
+    assert sorted(os.listdir(".")) == before_listing
+
+
+# --- Unreadable inputs (spec Edge Cases, R-116) -----------------------------
+
+
+@pytest.mark.skipif(os.geteuid() == 0, reason="file modes are not enforced for root")
+def test_fr_117_an_unreadable_directory_fails_naming_it(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-117, FR-119: a directory that cannot be read fails the command with
+    status 2, naming the path, and produces no archive — never an archive
+    quietly missing that member (R-116)."""
+    monkeypatch.chdir(photos_source)
+    closed = photos_source / "photos" / "closed"
+    closed.mkdir()
+    (closed / "secret.txt").write_bytes(b"secret")
+    os.chmod(closed, 0o000)
+    try:
+        result = run_cli(["create", "out.tar", "photos"])
+        assert result.status == 2
+        assert "photos/closed" in result.stderr
+        assert not Path("out.tar").exists()
+        assert _leftovers() == []
+    finally:
+        os.chmod(closed, 0o700)
+
+
+@pytest.mark.skipif(os.geteuid() == 0, reason="file modes are not enforced for root")
+def test_fr_119_an_unreadable_file_fails_leaving_no_archive(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-119, FR-113: a regular file that cannot be opened fails the command
+    with status 2, naming the member, and leaves no archive and no temporary
+    file behind — the failure happens during the write pass, and the
+    temporary-file design makes it indistinguishable in its effects from an
+    early one (R-116)."""
+    monkeypatch.chdir(photos_source)
+    locked = photos_source / "photos" / "locked.bin"
+    locked.write_bytes(b"unreadable")
+    os.chmod(locked, 0o000)
+    try:
+        result = run_cli(["create", "out.tar", "photos"])
+        assert result.status == 2
+        assert "photos/locked.bin" in result.stderr
+        assert not Path("out.tar").exists()
+        assert _leftovers() == []
+    finally:
+        os.chmod(locked, 0o600)
