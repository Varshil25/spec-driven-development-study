diff --git a/src/tarx/create.py b/src/tarx/create.py
new file mode 100644
index 0000000..b0e2a94
--- /dev/null
+++ b/src/tarx/create.py
@@ -0,0 +1,661 @@
+"""The create-side validate-then-write sequence.
+
+Pass 1 (:func:`plan_members`) validates every PATH, flattens every tree into an
+ordered member list, and writes nothing. Pass 2 (:func:`write_archive`) writes.
+The boundary between them is visible in :func:`create_archive`, which is where
+FR-118, FR-119, and SC-106 are enforced.
+
+The module is deliberately the mirror image of :mod:`tarx.extract`: a pass that
+decides everything before a pass that acts, so a reader who knows one knows the
+other.
+
+Pass 2 never calls ``TarFile.add()`` or ``TarFile.gettarinfo()``: every
+``TarInfo`` is built field by field, so the local account's uid, gid, user name,
+group name, permissions, and timestamps are never even read into a header
+(SR-108, R-101). It never writes to ARCHIVE directly either: content goes to a
+``mkstemp`` temporary file in ARCHIVE's own directory — created ``0o600`` at
+creation — which is renamed into place as the final act, so no failure at any
+point can leave a partial archive behind (FR-119, SR-107, R-104).
+"""
+
+import errno
+import gzip
+import os
+import stat
+import tarfile
+import tempfile
+from dataclasses import dataclass
+from pathlib import Path
+from typing import List, Literal, Optional
+
+from . import paths
+from .archive import (
+    COPY_CHUNK_BYTES,
+    MAX_MEMBER_BYTES,
+    MAX_MEMBERS,
+    MAX_TOTAL_BYTES,
+)
+from .errors import OverwriteConflict, TarxError
+from .paths import escape_name
+
+#: Fixed mode recorded for every file member — never the mode on disk (SR-108).
+MEMBER_FILE_MODE = 0o644
+
+#: Fixed mode recorded for every directory member (SR-108).
+MEMBER_DIR_MODE = 0o755
+
+
+@dataclass(frozen=True)
+class SourcePath:
+    """One PATH exactly as the command line gave it (data-model.md section 1).
+
+    ``given`` is the only value ever printed (through
+    :func:`~tarx.paths.escape_name`); ``components`` is the only value ever used
+    to touch the filesystem. ``./photos/`` and ``photos`` differ in ``given``
+    and agree in ``components``, which is what FR-104 requires.
+    """
+
+    given: str
+    components: tuple
+    name: str
+
+
+@dataclass(frozen=True)
+class PlannedMember:
+    """One entry to be recorded in the archive (data-model.md section 2).
+
+    ``kind`` is a closed two-value set by construction: enumeration refuses
+    everything that is not a regular file or a directory (SR-102), so there is
+    no third case downstream. A directory's ``size`` is ``0``.
+
+    ``size`` is the value the SR-105 bounds are checked against. It is *not* the
+    value written into the header: that comes from ``os.fstat`` on the open
+    descriptor at write time, and a disagreement between the two is FR-120's
+    failure.
+    """
+
+    name: str
+    kind: Literal["file", "dir"]
+    path: Path
+    size: int
+    origin: str
+
+
+@dataclass(frozen=True)
+class CreationPlan:
+    """The complete, validated member set (data-model.md section 3).
+
+    By the time a plan exists, every check that precedes writing has passed
+    (FR-118). ``file_count`` is computed here rather than counted while writing,
+    so the number reported on success is the number that was validated
+    (FR-110, FR-111).
+    """
+
+    members: List[PlannedMember]
+    file_count: int
+    total_bytes: int
+
+
+@dataclass(frozen=True)
+class ArchiveTarget:
+    """Where the archive goes, and what is there now (data-model.md section 4).
+
+    Classified by a single ``os.lstat`` before any traversal. Until the final
+    rename succeeds, no archive exists at ``path``.
+    """
+
+    given: str
+    path: Path
+    compressed: bool
+    replacing: bool
+
+
+def _kind_description(mode: int, nlink: int = 1) -> str:
+    """What an entry actually is, in operator-facing words (FR-113, SR-102).
+
+    A hard link is reported as such: on disk it is indistinguishable from a
+    regular file except by its link count, and SR-102 lists it among the kinds
+    that must be refused by name.
+    """
+    if stat.S_ISLNK(mode):
+        return "a symbolic link"
+    if stat.S_ISDIR(mode):
+        return "a directory"
+    if stat.S_ISREG(mode):
+        return "a hard link" if nlink > 1 else "a regular file"
+    if stat.S_ISCHR(mode):
+        return "a character device"
+    if stat.S_ISBLK(mode):
+        return "a block device"
+    if stat.S_ISFIFO(mode):
+        return "a FIFO"
+    if stat.S_ISSOCK(mode):
+        return "a socket"
+    return "an unsupported kind of file"
+
+
+def _lstat_source(path: Path, shown: str) -> os.stat_result:
+    """``lstat`` ``path``, or fail naming it as the user gave it (FR-117).
+
+    ``lstat``, never ``stat``: a symbolic link must be seen as a link so SR-102
+    can refuse it rather than silently archiving whatever it points at.
+    """
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        raise TarxError(f"{shown}: no such file or directory") from None
+    except OSError as exc:
+        raise TarxError(
+            f"{shown}: cannot be examined: "
+            f"{escape_name(exc.strerror or 'operation failed')}"
+        ) from exc
+
+
+def _scan_children(path: Path, name: str):
+    """The entries of directory ``path``, sorted by name in code-point order.
+
+    ``follow_symlinks=False`` everywhere, so a symlink to a directory is seen as
+    a symlink and refused by SR-102 rather than descended into (SR-103, R-106).
+    An unreadable directory fails here, naming itself — never silently producing
+    an archive with the member missing (R-116).
+    """
+    try:
+        with os.scandir(path) as entries:
+            children = [
+                (
+                    path / entry.name,
+                    f"{name}/{entry.name}",
+                    entry.stat(follow_symlinks=False),
+                )
+                for entry in entries
+            ]
+    except OSError as exc:
+        raise TarxError(
+            f"{escape_name(name)}: cannot be read: "
+            f"{escape_name(exc.strerror or 'operation failed')}"
+        ) from exc
+    children.sort(key=lambda child: child[1])
+    return children
+
+
+def plan_members(given_paths, archive_path) -> CreationPlan:
+    """Pass 1 — validate, traverse, and order every member. Writes nothing.
+
+    Each PATH is validated lexically (SR-101), ``lstat``-ed (FR-117), and
+    refused unless it is a regular file or a directory (SR-102). A directory is
+    then walked with an **explicit stack** — never recursion, so a tree deeper
+    than ``sys.getrecursionlimit()`` cannot raise ``RecursionError`` and reach
+    stderr as a traceback (SR-111, R-106) — emitting the directory's own member
+    first and then its entries in ascending code-point order, each
+    subdirectory's contents immediately following its own member (FR-106,
+    R-107).
+
+    Nothing here writes, opens for writing, or creates anything: by the time a
+    :class:`CreationPlan` is returned, every check that precedes writing has
+    passed (FR-103, FR-104, FR-105, FR-118, SR-103).
+    """
+    members: List[PlannedMember] = []
+    claimed = {}  # member name -> the PATH that produced it (SR-104, R-108)
+    file_count = 0
+    total_bytes = 0
+    archive_key = os.path.abspath(archive_path)
+
+    def record(member: PlannedMember) -> None:
+        """Claim a member's name and charge it against the bounds.
+
+        One name map is the single detection point for all three SR-104 cases —
+        the same PATH twice, two PATHs normalising to the same location, and one
+        PATH nested inside a directory PATH — because once PATHs are normalised
+        all three mean "two members would carry the same name" (R-108). It also
+        guarantees ``extract`` cannot reject the archive for duplicate members,
+        which is part of FR-109's promise.
+
+        The bounds are charged as each member is appended, so the cap fires
+        before the whole tree has been walked (SR-105, data-model.md rule 6).
+        """
+        nonlocal file_count, total_bytes
+        previous = claimed.get(member.name)
+        if previous is not None:
+            raise TarxError(
+                f"member {escape_name(member.name)} would be archived twice, from "
+                f"{escape_name(previous)} and from {escape_name(member.origin)}; "
+                "name each file or directory once"
+            )
+        claimed[member.name] = member.origin
+
+        if len(members) + 1 > MAX_MEMBERS:
+            raise TarxError(
+                f"too many members: the limit is {MAX_MEMBERS} members per "
+                f"archive, exceeded at member {escape_name(member.name)}"
+            )
+        if member.size > MAX_MEMBER_BYTES:
+            raise TarxError(
+                f"member {escape_name(member.name)}: {member.size} bytes exceeds "
+                f"the per-member limit of {MAX_MEMBER_BYTES} bytes"
+            )
+        if total_bytes + member.size > MAX_TOTAL_BYTES:
+            raise TarxError(
+                f"total size exceeds the limit of {MAX_TOTAL_BYTES} bytes across "
+                f"all members, exceeded at member {escape_name(member.name)}"
+            )
+
+        members.append(member)
+        if member.kind == "file":
+            file_count += 1
+            total_bytes += member.size
+
+    for given in given_paths:
+        components = paths.validate_source_path(given)
+        source = SourcePath(given, components, "/".join(components))
+        shown = escape_name(source.given)
+        root_path = Path(*components)
+        root_info = _lstat_source(root_path, shown)
+
+        # An explicit LIFO stack, seeded with the PATH itself. Children are
+        # pushed in reverse sorted order so they are visited ascending.
+        stack = [(root_path, source.name, root_info, True)]
+        while stack:
+            path, name, info, direct = stack.pop()
+
+            # SR-109: the archive is never a member of itself. Found by
+            # traversal it is omitted silently, as SR-109 requires, so
+            # ``create photos/out.tar photos`` still works on a rerun with
+            # --overwrite; named directly as a PATH it is refused, because
+            # Principle II forbids quietly dropping something the user typed
+            # (R-109). The temporary file needs no rule: it is created only
+            # after enumeration ends.
+            if os.path.abspath(path) == archive_key:
+                if direct:
+                    raise TarxError(
+                        f"{escape_name(source.given)}: refusing to archive the "
+                        "archive being written into itself"
+                    )
+                continue
+
+            mode = info.st_mode
+            if stat.S_ISDIR(mode):
+                record(
+                    PlannedMember(
+                        name=name, kind="dir", path=path, size=0, origin=source.given
+                    )
+                )
+                stack.extend(
+                    (child_path, child_name, child_info, False)
+                    for child_path, child_name, child_info in reversed(
+                        _scan_children(path, name)
+                    )
+                )
+            elif stat.S_ISREG(mode) and info.st_nlink == 1:
+                record(
+                    PlannedMember(
+                        name=name,
+                        kind="file",
+                        path=path,
+                        size=info.st_size,
+                        origin=source.given,
+                    )
+                )
+            else:
+                # Never silently skipped, and a symbolic link is never followed:
+                # the whole command fails, naming the member and its kind
+                # (SR-102, SR-103, data-model.md rule 4).
+                raise TarxError(
+                    f"{escape_name(name)}: refusing "
+                    f"{_kind_description(mode, info.st_nlink)}; only regular files "
+                    "and directories can be archived"
+                )
+
+    # Every name the producer computed is run through the very validator the
+    # consumer applies, so FR-109's round-trip promise is an executed check
+    # rather than an argument (R-112, data-model.md rule 8).
+    for member in members:
+        paths.validate_member_name(member.name)
+
+    return CreationPlan(
+        members=members, file_count=file_count, total_bytes=total_bytes
+    )
+
+
+class _ExactReader:
+    """A reader that fills every request exactly, or fails naming the member.
+
+    ``tarfile.copyfileobj`` treats a short read as a bare
+    ``OSError("unexpected end of data")``, which names no file and would breach
+    FR-113. Detecting the condition here is what lets the message say which
+    member shrank while it was being read (FR-120, R-110).
+
+    Reads are issued in ``COPY_CHUNK_BYTES`` chunks, so no file's contents are
+    ever held whole in memory however large the file is (SR-106); only the
+    bytes of the request in flight — ``tarfile``'s copy buffer — are held.
+    """
+
+    def __init__(self, fd: int, size: int, member_name: str) -> None:
+        self._fd = fd
+        self._remaining = size
+        self._shown = escape_name(member_name)
+        self.streamed = 0
+
+    def read(self, amount: Optional[int] = None) -> bytes:
+        if amount is None or amount < 0:
+            wanted = self._remaining
+        else:
+            wanted = min(amount, self._remaining)
+        chunks = []
+        filled = 0
+        while filled < wanted:
+            chunk = os.read(self._fd, min(wanted - filled, COPY_CHUNK_BYTES))
+            if not chunk:
+                raise TarxError(
+                    f"member {self._shown}: the file shrank while it was being "
+                    "read, so its contents would not match the size recorded for "
+                    "it; no archive has been written"
+                )
+            chunks.append(chunk)
+            filled += len(chunk)
+        self._remaining -= filled
+        self.streamed += filled
+        return b"".join(chunks)
+
+
+def _member_tarinfo(member: PlannedMember, size: int) -> tarfile.TarInfo:
+    """Build one header field by field — never from disk (SR-108, R-101).
+
+    ``TarFile.add()`` and ``TarFile.gettarinfo()`` are deliberately not used:
+    they copy the on-disk ``st_uid``, ``st_gid``, ``st_mode``, and ``st_mtime``
+    into the header and resolve the local account's user and group names, which
+    is exactly what SR-108 forbids. Every field below is either the member's
+    name, its size, or a constant, so no on-disk metadata can reach an archive.
+    """
+    info = tarfile.TarInfo(member.name)
+    if member.kind == "dir":
+        info.type = tarfile.DIRTYPE
+        info.mode = MEMBER_DIR_MODE
+        info.size = 0
+    else:
+        info.type = tarfile.REGTYPE
+        info.mode = MEMBER_FILE_MODE
+        info.size = size
+    info.uid = 0
+    info.gid = 0
+    info.uname = ""
+    info.gname = ""
+    info.mtime = 0
+    info.linkname = ""
+    return info
+
+
+def _add_file_member(
+    tar: tarfile.TarFile, member: PlannedMember, total_streamed: int
+) -> int:
+    """Stream one regular file into ``tar`` and return the new running total.
+
+    The file is opened once with ``O_NOFOLLOW``, so a file swapped for a symlink
+    between the two passes fails with ``ELOOP`` rather than being followed
+    (SR-102, R-110), and its size is taken from ``os.fstat`` on *that*
+    descriptor, so the header cannot disagree with the bytes that are read.
+
+    Three checks guard FR-120 and SR-105: the descriptor's size must still be
+    the size enumeration recorded, the stream must deliver exactly that many
+    bytes (:class:`_ExactReader`), and one extra byte must not be readable
+    afterwards. Any failure leaves the temporary file to be unlinked by
+    :func:`write_archive`, so there is never a corrupt member in a surviving
+    archive (FR-119, data-model.md rules 9–10).
+    """
+    shown = escape_name(member.name)
+    try:
+        fd = os.open(member.path, os.O_RDONLY | os.O_NOFOLLOW)
+    except OSError as exc:
+        if exc.errno == errno.ELOOP:
+            raise TarxError(
+                f"member {shown}: refusing a symbolic link, which this tool will "
+                "not follow"
+            ) from exc
+        raise TarxError(
+            f"member {shown}: cannot be read: "
+            f"{escape_name(exc.strerror or 'operation failed')}"
