+def test_sr_111_a_tree_deeper_than_the_recursion_limit_raises_no_recursion_error(
+    run_cli, tmp_path, monkeypatch
+):
+    """SR-111: a tree deeper than ``sys.getrecursionlimit()`` is traversed
+    iteratively, so no ``RecursionError`` — which is not an ``OSError`` and would
+    reach stderr as a traceback — can ever be raised (R-106)."""
+    monkeypatch.chdir(tmp_path)
+    depth = sys.getrecursionlimit() + 50
+    deep_root = tmp_path / "deep"
+    try:
+        helpers.build_deep_tree(deep_root, depth)
+        result = run_cli(["create", "out.tar", "deep"])
+        assert result.status == 0, result.stderr
+        assert result.stdout == "created out.tar with 0 files\n"
+        for marker in TRACEBACK_MARKERS:
+            assert marker not in result.stderr
+        assert "RecursionError" not in result.stderr
+        with tarfile.open("out.tar") as tar:
+            names = tar.getnames()
+        assert len(names) == depth + 1
+        assert all(member.endswith("d") or member == "deep" for member in names)
+    finally:
+        helpers.remove_deep_tree(deep_root)
