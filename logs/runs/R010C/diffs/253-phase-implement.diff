index 0000000..9ba2280
--- /dev/null
+++ b/tests/test_create_limits.py
@@ -0,0 +1,154 @@
+"""The resource bounds on the create side.
+
+Covers SR-105 of ``specs/002-create-archive-command/spec.md``: at most 10,000
+members, 1 GiB in total, and 1 GiB in any single member — the same fixed
+constants ``list`` and ``extract`` enforce, read from the same module. Every
+breach must be an error, never a truncated best-effort archive.
+"""
+
+import ast
+import os
+from pathlib import Path
+
+import pytest
+
+import helpers
+from tarx import archive as archive_module
+from tarx import create
+from tarx.errors import TarxError
+
+CREATE_SOURCE = Path(__file__).resolve().parents[1] / "src" / "tarx" / "create.py"
+
+
+def _leftovers(directory="."):
+    return [name for name in os.listdir(directory) if name.startswith(".tarx-")]
+
+
+def test_sr_105_the_bounds_are_imported_not_redefined():
+    """SR-105: the bounds are the *same* constants the existing commands
+    enforce, imported from :mod:`tarx.archive` rather than redefined, so "the
+    same bounds as the existing commands" cannot drift (R-111)."""
+    assert create.MAX_MEMBERS is archive_module.MAX_MEMBERS
+    assert create.MAX_TOTAL_BYTES is archive_module.MAX_TOTAL_BYTES
+    assert create.MAX_MEMBER_BYTES is archive_module.MAX_MEMBER_BYTES
+    assert create.COPY_CHUNK_BYTES is archive_module.COPY_CHUNK_BYTES
+    assert archive_module.MAX_MEMBERS == 10_000
+    assert archive_module.MAX_TOTAL_BYTES == 1 << 30
+    assert archive_module.MAX_MEMBER_BYTES == 1 << 30
+
+    assigned = {
+        target.id
+        for node in ast.walk(ast.parse(CREATE_SOURCE.read_text(encoding="utf-8")))
+        if isinstance(node, ast.Assign)
+        for target in node.targets
+        if isinstance(target, ast.Name)
+    }
+    assert not {name for name in assigned if name.startswith("MAX_")}
+
+
+def test_sr_105_too_many_members_is_an_error_not_a_truncated_archive(
+    run_cli, tmp_path, monkeypatch
+):
+    """SR-105: a tree of more than ``MAX_MEMBERS`` entries fails with status 2,
+    naming the bound, and leaves no archive at all."""
+    monkeypatch.chdir(tmp_path)
+    helpers.build_many_files(tmp_path / "many", archive_module.MAX_MEMBERS + 1)
+
+    result = run_cli(["create", "out.tar", "many"])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert str(archive_module.MAX_MEMBERS) in result.stderr
+    assert not Path("out.tar").exists()
+    assert _leftovers() == []
+
+
+def test_sr_105_exactly_the_member_cap_is_still_accepted(
+    run_cli, tmp_path, monkeypatch
+):
+    """SR-105: the cap is a limit, not an off-by-one — a tree of exactly
+    ``MAX_MEMBERS`` members is archived, and ``list`` reads it back."""
+    monkeypatch.chdir(tmp_path)
+    # The directory member counts too, so one fewer file reaches the cap exactly.
+    helpers.build_many_files(tmp_path / "many", archive_module.MAX_MEMBERS - 1)
+
+    result = run_cli(["create", "out.tar", "many"])
+    assert result.status == 0, result.stderr
+    assert result.stdout == f"created out.tar with {archive_module.MAX_MEMBERS - 1} files\n"
+    assert len(run_cli(["list", "out.tar"]).stdout.splitlines()) == (
+        archive_module.MAX_MEMBERS
+    )
+
+
+def test_sr_105_a_single_oversized_file_is_an_error(run_cli, tmp_path, monkeypatch):
+    """SR-105: a single file larger than ``MAX_MEMBER_BYTES`` fails with status 2
+    and leaves no archive."""
+    monkeypatch.chdir(tmp_path)
+    helpers.build_oversized_tree(
+        tmp_path / "big", member_bytes=archive_module.MAX_MEMBER_BYTES + 1
+    )
+
+    result = run_cli(["create", "out.tar", "big"])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "big/huge.bin" in result.stderr
+    assert str(archive_module.MAX_MEMBER_BYTES) in result.stderr
+    assert not Path("out.tar").exists()
+    assert _leftovers() == []
+
+
+def test_sr_105_an_oversized_total_is_an_error(run_cli, tmp_path, monkeypatch):
+    """SR-105: a tree whose total exceeds ``MAX_TOTAL_BYTES`` fails with status 2
+    and leaves no archive, even though no single member breaches its own bound."""
+    monkeypatch.chdir(tmp_path)
+    helpers.build_oversized_tree(
+        tmp_path / "big", total_bytes=archive_module.MAX_TOTAL_BYTES
+    )
+
+    result = run_cli(["create", "out.tar", "big"])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert str(archive_module.MAX_TOTAL_BYTES) in result.stderr
+    assert not Path("out.tar").exists()
+    assert _leftovers() == []
+
+
+def test_sr_105_the_write_pass_enforces_the_bounds_again(
+    tmp_path, monkeypatch, photos_source
+):
+    """SR-105: the bounds are checked a second time against the bytes actually
+    written, so a tree that grows past a bound between enumeration and writing is
+    still refused — and, because writing goes to a temporary file, still leaves
+    no archive (R-111)."""
+    monkeypatch.chdir(photos_source)
+    target = create.classify_target("out.tar", False)
+    plan = create.plan_members(["photos"], "out.tar")
+
+    # The plan passed the real bounds; shrink them so only the write pass can
+    # object, which is what proves the write-pass check exists.
+    monkeypatch.setattr(create, "MAX_TOTAL_BYTES", 4)
+    with pytest.raises(TarxError) as refused:
+        create.write_archive(plan, target)
+
+    assert refused.value.exit_code == 2
+    assert "4" in refused.value.message
+    assert not Path("out.tar").exists()
+    assert _leftovers() == []
+
+
+def test_sr_105_the_write_pass_bounds_a_single_member_too(
+    monkeypatch, photos_source
+):
+    """SR-105: the per-member bound is re-checked at write time as well, against
+    the size of the descriptor actually opened."""
+    monkeypatch.chdir(photos_source)
+    target = create.classify_target("out.tar", False)
+    plan = create.plan_members(["photos"], "out.tar")
+
+    monkeypatch.setattr(create, "MAX_MEMBER_BYTES", 2)
+    with pytest.raises(TarxError) as refused:
+        create.write_archive(plan, target)
+
+    assert refused.value.exit_code == 2
+    assert "per-member limit" in refused.value.message
+    assert not Path("out.tar").exists()
+    assert _leftovers() == []
