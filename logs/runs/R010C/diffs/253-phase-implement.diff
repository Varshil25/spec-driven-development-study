@@ -0,0 +1,212 @@
+"""The acceptance corpus: ``create`` → ``list`` → ``extract`` must round-trip.
+
+Covers FR-107 and FR-109 (and SC-101 – SC-103, SC-107, SC-109), plus the SR-108
+header-field normalisation, over every tree in the corpus fixture.
+"""
+
+import gzip
+import os
+import stat
+import tarfile
+from pathlib import Path
+
+import helpers
+from tarx import archive as archive_module
+
+
+def _listed(run_cli, archive):
+    listed = run_cli(["list", str(archive)])
+    assert listed.status == 0, listed.stderr
+    return listed.stdout.splitlines()
+
+
+def _tree_files(root):
+    """Every regular file beneath ``root`` as ``{relative path: bytes}``."""
+    found = {}
+    for dirpath, _dirnames, filenames in os.walk(root):
+        for name in filenames:
+            path = Path(dirpath) / name
+            found[str(path.relative_to(root))] = path.read_bytes()
+    return found
+
+
+def test_fr_109_list_prints_the_expected_members_in_order(
+    run_cli, acceptance_corpus, monkeypatch
+):
+    """FR-109 (SC-102): for every tree in the acceptance corpus, ``list`` prints
+    exactly the expected member names in the expected order, line for line."""
+    tree = acceptance_corpus
+    monkeypatch.chdir(tree.root)
+    created = run_cli(["create", tree.archive, *tree.paths])
+    assert created.status == 0, created.stderr
+    assert _listed(run_cli, tree.archive) == tree.members
+
+
+def test_fr_107_and_fr_109_extract_reproduces_the_tree_exactly(
+    run_cli, acceptance_corpus, monkeypatch
+):
+    """FR-107, FR-109 (SC-101, SC-103): ``create`` followed by ``extract`` into a
+    fresh directory reproduces identical relative paths and byte-identical
+    contents, no member is rejected, and the reported N is the number of regular
+    files in the source tree."""
+    tree = acceptance_corpus
+    monkeypatch.chdir(tree.root)
+    created = run_cli(["create", tree.archive, *tree.paths])
+    assert created.status == 0, created.stderr
+    assert created.stdout == (
+        f"created {tree.archive} with {tree.file_count} files\n"
+    )
+
+    extracted = run_cli(["extract", tree.archive, "back"])
+    assert extracted.status == 0, extracted.stderr
+    assert extracted.stdout == f"extracted {tree.file_count} files\n"
+
+    back = tree.root / "back"
+    assert _tree_files(back) == tree.files
+    for relative in tree.dirs:
+        assert (back / relative).is_dir(), relative
+
+
+def test_fr_105_an_empty_directory_survives_the_round_trip(
+    run_cli, tmp_path, monkeypatch
+):
+    """FR-105, FR-109: an empty subdirectory is recorded and recreated."""
+    monkeypatch.chdir(tmp_path)
+    helpers.build_source_tree(tmp_path / "tree", {"a.txt": b"a"})
+    helpers.build_empty_dirs(tmp_path / "tree", ["hollow"])
+    assert run_cli(["create", "out.tgz", "tree"]).status == 0
+    assert run_cli(["extract", "out.tgz", "back"]).status == 0
+    assert (tmp_path / "back" / "tree" / "hollow").is_dir()
+    assert not any((tmp_path / "back" / "tree" / "hollow").iterdir())
+
+
+def test_fr_107_zero_byte_files_are_regular_files_and_are_counted(
+    run_cli, tmp_path, monkeypatch
+):
+    """FR-107, FR-111: a zero-byte file is recorded as a regular file, counted in
+    N, and restored as an empty regular file."""
+    monkeypatch.chdir(tmp_path)
+    helpers.build_source_tree(tmp_path / "tree", {"zero.bin": b""})
+    result = run_cli(["create", "out.tar", "tree"])
+    assert result.stdout == "created out.tar with 1 files\n"
+
+    with tarfile.open("out.tar") as tar:
+        (zero,) = [m for m in tar.getmembers() if m.name == "tree/zero.bin"]
+        assert zero.isreg()
+        assert zero.size == 0
+
+    assert run_cli(["extract", "out.tar", "back"]).status == 0
+    restored = tmp_path / "back" / "tree" / "zero.bin"
+    assert restored.is_file()
+    assert restored.read_bytes() == b""
+
+
+def test_fr_107_names_with_spaces_and_non_ascii_round_trip_byte_for_byte(
+    run_cli, tmp_path, monkeypatch
+):
+    """FR-107, FR-109: names with spaces and non-ASCII characters survive the
+    round trip unchanged (R-102's PAX format)."""
+    monkeypatch.chdir(tmp_path)
+    payload = {
+        "odd dir/a b.txt": b"spaces",
+        "odd dir/ünïcode.txt": b"accents",
+        "odd dir/你好 — hi.txt": b"cjk",
+    }
+    helpers.build_source_tree(tmp_path, payload)
+    created = run_cli(["create", "out.tar.gz", "odd dir"])
+    assert created.status == 0, created.stderr
+    assert created.stdout == "created out.tar.gz with 3 files\n"
+    assert run_cli(["extract", "out.tar.gz", "back"]).status == 0
+    assert _tree_files(tmp_path / "back") == payload
+
+
+def test_fr_109_a_misnamed_archive_is_still_read_correctly(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-109: ``create`` picks compression from the name, but ``list`` and
+    ``extract`` keep deciding from content, so a deliberately misnamed archive
+    still reads correctly (001 FR-008, R-117)."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "gz-content.tgz", "photos"]).status == 0
+    assert run_cli(["create", "plain-content.tar", "photos"]).status == 0
+    os.rename("gz-content.tgz", "misnamed.tar")
+    os.rename("plain-content.tar", "misnamed.tgz")
+
+    assert archive_module.sniff_compression("misnamed.tar") == "gzip"
+    assert archive_module.sniff_compression("misnamed.tgz") == "none"
+    expected = ["photos", "photos/a.jpg", "photos/b.jpg", "photos/empty-sub"]
+    assert _listed(run_cli, "misnamed.tar") == expected
+    assert _listed(run_cli, "misnamed.tgz") == expected
+
+
+def test_sr_108_no_member_discloses_the_local_account(
+    run_cli, acceptance_corpus, monkeypatch
+):
+    """SR-108 (SC-107): no member records the local account's user name, group
+    name, uid, or gid, and none carries a setuid, setgid, or sticky bit."""
+    tree = acceptance_corpus
+    monkeypatch.chdir(tree.root)
+    assert run_cli(["create", tree.archive, *tree.paths]).status == 0
+
+    with tarfile.open(tree.archive) as tar:
+        members = tar.getmembers()
+    assert len(members) == len(tree.members)
+    for member in members:
+        assert member.uid == 0
+        assert member.gid == 0
+        assert member.uname == ""
+        assert member.gname == ""
+        assert member.mode & (stat.S_ISUID | stat.S_ISGID | stat.S_ISVTX) == 0
+
+
+def test_sr_108_every_header_field_is_fixed_not_read_from_disk(
+    run_cli, tmp_path, monkeypatch
+):
+    """SR-108: every ``TarInfo`` carries fixed values — uid/gid 0, empty user and
+    group names, mtime 0, mode 0o644 for files and 0o755 for directories, an
+    empty link name, and a type in ``{REGTYPE, DIRTYPE}`` only."""
+    monkeypatch.chdir(tmp_path)
+    helpers.build_source_tree(tmp_path / "tree", {"a.txt": b"a", "sub/b.txt": b"b"})
+    os.chmod(tmp_path / "tree" / "a.txt", 0o777)
+    os.chmod(tmp_path / "tree" / "sub", 0o700)
+    os.utime(tmp_path / "tree" / "a.txt", (1_000_000, 1_000_000))
+
+    assert run_cli(["create", "out.tar", "tree"]).status == 0
+    with tarfile.open("out.tar") as tar:
+        members = tar.getmembers()
+
+    assert [member.name for member in members] == [
+        "tree",
+        "tree/a.txt",
+        "tree/sub",
+        "tree/sub/b.txt",
+    ]
+    for member in members:
+        assert member.type in (tarfile.REGTYPE, tarfile.DIRTYPE)
+        assert member.uid == 0 and member.gid == 0
+        assert member.uname == "" and member.gname == ""
+        assert member.mtime == 0
+        assert member.linkname == ""
+        assert member.mode == (0o755 if member.isdir() else 0o644)
+        if member.isdir():
+            assert member.size == 0
+
+
+def test_sr_108_the_gzip_container_records_no_name_and_no_timestamp(
+    run_cli, photos_source, monkeypatch
+):
+    """SR-108, FR-106: the gzip container carries no filename and a zero
+    timestamp, so two runs over an unchanged tree produce byte-identical
+    archives (R-103)."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "first.tar.gz", "photos"]).status == 0
+    assert run_cli(["create", "second.tar.gz", "photos"]).status == 0
+
+    first = Path("first.tar.gz").read_bytes()
+    assert first[:2] == b"\x1f\x8b"
+    assert first[4:8] == b"\x00\x00\x00\x00", "gzip MTIME must be zero"
+    assert first[3] & 0x08 == 0, "gzip FNAME flag must not be set"
+    assert first == Path("second.tar.gz").read_bytes()
+
+    with gzip.open("first.tar.gz", "rb") as handle:
+        assert handle.read(2) != b"\x1f\x8b"
