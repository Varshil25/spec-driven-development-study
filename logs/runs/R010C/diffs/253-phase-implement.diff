+++ b/tests/test_create_overwrite.py
@@ -0,0 +1,271 @@
+"""Refusing to clobber: exit 3 for a pre-existing archive, exit 2 for anything
+else at the archive path.
+
+Covers FR-114, FR-115, FR-116 and FR-121 of
+``specs/002-create-archive-command/spec.md``.
+"""
+
+import os
+from pathlib import Path
+
+import pytest
+
+import helpers
+
+
+def _leftovers(directory):
+    """Any temporary file the command failed to clean up (FR-119)."""
+    return [name for name in os.listdir(directory) if name.startswith(".tarx-")]
+
+
+# --- FR-114: a pre-existing regular file is exit 3 --------------------------
+
+
+def test_fr_114_a_pre_existing_archive_is_refused_with_status_3(
+    run_cli, photos_source, monkeypatch, snapshot_bytes
+):
+    """FR-114: a regular file at ARCHIVE without ``--overwrite`` is refused —
+    nothing is written, the archive path is named on stderr, stdout stays empty,
+    the status is 3, and the existing file is byte-for-byte unchanged."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "photos.tar.gz", "photos"]).status == 0
+    before = snapshot_bytes("photos.tar.gz")
+
+    result = run_cli(["create", "photos.tar.gz", "photos"])
+    assert result.status == 3
+    assert result.stdout == ""
+    assert "photos.tar.gz" in result.stderr
+    assert snapshot_bytes("photos.tar.gz") == before
+    assert _leftovers(".") == []
+
+
+def test_fr_114_an_unrelated_regular_file_at_the_archive_path_is_also_status_3(
+    run_cli, photos_source, monkeypatch, snapshot_bytes
+):
+    """FR-114: the refusal is about the *path* being occupied by a regular file,
+    not about the file being an archive."""
+    monkeypatch.chdir(photos_source)
+    Path("out.tar").write_bytes(b"not an archive at all")
+    before = snapshot_bytes("out.tar")
+
+    result = run_cli(["create", "out.tar", "photos"])
+    assert result.status == 3
+    assert result.stdout == ""
+    assert snapshot_bytes("out.tar") == before
+
+
+# --- FR-115: --overwrite replaces it ----------------------------------------
+
+
+def test_fr_115_overwrite_replaces_the_existing_archive(
+    run_cli, photos_source, monkeypatch, snapshot_bytes
+):
+    """FR-115: with ``--overwrite`` the archive is replaced with one describing
+    the current tree, the success line is printed, and the status is 0."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "photos.tar.gz", "photos"]).status == 0
+    before = snapshot_bytes("photos.tar.gz")
+
+    helpers.build_source_tree(photos_source / "photos", {"c.jpg": b"gamma"})
+    result = run_cli(["create", "photos.tar.gz", "photos", "--overwrite"])
+    assert result.status == 0
+    assert result.stdout == "created photos.tar.gz with 3 files\n"
+    assert snapshot_bytes("photos.tar.gz") != before
+
+    listed = run_cli(["list", "photos.tar.gz"])
+    assert listed.stdout.splitlines() == [
+        "photos",
+        "photos/a.jpg",
+        "photos/b.jpg",
+        "photos/c.jpg",
+        "photos/empty-sub",
+    ]
+    assert os.stat("photos.tar.gz").st_mode & 0o777 == 0o600
+    assert _leftovers(".") == []
+
+
+def test_fr_115_overwrite_on_an_absent_path_is_not_an_error(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-115: ``--overwrite`` does not require something to be there."""
+    monkeypatch.chdir(photos_source)
+    result = run_cli(["create", "fresh.tar", "photos", "--overwrite"])
+    assert result.status == 0
+    assert result.stdout == "created fresh.tar with 2 files\n"
+
+
+# --- FR-116: anything else at the archive path is exit 2 --------------------
+
+
+def test_fr_116_a_directory_at_the_archive_path_is_status_2(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-116: a directory at ARCHIVE is reported, left untouched, and exits
+    2 — not 3 — with or without ``--overwrite``."""
+    monkeypatch.chdir(photos_source)
+    os.mkdir("adir")
+    helpers.build_source_tree(photos_source / "adir", {"keep.txt": b"keep"})
+
+    for argv in (["create", "adir", "photos"], ["create", "adir", "photos", "--overwrite"]):
+        result = run_cli(argv)
+        assert result.status == 2, argv
+        assert result.stdout == ""
+        assert "adir" in result.stderr
+        assert Path("adir").is_dir()
+        assert Path("adir/keep.txt").read_bytes() == b"keep"
+        assert _leftovers(".") == []
+
+
+def test_fr_116_a_symlink_at_the_archive_path_is_status_2_and_not_followed(
+    run_cli, photos_source, monkeypatch, snapshot_bytes
+):
+    """FR-116: a symbolic link at ARCHIVE is refused with status 2 and never
+    followed — its target is left unmodified."""
+    monkeypatch.chdir(photos_source)
+    Path("target.bin").write_bytes(b"precious")
+    os.symlink("target.bin", "link.tar")
+    before = snapshot_bytes("target.bin")
+
+    for argv in (
+        ["create", "link.tar", "photos"],
+        ["create", "link.tar", "photos", "--overwrite"],
+    ):
+        result = run_cli(argv)
+        assert result.status == 2, argv
+        assert result.stdout == ""
+        assert "link.tar" in result.stderr
+        assert Path("link.tar").is_symlink()
+        assert os.readlink("link.tar") == "target.bin"
+        assert snapshot_bytes("target.bin") == before
+        assert _leftovers(".") == []
+
+
+def test_fr_116_a_fifo_at_the_archive_path_is_status_2(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-116: a FIFO at ARCHIVE is refused with status 2, with or without
+    ``--overwrite``."""
+    monkeypatch.chdir(photos_source)
+    try:
+        helpers.add_fifo(photos_source, "pipe.tar")
+    except (OSError, AttributeError) as exc:  # pragma: no cover - platform dependent
+        pytest.skip(f"cannot create a FIFO here: {exc}")
+
+    for argv in (
+        ["create", "pipe.tar", "photos"],
+        ["create", "pipe.tar", "photos", "--overwrite"],
+    ):
+        result = run_cli(argv)
+        assert result.status == 2, argv
+        assert result.stdout == ""
+        assert "pipe.tar" in result.stderr
+        assert Path("pipe.tar").is_fifo()
+
+
+def test_fr_116_a_socket_or_device_at_the_archive_path_is_status_2(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-116: a socket or device at ARCHIVE is refused with status 2, where such
+    an entry can be created at all."""
+    monkeypatch.chdir(photos_source)
+    created = []
+    try:
+        created.append(helpers.add_socket(photos_source, "sock.tar"))
+    except OSError:  # pragma: no cover - platform dependent
+        pass
+    try:
+        created.append(helpers.add_device(photos_source, "dev.tar"))
+    except OSError:  # pragma: no cover - needs privilege
+        pass
+    if not created:  # pragma: no cover - platform dependent
+        pytest.skip("neither a socket nor a device can be created here")
+
+    for path in created:
+        for extra in ([], ["--overwrite"]):
+            result = run_cli(["create", path.name, "photos", *extra])
+            assert result.status == 2, (path.name, extra)
+            assert result.stdout == ""
+            assert path.name in result.stderr
+            assert os.path.lexists(path)
+
+
+def test_fr_116_a_missing_parent_directory_is_status_2_and_creates_nothing(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-116: ``create`` does not build directories for its own output — a
+    missing parent is an error with status 2 and no directory is created."""
+    monkeypatch.chdir(photos_source)
+    result = run_cli(["create", "nosuchdir/x.tar", "photos"])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "nosuchdir/x.tar" in result.stderr
+    assert not Path("nosuchdir").exists()
+
+    Path("afile").write_bytes(b"not a directory")
+    through_file = run_cli(["create", "afile/x.tar", "photos"])
+    assert through_file.status == 2
+    assert through_file.stdout == ""
+    assert Path("afile").read_bytes() == b"not a directory"
+
+
+# --- FR-121: status 3 has exactly one cause ---------------------------------
+
+
+def test_fr_121_status_3_comes_solely_from_the_pre_existing_archive_case(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-121: every failure other than a pre-existing regular file at ARCHIVE
+    without ``--overwrite`` is status 2, and no command produces a status
+    outside 0, 2 and 3."""
+    monkeypatch.chdir(photos_source)
+    Path("taken.tar").write_bytes(b"old")
+    os.mkdir("adir")
+    os.symlink("taken.tar", "link.tar")
+
+    # The archive path is classified before any traversal (data-model.md section
+    # 6, rule 3 before rule 4), so when a pre-existing archive is joined by a
+    # second problem the overwrite refusal is the first failure and wins.
+    expected_3 = [
+        ["create", "taken.tar", "photos"],
+        ["create", "taken.tar", "missing-folder"],
+    ]
+    expected_2 = [
+        ["create"],
+        ["create", "out.tar"],
+        ["create", "out.tar", ""],
+        ["create", "--verbose", "out.tar", "photos"],
+        ["create", "out.tar", "missing-folder"],
+        ["create", "out.tar", "/etc"],
+        ["create", "out.tar", ".."],
+        ["create", "out.tar", "."],
+        ["create", "out.tar", "photos", "photos"],
+        ["create", "adir", "photos"],
+        ["create", "adir", "photos", "--overwrite"],
+        ["create", "link.tar", "photos"],
+        ["create", "link.tar", "photos", "--overwrite"],
+        ["create", "nosuchdir/x.tar", "photos"],
+        ["create", "taken.tar", "missing-folder", "--overwrite"],
+        ["create", "taken.tar", "/etc"],
+    ]
+    expected_0 = [
+        ["create", "fine.tar", "photos"],
+        ["create", "taken.tar", "photos", "--overwrite"],
+    ]
+
+    observed = set()
+    for argv in expected_3:
+        result = run_cli(argv)
+        assert result.status == 3, (argv, result.stderr)
+        observed.add(result.status)
+    for argv in expected_2:
+        result = run_cli(argv)
+        assert result.status == 2, (argv, result.stderr)
+        assert result.stdout == "", argv
+        observed.add(result.status)
+    for argv in expected_0:
+        result = run_cli(argv)
+        assert result.status == 0, (argv, result.stderr)
+        observed.add(result.status)
+
+    assert observed == {0, 2, 3}
+    assert _leftovers(".") == []
