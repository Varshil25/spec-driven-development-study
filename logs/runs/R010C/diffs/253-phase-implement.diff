+# --- SR-107: the temporary file's permissions -------------------------------
+
+
+def test_sr_107_the_temporary_file_is_created_mode_600_and_never_survives(
+    run_cli, photos_source, monkeypatch
+):
+    """SR-107: the temporary file on the way to the final archive is created with
+    mode ``0o600`` — at creation, never setuid, setgid, or sticky — inside
+    ARCHIVE's own directory, and does not survive the command."""
+    monkeypatch.chdir(photos_source)
+    observed = {}
+    real_mkstemp = tempfile.mkstemp
+
+    def spy(*args, **kwargs):
+        fd, name = real_mkstemp(*args, **kwargs)
+        observed["name"] = name
+        observed["mode"] = os.stat(name).st_mode
+        observed["kwargs"] = kwargs
+        return fd, name
+
+    monkeypatch.setattr(create.tempfile, "mkstemp", spy)
+    assert run_cli(["create", "out.tar", "photos"]).status == 0
+
+    assert observed["mode"] & 0o777 == 0o600
+    assert observed["mode"] & 0o7000 == 0
+    assert observed["kwargs"]["prefix"] == ".tarx-"
+    assert Path(observed["kwargs"]["dir"]) == Path("out.tar").parent
+    assert not Path(observed["name"]).exists()
+    assert _leftovers() == []
