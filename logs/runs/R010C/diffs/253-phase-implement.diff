+    """
+    root = Path(root)
+    root.mkdir(parents=True, exist_ok=True)
+    # One level at a time: ``mkdir(parents=True)`` recurses once per missing
+    # parent, so building the tree would hit the very limit being tested.
+    current = root
+    for _ in range(depth):
+        current = current / "d"
+        os.mkdir(current)
+    return current
+
+
+def remove_deep_tree(root):
+    """Remove a tree without recursion.
+
+    ``shutil.rmtree`` recurses once per directory level, so it cannot remove a
+    tree built by :func:`build_deep_tree`; this walks bottom-up instead.
+    """
+    root = Path(root)
+    for dirpath, dirnames, filenames in os.walk(root, topdown=False):
+        for name in filenames:
+            os.unlink(os.path.join(dirpath, name))
+        for name in dirnames:
+            os.rmdir(os.path.join(dirpath, name))
+    if root.exists():
+        os.rmdir(root)
+
+
+def build_many_files(root, count):
+    """Build ``count`` zero-byte regular files in one directory, for the member cap."""
+    root = Path(root)
+    root.mkdir(parents=True, exist_ok=True)
+    for index in range(count):
+        (root / f"f{index:06d}.bin").touch()
+    return root
+
+
+def build_sparse_file(path, size):
+    """Create a file of ``size`` bytes that occupies almost no disk.
+
+    ``truncate`` makes the hole, so ``st_size`` reports the full size while the
+    filesystem stores nothing. This is what lets the SR-105 byte bounds be
+    tested at their real documented values (1 GiB) in a fraction of a second.
+    """
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "wb") as handle:
+        handle.truncate(size)
+    return path
+
+
+def build_oversized_tree(root, *, member_bytes=None, total_bytes=None):
+    """Build a tree that breaches a byte bound, using sparse files.
+
+    ``member_bytes`` builds one file of that size (for ``MAX_MEMBER_BYTES``);
+    ``total_bytes`` spreads that many bytes over two files, each individually
+    within the per-member bound (for ``MAX_TOTAL_BYTES``).
+    """
+    root = Path(root)
+    root.mkdir(parents=True, exist_ok=True)
+    if member_bytes is not None:
+        build_sparse_file(root / "huge.bin", member_bytes)
+    if total_bytes is not None:
+        half = total_bytes // 2 + 1
+        build_sparse_file(root / "half-a.bin", half)
+        build_sparse_file(root / "half-b.bin", total_bytes - half + 1)
+    return root
