+"""The ``create`` command surface: parsing, naming, ordering, and reporting.
+
+Covers FR-101, FR-102, FR-103, FR-104, FR-105, FR-106, FR-108, FR-110, FR-111,
+FR-112, FR-113, SR-106, SR-107 and SR-112 of
+``specs/002-create-archive-command/spec.md``.
+"""
+
+import ast
+import io
+import os
+import subprocess
+import sys
+import tokenize
+import tracemalloc
+from pathlib import Path
+
+import pytest
+
+import helpers
+from tarx import archive as archive_module
+
+SRC_DIR = Path(__file__).resolve().parents[1] / "src"
+CREATE_SOURCE = SRC_DIR / "tarx" / "create.py"
+
+
+def _code_only(source):
+    """``source`` with comments and string literals (so, docstrings) removed.
+
+    The SR-107 audit asks whether the module *calls* ``chmod``, not whether its
+    prose explains why it never does, so the audit has to look at code only.
+    """
+    kept = []
+    for token in tokenize.generate_tokens(io.StringIO(source).readline):
+        if token.type in (tokenize.COMMENT, tokenize.STRING):
+            continue
+        kept.append(token.string)
+    return " ".join(kept)
+
+
+def _members(run_cli, archive):
+    """Every member name ``list`` prints for ``archive``, in order."""
+    listed = run_cli(["list", str(archive)])
+    assert listed.status == 0, listed.stderr
+    return listed.stdout.splitlines()
+
+
+# --- FR-101: list and extract are untouched ---------------------------------
+
+
+def test_fr_101_list_and_extract_behave_exactly_as_before(
+    run_cli, photos_gz, photos_tar, empty_archive, tmp_path
+):
+    """FR-101: adding ``create`` changes nothing observable about ``list`` and
+    ``extract`` — the 001 contract still holds word for word."""
+    assert _members(run_cli, photos_gz) == ["photos", "photos/a.jpg", "photos/b.jpg"]
+    assert _members(run_cli, photos_tar) == ["photos", "photos/a.jpg", "photos/b.jpg"]
+    assert run_cli(["list", str(empty_archive)]).stdout == ""
+
+    extracted = run_cli(["extract", str(photos_gz), str(tmp_path / "out")])
+    assert extracted.status == 0
+    assert extracted.stdout == "extracted 2 files\n"
+    assert (tmp_path / "out" / "photos" / "a.jpg").read_bytes() == b"alpha"
+
+    again = run_cli(["extract", str(photos_gz), str(tmp_path / "out")])
+    assert again.status == 3
+    assert again.stdout == ""
+    assert (
+        run_cli(["extract", str(photos_gz), str(tmp_path / "out"), "--overwrite"]).status
+        == 0
+    )
+
+
+def test_fr_101_overwrite_is_still_a_usage_error_on_list(run_cli, photos_tar):
+    """FR-101, SR-112: ``--overwrite`` remains rejected by ``list`` and accepted
+    by ``extract`` and ``create``."""
+    from tarx import cli
+
+    refused = run_cli(["list", "--overwrite", str(photos_tar)])
+    assert refused.status == 2
+    assert refused.stdout == ""
+
+    (subparsers,) = [
+        action
+        for action in cli.build_parser()._actions
+        if hasattr(action, "choices") and action.choices
+    ]
+
+    def options(command):
+        return {
+            option
+            for action in subparsers.choices[command]._actions
+            for option in action.option_strings
+        }
+
+    assert "--overwrite" in options("create")
+    assert "--overwrite" in options("extract")
+    assert "--overwrite" not in options("list")
+
+
+# --- FR-102, SR-112: usage errors -------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "argv",
+    [
+        pytest.param(["create"], id="no-archive"),
+        pytest.param(["create", "out.tar"], id="no-path"),
+        pytest.param(["create", "--verbose", "out.tar", "p"], id="unknown-option"),
+        pytest.param(["create", "", "p"], id="empty-archive"),
+        pytest.param(["create", "out.tar", ""], id="empty-path"),
+        pytest.param(["create", "out.tar", "p", ""], id="empty-second-path"),
+    ],
+)
+def test_fr_102_and_sr_112_usage_errors_exit_2(run_cli, argv, monkeypatch, tmp_path):
+    """FR-102, SR-112: a missing ARCHIVE, a missing PATH, an unrecognised option,
+    and an empty-string ARCHIVE or PATH each write usage to stderr and exit 2."""
+    monkeypatch.chdir(tmp_path)
+    result = run_cli(argv)
+    assert result.status == 2
+    assert result.stdout == ""
+    assert result.stderr != ""
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_fr_102_create_accepts_one_archive_and_many_paths(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-102, FR-103: one ARCHIVE and one or more PATHs are accepted."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "one.tar", "notes.txt"]).status == 0
+    assert run_cli(["create", "many.tar", "notes.txt", "photos"]).status == 0
+
+
+# --- FR-103, FR-104, FR-105: what goes in, and under what name --------------
+
+
+def test_fr_103_a_file_path_and_a_directory_path(run_cli, photos_source, monkeypatch):
+    """FR-103: a file PATH contributes itself; a directory PATH is archived
+    recursively, together with everything beneath it."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "file.tar", "notes.txt"]).status == 0
+    assert _members(run_cli, "file.tar") == ["notes.txt"]
+
+    assert run_cli(["create", "dir.tar", "photos"]).status == 0
+    assert _members(run_cli, "dir.tar") == [
+        "photos",
+        "photos/a.jpg",
+        "photos/b.jpg",
+        "photos/empty-sub",
+    ]
+
+
+def test_fr_104_members_are_named_by_their_relative_path(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-104: each member is named by its path relative to the current
+    directory, joined with ``/``."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "out.tar", "notes.txt", "photos"]).status == 0
+    assert _members(run_cli, "out.tar") == [
+        "notes.txt",
+        "photos",
+        "photos/a.jpg",
+        "photos/b.jpg",
+        "photos/empty-sub",
+    ]
+
+
+def test_fr_104_redundant_dot_and_trailing_separators_are_normalised(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-104, SR-101: ``./photos/`` and ``photos`` name the same members."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "plain.tar", "photos"]).status == 0
+    assert run_cli(["create", "odd.tar", "./photos/"]).status == 0
+    assert _members(run_cli, "odd.tar") == _members(run_cli, "plain.tar")
+    assert Path("plain.tar").read_bytes() == Path("odd.tar").read_bytes()
+
+
+def test_fr_105_ancestors_above_a_path_are_not_members(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-105: a subdirectory PATH records itself and its contents, never the
+    ancestor directories above it."""
+    monkeypatch.chdir(photos_source)
+    helpers.build_source_tree(photos_source / "photos" / "sub", {"c.jpg": b"gamma"})
+    assert run_cli(["create", "out.tar", "photos/sub"]).status == 0
+    assert _members(run_cli, "out.tar") == ["photos/sub", "photos/sub/c.jpg"]
+
+
+def test_fr_105_every_directory_is_recorded_as_a_directory_member(
+    run_cli, tmp_path, monkeypatch
+):
+    """FR-105: every directory encountered becomes a directory member, so an
+    empty directory survives a create-then-extract round trip."""
+    monkeypatch.chdir(tmp_path)
+    helpers.build_empty_dirs(tmp_path / "tree", ["a/b/c"])
+    assert run_cli(["create", "out.tar", "tree"]).status == 0
+    assert _members(run_cli, "out.tar") == ["tree", "tree/a", "tree/a/b", "tree/a/b/c"]
+    assert run_cli(["extract", "out.tar", "back"]).status == 0
+    assert (tmp_path / "back" / "tree" / "a" / "b" / "c").is_dir()
+
+
+# --- FR-106: deterministic order --------------------------------------------
+
+
+def test_fr_106_paths_appear_in_command_line_order(run_cli, photos_source, monkeypatch):
+    """FR-106: PATHs are recorded in the order given on the command line."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "a.tar", "notes.txt", "photos"]).status == 0
+    assert run_cli(["create", "b.tar", "photos", "notes.txt"]).status == 0
+    assert _members(run_cli, "a.tar")[0] == "notes.txt"
+    assert _members(run_cli, "b.tar")[-1] == "notes.txt"
+
+
+def test_fr_106_directory_first_then_entries_in_code_point_order(
+    run_cli, tmp_path, monkeypatch
+):
+    """FR-106: within a directory the directory's own member comes first, then
+    its entries in ascending code-point order, each subdirectory's contents
+    immediately following that subdirectory's member."""
+    monkeypatch.chdir(tmp_path)
+    helpers.build_source_tree(
+        tmp_path / "tree",
+        {
+            "b.txt": b"b",
+            "a.txt": b"a",
+            "mid/z.txt": b"z",
+            "mid/a.txt": b"a",
+            "ülast.txt": b"u",
+        },
+    )
+    assert run_cli(["create", "out.tar", "tree"]).status == 0
+    assert _members(run_cli, "out.tar") == [
+        "tree",
+        "tree/a.txt",
+        "tree/b.txt",
+        "tree/mid",
+        "tree/mid/a.txt",
+        "tree/mid/z.txt",
+        "tree/ülast.txt",
+    ]
+
+
+def test_fr_106_two_runs_over_an_unchanged_tree_agree(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-106: running ``create`` twice over an unchanged tree produces the same
+    member names in the same order."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "first.tar", "photos", "notes.txt"]).status == 0
+    assert run_cli(["create", "second.tar", "photos", "notes.txt"]).status == 0
+    assert _members(run_cli, "first.tar") == _members(run_cli, "second.tar")
+
+
+# --- FR-108: compression chosen by suffix -----------------------------------
+
+
+@pytest.mark.parametrize(
+    "name, expected",
+    [
+        ("out.tar.gz", "gzip"),
+        ("out.tgz", "gzip"),
+        ("out.TGZ", "gzip"),
+        ("out.TAR.GZ", "gzip"),
+        ("out.Tar.Gz", "gzip"),
+        ("out.tar", "none"),
+        ("out", "none"),
+        ("archive.tar.gz.bak", "none"),
+        ("out.gz", "none"),
+    ],
+)
+def test_fr_108_compression_follows_the_archive_suffix(
+    run_cli, photos_source, monkeypatch, name, expected
+):
+    """FR-108: ``.tar.gz`` and ``.tgz`` — in any letter case — produce a gzip
+    archive; any other name produces a plain one."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", name, "notes.txt"]).status == 0
+    assert archive_module.sniff_compression(name) == expected
+    assert _members(run_cli, name) == ["notes.txt"]
+
+
+# --- FR-110, FR-111, FR-112, FR-113: reporting ------------------------------
+
+
+def test_fr_110_success_line_is_exact_and_exits_0(run_cli, photos_source, monkeypatch):
+    """FR-110: stdout carries exactly ``created ARCHIVE with N files`` and
+    nothing else, with ARCHIVE echoed as the user wrote it, and the status is 0."""
+    monkeypatch.chdir(photos_source)
+    result = run_cli(["create", "./photos.tar.gz", "photos"])
+    assert result.status == 0
+    assert result.stdout == "created ./photos.tar.gz with 2 files\n"
+    assert result.stderr == ""
+
+
+def test_fr_111_n_counts_regular_files_only(run_cli, photos_source, monkeypatch):
+    """FR-111: N counts regular files only — the ``photos`` example reports 2,
+    not 3, even though a directory member is recorded for ``photos`` itself."""
+    monkeypatch.chdir(photos_source)
+    result = run_cli(["create", "photos.tar.gz", "photos"])
+    assert result.stdout == "created photos.tar.gz with 2 files\n"
+    assert len(_members(run_cli, "photos.tar.gz")) == 4
+
+
+def test_fr_111_no_pluralisation_for_zero_or_one_file(run_cli, tmp_path, monkeypatch):
+    """FR-111: ``with 0 files`` and ``with 1 files`` are both produced verbatim."""
+    monkeypatch.chdir(tmp_path)
+    helpers.build_empty_dirs(tmp_path, ["hollow"])
+    helpers.build_source_tree(tmp_path, {"one.txt": b"x"})
+
+    zero = run_cli(["create", "zero.tar", "hollow"])
+    assert zero.status == 0
+    assert zero.stdout == "created zero.tar with 0 files\n"
+
+    one = run_cli(["create", "one.tar", "one.txt"])
+    assert one.status == 0
+    assert one.stdout == "created one.tar with 1 files\n"
+
+
+def test_fr_112_diagnostics_go_to_stderr_and_stdout_stays_empty(
+    run_cli, photos_source, monkeypatch
+):
+    """FR-112: every diagnostic goes to stderr, a failing ``create`` leaves
+    stdout empty, and no success line accompanies a failure."""
+    monkeypatch.chdir(photos_source)
+    result = run_cli(["create", "out.tar", "missing-folder"])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert result.stderr != ""
+    assert "created" not in result.stdout
+    assert "created" not in result.stderr
+    assert not Path("out.tar").exists()
+
+
+def test_fr_113_messages_name_what_was_rejected(run_cli, photos_source, monkeypatch):
+    """FR-113: a message names the archive path, the PATH as given, or the member
+    at issue."""
+    monkeypatch.chdir(photos_source)
+    assert "missing-folder" in run_cli(["create", "o.tar", "missing-folder"]).stderr
+    assert "/etc" in run_cli(["create", "o.tar", "/etc"]).stderr
+
+    Path("taken.tar").write_bytes(b"old")
+    assert "taken.tar" in run_cli(["create", "taken.tar", "notes.txt"]).stderr
+
+    helpers.add_symlink(photos_source, "photos/link", "a.jpg")
+    assert "photos/link" in run_cli(["create", "o.tar", "photos"]).stderr
+
+
+# --- SR-106, SR-107: memory and file permissions ----------------------------
+
+
+def test_sr_107_archive_is_created_mode_600_without_a_chmod(
+    run_cli, photos_source, monkeypatch
+):
+    """SR-107: the archive is created with mode ``0o600`` — owner read and write,
+    never setuid, setgid, or sticky — and the mode is set at creation, which is
+    why ``create.py`` contains no ``chmod`` call at all."""
+    monkeypatch.chdir(photos_source)
+    assert run_cli(["create", "out.tar", "photos"]).status == 0
+    mode = os.stat("out.tar").st_mode
+    assert mode & 0o777 == 0o600
+    assert mode & 0o7000 == 0
+
+    source = CREATE_SOURCE.read_text(encoding="utf-8")
+    assert "chmod" not in _code_only(source), "create.py must contain no chmod call"
+    for node in ast.walk(ast.parse(source, str(CREATE_SOURCE))):
+        if isinstance(node, ast.Attribute):
+            assert node.attr != "chmod"
+        if isinstance(node, ast.Name):
+            assert node.id != "chmod"
+
+
+def test_fr_121_and_sr_111_a_closed_stdout_is_reported_as_a_failure(
+    photos_source, tmp_path
+):
+    """FR-121, SR-111: stdout closed before the success line is written is the one
+    case where a non-zero status accompanies a complete archive — status 2, with
+    nothing on stdout and no crash report on stderr (contract failure case 14).
+
+    Driven as a real subprocess with a reader-less pipe for stdout, because the
+    condition is about what happens to a *buffered* write at flush time, which an
+    in-process capture cannot reproduce.
+    """
+    read_end, write_end = os.pipe()
+    os.close(read_end)  # No reader from the very start, so any write is EPIPE.
+    env = dict(os.environ, PYTHONPATH=str(SRC_DIR))
+    try:
+        completed = subprocess.run(
+            [sys.executable, "-m", "tarx", "create", "out.tar", "photos"],
+            cwd=photos_source,
+            env=env,
+            stdout=write_end,
+            stderr=subprocess.PIPE,
+        )
+    finally:
+        os.close(write_end)
+
+    assert completed.returncode == 2
+    assert completed.stderr == b""
+
+    # The archive was finished before the line was written, so it is complete.
+    listed = subprocess.run(
+        [sys.executable, "-m", "tarx", "list", "out.tar"],
+        cwd=photos_source,
+        env=env,
+        capture_output=True,
+    )
+    assert listed.returncode == 0
+    assert listed.stdout.decode().splitlines() == [
+        "photos",
+        "photos/a.jpg",
+        "photos/b.jpg",
+        "photos/empty-sub",
+    ]
+
+
+def test_sr_106_no_file_is_held_whole_in_memory(run_cli, tmp_path, monkeypatch):
+    """SR-106: archiving a file far larger than ``COPY_CHUNK_BYTES`` keeps peak
+    memory far below the file's size, proving the contents are streamed."""
+    monkeypatch.chdir(tmp_path)
+    file_size = 16 * 1024 * 1024
+    assert file_size > archive_module.COPY_CHUNK_BYTES
+    helpers.build_source_tree(tmp_path / "tree", {"huge.bin": b"\xa5" * file_size})
+
+    tracemalloc.start()
+    try:
+        result = run_cli(["create", "out.tar", "tree"])
+        _current, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+
+    assert result.status == 0
+    assert peak < file_size // 4, f"peak traced memory was {peak} bytes"
+    assert run_cli(["extract", "out.tar", "back"]).status == 0
+    assert (tmp_path / "back" / "tree" / "huge.bin").stat().st_size == file_size
