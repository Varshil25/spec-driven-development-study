@@ -0,0 +1,45 @@
+"""FR-014, FR-015 — the Luhn checksum in isolation.
+
+The function is pure and operates on the **separator-stripped** digit string;
+length is not its concern (contracts/redaction-rules.md "Luhn checksum").
+"""
+
+from logredact.redact import luhn
+
+
+def test_fr014_known_valid_card_passes():
+    assert luhn("4111111111111111") is True
+
+
+def test_fr015_known_invalid_digit_run_fails():
+    assert luhn("1234567890123") is False
+
+
+def test_fr014_subtract_nine_branch_is_applied():
+    """A doubled digit above 9 must have 9 subtracted, not be summed as-is.
+
+    `5555555555554444` totals 60 with the subtraction and 114 without, so this
+    case passes only when the branch is implemented.
+    """
+    assert luhn("5555555555554444") is True
+
+
+def test_fr014_total_reaches_ten_only_via_the_subtract_nine_branch():
+    """`91` is Luhn-valid only because doubling 9 gives 18 → 9, and 9+1 = 10.
+
+    Summing the doubled value as 18 would give 19 and reject it, so this is the
+    smallest case that fails when the subtraction is dropped.
+    """
+    assert luhn("91") is True
+
+
+def test_fr015_odd_and_even_length_runs_are_both_handled():
+    # 11-digit classic Luhn example, and a 13-digit run of zeros.
+    assert luhn("79927398713") is True
+    assert luhn("79927398710") is False
+    assert luhn("0000000000000") is True
+
+
+def test_fr015_single_digit_change_breaks_the_checksum():
+    assert luhn("4111111111111111") is True
+    assert luhn("4111111111111112") is False
