@@ -0,0 +1,151 @@
+"""FR-021 … FR-023 — the `--count` summary: exact form, placement, suppression."""
+
+import re
+
+import pytest
+
+SUMMARY = re.compile(rb"^emails=\d+ ips=\d+ cards=\d+\n$")
+
+
+# --------------------------------------------------------------------------
+# FR-021 — exact form, on stderr, one line
+# --------------------------------------------------------------------------
+
+
+def test_fr021_summary_has_the_exact_documented_form(run_cli):
+    proc = run_cli(["--count"], stdin=b"a@b.io 1.2.3.4\n")
+    assert proc.stdout == b"[EMAIL] [IP]\n"
+    assert proc.stderr == b"emails=1 ips=1 cards=0\n"
+    assert proc.returncode == 0
+
+
+def test_fr021_all_three_keys_always_appear_in_this_order(run_cli):
+    proc = run_cli(["--count"], stdin=b"4111111111111111\n")
+    assert proc.stderr == b"emails=0 ips=0 cards=1\n"
+    assert SUMMARY.match(proc.stderr)
+
+
+def test_fr022_zero_is_reported_not_omitted(run_cli):
+    proc = run_cli(["--count"], stdin=b"nothing of interest here\n")
+    assert proc.stderr == b"emails=0 ips=0 cards=0\n"
+
+
+def test_fr021_exactly_one_summary_line_is_written(run_cli):
+    proc = run_cli(["--count"], stdin=b"a@b.io\nc@d.io\n10.0.0.7\n")
+    assert proc.stderr.count(b"\n") == 1
+    assert proc.stderr == b"emails=2 ips=1 cards=0\n"
+
+
+def test_fr021_summary_goes_to_stderr_and_never_to_stdout(run_cli):
+    proc = run_cli(["--count"], stdin=b"a@b.io\n")
+    assert b"emails=" not in proc.stdout
+    assert b"emails=" in proc.stderr
+
+
+# --------------------------------------------------------------------------
+# FR-021 — one combined summary covering every source, after all output
+# --------------------------------------------------------------------------
+
+
+def test_fr021_multiple_files_give_a_single_combined_summary(run_cli, tmp_path):
+    one = tmp_path / "one.log"
+    two = tmp_path / "two.log"
+    one.write_bytes(b"first a@b.io\n")
+    two.write_bytes(b"second 10.0.0.7 4111111111111111\n")
+    proc = run_cli(["--count", str(one), str(two)])
+    assert proc.stdout == b"first [EMAIL]\nsecond [IP] [CARD]\n"
+    assert proc.stderr == b"emails=1 ips=1 cards=1\n"
+    assert proc.stderr.count(b"\n") == 1
+
+
+def test_fr021_counts_accumulate_across_a_file_named_twice(run_cli, tmp_path):
+    log = tmp_path / "one.log"
+    log.write_bytes(b"a@b.io 10.0.0.7\n")
+    proc = run_cli(["--count", str(log), str(log)])
+    assert proc.stderr == b"emails=2 ips=2 cards=0\n"
+
+
+def test_fr021_summary_follows_all_output_when_streams_are_merged(
+    run_cli, tmp_path
+):
+    """stdout is flushed first, so the summary is last even in a merged file."""
+    log = tmp_path / "many.log"
+    log.write_bytes(b"".join(b"a@b.io line %d\n" % i for i in range(2000)))
+    merged = tmp_path / "merged.txt"
+    with merged.open("wb") as handle:
+        import os
+        import subprocess
+        import sys
+
+        env = dict(os.environ)
+        env["PYTHONPATH"] = str(
+            __import__("pathlib").Path(__file__).resolve().parents[2] / "src"
+        )
+        status = subprocess.call(
+            [sys.executable, "-m", "logredact", "--count", str(log)],
+            stdout=handle,
+            stderr=handle,
+            env=env,
+        )
+    assert status == 0
+    content = merged.read_bytes()
+    assert content.endswith(b"emails=2000 ips=0 cards=0\n")
+    assert content.count(b"emails=") == 1
+
+
+# --------------------------------------------------------------------------
+# FR-023 — without --count, stderr stays empty
+# --------------------------------------------------------------------------
+
+
+def test_fr023_without_the_flag_stderr_is_empty_and_status_is_zero(run_cli):
+    proc = run_cli(stdin=b"a@b.io 1.2.3.4 4111111111111111\n")
+    assert proc.stderr == b""
+    assert len(proc.stderr) == 0
+    assert proc.returncode == 0
+
+
+def test_fr023_without_the_flag_no_summary_even_with_files(run_cli, tmp_path):
+    log = tmp_path / "one.log"
+    log.write_bytes(b"a@b.io\n")
+    proc = run_cli([str(log)])
+    assert proc.stderr == b""
+    assert proc.returncode == 0
+
+
+# --------------------------------------------------------------------------
+# SC-004 — the counts equal the placeholders present in the output
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "source",
+    [
+        b"jane@example.com 10.0.0.7 4111111111111111\n",
+        b"a@b.io a@b.io a@b.io\n",
+        b"nothing of interest\n",
+        b"999.1.1.1 1234567890123 [EMAIL]\n",
+        b"user@1.2.3.4\n",
+        b"paid with 4111 1111 1111 1111, ref 1234567890123\n",
+        b"",
+    ],
+)
+def test_sc004_reported_counts_equal_the_placeholders_in_stdout(run_cli, source):
+    proc = run_cli(["--count"], stdin=source)
+    reported = dict(
+        part.split(b"=") for part in proc.stderr.strip().split(b" ")
+    )
+    assert int(reported[b"emails"]) == proc.stdout.count(b"[EMAIL]") - source.count(
+        b"[EMAIL]"
+    )
+    assert int(reported[b"ips"]) == proc.stdout.count(b"[IP]") - source.count(b"[IP]")
+    assert int(reported[b"cards"]) == proc.stdout.count(b"[CARD]") - source.count(
+        b"[CARD]"
+    )
+
+
+def test_fr021_empty_input_with_the_flag_reports_all_zeros(run_cli):
+    proc = run_cli(["--count"], stdin=b"")
+    assert proc.stdout == b""
+    assert proc.stderr == b"emails=0 ips=0 cards=0\n"
+    assert proc.returncode == 0
