+"""Process-facing half of the tool: arguments, streams, sources, exit status."""
+
+import argparse
+import os
+import sys
+
+from logredact.redact import redact_line
+
+PROG = "python -m logredact"
+
+EXIT_OK = 0
+EXIT_FAILURE = 2
+
+
+def build_parser():
+    """The ``python -m logredact [--count] [FILE ...]`` command line (FR-001)."""
+    parser = argparse.ArgumentParser(prog=PROG)
+    parser.add_argument("--count", action="store_true")
+    parser.add_argument("files", nargs="*")
+    return parser
+
+
+def _configure_streams():
+    """Pin the encoding of stdin and stdout.
+
+    Naming UTF-8 explicitly means behaviour never varies with ``LANG``,
+    ``LC_ALL``, or ``PYTHONIOENCODING`` (FR-005a); ``surrogateescape``
+    round-trips undecodable bytes (FR-005b); ``newline`` disables all line-ending
+    translation so terminators survive byte-for-byte (FR-005).
+    """
+    sys.stdin.reconfigure(encoding="utf-8", errors="surrogateescape", newline="\n")
+    sys.stdout.reconfigure(encoding="utf-8", errors="surrogateescape", newline="")
+
+
+def _open_source(name):
+    """Open one named FILE with exactly the stdin encoding contract (R-002).
+
+    Sources are opened lazily, one at a time, and closed before the next is
+    opened, so a failure on source *n* leaves sources *n+1...* unopened.
+    """
+    return open(name, encoding="utf-8", errors="surrogateescape", newline="\n")
+
+
+def _redact_stream(stream, totals):
+    """Redact every line of one open stream, writing each out immediately.
+
+    Nothing is accumulated, so memory stays bounded by the longest single line
+    rather than by input size (research.md R-008; SC-007).
+    """
+    write = sys.stdout.write
+    for line in stream:
+        text, counts = redact_line(line)
+        write(text)
+        totals["emails"] += counts["emails"]
+        totals["ips"] += counts["ips"]
+        totals["cards"] += counts["cards"]
+
+
+def _report(name, error):
+    """Name the input that could not be read, and why (FR-025).
+
+    The name is used **exactly as given on the command line** — never
+    normalised, never made absolute — so the diagnostic points at what the user
+    actually typed (research.md R-007; contracts/cli-contract.md).
+    """
+    reason = error.strerror or str(error)
+    sys.stdout.flush()
+    sys.stderr.write(f"{PROG}: {name}: {reason}\n")
+
+
+def _write_summary(totals):
+    """Write the one-line `--count` summary to stderr (FR-021).
+
+    stdout is flushed **first**, so the summary always follows the complete
+    output even when both streams are redirected to the same file
+    (research.md R-007 "Ordering").
+    """
+    sys.stdout.flush()
+    sys.stderr.write(
+        "emails={emails} ips={ips} cards={cards}\n".format(**totals)
+    )
+
+
+def main(argv=None) -> int:
+    """Run the filter. The return value is the process exit status: 0 or 2 only."""
+    parser = build_parser()
+    # parse_intermixed_args, not parse_args: FR-001 allows the flag between two
+    # filenames, which parse_args rejects outright (research.md R-001).
+    args = parser.parse_intermixed_args(argv)
+    _configure_streams()
+
+    totals = {"emails": 0, "ips": 0, "cards": 0}
+
+    try:
+        if not args.files:
+            # No FILE argument: exactly one source, standard input (FR-002).
+            _redact_stream(sys.stdin, totals)
+        else:
+            # One source per argument, in command-line order; stdin is never
+            # opened or read. A name repeated on the command line is a separate
+            # source each time and is read again (FR-003).
+            for name in args.files:
+                try:
+                    with _open_source(name) as stream:
+                        _redact_stream(stream, totals)
+                except BrokenPipeError:
+                    # BrokenPipeError IS an OSError, so it must be re-raised
+                    # past the FR-025 handler below: an early-closing consumer
+                    # is not a read failure and must not be reported as one
+                    # (FR-028 wins over FR-025 on the write path).
+                    raise
+                except OSError as error:
+                    # The one narrow base class covering every reason FR-025
+                    # enumerates: it does not exist, permission is denied, it is
+                    # a directory, or reading failed partway through. Wrapping
+                    # both the open and the read loop catches all four.
+                    _report(name, error)
+                    # Stop: no later FILE is opened, and the summary below is
+                    # never reached, so an incomplete run is never presented as
+                    # a complete one (FR-026, FR-027).
+                    return EXIT_FAILURE
+
+        # Flush inside the guard. A short run fits entirely in the buffer, so
+        # the write loop above never fails and the broken pipe would otherwise
+        # surface only at interpreter shutdown — which exits 120 with a
+        # traceback and "Exception ignored on flushing sys.stdout" on stderr,
+        # breaking FR-028 and SC-006. This is also what makes the flush inside
+        # _write_summary below unable to raise.
+        sys.stdout.flush()
+    except BrokenPipeError:
+        # The consumer stopped reading. That is a normal end of work, not input
+        # we failed to validate: exit 0 with nothing on stderr (FR-028).
+        # The dup2 keeps the interpreter's own shutdown flush silent too
+        # (research.md R-006).
+        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
+        # Returning here, before any summary is written, is what suppresses the
+        # summary on the early-close path (FR-021, FR-028).
+        return EXIT_OK
+
+    if args.count:
+        _write_summary(totals)
+    return EXIT_OK
