@@ -0,0 +1,110 @@
+"""Pure matching core: patterns, validation, Luhn, and per-line redaction.
+
+No I/O, no ``sys``, no exit codes — text in, text and counts out, so every
+recognition rule is directly unit-testable (plan.md "Structure Decision").
+
+The three patterns below are quoted verbatim from research.md R-004 and were
+verified by execution during Phase 0. The lookarounds and possessive
+quantifiers each implement a specific requirement; they are not decorative.
+"""
+
+import re
+
+EMAIL_PLACEHOLDER = "[EMAIL]"
+IP_PLACEHOLDER = "[IP]"
+CARD_PLACEHOLDER = "[CARD]"
+
+# Local part is letters, digits, '.', '_', '%', '+', '-'; the domain is either
+# dot-separated labels ending in a final label of at least two letters, or four
+# dot-separated groups of one to three digits (FR-007, FR-007a, FR-008).
+_EMAIL = r"[A-Za-z0-9._%+-]+@(?:(?:[A-Za-z0-9-]+\.)+[A-Za-z]{2,}|\d{1,3}(?:\.\d{1,3}){3})"
+
+# The four lookarounds are a direct transcription of FR-012: not adjacent to a
+# digit on either side, not preceded by digit-and-dot, not followed by
+# dot-and-digit (FR-010, FR-012).
+_IP = r"(?<!\d)(?<!\d\.)\d{1,3}(?:\.\d{1,3}){3}(?!\d)(?!\.\d)"
+
+# Possessive quantifiers (Python 3.11+) make the candidate maximal and
+# non-backtrackable, which is what makes the doubled-separator edge case work.
+# Deliberately carries no {13,19} bound: the digit count is only known after the
+# separators are stripped, so the length test lives in the validator (FR-014,
+# FR-016, FR-017).
+_CARD = r"(?<!\d)\d++(?:[ -]\d++)*+"
+
+# One alternation, scanned once per line. The branch order *is* the FR-019
+# precedence and `match.lastgroup` *is* the type tag — no enum, no registry
+# (data-model.md "Redaction type"; Constitution Principle IV).
+PATTERN = re.compile(
+    rf"(?P<email>{_EMAIL})|(?P<ip>{_IP})|(?P<card>{_CARD})"
+)
+
+_CARD_SEPARATORS = str.maketrans("", "", " -")
+
+MIN_CARD_DIGITS = 13
+MAX_CARD_DIGITS = 19
+MAX_OCTET = 255
+
+
+def new_counts():
+    """A fresh run-local counter dict.
+
+    Counters are never module-level state, so two runs in one process cannot
+    contaminate each other (data-model.md "Redaction counts").
+    """
+    return {"emails": 0, "ips": 0, "cards": 0}
+
+
+def luhn(digits: str) -> bool:
+    """True when ``digits`` passes the Luhn checksum (FR-014, FR-015).
+
+    Walking right to left, every second digit is doubled; a doubled value above
+    9 has 9 subtracted. The number is valid when the total is divisible by 10.
+    """
+    total = 0
+    for position, character in enumerate(reversed(digits)):
+        value = int(character)
+        if position % 2 == 1:
+            value *= 2
+            if value > 9:
+                value -= 9
+        total += value
+    return total % 10 == 0
+
+
+def _replacement(match, counts):
+    """Decide what a single matched candidate becomes.
+
+    A candidate that fails validation is returned **whole and unchanged**, never
+    partially redacted, and increments nothing — no replacement was made.
+    """
+    kind = match.lastgroup
+    text = match.group(0)
+
+    if kind == "email":
+        # No validation at all: a syntactic match is always redacted, and the
+        # numeric-domain form is deliberately not range-checked (FR-007a).
+        counts["emails"] += 1
+        return EMAIL_PLACEHOLDER
+
+    if kind == "ip":
+        if all(int(octet) <= MAX_OCTET for octet in text.split(".")):
+            counts["ips"] += 1
+            return IP_PLACEHOLDER
+        return text  # FR-011: out-of-range octet leaves the whole candidate
+
+    digits = text.translate(_CARD_SEPARATORS)
+    if MIN_CARD_DIGITS <= len(digits) <= MAX_CARD_DIGITS and luhn(digits):
+        counts["cards"] += 1
+        return CARD_PLACEHOLDER
+    return text  # FR-015, FR-016: wrong length or failed Luhn
+
+
+def redact_line(text: str):
+    """Redact one line. Returns ``(redacted_text, counts)``.
+
+    ``re.sub`` supplies FR-018 by construction: it scans left to right, takes
+    the match starting earliest, and resumes after the replaced span, so
+    inserted placeholders are never revisited or counted (FR-020).
+    """
+    counts = new_counts()
+    return PATTERN.sub(lambda match: _replacement(match, counts), text), counts
