@@ -0,0 +1,107 @@
+"""FR-020, FR-022 — what increments a counter, and what does not.
+
+The rule is one increment **per replacement actually made**, never per distinct
+value and never for a candidate that validation rejected.
+"""
+
+from logredact.redact import new_counts, redact_line
+
+
+def counts(text):
+    return redact_line(text)[1]
+
+
+# --------------------------------------------------------------------------
+# FR-022 — counts measure replacements, not distinct values
+# --------------------------------------------------------------------------
+
+
+def test_fr022_the_same_address_three_times_counts_as_three():
+    assert counts("jane@example.com jane@example.com jane@example.com")["emails"] == 3
+    assert counts("10.0.0.7 10.0.0.7 10.0.0.7")["ips"] == 3
+    # Separated by a comma: a bare space would join them into one 32-digit
+    # candidate under the maximal-run rule (contracts/redaction-rules.md).
+    c = counts("4111111111111111, 4111111111111111")
+    assert c["cards"] == 2
+
+
+def test_fr022_distinct_values_of_one_type_accumulate_into_one_counter():
+    c = counts("a@b.io c@d.io 10.0.0.7 192.168.1.1")
+    assert c == {"emails": 2, "ips": 2, "cards": 0}
+
+
+def test_fr022_each_type_increments_only_its_own_counter():
+    c = counts("jane@example.com 10.0.0.7 4111111111111111")
+    assert c == {"emails": 1, "ips": 1, "cards": 1}
+
+
+# --------------------------------------------------------------------------
+# FR-022 — a rejected candidate increments nothing
+# --------------------------------------------------------------------------
+
+
+def test_fr022_out_of_range_octet_increments_nothing():
+    assert counts("999.1.1.1 256.1.1.1") == {"emails": 0, "ips": 0, "cards": 0}
+
+
+def test_fr022_wrong_length_digit_run_increments_nothing():
+    assert counts("123456789012") == {"emails": 0, "ips": 0, "cards": 0}
+    assert counts("12345678901234567890") == {"emails": 0, "ips": 0, "cards": 0}
+
+
+def test_fr022_failed_luhn_increments_nothing():
+    assert counts("1234567890123") == {"emails": 0, "ips": 0, "cards": 0}
+
+
+def test_fr022_a_rejected_candidate_beside_a_valid_one_counts_once():
+    c = counts("1234567890123 and 4111111111111111")
+    assert c["cards"] == 1
+
+
+# --------------------------------------------------------------------------
+# FR-020 — placeholders in the input are never counted
+# --------------------------------------------------------------------------
+
+
+def test_fr020_placeholder_text_in_the_input_is_never_counted():
+    assert counts("[EMAIL] [IP] [CARD]") == {"emails": 0, "ips": 0, "cards": 0}
+
+
+def test_fr020_inserted_placeholders_are_not_counted_a_second_time():
+    assert counts("jane@example.com [EMAIL]")["emails"] == 1
+
+
+# --------------------------------------------------------------------------
+# FR-022 — zero is reported, not omitted; counts are run-local
+# --------------------------------------------------------------------------
+
+
+def test_fr022_every_key_is_present_and_zero_when_nothing_was_replaced():
+    assert counts("nothing of interest here") == {"emails": 0, "ips": 0, "cards": 0}
+
+
+def test_fr022_new_counts_starts_at_zero_for_all_three_keys():
+    assert new_counts() == {"emails": 0, "ips": 0, "cards": 0}
+
+
+def test_fr022_counts_are_run_local_and_do_not_leak_between_calls():
+    """Two calls in one process must not contaminate each other."""
+    first = counts("jane@example.com")
+    second = counts("nothing here")
+    assert first["emails"] == 1
+    assert second["emails"] == 0
+    assert new_counts() == {"emails": 0, "ips": 0, "cards": 0}
+
+
+def test_sc004_counts_equal_the_placeholders_present_in_the_output():
+    for source in [
+        "jane@example.com 10.0.0.7 4111111111111111",
+        "a@b.io a@b.io 1.2.3.4",
+        "nothing of interest",
+        "999.1.1.1 1234567890123",
+        "user@1.2.3.4",
+    ]:
+        text, c = redact_line(source)
+        assert text.count("[EMAIL]") == c["emails"]
+        assert text.count("[IP]") == c["ips"]
+        assert text.count("[CARD]") == c["cards"]
