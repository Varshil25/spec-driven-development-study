@@ -0,0 +1,264 @@
+"""FR-024 … FR-027, FR-029 — unreadable inputs and invalid command lines.
+
+Every case asserts both halves of Constitution Principle II: a specific
+diagnostic naming the offending input, and a failure signal. No case may ever
+produce a stack trace, and no case may ever produce a status outside {0, 2}.
+"""
+
+import os
+
+import pytest
+
+NO_TRACE_MARKERS = (b"Traceback", b"Error:", b"File \"")
+
+
+def assert_no_stack_trace(stderr):
+    assert b"Traceback" not in stderr
+    assert b"most recent call last" not in stderr
+
+
+# --------------------------------------------------------------------------
+# FR-025 — the file cannot be opened
+# --------------------------------------------------------------------------
+
+
+def test_fr025_missing_file_is_named_on_stderr_and_exits_two(run_cli, tmp_path):
+    missing = tmp_path / "missing.log"
+    proc = run_cli([str(missing)])
+    assert proc.returncode == 2
+    assert str(missing).encode() in proc.stderr
+    assert_no_stack_trace(proc.stderr)
+    assert proc.stdout == b""
+
+
+def test_fr025_diagnostic_states_what_went_wrong(run_cli, tmp_path):
+    missing = tmp_path / "missing.log"
+    proc = run_cli([str(missing)])
+    # The reason is reported, not just the name.
+    assert proc.stderr.lower().count(b"no such file") == 1
+    assert proc.stderr.startswith(b"python -m logredact: ")
+
+
+def test_fr025_filename_is_reported_exactly_as_given_on_the_command_line(
+    run_cli, tmp_path
+):
+    """Never normalised, never made absolute."""
+    proc = run_cli(["missing.log"], cwd=tmp_path)
+    assert proc.returncode == 2
+    assert b"missing.log" in proc.stderr
+    assert str(tmp_path).encode() not in proc.stderr
+
+    odd = run_cli(["./sub/../missing.log"], cwd=tmp_path)
+    assert odd.returncode == 2
+    assert b"./sub/../missing.log" in odd.stderr
+
+
+@pytest.mark.skipif(
+    os.geteuid() == 0, reason="root bypasses file permissions"
+)
+def test_fr025_unreadable_file_is_named_and_exits_two(run_cli, tmp_path):
+    locked = tmp_path / "locked.log"
+    locked.write_bytes(b"secret a@b.io\n")
+    locked.chmod(0o000)
+    try:
+        proc = run_cli([str(locked)])
+    finally:
+        locked.chmod(0o644)
+    assert proc.returncode == 2
+    assert str(locked).encode() in proc.stderr
+    assert_no_stack_trace(proc.stderr)
+    assert b"secret" not in proc.stdout
+
+
+def test_fr025_a_directory_argument_is_named_and_exits_two(run_cli, tmp_path):
+    """Clarified 2026-11-13: a directory takes the FR-025 path."""
+    directory = tmp_path / "logs"
+    directory.mkdir()
+    proc = run_cli([str(directory)])
+    assert proc.returncode == 2
+    assert str(directory).encode() in proc.stderr
+    assert_no_stack_trace(proc.stderr)
+    assert proc.stdout == b""
+
+
+# --------------------------------------------------------------------------
+# FR-026, FR-027 — stop at the first failure; earlier output stays valid
+# --------------------------------------------------------------------------
+
+
+@pytest.fixture
+def good_bad_third(tmp_path):
+    good = tmp_path / "good.log"
+    bad = tmp_path / "missing.log"
+    third = tmp_path / "third.log"
+    good.write_bytes(b"first a@b.io\n")
+    third.write_bytes(b"THIRD-SENTINEL 10.0.0.7\n")
+    return good, bad, third
+
+
+def test_fr027_output_for_earlier_files_is_written_and_complete(
+    run_cli, good_bad_third
+):
+    good, bad, third = good_bad_third
+    proc = run_cli([str(good), str(bad), str(third)])
+    assert proc.stdout == b"first [EMAIL]\n"
+    assert proc.returncode == 2
+
+
+def test_fr026_processing_stops_so_the_third_file_is_never_read(
+    run_cli, good_bad_third
+):
+    good, bad, third = good_bad_third
+    proc = run_cli([str(good), str(bad), str(third)])
+    assert b"THIRD-SENTINEL" not in proc.stdout
+    assert str(bad).encode() in proc.stderr
+    assert str(third).encode() not in proc.stderr
+    assert proc.returncode == 2
+
+
+def test_fr026_no_count_summary_is_printed_on_the_failure_path(
+    run_cli, good_bad_third
+):
+    good, bad, third = good_bad_third
+    proc = run_cli(["--count", str(good), str(bad), str(third)])
+    assert proc.stdout == b"first [EMAIL]\n"
+    assert b"emails=" not in proc.stderr
+    assert b"ips=" not in proc.stderr
+    assert b"cards=" not in proc.stderr
+    assert proc.returncode == 2
+
+
+def test_fr027_diagnostic_follows_all_earlier_output_when_streams_are_merged(
+    run_cli, tmp_path
+):
+    """stdout is flushed before the diagnostic (contracts/cli-contract.md).
+
+    With both streams redirected to one file, the earlier file's redacted
+    output must be complete *before* the diagnostic, not interleaved after it
+    by a late buffer flush.
+    """
+    import subprocess
+    import sys
+    from pathlib import Path
+
+    good = tmp_path / "good.log"
+    good.write_bytes(b"".join(b"a@b.io line %d\n" % i for i in range(2000)))
+    bad = tmp_path / "missing.log"
+    merged = tmp_path / "merged.txt"
+
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(Path(__file__).resolve().parents[2] / "src")
+    with merged.open("wb") as handle:
+        status = subprocess.call(
+            [sys.executable, "-m", "logredact", str(good), str(bad)],
+            stdout=handle,
+            stderr=handle,
+            env=env,
+        )
+
+    assert status == 2
+    content = merged.read_bytes()
+    assert content.endswith(b"missing.log: No such file or directory\n")
+    # All 2000 redacted lines precede the diagnostic.
+    assert content.count(b"[EMAIL] line ") == 2000
+    assert content.index(b"missing.log") > content.rindex(b"[EMAIL] line 1999")
+
+
+def test_fr026_failure_on_the_very_first_file_leaves_stdout_empty(
+    run_cli, good_bad_third
+):
+    good, bad, _ = good_bad_third
+    proc = run_cli(["--count", str(bad), str(good)])
+    assert proc.stdout == b""
+    assert b"emails=" not in proc.stderr
+    assert proc.returncode == 2
+
+
+# --------------------------------------------------------------------------
+# FR-024 — every named file readable
+# --------------------------------------------------------------------------
+
+
+def test_fr024_all_files_readable_means_empty_stderr_and_exit_zero(
+    run_cli, tmp_path
+):
+    a = tmp_path / "a.log"
+    b = tmp_path / "b.log"
+    a.write_bytes(b"a@b.io\n")
+    b.write_bytes(b"10.0.0.7\n")
+    proc = run_cli([str(a), str(b)])
+    assert proc.stderr == b""
+    assert proc.returncode == 0
+
+
+# --------------------------------------------------------------------------
+# FR-029 — invalid command line
+# --------------------------------------------------------------------------
+
+
+def test_fr029_unrecognised_flag_is_named_in_a_usage_diagnostic(run_cli):
+    proc = run_cli(["--redact-all"], stdin=b"jane@example.com\n")
+    assert proc.returncode == 2
+    assert b"usage:" in proc.stderr
+    assert b"python -m logredact" in proc.stderr
+    assert b"--redact-all" in proc.stderr
+
+
+def test_fr029_no_redacted_output_is_written_for_an_invalid_command_line(run_cli):
+    proc = run_cli(["--redact-all"], stdin=b"jane@example.com\n")
+    assert proc.stdout == b""
+    assert b"[EMAIL]" not in proc.stdout
+
+
+def test_fr029_no_summary_is_printed_for_an_invalid_command_line(run_cli):
+    proc = run_cli(["--count", "--redact-all"], stdin=b"jane@example.com\n")
+    assert proc.stdout == b""
+    assert b"emails=" not in proc.stderr
+    assert proc.returncode == 2
+
+
+def test_fr029_an_unknown_flag_is_not_reinterpreted_as_a_filename(run_cli):
+    proc = run_cli(["--redact-all"], stdin=b"jane@example.com\n")
+    assert proc.returncode == 2
+    # It is reported as an unrecognised argument, not as an unreadable file.
+    assert b"no such file" not in proc.stderr.lower()
+
+
+def test_fr029_no_stack_trace_for_an_invalid_command_line(run_cli):
+    proc = run_cli(["--redact-all"])
+    assert_no_stack_trace(proc.stderr)
+
+
+# --------------------------------------------------------------------------
+# SC-006 — the status set is exactly {0, 2}
+# --------------------------------------------------------------------------
+
+
+def test_sc006_no_status_other_than_zero_or_two_is_ever_observed(
+    run_cli, tmp_path, good_bad_third
+):
+    good, bad, third = good_bad_third
+    directory = tmp_path / "adir"
+    directory.mkdir()
+
+    invocations = [
+        ([], b"a@b.io\n"),
+        (["--count"], b"a@b.io\n"),
+        ([str(good)], b""),
+        ([str(good), str(good)], b""),
+        (["--count", str(good)], b""),
+        ([str(bad)], b""),
+        ([str(good), str(bad)], b""),
+        ([str(directory)], b""),
+        (["--redact-all"], b""),
+        (["--count", "--redact-all"], b""),
+        (["-x"], b""),
+        ([], b""),
+    ]
+    observed = set()
+    for argv, stdin in invocations:
+        proc = run_cli(argv, stdin=stdin)
+        assert proc.returncode in (0, 2), (argv, proc.returncode, proc.stderr)
+        assert_no_stack_trace(proc.stderr)
+        observed.add(proc.returncode)
+    assert observed == {0, 2}
diff --git a/tests/cli/test_invocation.py b/tests/cli/test_invocation.py
new file mode 100644
index 0000000..c923f3a
--- /dev/null
+++ b/tests/cli/test_invocation.py
@@ -0,0 +1,164 @@
+"""FR-001 … FR-004 — input selection, ordering, and the spec's acceptance scenarios."""
+
+import pytest
+
+
+# --------------------------------------------------------------------------
+# FR-002 — no FILE argument means standard input
+# --------------------------------------------------------------------------
+
+
+def test_fr002_with_no_arguments_input_is_read_from_stdin(run_cli):
+    proc = run_cli(stdin=b"user jane@example.com from 10.0.0.7\n")
+    assert proc.stdout == b"user [EMAIL] from [IP]\n"
+    assert proc.returncode == 0
+
+
+def test_fr002_empty_stdin_produces_empty_output(run_cli):
+    proc = run_cli(stdin=b"")
+    assert proc.stdout == b""
+    assert proc.stderr == b""
+    assert proc.returncode == 0
+
+
+# --------------------------------------------------------------------------
+# FR-004 — every line exactly once, in order
+# --------------------------------------------------------------------------
+
+
+def test_fr004_every_line_is_written_exactly_once_in_order(run_cli):
+    source = b"".join(b"line %d: 10.0.0.%d\n" % (i, i % 10) for i in range(500))
+    expected = b"".join(b"line %d: [IP]\n" % i for i in range(500))
+    proc = run_cli(stdin=source)
+    assert proc.stdout == expected
+    assert proc.stdout.count(b"\n") == 500
+
+
+def test_fr004_duplicate_lines_are_not_collapsed(run_cli):
+    proc = run_cli(stdin=b"same 10.0.0.7\nsame 10.0.0.7\nsame 10.0.0.7\n")
+    assert proc.stdout == b"same [IP]\nsame [IP]\nsame [IP]\n"
+
+
+# --------------------------------------------------------------------------
+# Spec acceptance scenarios, User Story 1 (1-6)
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "source, expected",
+    [
+        # 1 - email and IPv4 on one line
+        (b"user jane@example.com from 10.0.0.7\n", b"user [EMAIL] from [IP]\n"),
+        # 2 - grouped card replaced, Luhn-failing reference untouched
+        (
+            b"paid with 4111 1111 1111 1111, ref 1234567890123\n",
+            b"paid with [CARD], ref 1234567890123\n",
+        ),
+        # 3 - nothing to redact: byte-for-byte
+        (b"a line with nothing of interest\n", b"a line with nothing of interest\n"),
+        # 4 - out-of-range octet left alone
+        (b"999.1.1.1\n", b"999.1.1.1\n"),
+        # 5 - several items on one line, each with its own placeholder
+        (
+            b"jane@example.com 10.0.0.7 4111111111111111\n",
+            b"[EMAIL] [IP] [CARD]\n",
+        ),
+        # 6 - numeric-domain address redacted whole
+        (b"login from user@1.2.3.4\n", b"login from [EMAIL]\n"),
+    ],
+)
+def test_us1_acceptance_scenarios(run_cli, source, expected):
+    proc = run_cli(stdin=source)
+    assert proc.stdout == expected
+    assert proc.stderr == b""
+    assert proc.returncode == 0
+
+
+def test_fr023_and_fr024_successful_run_is_silent_and_exits_zero(run_cli):
+    proc = run_cli(stdin=b"jane@example.com\n10.0.0.7\n4111111111111111\n")
+    assert proc.stderr == b""
+    assert proc.returncode == 0
+
+
+# --------------------------------------------------------------------------
+# FR-003 — named files, in order; stdin is not read   (User Story 2)
+# --------------------------------------------------------------------------
+
+
+@pytest.fixture
+def logs(tmp_path):
+    one = tmp_path / "one.log"
+    two = tmp_path / "two.log"
+    one.write_bytes(b"first a@b.io\n")
+    two.write_bytes(b"second 10.0.0.7\n")
+    return one, two
+
+
+def test_fr003_two_named_files_are_read_in_command_line_order(run_cli, logs):
+    one, two = logs
+    proc = run_cli([str(one), str(two)])
+    assert proc.stdout == b"first [EMAIL]\nsecond [IP]\n"
+    assert proc.returncode == 0
+
+    reversed_proc = run_cli([str(two), str(one)])
+    assert reversed_proc.stdout == b"second [IP]\nfirst [EMAIL]\n"
+
+
+def test_fr004_named_files_contribute_every_line_once_and_in_order(run_cli, tmp_path):
+    a = tmp_path / "a.log"
+    b = tmp_path / "b.log"
+    a.write_bytes(b"".join(b"a%d: 10.0.0.1\n" % i for i in range(100)))
+    b.write_bytes(b"".join(b"b%d: 10.0.0.2\n" % i for i in range(100)))
+    proc = run_cli([str(a), str(b)])
+    expected = b"".join(b"a%d: [IP]\n" % i for i in range(100)) + b"".join(
+        b"b%d: [IP]\n" % i for i in range(100)
+    )
+    assert proc.stdout == expected
+
+
+def test_fr003_a_file_named_twice_is_read_twice(run_cli, logs):
+    one, _ = logs
+    proc = run_cli([str(one), str(one)])
+    assert proc.stdout == b"first [EMAIL]\nfirst [EMAIL]\n"
+    assert proc.returncode == 0
+
+
+def test_fr003_an_empty_file_produces_empty_output_and_exit_zero(run_cli, tmp_path):
+    empty = tmp_path / "empty.log"
+    empty.write_bytes(b"")
+    proc = run_cli([str(empty)])
+    assert proc.stdout == b""
+    assert proc.stderr == b""
+    assert proc.returncode == 0
+
+
+def test_fr003_stdin_is_not_read_at_all_when_files_are_named(run_cli, logs):
+    one, _ = logs
+    proc = run_cli([str(one)], stdin=b"SENTINEL from stdin 10.0.0.9\n")
+    assert b"SENTINEL" not in proc.stdout
+    assert proc.stdout == b"first [EMAIL]\n"
+    assert proc.returncode == 0
+
+
+# --------------------------------------------------------------------------
+# FR-001 — --count and FILE may be interleaved in any order
+# --------------------------------------------------------------------------
+
+
+def test_fr001_flag_between_two_filenames_is_accepted(run_cli, logs):
+    one, two = logs
+    between = run_cli([str(one), "--count", str(two)])
+    leading = run_cli(["--count", str(one), str(two)])
+    trailing = run_cli([str(one), str(two), "--count"])
+
+    assert between.returncode == 0
+    assert between.stdout == leading.stdout == trailing.stdout
+    assert between.stderr == leading.stderr == trailing.stderr
+    assert between.stderr == b"emails=1 ips=1 cards=0\n"
+
+
+def test_fr001_the_tool_is_runnable_as_python_dash_m_logredact(run_cli):
+    proc = run_cli(["--help"])
+    assert proc.returncode == 0
+    assert b"python -m logredact" in proc.stdout
+    assert b"--count" in proc.stdout
