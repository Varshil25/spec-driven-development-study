@@ -0,0 +1,118 @@
+"""FR-005, FR-005a, FR-005b, SC-003 — byte-for-byte output.
+
+Everything here compares raw bytes, because the guarantee is about bytes: a
+line terminator, a missing final newline, and an undecodable byte must all
+survive the round trip untouched.
+"""
+
+ODD = b"caf\xe9 jane@example.com\r\nno trailing newline"
+
+
+def test_fr005b_undecodable_bytes_are_carried_through_unchanged(run_cli):
+    proc = run_cli(stdin=ODD)
+    assert proc.returncode == 0
+    assert b"\xe9" in proc.stdout
+    assert proc.stdout == b"caf\xe9 [EMAIL]\r\nno trailing newline"
+
+
+def test_fr005b_undecodable_bytes_do_not_abort_or_substitute(run_cli):
+    proc = run_cli(stdin=b"\xff\xfe\x80 plain text\n")
+    assert proc.returncode == 0
+    assert proc.stderr == b""
+    assert proc.stdout == b"\xff\xfe\x80 plain text\n"
+    assert "�".encode() not in proc.stdout
+
+
+def test_fr005_crlf_is_preserved(run_cli):
+    proc = run_cli(stdin=b"one 10.0.0.7\r\ntwo\r\n")
+    assert proc.stdout == b"one [IP]\r\ntwo\r\n"
+
+
+def test_fr005_a_bare_carriage_return_stays_inside_the_line(run_cli):
+    proc = run_cli(stdin=b"progress\rdone 10.0.0.7\n")
+    assert proc.stdout == b"progress\rdone [IP]\n"
+
+
+def test_fr005_no_final_newline_is_added(run_cli):
+    proc = run_cli(stdin=b"last line has no newline")
+    assert proc.stdout == b"last line has no newline"
+    assert not proc.stdout.endswith(b"\n")
+
+
+def test_fr005_no_final_newline_is_removed(run_cli):
+    proc = run_cli(stdin=b"ends with one\n")
+    assert proc.stdout == b"ends with one\n"
+
+
+def test_sc003_input_with_nothing_to_redact_is_byte_identical(run_cli):
+    sample = (
+        b"999.1.1.1\n"
+        b"1.2.3.4.5\n"
+        b"123456789012\n"
+        b"12345678901234567890\n"
+        b"4111  1111 1111 1111\n"
+        b"[EMAIL] [IP] [CARD]\n"
+        b"caf\xe9 plain\r\n"
+        b"no newline at the end"
+    )
+    proc = run_cli(stdin=sample)
+    assert proc.stdout == sample
+    assert proc.stderr == b""
+    assert proc.returncode == 0
+
+
+def test_sc002_near_miss_control_sample_has_zero_false_positives(run_cli):
+    sample = b"\n".join(
+        [
+            b"999.1.1.1",
+            b"256.1.1.1",
+            b"1.2.3.4.5",
+            b"1234567890123",
+            b"123456789012",
+            b"12345678901234567890",
+            b"4111  1111 1111 1111",
+            b"2026-11-13 10:00:00",
+            b"jane@example.c",
+        ]
+    ) + b"\n"
+    proc = run_cli(["--count"], stdin=sample)
+    assert proc.stdout == sample
+    assert proc.stderr == b"emails=0 ips=0 cards=0\n"
+
+
+def test_fr005a_output_does_not_vary_with_locale_or_encoding_environment(run_cli):
+    a = run_cli(stdin=ODD, env={"LC_ALL": "C"})
+    b = run_cli(
+        stdin=ODD, env={"LC_ALL": "C.UTF-8", "PYTHONIOENCODING": "latin-1"}
+    )
+    assert a.stdout == b.stdout
+    assert a.returncode == b.returncode == 0
+
+
+def test_fr005a_utf8_text_round_trips_under_a_hostile_locale(run_cli):
+    sample = "héllo wörld jane@example.com\n".encode()
+    for env in ({"LC_ALL": "C"}, {"LC_ALL": "POSIX", "PYTHONIOENCODING": "ascii"}):
+        proc = run_cli(stdin=sample, env=env)
+        assert proc.stdout == "héllo wörld [EMAIL]\n".encode()
+        assert proc.returncode == 0
+
+
+def test_fr005_text_outside_a_match_is_untouched(run_cli):
+    proc = run_cli(stdin=b"  spaced\tand\ttabbed 10.0.0.7  trailing   \n")
+    assert proc.stdout == b"  spaced\tand\ttabbed [IP]  trailing   \n"
+
+
+def test_sc007_a_very_long_line_is_processed_without_truncation(run_cli):
+    """A single line far larger than a typical log line (spec "Edge Cases").
+
+    10,000 characters a side is ~100x a typical log line. Note that the email
+    branch scans quadratically in the length of an unbroken run of local-part
+    characters, so a megabyte-scale single line takes minutes rather than
+    milliseconds; see the implementation note in the completion report.
+    """
+    size = 10_000
+    line = b"x" * size + b" jane@example.com " + b"y" * size + b"\n"
+    proc = run_cli(stdin=line)
+    assert proc.returncode == 0
+    assert proc.stdout == b"x" * size + b" [EMAIL] " + b"y" * size + b"\n"
+    assert len(proc.stdout) == len(line) - len(b"jane@example.com") + len(b"[EMAIL]")
