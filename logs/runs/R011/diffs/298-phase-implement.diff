+"""Subprocess harness for the CLI contract tests.
+
+CLI-level behaviour (true exit status, true stream separation, a true broken pipe)
+can only be observed from a real process, so every test in ``tests/cli`` drives
+``python -m logredact`` through ``subprocess`` rather than calling ``main()``
+in-process (research.md R-009).
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+SRC = REPO_ROOT / "src"
+
+
+@pytest.fixture
+def run_cli():
+    """Run ``python -m logredact`` and return the CompletedProcess.
+
+    ``stdin`` is **bytes** and ``stdout``/``stderr`` come back as **bytes**, so
+    byte-fidelity (FR-005, FR-005b) and "0 bytes on stderr" (FR-028) assertions
+    are exact rather than filtered through a decoding step.
+    """
+
+    def _run(argv=None, stdin=b"", env=None, cwd=None):
+        environment = dict(os.environ)
+        environment["PYTHONPATH"] = str(SRC)
+        if env:
+            environment.update(env)
+        return subprocess.run(
+            [sys.executable, "-m", "logredact", *(argv or [])],
+            input=stdin,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            env=environment,
+            cwd=str(cwd) if cwd is not None else None,
+        )
+
+    return _run
diff --git a/tests/cli/test_broken_pipe.py b/tests/cli/test_broken_pipe.py
new file mode 100644
index 0000000..74651d0
--- /dev/null
+++ b/tests/cli/test_broken_pipe.py
@@ -0,0 +1,168 @@
+"""FR-028 — the output consumer stops reading before the tool has finished.
+
+Only a real pipe into a real short-reading consumer exercises this: the tool
+must end quietly with status 0, writing **nothing at all** to stderr — no
+diagnostic, no `BrokenPipeError` traceback, no `Exception ignored in:` noise
+from the interpreter's shutdown flush, and no `--count` summary.
+"""
+
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+SRC = REPO_ROOT / "src"
+
+pytestmark = pytest.mark.skipif(
+    shutil.which("head") is None, reason="needs `head` as the short-reading consumer"
+)
+
+
+@pytest.fixture(scope="module")
+def big_log(tmp_path_factory):
+    path = tmp_path_factory.mktemp("bigpipe") / "big.log"
+    with path.open("w", encoding="utf-8") as handle:
+        for i in range(200_000):
+            handle.write(f"line {i} jane@example.com from 10.0.0.7\n")
+    return path
+
+
+def run_into_head(argv, lines=5):
+    """Run `python -m logredact ... | head -N` and report both ends."""
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+    head = subprocess.Popen(
+        ["head", f"-{lines}"], stdin=subprocess.PIPE, stdout=subprocess.PIPE
+    )
+    proc = subprocess.Popen(
+        [sys.executable, "-m", "logredact", *argv],
+        stdout=head.stdin,
+        stderr=subprocess.PIPE,
+        env=env,
+    )
+    head.stdin.close()
+    out = head.stdout.read()
+    head.stdout.close()
+    head.wait()
+    err = proc.stderr.read()
+    proc.stderr.close()
+    proc.wait()
+    return out, err, proc.returncode
+
+
+def test_fr028_early_close_writes_the_consumed_lines_and_exits_zero(big_log):
+    out, err, status = run_into_head([str(big_log)])
+    assert out == b"line 0 [EMAIL] from [IP]\n" * 1 + b"".join(
+        b"line %d [EMAIL] from [IP]\n" % i for i in range(1, 5)
+    )
+    assert out.count(b"\n") == 5
+    assert status == 0
+
+
+def test_fr028_nothing_at_all_is_written_to_stderr(big_log):
+    _, err, status = run_into_head([str(big_log)])
+    assert err == b""
+    assert len(err) == 0
+    assert b"BrokenPipeError" not in err
+    assert b"Traceback" not in err
+    assert b"Exception ignored" not in err
+    assert status == 0
+
+
+def test_fr028_no_count_summary_on_the_early_close_path(big_log):
+    out, err, status = run_into_head(["--count", str(big_log)])
+    assert out.count(b"\n") == 5
+    assert err == b""
+    assert b"emails=" not in err
+    assert status == 0
+
+
+def test_fr028_early_close_on_the_stdin_path_is_also_silent(big_log):
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+    head = subprocess.Popen(
+        ["head", "-5"], stdin=subprocess.PIPE, stdout=subprocess.PIPE
+    )
+    with big_log.open("rb") as source:
+        proc = subprocess.Popen(
+            [sys.executable, "-m", "logredact", "--count"],
+            stdin=source,
+            stdout=head.stdin,
+            stderr=subprocess.PIPE,
+            env=env,
+        )
+    head.stdin.close()
+    out = head.stdout.read()
+    head.stdout.close()
+    head.wait()
+    err = proc.stderr.read()
+    proc.stderr.close()
+    proc.wait()
+
+    assert out.count(b"\n") == 5
+    assert err == b""
+    assert proc.returncode == 0
+
+
+def run_with_no_reader(argv, stdin=b"jane@example.com 10.0.0.7\n"):
+    """Run with stdout on a pipe that has **no reader at all**.
+
+    A small input fits entirely in the buffer, so the write loop itself never
+    fails: the broken pipe only surfaces when the buffer is finally flushed.
+    That is the path a large-input test can never reach.
+    """
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+    read_fd, write_fd = os.pipe()
+    os.close(read_fd)
+    proc = subprocess.Popen(
+        [sys.executable, "-m", "logredact", *argv],
+        stdin=subprocess.PIPE,
+        stdout=write_fd,
+        stderr=subprocess.PIPE,
+        env=env,
+    )
+    os.close(write_fd)
+    _, err = proc.communicate(stdin)
+    return err, proc.returncode
+
+
+@pytest.mark.parametrize("argv", [[], ["--count"]])
+def test_fr028_small_input_with_no_reader_is_still_silent_and_exits_zero(argv):
+    """Regression: the final flush must happen inside the BrokenPipeError guard.
+
+    Otherwise a short run exits 120 with a traceback plus
+    "Exception ignored on flushing sys.stdout" on stderr.
+    """
+    err, status = run_with_no_reader(argv)
+    assert err == b""
+    assert b"Traceback" not in err
+    assert b"Exception ignored" not in err
+    assert b"BrokenPipeError" not in err
+    assert status == 0
+
+
+@pytest.mark.parametrize("argv", [[], ["--count"]])
+def test_sc006_no_reader_never_yields_a_status_outside_zero_or_two(argv):
+    _, status = run_with_no_reader(argv)
+    assert status in (0, 2)
+    assert status != 120
+
+
+def test_fr028_small_input_with_no_reader_on_the_file_path(tmp_path):
+    log = tmp_path / "small.log"
+    log.write_bytes(b"a@b.io 10.0.0.7\n")
+    err, status = run_with_no_reader(["--count", str(log)], stdin=b"")
+    assert err == b""
+    assert status == 0
+
+
+def test_sc006_early_close_status_is_zero_not_one_and_not_141(big_log):
+    _, _, status = run_into_head([str(big_log)])
+    assert status == 0
+    assert status != 1
+    assert status != 141
