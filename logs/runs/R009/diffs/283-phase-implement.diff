+    ``register alice`` is excluded: against an empty store that is the success path, and
+    success is exactly when the store *is* created (FR-002).
+    """
+    checked = 0
+    for command, username, stdin, _, _ in FAILING_PATHS:
+        if (command, username) == ("register", "alice"):
+            continue
+        status, _, _ = run(["--store", str(store_path), command, username], stdin)
+        assert status != 0, f"{command} {username} unexpectedly succeeded"
+        assert not Path(store_path).exists(), f"{command} {username} created the store"
+        checked += 1
