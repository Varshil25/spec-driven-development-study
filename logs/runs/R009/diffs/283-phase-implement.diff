+# --- FR-028 / SC-008: a failing command leaves the store alone ------------------------
+
+
+@pytest.mark.parametrize(
+    "command,username,stdin,status,message", FAILING_PATHS, ids=FAILING_IDS
+)
+def test_fr028_sc008_failing_commands_leave_the_store_unchanged(
+    run, alice_store, read_store, command, username, stdin, status, message
+):
+    """FR-028/SC-008: the full parsed store is identical before and after each failure.
+
+    The single documented exception is the ``login`` wrong-password tally increment
+    (L-7), which is asserted separately below.
+    """
+    before = read_store(alice_store)
+    got_status, _, _ = run(["--store", str(alice_store), command, username], stdin)
+    assert got_status == status
+
+    after = read_store(alice_store)
+    if (command, username, status) == ("login", "alice", 1):
+        # The one documented write on a failing path (FR-013, FR-015, L-7).
+        expected = json.loads(json.dumps(before))
+        expected["accounts"]["alice"]["failed_logins"] += 1
+        assert after == expected
+    else:
+        assert after == before
