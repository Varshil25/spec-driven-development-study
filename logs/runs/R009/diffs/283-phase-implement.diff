+# =====================================================================================
+# SC-006 — five consecutive failures always lock
+# =====================================================================================
+
+
+@pytest.mark.parametrize(
+    "prefix",
+    [
+        [],
+        [True],
+        [False],
+        [True, False, True],
+        [False, False, True, False],
+        [True] * 3,
+    ],
+)
+def test_sc006_five_consecutive_failures_lock_after_any_prefix(
+    run, store_path, low_iterations, prefix
+):
+    """SC-006: whatever came before, five consecutive failures lock the account."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+
+    consecutive = 0
+    for correct in prefix:
+        password=[REDACTED:assigned_secret] if correct else WRONG_PASSWORD
+        run(["--store", str(store_path), "login", "alice"], password + "\n")
+        consecutive = 0 if correct else consecutive + 1
+
+    # Failures already carried over from the prefix count toward the five, so the lock
+    # falls on the (5 - consecutive)-th of the attempts below (FR-015, L-1, L-2).
+    remaining = 5 - consecutive
+    assert remaining >= 1
+    for index in range(remaining):
+        status, out, err = run(
+            ["--store", str(store_path), "login", "alice"], WRONG_PASSWORD + "\n"
+        )
+        assert (status, out, err) == (1, "", "invalid credentials\n"), f"attempt {index}"
+
+    # Locked: no password, correct or not, produces a successful login.
+    for password in (GOOD_PASSWORD, WRONG_PASSWORD, "another attempt!!!"):
+        assert run(["--store", str(store_path), "login", "alice"], password + "\n") == (
+            4,
+            "",
+            "account locked\n",
+        )
+
+    assert run(["--store", str(store_path), "unlock", "alice"])[0] == 0
+    assert run(["--store", str(store_path), "login", "alice"], GOOD_PASSWORD + "\n") == (
+        0,
+        "ok\n",
+        "",
+    )
+
