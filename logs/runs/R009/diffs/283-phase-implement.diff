+    write_store(store_path, "not json at all\n")
+    status, out, err = run(
+        ["--store", str(store_path), "login", "alice"], GOOD_PASSWORD + "\n"
+    )
+    assert status == 5
+    assert out == ""
+    assert err.startswith("store unusable: ")
+    assert err[len("store unusable: ") :].strip() != ""
+
+
+def test_sc002_every_exit_status_0_to_5_is_produced(
+    run, store_path, write_store, low_iterations, tmp_path
+):
+    """SC-002: each of the six documented statuses is produced at least once."""
+    observed = set()
+
+    # 0 — success
+    observed.add(run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")[0])
+    # 1 — invalid credentials
+    observed.add(run(["--store", str(store_path), "login", "alice"], WRONG_PASSWORD + "\n")[0])
+    # 2 — invalid input
+    observed.add(run(["--store", str(store_path), "bogus", "alice"])[0])
+    # 3 — account conflict
+    observed.add(run(["--store", str(store_path), "unlock", "carol"])[0])
+    # 4 — account locked
+    for _ in range(4):
+        run(["--store", str(store_path), "login", "alice"], WRONG_PASSWORD + "\n")
+    observed.add(run(["--store", str(store_path), "login", "alice"], GOOD_PASSWORD + "\n")[0])
+    # 5 — store unusable
+    corrupt = tmp_path / "corrupt.json"
+    write_store(corrupt, "not json at all\n")
+    observed.add(run(["--store", str(corrupt), "login", "alice"], GOOD_PASSWORD + "\n")[0])
