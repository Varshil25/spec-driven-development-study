+def test_fr029c_store_stays_owner_only_across_every_writing_command(
+    run, store_path, low_iterations
+):
+    """FR-029c: mode 0o600 after creation and after every rewrite."""
+    def mode():
+        return os.stat(store_path).st_mode & 0o777
+
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    assert oct(mode()) == oct(0o600)
+
+    # Widen it, then confirm each writing command narrows it back (never widens).
+    for command, username, stdin in [
+        ("register", "bob", GOOD_PASSWORD + "\n"),
+        ("login", "alice", WRONG_PASSWORD + "\n"),
+        ("unlock", "alice", ""),
+        ("passwd", "alice", f"{GOOD_PASSWORD}\n{NEW_PASSWORD}\n"),
+        ("delete", "alice", f"{NEW_PASSWORD}\n"),
+    ]:
+        os.chmod(store_path, 0o666)
+        assert run(["--store", str(store_path), command, username], stdin)[0] in (0, 1)
+        assert oct(mode()) == oct(0o600), f"{command} left mode {oct(mode())}"
