+def test_fr029c_rewrite_never_widens_a_wider_mode(store_path):
+    """FR-029c (S-4): rewriting a world-readable store narrows it back to 0o600."""
+    store.save(store_path, EMPTY_STORE)
+    os.chmod(store_path, 0o666)
+    assert os.stat(store_path).st_mode & 0o777 == 0o666
+
+    store.save(store_path, valid_store(alice=record()))
+    assert oct(os.stat(store_path).st_mode & 0o777) == oct(0o600)
+
