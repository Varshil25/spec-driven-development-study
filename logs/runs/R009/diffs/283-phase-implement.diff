+"""``python -m accounts`` entry point — the only module that touches interpreter globals.
+
+Three lines of adapter and no logic: wrap standard input as UTF-8 with universal
+newlines (D-003), call :func:`accounts.cli.main`, and exit with the status it returns.
+"""
+
+import io
+import sys
+
+from . import cli
+
+sys.exit(
+    cli.main(
+        sys.argv[1:],
+        io.TextIOWrapper(sys.stdin.buffer, encoding="utf-8", newline=None),
+        sys.stdout,
+        sys.stderr,
+    )
+)
