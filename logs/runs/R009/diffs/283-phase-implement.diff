new file mode 100644
index 0000000..fdd881d
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,121 @@
+"""Shared fixtures for the accounts CLI suite.
+
+Harness design is fixed by research.md D-008:
+
+* Tests drive ``accounts.cli.main(argv, stdin, stdout, stderr) -> int`` in process by
+  default.  Each call re-reads the store from disk and shares no in-memory state with the
+  previous call, so a sequence of ``run(...)`` calls is a faithful stand-in for a sequence
+  of separate invocations.
+* A handful of tests use real ``python -m accounts`` subprocesses to assert the documented
+  interface (FR-001, FR-002, SC-003).
+* Bulk tests monkeypatch ``accounts.hashing.DEFAULT_ITERATIONS`` down; this is sound
+  because every record carries its own iteration count (FR-026b).
+"""
+
+from __future__ import annotations
+
+import io
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC_DIR = REPO_ROOT / "src"
+
+# A valid password used across the suite (21 characters, contains spaces — FR-003, A-5).
+GOOD_PASSWORD = "correct horse battery"
+OTHER_PASSWORD = "definitely wrong pw!"
+
+
+@pytest.fixture()
+def store_path(tmp_path: Path) -> Path:
+    """A path inside tmp_path where **no file exists yet** (the empty-store case, S-1)."""
+    path = tmp_path / "accounts.json"
+    assert not path.exists()
+    return path
+
+
+@pytest.fixture()
+def run():
+    """In-process runner: ``run(argv, stdin="")`` -> ``(status, stdout, stderr)``.
+
+    Imported lazily inside the call so that a fresh module state is not required but the
+    store is always re-read from disk by ``cli.main`` itself.
+    """
+
+    def _run(argv, stdin: str = "") -> tuple[int, str, str]:
+        from accounts import cli
+
+        out, err = io.StringIO(), io.StringIO()
+        # newline=None mirrors the io.TextIOWrapper(newline=None) that __main__.py wraps
+        # sys.stdin.buffer in, so `\r\n` is translated to `\n` here exactly as it is in a
+        # real run (research.md D-003).
+        stream = io.StringIO(stdin, newline=None)
+        status = cli.main(list(argv), stream, out, err)
+        return status, out.getvalue(), err.getvalue()
+
+    return _run
+
+
+@pytest.fixture()
+def run_subprocess():
+    """Real ``python -m accounts`` runner with ``src`` on PYTHONPATH (FR-001, SC-003)."""
+
+    def _run(argv, stdin: str = "") -> tuple[int, str, str]:
+        env = dict(os.environ)
+        env["PYTHONPATH"] = str(SRC_DIR)
+        proc = subprocess.run(
+            [sys.executable, "-m", "accounts", *[str(a) for a in argv]],
+            input=stdin,
+            capture_output=True,
+            text=True,
+            env=env,
+            cwd=str(REPO_ROOT),
+        )
+        return proc.returncode, proc.stdout, proc.stderr
+
+    return _run
+
+
+@pytest.fixture()
+def low_iterations(monkeypatch):
+    """Lower the derivation cost for bulk tests (research.md D-008 part 3).
+
+    Returns the patched value.  Only new material is affected; existing records keep
+    their own recorded ``iterations`` (FR-026b), which is exactly why this is sound.
+    """
+    from accounts import hashing
+
+    value = 1000
+    monkeypatch.setattr(hashing, "DEFAULT_ITERATIONS", value)
+    return value
+
+
+@pytest.fixture()
+def read_store():
+    """Parse the store file and return the document (compare parsed JSON, never bytes)."""
+
+    def _read(path) -> dict:
+        return json.loads(Path(path).read_text(encoding="utf-8"))
+
+    return _read
+
+
+@pytest.fixture()
+def write_store():
+    """Write a raw store document (or raw text) for corruption tests."""
+
+    def _write(path, document) -> None:
+        p = Path(path)
+        if isinstance(document, bytes):
+            p.write_bytes(document)
+        elif isinstance(document, str):
+            p.write_text(document, encoding="utf-8")
+        else:
+            p.write_text(json.dumps(document), encoding="utf-8")
+
+    return _write
diff --git a/tests/test_cli_contract.py b/tests/test_cli_contract.py
new file mode 100644
index 0000000..bec1e31
--- /dev/null
+++ b/tests/test_cli_contract.py
@@ -0,0 +1,448 @@
+"""Tests for the CLI pre-dispatch pipeline — FR-001, FR-003, FR-004, FR-005, FR-006,
+FR-030 and SC-007.
+
+Every row of the argument grammar in contracts/cli.md is asserted here, together with the
+standard-input protocol.  Message strings are asserted for **equality**, never containment.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+USAGE = (
+    "usage: python -m accounts --store PATH "
+    "{register|login|unlock|passwd|delete} USERNAME\n"
+)
+GOOD_PASSWORD = "correct horse battery"
+COMMANDS = ["register", "login", "unlock", "passwd", "delete"]
+
+
+# --- FR-006 / SC-007: the argument grammar --------------------------------------------
+
+
+def usage_error(result, store_path):
+    status, out, err = result
+    assert status == 2
+    assert err == USAGE
+    assert out == ""
+    assert not Path(store_path).exists(), "FR-006: no store file created or modified"
+
+
+def test_fr006_store_omitted_is_a_usage_error(run, store_path):
+    """FR-006: ``--store`` is required."""
+    usage_error(run(["login", "alice"], GOOD_PASSWORD + "\n"), store_path)
+
+
+def test_fr006_store_with_no_following_value_is_a_usage_error(run, store_path):
+    """FR-006: ``--store`` with no value is a usage error."""
+    usage_error(run(["login", "alice", "--store"], GOOD_PASSWORD + "\n"), store_path)
+
+
+def test_fr006_store_equals_form_is_a_usage_error(run, store_path):
+    """D-002: only the space-separated ``--store PATH`` form is supported."""
+    usage_error(
+        run([f"--store={store_path}", "login", "alice"], GOOD_PASSWORD + "\n"), store_path
+    )
+
+
+def test_fr006_command_missing_is_a_usage_error(run, store_path):
+    """FR-006: a missing command word is a usage error."""
+    usage_error(run(["--store", str(store_path)]), store_path)
+
+
+@pytest.mark.parametrize("command", ["lgoin", "list", "REGISTER", "", "help"])
+def test_fr006_unknown_command_is_a_usage_error(run, store_path, command):
+    """FR-006: the command word must be one of the five."""
+    usage_error(run(["--store", str(store_path), command, "alice"]), store_path)
+
+
+def test_fr006_username_missing_is_a_usage_error(run, store_path):
+    """FR-006: a command word without a username is a usage error."""
+    usage_error(run(["--store", str(store_path), "login"], GOOD_PASSWORD + "\n"), store_path)
+
+
+def test_fr006_a_third_positional_is_a_usage_error(run, store_path):
+    """FR-006: exactly two positionals are accepted."""
+    usage_error(
