--- /dev/null
+++ b/src/accounts/hashing.py
@@ -0,0 +1,75 @@
+"""Password derivation and verification (FR-026, FR-026a, FR-026b, FR-026c).
+
+PBKDF2-HMAC-SHA256 over a 16-byte per-account salt, 600,000 iterations, 32-byte derived
+key.  Each record carries its own derivation parameters, so verification never depends on
+the current module default (FR-026b).
+
+``DEFAULT_ITERATIONS`` is a module constant, not configuration: nothing here reads an
+environment variable or a config file (research.md D-008).
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import secrets
+
+#: Algorithm name recorded in every account record (FR-026b).
+ALGORITHM = "pbkdf2_hmac_sha256"
+
+#: Iteration count used for **new** password material (FR-026a).
+DEFAULT_ITERATIONS = 600_000
+
+#: Per-account salt length in bytes (FR-026a).
+SALT_BYTES = 16
+
+#: Derived key length in bytes (FR-026a).
+KEY_BYTES = 32
+
+
+def derive(password: str, salt: bytes, iterations: int) -> bytes:
+    """Derive the key for ``password`` with the given ``salt`` and ``iterations``.
+
+    The single place a derivation happens, so the cost of a command is countable
+    (SC-009).  The password is encoded UTF-8 before derivation (FR-026a).
+    """
+    return hashlib.pbkdf2_hmac(
+        "sha256", password.encode("utf-8"), salt, iterations, dklen=KEY_BYTES
+    )
+
+
+def new_password_material(password: str) -> dict:
+    """Return fresh derivation material for ``password`` (FR-026a).
+
+    A new salt is drawn per account from a cryptographically secure source, so two
+    accounts sharing a password share no stored material (FR-026, A-6).
+    """
+    salt = secrets.token_bytes(SALT_BYTES)
+    key = derive(password, salt, DEFAULT_ITERATIONS)
+    return {
+        "algorithm": ALGORITHM,
+        "iterations": DEFAULT_ITERATIONS,
+        "salt": base64.b64encode(salt).decode("ascii"),
+        "key": base64.b64encode(key).decode("ascii"),
+    }
+
+
+def verify(record: dict, password: str) -> bool:
+    """Check ``password`` against ``record`` using the record's own parameters.
+
+    Derives with the record's ``algorithm``, ``iterations`` and ``salt`` — never the
+    module default (FR-026b) — and compares in constant time (FR-026c).
+
+    Raises:
+        ValueError: if the record names an algorithm this version cannot compute.  A
+            record like this reaching here means a corrupt store (FR-029a); failing
+            loudly is required rather than falling back to the default algorithm.
+    """
+    algorithm = record["algorithm"]
+    if algorithm != ALGORITHM:
+        raise ValueError(f"unsupported algorithm: {algorithm!r}")
+    candidate = derive(
+        password, base64.b64decode(record["salt"]), record["iterations"]
+    )
+    return hmac.compare_digest(candidate, base64.b64decode(record["key"]))
