+def test_sc008_every_failure_path_leaves_all_accounts_behaving_identically(
+    run, store_path, low_iterations, read_store
+):
+    """SC-008: the full store state, and every account's behaviour, is unchanged."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    run(["--store", str(store_path), "register", "bob"], NEW_PASSWORD + "\n")
+    before = read_store(store_path)
+
+    for argv, stdin, status in SC008_FAILURES:
+        got_status, out, err = run(["--store", str(store_path), *argv], stdin)
+        assert got_status == status, f"{argv} {stdin!r}"
+        assert out == "", f"{argv}: FR-027 forbids stdout on a failure"
+        assert read_store(store_path) == before, f"{argv} {stdin!r} changed the store"
+
+        # And every account still behaves as it did.
+        assert run(["--store", str(store_path), "login", "alice"], GOOD_PASSWORD + "\n") == (
+            0,
+            "ok\n",
+            "",
