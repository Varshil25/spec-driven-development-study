+# =====================================================================================
+# SC-009 — performance and derivation count
+# =====================================================================================
+
+
+def build_large_store(path, count: int, iterations: int) -> dict:
+    """Write a store of ``count`` accounts directly, at a low derivation cost."""
+    accounts = {}
+    for index in range(count):
+        name = f"user_{index:04d}"
+        salt = bytes((index % 251,)) * 16
+        key = hashing.derive(f"password for {name}", salt, iterations)
+        accounts[name] = {
+            "algorithm": "pbkdf2_hmac_sha256",
+            "iterations": iterations,
+            "salt": base64.b64encode(salt).decode("ascii"),
+            "key": base64.b64encode(key).decode("ascii"),
+            "failed_logins": 0,
+            "locked": False,
+        }
+    document = {"format": "accounts-store-v1", "accounts": accounts}
+    store.save(path, document)
+    return document
+
+
+@pytest.mark.parametrize(
+    "argv,stdin",
+    [
+        (["login", "user_0500"], "password for user_0500\n"),
+        (["unlock", "user_0500"], ""),
+        (["passwd", "user_0500"], "password for user_0500\nnew passphrase here\n"),
+        (["delete", "user_0999"], "password for user_0999\n"),
+        (["register", "newcomer"], "a brand new password\n"),
+    ],
+    ids=["login", "unlock", "passwd", "delete", "register"],
+)
+def test_sc009_one_command_under_one_second_against_1000_accounts(
+    run, store_path, low_iterations, argv, stdin
+):
+    """SC-009: a single command completes within 1 second for a 1,000-account store."""
+    build_large_store(store_path, 1000, low_iterations)
+
+    started = time.perf_counter()
+    status, out, err = run(["--store", str(store_path), *argv], stdin)
+    elapsed = time.perf_counter() - started
+
+    assert status == 0, (status, out, err)
+    assert elapsed < 1.0, f"{argv[0]} took {elapsed:.3f}s against 1,000 accounts"
+
+
+def test_sc009_a_full_cost_command_against_1000_accounts_is_under_one_second(
+    run, store_path, monkeypatch
+):
+    """SC-009: at the real 600,000 iterations, a command on a big store still fits.
+
+    The store is built cheaply, then ``register`` runs at the full module default — one
+    real derivation plus a whole-file read and rewrite of 1,000 accounts.
+    """
+    build_large_store(store_path, 1000, 1000)
+    assert hashing.DEFAULT_ITERATIONS == 600_000
+
+    started = time.perf_counter()
+    status, out, err = run(
+        ["--store", str(store_path), "register", "newcomer"], "a brand new password\n"
+    )
+    elapsed = time.perf_counter() - started
+
+    assert (status, out, err) == (0, "registered newcomer\n", "")
+    assert elapsed < 1.0, f"full-cost register took {elapsed:.3f}s"
+
+
+@pytest.mark.parametrize(
+    "argv,stdin,expected",
+    [
+        (["register", "newcomer"], "a brand new password\n", 1),
+        (["login", "alice"], GOOD_PASSWORD + "\n", 1),
+        (["login", "alice"], WRONG_PASSWORD + "\n", 1),
+        (["login", "nobody"], GOOD_PASSWORD + "\n", 0),
+        (["unlock", "alice"], "", 0),
+        (["passwd", "alice"], f"{GOOD_PASSWORD}\n{NEW_PASSWORD}\n", 2),
+        (["passwd", "alice"], f"{WRONG_PASSWORD}\n{NEW_PASSWORD}\n", 1),
+        (["delete", "alice"], GOOD_PASSWORD + "\n", 1),
+        (["delete", "alice"], WRONG_PASSWORD + "\n", 1),
+        (["bogus", "alice"], "", 0),
+    ],
+    ids=[
+        "register",
+        "login-correct",
+        "login-wrong",
+        "login-unknown",
+        "unlock",
+        "passwd-success",
+        "passwd-wrong-current",
+        "delete-success",
+        "delete-wrong",
+        "usage-error",
+    ],
+)
+def test_sc009_derivation_count_per_command(
+    run, store_path, low_iterations, monkeypatch, argv, stdin, expected
+):
+    """SC-009/A-8: at most one derivation per command, two for ``passwd``, none for ``unlock``."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+
+    calls = []
+    real_derive = hashing.derive
+    monkeypatch.setattr(
+        hashing, "derive", lambda *a, **k: (calls.append(1), real_derive(*a, **k))[1]
+    )
+    run(["--store", str(store_path), *argv], stdin)
+
+    assert len(calls) == expected, f"{argv} performed {len(calls)} derivations"
+
+
+def test_sc009_cost_does_not_grow_with_the_number_of_accounts(
+    run, store_path, tmp_path, low_iterations
+):
+    """SC-009: derivation count is independent of store size."""
+    small = tmp_path / "small.json"
+    build_large_store(small, 10, low_iterations)
+    large = tmp_path / "large.json"
+    build_large_store(large, 1000, low_iterations)
+
+    def derivations(path):
+        calls = []
+        real_derive = hashing.derive
+        hashing.derive = lambda *a, **k: (calls.append(1), real_derive(*a, **k))[1]
+        try:
+            run(["--store", str(path), "login", "user_0005"], "password for user_0005\n")
+        finally:
+            hashing.derive = real_derive
+        return len(calls)
+
+    assert derivations(small) == derivations(large) == 1
+
