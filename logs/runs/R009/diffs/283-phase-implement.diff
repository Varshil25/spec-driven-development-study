+# =====================================================================================
+# SC-008 — every failed command leaves the store as it was
+# =====================================================================================
+
+#: Failure paths, run against a store holding ``alice`` (unlocked, tally 0) and ``bob``.
+SC008_FAILURES = [
+    (["register", "alice"], GOOD_PASSWORD + "\n", 3),
+    (["register", "bad-name"], GOOD_PASSWORD + "\n", 2),
+    (["register", "newcomer"], "short\n", 2),
+    (["register", "newcomer"], "", 2),
+    (["login", "nobody"], GOOD_PASSWORD + "\n", 1),
+    (["login", "alice"], "", 2),
+    (["unlock", "carol"], "", 3),
+    (["passwd", "alice"], f"{WRONG_PASSWORD}\n{NEW_PASSWORD}\n", 1),
+    (["passwd", "alice"], f"{GOOD_PASSWORD}\nshort\n", 2),
+    (["passwd", "dave"], f"{GOOD_PASSWORD}\n{NEW_PASSWORD}\n", 3),
+    (["passwd", "alice"], GOOD_PASSWORD + "\n", 2),
+    (["delete", "alice"], WRONG_PASSWORD + "\n", 1),
+    (["delete", "erin"], GOOD_PASSWORD + "\n", 3),
+    (["delete", "alice"], "", 2),
+    (["bogus", "alice"], "", 2),
+    (["login"], GOOD_PASSWORD + "\n", 2),
