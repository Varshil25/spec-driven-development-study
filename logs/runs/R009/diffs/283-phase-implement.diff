+def assert_store_unusable(result):
+    """``store unusable: `` as an exact prefix on stderr, exit 5, non-empty cause."""
+    status, out, err = result
+    assert status == 5
+    assert out == ""
+    assert err.startswith("store unusable: ")
+    assert err.endswith("\n")
+    cause = err[len("store unusable: ") :].strip()
+    assert cause != "", "Principle II: the cause must be named"
+
+
+@pytest.mark.parametrize("command,username,stdin", ALL_COMMANDS, ids=ALL_COMMAND_IDS)
+def test_fr029_cli_corrupt_store_is_unusable_for_every_command(
+    run, store_path, write_store, command, username, stdin
+):
+    """FR-029: a corrupt store is exit 5 for all five commands, never an empty store."""
+    write_store(store_path, "not json at all\n")
+    assert_store_unusable(run(["--store", str(store_path), command, username], stdin))
