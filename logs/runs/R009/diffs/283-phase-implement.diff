+"""Tests for ``delete`` — FR-023, FR-024, FR-025."""
+
+from __future__ import annotations
+
+import pytest
+
+GOOD_PASSWORD = "correct horse battery"
+WRONG_PASSWORD = "definitely wrong pw!"
+BOB_PASSWORD = "another good password"
+
+
+@pytest.fixture(autouse=True)
+def _cheap_derivation(low_iterations):
+    return low_iterations
+
+
+@pytest.fixture()
+def registered(run, store_path):
+    assert run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")[0] == 0
+    return store_path
+
+
+def delete(run, store_path, password, username="alice"):
+    return run(["--store", str(store_path), "delete", username], password + "\n")
+
+
+def login(run, store_path, password, username="alice"):
+    return run(["--store", str(store_path), "login", username], password + "\n")
+
+
+def accounts(read_store, store_path):
+    return read_store(store_path)["accounts"]
+
+
+# --- FR-023: success ------------------------------------------------------------------
+
+
+def test_fr023_success_exits_0_with_both_streams_empty(run, registered):
+    """FR-023: exit 0 and no output at all."""
+    status, out, err = delete(run, registered, GOOD_PASSWORD)
+    assert status == 0
+    assert out == ""
+    assert err == ""
+
+
+def test_fr023_the_record_is_gone_from_the_store(run, registered, read_store):
+    """FR-023: the account record is removed."""
+    delete(run, registered, GOOD_PASSWORD)
+    assert "alice" not in accounts(read_store, registered)
+    assert accounts(read_store, registered) == {}
+
+
+def test_fr023_a_later_login_behaves_as_an_unknown_account(run, registered):
+    """FR-023/FR-014: indistinguishable from a username that never existed."""
+    delete(run, registered, GOOD_PASSWORD)
+    assert login(run, registered, GOOD_PASSWORD) == (1, "", "invalid credentials\n")
+    assert login(run, registered, GOOD_PASSWORD, username="never_existed") == (
+        1,
+        "",
+        "invalid credentials\n",
+    )
+
+
+def test_fr023_unlock_and_passwd_report_no_such_account_after_deletion(run, registered):
+    """FR-023 (FR-018, FR-022): the username behaves as unknown for the other commands."""
+    delete(run, registered, GOOD_PASSWORD)
+    assert run(["--store", str(registered), "unlock", "alice"]) == (
+        3,
+        "",
+        "no such account\n",
+    )
+    assert run(
+        ["--store", str(registered), "passwd", "alice"], f"{GOOD_PASSWORD}\nnew password here\n"
+    ) == (3, "", "no such account\n")
+    assert delete(run, registered, GOOD_PASSWORD) == (3, "", "no such account\n")
+
+
+def test_fr023_l9_the_username_registers_afresh_with_no_surviving_state(
+    run, registered, read_store
+):
+    """FR-023 (L-9): new salt, zero tally, no lock — nothing survived the deletion."""
+    for _ in range(3):
+        login(run, registered, WRONG_PASSWORD)
+    before = accounts(read_store, registered)["alice"]
+
+    assert delete(run, registered, GOOD_PASSWORD) == (0, "", "")
+
+    status, out, err = run(
+        ["--store", str(registered), "register", "alice"], "a brand new password\n"
+    )
+    assert (status, out, err) == (0, "registered alice\n", "")
+
+    after = accounts(read_store, registered)["alice"]
+    assert after["salt"] != before["salt"]
+    assert after["key"] != before["key"]
+    assert after["failed_logins"] == 0
+    assert after["locked"] is False
+
+    assert login(run, registered, "a brand new password") == (0, "ok\n", "")
+    assert login(run, registered, GOOD_PASSWORD) == (1, "", "invalid credentials\n")
+
+
+def test_fr023_deleting_one_of_two_accounts_leaves_the_other_untouched(
+    run, registered, read_store
+):
+    """FR-023: every other account in the store is unchanged."""
+    run(["--store", str(registered), "register", "bob"], BOB_PASSWORD + "\n")
+    bob_before = accounts(read_store, registered)["bob"]
+
+    assert delete(run, registered, GOOD_PASSWORD) == (0, "", "")
+
+    assert list(accounts(read_store, registered)) == ["bob"]
+    assert accounts(read_store, registered)["bob"] == bob_before
+    assert login(run, registered, BOB_PASSWORD, username="bob") == (0, "ok\n", "")
+
+
+def test_fr023_l5_delete_on_a_locked_account_succeeds(run, registered, read_store):
+    """L-5: the lock gates ``login`` only — the correct password still deletes."""
+    for _ in range(5):
+        login(run, registered, WRONG_PASSWORD)
+    assert accounts(read_store, registered)["alice"]["locked"] is True
+
+    assert delete(run, registered, GOOD_PASSWORD) == (0, "", "")
+    assert accounts(read_store, registered) == {}
+
+
+def test_fr023_the_store_file_remains_valid_after_the_last_account_is_deleted(
+    run, registered, read_store
+):
+    """FR-029a: an emptied store is ``{"format": ..., "accounts": {}}``, not corrupt."""
+    delete(run, registered, GOOD_PASSWORD)
+    assert read_store(registered) == {"format": "accounts-store-v1", "accounts": {}}
+    # And it still loads, rather than reporting an unusable store.
+    assert login(run, registered, GOOD_PASSWORD) == (1, "", "invalid credentials\n")
+
+
+# --- FR-024: wrong password -----------------------------------------------------------
+
+
+def test_fr024_wrong_password_prints_invalid_credentials(run, registered):
+    """FR-024: ``invalid credentials`` on stderr with exit 1."""
+    status, out, err = delete(run, registered, WRONG_PASSWORD)
+    assert status == 1
+    assert err == "invalid credentials\n"
+    assert out == ""
+
+
+def test_fr024_wrong_password_retains_the_account_unchanged(
+    run, registered, read_store
+):
+    """FR-024: the account survives and still accepts its correct password."""
+    before = read_store(registered)
+    delete(run, registered, WRONG_PASSWORD)
+    assert read_store(registered) == before
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+
+
+def test_fr024_l6_wrong_password_does_not_advance_the_tally(
+    run, registered, read_store
+):
+    """FR-024 (L-6): a failed ``delete`` can never lock an account."""
+    for _ in range(10):
+        assert delete(run, registered, WRONG_PASSWORD)[0] == 1
+
+    record = accounts(read_store, registered)["alice"]
+    assert record["failed_logins"] == 0
+    assert record["locked"] is False
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+
+
+# --- FR-025: unknown account ----------------------------------------------------------
+
+
+def test_fr025_unknown_account_prints_no_such_account(run, registered):
+    """FR-025: ``no such account`` on stderr with exit 3."""
+    status, out, err = delete(run, registered, GOOD_PASSWORD, username="erin")
+    assert status == 3
+    assert err == "no such account\n"
+    assert out == ""
+
+
+def test_fr025_unknown_account_performs_no_password_check(run, registered, monkeypatch):
+    """FR-025: the existence check precedes the password check."""
+    from accounts import cli
+
+    calls = []
+    monkeypatch.setattr(cli.hashing, "verify", lambda *a, **k: calls.append(1) or False)
+    status, out, err = delete(run, registered, GOOD_PASSWORD, username="erin")
+    assert (status, out, err) == (3, "", "no such account\n")
+    assert calls == []
+
+
+def test_fr025_unknown_account_leaves_the_store_unchanged(run, registered, read_store):
+    """FR-025/FR-028: a failing ``delete`` writes nothing."""
+    before = read_store(registered)
+    delete(run, registered, GOOD_PASSWORD, username="erin")
+    assert read_store(registered) == before
+
+
+def test_fr025_delete_against_a_missing_store_reports_no_such_account(run, store_path):
+    """contracts/cli.md: a non-existent store path is the empty store (S-1)."""
+    status, out, err = delete(run, store_path, GOOD_PASSWORD)
+    assert (status, out, err) == (3, "", "no such account\n")
+
+
+def test_fr025_a3_a_malformed_username_is_simply_unknown(run, registered):
+    """A-3: ``delete`` never reports ``invalid username``."""
+    for username in ["bad-name", "x", "a" * 40]:
+        assert delete(run, registered, GOOD_PASSWORD, username=username) == (
+            3,
+            "",
+            "no such account\n",
+        )
+
+
+# --- A-8: derivation count ------------------------------------------------------------
+
+
+def test_a8_delete_performs_exactly_one_derivation(run, registered, monkeypatch):
+    """A-8/SC-009: one derivation and no more."""
+    from accounts import hashing as hashing_module
+
+    calls = []
+    real_derive = hashing_module.derive
+    monkeypatch.setattr(
+        hashing_module,
+        "derive",
+        lambda *a, **k: (calls.append(1), real_derive(*a, **k))[1],
+    )
+    assert delete(run, registered, GOOD_PASSWORD) == (0, "", "")
+    assert len(calls) == 1
diff --git a/tests/test_hashing.py b/tests/test_hashing.py
new file mode 100644
index 0000000..19139e7
--- /dev/null
+++ b/tests/test_hashing.py
@@ -0,0 +1,201 @@
+"""Tests for ``accounts.hashing`` — FR-026, FR-026a, FR-026b, FR-026c.
+
+Most tests here derive at a deliberately low iteration count so the suite stays inside the
+SC-009 budget; the 600,000 default is asserted separately as a constant (FR-026a) and
+end to end in ``test_cli_contract.py`` (T035, research.md D-008 part 3).
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+
+import pytest
+
+from accounts import hashing
+
+
+# --- FR-026a: algorithm, cost, key length, salt length, UTF-8 encoding ---------------
+
+
+def test_fr026a_default_iterations_is_600000():
+    """FR-026a: the module default cost is PBKDF2-HMAC-SHA256 at 600,000 iterations."""
+    assert hashing.DEFAULT_ITERATIONS == 600_000
+
+
+def test_fr026a_algorithm_name_is_pbkdf2_hmac_sha256():
+    """FR-026a/FR-026b: the recorded algorithm name is exactly ``pbkdf2_hmac_sha256``."""
+    assert hashing.ALGORITHM == "pbkdf2_hmac_sha256"
+
+
+def test_fr026a_derive_matches_pbkdf2_hmac_sha256_with_32_byte_key():
+    """FR-026a: derivation is pbkdf2_hmac('sha256', password_utf8, salt, n, dklen=32)."""
+    salt = b"0123456789abcdef"
+    derived = hashing.derive("correct horse battery", salt, 1000)
+    expected = hashlib.pbkdf2_hmac(
+        "sha256", "correct horse battery".encode("utf-8"), salt, 1000, dklen=32
+    )
+    assert derived == expected
+    assert len(derived) == 32
+
+
+def test_fr026a_password_is_encoded_utf8_before_derivation():
+    """FR-026a: the password is encoded UTF-8, not latin-1 or the ambient locale."""
+    salt = b"0123456789abcdef"
+    password = "pässwörd ünïcode"  # latin-1 encodable, so the two encodings differ
+    assert hashing.derive(password, salt, 1000) == hashlib.pbkdf2_hmac(
+        "sha256", password.encode("utf-8"), salt, 1000, dklen=32
+    )
+    assert hashing.derive(password, salt, 1000) != hashlib.pbkdf2_hmac(
+        "sha256", password.encode("latin-1"), salt, 1000, dklen=32
+    )
+
+
+def test_fr026a_new_material_salt_is_16_bytes_from_a_csprng(monkeypatch, low_iterations):
+    """FR-026a: the salt is exactly 16 bytes drawn from ``secrets.token_bytes``."""
+    calls = []
+    real_token_bytes = hashing.secrets.token_bytes
+
+    def spy(n):
+        calls.append(n)
+        return real_token_bytes(n)
+
+    monkeypatch.setattr(hashing.secrets, "token_bytes", spy)
+    material = hashing.new_password_material("correct horse battery")
+
+    assert calls == [16]
+    assert len(base64.b64decode(material["salt"])) == 16
+
+
+def test_fr026a_new_material_key_is_32_bytes_and_fields_are_base64(low_iterations):
+    """FR-026a: ``key`` is base64 of 32 bytes; ``salt`` base64 of 16."""
+    material = hashing.new_password_material("correct horse battery")
+
+    assert set(material) == {"algorithm", "iterations", "salt", "key"}
+    assert material["algorithm"] == "pbkdf2_hmac_sha256"
+    assert material["iterations"] == low_iterations
+    assert len(base64.b64decode(material["key"])) == 32
+    assert len(base64.b64decode(material["salt"])) == 16
+
+
+def test_fr026a_salt_differs_between_two_calls(low_iterations):
+    """FR-026a: a fresh salt is drawn per account."""
+    a = hashing.new_password_material("correct horse battery")
+    b = hashing.new_password_material("correct horse battery")
+    assert a["salt"] != b["salt"]
+
+
+# --- FR-026 / A-6: two accounts with the same password share no stored material -------
+
+
+def test_fr026_same_password_yields_different_salt_and_key(low_iterations):
+    """FR-026 (A-6): same password, different salt, therefore different key."""
+    a = hashing.new_password_material("correct horse battery")
+    b = hashing.new_password_material("correct horse battery")
+    assert a["salt"] != b["salt"]
+    assert a["key"] != b["key"]
+
+
+def test_fr026_material_holds_no_recoverable_password(low_iterations):
+    """FR-026: no field of the material contains the password or a reversible encoding."""
+    password = "correct horse battery"
+    material = hashing.new_password_material(password)
+    blob = "".join(str(v) for v in material.values())
+    assert password not in blob
+    assert base64.b64encode(password.encode("utf-8")).decode() not in blob
+    assert password.encode("utf-8").hex() not in blob
+
+
+# --- FR-026b: verification uses the record's own parameters ---------------------------
+
+
+def test_fr026b_verify_accepts_the_correct_password(low_iterations):
+    """FR-026b: a record verifies against the password it was derived from."""
+    material = hashing.new_password_material("correct horse battery")
+    assert hashing.verify(material, "correct horse battery") is True
+
+
+def test_fr026b_verify_rejects_a_wrong_password(low_iterations):
+    """FR-026b: a record does not verify against a different password."""
+    material = hashing.new_password_material("correct horse battery")
+    assert hashing.verify(material, "definitely wrong pw!") is False
+
+
+def test_fr026b_verify_uses_the_records_own_iterations_not_the_default():
+    """FR-026b: a record written at a non-default cost still verifies.
+
+    ``DEFAULT_ITERATIONS`` stays at its real value here, and the record carries 1000.  If
+    verification consulted the module default it would derive the wrong key and fail.
+    """
+    salt = b"0123456789abcdef"
+    record = {
+        "algorithm": "pbkdf2_hmac_sha256",
+        "iterations": 1000,
+        "salt": base64.b64encode(salt).decode(),
+        "key": base64.b64encode(hashing.derive("correct horse battery", salt, 1000)).decode(),
+    }
+    assert hashing.DEFAULT_ITERATIONS != 1000
+    assert hashing.verify(record, "correct horse battery") is True
+
+
+def test_fr026b_verify_uses_the_records_own_salt_not_a_fresh_one(low_iterations):
+    """FR-026b: swapping the recorded salt makes the same password fail."""
+    material = hashing.new_password_material("correct horse battery")
+    tampered = dict(material, salt=base64.b64encode(b"ffffffffffffffff").decode())
+    assert hashing.verify(tampered, "correct horse battery") is False
+
+
+def test_fr026b_verify_survives_a_later_change_of_the_module_default(monkeypatch):
+    """FR-026b: changing the default cost cannot turn a correct password into a reject."""
+    monkeypatch.setattr(hashing, "DEFAULT_ITERATIONS", 1000)
+    material = hashing.new_password_material("correct horse battery")
+    monkeypatch.setattr(hashing, "DEFAULT_ITERATIONS", 2000)
+    assert hashing.verify(material, "correct horse battery") is True
+
+
+def test_fr026b_verify_rejects_an_unknown_algorithm(low_iterations):
+    """FR-026b: ``verify`` derives with the record's algorithm and refuses an unknown one.
+
+    An unrecognized algorithm reaching the store is corruption caught at load (FR-029a);
+    ``verify`` must not silently fall back to the default algorithm either.
+    """
+    material = hashing.new_password_material("correct horse battery")
+    tampered = dict(material, algorithm="scrypt")
+    with pytest.raises(ValueError):
+        hashing.verify(tampered, "correct horse battery")
+
+
+# --- FR-026c: constant-time comparison ------------------------------------------------
+
+
+def test_fr026c_comparison_uses_hmac_compare_digest(monkeypatch, low_iterations):
+    """FR-026c: the key comparison goes through ``hmac.compare_digest``."""
+    material = hashing.new_password_material("correct horse battery")
+    calls = []
+    real_compare = hmac.compare_digest
+
+    def spy(a, b):
+        calls.append((bytes(a), bytes(b)))
+        return real_compare(a, b)
+
+    monkeypatch.setattr(hashing.hmac, "compare_digest", spy)
+    assert hashing.verify(material, "correct horse battery") is True
+    assert len(calls) == 1
+    assert len(calls[0][0]) == 32 and len(calls[0][1]) == 32
+
+
+def test_fr026c_comparison_uses_compare_digest_on_the_failing_path(
+    monkeypatch, low_iterations
+):
+    """FR-026c: the failing path is constant-time too — no short-circuit comparison."""
+    material = hashing.new_password_material("correct horse battery")
+    calls = []
+    real_compare = hmac.compare_digest
+    monkeypatch.setattr(
+        hashing.hmac,
+        "compare_digest",
+        lambda a, b: (calls.append(1), real_compare(a, b))[1],
+    )
+    assert hashing.verify(material, "definitely wrong pw!") is False
+    assert len(calls) == 1
diff --git a/tests/test_login_lockout.py b/tests/test_login_lockout.py
new file mode 100644
index 0000000..0b950aa
--- /dev/null
+++ b/tests/test_login_lockout.py
@@ -0,0 +1,271 @@
+"""Tests for ``login`` — FR-012, FR-013, FR-014, FR-015, FR-016 and SC-006.
+
+User Story 1 covers the unlocked path (FR-012, FR-014); User Story 2 adds the failure
+tally and the lock (FR-013, FR-015, FR-016, SC-006).
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+GOOD_PASSWORD = "correct horse battery"
+WRONG_PASSWORD = "definitely wrong pw!"
+
+
+@pytest.fixture(autouse=True)
+def _cheap_derivation(low_iterations):
+    return low_iterations
+
+
+@pytest.fixture()
+def registered(run, store_path):
+    """A store holding ``alice`` with ``GOOD_PASSWORD``, unlocked and at tally 0."""
+    status, _, _ = run(
+        ["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n"
+    )
+    assert status == 0
+    return store_path
+
+
+def login(run, store_path, password, username="alice"):
+    return run(["--store", str(store_path), "login", username], password + "\n")
+
+
+def tally(read_store, store_path, username="alice") -> int:
+    return read_store(store_path)["accounts"][username]["failed_logins"]
+
+
+def is_locked(read_store, store_path, username="alice") -> bool:
+    return read_store(store_path)["accounts"][username]["locked"]
+
+
+# =====================================================================================
+# User Story 1 — FR-012, FR-014
+# =====================================================================================
+
+
+def test_fr012_correct_password_prints_ok_on_stdout(run, registered):
+    """FR-012: ``ok`` on stdout, exit 0, nothing on stderr."""
+    status, out, err = login(run, registered, GOOD_PASSWORD)
+    assert status == 0
+    assert out == "ok\n"
+    assert err == ""
+
+
+def test_fr013_wrong_password_prints_invalid_credentials_on_stderr(run, registered):
+    """FR-013: ``invalid credentials`` on stderr, exit 1, nothing on stdout."""
+    status, out, err = login(run, registered, WRONG_PASSWORD)
+    assert status == 1
+    assert err == "invalid credentials\n"
+    assert out == ""
+
+
+def test_fr014_unknown_username_is_indistinguishable_from_a_wrong_password(
+    run, registered
+):
+    """FR-014: byte-identical output and status for an unknown account."""
+    wrong = login(run, registered, WRONG_PASSWORD, username="alice")
+    unknown = login(run, registered, GOOD_PASSWORD, username="nobody")
+    assert unknown == wrong == (1, "", "invalid credentials\n")
+
+
+def test_fr014_unknown_username_gives_no_hint_that_the_distinction_exists(
+    run, registered
+):
+    """FR-014: an unregisterable name behaves the same as any unknown name (A-3)."""
+    for username in ["nobody", "bad-name", "x", "a" * 40]:
+        status, out, err = login(run, registered, GOOD_PASSWORD, username=username)
+        assert (status, out, err) == (1, "", "invalid credentials\n")
+
+
+def test_fr014_login_against_a_missing_store_reports_invalid_credentials(
+    run, store_path
+):
+    """contracts/cli.md: a store path that does not exist is the empty store (S-1)."""
+    status, out, err = login(run, store_path, GOOD_PASSWORD)
+    assert (status, out, err) == (1, "", "invalid credentials\n")
+    assert not Path(store_path).exists(), "FR-028: a failing login creates no store"
+
+
+def test_fr014_unknown_account_performs_no_store_write(run, registered, read_store):
+    """FR-014/L-7: an unknown-account login writes nothing."""
+    before = read_store(registered)
+    login(run, registered, GOOD_PASSWORD, username="nobody")
+    assert read_store(registered) == before
+
+
+def test_fr012_a_successful_login_is_repeatable(run, registered):
+    """FR-012: logging in does not consume the password."""
+    for _ in range(3):
+        assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+
+
+# =====================================================================================
+# User Story 2 — FR-013, FR-015, FR-016, SC-006
+# =====================================================================================
+
+
+def test_fr013_each_wrong_password_increases_the_tally_by_exactly_one(
+    run, registered, read_store
+):
+    """FR-013: the failure tally advances by one per rejected login."""
+    for expected in (1, 2, 3, 4):
+        status, out, err = login(run, registered, WRONG_PASSWORD)
+        assert (status, out, err) == (1, "", "invalid credentials\n")
+        assert tally(read_store, registered) == expected
+
+
+def test_fr015_four_wrong_attempts_leave_the_account_unlocked(
+    run, registered, read_store
+):
+    """FR-015: four consecutive failures do not lock the account."""
+    for _ in range(4):
+        login(run, registered, WRONG_PASSWORD)
+    assert is_locked(read_store, registered) is False
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+
+
+def test_fr015_l1_the_fifth_failure_reports_invalid_credentials_and_locks(
+    run, registered, read_store
+):
+    """FR-015 (L-1): the fifth failure itself is ``invalid credentials`` / 1, then locked."""
+    for _ in range(4):
+        login(run, registered, WRONG_PASSWORD)
+
+    status, out, err = login(run, registered, WRONG_PASSWORD)
+    assert (status, out, err) == (1, "", "invalid credentials\n")
+    assert tally(read_store, registered) == 5
+    assert is_locked(read_store, registered) is True
+
+
+def test_fr016_locked_account_reports_account_locked_for_the_correct_password(
+    run, registered
+):
+    """FR-016: ``account locked`` on stderr with exit 4; ``ok`` is never printed."""
+    for _ in range(5):
+        login(run, registered, WRONG_PASSWORD)
+
+    status, out, err = login(run, registered, GOOD_PASSWORD)
+    assert status == 4
+    assert err == "account locked\n"
+    assert out == ""
+
+
+def test_fr016_locked_account_reports_account_locked_for_a_wrong_password(
+    run, registered
+):
+    """FR-016: the message does not depend on whether the password was right."""
+    for _ in range(5):
+        login(run, registered, WRONG_PASSWORD)
+    assert login(run, registered, WRONG_PASSWORD) == (4, "", "account locked\n")
+
+
+def test_fr016_l3_a_locked_login_changes_nothing_at_all(run, registered, read_store):
+    """FR-016 (L-3): not the tally, not the lock, not the stored password."""
+    for _ in range(5):
+        login(run, registered, WRONG_PASSWORD)
+    before = read_store(registered)
+
+    for password in (GOOD_PASSWORD, WRONG_PASSWORD, "yet another attempt!"):
+        login(run, registered, password)
+        assert read_store(registered) == before
+
+    assert before["accounts"]["alice"]["failed_logins"] == 5
+
+
+def test_fr012_l2_a_successful_login_resets_the_tally(run, registered, read_store):
+    """FR-012 (L-2): the five failures that lock an account are five consecutive ones."""
+    for _ in range(3):
+        login(run, registered, WRONG_PASSWORD)
+    assert tally(read_store, registered) == 3
+
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+    assert tally(read_store, registered) == 0
+
+    # Five *further* consecutive failures are now required.
+    for _ in range(4):
+        login(run, registered, WRONG_PASSWORD)
+    assert is_locked(read_store, registered) is False
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+
+
+def test_fr012_spec_scenario_three_failures_then_a_success(run, registered, read_store):
+    """FR-012: the spec's US2 scenario 9 — three recorded failures, then a success."""
+    for _ in range(3):
+        assert login(run, registered, WRONG_PASSWORD)[0] == 1
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+    assert tally(read_store, registered) == 0
+
+
+def test_fr015_locked_account_stays_locked_until_unlock(run, registered):
+    """FR-015: the lock persists across invocations."""
+    for _ in range(5):
+        login(run, registered, WRONG_PASSWORD)
+    for _ in range(3):
+        assert login(run, registered, GOOD_PASSWORD) == (4, "", "account locked\n")
+
+    assert run(["--store", str(registered), "unlock", "alice"])[0] == 0
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+
+
+# --- SC-006: every ordering containing five consecutive failures locks ----------------
+
+#: ``True`` = correct password, ``False`` = wrong password.  Every sequence below
+#: contains five consecutive failures somewhere.
+SC006_SEQUENCES = [
+    [False] * 5,
+    [True] + [False] * 5,
+    [False] * 5 + [True],
+    [True, False, True, False] + [False] * 5,
+    [False, True, False, False, False, False] + [False],
+    [False] * 4 + [True] + [False] * 5,
+    [True, True, True] + [False] * 5,
+    [False, False, True] + [False] * 5,
+    [False] * 3 + [True, True] + [False] * 5,
+    [True] * 2 + [False] * 4 + [True] + [False] * 5,
+]
+
+
+@pytest.mark.parametrize(
+    "sequence", SC006_SEQUENCES, ids=[str(i) for i in range(len(SC006_SEQUENCES))]
+)
+def test_sc006_five_consecutive_failures_always_lock(run, registered, sequence):
+    """SC-006: every ordering containing five consecutive failures locks the account."""
+    locked = False
+    consecutive = 0
+    for correct in sequence:
+        password=[REDACTED:assigned_secret] if correct else WRONG_PASSWORD
+        status, out, err = login(run, registered, password)
+        if locked:
+            assert (status, out, err) == (4, "", "account locked\n")
+            continue
+        if correct:
+            assert (status, out, err) == (0, "ok\n", "")
+            consecutive = 0
+        else:
+            assert (status, out, err) == (1, "", "invalid credentials\n")
+            consecutive += 1
+            if consecutive == 5:
+                locked = True
+
+    assert locked, "the sequence must contain five consecutive failures"
+
+
+@pytest.mark.parametrize(
+    "sequence", SC006_SEQUENCES, ids=[str(i) for i in range(len(SC006_SEQUENCES))]
+)
+def test_sc006_after_a_lock_no_password_succeeds_until_unlock(run, registered, sequence):
+    """SC-006: after a lock, no password produces a successful login until ``unlock``."""
+    for correct in sequence:
+        login(run, registered, GOOD_PASSWORD if correct else WRONG_PASSWORD)
+
+    for password in (GOOD_PASSWORD, WRONG_PASSWORD, ""):
+        status, out, err = login(run, registered, password)
+        assert status == 4
+        assert out == ""
+        assert err == "account locked\n"
+
+    assert run(["--store", str(registered), "unlock", "alice"])[0] == 0
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
diff --git a/tests/test_passwd.py b/tests/test_passwd.py
new file mode 100644
index 0000000..50587c6
--- /dev/null
+++ b/tests/test_passwd.py
@@ -0,0 +1,258 @@
+"""Tests for ``passwd`` — FR-019, FR-020, FR-021, FR-022."""
+
+from __future__ import annotations
+
+import pytest
+
+from accounts import hashing
+
+GOOD_PASSWORD = "correct horse battery"
+NEW_PASSWORD = "new passphrase here"
+WRONG_PASSWORD = "definitely wrong pw!"
+
+
+@pytest.fixture(autouse=True)
+def _cheap_derivation(low_iterations):
+    return low_iterations
+
+
+@pytest.fixture()
+def registered(run, store_path):
+    assert run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")[0] == 0
+    return store_path
+
+
+def passwd(run, store_path, current, new, username="alice"):
+    return run(["--store", str(store_path), "passwd", username], f"{current}\n{new}\n")
+
+
+def login(run, store_path, password, username="alice"):
+    return run(["--store", str(store_path), "login", username], password + "\n")
+
+
+def account(read_store, store_path, username="alice"):
+    return read_store(store_path)["accounts"][username]
+
+
+# --- FR-019: success ------------------------------------------------------------------
+
+
+def test_fr019_success_exits_0_with_both_streams_empty(run, registered):
+    """FR-019: exit 0 and no output at all."""
+    status, out, err = passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD)
+    assert status == 0
+    assert out == ""
+    assert err == ""
+
+
+def test_fr019_the_new_password_is_accepted_and_the_old_one_rejected(run, registered):
+    """FR-019: afterwards the new password logs in and the previous one does not."""
+    passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD)
+    assert login(run, registered, NEW_PASSWORD) == (0, "ok\n", "")
+    assert login(run, registered, GOOD_PASSWORD) == (1, "", "invalid credentials\n")
+
+
+def test_fr019_success_replaces_all_four_derivation_fields(
+    run, registered, read_store, low_iterations
+):
+    """FR-019: ``algorithm``, ``iterations``, ``salt`` and ``key`` are replaced."""
+    before = account(read_store, registered)
+    passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD)
+    after = account(read_store, registered)
+
+    assert after["salt"] != before["salt"]
+    assert after["key"] != before["key"]
+    assert after["algorithm"] == "pbkdf2_hmac_sha256"
+    assert after["iterations"] == hashing.DEFAULT_ITERATIONS == low_iterations
+
+
+def test_fr019_l5_success_leaves_the_tally_and_lock_untouched(
+    run, registered, read_store
+):
+    """FR-019 (L-5): ``locked`` and ``failed_logins`` are not touched."""
+    for _ in range(3):
+        login(run, registered, WRONG_PASSWORD)
+    assert account(read_store, registered)["failed_logins"] == 3
+
+    assert passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD) == (0, "", "")
+
+    record = account(read_store, registered)
+    assert record["failed_logins"] == 3
+    assert record["locked"] is False
+
+
+def test_fr019_l5_passwd_on_a_locked_account_succeeds_and_does_not_unlock_it(
+    run, registered, read_store
+):
+    """FR-019 (L-5): the lock gates ``login`` only; a successful ``passwd`` keeps it."""
+    for _ in range(5):
+        login(run, registered, WRONG_PASSWORD)
+    assert account(read_store, registered)["locked"] is True
+
+    assert passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD) == (0, "", "")
+
+    record = account(read_store, registered)
+    assert record["locked"] is True
+    assert record["failed_logins"] == 5
+    # Still locked: even the new password cannot log in until `unlock` is run.
+    assert login(run, registered, NEW_PASSWORD) == (4, "", "account locked\n")
+    assert run(["--store", str(registered), "unlock", "alice"])[0] == 0
+    assert login(run, registered, NEW_PASSWORD) == (0, "ok\n", "")
+
+
+def test_fr019_passwd_leaves_other_accounts_untouched(run, registered, read_store):
+    """FR-019: only the named account changes."""
+    run(["--store", str(registered), "register", "bob"], "another good password\n")
+    before = account(read_store, registered, "bob")
+    passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD)
+    assert account(read_store, registered, "bob") == before
+
+
+def test_fr019_the_new_password_can_be_changed_again(run, registered):
+    """FR-019: rotation is repeatable."""
+    passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD)
+    assert passwd(run, registered, NEW_PASSWORD, "a third password!!") == (0, "", "")
+    assert login(run, registered, "a third password!!") == (0, "ok\n", "")
+
+
+# --- FR-020: wrong current password ---------------------------------------------------
+
+
+def test_fr020_wrong_current_password_prints_invalid_credentials(run, registered):
+    """FR-020: ``invalid credentials`` on stderr with exit 1."""
+    status, out, err = passwd(run, registered, WRONG_PASSWORD, NEW_PASSWORD)
+    assert status == 1
+    assert err == "invalid credentials\n"
+    assert out == ""
+
+
+def test_fr020_wrong_current_password_leaves_the_stored_password_unchanged(
+    run, registered, read_store
+):
+    """FR-020: the original password still logs in; nothing was replaced."""
+    before = account(read_store, registered)
+    passwd(run, registered, WRONG_PASSWORD, NEW_PASSWORD)
+
+    assert account(read_store, registered) == before
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+    assert login(run, registered, NEW_PASSWORD) == (1, "", "invalid credentials\n")
+
+
+def test_fr020_l6_wrong_current_password_does_not_advance_the_tally(
+    run, registered, read_store
+):
+    """FR-020 (L-6): a failed ``passwd`` can never lock an account."""
+    for _ in range(10):
+        assert passwd(run, registered, WRONG_PASSWORD, NEW_PASSWORD)[0] == 1
+
+    record = account(read_store, registered)
+    assert record["failed_logins"] == 0
+    assert record["locked"] is False
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+
+
+# --- FR-021: new password too short ---------------------------------------------------
+
+
+def test_fr021_short_new_password_prints_password_too_short(run, registered):
+    """FR-021: ``password too short`` on stderr with exit 2."""
+    status, out, err = passwd(run, registered, GOOD_PASSWORD, "short")
+    assert status == 2
+    assert err == "password too short\n"
+    assert out == ""
+
+
+def test_fr021_short_new_password_leaves_the_stored_password_unchanged(
+    run, registered, read_store
+):
+    """FR-021: the account keeps its existing password."""
+    before = account(read_store, registered)
+    passwd(run, registered, GOOD_PASSWORD, "short")
+    assert account(read_store, registered) == before
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+
+
+def test_fr021_new_password_boundaries_12_accepted_11_rejected(run, registered):
+    """FR-021 (A-4): 12 characters accepted, 11 rejected."""
+    assert passwd(run, registered, GOOD_PASSWORD, "a" * 11) == (
+        2,
+        "",
+        "password too short\n",
+    )
+    assert passwd(run, registered, GOOD_PASSWORD, "b" * 12) == (0, "", "")
+    assert login(run, registered, "b" * 12) == (0, "ok\n", "")
+
+
+def test_fr021_current_password_is_verified_before_the_new_ones_length(run, registered):
+    """FR-021: both faults at once exits 1, not 2."""
+    status, out, err = passwd(run, registered, WRONG_PASSWORD, "short")
+    assert (status, out, err) == (1, "", "invalid credentials\n")
+
+
+def test_fr021_an_empty_new_password_is_too_short(run, registered):
+    """FR-021 (A-4): a 0-length new password is short, not missing input."""
+    assert passwd(run, registered, GOOD_PASSWORD, "") == (2, "", "password too short\n")
+
+
+# --- FR-022: unknown account ----------------------------------------------------------
+
+
+def test_fr022_unknown_account_prints_no_such_account(run, registered):
+    """FR-022: ``no such account`` on stderr with exit 3."""
+    status, out, err = passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD, username="dave")
+    assert status == 3
+    assert err == "no such account\n"
+    assert out == ""
+
+
+def test_fr022_unknown_account_performs_no_password_check(run, registered, monkeypatch):
+    """FR-022: the existence check precedes any derivation — ``verify`` is never called."""
+    from accounts import cli
+
+    calls = []
+    monkeypatch.setattr(
+        cli.hashing, "verify", lambda *a, **k: calls.append(1) or False
+    )
+    status, out, err = passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD, username="dave")
+    assert (status, out, err) == (3, "", "no such account\n")
+    assert calls == []
+
+
+def test_fr022_unknown_account_leaves_the_store_unchanged(run, registered, read_store):
+    """FR-022/FR-028: a failing ``passwd`` writes nothing."""
+    before = read_store(registered)
+    passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD, username="dave")
+    assert read_store(registered) == before
+
+
+def test_fr022_passwd_against_a_missing_store_reports_no_such_account(run, store_path):
+    """contracts/cli.md: a non-existent store path is the empty store (S-1)."""
+    status, out, err = passwd(run, store_path, GOOD_PASSWORD, NEW_PASSWORD)
+    assert (status, out, err) == (3, "", "no such account\n")
+
+
+def test_fr022_a3_a_malformed_username_is_simply_unknown(run, registered):
+    """A-3: ``passwd`` never reports ``invalid username``."""
+    for username in ["bad-name", "x", "a" * 40]:
+        status, out, err = passwd(
+            run, registered, GOOD_PASSWORD, NEW_PASSWORD, username=username
+        )
+        assert (status, out, err) == (3, "", "no such account\n")
+
+
+# --- A-8: derivation count ------------------------------------------------------------
+
+
+def test_a8_passwd_performs_exactly_two_derivations(run, registered, monkeypatch):
+    """A-8/SC-009: verify the current password, derive the new one — two, no more."""
+    from accounts import hashing as hashing_module
+
+    calls = []
+    real_derive = hashing_module.derive
+    monkeypatch.setattr(
+        hashing_module,
+        "derive",
+        lambda *a, **k: (calls.append(1), real_derive(*a, **k))[1],
+    )
+    assert passwd(run, registered, GOOD_PASSWORD, NEW_PASSWORD) == (0, "", "")
+    assert len(calls) == 2
