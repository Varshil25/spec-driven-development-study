new file mode 100644
index 0000000..3f58922
--- /dev/null
+++ b/src/accounts/cli.py
@@ -0,0 +1,277 @@
+"""Command-line surface: argument parsing, input reading, dispatch, messages, statuses.
+
+Contract: ``specs/001-accounts-cli/contracts/cli.md``.
+
+``main(argv, stdin, stdout, stderr) -> int`` returns the exit status rather than raising
+``SystemExit``, and touches no interpreter globals — ``__main__`` is the only module that
+does (research.md D-008).  Argument parsing is hand-rolled so that the single exact usage
+line of FR-006 is the only thing ever printed for a malformed invocation (D-002).
+"""
+
+from __future__ import annotations
+
+from . import hashing, store
+
+# --- Messages (contracts/cli.md Messages table; exact and complete) -------------------
+
+USAGE = (
+    "usage: python -m accounts --store PATH "
+    "{register|login|unlock|passwd|delete} USERNAME"
+)
+MSG_OK = "ok"
+MSG_INVALID_CREDENTIALS = "invalid credentials"
+MSG_ACCOUNT_LOCKED = "account locked"
+MSG_INVALID_USERNAME = "invalid username"
+MSG_PASSWORD_TOO_SHORT = "password too short"
+MSG_USERNAME_EXISTS = "username already exists"
+MSG_NO_SUCH_ACCOUNT = "no such account"
+MSG_MISSING_PASSWORD_INPUT = "missing password input"
+STORE_UNUSABLE_PREFIX = "store unusable: "
+
+# --- Exit statuses (FR-030) ----------------------------------------------------------
+
+EXIT_SUCCESS = 0
+EXIT_INVALID_CREDENTIALS = 1
+EXIT_INVALID_INPUT = 2
+EXIT_ACCOUNT_CONFLICT = 3
+EXIT_ACCOUNT_LOCKED = 4
+EXIT_STORE_UNUSABLE = 5
+
+# --- Validation rules ----------------------------------------------------------------
+
+MIN_PASSWORD_LENGTH = 12
+MIN_USERNAME_LENGTH = 3
+MAX_USERNAME_LENGTH = 32
+FAILED_LOGIN_LIMIT = 5
+
+#: The five commands and how many standard-input lines each reads, in order (FR-004).
+PASSWORD_LINES = {
+    "register": 1,
+    "login": 1,
+    "unlock": 0,
+    "passwd": 2,
+    "delete": 1,
+}
+
+
+def main(argv, stdin, stdout, stderr) -> int:
+    """Run one invocation and return its exit status.
+
+    Check order is fixed by D-004: argument parsing (2) → store load (5) → the required
+    input lines (2) → the command's own rules.
+    """
+    parsed = _parse_args(argv)
+    if parsed is None:
+        return _fail(stderr, USAGE, EXIT_INVALID_INPUT)
+    store_path, command, username = parsed
+
+    try:
+        data = store.load(store_path)
+    except store.StoreError as exc:
+        return _fail(stderr, f"{STORE_UNUSABLE_PREFIX}{exc}", EXIT_STORE_UNUSABLE)
+
+    passwords = _read_passwords(stdin, PASSWORD_LINES[command])
+    if passwords is None:
+        return _fail(stderr, MSG_MISSING_PASSWORD_INPUT, EXIT_INVALID_INPUT)
+
+    handler = _HANDLERS.get(command)
+    if handler is None:  # pragma: no cover - unreachable once every handler exists
+        raise NotImplementedError(f"no handler for command {command!r}")
+
+    try:
+        return handler(data, store_path, username, passwords, stdout, stderr)
+    except store.StoreError as exc:
+        return _fail(stderr, f"{STORE_UNUSABLE_PREFIX}{exc}", EXIT_STORE_UNUSABLE)
+
+
+# --- Pre-dispatch pipeline -----------------------------------------------------------
+
+
+def _parse_args(argv):
+    """Parse ``argv`` into ``(store_path, command, username)``, or ``None`` on a usage error.
+
+    ``--store PATH`` is located by scan, so it may appear anywhere relative to the two
+    positionals; ``--store=PATH`` and every other flag are usage errors (D-002).
+    """
+    store_path = None
+    positionals = []
+    index = 0
+    while index < len(argv):
+        argument = argv[index]
+        if argument == "--store":
+            if store_path is not None or index + 1 >= len(argv):
+                return None
+            store_path = argv[index + 1]
+            index += 2
+            continue
+        if argument.startswith("-"):
+            return None
+        positionals.append(argument)
+        index += 1
+
+    if store_path is None or len(positionals) != 2:
+        return None
+    command, username = positionals
+    if command not in PASSWORD_LINES:
+        return None
+    return store_path, command, username
+
+
+def _read_passwords(stdin, count: int):
+    """Read exactly ``count`` password lines, or ``None`` if input ends first (FR-005).
+
+    A line is its content with a single trailing line break removed and nothing else
+    stripped, so leading and trailing whitespace is preserved (FR-003, D-003).  Input
+    beyond ``count`` lines is never read, and so is ignored (FR-004).
+    """
+    passwords = []
+    for _ in range(count):
+        line = stdin.readline()
+        if line == "":
+            return None
+        passwords.append(line[:-1] if line.endswith("\n") else line)
+    return passwords
+
+
+def _fail(stderr, message: str, status: int) -> int:
+    """Write ``message`` to standard error and return ``status`` (FR-027)."""
+    print(message, file=stderr)
+    return status
+
+
+# --- Command handlers ----------------------------------------------------------------
+#
+# Every handler takes the loaded store, the path, the username, the password lines the
+# pipeline read, and the two output streams, and returns the exit status.
+
+
+def _valid_username(username: str) -> bool:
+    """Whether ``username`` may be registered (FR-007, A-1)."""
+    if not MIN_USERNAME_LENGTH <= len(username) <= MAX_USERNAME_LENGTH:
+        return False
+    return all(
+        character in _USERNAME_CHARACTERS for character in username
+    )
+
+
+_USERNAME_CHARACTERS = frozenset(
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_"
+)
+
+
+def _register(data, store_path, username, passwords, stdout, stderr) -> int:
+    """``register USERNAME`` — checks in the order of contracts/cli.md 1→4."""
+    (password,) = passwords
+
+    if not _valid_username(username):
+        return _fail(stderr, MSG_INVALID_USERNAME, EXIT_INVALID_INPUT)
+    if len(password) < MIN_PASSWORD_LENGTH:
+        return _fail(stderr, MSG_PASSWORD_TOO_SHORT, EXIT_INVALID_INPUT)
+    if username in data["accounts"]:
+        return _fail(stderr, MSG_USERNAME_EXISTS, EXIT_ACCOUNT_CONFLICT)
+
+    record = hashing.new_password_material(password)
+    record["failed_logins"] = 0
+    record["locked"] = False
+    data["accounts"][username] = record
+    store.save(store_path, data)
+
+    print(f"registered {username}", file=stdout)
+    return EXIT_SUCCESS
+
+
+def _login(data, store_path, username, passwords, stdout, stderr) -> int:
+    """``login USERNAME`` — existence (1) → locked (4) → password (1)."""
+    (password,) = passwords
+    record = data["accounts"].get(username)
+
+    # An unknown account is reported exactly as a wrong password, and writes nothing
+    # (FR-014).
+    if record is None:
+        return _fail(stderr, MSG_INVALID_CREDENTIALS, EXIT_INVALID_CREDENTIALS)
+
+    if record["locked"]:
+        # Nothing changes at all on a locked account (FR-016, L-3).
+        return _fail(stderr, MSG_ACCOUNT_LOCKED, EXIT_ACCOUNT_LOCKED)
+
+    if not hashing.verify(record, password):
+        record["failed_logins"] += 1
+        if record["failed_logins"] >= FAILED_LOGIN_LIMIT:
+            record["locked"] = True
+        store.save(store_path, data)
+        # The fifth failure is still reported as invalid credentials (FR-015, L-1).
+        return _fail(stderr, MSG_INVALID_CREDENTIALS, EXIT_INVALID_CREDENTIALS)
+
+    if record["failed_logins"] != 0:
+        record["failed_logins"] = 0
+        store.save(store_path, data)
+
+    print(MSG_OK, file=stdout)
+    return EXIT_SUCCESS
+
+
+def _unlock(data, store_path, username, passwords, stdout, stderr) -> int:
+    """``unlock USERNAME`` — reads no input; existence (3) → succeed (0)."""
+    record = data["accounts"].get(username)
+    if record is None:
+        return _fail(stderr, MSG_NO_SUCH_ACCOUNT, EXIT_ACCOUNT_CONFLICT)
+
+    # Succeeds whether or not the account was locked (FR-017, L-4). A no-op may skip
+    # the write; the observable behaviour is identical either way.
+    if record["locked"] or record["failed_logins"] != 0:
+        record["locked"] = False
+        record["failed_logins"] = 0
+        store.save(store_path, data)
+
+    return EXIT_SUCCESS
+
+
+def _passwd(data, store_path, username, passwords, stdout, stderr) -> int:
+    """``passwd USERNAME`` — existence (3) → current password (1) → new length (2)."""
+    current, new = passwords
+    record = data["accounts"].get(username)
+
+    # The existence check precedes any derivation, so no password check is performed on
+    # an unknown account (FR-022).
+    if record is None:
+        return _fail(stderr, MSG_NO_SUCH_ACCOUNT, EXIT_ACCOUNT_CONFLICT)
+
+    # The current password is verified before the new one's length (FR-021).
+    if not hashing.verify(record, current):
+        return _fail(stderr, MSG_INVALID_CREDENTIALS, EXIT_INVALID_CREDENTIALS)
+
+    if len(new) < MIN_PASSWORD_LENGTH:
+        return _fail(stderr, MSG_PASSWORD_TOO_SHORT, EXIT_INVALID_INPUT)
+
+    # Only the four derivation fields are replaced; `locked` and `failed_logins` are
+    # left exactly as they were (FR-019, L-5).
+    record.update(hashing.new_password_material(new))
+    store.save(store_path, data)
+    return EXIT_SUCCESS
+
+
+def _delete(data, store_path, username, passwords, stdout, stderr) -> int:
+    """``delete USERNAME`` — existence (3) → password (1)."""
+    (password,) = passwords
+    record = data["accounts"].get(username)
+
+    if record is None:
+        return _fail(stderr, MSG_NO_SUCH_ACCOUNT, EXIT_ACCOUNT_CONFLICT)
+
+    if not hashing.verify(record, password):
+        # The account is retained unchanged and the tally is not advanced (FR-024, L-6).
+        return _fail(stderr, MSG_INVALID_CREDENTIALS, EXIT_INVALID_CREDENTIALS)
+
+    del data["accounts"][username]
+    store.save(store_path, data)
+    return EXIT_SUCCESS
+
+
+#: Command word → handler.
+_HANDLERS: dict = {
+    "register": _register,
+    "login": _login,
+    "unlock": _unlock,
+    "passwd": _passwd,
+    "delete": _delete,
+}
