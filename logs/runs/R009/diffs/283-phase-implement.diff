+def test_fr029b_temporary_file_is_created_in_the_stores_own_directory(store_path, monkeypatch):
+    """FR-029b: the temp file shares the store's directory so the rename stays atomic."""
+    seen = {}
+    real_mkstemp = store.tempfile.mkstemp
+
+    def spy(*args, **kwargs):
+        seen["dir"] = kwargs.get("dir")
+        return real_mkstemp(*args, **kwargs)
+
+    monkeypatch.setattr(store.tempfile, "mkstemp", spy)
+    store.save(store_path, EMPTY_STORE)
+    assert Path(seen["dir"]).resolve() == Path(store_path).parent.resolve()
