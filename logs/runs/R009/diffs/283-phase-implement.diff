+# =====================================================================================
+# Whole-command behaviour — FR-027, FR-028 and FR-029 at the CLI level (T032, T033)
+# =====================================================================================
+
+GOOD_PASSWORD = "correct horse battery"
+WRONG_PASSWORD = "definitely wrong pw!"
+NEW_PASSWORD = "new passphrase here"
+
+#: (command, stdin) pairs that succeed against a store holding ``alice``.
+SUCCEEDING_COMMANDS = [
+    ("register", "bob", GOOD_PASSWORD + "\n"),
+    ("login", "alice", GOOD_PASSWORD + "\n"),
+    ("unlock", "alice", ""),
+    ("passwd", "alice", f"{GOOD_PASSWORD}\n{NEW_PASSWORD}\n"),
+    ("delete", "alice", GOOD_PASSWORD + "\n"),
+]
+
+#: (command, username, stdin, expected status, expected stderr) failing paths.
+FAILING_PATHS = [
+    ("register", "alice", GOOD_PASSWORD + "\n", 3, "username already exists\n"),
+    ("register", "bad-name", GOOD_PASSWORD + "\n", 2, "invalid username\n"),
+    ("register", "bob", "short\n", 2, "password too short\n"),
+    ("register", "bob", "", 2, "missing password input\n"),
+    ("login", "alice", WRONG_PASSWORD + "\n", 1, "invalid credentials\n"),
+    ("login", "nobody", GOOD_PASSWORD + "\n", 1, "invalid credentials\n"),
+    ("login", "alice", "", 2, "missing password input\n"),
+    ("unlock", "carol", "", 3, "no such account\n"),
+    ("passwd", "alice", f"{WRONG_PASSWORD}\n{NEW_PASSWORD}\n", 1, "invalid credentials\n"),
+    ("passwd", "alice", f"{GOOD_PASSWORD}\nshort\n", 2, "password too short\n"),
+    ("passwd", "dave", f"{GOOD_PASSWORD}\n{NEW_PASSWORD}\n", 3, "no such account\n"),
+    ("passwd", "alice", GOOD_PASSWORD + "\n", 2, "missing password input\n"),
+    ("delete", "alice", WRONG_PASSWORD + "\n", 1, "invalid credentials\n"),
+    ("delete", "erin", GOOD_PASSWORD + "\n", 3, "no such account\n"),
+    ("delete", "alice", "", 2, "missing password input\n"),
+]
+
+FAILING_IDS = [f"{c}-{u}-{s}" for c, u, _, s, _ in FAILING_PATHS]
+
+
+@pytest.fixture()
+def alice_store(run, store_path, low_iterations):
+    """A store holding ``alice`` at ``GOOD_PASSWORD``, unlocked, tally 0."""
+    assert run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")[0] == 0
+    return store_path
+
+
+# --- FR-027: stream discipline --------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "command,username,stdin,status,message", FAILING_PATHS, ids=FAILING_IDS
+)
+def test_fr027_every_failing_command_writes_only_to_stderr(
+    run, alice_store, command, username, stdin, status, message
+):
+    """FR-027: the message goes to stderr and nothing is written to stdout."""
+    got_status, out, err = run(["--store", str(alice_store), command, username], stdin)
+    assert got_status == status
+    assert err == message
+    assert out == ""
+
+
+@pytest.mark.parametrize(
+    "command,username,stdin", SUCCEEDING_COMMANDS, ids=[c for c, _, _ in SUCCEEDING_COMMANDS]
+)
+def test_fr027_every_successful_command_writes_nothing_to_stderr(
+    run, alice_store, command, username, stdin
+):
+    """FR-027: a successful command writes nothing at all to stderr."""
+    status, out, err = run(["--store", str(alice_store), command, username], stdin)
+    assert status == 0
+    assert err == ""
+
+
+def test_fr027_the_usage_error_writes_only_to_stderr(run, alice_store):
+    """FR-027: the usage line is a failure message and belongs on stderr."""
+    status, out, err = run(["--store", str(alice_store), "nope", "alice"])
+    assert status == 2
+    assert out == ""
+    assert err.startswith("usage: python -m accounts")
+
