@@ -0,0 +1,765 @@
+"""Tests for ``accounts.store`` — FR-029, FR-029a, FR-029b, FR-029c.
+
+One test per corruption condition listed in contracts/store-file.md, each asserting
+``StoreError`` with a non-empty cause.  Comparisons are against parsed JSON, never bytes.
+
+Note on the permission cases: this suite must pass for any user, including root, for whom
+the kernel bypasses file-mode checks — so a ``chmod 000`` file is still readable.  The
+"cannot be read / cannot be written" conditions of FR-029 are therefore covered two ways:
+by real filesystem conditions that fail for every user (the path is a directory, the parent
+is missing, the parent is not a directory) and by injecting the ``OSError`` a permission
+failure raises, asserting it is mapped to ``StoreError`` with the OS cause attached.
+"""
+
+from __future__ import annotations
+
+import base64
