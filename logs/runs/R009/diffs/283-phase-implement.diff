+"""Tests for ``unlock`` — FR-017 and FR-018."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+GOOD_PASSWORD = "correct horse battery"
+WRONG_PASSWORD = "definitely wrong pw!"
+
+
+@pytest.fixture(autouse=True)
+def _cheap_derivation(low_iterations):
+    return low_iterations
+
+
+@pytest.fixture()
+def registered(run, store_path):
+    assert run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")[0] == 0
+    return store_path
+
+
+def unlock(run, store_path, username="alice", stdin=""):
+    return run(["--store", str(store_path), "unlock", username], stdin)
+
+
+def login(run, store_path, password, username="alice"):
+    return run(["--store", str(store_path), "login", username], password + "\n")
+
+
+def account(read_store, store_path, username="alice"):
+    return read_store(store_path)["accounts"][username]
+
+
+# --- FR-017: success ------------------------------------------------------------------
+
+
+def test_fr017_unlock_a_locked_account_exits_0_with_both_streams_empty(run, registered):
+    """FR-017: exit 0 and no output at all; the correct password then works again."""
+    for _ in range(5):
+        login(run, registered, WRONG_PASSWORD)
+    assert login(run, registered, GOOD_PASSWORD)[0] == 4
+
+    status, out, err = unlock(run, registered)
+    assert status == 0
+    assert out == ""
+    assert err == ""
+
+    assert login(run, registered, GOOD_PASSWORD) == (0, "ok\n", "")
+
+
+def test_fr017_unlock_clears_both_the_lock_and_the_tally(run, registered, read_store):
+    """FR-017 (L-4): ``locked`` false and the tally back to 0."""
+    for _ in range(5):
+        login(run, registered, WRONG_PASSWORD)
+    assert account(read_store, registered)["locked"] is True
+    assert account(read_store, registered)["failed_logins"] == 5
+
+    assert unlock(run, registered) == (0, "", "")
+
+    assert account(read_store, registered)["locked"] is False
+    assert account(read_store, registered)["failed_logins"] == 0
+
+
+def test_fr017_unlock_an_unlocked_account_with_a_nonzero_tally_clears_the_tally(
+    run, registered, read_store
+):
+    """FR-017: it succeeds on an account that is not locked and resets the tally."""
+    for _ in range(3):
+        login(run, registered, WRONG_PASSWORD)
+    assert account(read_store, registered)["failed_logins"] == 3
+    assert account(read_store, registered)["locked"] is False
+
+    assert unlock(run, registered) == (0, "", "")
+    assert account(read_store, registered)["failed_logins"] == 0
+
+
+def test_fr017_unlock_is_idempotent_on_a_clean_account(run, registered, read_store):
+    """FR-017: unlocking an already-unlocked, zero-tally account succeeds."""
+    before = read_store(registered)
+    assert unlock(run, registered) == (0, "", "")
+    assert unlock(run, registered) == (0, "", "")
+    assert read_store(registered) == before
+
+
+def test_fr017_unlock_reads_nothing_from_standard_input(run, registered):
+    """FR-017: no password input is required — empty input is not ``missing input``."""
+    assert unlock(run, registered, stdin="") == (0, "", "")
+
+
+def test_fr017_unlock_ignores_any_input_supplied(run, registered):
+    """FR-017/FR-004: input present on standard input is ignored."""
+    assert unlock(run, registered, stdin="whatever\nmore\n") == (0, "", "")
+
+
+def test_fr017_l4_after_unlock_four_wrong_attempts_do_not_relock(
+    run, registered, read_store
+):
+    """FR-017 (L-4): the tally really restarted — four fresh failures do not lock."""
+    for _ in range(5):
+        login(run, registered, WRONG_PASSWORD)
