index 0000000..c27982f
--- /dev/null
+++ b/src/accounts/store.py
@@ -0,0 +1,209 @@
+"""The store file: load, validate, and atomic owner-only write.
+
+Format contract: ``specs/001-accounts-cli/contracts/store-file.md``.
+
+Everything that makes a store unusable — an unreadable path, content that is not UTF-8 or
+not JSON, a missing format marker, a record missing or mistyping any required field —
+raises :class:`StoreError` with the specific cause named (FR-029, FR-029a, Principle II).
+A path that simply does not exist is **not** corruption: it loads as the empty store
+(FR-002, S-1).
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import os
+import tempfile
+from pathlib import Path
+
+#: The only format marker this version accepts (FR-029a).
+FORMAT = "accounts-store-v1"
+
+#: Required fields of every account record, with the JSON type each must hold.
+_SALT_BYTES = 16
+_KEY_BYTES = 32
+_ALGORITHM = "pbkdf2_hmac_sha256"
+_REQUIRED_FIELDS = ("algorithm", "iterations", "salt", "key", "failed_logins", "locked")
+
+
+class StoreError(Exception):
+    """The store cannot be read, written or interpreted. Carries the specific cause."""
+
+
+def empty() -> dict:
+    """The empty store — what a non-existent path loads as (S-1)."""
+    return {"format": FORMAT, "accounts": {}}
+
+
+def load(path) -> dict:
+    """Read and validate the store at ``path``.
+
+    Returns:
+        The store document, normalized to exactly ``format`` and ``accounts``; unknown
+        extra top-level keys found on disk are ignored and so dropped (S-6).
+
+    Raises:
+        StoreError: the path is unusable or the content is not a valid store (FR-029).
+    """
+    target = Path(path)
+    try:
+        raw = target.read_bytes()
+    except FileNotFoundError as exc:
+        # The file itself being absent is the empty store (S-1); a missing *parent*
+        # directory is an unusable path and must still fail loudly (FR-029).
+        if target.parent.is_dir():
+            return empty()
+        raise StoreError(f"{target.parent}: no such directory") from exc
+    except OSError as exc:
+        raise StoreError(_os_cause(exc)) from exc
+
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise StoreError(f"{target}: not valid UTF-8 ({exc.reason})") from exc
+
+    try:
+        document = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise StoreError(f"{target}: not valid JSON ({exc.msg} at line {exc.lineno})") from exc
+
+    _validate(document)
+    return {"format": FORMAT, "accounts": document["accounts"]}
+
+
+def save(path, document: dict) -> None:
+    """Write ``document`` to ``path`` whole and atomically, owner-only.
+
+    Temporary file in the store's own directory → ``chmod 0o600`` → write → ``flush`` →
+    ``fsync`` → ``os.replace`` (FR-029b).  The mode is set before the rename, so the
+    store is never momentarily world-readable and a rewrite cannot widen it (FR-029c).
+    On any failure the temporary file is removed and the cause surfaces as a
+    :class:`StoreError`.
+
+    Raises:
+        StoreError: the path could not be written (FR-029).
+    """
+    target = Path(path)
+    payload = json.dumps({"format": FORMAT, "accounts": document["accounts"]})
+
+    fd = None
+    tmp_name = None
+    try:
+        fd, tmp_name = tempfile.mkstemp(dir=str(target.parent))
+        os.chmod(tmp_name, 0o600)
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            fd = None  # fdopen owns the descriptor from here on
+            handle.write(payload)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(tmp_name, str(target))
+        tmp_name = None
+    except OSError as exc:
+        raise StoreError(_os_cause(exc)) from exc
+    finally:
+        if fd is not None:
+            os.close(fd)
+        if tmp_name is not None and os.path.exists(tmp_name):
+            # Not a swallowed error: the write has already failed and its cause is being
+            # raised above. This only removes the orphaned temporary file (FR-029b).
+            os.unlink(tmp_name)
+
+
+# --- internals ------------------------------------------------------------------------
+
+
+def _os_cause(exc: OSError) -> str:
+    """A non-empty, human-readable cause for an OS-level failure (Principle II)."""
+    parts = [str(part) for part in (exc.filename, exc.strerror) if part]
+    return ": ".join(parts) if parts else str(exc) or exc.__class__.__name__
+
+
+def _validate(document) -> None:
+    """Raise :class:`StoreError` unless ``document`` is a valid store (FR-029a)."""
+    if not isinstance(document, dict):
+        raise StoreError(
+            f"top level is {_type_name(document)}, expected a JSON object"
+        )
+
+    if "format" not in document:
+        raise StoreError("format marker is missing")
+    if document["format"] != FORMAT:
+        raise StoreError(f"unrecognized format marker: {document['format']!r}")
+
+    if "accounts" not in document:
+        raise StoreError("accounts is missing")
+    accounts = document["accounts"]
+    if not isinstance(accounts, dict):
+        raise StoreError(f"accounts is {_type_name(accounts)}, expected a JSON object")
+
+    for username, record in accounts.items():
+        _validate_record(username, record)
+
+
+def _validate_record(username: str, record) -> None:
+    if not isinstance(record, dict):
+        raise StoreError(
+            f"account {username!r}: record is {_type_name(record)}, "
+            "expected a JSON object"
+        )
+
+    for field in _REQUIRED_FIELDS:
+        if field not in record:
+            raise StoreError(f"account {username!r}: {field} is missing")
+
+    prefix = f"account {username!r}"
+
+    algorithm = record["algorithm"]
+    if not isinstance(algorithm, str):
+        raise StoreError(
+            f"{prefix}: algorithm is {_type_name(algorithm)}, expected a string"
+        )
+    if algorithm != _ALGORITHM:
+        raise StoreError(f"{prefix}: unrecognized algorithm: {algorithm!r}")
+
+    _validate_int(prefix, "iterations", record["iterations"], minimum=1)
+    _validate_int(prefix, "failed_logins", record["failed_logins"], minimum=0)
+
+    _validate_b64(prefix, "salt", record["salt"], _SALT_BYTES)
+    _validate_b64(prefix, "key", record["key"], _KEY_BYTES)
+
+    locked = record["locked"]
+    if not isinstance(locked, bool):
+        raise StoreError(f"{prefix}: locked is {_type_name(locked)}, expected a boolean")
+
+
+def _validate_int(prefix: str, field: str, value, minimum: int) -> None:
+    # bool is a subclass of int in Python, so it must be rejected explicitly here
+    # (contracts/store-file.md: `{"iterations": true}` is corruption).
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise StoreError(
+            f"{prefix}: {field} is {_type_name(value)}, expected an integer"
+        )
+    if value < minimum:
+        raise StoreError(f"{prefix}: {field} is {value}, expected at least {minimum}")
+
+
+def _validate_b64(prefix: str, field: str, value, length: int) -> None:
+    if not isinstance(value, str):
+        raise StoreError(f"{prefix}: {field} is {_type_name(value)}, expected a string")
+    try:
+        decoded = base64.b64decode(value, validate=True)
+    except (ValueError, TypeError) as exc:
+        raise StoreError(f"{prefix}: {field} is not valid base64 ({exc})") from exc
+    if len(decoded) != length:
+        raise StoreError(
+            f"{prefix}: {field} decodes to {len(decoded)} bytes, expected {length}"
+        )
+
+
+def _type_name(value) -> str:
+    return {
+        type(None): "null",
+        bool: "a boolean",
+        int: "a number",
+        float: "a number",
+        str: "a string",
+        list: "an array",
+        dict: "an object",
+    }.get(type(value), type(value).__name__)
