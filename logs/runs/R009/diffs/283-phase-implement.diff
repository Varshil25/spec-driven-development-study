+
+# =====================================================================================
+# SC-002 — every documented message and every exit status, asserted exactly
+# =====================================================================================
+
+#: (id, setup commands, command under test, expected status, stream, exact message).
+#: ``setup`` runs first against the same store; ``stream`` is "out" or "err".
+SC002_ROWS = [
+    (
+        "registered-username",
+        [],
+        (["register", "alice"], GOOD_PASSWORD + "\n"),
+        0,
+        "out",
+        "registered alice\n",
+    ),
+    (
+        "ok",
+        [(["register", "alice"], GOOD_PASSWORD + "\n")],
+        (["login", "alice"], GOOD_PASSWORD + "\n"),
+        0,
+        "out",
+        "ok\n",
+    ),
+    (
+        "invalid-credentials",
+        [(["register", "alice"], GOOD_PASSWORD + "\n")],
+        (["login", "alice"], WRONG_PASSWORD + "\n"),
+        1,
+        "err",
+        "invalid credentials\n",
+    ),
+    (
+        "invalid-username",
+        [],
+        (["register", "bad-name"], GOOD_PASSWORD + "\n"),
+        2,
+        "err",
+        "invalid username\n",
+    ),
+    (
+        "password-too-short",
+        [],
+        (["register", "bob"], "short\n"),
+        2,
+        "err",
+        "password too short\n",
+    ),
+    (
+        "missing-password-input",
+        [],
+        (["register", "bob"], ""),
+        2,
+        "err",
+        "missing password input\n",
+    ),
+    (
+        "usage",
+        [],
+        (["bogus", "alice"], ""),
+        2,
+        "err",
+        USAGE,
+    ),
+    (
+        "username-already-exists",
+        [(["register", "alice"], GOOD_PASSWORD + "\n")],
+        (["register", "alice"], NEW_PASSWORD + "\n"),
+        3,
+        "err",
+        "username already exists\n",
+    ),
+    (
+        "no-such-account",
+        [(["register", "alice"], GOOD_PASSWORD + "\n")],
+        (["unlock", "carol"], ""),
+        3,
+        "err",
+        "no such account\n",
+    ),
+    (
+        "account-locked",
+        [(["register", "alice"], GOOD_PASSWORD + "\n")]
+        + [(["login", "alice"], WRONG_PASSWORD + "\n")] * 5,
+        (["login", "alice"], GOOD_PASSWORD + "\n"),
+        4,
+        "err",
+        "account locked\n",
+    ),
+]
+
+
+@pytest.mark.parametrize(
+    "setup,command,status,stream,message",
+    [row[1:] for row in SC002_ROWS],
+    ids=[row[0] for row in SC002_ROWS],
+)
+def test_sc002_each_documented_message_on_its_stream_with_its_status(
+    run, store_path, low_iterations, setup, command, status, stream, message
+):
+    """SC-002: every documented message asserted for equality on the correct stream."""
+    for argv, stdin in setup:
+        run(["--store", str(store_path), *argv], stdin)
+
+    argv, stdin = command
+    got_status, out, err = run(["--store", str(store_path), *argv], stdin)
+
+    assert got_status == status
+    if stream == "out":
+        assert out == message
+        assert err == ""
+    else:
+        assert err == message
+        assert out == ""
+
+
+def test_sc002_store_unusable_is_an_exact_prefix_with_a_named_cause(
+    run, store_path, write_store
+):
