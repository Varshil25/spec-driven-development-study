@@ -0,0 +1,280 @@
+"""Tests for ``register`` — FR-007, FR-008, FR-009, FR-010, FR-011.
+
+All runs use the ``low_iterations`` fixture; the 600,000 default is asserted separately
+(``test_hashing.py``, and end to end in ``test_cli_contract.py``).
+"""
+
+from __future__ import annotations
+
+import base64
+from pathlib import Path
+
+import pytest
+
+GOOD_PASSWORD = "correct horse battery"
+
+
+@pytest.fixture(autouse=True)
+def _cheap_derivation(low_iterations):
+    """Every test in this module registers, so lower the cost for all of them."""
+    return low_iterations
+
+
+# --- FR-009: success ------------------------------------------------------------------
+
+
+def test_fr009_success_prints_registered_username_on_stdout(run, store_path):
+    """FR-009: ``registered alice`` on stdout, exit 0, and the store now exists."""
+    status, out, err = run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    assert status == 0
+    assert out == "registered alice\n"
+    assert err == ""
+    assert Path(store_path).exists()
+
+
+def test_fr009_message_names_the_username_registered(run, store_path):
+    """FR-009: the message carries the username, not a fixed word."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    status, out, err = run(["--store", str(store_path), "register", "bob_99"], GOOD_PASSWORD + "\n")
+    assert (status, out, err) == (0, "registered bob_99\n", "")
+
+
+def test_fr009_l8_new_record_starts_unlocked_with_a_zero_tally(run, store_path, read_store):
+    """FR-009 (L-8): a new account has ``failed_logins: 0`` and ``locked: false``."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    record = read_store(store_path)["accounts"]["alice"]
+    assert record["failed_logins"] == 0
+    assert record["locked"] is False
+
+
+def test_fr009_new_record_has_all_six_required_fields(run, store_path, read_store):
+    """FR-009/FR-029a: the created record holds exactly the six required fields."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    record = read_store(store_path)["accounts"]["alice"]
+    assert set(record) == {
+        "algorithm",
+        "iterations",
+        "salt",
+        "key",
+        "failed_logins",
+        "locked",
+    }
+    assert record["algorithm"] == "pbkdf2_hmac_sha256"
+    assert len(base64.b64decode(record["salt"])) == 16
+    assert len(base64.b64decode(record["key"])) == 32
+
+
+def test_fr009_store_marker_is_written(run, store_path, read_store):
+    """FR-029a: the format marker is written on first use."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    assert read_store(store_path)["format"] == "accounts-store-v1"
+
+
+def test_fr009_two_accounts_coexist_in_one_store(run, store_path, read_store):
+    """FR-009: registering a second account leaves the first in place."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    run(["--store", str(store_path), "register", "bob"], "another good password\n")
+    assert sorted(read_store(store_path)["accounts"]) == ["alice", "bob"]
+
+
+# --- FR-007 / FR-010: username rules --------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "username",
+    [
+        "abc",  # 3 characters — lower boundary accepted
+        "a" * 32,  # 32 characters — upper boundary accepted
+        "Alice",
+        "alice_99",
+        "____",
+        "0123",
+        "aB_9",
+        "A" * 3,
+    ],
+)
+def test_fr007_valid_usernames_are_accepted(run, store_path, username):
+    """FR-007: 3–32 characters of letters, digits and underscores are accepted."""
+    status, out, err = run(
+        ["--store", str(store_path), "register", username], GOOD_PASSWORD + "\n"
+    )
+    assert (status, out, err) == (0, f"registered {username}\n", "")
+
+
+@pytest.mark.parametrize(
+    "username",
+    [
+        "ab",  # 2 characters — below the lower boundary
+        "a",
+        "a" * 33,  # 33 characters — above the upper boundary
+        "bad-name",
+        "bad name",
+        "bad.name",
+        "bad/name",
+        "bad!name",
+        "pässwörd",  # non-ASCII letters are not A-Z a-z
+        "a b",
+        "name\t",
+        "αβγ",
+    ],
+)
+def test_fr010_invalid_username_is_rejected(run, store_path, username, read_store):
+    """FR-010: ``invalid username`` on stderr, exit 2, and no account created."""
+    status, out, err = run(
+        ["--store", str(store_path), "register", username], GOOD_PASSWORD + "\n"
+    )
+    assert status == 2
+    assert err == "invalid username\n"
+    assert out == ""
+    assert not Path(store_path).exists()
+
+
+def test_fr007_username_boundaries_3_and_32_accepted_2_and_33_rejected(run, store_path):
+    """FR-007 (A-1): the exact length boundaries."""
+    assert run(["--store", str(store_path), "register", "a" * 3], GOOD_PASSWORD + "\n")[0] == 0
+    assert run(["--store", str(store_path), "register", "b" * 32], GOOD_PASSWORD + "\n")[0] == 0
+    assert run(["--store", str(store_path), "register", "c" * 2], GOOD_PASSWORD + "\n")[0] == 2
+    assert run(["--store", str(store_path), "register", "d" * 33], GOOD_PASSWORD + "\n")[0] == 2
+
+
+def test_fr007_a2_usernames_are_case_sensitive(run, store_path, read_store):
+    """FR-007 (A-2): ``Alice`` and ``alice`` are distinct accounts."""
+    assert run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")[0] == 0
+    status, out, err = run(
+        ["--store", str(store_path), "register", "Alice"], "a different password\n"
+    )
+    assert (status, out, err) == (0, "registered Alice\n", "")
+    assert sorted(read_store(store_path)["accounts"]) == ["Alice", "alice"]
+
+
+def test_fr010_invalid_username_does_not_create_the_store(run, store_path):
+    """FR-010: a failing registration creates no store file at all (S-2)."""
+    run(["--store", str(store_path), "register", "bad-name"], GOOD_PASSWORD + "\n")
+    assert not Path(store_path).exists()
+
+
+# --- FR-008 / FR-010: password rules --------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "password",
+    [
+        "a" * 12,  # 12 characters — lower boundary accepted
+        GOOD_PASSWORD,
+        "a" * 200,  # no maximum length
+        " " * 12,  # 12 spaces: no character-class restriction
+        "123456789012",
+        "!@#$%^&*()_+",
+    ],
+)
+def test_fr008_valid_passwords_are_accepted(run, store_path, password):
+    """FR-008: at least 12 characters, no maximum, no character-class restriction."""
+    status, out, err = run(["--store", str(store_path), "register", "alice"], password + "\n")
+    assert (status, out, err) == (0, "registered alice\n", "")
+
+
+@pytest.mark.parametrize("password", ["", "short", "a" * 11, " " * 11])
+def test_fr010_too_short_password_is_rejected(run, store_path, password):
+    """FR-010: ``password too short`` on stderr, exit 2, and no account created."""
+    status, out, err = run(["--store", str(store_path), "register", "alice"], password + "\n")
+    assert status == 2
+    assert err == "password too short\n"
+    assert out == ""
+    assert not Path(store_path).exists()
+
+
+def test_fr008_password_boundaries_12_accepted_11_rejected(run, store_path):
+    """FR-008 (A-4): the exact length boundary."""
+    assert run(["--store", str(store_path), "register", "alice"], "a" * 11 + "\n")[0] == 2
+    assert run(["--store", str(store_path), "register", "alice"], "a" * 12 + "\n")[0] == 0
+
+
+def test_fr008_a4_length_is_counted_in_characters_not_bytes(run, store_path):
+    """FR-008 (A-4): a 12-character non-ASCII password is accepted."""
+    password = "ü" * 12
+    assert len(password) == 12
+    assert len(password.encode("utf-8")) == 24
+    status, out, err = run(["--store", str(store_path), "register", "alice"], password + "\n")
+    assert (status, out, err) == (0, "registered alice\n", "")
+    assert run(["--store", str(store_path), "login", "alice"], password + "\n")[0] == 0
+
+
+def test_fr008_a4_an_11_character_non_ascii_password_is_rejected(run, store_path):
+    """FR-008 (A-4): 11 characters is short even when it occupies 22 bytes."""
+    password = "ü" * 11
+    status, out, err = run(["--store", str(store_path), "register", "alice"], password + "\n")
+    assert (status, out, err) == (2, "", "password too short\n")
+
+
+# --- FR-011: duplicate username -------------------------------------------------------
+
+
+def test_fr011_duplicate_username_is_rejected(run, store_path):
+    """FR-011: ``username already exists`` on stderr with exit 3."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    status, out, err = run(
+        ["--store", str(store_path), "register", "alice"], "a different password\n"
+    )
+    assert status == 3
+    assert err == "username already exists\n"
+    assert out == ""
+
+
+def test_fr011_duplicate_leaves_the_existing_account_entirely_unchanged(
+    run, store_path, read_store
+):
+    """FR-011: password, failure tally and lock state are all untouched."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    run(["--store", str(store_path), "login", "alice"], "wrong password here\n")
+    before = read_store(store_path)
+
+    run(["--store", str(store_path), "register", "alice"], "a different password\n")
+
+    assert read_store(store_path) == before
+    # The original password still works; the attempted new one does not.
+    assert run(["--store", str(store_path), "login", "alice"], GOOD_PASSWORD + "\n")[0] == 0
+    assert (
+        run(["--store", str(store_path), "login", "alice"], "a different password\n")[0] == 1
+    )
+
+
+# --- FR-010: precedence ---------------------------------------------------------------
+
+
+def test_fr010_invalid_username_wins_over_a_short_password(run, store_path):
+    """FR-010: the username is checked before the password."""
+    status, out, err = run(["--store", str(store_path), "register", "bad-name"], "short\n")
+    assert (status, out, err) == (2, "", "invalid username\n")
+
+
+def test_fr010_format_rules_win_over_the_duplicate_check(run, store_path):
+    """FR-010: an existing username with a short password prints ``password too short``."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    status, out, err = run(["--store", str(store_path), "register", "alice"], "short\n")
+    assert (status, out, err) == (2, "", "password too short\n")
+
+
+def test_fr010_invalid_username_wins_over_the_duplicate_check(run, store_path):
+    """FR-010: a username that is both invalid and (impossibly) taken reports format first.
+
+    ``bad-name`` can never be in the store, so this asserts the ordering positively via
+    the one case that is reachable: an invalid username is reported before anything the
+    store could say.
+    """
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    status, out, err = run(["--store", str(store_path), "register", "bad-name"], "short\n")
+    assert (status, out, err) == (2, "", "invalid username\n")
+
+
+# --- A-6 / SC-005 at the register level -----------------------------------------------
+
+
+def test_a6_two_accounts_with_the_same_password_share_no_material(
+    run, store_path, read_store
+):
+    """A-6: identical passwords produce different salt and different key."""
+    run(["--store", str(store_path), "register", "alice"], GOOD_PASSWORD + "\n")
+    run(["--store", str(store_path), "register", "bob"], GOOD_PASSWORD + "\n")
+    accounts = read_store(store_path)["accounts"]
+    assert accounts["alice"]["salt"] != accounts["bob"]["salt"]
+    assert accounts["alice"]["key"] != accounts["bob"]["key"]
