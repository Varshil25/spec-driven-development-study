+# =====================================================================================
+# SC-001 — every functional requirement is named by at least one test
+# =====================================================================================
+
+ALL_REQUIREMENTS = [f"FR-{index:03d}" for index in range(1, 31)] + [
+    "FR-026a",
+    "FR-026b",
+    "FR-026c",
+    "FR-029a",
+    "FR-029b",
+    "FR-029c",
+]
+
+ALL_CRITERIA = [f"SC-{index:03d}" for index in range(1, 10)]
+
+
+def _requirement_token(identifier: str) -> str:
+    """Normalize ``FR-026a`` so it matches both ``FR-026a`` and ``test_fr026a_...``."""
+    return identifier.lower().replace("-", "").replace("_", "")
+
+
+def _test_functions():
+    """Yield ``(file, function name, function source)`` for every test in the suite."""
+    import ast
+
+    for path in sorted(Path(__file__).resolve().parent.glob("test_*.py")):
+        source = path.read_text(encoding="utf-8")
+        tree = ast.parse(source)
+        lines = source.splitlines()
+        for node in ast.walk(tree):
+            if isinstance(node, ast.FunctionDef) and node.name.startswith("test_"):
+                body = "\n".join(lines[node.lineno - 1 : node.end_lineno])
+                yield path.name, node.name, body
+
+
+@pytest.mark.parametrize("requirement", ALL_REQUIREMENTS)
+def test_sc001_every_functional_requirement_is_named_by_a_test(requirement):
+    """SC-001: each FR is named in the name or a comment of at least one test.
+
+    Constitution Principle III: a feature MUST NOT be marked complete while any
+    functional requirement has no covering test, and the mapping MUST be explicit.
+    """
+    token=[REDACTED:assigned_secret](requirement)
+    covering = [
+        f"{file}::{name}"
+        for file, name, body in _test_functions()
+        if token in _requirement_token(name) or token in _requirement_token(body)
+    ]
+    assert covering, f"{requirement} is named by no test"
+
+
+@pytest.mark.parametrize("criterion", ALL_CRITERIA)
+def test_sc001_every_success_criterion_is_named_by_a_test(criterion):
+    """SC-001: each success criterion is likewise named by at least one test."""
+    token=[REDACTED:assigned_secret](criterion)
+    covering = [
+        f"{file}::{name}"
+        for file, name, body in _test_functions()
+        if token in _requirement_token(name) or token in _requirement_token(body)
+    ]
+    assert covering, f"{criterion} is named by no test"
+
+
+def test_sc001_the_suite_covers_every_message_and_every_status():
+    """SC-001/SC-002: the inventory tables above are complete, not a sample."""
+    assert len(SC002_ROWS) == 10  # the eleventh, `store unusable: `, is a prefix test
+    assert {row[3] for row in SC002_ROWS} == {0, 1, 2, 3, 4}
