+++ b/tests/test_delete.py
@@ -0,0 +1,261 @@
+"""Delete: FR-030 - FR-033."""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+PASSWORD = "correct horse battery"
+OTHER = "a second password"
+INVALID = "invalid credentials\n"
+E8 = "no password on standard input\n"
+
+
+class ExplodingStream(io.StringIO):
+    """A standard-input stream that fails if it is read at all (FR-034)."""
+
+    def readline(self, *args, **kwargs):  # noqa: D102
+        raise AssertionError("this command must not read standard input")
+
+
+def register(run_cli, store_path: Path, username: str = "alice", password: str = PASSWORD):
+    return run_cli(["--store", str(store_path), "register", username], password + "\n")
+
+
+def delete(run_cli, store_path: Path, password: str | None, username: str = "alice"):
+    argv = ["--store", str(store_path), "delete", username]
+    return run_cli(argv, "" if password is None else password + "\n")
+
+
+def login(run_cli, store_path: Path, password: str, username: str = "alice"):
+    return run_cli(["--store", str(store_path), "login", username], password + "\n")
+
+
+# ------------------------------------------------------------------------------- FR-030
+
+
+def test_fr030_success_reads_one_line_exits_0_and_prints_nothing(run_cli, store_path):
+    """FR-030: the correct password removes the account; status 0, both streams empty."""
+    register(run_cli, store_path)
+    status, out, err = delete(run_cli, store_path, PASSWORD)
+    assert status == 0
+    assert out == ""
+    assert err == ""
+
+
+def test_fr030_the_record_and_all_its_state_are_removed(run_cli, store_path, read_store):
+    """FR-030: the account and all of its state leave the store."""
+    register(run_cli, store_path)
+    for _ in range(2):
+        login(run_cli, store_path, "wrong password!!")
+    assert read_store(store_path)["accounts"]["alice"]["failed_logins"] == 2
+
+    delete(run_cli, store_path, PASSWORD)
+    accounts = read_store(store_path)["accounts"]
+    assert "alice" not in accounts
+    assert accounts == {}
+
+
+def test_fr030_extra_lines_beyond_the_one_needed_are_ignored(run_cli, store_path):
+    """Contract "Standard-input protocol": delete reads exactly one line."""
+    register(run_cli, store_path)
+    status, out, err = run_cli(
+        ["--store", str(store_path), "delete", "alice"], PASSWORD + "\nextra\n\n"
+    )
+    assert (status, out, err) == (0, "", "")
+
+
+# ------------------------------------------------------------------------------- FR-031
+
+
+def test_fr031_a_wrong_password_exits_1_with_invalid_credentials(run_cli, store_path):
+    """FR-031: exactly 'invalid credentials' on stderr, status 1."""
+    register(run_cli, store_path)
+    status, out, err = delete(run_cli, store_path, "wrong password!!")
+    assert status == 1
+    assert out == ""
+    assert err == INVALID
+
+
+def test_fr031_a_wrong_password_retains_the_account_unchanged(
+    run_cli, store_path, read_store
+):
+    """FR-031: the account survives byte-identically and still logs in."""
+    register(run_cli, store_path)
+    before = read_store(store_path)
+    delete(run_cli, store_path, "wrong password!!")
+    assert read_store(store_path) == before
+    assert login(run_cli, store_path, PASSWORD) == (0, "ok\n", "")
+
+
+def test_fr031_an_empty_password_is_a_rejected_credential(run_cli, store_path):
+    """FR-031 / FR-018: a blank line is a supplied password, and a wrong one."""
+    register(run_cli, store_path)
+    assert delete(run_cli, store_path, "") == (1, "", INVALID)
+    assert login(run_cli, store_path, PASSWORD) == (0, "ok\n", "")
+
+
+# ------------------------------------------------------------------------------- FR-032
+
+
+def test_fr032_a_login_after_a_successful_delete_fails_per_fr016(run_cli, store_path):
+    """FR-032: the deleted username behaves exactly like one that never existed."""
+    register(run_cli, store_path)
+    delete(run_cli, store_path, PASSWORD)
+    assert login(run_cli, store_path, PASSWORD) == (1, "", INVALID)
+    assert login(run_cli, store_path, "wrong password!!") == (1, "", INVALID)
+
+
+def test_fr032_the_username_is_available_for_registration_again(run_cli, store_path):
+    """FR-032: the name is free, and the new account is a new account."""
+    register(run_cli, store_path)
+    delete(run_cli, store_path, PASSWORD)
+    status, out, err = register(run_cli, store_path, password="a brand new secret")
+    assert (status, out, err) == (0, "registered alice\n", "")
+    assert login(run_cli, store_path, "a brand new secret") == (0, "ok\n", "")
+    assert login(run_cli, store_path, PASSWORD) == (1, "", INVALID)
+
+
+def test_fr032_the_re_registered_account_starts_with_clean_state(
+    run_cli, store_path, read_store
+):
+    """FR-030 / FR-032: no failed-login count or lock is inherited from the old account."""
+    register(run_cli, store_path)
+    for _ in range(3):
+        login(run_cli, store_path, "wrong password!!")
+    delete(run_cli, store_path, PASSWORD)
+    register(run_cli, store_path, password="a brand new secret")
+    record = read_store(store_path)["accounts"]["alice"]
+    assert record["failed_logins"] == 0
+    assert record["locked"] is False
+
+
+# ------------------------------------------------------------------------------- FR-033
+
+
+def test_fr033_removing_one_account_does_not_alter_any_other(
+    run_cli, store_path, read_store
+):
+    """FR-033: bob's verifier, salt, failed-login count, and lock state are untouched."""
+    register(run_cli, store_path)
+    register(run_cli, store_path, username="bob", password=OTHER)
+    login(run_cli, store_path, "wrong password!!", username="bob")
+    before = read_store(store_path)["accounts"]["bob"]
+
+    assert delete(run_cli, store_path, PASSWORD) == (0, "", "")
+    after = read_store(store_path)["accounts"]["bob"]
+    assert after == before
+    assert login(run_cli, store_path, OTHER, username="bob") == (0, "ok\n", "")
+
+
+def test_fr033_a_locked_other_account_stays_locked(run_cli, store_path, read_store):
+    """FR-033: deleting alice does not clear bob's lock."""
+    register(run_cli, store_path)
+    register(run_cli, store_path, username="bob", password=OTHER)
+    for _ in range(5):
+        login(run_cli, store_path, "wrong password!!", username="bob")
+    assert read_store(store_path)["accounts"]["bob"]["locked"] is True
+
+    delete(run_cli, store_path, PASSWORD)
+    assert read_store(store_path)["accounts"]["bob"]["locked"] is True
+
+
+def test_fr033_a_failed_delete_does_not_alter_any_other_account(
+    run_cli, store_path, read_store
+):
+    """FR-033 / FR-006: a rejected delete leaves the whole store unchanged."""
+    register(run_cli, store_path)
+    register(run_cli, store_path, username="bob", password=OTHER)
+    before = read_store(store_path)
+    delete(run_cli, store_path, "wrong password!!")
+    assert read_store(store_path) == before
+
+
+# ------------------------------------------------------------------------- FR-034 (E4)
+
+
+def test_fr034_a_missing_account_exits_3_with_e4(run_cli, store_path):
+    """FR-034 / E4: 'no such account: carol' on stderr with status 3."""
+    register(run_cli, store_path)
+    status, out, err = delete(run_cli, store_path, PASSWORD, username="carol")
+    assert status == 3
+    assert out == ""
+    assert err == "no such account: carol\n"
+
+
+def test_fr034_the_existence_check_precedes_any_standard_input_read(store_path, run_cli):
+    """FR-034: nothing is consumed from standard input for a missing account."""
+    from accounts import cli
+
+    register(run_cli, store_path)
+    out, err = io.StringIO(), io.StringIO()
+    status = cli.main(
+        ["--store", str(store_path), "delete", "carol"], ExplodingStream(), out, err
+    )
+    assert status == 3
+    assert out.getvalue() == ""
+    assert err.getvalue() == "no such account: carol\n"
+
+
+def test_fr034_delete_against_a_missing_store_exits_3_and_creates_no_file(
+    run_cli, store_path
+):
+    """FR-034 / FR-002: a missing store is an empty store; no file is created."""
+    assert not store_path.exists()
+    assert delete(run_cli, store_path, PASSWORD) == (3, "", "no such account: alice\n")
+    assert not store_path.exists()
+
+
+# ------------------------------------------------------------------------- FR-018 (E8)
+
+
+def test_fr018_end_of_input_gives_e8_and_status_2(run_cli, store_path):
+    """FR-018 / E8: end of input where the password was required, status 2."""
+    register(run_cli, store_path)
+    status, out, err = delete(run_cli, store_path, None)
+    assert (status, out, err) == (2, "", E8)
+
+
+def test_fr018_a_missing_password_deletes_nothing(run_cli, store_path, read_store):
+    """FR-006 / FR-018: an E8 failure leaves the store's account data unchanged."""
+    register(run_cli, store_path)
+    before = read_store(store_path)
+    delete(run_cli, store_path, None)
+    assert read_store(store_path) == before
+
+
+# ------------------------------------------------------------------------- FR-024, FR-025
+
+
+def test_fr025_a_locked_account_is_still_deletable_with_the_correct_password(
+    run_cli, store_path, read_store
+):
+    """FR-025: the lock does not protect the account from its own holder."""
+    register(run_cli, store_path)
+    for _ in range(5):
+        login(run_cli, store_path, "wrong password!!")
+    assert read_store(store_path)["accounts"]["alice"]["locked"] is True
+
+    assert delete(run_cli, store_path, PASSWORD) == (0, "", "")
+    assert read_store(store_path)["accounts"] == {}
+
+
+def test_fr024_a_failed_delete_does_not_count_as_a_failed_login(
+    run_cli, store_path, read_store
+):
+    """FR-024: a rejected delete never changes the failed-login count."""
+    register(run_cli, store_path)
+    for _ in range(6):
+        assert delete(run_cli, store_path, "wrong password!!") == (1, "", INVALID)
+    record = read_store(store_path)["accounts"]["alice"]
+    assert record["failed_logins"] == 0
+    assert record["locked"] is False
+
+
+def test_fr037_delete_diagnostics_contain_no_secret(run_cli, store_path):
+    """FR-037: the attempted password is never echoed."""
+    register(run_cli, store_path)
+    attempt = "a unique wrong secret"
+    _, out, err = delete(run_cli, store_path, attempt)
+    assert attempt not in out and attempt not in err
+    assert PASSWORD not in out and PASSWORD not in err
diff --git a/tests/test_end_to_end.py b/tests/test_end_to_end.py
new file mode 100644
index 0000000..659353b
--- /dev/null
+++ b/tests/test_end_to_end.py
@@ -0,0 +1,246 @@
+"""Real process, real files: SC-002, SC-005, SC-006, FR-038.
+
+Some criteria are claims about the *process* — its real exit status, that nothing extra
+reaches the real streams, and that no password appears in ``argv`` — which an in-process
+call cannot honestly verify (research.md R-08). These tests therefore run
+``python -m accounts`` through ``subprocess.run`` with ``PYTHONPATH=src``.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import os
+import stat
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC = REPO_ROOT / "src"
+
+PASSWORD = "correct horse battery"
+
+
+def run(store: Path, command: str, username: str, stdin_text: str = "") -> subprocess.CompletedProcess:
+    """Invoke the tool as a separate process, exactly as the contract documents it."""
+    argv = [sys.executable, "-m", "accounts", "--store", str(store), command, username]
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+    completed = subprocess.run(
+        argv,
+        input=stdin_text,
+        capture_output=True,
+        text=True,
+        env=env,
+        cwd=REPO_ROOT,
+        timeout=60,
+    )
+    # FR-003 / SC-006: nothing supplied on standard input is ever an element of the real
+    # command line. Checked on every invocation these tests make, not just once.
+    for line in stdin_text.splitlines():
+        if line:
+            assert all(line not in element for element in argv)
+    return completed
+
+
+@pytest.fixture
+def store(tmp_path: Path) -> Path:
+    return tmp_path / "store.json"
+
+
+# ---------------------------------------------------------------------------- SC-002
+
+
+def test_sc002_worked_example_1_register_alice(store):
+    """SC-002: `register alice` prints `registered alice`, status 0, nothing on stderr."""
+    done = run(store, "register", "alice", PASSWORD + "\n")
+    assert done.returncode == 0
+    assert done.stdout == "registered alice\n"
+    assert done.stderr == ""
+
+
+def test_sc002_worked_example_2_login_succeeds(store):
+    """SC-002: `login alice` with the right password prints `ok`, status 0."""
+    run(store, "register", "alice", PASSWORD + "\n")
+    done = run(store, "login", "alice", PASSWORD + "\n")
+    assert done.returncode == 0
+    assert done.stdout == "ok\n"
+    assert done.stderr == ""
+
+
+def test_sc002_worked_example_3_login_fails(store):
+    """SC-002: a wrong password prints `invalid credentials` on stderr, status 1."""
+    run(store, "register", "alice", PASSWORD + "\n")
+    done = run(store, "login", "alice", "wrong password!!\n")
+    assert done.returncode == 1
+    assert done.stdout == ""
+    assert done.stderr == "invalid credentials\n"
+
+
+def test_sc002_worked_example_4_short_password_creates_no_account(store):
+    """SC-002: `register bob` with `short` exits 2 and creates no account."""
+    run(store, "register", "alice", PASSWORD + "\n")
+    done = run(store, "register", "bob", "short\n")
+    assert done.returncode == 2
+    assert done.stdout == ""
+    assert done.stderr == "password must be at least 12 characters\n"
+    assert "bob" not in json.loads(store.read_text(encoding="utf-8"))["accounts"]
+
+
+# ---------------------------------------------------------------------------- SC-005
+
+
+def test_sc005_a_registration_is_readable_by_a_later_separate_invocation(store):
+    """SC-005: account data written by one process is read by the next."""
+    assert run(store, "register", "alice", PASSWORD + "\n").returncode == 0
+    assert run(store, "login", "alice", PASSWORD + "\n").stdout == "ok\n"
+
+
+def test_sc005_a_failed_login_count_is_visible_to_a_later_invocation(store):
+    """SC-005 / FR-006: a failed login's persisted count accumulates across processes."""
+    run(store, "register", "alice", PASSWORD + "\n")
+    for _ in range(3):
+        assert run(store, "login", "alice", "wrong password!!\n").returncode == 1
+    record = json.loads(store.read_text(encoding="utf-8"))["accounts"]["alice"]
+    assert record["failed_logins"] == 3
+
+
+# ---------------------------------------------------------------------------- SC-006
+
+
+def test_sc006_no_password_appears_anywhere_in_the_store_bytes(store):
+    """SC-006: no password supplied in testing is found in the store file's bytes."""
+    secrets_used = [PASSWORD, "a second password", "  leading and trailing  ", "pässwörd-ñ€x"]
+    for index, secret in enumerate(secrets_used):
+        assert run(store, "register", f"user_{index}", secret + "\n").returncode == 0
+    raw = store.read_bytes()
+    for secret in secrets_used:
+        encoded = secret.encode("utf-8")
+        assert encoded not in raw
+        # The store's fields are base64, so check that encoding too, not just the plain bytes.
+        assert base64.b64encode(encoded).rstrip(b"=") not in raw
+
+
+def test_sc006_a_password_cannot_be_passed_on_the_command_line(store):
+    """FR-003 / SC-006: the password reaches the process only through standard input.
+
+    Attempting to supply it as an argument is a usage error, so there is no invocation in
+    which a password could appear in ``argv`` at all.
+    """
+    run(store, "register", "alice", PASSWORD + "\n")
+    env = dict(os.environ, PYTHONPATH=str(SRC))
+    for extra in ([f"--password={PASSWORD}"], ["--password", PASSWORD], [PASSWORD]):
+        done = subprocess.run(
+            [sys.executable, "-m", "accounts", "--store", str(store), "login", "alice", *extra],
+            input="",
+            capture_output=True,
+            text=True,
+            env=env,
+            cwd=REPO_ROOT,
+            timeout=60,
+        )
+        assert done.returncode == 2, extra
+        assert done.stdout == "", extra
+        assert "usage:" in done.stderr, extra
+
+
+# ---------------------------------------------------------------------------- FR-038
+
+
+def test_fr038_a_freshly_created_store_reports_mode_600(store):
+    """FR-038: a newly created store file is readable and writable only by its owner."""
+    run(store, "register", "alice", PASSWORD + "\n")
+    assert oct(stat.S_IMODE(store.stat().st_mode)) == oct(0o600)
+
+
+def test_fr038_mode_600_survives_the_atomic_replace(store):
+    """FR-038 / FR-008: a rewrite does not widen the mode."""
+    run(store, "register", "alice", PASSWORD + "\n")
+    run(store, "register", "bob", "a second password\n")
+    assert stat.S_IMODE(store.stat().st_mode) == 0o600
+
+
+# ----------------------------------------------- SC-005 across every mutating command
+
+
+def test_sc005_a_password_change_is_observed_by_a_later_separate_process(store):
+    """SC-005: passwd in one process, login with the new password in the next."""
+    run(store, "register", "alice", PASSWORD + "\n")
+    done = run(store, "passwd", "alice", f"{PASSWORD}\nnew longer secret\n")
+    assert (done.returncode, done.stdout, done.stderr) == (0, "", "")
+
+    assert run(store, "login", "alice", "new longer secret\n").stdout == "ok\n"
+    assert run(store, "login", "alice", PASSWORD + "\n").returncode == 1
+    assert stat.S_IMODE(store.stat().st_mode) == 0o600
+
+
+def test_sc005_an_unlock_is_observed_by_a_later_separate_process(store):
+    """SC-005: the lock set in one process is cleared for the next."""
+    run(store, "register", "alice", PASSWORD + "\n")
+    for _ in range(5):
+        assert run(store, "login", "alice", "nope nope nope\n").returncode == 1
+    locked = run(store, "login", "alice", PASSWORD + "\n")
+    assert locked.returncode == 4
+    assert locked.stderr == "account locked\n"
+
+    done = run(store, "unlock", "alice")
+    assert (done.returncode, done.stdout, done.stderr) == (0, "", "")
+    assert run(store, "login", "alice", PASSWORD + "\n").stdout == "ok\n"
+    assert stat.S_IMODE(store.stat().st_mode) == 0o600
+
+
+def test_sc005_a_delete_is_observed_by_a_later_separate_process(store):
+    """SC-005 / FR-032: the removal persists and frees the username for the next process."""
+    run(store, "register", "alice", PASSWORD + "\n")
+    run(store, "register", "bob", "a second password\n")
+
+    done = run(store, "delete", "alice", PASSWORD + "\n")
+    assert (done.returncode, done.stdout, done.stderr) == (0, "", "")
+    assert "alice" not in json.loads(store.read_text(encoding="utf-8"))["accounts"]
+    assert run(store, "login", "alice", PASSWORD + "\n").returncode == 1
+    assert run(store, "login", "bob", "a second password\n").stdout == "ok\n"
+    assert run(store, "register", "alice", "a brand new secret\n").stdout == "registered alice\n"
+    assert stat.S_IMODE(store.stat().st_mode) == 0o600
+
+
+def test_sc005_the_failed_login_count_survives_every_other_command(store):
+    """SC-005 / FR-024: passwd and delete leave the persisted counter alone."""
+    run(store, "register", "alice", PASSWORD + "\n")
+    run(store, "login", "alice", "nope nope nope\n")
+    run(store, "passwd", "alice", f"{PASSWORD}\nnew longer secret\n")
+    run(store, "delete", "alice", "nope nope nope\n")
+    record = json.loads(store.read_text(encoding="utf-8"))["accounts"]["alice"]
+    assert record["failed_logins"] == 1
+    assert record["locked"] is False
+
+
+# ------------------------------------------------------------- FR-035 in a real process
+
+
+def test_fr035_every_usage_error_exits_2_in_a_real_process(tmp_path):
+    """FR-035: the five usage errors reach exit status 2 as a process, not just in-process."""
+    env = dict(os.environ, PYTHONPATH=str(SRC))
+    store = tmp_path / "store.json"
+    cases = [
+        ["login", "alice"],
+        ["--store", str(store)],
+        ["--store", str(store), "frobnicate", "alice"],
+        ["--store", str(store), "login"],
+        ["--store", str(store), "login", "alice", "extra"],
+    ]
+    for extra in cases:
+        done = subprocess.run(
+            [sys.executable, "-m", "accounts", *extra],
+            input="",
+            capture_output=True,
+            text=True,
+            env=env,
+            cwd=REPO_ROOT,
+            timeout=60,
+        )
+        assert done.returncode == 2, extra
+        assert done.stdout == "", extra
+        assert "usage:" in done.stderr, extra
