@@ -0,0 +1,305 @@
+"""Password change: FR-026 - FR-029."""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+PASSWORD = "correct horse battery"
+NEW = "new longer secret"
+INVALID = "invalid credentials\n"
+E1 = "password must be at least 12 characters\n"
+E8 = "no password on standard input\n"
+E9 = "no new password on standard input\n"
+
+
+class ExplodingStream(io.StringIO):
+    """A standard-input stream that fails if it is read at all (FR-034)."""
+
+    def readline(self, *args, **kwargs):  # noqa: D102
+        raise AssertionError("this command must not read standard input")
+
+
+def register(run_cli, store_path: Path, username: str = "alice", password: str = PASSWORD):
+    return run_cli(["--store", str(store_path), "register", username], password + "\n")
+
+
+def passwd(run_cli, store_path: Path, lines: str, username: str = "alice"):
+    return run_cli(["--store", str(store_path), "passwd", username], lines)
+
+
+def login(run_cli, store_path: Path, password: str, username: str = "alice"):
+    return run_cli(["--store", str(store_path), "login", username], password + "\n")
+
+
+def account(read_store, store_path: Path, username: str = "alice") -> dict:
+    return read_store(store_path)["accounts"][username]
+
+
+# ------------------------------------------------------------------------------- FR-026
+
+
+def test_fr026_success_reads_two_lines_exits_0_and_prints_nothing(run_cli, store_path):
+    """FR-026: current password then new password; status 0 with both streams empty."""
+    register(run_cli, store_path)
+    status, out, err = passwd(run_cli, store_path, f"{PASSWORD}\n{NEW}\n")
+    assert status == 0
+    assert out == ""
+    assert err == ""
+
+
+def test_fr026_the_order_is_current_then_new(run_cli, store_path):
+    """FR-026: the first line is the current password, the second the new one."""
+    register(run_cli, store_path)
+    # Supplying them the wrong way round means the "current" password is wrong.
+    assert passwd(run_cli, store_path, f"{NEW}\n{PASSWORD}\n") == (1, "", INVALID)
+    assert login(run_cli, store_path, PASSWORD) == (0, "ok\n", "")
+
+
+def test_fr026_extra_lines_beyond_the_two_needed_are_ignored(run_cli, store_path):
+    """Contract "Standard-input protocol": passwd reads exactly two lines."""
+    register(run_cli, store_path)
+    status, out, err = passwd(run_cli, store_path, f"{PASSWORD}\n{NEW}\nextra\nmore\n")
+    assert (status, out, err) == (0, "", "")
+
+
+def test_fr026_a_new_password_equal_to_the_current_one_is_accepted(run_cli, store_path):
+    """FR-026 (spec assumption): there is no reuse rule."""
+    register(run_cli, store_path)
+    assert passwd(run_cli, store_path, f"{PASSWORD}\n{PASSWORD}\n") == (0, "", "")
+    assert login(run_cli, store_path, PASSWORD) == (0, "ok\n", "")
+
+
+def test_fr026_a_12_character_new_password_is_accepted(run_cli, store_path):
+    """FR-026 / FR-011: the new password is held to the same 12-character boundary."""
+    register(run_cli, store_path)
+    twelve = "b" * 12
+    assert passwd(run_cli, store_path, f"{PASSWORD}\n{twelve}\n") == (0, "", "")
+    assert login(run_cli, store_path, twelve) == (0, "ok\n", "")
+
+
+# ------------------------------------------------------------------------------- FR-027
+
+
+def test_fr027_a_wrong_current_password_exits_1_with_invalid_credentials(
+    run_cli, store_path
+):
+    """FR-027: exactly 'invalid credentials' on stderr, status 1."""
+    register(run_cli, store_path)
+    status, out, err = passwd(run_cli, store_path, f"wrong password!!\n{NEW}\n")
+    assert status == 1
+    assert out == ""
+    assert err == INVALID
+
+
+def test_fr027_a_wrong_current_password_leaves_the_stored_password_unchanged(
+    run_cli, store_path, read_store
+):
+    """FR-027: the stored password still works and the record is byte-identical."""
+    register(run_cli, store_path)
+    before = read_store(store_path)
+    passwd(run_cli, store_path, f"wrong password!!\n{NEW}\n")
+    assert read_store(store_path) == before
+    assert login(run_cli, store_path, PASSWORD) == (0, "ok\n", "")
+    assert login(run_cli, store_path, NEW) == (1, "", INVALID)
+
+
+# ------------------------------------------------------------------------------- FR-028
+
+
+def test_fr028_a_short_new_password_exits_2_with_e1(run_cli, store_path):
+    """FR-028: a new password shorter than 12 characters is a diagnostic and status 2."""
+    register(run_cli, store_path)
+    status, out, err = passwd(run_cli, store_path, f"{PASSWORD}\nshort\n")
+    assert status == 2
+    assert out == ""
+    assert err == E1
+
+
+def test_fr028_a_short_new_password_leaves_the_stored_password_unchanged(
+    run_cli, store_path, read_store
+):
+    """FR-028: the rejected change does not touch the store."""
+    register(run_cli, store_path)
+    before = read_store(store_path)
+    passwd(run_cli, store_path, f"{PASSWORD}\nshort\n")
+    assert read_store(store_path) == before
+    assert login(run_cli, store_path, PASSWORD) == (0, "ok\n", "")
+
+
+def test_fr028_an_empty_new_password_is_too_short(run_cli, store_path):
+    """FR-028 / FR-018: a blank second line is a supplied password of length 0."""
+    register(run_cli, store_path)
+    assert passwd(run_cli, store_path, f"{PASSWORD}\n\n") == (2, "", E1)
+
+
+def test_fr028_wrong_current_plus_short_new_exits_1_not_2(run_cli, store_path):
+    """FR-028: the length error is reported only after the current password is accepted.
+
+    This is the ordering consequence that matters: a status-2 reply can never confirm that
+    the current password was right.
+    """
+    register(run_cli, store_path)
+    status, out, err = passwd(run_cli, store_path, "wrong password!!\nshort\n")
+    assert status == 1
+    assert out == ""
+    assert err == INVALID
+
+
+def test_fr028_the_status_does_not_distinguish_a_right_from_a_wrong_current_password(
+    run_cli, store_path
+):
+    """FR-028: with a short new password, both answers are the credential answer or 2."""
+    register(run_cli, store_path)
+    wrong = passwd(run_cli, store_path, "wrong password!!\nshort\n")
+    right = passwd(run_cli, store_path, f"{PASSWORD}\nshort\n")
+    assert wrong == (1, "", INVALID)
+    assert right == (2, "", E1)
+    # The only way to get status 2 is to already hold the current password, so status 2
+    # never leaks anything the caller did not already know.
+    assert wrong[0] != right[0]
+
+
+# ------------------------------------------------------------------------------- FR-029
+
+
+def test_fr029_the_new_password_verifies_and_the_old_one_does_not(run_cli, store_path):
+    """FR-029: after a successful change, only the new password logs in."""
+    register(run_cli, store_path)
+    assert passwd(run_cli, store_path, f"{PASSWORD}\n{NEW}\n") == (0, "", "")
+    assert login(run_cli, store_path, NEW) == (0, "ok\n", "")
+    assert login(run_cli, store_path, PASSWORD) == (1, "", INVALID)
+
+
+def test_fr029_a_successful_change_regenerates_the_salt(run_cli, store_path, read_store):
+    """FR-029 / FR-036: a fresh salt is generated, so the stored verifier changes."""
+    register(run_cli, store_path)
+    before = account(read_store, store_path)
+    passwd(run_cli, store_path, f"{PASSWORD}\n{NEW}\n")
+    after = account(read_store, store_path)
+    assert after["salt"] != before["salt"]
+    assert after["verifier"] != before["verifier"]
+
+
+def test_fr029_changing_to_the_same_password_still_regenerates_the_salt(
+    run_cli, store_path, read_store
+):
+    """FR-029 / FR-036: the salt is regenerated on every successful change."""
+    register(run_cli, store_path)
+    before = account(read_store, store_path)
+    passwd(run_cli, store_path, f"{PASSWORD}\n{PASSWORD}\n")
+    after = account(read_store, store_path)
+    assert after["salt"] != before["salt"]
+    assert after["verifier"] != before["verifier"]
+
+
+def test_fr029_fr037_the_new_password_does_not_appear_in_the_store_bytes(
+    run_cli, store_path
+):
+    """FR-037 / SC-006: the replacement verifier is one-way too."""
+    register(run_cli, store_path)
+    passwd(run_cli, store_path, f"{PASSWORD}\n{NEW}\n")
+    raw = store_path.read_bytes()
+    assert NEW.encode("utf-8") not in raw
+    assert PASSWORD.encode("utf-8") not in raw
+
+
+def test_fr024_fr025_passwd_leaves_failed_logins_and_locked_untouched(
+    run_cli, store_path, read_store
+):
+    """FR-024 / FR-025: passwd neither reads nor writes the lock or the failure count."""
+    register(run_cli, store_path)
+    run_cli(["--store", str(store_path), "login", "alice"], "wrong password!!\n")
+    before = account(read_store, store_path)
+    assert before["failed_logins"] == 1
+
+    assert passwd(run_cli, store_path, f"{PASSWORD}\n{NEW}\n") == (0, "", "")
+    after = account(read_store, store_path)
+    assert after["failed_logins"] == before["failed_logins"]
+    assert after["locked"] == before["locked"]
+
+
+# ------------------------------------------------------------------------- FR-034 (E4)
+
+
+def test_fr034_a_missing_account_exits_3_with_e4(run_cli, store_path):
+    """FR-034 / E4: 'no such account: carol' on stderr with status 3."""
+    register(run_cli, store_path)
+    status, out, err = passwd(run_cli, store_path, f"{PASSWORD}\n{NEW}\n", username="carol")
+    assert status == 3
+    assert out == ""
+    assert err == "no such account: carol\n"
+
+
+def test_fr034_the_existence_check_precedes_any_standard_input_read(store_path, run_cli):
+    """FR-034: nothing is consumed from standard input for a missing account."""
+    from accounts import cli
+
+    register(run_cli, store_path)
+    out, err = io.StringIO(), io.StringIO()
+    status = cli.main(
+        ["--store", str(store_path), "passwd", "carol"], ExplodingStream(), out, err
+    )
+    assert status == 3
+    assert out.getvalue() == ""
+    assert err.getvalue() == "no such account: carol\n"
+
+
+def test_fr034_passwd_against_a_missing_store_exits_3_and_creates_no_file(
+    run_cli, store_path
+):
+    """FR-034 / FR-002: a missing store is an empty store."""
+    assert not store_path.exists()
+    assert passwd(run_cli, store_path, f"{PASSWORD}\n{NEW}\n") == (
+        3,
+        "",
+        "no such account: alice\n",
+    )
+    assert not store_path.exists()
+
+
+# ------------------------------------------------------------------- FR-018 (E8 and E9)
+
+
+def test_fr018_end_of_input_before_the_current_password_gives_e8(run_cli, store_path):
+    """FR-018 / E8: no input at all where the current password was required."""
+    register(run_cli, store_path)
+    status, out, err = passwd(run_cli, store_path, "")
+    assert (status, out, err) == (2, "", E8)
+
+
+def test_fr018_end_of_input_after_the_current_password_gives_e9(run_cli, store_path):
+    """FR-018 / E9: the second line is distinguished from the first by its own diagnostic."""
+    register(run_cli, store_path)
+    status, out, err = passwd(run_cli, store_path, f"{PASSWORD}\n")
+    assert status == 2
+    assert out == ""
+    assert err == E9
+
+
+def test_fr018_e9_is_reported_even_when_the_current_password_is_wrong(run_cli, store_path):
+    """FR-018: both passwords are read before either is judged (research.md R-07)."""
+    register(run_cli, store_path)
+    assert passwd(run_cli, store_path, "wrong password!!\n") == (2, "", E9)
+
+
+def test_fr018_a_missing_new_password_changes_nothing(run_cli, store_path, read_store):
+    """FR-006 / FR-018: an E9 failure leaves the store's account data unchanged."""
+    register(run_cli, store_path)
+    before = read_store(store_path)
+    passwd(run_cli, store_path, f"{PASSWORD}\n")
+    assert read_store(store_path) == before
+
+
+# ---------------------------------------------------------------------- FR-017 exactness
+
+
+def test_fr017_the_new_password_keeps_its_spaces_and_non_ascii_characters(
+    run_cli, store_path
+):
+    """FR-017: only the terminating newline is excluded from either line."""
+    register(run_cli, store_path)
+    replacement = "  pässwörd с пробелами  "
+    assert passwd(run_cli, store_path, f"{PASSWORD}\n{replacement}\n") == (0, "", "")
+    assert login(run_cli, store_path, replacement) == (0, "ok\n", "")
+    assert login(run_cli, store_path, replacement.strip()) == (1, "", INVALID)
