+++ b/tests/test_store.py
@@ -0,0 +1,336 @@
+"""The store file: FR-002, FR-006, FR-007, FR-008, FR-034, FR-038.
+
+The store's on-disk format is an internal decision (data-model.md), so these tests are the
+only ones that look inside it. They exercise ``accounts.store`` directly: strict loading
+(never defaulting around bad input, Principle II) and the atomic, owner-only save.
+"""
+
+from __future__ import annotations
+
+import base64
+import functools
+import json
+import os
+import stat
+from pathlib import Path
+
+import pytest
+
+from accounts import passwords, store
+
+
+@functools.lru_cache(maxsize=None)
+def _credential(password: str) -> tuple[str, str]:
+    """One salt and verifier per password, cached: these tests check the store's shape,
+    not the KDF, so paying for one PBKDF2 derivation per distinct password keeps the
+    module fast. FR-036's per-account salt distinctness is test_passwords.py's job."""
+    salt = passwords.new_salt()
+    return store.encode(salt), store.encode(passwords.derive(password, salt))
+
+
+def record(password: str = "a valid password", failed: int = 0, locked: bool = False) -> dict:
+    salt, verifier = _credential(password)
+    return {
+        "salt": salt,
+        "verifier": verifier,
+        "failed_logins": failed,
+        "locked": locked,
+    }
+
+
+def write_raw(path: Path, payload) -> None:
+    path.write_text(json.dumps(payload), encoding="utf-8")
+
+
+# --------------------------------------------------------------------------- FR-002
+
+
+def test_fr002_missing_path_loads_as_empty_and_creates_no_file(store_path: Path):
+    """FR-002: a store that does not exist is a store with no accounts; no file is created."""
+    assert store.load(store_path) == {}
+    assert not store_path.exists()
+
+
+def test_fr002_round_trip_preserves_every_record_field(store_path: Path):
+    """FR-002: accounts, verifiers, failed-login counts, and lock states all persist."""
+    accounts = {
+        "alice": record("correct horse battery", failed=3, locked=False),
+        "bob": record("a second password", failed=5, locked=True),
+    }
+    store.save(store_path, accounts)
+    assert store.load(store_path) == accounts
+
+
+def test_fr002_an_empty_accounts_object_is_a_valid_store(store_path: Path):
+    """FR-002: a store with no accounts is legal (e.g. after the last delete)."""
+    store.save(store_path, {})
+    assert store.load(store_path) == {}
+
+
+def test_fr034_existence_is_answerable_before_any_password_is_read(store_path: Path):
+    """FR-034: the store is loaded whole up front, so membership is known before any read.
+
+    The behavioural assertions for FR-034 (unlock/passwd/delete exiting 3 without consuming
+    standard input) live in test_lockout.py, test_passwd.py, and test_delete.py.
+    """
+    store.save(store_path, {"alice": record()})
+    accounts = store.load(store_path)
+    assert "alice" in accounts
+    assert "carol" not in accounts
+
+
+# --------------------------------------------------------------------------- FR-007
+
+
+def test_fr007_unparsable_bytes_raise_store_error_naming_the_path(store_path: Path):
+    """FR-007: bytes that are not JSON are an error, never an empty store."""
+    store_path.write_text("this is not a store\n", encoding="utf-8")
+    with pytest.raises(store.StoreError) as excinfo:
+        store.load(store_path)
+    assert str(store_path) in str(excinfo.value)
+
+
+def test_fr007_bytes_that_are_not_utf8_raise_store_error(store_path: Path):
+    """FR-007: a binary or mis-encoded file is a named error, not a traceback."""
+    store_path.write_bytes(b'{"version": 1, "accounts": {"\xff\xfe": {}}}')
+    with pytest.raises(store.StoreError) as excinfo:
+        store.load(store_path)
+    assert str(store_path) in str(excinfo.value)
+
+
+def test_fr007_top_level_not_an_object_raises(store_path: Path):
+    """FR-007 (rule 1): the top-level value must be a JSON object."""
+    for payload in ([], "store", 1, None, True):
+        write_raw(store_path, payload)
+        with pytest.raises(store.StoreError) as excinfo:
+            store.load(store_path)
+        assert str(store_path) in str(excinfo.value)
+
+
+def test_fr007_version_absent_or_wrong_raises(store_path: Path):
+    """FR-007 (rule 2): version must be present and equal to 1."""
+    for payload in (
+        {"accounts": {}},
+        {"version": 2, "accounts": {}},
+        {"version": "1", "accounts": {}},
+        {"version": None, "accounts": {}},
+        {"version": True, "accounts": {}},
+    ):
+        write_raw(store_path, payload)
+        with pytest.raises(store.StoreError) as excinfo:
+            store.load(store_path)
+        assert str(store_path) in str(excinfo.value)
+
+
+def test_fr007_accounts_absent_or_not_an_object_raises(store_path: Path):
+    """FR-007 (rule 3): accounts must be present and be an object."""
+    for payload in (
+        {"version": 1},
+        {"version": 1, "accounts": []},
+        {"version": 1, "accounts": "alice"},
+        {"version": 1, "accounts": None},
+    ):
+        write_raw(store_path, payload)
+        with pytest.raises(store.StoreError) as excinfo:
+            store.load(store_path)
+        assert str(store_path) in str(excinfo.value)
+
+
+def test_fr007_record_with_a_missing_key_raises(store_path: Path):
+    """FR-007 (rule 4): every record carries all four keys."""
+    for missing in ("salt", "verifier", "failed_logins", "locked"):
+        rec = record()
+        del rec[missing]
+        write_raw(store_path, {"version": 1, "accounts": {"alice": rec}})
+        with pytest.raises(store.StoreError) as excinfo:
+            store.load(store_path)
+        assert missing in str(excinfo.value)
+        assert str(store_path) in str(excinfo.value)
+
+
+def test_fr007_record_with_an_unknown_key_raises(store_path: Path):
+    """FR-007 (rule 4): an unknown key is loud, not silently ignored."""
+    rec = record()
+    rec["iterations"] = 1000
+    write_raw(store_path, {"version": 1, "accounts": {"alice": rec}})
+    with pytest.raises(store.StoreError) as excinfo:
+        store.load(store_path)
+    assert "iterations" in str(excinfo.value)
+
+
+def test_fr007_record_not_an_object_raises(store_path: Path):
+    """FR-007 (rule 4): a record must itself be an object."""
+    for bad in ([], "x", 3, None):
+        write_raw(store_path, {"version": 1, "accounts": {"alice": bad}})
+        with pytest.raises(store.StoreError):
+            store.load(store_path)
+
+
+def test_fr007_salt_and_verifier_must_be_strict_base64_of_the_right_length(store_path: Path):
+    """FR-007 (rule 5): salt decodes to 16 bytes, verifier to 32, strict base64 only."""
+    bad_values = [
+        "not base64 at all!",
+        "",
+        base64.b64encode(b"short").decode("ascii"),
+        base64.b64encode(b"x" * 64).decode("ascii"),
+        12,
+        None,
+    ]
+    for field in ("salt", "verifier"):
+        for bad in bad_values:
+            rec = record()
+            rec[field] = bad
+            write_raw(store_path, {"version": 1, "accounts": {"alice": rec}})
+            with pytest.raises(store.StoreError) as excinfo:
+                store.load(store_path)
+            assert field in str(excinfo.value)
+
+
+def test_fr007_salt_of_32_bytes_and_verifier_of_16_are_both_rejected(store_path: Path):
+    """FR-007 (rule 5): the two lengths are not interchangeable."""
+    rec = record()
+    rec["salt"], rec["verifier"] = rec["verifier"], rec["salt"]
+    write_raw(store_path, {"version": 1, "accounts": {"alice": rec}})
+    with pytest.raises(store.StoreError):
+        store.load(store_path)
+
+
+def test_fr007_failed_logins_must_be_a_non_negative_non_bool_int(store_path: Path):
+    """FR-007 (rule 6): JSON ``true`` is a Python int, so bool is excluded explicitly."""
+    for bad in (-1, 1.5, "3", None, True, False):
+        rec = record()
+        rec["failed_logins"] = bad
+        write_raw(store_path, {"version": 1, "accounts": {"alice": rec}})
+        with pytest.raises(store.StoreError) as excinfo:
+            store.load(store_path)
+        assert "failed_logins" in str(excinfo.value)
+
+
