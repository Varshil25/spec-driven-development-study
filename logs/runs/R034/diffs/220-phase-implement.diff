index 0000000..f732019
--- /dev/null
+++ b/tests/test_passwords.py
@@ -0,0 +1,95 @@
+"""Password transformation: FR-036 (one-way, per-account salt) and FR-037 (never disclosed).
+
+FR-036 is a property of ``accounts.passwords`` alone — a distinct random salt per account is
+what makes two accounts sharing a password hold different verifiers.
+"""
+
+from __future__ import annotations
+
+import base64
+
+from accounts import passwords
+
+
+def test_fr036_new_salt_is_16_random_bytes():
+    """FR-036: the salt is 16 random bytes, distinct on every call."""
+    salts = {passwords.new_salt() for _ in range(32)}
+    assert len(salts) == 32, "FR-036: salts must not repeat across accounts"
+    for salt in salts:
+        assert isinstance(salt, bytes)
+        assert len(salt) == passwords.SALT_BYTES == 16
+
+
+def test_fr036_derive_is_deterministic_for_a_given_password_and_salt():
+    """FR-036: verification works because derive() is a function of (password, salt)."""
+    salt = passwords.new_salt()
+    first = passwords.derive("correct horse battery", salt)
+    second = passwords.derive("correct horse battery", salt)
+    assert first == second
+    assert isinstance(first, bytes)
+    assert len(first) == passwords.KEY_BYTES == 32
+
+
+def test_fr036_same_password_different_salts_give_different_verifiers():
+    """FR-036: two accounts with the same password have different stored verifiers."""
+    password=[REDACTED:assigned_secret] password"
+    salt_one = passwords.new_salt()
+    salt_two = passwords.new_salt()
+    assert salt_one != salt_two
+    assert passwords.derive(password, salt_one) != passwords.derive(password, salt_two)
+
+
+def test_fr036_derive_distinguishes_different_passwords_under_one_salt():
+    """FR-036: a different password under the same salt derives a different verifier."""
+    salt = passwords.new_salt()
+    assert passwords.derive("a valid password", salt) != passwords.derive(
+        "a valid passwore", salt
+    )
+
+
+def test_fr036_verify_accepts_the_right_password_and_rejects_others():
+    """FR-036: verify() is true only for the password the verifier was derived from."""
+    salt = passwords.new_salt()
+    verifier = passwords.derive("correct horse battery", salt)
+    assert passwords.verify("correct horse battery", salt, verifier) is True
+    assert passwords.verify("wrong password!!", salt, verifier) is False
+    assert passwords.verify("correct horse batterY", salt, verifier) is False
+    assert passwords.verify("", salt, verifier) is False
+
+
+def test_fr036_verify_rejects_the_right_password_under_a_different_salt():
+    """FR-036: the salt is part of the verifier; it is not interchangeable."""
+    salt = passwords.new_salt()
+    verifier = passwords.derive("correct horse battery", salt)
+    assert passwords.verify("correct horse battery", passwords.new_salt(), verifier) is False
+
+
+def test_fr037_password_bytes_do_not_appear_in_the_verifier():
+    """FR-037: the transformation is one-way; the password is not readable back out."""
+    password = "correct horse battery"
+    salt = passwords.new_salt()
+    verifier = passwords.derive(password, salt)
+    assert password.encode("utf-8") not in verifier
+    assert password.encode("utf-8") not in salt
+    assert password.encode("utf-8") not in base64.b64encode(verifier)
+    assert password.encode("utf-8") not in base64.b64encode(salt)
+    # Not even a 4-character window of the password survives into the verifier.
+    for i in range(len(password) - 3):
+        assert password[i : i + 4].encode("utf-8") not in verifier
+
+
+def test_fr037_non_ascii_and_whitespace_passwords_round_trip_through_verify():
+    """FR-037 / FR-017: encoding happens inside passwords.py and is lossless."""
+    salt = passwords.new_salt()
+    for password in ("  leading and trailing  ", "pässwörd-с-юникодом", "tab\tseparated x"):
+        verifier = passwords.derive(password, salt)
+        assert passwords.verify(password, salt, verifier) is True
+        assert password.encode("utf-8") not in verifier
+
+
+def test_algorithm_parameters_are_module_constants():
+    """Principle IV: the KDF parameters are constants, not options or stored fields."""
+    assert passwords.ALGORITHM == "sha256"
+    assert passwords.ITERATIONS == 600_000
+    assert passwords.SALT_BYTES == 16
+    assert passwords.KEY_BYTES == 32
