new file mode 100644
index 0000000..ab55580
--- /dev/null
+++ b/tests/test_lockout.py
@@ -0,0 +1,388 @@
+"""Lockout and recovery: FR-019 - FR-025, SC-004.
+
+Scope note (T020): FR-024 and FR-025 are properties of ``passwd`` and ``delete`` — that a
+failed one never touches the failure counter, and that a locked account still accepts both
+with the correct password. They are tested here, in the file that owns the lock state, and
+they therefore go green at the User Story 3 and User Story 4 checkpoints rather than at
+this one. The choice is deliberate: keeping every assertion about ``locked`` and
+``failed_logins`` in one module is what makes FR-023's "only unlock clears a lock, only
+login sets one" reviewable in a single place.
+"""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+PASSWORD = "correct horse battery"
+WRONG = "nope nope nope"
+INVALID = "invalid credentials\n"
+LOCKED = "account locked\n"
+
+
+def register(run_cli, store_path: Path, username: str = "alice", password: str = PASSWORD):
+    return run_cli(["--store", str(store_path), "register", username], password + "\n")
+
+
+def login(run_cli, store_path: Path, password: str = PASSWORD, username: str = "alice"):
+    return run_cli(["--store", str(store_path), "login", username], password + "\n")
+
+
+def unlock(run_cli, store_path: Path, username: str = "alice"):
+    return run_cli(["--store", str(store_path), "unlock", username], "")
+
+
+def account(read_store, store_path: Path, username: str = "alice") -> dict:
+    return read_store(store_path)["accounts"][username]
+
+
+class ExplodingStream(io.StringIO):
+    """A standard-input stream that fails if it is read at all (FR-022, FR-034)."""
+
+    def readline(self, *args, **kwargs):  # noqa: D102
+        raise AssertionError("this command must not read standard input")
+
+    def read(self, *args, **kwargs):  # noqa: D102
+        raise AssertionError("this command must not read standard input")
+
+
+# ------------------------------------------------------------------------------- FR-019
+
+
+def test_fr019_each_failed_login_increments_the_count(run_cli, store_path, read_store):
+    """FR-019: each failed login increases the recorded failed-login count by one."""
+    register(run_cli, store_path)
+    for expected in (1, 2, 3, 4):
+        assert login(run_cli, store_path, WRONG) == (1, "", INVALID)
+        assert account(read_store, store_path)["failed_logins"] == expected
+        assert account(read_store, store_path)["locked"] is False
+
+
+def test_sc004_four_failures_then_the_correct_password_succeeds(
+    run_cli, store_path, read_store
+):
+    """SC-004: four wrong passwords followed by the correct one succeeds."""
+    register(run_cli, store_path)
+    for _ in range(4):
+        assert login(run_cli, store_path, WRONG) == (1, "", INVALID)
+    assert account(read_store, store_path)["locked"] is False
+    assert login(run_cli, store_path) == (0, "ok\n", "")
+    assert account(read_store, store_path)["failed_logins"] == 0
+
+
+def test_fr019_the_fifth_consecutive_failure_locks_but_still_reports_credentials(
+    run_cli, store_path, read_store
+):
+    """FR-019 / SC-004: the fifth attempt itself exits 1, not 4; the account is now locked."""
+    register(run_cli, store_path)
+    for _ in range(4):
+        login(run_cli, store_path, WRONG)
+    status, out, err = login(run_cli, store_path, WRONG)
+    assert (status, out, err) == (1, "", INVALID)
+    record = account(read_store, store_path)
+    assert record["failed_logins"] == 5
+    assert record["locked"] is True
+
+
+def test_fr019_the_count_must_be_consecutive(run_cli, store_path, read_store):
+    """FR-019 / FR-021: a success in the middle means five more failures are needed."""
+    register(run_cli, store_path)
+    for _ in range(4):
+        login(run_cli, store_path, WRONG)
+    login(run_cli, store_path)
+    for _ in range(4):
+        login(run_cli, store_path, WRONG)
+    assert account(read_store, store_path)["locked"] is False
+    assert login(run_cli, store_path) == (0, "ok\n", "")
+
+
+# ------------------------------------------------------------------------------- FR-020
+
+
+def lock_account(run_cli, store_path: Path) -> None:
+    register(run_cli, store_path)
+    for _ in range(5):
+        login(run_cli, store_path, WRONG)
+
+
+def test_fr020_a_locked_account_reports_the_lock_for_the_correct_password(
+    run_cli, store_path
+):
+    """FR-020 / SC-004: the sixth attempt with the correct password exits 4, never 'ok'."""
+    lock_account(run_cli, store_path)
+    status, out, err = login(run_cli, store_path)
+    assert status == 4
+    assert out == ""
+    assert err == LOCKED
+
+
+def test_fr020_a_locked_account_reports_the_lock_for_a_wrong_password_too(
+    run_cli, store_path
+):
+    """FR-020: the same answer whether or not the password is correct."""
+    lock_account(run_cli, store_path)
+    assert login(run_cli, store_path, WRONG) == (4, "", LOCKED)
+
+
+def test_sc003_a_locked_account_never_produces_the_success_output(run_cli, store_path):
+    """SC-003 / FR-020: no login against a locked account exits 0 or writes 'ok'."""
+    lock_account(run_cli, store_path)
+    for password in (PASSWORD, WRONG, "", "another wrong one"):
+        status, out, _ = login(run_cli, store_path, password)
+        assert status == 4
+        assert "ok" not in out
+
+
+def test_fr020_a_locked_account_does_not_keep_counting_failures(
+    run_cli, store_path, read_store
+):
+    """FR-020: the lock gate precedes verification, so nothing further is counted."""
+    lock_account(run_cli, store_path)
+    assert account(read_store, store_path)["failed_logins"] == 5
+    login(run_cli, store_path, WRONG)
+    login(run_cli, store_path, WRONG)
+    assert account(read_store, store_path)["failed_logins"] == 5
+
+
+def test_fr020_the_lock_gate_precedes_the_standard_input_read(run_cli, store_path):
+    """FR-020: a locked account exits 4 even with no password supplied at all."""
+    lock_account(run_cli, store_path)
+    status, out, err = run_cli(["--store", str(store_path), "login", "alice"], "")
+    assert (status, out, err) == (4, "", LOCKED)
+
+
+# ------------------------------------------------------------------------------- FR-021
+
+
+def test_fr021_a_successful_login_resets_the_count(run_cli, store_path, read_store):
+    """FR-021: a successful login resets the failed-login count to zero."""
+    register(run_cli, store_path)
+    for _ in range(3):
+        login(run_cli, store_path, WRONG)
+    assert account(read_store, store_path)["failed_logins"] == 3
+    login(run_cli, store_path)
+    assert account(read_store, store_path)["failed_logins"] == 0
+
+
+# ------------------------------------------------------------------------------- FR-022
+
+
+def test_fr022_unlock_clears_the_lock_zeroes_the_count_and_exits_0(
+    run_cli, store_path, read_store
+):
+    """FR-022: unlock exits 0 with empty stdout, clears the lock, and zeroes the count."""
+    lock_account(run_cli, store_path)
+    status, out, err = unlock(run_cli, store_path)
+    assert status == 0
+    assert out == ""
+    assert err == ""
+    record = account(read_store, store_path)
+    assert record["locked"] is False
+    assert record["failed_logins"] == 0
+
+
+def test_fr022_unlock_restores_login(run_cli, store_path):
+    """FR-022 / SC-004: after unlock the correct password logs in again."""
+    lock_account(run_cli, store_path)
+    assert login(run_cli, store_path) == (4, "", LOCKED)
+    assert unlock(run_cli, store_path)[0] == 0
+    assert login(run_cli, store_path) == (0, "ok\n", "")
+
+
+def test_fr022_unlock_on_an_account_that_is_not_locked_also_exits_0(
+    run_cli, store_path, read_store
+):
+    """FR-022: unlocking an unlocked account exits 0 and leaves it usable."""
+    register(run_cli, store_path)
+    login(run_cli, store_path, WRONG)
+    status, out, err = unlock(run_cli, store_path)
+    assert (status, out, err) == (0, "", "")
+    record = account(read_store, store_path)
+    assert record["locked"] is False
+    assert record["failed_logins"] == 0
+    assert login(run_cli, store_path) == (0, "ok\n", "")
+
+
+def test_fr022_unlock_reads_nothing_from_standard_input(store_path, run_cli):
+    """FR-022: unlock takes no password; a stream that raises on read still succeeds."""
+    from accounts import cli
+
+    lock_account(run_cli, store_path)
+    out, err = io.StringIO(), io.StringIO()
+    status = cli.main(["--store", str(store_path), "unlock", "alice"], ExplodingStream(), out, err)
+    assert status == 0
+    assert out.getvalue() == ""
+    assert err.getvalue() == ""
+
+
+def test_fr022_unlock_ignores_any_input_it_is_given(run_cli, store_path):
+    """FR-022: extra standard input is simply never read."""
+    lock_account(run_cli, store_path)
+    status, out, err = run_cli(
+        ["--store", str(store_path), "unlock", "alice"], "something\nelse\n"
+    )
+    assert (status, out, err) == (0, "", "")
+
+
+# ------------------------------------------------------------------------- FR-034 (E4)
+
+
+def test_fr034_unlock_for_a_missing_account_exits_3(run_cli, store_path):
+    """FR-034 / E4: 'no such account: carol' on stderr with status 3."""
+    register(run_cli, store_path)
+    status, out, err = unlock(run_cli, store_path, username="carol")
+    assert status == 3
+    assert out == ""
+    assert err == "no such account: carol\n"
+
+
+def test_fr034_unlock_checks_existence_before_reading_standard_input(store_path, run_cli):
+    """FR-034: the existence check precedes any read, so nothing is consumed."""
+    from accounts import cli
+
+    register(run_cli, store_path)
+    out, err = io.StringIO(), io.StringIO()
+    status = cli.main(
+        ["--store", str(store_path), "unlock", "carol"], ExplodingStream(), out, err
+    )
+    assert status == 3
+    assert out.getvalue() == ""
+    assert err.getvalue() == "no such account: carol\n"
+
+
+def test_fr034_unlock_against_a_missing_store_exits_3(run_cli, store_path):
+    """FR-034 / FR-002: a missing store is an empty store; no file is created."""
+    assert not store_path.exists()
+    status, out, err = unlock(run_cli, store_path)
+    assert (status, out, err) == (3, "", "no such account: alice\n")
+    assert not store_path.exists()
+
+
+def test_fr034_a_failed_unlock_changes_nothing(run_cli, store_path, read_store):
+    """FR-006 / FR-034: a non-zero unlock leaves the store's account data unchanged."""
+    lock_account(run_cli, store_path)
+    before = read_store(store_path)
+    unlock(run_cli, store_path, username="carol")
+    assert read_store(store_path) == before
+
+
+# ------------------------------------------------------------------------------- FR-023
+
+
+def test_fr023_no_command_other_than_login_sets_a_lock(run_cli, store_path, read_store):
+    """FR-023: register, unlock, passwd, and delete never set the lock."""
+    register(run_cli, store_path)
+    register(run_cli, store_path, username="bob", password="a second password")
+    for _ in range(6):
+        run_cli(["--store", str(store_path), "passwd", "bob"], WRONG + "\nanother long one\n")
+        run_cli(["--store", str(store_path), "delete", "bob"], WRONG + "\n")
+        unlock(run_cli, store_path, username="bob")
+    record = account(read_store, store_path, "bob")
+    assert record["locked"] is False
+    assert record["failed_logins"] == 0
+
+
+def test_fr023_only_unlock_clears_a_lock(run_cli, store_path, read_store):
+    """FR-023: a successful passwd on a locked account does not clear the lock."""
+    lock_account(run_cli, store_path)
+    status, _, _ = run_cli(
+        ["--store", str(store_path), "passwd", "alice"], PASSWORD + "\na new long secret\n"
+    )
+    assert status == 0
+    assert account(read_store, store_path)["locked"] is True
+    assert login(run_cli, store_path, "a new long secret") == (4, "", LOCKED)
+
+    assert unlock(run_cli, store_path)[0] == 0
+    assert login(run_cli, store_path, "a new long secret") == (0, "ok\n", "")
+
+
+def test_fr023_a_register_of_another_account_does_not_clear_a_lock(
+    run_cli, store_path, read_store
+):
+    """FR-023: registering a second account leaves the first one's lock in place."""
+    lock_account(run_cli, store_path)
+    register(run_cli, store_path, username="bob", password="a second password")
+    assert account(read_store, store_path)["locked"] is True
+
+
+# ------------------------------------------------------------- FR-024 (needs US3 / US4)
+
+
+def test_fr024_a_failed_passwd_does_not_count_against_the_login_counter(
+    run_cli, store_path, read_store
+):
+    """FR-024: a failed password change never changes the failed-login count."""
+    register(run_cli, store_path)
+    login(run_cli, store_path, WRONG)
+    assert account(read_store, store_path)["failed_logins"] == 1
+    for _ in range(8):
+        status, _, err = run_cli(
+            ["--store", str(store_path), "passwd", "alice"], WRONG + "\na new long secret\n"
+        )
+        assert (status, err) == (1, INVALID)
+    record = account(read_store, store_path)
+    assert record["failed_logins"] == 1
+    assert record["locked"] is False
+
+
+def test_fr024_a_failed_delete_does_not_count_against_the_login_counter(
+    run_cli, store_path, read_store
+):
+    """FR-024: a failed delete never changes the failed-login count or locks the account."""
+    register(run_cli, store_path)
+    for _ in range(8):
+        status, _, err = run_cli(["--store", str(store_path), "delete", "alice"], WRONG + "\n")
+        assert (status, err) == (1, INVALID)
+    record = account(read_store, store_path)
+    assert record["failed_logins"] == 0
+    assert record["locked"] is False
+    assert login(run_cli, store_path) == (0, "ok\n", "")
+
+
+def test_fr024_a_successful_passwd_leaves_the_counter_untouched(
+    run_cli, store_path, read_store
+):
+    """FR-024: passwd does not reset the failed-login count either; only login and unlock do."""
+    register(run_cli, store_path)
+    login(run_cli, store_path, WRONG)
+    login(run_cli, store_path, WRONG)
+    assert account(read_store, store_path)["failed_logins"] == 2
+    status, _, _ = run_cli(
+        ["--store", str(store_path), "passwd", "alice"], PASSWORD + "\na new long secret\n"
+    )
+    assert status == 0
+    assert account(read_store, store_path)["failed_logins"] == 2
+
+
+# ------------------------------------------------------------- FR-025 (needs US3 / US4)
+
+
+def test_fr025_a_locked_account_still_accepts_a_password_change(run_cli, store_path):
+    """FR-025: passwd works on a locked account given the correct current password."""
+    lock_account(run_cli, store_path)
+    status, out, err = run_cli(
+        ["--store", str(store_path), "passwd", "alice"], PASSWORD + "\na new long secret\n"
+    )
+    assert (status, out, err) == (0, "", "")
+    unlock(run_cli, store_path)
+    assert login(run_cli, store_path, "a new long secret") == (0, "ok\n", "")
+
+
+def test_fr025_a_locked_account_still_accepts_a_delete(run_cli, store_path, read_store):
+    """FR-025: delete works on a locked account given the correct password."""
+    lock_account(run_cli, store_path)
+    status, out, err = run_cli(["--store", str(store_path), "delete", "alice"], PASSWORD + "\n")
+    assert (status, out, err) == (0, "", "")
+    assert "alice" not in read_store(store_path)["accounts"]
+
+
+def test_fr025_a_locked_account_rejects_a_passwd_with_the_wrong_password(
+    run_cli, store_path, read_store
+):
+    """FR-025: the lock does not substitute for the credential check."""
+    lock_account(run_cli, store_path)
+    status, out, err = run_cli(
+        ["--store", str(store_path), "passwd", "alice"], WRONG + "\na new long secret\n"
+    )
+    assert (status, out, err) == (1, "", INVALID)
+    assert account(read_store, store_path)["locked"] is True
