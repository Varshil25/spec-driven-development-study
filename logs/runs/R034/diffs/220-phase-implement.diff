+++ b/tests/test_login.py
@@ -0,0 +1,235 @@
+"""Login: FR-014 - FR-018 (plus FR-006's "a failed login persists its count")."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+PASSWORD = "correct horse battery"
+INVALID = "invalid credentials\n"
+E8 = "no password on standard input\n"
+
+
+def register(run_cli, store_path: Path, username: str = "alice", password: str = PASSWORD):
+    return run_cli(["--store", str(store_path), "register", username], password + "\n")
+
+
+def login(run_cli, store_path: Path, username: str = "alice", password: str | None = PASSWORD):
+    argv = ["--store", str(store_path), "login", username]
+    return run_cli(argv, "" if password is None else password + "\n")
+
+
+# ------------------------------------------------------------------------------- FR-014
+
+
+def test_fr014_correct_password_on_an_unlocked_account_writes_ok_and_exits_0(
+    run_cli, store_path
+):
+    """FR-014: exactly 'ok' on stdout, status 0, stderr empty."""
+    register(run_cli, store_path)
+    status, out, err = login(run_cli, store_path)
+    assert status == 0
+    assert out == "ok\n"
+    assert err == ""
+
+
+# ------------------------------------------------------------------------------- FR-015
+
+
+def test_fr015_a_wrong_password_writes_invalid_credentials_and_exits_1(run_cli, store_path):
+    """FR-015: exactly 'invalid credentials' on stderr, status 1, stdout empty."""
+    register(run_cli, store_path)
+    status, out, err = login(run_cli, store_path, password="wrong password!!")
+    assert status == 1
+    assert out == ""
+    assert err == INVALID
+
+
+def test_fr015_a_wrong_password_does_not_change_the_stored_credential(run_cli, store_path):
+    """FR-015: a rejected login leaves the password itself untouched."""
+    register(run_cli, store_path)
+    login(run_cli, store_path, password="wrong password!!")
+    status, out, _ = login(run_cli, store_path)
+    assert (status, out) == (0, "ok\n")
+
+
+# ------------------------------------------------------------------------------- FR-016
+
+
+def test_fr016_an_unknown_username_is_indistinguishable_from_a_wrong_password(
+    run_cli, store_path
+):
+    """FR-016: an absent account gives the identical message and status, revealing nothing."""
+    register(run_cli, store_path)
+    absent = login(run_cli, store_path, username="carol")
+    wrong = login(run_cli, store_path, password="wrong password!!")
+    assert absent == wrong == (1, "", INVALID)
+
+
+def test_fr016_a_badly_formatted_username_is_simply_absent_on_login(run_cli, store_path):
+    """FR-016: login does not apply the register-time username rule; it just does not exist."""
+    register(run_cli, store_path)
+    for username in ("ab", "bad-name", "éé1", "u" * 40, ""):
+        status, out, err = login(run_cli, store_path, username=username)
+        assert (status, out, err) == (1, "", INVALID), username
+
+
+def test_fr016_login_against_a_missing_store_exits_1(run_cli, store_path):
+    """FR-016 / FR-002: a missing store is an empty store, so every account is absent."""
+    assert not store_path.exists()
+    status, out, err = login(run_cli, store_path)
+    assert (status, out, err) == (1, "", INVALID)
+    assert not store_path.exists(), "a failed login must not create the store"
+
+
+def test_fr016_an_unknown_username_is_not_recorded_in_the_store(
+    run_cli, store_path, read_store
+):
+    """FR-016: a login for an absent account creates nothing to leak its absence."""
+    register(run_cli, store_path)
+    before = read_store(store_path)
+    login(run_cli, store_path, username="carol")
+    assert read_store(store_path) == before
+
+
+# ------------------------------------------------------------------------------- FR-017
+
+EXACTNESS_CASES = [
+    ("correct horse battery", "Correct horse battery"),
+    ("correct horse battery", "correct horse batter"),
+    ("correct horse battery", "correct  horse battery"),
+    ("  leading and trailing  ", "leading and trailing"),
+    ("  leading and trailing  ", " leading and trailing "),
+    ("pässwörd-с-юникодом", "passwörd-с-юникодом"),
+    ("tab\tin the middle", "tab in the middle"),
+]
+
+
+@pytest.mark.parametrize(
+    "stored,attempt",
+    EXACTNESS_CASES,
+    ids=[f"case{i}" for i in range(len(EXACTNESS_CASES))],
+)
+def test_fr017_comparison_is_exact_over_the_full_password(
+    run_cli, store_path, stored, attempt
+):
+    """FR-017: case, spaces, and non-ASCII characters are all significant."""
+    register(run_cli, store_path, password=stored)
+    assert login(run_cli, store_path, password=stored) == (0, "ok\n", "")
+    assert login(run_cli, store_path, password=attempt) == (1, "", INVALID)
+
+
+def test_fr017_only_the_terminating_newline_is_excluded(run_cli, store_path):
+    """FR-017: one trailing newline is removed; a second one is part of nothing read."""
+    password = "a valid password"
+    run_cli(["--store", str(store_path), "register", "alice"], password + "\n")
+    # No trailing newline at all: the line still reads as the whole password.
+    assert run_cli(["--store", str(store_path), "login", "alice"], password) == (
+        0,
+        "ok\n",
+        "",
+    )
+    # A carriage return is part of the password, not part of the line terminator.
+    assert run_cli(["--store", str(store_path), "login", "alice"], password + "\r\n") == (
+        1,
+        "",
+        INVALID,
+    )
+
+
+def test_fr017_a_trailing_newline_is_not_part_of_the_stored_password(run_cli, store_path):
+    """FR-017: register and login strip the terminator identically."""
+    password = "a valid password"
+    run_cli(["--store", str(store_path), "register", "alice"], password)
+    assert run_cli(["--store", str(store_path), "login", "alice"], password + "\n") == (
+        0,
+        "ok\n",
+        "",
+    )
+
+
+def test_fr017_extra_lines_beyond_the_one_needed_are_ignored(run_cli, store_path):
+    """Contract "Standard-input protocol": login reads exactly one line."""
+    register(run_cli, store_path)
+    status, out, err = run_cli(
+        ["--store", str(store_path), "login", "alice"],
+        PASSWORD + "\nextra line\nand another\n",
+    )
+    assert (status, out, err) == (0, "ok\n", "")
+
+
+# ------------------------------------------------------------------------------- FR-018
+
+
+def test_fr018_end_of_input_gives_e8_and_status_2(run_cli, store_path):
+    """FR-018: a missing password is an error, not an empty password."""
+    register(run_cli, store_path)
+    status, out, err = login(run_cli, store_path, password=None)
+    assert (status, out, err) == (2, "", E8)
+
+
+def test_fr018_a_blank_line_is_an_empty_password_and_fails_as_a_credential(
+    run_cli, store_path
+):
+    """FR-018: a supplied blank line is distinguishable from end of input."""
+    register(run_cli, store_path)
+    status, out, err = login(run_cli, store_path, password="")
+    assert (status, out, err) == (1, "", INVALID)
+
+
+def test_fr018_end_of_input_is_reported_before_the_credential_is_judged(
+    run_cli, store_path
+):
+    """FR-018: E8 wins over 'invalid credentials' for an existing account."""
+    register(run_cli, store_path)
+    assert login(run_cli, store_path, password=None)[0] == 2
+    # For an absent account the absence is reported first (FR-016 order, research.md R-07).
+    assert login(run_cli, store_path, username="carol", password=None) == (1, "", INVALID)
+
+
+# ---------------------------------------------------------------------- FR-006, FR-021
+
+
+def test_fr006_a_failed_login_persists_its_incremented_count(
+    run_cli, store_path, read_store
+):
+    """FR-006: a non-zero exit normally changes nothing — a failed login is the exception."""
+    register(run_cli, store_path)
+    assert read_store(store_path)["accounts"]["alice"]["failed_logins"] == 0
+    for expected in (1, 2, 3):
+        login(run_cli, store_path, password="wrong password!!")
+        assert read_store(store_path)["accounts"]["alice"]["failed_logins"] == expected
+
+
+def test_fr021_a_successful_login_resets_the_count_to_zero(run_cli, store_path, read_store):
+    """FR-021: a successful login resets the failed-login count."""
+    register(run_cli, store_path)
+    login(run_cli, store_path, password="wrong password!!")
+    login(run_cli, store_path, password="wrong password!!")
+    assert read_store(store_path)["accounts"]["alice"]["failed_logins"] == 2
+    assert login(run_cli, store_path) == (0, "ok\n", "")
+    assert read_store(store_path)["accounts"]["alice"]["failed_logins"] == 0
+
+
+def test_fr006_a_login_with_no_password_on_stdin_changes_nothing(
+    run_cli, store_path, read_store
+):
+    """FR-006: an E8 failure is not a failed credential, so it persists nothing."""
+    register(run_cli, store_path)
+    before = read_store(store_path)
+    login(run_cli, store_path, password=None)
+    assert read_store(store_path) == before
+
+
+def test_fr037_login_diagnostics_contain_no_secret(run_cli, store_path):
+    """FR-037: neither the attempted password nor the stored verifier is echoed."""
+    register(run_cli, store_path)
+    attempt = "a unique wrong secret"
+    _, out, err = login(run_cli, store_path, password=attempt)
+    assert attempt not in out and attempt not in err
+    assert PASSWORD not in out and PASSWORD not in err
+    record = json.loads(store_path.read_text(encoding="utf-8"))["accounts"]["alice"]
+    assert record["verifier"] not in err and record["salt"] not in err
+    assert err == INVALID
