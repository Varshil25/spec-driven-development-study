+def test_fr008_a_failed_save_leaves_the_prior_contents_intact(
+    store_path: Path, monkeypatch: pytest.MonkeyPatch
+):
+    """FR-008: either the change is fully applied or the previous store survives.
+
+    The failure is injected at the final ``os.replace``, which is the latest possible
+    moment: an implementation that wrote the store path in place would already have
+    truncated the previous contents by the time this raises.
+    """
+    first = {"alice": record("correct horse battery")}
+    store.save(store_path, first)
+    before = store_path.read_bytes()
+
+    def exploding_replace(src, dst):
+        raise OSError(28, "No space left on device")
+
+    monkeypatch.setattr(store.os, "replace", exploding_replace)
+    with pytest.raises(store.StoreError) as excinfo:
+        store.save(store_path, {"alice": record(), "bob": record()})
+    assert str(store_path) in str(excinfo.value)
+    assert store_path.read_bytes() == before
+    monkeypatch.undo()
+    assert store.load(store_path) == first
+    assert [p.name for p in store_path.parent.iterdir()] == [store_path.name]
+
+
+def test_fr008_a_store_path_that_is_a_directory_cannot_be_written(tmp_path: Path):
+    """FR-008 / "unusable store path": an unwritable target is loud, not partial."""
