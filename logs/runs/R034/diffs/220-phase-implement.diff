new file mode 100644
index 0000000..12f3739
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,20 @@
+[project]
+name = "accounts"
+version = "1.0.0"
+description = "Local account manager: a single-process CLI over one JSON account store"
+# The minimum supported Python version is stated here and nowhere else in the repository
+# (Constitution: Additional Constraints -> Language).
+requires-python = ">=3.11"
+# Runtime dependency manifest MUST remain empty (Constitution Principle I).
+dependencies = []
+
+# Development-only tooling, declared separately so the exemption cannot leak into the
+# shipped runtime (Constitution Principle I).
+[project.optional-dependencies]
+dev = ["pytest"]
+
+[tool.pytest.ini_options]
+# Puts src/ on the import path so a bare `pytest` from the repository root works with no
+# environment setup (Constitution: Additional Constraints -> Test framework).
+pythonpath = ["src"]
+testpaths = ["tests"]
