+"""The process-facing shell: argv, the three streams, and the exit status.
+
+This is the only module that reads arguments, writes a stream, or produces an exit status,
+which is what makes the "diagnostics never on stdout" gate (FR-004) checkable in one file.
+Streams are injected rather than taken from ``sys``, so tests observe them directly
+(research.md R-08); argparse's own output is redirected onto the injected streams so its
+native usage-on-stderr, exit-2 behaviour satisfies FR-035 unchanged (research.md R-03).
+"""
+
+from __future__ import annotations
+
+import argparse
+import contextlib
+from typing import TextIO
+
+from . import commands, store
+
+COMMANDS = ("register", "login", "unlock", "passwd", "delete")
+
+
+def main(argv: list[str], stdin: TextIO, stdout: TextIO, stderr: TextIO) -> int:
+    """Run one command. Returns the process exit status (FR-005: only 0-4)."""
+    parser = argparse.ArgumentParser(
+        prog="python -m accounts",
+        description="Manage local accounts in a single JSON store file.",
+    )
+    parser.add_argument("--store", required=True, metavar="PATH", help="the store file")
+    parser.add_argument("command", choices=COMMANDS, help="the operation to perform")
+    parser.add_argument("username", help="the account to act on")
+
+    # argparse signals usage failures (and --help) by raising SystemExit after printing to
+    # sys.stdout/sys.stderr; redirecting both keeps that output on the injected streams and
+    # turns the exit into an observable status (FR-035, E13).
+    try:
+        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return exc.code if isinstance(exc.code, int) else 2
+
+    try:
+        accounts = store.load(args.store)
+    except store.StoreError as exc:
+        stderr.write(f"{exc}\n")
+        return 2
+
+    result = _dispatch(args.command, accounts, args.username, stdin)
+
+    if result.save:
+        try:
+            store.save(args.store, accounts)
+        except store.StoreError as exc:
+            stderr.write(f"{exc}\n")
+            return 2
+
+    stdout.write(result.out)
+    stderr.write(result.err)
+    return result.code
+
+
+def _dispatch(
+    name: str, accounts: dict[str, dict], username: str, stdin: TextIO
+) -> commands.Result:
+    """Read exactly the passwords this command needs, then run it.
+
+    The number of lines read per command is fixed by the contract's standard-input
+    protocol; nothing beyond them is read, so extra input is ignored. ``None`` is passed
+    through on end of input so ``commands`` owns the diagnostic (FR-018).
+
+    ``name`` is constrained by argparse's ``choices`` to exactly the five commands below,
+    so the last branch is unconditional: there is no fallback to fall through to, and no
+    path that could return ``None`` to a caller expecting a ``Result``.
+    """
+    if name == "register":
+        return commands.register(accounts, username, _read_password(stdin))
+    if name == "login":
+        return commands.login(accounts, username, _read_password(stdin))
+    if name == "unlock":
+        # Zero reads: the existence check inside the command runs before any input could
+        # be consumed (FR-022, FR-034).
+        return commands.unlock(accounts, username)
+    if name == "passwd":
+        # Two reads, current then new, but only after the command has confirmed the
+        # account exists (FR-034) — which is why the existence check lives in a short
+        # pre-pass here rather than being reached after the reads.
+        if username not in accounts:
+            return commands.passwd(accounts, username, None, None)
+        current = _read_password(stdin)
+        new = _read_password(stdin)
+        return commands.passwd(accounts, username, current, new)
+    # delete, the remaining choice: one read, and only after the existence check.
+    if username not in accounts:
+        return commands.delete(accounts, username, None)
+    return commands.delete(accounts, username, _read_password(stdin))
+
+
+def _read_password(stream: TextIO) -> str | None:
+    """Read one password line, or ``None`` at end of input.
+
+    End of input is never an empty password (FR-018). Exactly one trailing newline is
+    removed; every other character is preserved, including leading and trailing spaces,
+    carriage returns, and non-ASCII characters (FR-017, research.md R-06).
+    """
+    line = stream.readline()
+    if line == "":
+        return None
+    return line[:-1] if line.endswith("\n") else line
