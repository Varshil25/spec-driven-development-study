+    target.mkdir()
+    with pytest.raises(store.StoreError) as excinfo:
+        store.save(target, {"alice": record()})
+    assert str(target) in str(excinfo.value)
+    assert target.is_dir()
+    assert list(target.iterdir()) == []
+
