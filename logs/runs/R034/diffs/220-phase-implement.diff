+++ b/tests/test_performance.py
@@ -0,0 +1,88 @@
+"""SC-007: each command completes in under 1 second on a store of 1,000 accounts.
+
+The store is built by constructing records directly rather than by running 1,000
+registrations: the criterion is about the cost of *one* command against a large store, and
+1,000 real registrations would be 1,000 PBKDF2 derivations of setup for no extra signal.
+
+Budget (research.md R-02, plan.md Performance Goals): one ~145 ms PBKDF2 derivation at
+600,000 iterations, plus a JSON load and an atomic rewrite of a ~200 KB file.
+"""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import pytest
+
+from accounts import passwords, store
+
+ACCOUNT_COUNT = 1000
+BUDGET_SECONDS = 1.0
+
+PASSWORD = "correct horse battery"
+TARGET = "user_500"
+
+
+@pytest.fixture(scope="module")
+def large_store_accounts() -> dict[str, dict]:
+    """1,000 accounts, all sharing one salt and verifier so setup costs one derivation."""
+    salt = passwords.new_salt()
+    salt_text = store.encode(salt)
+    verifier_text = store.encode(passwords.derive(PASSWORD, salt))
+    return {
+        f"user_{index}": {
+            "salt": salt_text,
+            "verifier": verifier_text,
+            "failed_logins": 0,
+            "locked": False,
+        }
+        for index in range(ACCOUNT_COUNT)
+    }
+
+
+@pytest.fixture
+def large_store(tmp_path: Path, large_store_accounts) -> Path:
+    path = tmp_path / "big.json"
+    store.save(path, dict(large_store_accounts))
+    assert len(store.load(path)) == ACCOUNT_COUNT
+    return path
+
+
+COMMANDS = [
+    ("register", "user_new", "a brand new secret\n", 0),
+    ("login", TARGET, PASSWORD + "\n", 0),
+    ("unlock", TARGET, "", 0),
+    ("passwd", TARGET, PASSWORD + "\na new long secret\n", 0),
+    ("delete", TARGET, PASSWORD + "\n", 0),
+]
+
+
+@pytest.mark.parametrize(
+    "command,username,stdin_text,expected_status",
+    COMMANDS,
+    ids=[case[0] for case in COMMANDS],
+)
+def test_sc007_each_command_completes_in_under_a_second_on_1000_accounts(
+    run_cli, large_store, command, username, stdin_text, expected_status
+):
+    """SC-007: a 1,000-account store does not make any command feel delayed."""
+    started = time.perf_counter()
+    status, _, err = run_cli(["--store", str(large_store), command, username], stdin_text)
+    elapsed = time.perf_counter() - started
+
+    assert status == expected_status, err
+    assert elapsed < BUDGET_SECONDS, f"{command} took {elapsed:.3f}s on {ACCOUNT_COUNT} accounts"
+
+
+def test_sc007_the_store_survives_a_full_rewrite_at_scale(run_cli, large_store):
+    """SC-007 / FR-008: the atomic rewrite of a 1,000-account store stays correct."""
+    status, out, _ = run_cli(
+        ["--store", str(large_store), "register", "user_new"], "a brand new secret\n"
+    )
+    assert (status, out) == (0, "registered user_new\n")
+    accounts = store.load(large_store)
+    assert len(accounts) == ACCOUNT_COUNT + 1
+    assert run_cli(
+        ["--store", str(large_store), "login", "user_new"], "a brand new secret\n"
+    ) == (0, "ok\n", "")
