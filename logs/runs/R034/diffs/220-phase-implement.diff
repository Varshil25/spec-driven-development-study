+++ b/tests/test_requirement_coverage.py
@@ -0,0 +1,54 @@
+"""SC-001: every functional requirement is named by at least one test.
+
+Constitution Principle III requires the requirement-to-test mapping to be *discoverable* —
+by test name, by docstring, or by an explicit reference to the requirement identifier. This
+module makes that mapping a test of its own, so a requirement that loses its coverage fails
+the suite rather than decaying silently while everyone has stopped reading the spec.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+TESTS = Path(__file__).resolve().parent
+SPEC = TESTS.parent / "specs" / "001-local-account-manager" / "spec.md"
+
+FIRST_REQUIREMENT = 1
+LAST_REQUIREMENT = 38
+
+_IDENTIFIER = re.compile(r"FR-0\d\d")
+
+
+def referenced_identifiers() -> set[str]:
+    """Every FR identifier mentioned anywhere under tests/, excluding this file."""
+    found: set[str] = set()
+    for path in sorted(TESTS.glob("test_*.py")):
+        if path.name == Path(__file__).name:
+            continue
+        found.update(_IDENTIFIER.findall(path.read_text(encoding="utf-8")))
+    return found
+
+
+def test_sc001_all_38_functional_requirements_are_referenced_by_a_test():
+    """SC-001: 38 of 38 requirements mapped, none verified by inspection alone."""
+    expected = {f"FR-{n:03d}" for n in range(FIRST_REQUIREMENT, LAST_REQUIREMENT + 1)}
+    found = referenced_identifiers()
+    missing = sorted(expected - found)
+    assert not missing, f"requirements with no test referencing them: {missing}"
+
+
+def test_sc001_no_test_references_a_requirement_the_spec_does_not_define():
+    """SC-001: the mapping is checked in both directions, so a typo cannot hide a gap."""
+    expected = {f"FR-{n:03d}" for n in range(FIRST_REQUIREMENT, LAST_REQUIREMENT + 1)}
+    unexpected = sorted(referenced_identifiers() - expected)
+    assert not unexpected, f"tests reference requirements that do not exist: {unexpected}"
+
+
+def test_sc001_the_spec_still_defines_exactly_38_functional_requirements():
+    """SC-001: if the spec grows a requirement, this check must grow with it."""
+    if not SPEC.exists():  # pragma: no cover - the spec travels with the repository
+        raise AssertionError(f"specification not found at {SPEC}")
+    defined = set(_IDENTIFIER.findall(SPEC.read_text(encoding="utf-8")))
+    expected = {f"FR-{n:03d}" for n in range(FIRST_REQUIREMENT, LAST_REQUIREMENT + 1)}
+    assert defined == expected
