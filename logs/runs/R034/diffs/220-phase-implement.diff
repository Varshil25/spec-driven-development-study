index 0000000..da3dfc8
--- /dev/null
+++ b/src/accounts/passwords.py
@@ -0,0 +1,44 @@
+"""One-way password transformation (FR-036, FR-037).
+
+PBKDF2-HMAC-SHA256 is the one password-based KDF stdlib ``hashlib`` always provides,
+independent of how the local OpenSSL was built (research.md R-02). The parameters below are
+module constants rather than options or per-record fields: no requirement asks for algorithm
+migration, so storing them would be a degree of freedom that earns nothing (Principle IV).
+Changing them invalidates existing stores, and no requirement calls for migrating them.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import secrets
+
+ALGORITHM = "sha256"
+ITERATIONS = 600_000
+SALT_BYTES = 16
+KEY_BYTES = 32
+
+
+def new_salt() -> bytes:
+    """Return a fresh random salt, distinct per account (FR-036)."""
+    return secrets.token_bytes(SALT_BYTES)
+
+
+def derive(password: str, salt: bytes) -> bytes:
+    """Return the verifier for ``password`` under ``salt``.
+
+    This is the only place a password is encoded to bytes; validation happens before it,
+    on the ``str``, so length rules count characters rather than bytes (research.md R-06).
+    """
+    return hashlib.pbkdf2_hmac(
+        ALGORITHM, password.encode("utf-8"), salt, ITERATIONS, dklen=KEY_BYTES
+    )
+
+
+def verify(password: str, salt: bytes, verifier: bytes) -> bool:
+    """Return whether ``password`` reproduces ``verifier`` under ``salt``.
+
+    ``hmac.compare_digest`` keeps a wrong password from being narrowed byte-by-byte
+    through timing.
+    """
+    return hmac.compare_digest(derive(password, salt), verifier)
diff --git a/src/accounts/store.py b/src/accounts/store.py
