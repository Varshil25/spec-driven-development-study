+++ b/src/accounts/commands.py
@@ -0,0 +1,203 @@
+"""The five operations and their rules.
+
+Command functions take the in-memory store and return a ``Result``; they never touch a
+stream, so ``cli`` stays the only module that writes one (FR-004) and every rule here is
+testable without capturing output.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from . import passwords, store
+
+MIN_PASSWORD_LENGTH = 12
+LOCK_THRESHOLD = 5
+
+# An explicit character-set test rather than str.isalnum(), which is true for non-ASCII
+# letters and digits ("éé1", "١٢٣") that "letters, digits, and underscores" does not
+# intend in a local-account context (data-model.md).
+_USERNAME = re.compile(r"\A[A-Za-z0-9_]{3,32}\Z")
+
+E1_SHORT_PASSWORD = "password must be at least 12 characters\n"
+E2_BAD_USERNAME = "username must be 3 to 32 characters of letters, digits, and underscores\n"
+E5_INVALID_CREDENTIALS = "invalid credentials\n"
+E7_ACCOUNT_LOCKED = "account locked\n"
+E8_NO_PASSWORD = "no password on standard input\n"
+E9_NO_NEW_PASSWORD = "no new password on standard input\n"
+
+
+@dataclass(frozen=True)
+class Result:
+    """What a command decided: the exit status, what to print, and whether to persist.
+
+    ``save`` is stated by the command rather than inferred from ``code`` because FR-006
+    makes "exit non-zero but still persist" a real case: a failed login must write its
+    incremented ``failed_logins`` and any resulting lock, while every other non-zero
+    outcome must leave the store untouched. No status code can express that distinction.
+
+    Invariants (asserted in tests): ``code == 0`` implies ``err == ""``; ``code != 0``
+    implies ``out == ""`` and ``err != ""``; ``code`` is only ever 0, 1, 2, 3, or 4.
+    """
+
+    code: int
+    out: str = ""
+    err: str = ""
+    save: bool = False
+
+
+# --------------------------------------------------------------------------- validation
+
+
+def _valid_username(username: str) -> bool:
+    """FR-010: 3 to 32 characters of ASCII letters, digits, and underscores."""
+    return _USERNAME.fullmatch(username) is not None
+
+
+def _valid_password(password: str) -> bool:
+    """FR-011: at least 12 characters, counted in code points rather than bytes."""
+    return len(password) >= MIN_PASSWORD_LENGTH
+
+
+def _credential(password: str) -> tuple[str, str]:
+    """A fresh salt and the matching verifier, encoded for storage (FR-036)."""
+    salt = passwords.new_salt()
+    return store.encode(salt), store.encode(passwords.derive(password, salt))
+
+
+def _verify(record: dict, password: str) -> bool:
+    """Whether ``password`` matches the stored verifier for ``record``."""
+    return passwords.verify(
+        password, store.decode(record["salt"]), store.decode(record["verifier"])
+    )
+
+
+# ----------------------------------------------------------------------------- commands
+
+
+def register(accounts: dict[str, dict], username: str, password: str | None) -> Result:
+    """Create the named account (FR-009 - FR-013).
+
+    Order: username format -> password present -> password length -> already exists. The
+    two validation steps precede the existence check, which is what makes FR-013's
+    "invalid username and the account also exists exits 2, not 3" fall out of the order
+    rather than being special-cased (research.md R-07).
+    """
+    if not _valid_username(username):
+        return Result(2, err=E2_BAD_USERNAME)
+    if password is None:
+        return Result(2, err=E8_NO_PASSWORD)
+    if not _valid_password(password):
+        return Result(2, err=E1_SHORT_PASSWORD)
+    if username in accounts:
+        return Result(3, err=f"account already exists: {username}\n")
+
+    salt, verifier = _credential(password)
+    accounts[username] = {
+        "salt": salt,
+        "verifier": verifier,
+        "failed_logins": 0,
+        "locked": False,
+    }
+    return Result(0, out=f"registered {username}\n", save=True)
+
+
+def login(accounts: dict[str, dict], username: str, password: str | None) -> Result:
+    """Check a password (FR-014 - FR-021).
+
+    Order: exists? -> locked? -> password present -> verify. The absent-account case is
+    deliberately indistinguishable from a wrong password (FR-016), and the lock gate sits
+    before the password is even read, so a correct password can never produce ``ok`` on a
+    locked account (FR-020).
+    """
+    record = accounts.get(username)
+    if record is None:
+        return Result(1, err=E5_INVALID_CREDENTIALS)
+    if record["locked"]:
+        return Result(4, err=E7_ACCOUNT_LOCKED)
+    if password is None:
+        return Result(2, err=E8_NO_PASSWORD)
+
+    if _verify(record, password):
+        # Only the count is reset; the lock is left alone because only unlock clears it
+        # (FR-021, FR-023) — and a locked account never reaches this line anyway.
+        record["failed_logins"] = 0
+        return Result(0, out="ok\n", save=True)
+
+    # FR-006: this is the one non-zero outcome that persists, so the incremented count and
+    # any resulting lock survive the process. FR-019: reaching the threshold locks the
+    # account, but this attempt still reports the credential rather than the lock.
+    record["failed_logins"] += 1
+    if record["failed_logins"] >= LOCK_THRESHOLD:
+        record["locked"] = True
+    return Result(1, err=E5_INVALID_CREDENTIALS, save=True)
+
+
+def unlock(accounts: dict[str, dict], username: str) -> Result:
+    """Clear the lock and zero the failure count (FR-022, FR-023, FR-034).
+
+    Takes no password parameter at all: FR-022 makes unlock an operator action on the
+    store, not a credential check. Exits 0 even when the account was not locked.
+    """
+    record = accounts.get(username)
+    if record is None:
+        return Result(3, err=f"no such account: {username}\n")
+
+    record["locked"] = False
+    record["failed_logins"] = 0
+    return Result(0, save=True)
+
+
+def passwd(
+    accounts: dict[str, dict],
+    username: str,
+    current: str | None,
+    new: str | None,
+) -> Result:
+    """Replace an account's password (FR-026 - FR-029).
+
+    Order: exists? -> current present -> new present -> verify current -> new length ->
+    replace. Verify-before-length is the reverse of ``register``'s order and is required:
+    the length complaint is reported only after the current password has been accepted, so
+    a status-2 reply can never reveal that the current password was right (FR-028).
+
+    Neither ``locked`` nor ``failed_logins`` is read or written here (FR-023 - FR-025): a
+    locked account accepts a change, and a rejected one is not a failed login.
+    """
+    record = accounts.get(username)
+    if record is None:
+        return Result(3, err=f"no such account: {username}\n")
+    if current is None:
+        return Result(2, err=E8_NO_PASSWORD)
+    if new is None:
+        return Result(2, err=E9_NO_NEW_PASSWORD)
+    if not _verify(record, current):
+        return Result(1, err=E5_INVALID_CREDENTIALS)
+    if not _valid_password(new):
+        return Result(2, err=E1_SHORT_PASSWORD)
+
+    # A fresh salt on every change, so the stored verifier differs even when the password
+    # does not (FR-029, FR-036).
+    record["salt"], record["verifier"] = _credential(new)
+    return Result(0, save=True)
+
+
+def delete(accounts: dict[str, dict], username: str, password: str | None) -> Result:
+    """Remove an account and all of its state (FR-030 - FR-033).
+
+    Order: exists? -> password present -> verify -> remove. Removing the record is what
+    makes FR-030's "all of its state" and FR-032's "the username is available again" the
+    same act, and no other account is touched (FR-033). A rejected attempt is not a failed
+    login, so the failure counter is left alone (FR-024).
+    """
+    record = accounts.get(username)
+    if record is None:
+        return Result(3, err=f"no such account: {username}\n")
+    if password is None:
+        return Result(2, err=E8_NO_PASSWORD)
+    if not _verify(record, password):
+        return Result(1, err=E5_INVALID_CREDENTIALS)
+
+    del accounts[username]
+    return Result(0, save=True)
