+def test_fr008_missing_parent_directory_raises_and_writes_nothing(tmp_path: Path):
+    """FR-008 / "unusable store path": a missing directory is loud, before any change."""
+    target = tmp_path / "nonexistent-dir" / "store.json"
+    with pytest.raises(store.StoreError) as excinfo:
