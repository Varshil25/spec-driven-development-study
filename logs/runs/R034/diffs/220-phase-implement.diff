+"""Shared test fixtures.
+
+The in-process seam is ``accounts.cli.main(argv, stdin, stdout, stderr) -> int``
+(research.md R-08): most tests drive it directly with ``io.StringIO`` streams and a
+``tmp_path`` store, so a case costs microseconds instead of an interpreter start.
+"""
+
+from __future__ import annotations
+
+import io
+import json
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def store_path(tmp_path: Path) -> Path:
+    """A store path that does not exist yet."""
+    return tmp_path / "store.json"
+
+
+@pytest.fixture
+def run_cli():
+    """Call ``cli.main`` in process; return ``(status, stdout_text, stderr_text)``."""
+    from accounts import cli
+
+    def _run(argv: list[str], stdin_text: str = "") -> tuple[int, str, str]:
+        out = io.StringIO()
+        err = io.StringIO()
+        status = cli.main(list(argv), io.StringIO(stdin_text), out, err)
+        return status, out.getvalue(), err.getvalue()
+
+    return _run
+
+
+@pytest.fixture
+def read_store():
+    """Read the raw store JSON (test-side inspection of the internal format)."""
+
+    def _read(path: Path) -> dict:
+        return json.loads(path.read_text(encoding="utf-8"))
+
+    return _read
diff --git a/tests/test_cli_usage.py b/tests/test_cli_usage.py
new file mode 100644
index 0000000..8b02cd6
--- /dev/null
+++ b/tests/test_cli_usage.py
@@ -0,0 +1,290 @@
+"""The process-facing shell: FR-001, FR-003, FR-004, FR-005, FR-035.
+
+Scope note: the tests here that assert a *property across all five commands* (the exit-status
+set, the stream-discipline sweep, "no password in any diagnostic", and the E12 write path)
+drive real commands, so they go green only once User Stories 1-4 have landed. The usage
+errors (E13) and the store-read diagnostics (E10, E11) are satisfiable by the foundational
+CLI alone. This split is deliberate; test_lockout.py records the same choice for FR-024/25.
+"""
+
+from __future__ import annotations
+
+import base64
+import dataclasses
+import io
+import json
+from pathlib import Path
+
+import pytest
+
+from accounts import cli, commands, passwords, store
+
+PASSWORD = "correct horse battery"
+
+
+def seed(path: Path, username: str = "alice", password: str = PASSWORD, **kwargs) -> None:
+    salt = passwords.new_salt()
+    store.save(
+        path,
+        {
+            username: {
+                "salt": base64.b64encode(salt).decode("ascii"),
+                "verifier": base64.b64encode(passwords.derive(password, salt)).decode("ascii"),
+                "failed_logins": kwargs.get("failed_logins", 0),
+                "locked": kwargs.get("locked", False),
+            }
+        },
+    )
+
+
+# --------------------------------------------------------------- FR-035 / E13 usage errors
+
+USAGE_ERRORS = {
+    "missing --store": ["login", "alice"],
+    "missing command and username": ["--store", "S"],
+    "missing username": ["--store", "S", "login"],
+    "unknown command": ["--store", "S", "frobnicate", "alice"],
+    "extra positional argument": ["--store", "S", "login", "alice", "extra"],
+    "store option without a value": ["--store"],
+    "unknown option": ["--store", "S", "--password", "x", "login", "alice"],
+}
+
+
+@pytest.mark.parametrize("case", sorted(USAGE_ERRORS), ids=sorted(USAGE_ERRORS))
+def test_fr035_usage_errors_go_to_stderr_with_status_2(case, store_path, run_cli):
+    """FR-035 / E13: every usage error is a stderr diagnostic with exit status 2."""
+    argv = [str(store_path) if a == "S" else a for a in USAGE_ERRORS[case]]
+    status, out, err = run_cli(argv)
+    assert status == 2, case
+    assert out == "", case
+    assert "usage:" in err, case
+
+
+def test_fr035_usage_message_names_the_program_as_invoked(store_path, run_cli):
+    """FR-035: the usage line matches the documented invocation form."""
+    _, _, err = run_cli(["--store", str(store_path), "login"])
+    assert "python -m accounts" in err
+
+
+def test_fr001_the_five_command_names_are_the_only_ones_accepted(store_path, run_cli):
+    """FR-001: the command name is one of exactly five, lower-case and exact."""
+    for bad in ("Login", "LOGIN", "reg", "registe", "logout", ""):
+        status, out, err = run_cli(["--store", str(store_path), bad, "alice"])
+        assert status == 2, bad
+        assert out == "", bad
+        assert err != "", bad
+
+
+def test_fr001_the_tool_acts_only_on_the_store_at_the_given_path(tmp_path, run_cli):
+    """FR-001: the store option selects the file; another path is untouched."""
+    one = tmp_path / "one.json"
+    two = tmp_path / "two.json"
+    status, out, _ = run_cli(["--store", str(one), "register", "alice"], PASSWORD + "\n")
+    assert (status, out) == (0, "registered alice\n")
+    assert one.exists()
+    assert not two.exists()
+
+    status, _, err = run_cli(["--store", str(two), "login", "alice"], PASSWORD + "\n")
+    assert (status, err) == (1, "invalid credentials\n")
+
+
+# ------------------------------------------------------------------- FR-003 no argv secrets
+
+
+def test_fr003_no_option_accepts_a_password(store_path, run_cli):
+    """FR-003: there is no flag through which a password could be passed."""
+    for flag in ("--password", "--pass", "-p", "--new-password", "--current"):
+        status, out, _ = run_cli(
+            ["--store", str(store_path), flag, PASSWORD, "login", "alice"]
+        )
+        assert status == 2, flag
+        assert out == "", flag
+
+
+def test_fr003_the_parser_exposes_only_the_store_option(run_cli):
+    """FR-003: --store is the only option the tool has, so no password can be an argument."""
+    status, out, err = run_cli(["--help"])
+    assert status == 0
+    assert err == ""
+    options = {
+        token.split("=")[0].rstrip(",") for token in out.split() if token.startswith("--")
+    }
+    assert options == {"--store", "--help"}
+
+
+def test_fr003_a_password_is_never_echoed_into_a_diagnostic(store_path, run_cli):
+    """FR-003 / FR-037: the supplied password appears in no message on any stream."""
+    seed(store_path)
+    secret = "a unique secret value"
+    for argv, stdin_text in (
+        (["--store", str(store_path), "login", "alice"], secret + "\n"),
+        (["--store", str(store_path), "register", "alice"], secret + "\n"),
+        (["--store", str(store_path), "register", "ab"], secret + "\n"),
+        (["--store", str(store_path), "register", "bob"], "short\n"),
+    ):
+        _, out, err = run_cli(argv, stdin_text)
+        assert secret not in out
+        assert secret not in err
+
+
+# ----------------------------------------------------------- FR-005 the permitted status set
+
+PERMITTED_STATUSES = {0, 1, 2, 3, 4}
+
+
+def test_fr005_every_observed_status_is_one_of_the_five(store_path, run_cli):
+    """FR-005: only 0, 1, 2, 3, and 4 are ever returned."""
+    seed(store_path, failed_logins=5, locked=True)
+    scenarios = [
+        (["--store", str(store_path), "login", "alice"], PASSWORD + "\n"),
+        (["--store", str(store_path), "unlock", "alice"], ""),
+        (["--store", str(store_path), "login", "alice"], PASSWORD + "\n"),
+        (["--store", str(store_path), "login", "alice"], "wrong password!!\n"),
+        (["--store", str(store_path), "login", "carol"], PASSWORD + "\n"),
+        (["--store", str(store_path), "register", "alice"], PASSWORD + "\n"),
+        (["--store", str(store_path), "register", "bob"], PASSWORD + "\n"),
+        (["--store", str(store_path), "register", "ab"], PASSWORD + "\n"),
+        (["--store", str(store_path), "register", "carol"], ""),
+        (["--store", str(store_path), "passwd", "alice"], PASSWORD + "\nnew longer secret\n"),
+        (["--store", str(store_path), "passwd", "carol"], PASSWORD + "\nx\n"),
+        (["--store", str(store_path), "delete", "carol"], PASSWORD + "\n"),
+        (["--store", str(store_path), "delete", "alice"], "new longer secret\n"),
+        (["--store", str(store_path), "frobnicate", "alice"], ""),
+        (["login", "alice"], ""),
+    ]
+    for argv, stdin_text in scenarios:
+        status, _, _ = run_cli(argv, stdin_text)
+        assert status in PERMITTED_STATUSES, (argv, status)
+
+
+def test_fr005_result_codes_are_restricted_and_streams_are_exclusive():
+    """FR-004 / FR-005: the Result type carries the invariants as a property."""
+    success = commands.Result(0, out="ok\n", save=True)
+    assert success.code == 0 and success.err == ""
+
+    failure = commands.Result(1, err="invalid credentials\n")
+    assert failure.out == ""
+
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        success.code = 1  # type: ignore[misc]
+
+
+# -------------------------------------------------------- FR-004 / E10-E12 store diagnostics
+
+
+def test_fr004_unreadable_store_reports_e10_on_stderr_with_status_2(tmp_path, run_cli):
+    """E10 / FR-007: 'cannot read store file: PATH: REASON' on stderr, status 2."""
+    a_directory = tmp_path / "store.json"
+    a_directory.mkdir()
+    status, out, err = run_cli(["--store", str(a_directory), "login", "alice"], PASSWORD + "\n")
+    assert status == 2
+    assert out == ""
+    assert err.startswith(f"cannot read store file: {a_directory}: ")
+    assert err.endswith("\n") and err.count("\n") == 1
+
+
+def test_fr004_malformed_store_reports_e11_on_stderr_with_status_2(store_path, run_cli):
+    """E11 / FR-007: 'not a valid store file: PATH: REASON' on stderr, status 2."""
+    store_path.write_text("this is not a store\n", encoding="utf-8")
+    status, out, err = run_cli(["--store", str(store_path), "login", "alice"], PASSWORD + "\n")
+    assert status == 2
+    assert out == ""
+    assert err.startswith(f"not a valid store file: {store_path}: ")
+    assert store_path.read_text(encoding="utf-8") == "this is not a store\n"
+
+
+def test_fr004_store_validation_failure_reports_e11(store_path, run_cli):
+    """E11 / FR-007: valid JSON that is not a store is reported the same loud way."""
+    store_path.write_text(json.dumps({"version": 2, "accounts": {}}), encoding="utf-8")
+    status, out, err = run_cli(["--store", str(store_path), "login", "alice"], PASSWORD + "\n")
+    assert (status, out) == (2, "")
+    assert err.startswith(f"not a valid store file: {store_path}: ")
+
+
+def test_fr005_a_non_utf8_store_still_exits_with_a_permitted_status(store_path, run_cli):
+    """FR-005 / FR-007: a mis-encoded store is reported, not left to a traceback's exit 1."""
+    store_path.write_bytes(b'{"version": 1, "accounts": {"\xff\xfe": {}}}')
+    status, out, err = run_cli(["--store", str(store_path), "login", "alice"], PASSWORD + "\n")
+    assert status == 2
+    assert out == ""
+    assert err.startswith(f"not a valid store file: {store_path}: ")
+
+
+def test_fr004_unwritable_store_reports_e12_on_stderr_with_status_2(tmp_path, run_cli):
+    """E12: 'cannot write store file: PATH: REASON' on stderr, status 2."""
+    target = tmp_path / "nonexistent-dir" / "store.json"
+    status, out, err = run_cli(["--store", str(target), "register", "alice"], PASSWORD + "\n")
+    assert status == 2
+    assert out == ""
+    assert err.startswith(f"cannot write store file: {target}: ")
+    assert not target.exists()
+
+
+def test_fr004_every_store_diagnostic_omits_the_password(store_path, run_cli):
+    """FR-037: store diagnostics name the file and the condition, never a secret."""
+    store_path.write_text("not a store", encoding="utf-8")
+    secret = "a unique secret value"
+    _, out, err = run_cli(["--store", str(store_path), "login", "alice"], secret + "\n")
+    assert secret not in out and secret not in err
+
+
+# ------------------------------------------------- FR-004 cross-command stream discipline
+
+
+SWEEP: list[tuple[list[str], str]] = [
+    (["register", "alice"], PASSWORD + "\n"),
+    (["register", "alice"], PASSWORD + "\n"),
+    (["register", "ab"], PASSWORD + "\n"),
+    (["register", "bob"], "short\n"),
+    (["register", "carol"], ""),
+    (["login", "alice"], PASSWORD + "\n"),
+    (["login", "alice"], "wrong password!!\n"),
+    (["login", "carol"], PASSWORD + "\n"),
+    (["login", "alice"], ""),
+    (["unlock", "alice"], ""),
+    (["unlock", "carol"], ""),
+    (["passwd", "alice"], PASSWORD + "\nnew longer secret\n"),
+    (["passwd", "alice"], "wrong password!!\nnew longer secret\n"),
+    (["passwd", "alice"], "new longer secret\nshort\n"),
+    (["passwd", "alice"], "new longer secret\n"),
+    (["passwd", "carol"], PASSWORD + "\n" + PASSWORD + "\n"),
+    (["delete", "carol"], PASSWORD + "\n"),
+    (["delete", "alice"], "wrong password!!\n"),
+    (["delete", "alice"], ""),
+    (["delete", "alice"], "new longer secret\n"),
+]
+
+
+def test_fr004_success_leaves_stderr_empty_and_failure_leaves_stdout_empty_sweep(
+    store_path, run_cli
+):
+    """FR-004 / SC-008: results only on stdout, diagnostics only on stderr, never mixed."""
+    observed_success = observed_failure = 0
+    for tail, stdin_text in SWEEP:
+        status, out, err = run_cli(["--store", str(store_path), *tail], stdin_text)
+        assert status in PERMITTED_STATUSES, (tail, status)
+        if status == 0:
+            assert err == "", (tail, err)
+            observed_success += 1
+        else:
+            assert out == "", (tail, out)
+            assert err != "", tail
+            assert err.endswith("\n") and err.count("\n") == 1, (tail, err)
+            observed_failure += 1
+    assert observed_success >= 5
+    assert observed_failure >= 10
+
+
+def test_fr004_main_writes_nothing_to_the_wrong_stream_for_a_locked_account(store_path):
+    """FR-004 / FR-020: a locked account's diagnostic never reaches stdout."""
+    seed(store_path, failed_logins=5, locked=True)
+    out, err = io.StringIO(), io.StringIO()
+    status = cli.main(
+        ["--store", str(store_path), "login", "alice"],
+        io.StringIO(PASSWORD + "\n"),
+        out,
+        err,
+    )
+    assert status == 4
+    assert out.getvalue() == ""
+    assert err.getvalue() == "account locked\n"
