@@ -0,0 +1,234 @@
+"""Registration: FR-009 - FR-013."""
+
+from __future__ import annotations
+
+import stat
+from pathlib import Path
+
+import pytest
+
+PASSWORD = "correct horse battery"
+E1 = "password must be at least 12 characters\n"
+E2 = "username must be 3 to 32 characters of letters, digits, and underscores\n"
+E8 = "no password on standard input\n"
+
+
+def register(run_cli, store_path: Path, username: str, password: str | None):
+    argv = ["--store", str(store_path), "register", username]
+    return run_cli(argv, "" if password is None else password + "\n")
+
+
+# ------------------------------------------------------------------------------- FR-009
+
+
+def test_fr009_success_writes_registered_username_and_exits_0(run_cli, store_path):
+    """FR-009: 'registered USERNAME' on stdout, status 0, account created."""
+    status, out, err = register(run_cli, store_path, "alice", PASSWORD)
+    assert status == 0
+    assert out == "registered alice\n"
+    assert err == ""
+    assert store_path.exists()
+
+
+def test_fr009_the_created_account_can_log_in(run_cli, store_path):
+    """FR-009: registration creates the named account with the supplied password."""
+    register(run_cli, store_path, "alice", PASSWORD)
+    status, out, err = run_cli(["--store", str(store_path), "login", "alice"], PASSWORD + "\n")
+    assert (status, out, err) == (0, "ok\n", "")
+
+
+def test_fr009_fr038_the_store_is_created_owner_only(run_cli, store_path):
+    """FR-009 / FR-038: the store file is created on first registration, mode 0600."""
+    assert not store_path.exists()
+    register(run_cli, store_path, "alice", PASSWORD)
+    assert stat.S_IMODE(store_path.stat().st_mode) == 0o600
+
+
+def test_fr009_registration_stores_a_fresh_record(run_cli, store_path, read_store):
+    """FR-009: the new record starts unlocked with no failed logins."""
+    register(run_cli, store_path, "alice", PASSWORD)
+    record = read_store(store_path)["accounts"]["alice"]
+    assert record["failed_logins"] == 0
+    assert record["locked"] is False
+    assert set(record) == {"salt", "verifier", "failed_logins", "locked"}
+
+
+# ------------------------------------------------------------------------------- FR-010
+
+VALID_USERNAMES = ["abc", "a_b", "___", "A1_z", "u" * 32, "0123456789", "Alice_99"]
+INVALID_USERNAMES = [
+    "ab",
+    "u" * 33,
+    "bad-name",
+    "with space",
+    "dots.here",
+    "éé1",
+    "١٢٣",
+    "alice!",
+    "",
+    "  abc",
+    "ünicode_name",
+]
+
+
+@pytest.mark.parametrize("username", VALID_USERNAMES)
+def test_fr010_usernames_of_3_to_32_word_characters_are_accepted(
+    run_cli, store_path, username
+):
+    """FR-010: 3 to 32 characters of ASCII letters, digits, and underscores. 3 and 32 pass."""
+    status, out, err = register(run_cli, store_path, username, PASSWORD)
+    assert (status, err) == (0, "")
+    assert out == f"registered {username}\n"
+
+
+@pytest.mark.parametrize("username", INVALID_USERNAMES)
+def test_fr010_other_usernames_are_rejected_with_e2_and_status_2(
+    run_cli, store_path, username
+):
+    """FR-010: 2 and 33 characters, hyphens, and non-ASCII alphanumerics are rejected."""
+    status, out, err = register(run_cli, store_path, username, PASSWORD)
+    assert status == 2, username
+    assert out == "", username
+    assert err == E2, username
+    assert not store_path.exists(), username
+
+
+# ------------------------------------------------------------------------------- FR-011
+
+
+def test_fr011_a_12_character_password_is_accepted(run_cli, store_path):
+    """FR-011: the boundary is 12 characters; exactly 12 passes."""
+    twelve = "a" * 12
+    assert len(twelve) == 12
+    status, out, _ = register(run_cli, store_path, "alice", twelve)
+    assert (status, out) == (0, "registered alice\n")
+
+
+def test_fr011_an_11_character_password_is_rejected_with_e1_and_status_2(run_cli, store_path):
+    """FR-011: 11 characters is rejected with a diagnostic and status 2."""
+    status, out, err = register(run_cli, store_path, "alice", "a" * 11)
+    assert (status, out, err) == (2, "", E1)
+    assert not store_path.exists()
+
+
+def test_fr011_an_empty_line_is_a_password_that_is_too_short(run_cli, store_path):
+    """FR-011 / FR-018: a blank line is a supplied password of length 0, not missing input."""
+    status, out, err = register(run_cli, store_path, "alice", "")
+    assert (status, out, err) == (2, "", E1)
+
+
+def test_fr011_password_length_counts_characters_not_bytes(run_cli, store_path):
+    """FR-011: a 12-character non-ASCII password is accepted though it is longer in bytes."""
+    password = "pässwörd-ñ€"
+    assert len(password) == 11 and len(password.encode("utf-8")) > 12
+    status, _, err = register(run_cli, store_path, "alice", password)
+    assert (status, err) == (2, E1)
+
+    password = "pässwörd-ñ€x"
+    assert len(password) == 12 and len(password.encode("utf-8")) == 17
+    status, out, err = register(run_cli, store_path, "bob", password)
+    assert (status, out, err) == (0, "registered bob\n", "")
+
+
+# ------------------------------------------------------------------------------- FR-012
+
+
+def test_fr012_a_duplicate_username_is_rejected_with_e3_and_status_3(
+    run_cli, store_path, read_store
+):
+    """FR-012: a username already present exits 3 and leaves the record untouched."""
+    register(run_cli, store_path, "alice", PASSWORD)
+    before = read_store(store_path)
+
+    status, out, err = register(run_cli, store_path, "alice", "a totally different one")
+    assert status == 3
+    assert out == ""
+    assert err == "account already exists: alice\n"
+    assert read_store(store_path) == before
+
+
+def test_fr012_the_original_password_still_works_after_a_rejected_duplicate(
+    run_cli, store_path
+):
+    """FR-012: a rejected registration must not modify the existing account."""
+    register(run_cli, store_path, "alice", PASSWORD)
+    register(run_cli, store_path, "alice", "a totally different one")
+    status, out, _ = run_cli(["--store", str(store_path), "login", "alice"], PASSWORD + "\n")
+    assert (status, out) == (0, "ok\n")
+
+
+# ------------------------------------------------------------------------- FR-018 (E8)
+
+
+def test_fr018_end_of_input_gives_e8_status_2_and_creates_no_account(run_cli, store_path):
+    """FR-018: end of input is an error, never an empty password."""
+    status, out, err = register(run_cli, store_path, "alice", None)
+    assert (status, out, err) == (2, "", E8)
+    assert not store_path.exists()
+
+
+# ------------------------------------------------------------------------------- FR-013
+
+
+def test_fr013_invalid_username_and_short_password_exits_2_reporting_the_username(
+    run_cli, store_path
+):
+    """FR-013: when both are invalid the command still exits 2; the username is checked first."""
+    status, out, err = register(run_cli, store_path, "ab", "short")
+    assert (status, out, err) == (2, "", E2)
+
+
+def test_fr013_invalid_username_and_existing_account_exits_2_not_3(run_cli, store_path):
+    """FR-013: input validation precedes existence checks, so this is 2 rather than 3."""
+    # "bad-name" is an invalid username that nevertheless exists in the store: the store's
+    # username keys are not validated at load time (data-model.md).
+    register(run_cli, store_path, "alice", PASSWORD)
+    raw = store_path.read_text(encoding="utf-8").replace('"alice"', '"bad-name"')
+    store_path.write_text(raw, encoding="utf-8")
+
+    status, out, err = register(run_cli, store_path, "bad-name", PASSWORD)
+    assert (status, out, err) == (2, "", E2)
+
+
+def test_fr013_invalid_username_is_reported_before_missing_input(run_cli, store_path):
+    """FR-013: the username rule precedes the standard-input read entirely."""
+    status, out, err = register(run_cli, store_path, "ab", None)
+    assert (status, out, err) == (2, "", E2)
+
+
+def test_fr013_short_password_is_reported_before_the_account_exists_check(
+    run_cli, store_path
+):
+    """FR-013: password validation also precedes the existence check (E1, not E3)."""
+    register(run_cli, store_path, "alice", PASSWORD)
+    status, out, err = register(run_cli, store_path, "alice", "short")
+    assert (status, out, err) == (2, "", E1)
+
+
+# --------------------------------------------------------------------- other properties
+
+
+def test_register_ignores_extra_lines_on_standard_input(run_cli, store_path):
+    """Contract "Standard-input protocol": register reads exactly one line."""
+    status, out, err = run_cli(
+        ["--store", str(store_path), "register", "extras"],
+        "a valid password\nextra line\n\n",
+    )
+    assert (status, out, err) == (0, "registered extras\n", "")
+
+
+def test_fr037_the_password_never_appears_in_the_store_bytes(run_cli, store_path):
+    """FR-037 / SC-006: the store holds only a salted one-way verifier."""
+    register(run_cli, store_path, "alice", PASSWORD)
+    assert PASSWORD.encode("utf-8") not in store_path.read_bytes()
+
+
+def test_fr036_two_accounts_with_the_same_password_have_different_verifiers(
+    run_cli, store_path, read_store
+):
+    """FR-036: a distinct per-account random salt is used, so verifiers differ."""
+    register(run_cli, store_path, "user_one", "identical password")
+    register(run_cli, store_path, "user_two", "identical password")
+    accounts = read_store(store_path)["accounts"]
+    assert accounts["user_one"]["salt"] != accounts["user_two"]["salt"]
+    assert accounts["user_one"]["verifier"] != accounts["user_two"]["verifier"]
