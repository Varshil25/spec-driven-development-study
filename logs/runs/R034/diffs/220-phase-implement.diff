index 0000000..440da7b
--- /dev/null
+++ b/src/accounts/store.py
@@ -0,0 +1,174 @@
+"""The store file: strict loading and atomic, owner-only saving.
+
+Two principles shape this module.
+
+*Fail Loudly* (Principle II): a store that exists but is not a store is an error naming the
+file and the specific condition — never an empty store, never a defaulted field (FR-007).
+Only ``OSError``, ``json.JSONDecodeError``, and this module's own ``StoreError`` are caught,
+and each is re-raised as a ``StoreError`` carrying the path. Base64 and type checking is done
+by explicit test rather than by catching a decoder's exception, so there is nothing to swallow.
+
+*Atomicity* (FR-008, research.md R-05): every write goes to a temporary file in the store's
+own directory, is flushed and ``fsync``-ed, and is moved into place with ``os.replace``, which
+is atomic within a filesystem. A reader sees either the previous store or the complete new
+one, never a truncated one.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import os
+import re
+import tempfile
+from pathlib import Path
+
+VERSION = 1
+RECORD_KEYS = frozenset({"salt", "verifier", "failed_logins", "locked"})
+SALT_BYTES = 16
+VERIFIER_BYTES = 32
+FILE_MODE = 0o600
+
+_BASE64 = re.compile(r"\A[A-Za-z0-9+/]+={0,2}\Z")
+
+
+class StoreError(Exception):
+    """A store file that cannot be read, is not a store, or cannot be written.
+
+    The message is the complete diagnostic the CLI writes to stderr: it names the path and
+    the specific condition, and never discloses store contents (FR-007, FR-037).
+    """
+
+
+def load(path: str | os.PathLike[str]) -> dict[str, dict]:
+    """Return the store's accounts, or ``{}`` if the file does not exist (FR-002).
+
+    A missing file is a store with no accounts and no file is created. Anything else that
+    is not a valid store raises ``StoreError``.
+    """
+    path = Path(path)
+    try:
+        text = path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return {}
+    except OSError as exc:
+        raise StoreError(f"cannot read store file: {path}: {_reason(exc)}") from exc
+    except UnicodeDecodeError as exc:
+        raise StoreError(f"not a valid store file: {path}: {exc}") from exc
+
+    try:
+        payload = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise StoreError(f"not a valid store file: {path}: {exc}") from exc
+
+    try:
+        return _validated(payload)
+    except StoreError as exc:
+        raise StoreError(f"not a valid store file: {path}: {exc}") from exc
+
+
+def save(path: str | os.PathLike[str], accounts: dict[str, dict]) -> None:
+    """Write ``accounts`` to ``path`` atomically, owner-readable only (FR-008, FR-038)."""
+    path = Path(path)
+    text = json.dumps({"version": VERSION, "accounts": accounts}, indent=2, sort_keys=True)
+
+    try:
+        handle, temp_name = tempfile.mkstemp(dir=path.parent, prefix=".store-", suffix=".tmp")
+    except OSError as exc:
+        raise StoreError(f"cannot write store file: {path}: {_reason(exc)}") from exc
+
+    try:
+        with open(handle, "w", encoding="utf-8") as stream:
+            stream.write(text + "\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.chmod(temp_name, FILE_MODE)
+        os.replace(temp_name, path)
+    except OSError as exc:
+        _discard(temp_name)
+        raise StoreError(f"cannot write store file: {path}: {_reason(exc)}") from exc
+
+
+# --------------------------------------------------------------------------- internals
+
+
+def _reason(exc: OSError) -> str:
+    """The operating system's own description, without the path it already carries."""
+    return exc.strerror or str(exc)
+
+
+def _discard(temp_name: str) -> None:
+    """Remove the temporary file so a failed save leaves nothing behind.
+
+    ``FileNotFoundError`` is the one benign case (``os.replace`` consumed it). Any other
+    ``OSError`` is allowed to propagate, chained onto the failure being handled, rather
+    than being swallowed (Principle II).
+    """
+    try:
+        os.unlink(temp_name)
+    except FileNotFoundError:
+        pass
+
+
+def _validated(payload: object) -> dict[str, dict]:
+    """Apply the seven load-time rules from data-model.md, or raise ``StoreError``."""
+    if not isinstance(payload, dict):
+        raise StoreError("top-level value is not an object")
+
+    if "version" not in payload:
+        raise StoreError("missing key: version")
+    version = payload["version"]
+    if isinstance(version, bool) or not isinstance(version, int) or version != VERSION:
+        raise StoreError(f"version is not {VERSION}")
+
+    if "accounts" not in payload:
+        raise StoreError("missing key: accounts")
+    accounts = payload["accounts"]
+    if not isinstance(accounts, dict):
+        raise StoreError("accounts is not an object")
+
+    for username, record in accounts.items():
+        _validate_record(username, record)
+    return accounts
+
+
+def _validate_record(username: str, record: object) -> None:
+    where = f"account {username!r}"
+    if not isinstance(record, dict):
+        raise StoreError(f"{where}: not an object")
+
+    missing = sorted(RECORD_KEYS - set(record))
+    if missing:
+        raise StoreError(f"{where}: missing key: {missing[0]}")
+    unknown = sorted(set(record) - RECORD_KEYS)
+    if unknown:
+        raise StoreError(f"{where}: unknown key: {unknown[0]}")
+
+    _validate_base64(where, "salt", record["salt"], SALT_BYTES)
+    _validate_base64(where, "verifier", record["verifier"], VERIFIER_BYTES)
+
+    failed = record["failed_logins"]
+    if isinstance(failed, bool) or not isinstance(failed, int) or failed < 0:
+        raise StoreError(f"{where}: failed_logins is not a non-negative integer")
+
+    if not isinstance(record["locked"], bool):
+        raise StoreError(f"{where}: locked is not a boolean")
+
+
+def _validate_base64(where: str, field: str, value: object, expected: int) -> None:
+    """Require strict base64 of exactly ``expected`` bytes, by test rather than by catch."""
+    problem = f"{where}: {field} is not base64 of {expected} bytes"
+    if not isinstance(value, str) or len(value) % 4 or not _BASE64.fullmatch(value):
+        raise StoreError(problem)
+    if len(base64.b64decode(value, validate=True)) != expected:
+        raise StoreError(problem)
+
+
+def decode(value: str) -> bytes:
+    """Decode a validated base64 field from a loaded record."""
+    return base64.b64decode(value, validate=True)
+
+
+def encode(raw: bytes) -> str:
+    """Encode salt or verifier bytes for storage."""
+    return base64.b64encode(raw).decode("ascii")
