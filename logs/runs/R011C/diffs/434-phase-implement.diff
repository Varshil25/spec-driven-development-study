+++ b/tests/cli/test_output_fidelity.py
@@ -77,7 +77,56 @@ def test_sc002_near_miss_control_sample_has_zero_false_positives(run_cli):
     ) + b"\n"
     proc = run_cli(["--count"], stdin=sample)
     assert proc.stdout == sample
-    assert proc.stderr == b"emails=0 ips=0 cards=0\n"
+    assert proc.stderr == b"emails=0 ips=0 cards=0 phones=0\n"
+
+
+def test_sc009_phone_near_miss_control_sample_has_zero_false_positives(run_cli):
+    """Every near miss of the phone rule, in one sample, byte-identical out.
+
+    Zero false positives, zero partial redactions, and — the point of the
+    16-digit Luhn-valid row — no `[CARD]` conjured out of a '+'-prefixed run
+    (FR-032a, SC-009).
+    """
+    sample = b"\n".join(
+        [
+            b"+1234567",                      # 7 digits - below the minimum
+            b"+1234567890123456",             # 16 digits - rejected whole
+            b"+4111111111111111",             # 16 digits and Luhn-valid
+            b"+abc",                          # no digits at all
+            "+١٤١٥٥٥٥٢٦٧١".encode(),
+            b"+",                             # a bare plus
+            b"+1 415 555 2671",               # separators are not this format
+        ]
+    ) + b"\n"
+    proc = run_cli(stdin=sample)
+    assert proc.stdout == sample
+    assert proc.stderr == b""
+    assert proc.returncode == 0
+    assert b"[PHONE]" not in proc.stdout
+    assert b"[CARD]" not in proc.stdout
