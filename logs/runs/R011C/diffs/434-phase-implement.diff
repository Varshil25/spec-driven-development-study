--- /dev/null
+++ b/tests/cli/test_out_dir_failures.py
@@ -0,0 +1,412 @@
+"""FR-048 … FR-051, FR-050a — every way an `--out-dir` run can fail.
+
+Each case asserts both halves of Constitution Principle II: a specific
+diagnostic naming the offending path, and a failure signal. And each asserts
+the two things that keep a failed run from looking like a successful one — no
+`wrote N files` line, no `--count` summary — plus the partial-output guarantee
+(FR-050a): the folder never keeps a truncated file under a legitimate name.
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[2] / "src"
+
+
+def assert_no_stack_trace(stderr):
+    assert b"Traceback" not in stderr
+    assert b"most recent call last" not in stderr
+
+
+def assert_failed_cleanly(proc):
+    """The three marks of a failed run, asserted together everywhere."""
+    assert proc.returncode == 2
+    assert b"wrote" not in proc.stdout
+    assert b"emails=" not in proc.stderr
+    assert_no_stack_trace(proc.stderr)
+
+
+def redacted(path):
+    """What `python -m logredact <path>` writes to stdout, as bytes."""
+    environment = dict(os.environ)
+    environment["PYTHONPATH"] = str(SRC)
+    return subprocess.run(
+        [sys.executable, "-m", "logredact", str(path)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        input=b"",
+        env=environment,
+    ).stdout
+
+
+def assert_folder_holds_only_complete_redactions(out, sources):
+    """SC-013a — every file left in DIR is a complete redaction of its input."""
+    by_name = {Path(source).name: source for source in sources}
+    for leftover in out.iterdir():
+        source = by_name.get(leftover.name)
+        assert source is not None, f"unexpected file left in DIR: {leftover.name}"
+        assert leftover.read_bytes() == redacted(source)
+
+
+def write(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(data)
+    return path
+
+
+# --------------------------------------------------------------------------
+# FR-048 — a FILE that cannot be opened names the FILE, as typed
+# --------------------------------------------------------------------------
+
+
+def test_fr048_an_unopenable_file_is_named_as_typed_on_the_command_line(
+    run_cli, tmp_path
+):
+    write(tmp_path / "real.log", b"a@b.io\n")
+    proc = run_cli(["--out-dir", "clean", "missing.log"], cwd=tmp_path)
+
+    assert_failed_cleanly(proc)
+    assert proc.stdout == b""
+    assert b"missing.log" in proc.stderr
+    assert str(tmp_path).encode() not in proc.stderr
+    assert proc.stderr.startswith(b"python -m logredact: ")
+    assert b"no such file" in proc.stderr.lower()
+
+
+def test_fr048_a_directory_as_input_takes_the_same_path(run_cli, tmp_path):
+    directory = tmp_path / "logs"
+    directory.mkdir()
+    out = tmp_path / "clean"
+
+    proc = run_cli(["--out-dir", str(out), str(directory)])
+
+    assert_failed_cleanly(proc)
+    assert str(directory).encode() in proc.stderr
+
+
+def test_r017_a_file_that_cannot_be_opened_leaves_its_output_name_untouched(
+    run_cli, tmp_path
+):
+    """The input is opened before the sink, so nothing was destroyed (R-017)."""
+    out = tmp_path / "clean"
+    preexisting = write(out / "missing.log", b"PRECIOUS pre-existing contents\n")
+
+    proc = run_cli(["--out-dir", str(out), str(tmp_path / "missing.log")])
+
+    assert_failed_cleanly(proc)
+    assert preexisting.read_bytes() == b"PRECIOUS pre-existing contents\n"
+
+
+def test_us4_2_earlier_output_is_complete_and_later_files_are_never_opened(
+    run_cli, tmp_path
+):
+    good = write(tmp_path / "good.log", b"first a@b.io +14155552671\n")
+    bad = tmp_path / "missing.log"
+    later = write(tmp_path / "later.log", b"LATER-SENTINEL 10.0.0.7\n")
+    out = tmp_path / "clean"
+
+    proc = run_cli(
+        ["--out-dir", str(out), "--count", str(good), str(bad), str(later)]
+    )
+
+    assert_failed_cleanly(proc)
+    assert proc.stdout == b""
+    assert str(bad).encode() in proc.stderr
+    assert str(later).encode() not in proc.stderr
+    assert (out / "good.log").read_bytes() == b"first [EMAIL] [PHONE]\n"
+    assert not (out / "later.log").exists()
+    assert_folder_holds_only_complete_redactions(out, [good])
+
+
+# --------------------------------------------------------------------------
+# FR-049 — DIR cannot be created
+# --------------------------------------------------------------------------
+
+
+def test_fr049_dir_that_cannot_be_created_is_named_and_no_input_is_read(
+    run_cli, tmp_path
+):
+    """`blocker` is a regular file, so `blocker/sub` cannot be made."""
+    blocker = write(tmp_path / "blocker", b"I am a file, not a folder\n")
+    source = write(tmp_path / "app.log", b"SENTINEL a@b.io\n")
+    out = tmp_path / "blocker" / "sub"
+
+    proc = run_cli(["--out-dir", str(out), "--count", str(source)])
+
+    assert_failed_cleanly(proc)
+    assert proc.stdout == b""
+    assert str(out).encode() in proc.stderr
+    assert b"SENTINEL" not in proc.stdout
+    assert not out.exists()
+    # The blocking file is untouched.
+    assert blocker.read_bytes() == b"I am a file, not a folder\n"
+
+
+# --------------------------------------------------------------------------
+# FR-050 — the output file cannot be opened, written, or closed
+# --------------------------------------------------------------------------
+
+
+def test_fr050_an_output_path_that_is_a_directory_names_the_output_not_the_input(
+    run_cli, tmp_path
+):
+    source = write(tmp_path / "app.log", b"a@b.io\n")
+    out = tmp_path / "clean"
+    (out / "app.log").mkdir(parents=True)
+
+    proc = run_cli(["--out-dir", str(out), str(source)])
+
+    assert_failed_cleanly(proc)
+    assert str(out / "app.log").encode() in proc.stderr
+    # The diagnostic blames the output path, not the perfectly readable input.
+    assert proc.stderr.count(str(source).encode()) == 0
+    # ...and the directory is still there: it was never the thing to delete.
+    assert (out / "app.log").is_dir()
+
+
+@pytest.mark.skipif(
+    not os.path.exists("/dev/full"), reason="/dev/full is required to force ENOSPC"
+)
+def test_fr050_a_write_failure_names_the_output_path_and_the_reason(
+    run_cli, tmp_path
+):
+    """A symlink to /dev/full makes every write fail with ENOSPC."""
+    source = write(tmp_path / "app.log", b"".join(b"a@b.io %d\n" % i for i in range(20000)))
+    out = tmp_path / "clean"
+    out.mkdir()
+    (out / "app.log").symlink_to("/dev/full")
+
+    proc = run_cli(["--out-dir", str(out), "--count", str(source)])
+
+    assert_failed_cleanly(proc)
+    assert proc.stdout == b""
+    assert str(out / "app.log").encode() in proc.stderr
+    assert b"No space left on device" in proc.stderr
+
+
+@pytest.mark.skipif(
+    not os.path.exists("/dev/full"), reason="/dev/full is required to force ENOSPC"
+)
+def test_fr050a_the_half_written_file_is_gone_and_is_not_restored(
+    run_cli, tmp_path
+):
+    """US4-9 — the folder is left with no file under that name at all."""
+    source = write(tmp_path / "app.log", b"".join(b"a@b.io %d\n" % i for i in range(20000)))
+    out = tmp_path / "clean"
+    out.mkdir()
+    (out / "app.log").symlink_to("/dev/full")
+
+    proc = run_cli(["--out-dir", str(out), str(source)])
+
+    assert proc.returncode == 2
+    assert not (out / "app.log").exists()
+    assert not (out / "app.log").is_symlink()
+    assert list(out.iterdir()) == []
+
+
+# --------------------------------------------------------------------------
+# FR-050a — a read failure partway through also discards the sink
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.skipif(
+    not os.path.exists("/proc/self/mem"),
+    reason="/proc/self/mem is required to force a mid-read EIO",
+)
+def test_us4_8_a_read_failure_partway_discards_the_sink_it_opened(
+    run_cli, tmp_path
+):
+    """SC-013a — the earlier file stays complete, the failing one leaves nothing."""
+    good = write(tmp_path / "good.log", b"first a@b.io\n")
+    out = tmp_path / "clean"
+    stale = write(out / "mem", b"PRECIOUS pre-existing contents\n")
+
+    proc = run_cli(["--out-dir", str(out), "--count", str(good), "/proc/self/mem"])
+
+    assert_failed_cleanly(proc)
+    assert b"/proc/self/mem" in proc.stderr
+    # The sink opened for the failing input is gone, and "w" had already
+    # destroyed what was there: the previous contents are not restored.
+    assert not stale.exists()
+    assert (out / "good.log").read_bytes() == b"first [EMAIL]\n"
+    assert_folder_holds_only_complete_redactions(out, [good])
+
+
+# --------------------------------------------------------------------------
+# FR-051 — --out-dir with no FILE is invalid usage
+# --------------------------------------------------------------------------
+
+
+def test_fr051_out_dir_with_no_file_is_a_usage_error(run_cli, tmp_path):
+    out = tmp_path / "clean"
+    proc = run_cli(
+        ["--out-dir", str(out)], stdin=b"SENTINEL jane@example.com\n"
+    )
+
+    assert_failed_cleanly(proc)
+    assert proc.stdout == b""
+    assert b"usage:" in proc.stderr
+    assert b"--out-dir" in proc.stderr
+    assert b"at least one FILE" in proc.stderr
+
+
+def test_fr051_stdin_is_not_read_and_dir_is_not_created(run_cli, tmp_path):
+    out = tmp_path / "clean"
+    proc = run_cli(
+        ["--out-dir", str(out), "--count"], stdin=b"SENTINEL jane@example.com\n"
+    )
+
+    assert proc.returncode == 2
+    assert b"SENTINEL" not in proc.stdout
+    assert b"[EMAIL]" not in proc.stdout
+    assert not out.exists()
+
+
+# --------------------------------------------------------------------------
+# FR-029 — the inherited invalid-command-line path, unchanged
+# --------------------------------------------------------------------------
+
+
+def test_fr029_an_unrecognised_flag_is_unchanged_by_this_feature(run_cli, tmp_path):
+    out = tmp_path / "clean"
+    proc = run_cli(["--out-dir", str(out), "--redact-all", "a.log"])
+
+    assert_failed_cleanly(proc)
+    assert b"usage:" in proc.stderr
+    assert b"--redact-all" in proc.stderr
+    assert not out.exists()
+
+
+# --------------------------------------------------------------------------
+# SC-013a, SC-014 — the sweeps across every scenario in this module
+# --------------------------------------------------------------------------
+
+
+def failing_runs(run_cli, tmp_path):
+    """Every failure scenario, each in its own folder, with its sources."""
+    scenarios = []
+
+    # 1. An input that cannot be opened, after one that can.
+    one = tmp_path / "s1"
+    good = write(one / "good.log", b"first a@b.io +14155552671\n")
+    out = one / "clean"
+    scenarios.append(
+        (
+            run_cli(
+                ["--out-dir", str(out), str(good), str(one / "missing.log")]
+            ),
+            out,
+            [good],
+        )
+    )
+
+    # 2. DIR cannot be created.
+    two = tmp_path / "s2"
+    source = write(two / "app.log", b"a@b.io\n")
+    write(two / "blocker", b"file\n")
+    scenarios.append(
+        (run_cli(["--out-dir", str(two / "blocker" / "sub"), str(source)]), None, [])
+    )
+
+    # 3. The output path is a directory.
+    three = tmp_path / "s3"
+    source = write(three / "app.log", b"a@b.io\n")
+    out = three / "clean"
+    (out / "app.log").mkdir(parents=True)
+    scenarios.append((run_cli(["--out-dir", str(out), str(source)]), None, []))
+
+    # 4. --out-dir with no FILE.
+    four = tmp_path / "s4"
+    scenarios.append((run_cli(["--out-dir", str(four / "clean")]), None, []))
+
+    # 5. An unrecognised flag.
+    scenarios.append((run_cli(["--out-dir", str(tmp_path / "s5"), "--nope"]), None, []))
+
+    if os.path.exists("/dev/full"):
+        # 6. A write failure after an earlier file completed.
+        six = tmp_path / "s6"
+        good = write(six / "good.log", b"first a@b.io\n")
+        big = write(
+            six / "big.log", b"".join(b"a@b.io %d\n" % i for i in range(20000))
+        )
+        out = six / "clean"
+        out.mkdir(parents=True)
+        (out / "big.log").symlink_to("/dev/full")
+        scenarios.append(
+            (run_cli(["--out-dir", str(out), str(good), str(big)]), out, [good])
+        )
+
+    if os.path.exists("/proc/self/mem"):
+        # 7. A read failure partway through, after an earlier file completed.
+        seven = tmp_path / "s7"
+        good = write(seven / "good.log", b"first a@b.io\n")
+        out = seven / "clean"
+        scenarios.append(
+            (
+                run_cli(["--out-dir", str(out), str(good), "/proc/self/mem"]),
+                out,
+                [good],
+            )
+        )
+
+    return scenarios
+
+
+def test_sc013a_after_any_failed_run_dir_holds_only_complete_redactions(
+    run_cli, tmp_path
+):
+    for proc, out, sources in failing_runs(run_cli, tmp_path):
+        assert proc.returncode == 2
+        if out is not None:
+            assert_folder_holds_only_complete_redactions(out, sources)
+
+
+def test_sc014_every_failure_scenario_exits_zero_or_two_and_never_anything_else(
+    run_cli, tmp_path
+):
+    """SC-014 — the exit-status set is exactly {0, 2}, in this module too."""
+    statuses = {proc.returncode for proc, _, _ in failing_runs(run_cli, tmp_path)}
+    assert statuses <= {0, 2}
+    assert statuses == {2}
+
+    # ...and the successful counterpart still exits 0.
+    good = write(tmp_path / "ok" / "app.log", b"a@b.io\n")
+    ok = run_cli(["--out-dir", str(tmp_path / "ok" / "clean"), str(good)])
+    assert ok.returncode == 0
+
+
+def test_fr053_this_feature_adds_no_new_exit_status(run_cli, tmp_path):
+    """FR-053 — the status set is still exactly {0, 2}, old paths and new.
+
+    Asserted across both destinations at once: the inherited stdout path and
+    the new --out-dir path, each on a success and on a failure. A third status
+    anywhere would mean this feature invented one.
+    """
+    good = write(tmp_path / "good.log", b"a@b.io +14155552671\n")
+    missing = tmp_path / "missing.log"
+    out = tmp_path / "clean"
+
+    statuses = {
+        run_cli([str(good)]).returncode,
+        run_cli(["--count", str(good)]).returncode,
+        run_cli([str(missing)]).returncode,
+        run_cli(["--out-dir", str(out), str(good)]).returncode,
+        run_cli(["--out-dir", str(out), "--count", str(good)]).returncode,
+        run_cli(["--out-dir", str(out), str(missing)]).returncode,
+        run_cli(["--out-dir", str(out)]).returncode,
+        run_cli(["--redact-all"]).returncode,
+    }
+    assert statuses == {0, 2}
+
+
+def test_sc013_no_failure_path_prints_a_confirmation_line_or_a_summary(
+    run_cli, tmp_path
+):
+    for proc, _, _ in failing_runs(run_cli, tmp_path):
+        assert b"wrote" not in proc.stdout
+        assert b"emails=" not in proc.stderr
+        assert_no_stack_trace(proc.stderr)
