@@ -0,0 +1,276 @@
+"""FR-040 … FR-047, FR-052 — `--out-dir DIR`, the happy paths.
+
+Every assertion here is about what is actually on disk and on the two streams
+after a real process has run, because that is what the contract is about: the
+file name, the folder creation, the replacement of an existing file, the byte
+identity with the stdout run, and the single confirmation line.
+
+Failure handling for this destination lives in test_out_dir_failures.py.
+"""
+
+SAMPLE_ONE = b"user jane@example.com from 10.0.0.7\ncall +14155552671 now\n"
+SAMPLE_TWO = b"card 4111111111111111 charged\nplain line\n"
+
+
+def write(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(data)
+    return path
+
+
+# --------------------------------------------------------------------------
+# FR-041, FR-046 — one output file per FILE, named by its final component
+# --------------------------------------------------------------------------
+
+
+def test_fr041_two_files_are_written_into_a_folder_that_did_not_exist(
+    run_cli, tmp_path
+):
+    one = write(tmp_path / "app.log", SAMPLE_ONE)
+    two = write(tmp_path / "web.log", SAMPLE_TWO)
+    out = tmp_path / "clean"
+    assert not out.exists()
+
+    proc = run_cli(["--out-dir", str(out), str(one), str(two)])
+
+    assert proc.returncode == 0
+    assert proc.stdout == b"wrote 2 files\n"
+    assert proc.stderr == b""
+    assert out.is_dir()
+    assert (out / "app.log").read_bytes() == (
+        b"user [EMAIL] from [IP]\ncall [PHONE] now\n"
+    )
+    assert (out / "web.log").read_bytes() == b"card [CARD] charged\nplain line\n"
+
+
+def test_fr041_the_output_name_drops_the_input_s_directories(run_cli, tmp_path):
+    source = write(tmp_path / "var" / "logs" / "app.log", SAMPLE_ONE)
+    out = tmp_path / "clean"
+
+    proc = run_cli(["--out-dir", str(out), str(source)])
+
+    assert proc.returncode == 0
+    assert proc.stdout == b"wrote 1 files\n"
+    assert (out / "app.log").exists()
+    assert not (out / "var").exists()
+    assert sorted(p.name for p in out.iterdir()) == ["app.log"]
+
+
+def test_fr046_the_confirmation_line_is_never_pluralised(run_cli, tmp_path):
+    source = write(tmp_path / "only.log", SAMPLE_ONE)
+    proc = run_cli(["--out-dir", str(tmp_path / "clean"), str(source)])
+    assert proc.stdout == b"wrote 1 files\n"
+
+
+# --------------------------------------------------------------------------
+# FR-042, FR-045 — DIR is created, parents and all, and never emptied
+# --------------------------------------------------------------------------
+
+
+def test_fr042_every_missing_parent_of_a_deep_output_folder_is_created(
+    run_cli, tmp_path
+):
+    source = write(tmp_path / "app.log", SAMPLE_ONE)
+    out = tmp_path / "a" / "b" / "c" / "clean"
+
+    proc = run_cli(["--out-dir", str(out), str(source)])
+
+    assert proc.returncode == 0
+    assert out.is_dir()
+    assert (out / "app.log").read_bytes().endswith(b"call [PHONE] now\n")
+
+
+def test_fr042_an_existing_folder_is_used_as_it_is_and_never_emptied(
+    run_cli, tmp_path
+):
+    source = write(tmp_path / "app.log", SAMPLE_ONE)
+    out = tmp_path / "clean"
+    bystander = write(out / "unrelated.txt", b"keep me exactly as I am\n")
+
+    proc = run_cli(["--out-dir", str(out), str(source)])
+
+    assert proc.returncode == 0
+    assert bystander.read_bytes() == b"keep me exactly as I am\n"
+    assert (out / "app.log").exists()
+
+
+# --------------------------------------------------------------------------
+# FR-043, SC-012 — an existing file of that name is replaced, never appended to
+# --------------------------------------------------------------------------
+
+
+def test_fr043_a_pre_existing_output_file_is_replaced_not_appended_to(
+    run_cli, tmp_path
+):
+    source = write(tmp_path / "app.log", b"short 10.0.0.7\n")
+    out = tmp_path / "clean"
+    stale = write(out / "app.log", b"stale contents that are much longer\n")
+    stale_length = len(stale.read_bytes())
+
+    proc = run_cli(["--out-dir", str(out), str(source)])
+
+    assert proc.returncode == 0
+    fresh = (out / "app.log").read_bytes()
+    assert fresh == b"short [IP]\n"
+    assert len(fresh) < stale_length
+    assert b"stale" not in fresh
+
+
+# --------------------------------------------------------------------------
+# FR-046 — N counts FILE arguments processed, not files on disk
+# --------------------------------------------------------------------------
+
+
+def test_us3_8_an_empty_input_gives_an_empty_output_file_that_still_counts(
+    run_cli, tmp_path
+):
+    empty = write(tmp_path / "empty.log", b"")
+    other = write(tmp_path / "app.log", SAMPLE_ONE)
+    out = tmp_path / "clean"
+
+    proc = run_cli(["--out-dir", str(out), str(empty), str(other)])
+
+    assert proc.returncode == 0
+    assert proc.stdout == b"wrote 2 files\n"
+    assert (out / "empty.log").read_bytes() == b""
+    assert (out / "empty.log").stat().st_size == 0
+
+
+def test_collisions_two_inputs_with_the_same_basename_leave_one_file(
+    run_cli, tmp_path
+):
+    """Both writes happen and both count; the second replaces the first."""
+    first = write(tmp_path / "a" / "app.log", b"first a@b.io\n")
+    second = write(tmp_path / "b" / "app.log", b"second +14155552671\n")
+    out = tmp_path / "clean"
+
+    proc = run_cli(["--out-dir", str(out), str(first), str(second)])
+
+    assert proc.returncode == 0
+    assert proc.stdout == b"wrote 2 files\n"
+    assert sorted(p.name for p in out.iterdir()) == ["app.log"]
+    assert (out / "app.log").read_bytes() == b"second [PHONE]\n"
+
+
+def test_fr046_the_same_file_named_twice_is_counted_twice(run_cli, tmp_path):
+    source = write(tmp_path / "app.log", SAMPLE_ONE)
+    out = tmp_path / "clean"
+
+    proc = run_cli(["--out-dir", str(out), str(source), str(source)])
+
+    assert proc.returncode == 0
+    assert proc.stdout == b"wrote 2 files\n"
+    assert (out / "app.log").read_bytes() == (
+        b"user [EMAIL] from [IP]\ncall [PHONE] now\n"
+    )
+
+
+# --------------------------------------------------------------------------
+# FR-047, FR-052 — what reaches stdout and stderr
+# --------------------------------------------------------------------------
+
+
+def test_fr052_with_count_the_confirmation_precedes_the_summary(run_cli, tmp_path):
+    one = write(tmp_path / "app.log", SAMPLE_ONE)
+    two = write(tmp_path / "web.log", SAMPLE_TWO)
+    out = tmp_path / "clean"
+
+    proc = run_cli(["--out-dir", str(out), "--count", str(one), str(two)])
+
+    assert proc.returncode == 0
+    assert proc.stdout == b"wrote 2 files\n"
+    assert proc.stderr == b"emails=1 ips=1 cards=1 phones=1\n"
+
+
+def test_fr047_redacted_text_never_reaches_stdout_under_out_dir(run_cli, tmp_path):
+    source = write(tmp_path / "app.log", SAMPLE_ONE)
+    proc = run_cli(["--out-dir", str(tmp_path / "clean"), str(source)])
+    assert proc.stdout == b"wrote 1 files\n"
+    assert b"[EMAIL]" not in proc.stdout
+    assert b"[PHONE]" not in proc.stdout
+
+
+def test_fr047_without_out_dir_output_goes_to_stdout_and_no_wrote_line_appears(
+    run_cli, tmp_path
+):
+    source = write(tmp_path / "app.log", SAMPLE_ONE)
+
+    proc = run_cli([str(source)])
+
+    assert proc.returncode == 0
+    assert proc.stdout == b"user [EMAIL] from [IP]\ncall [PHONE] now\n"
+    assert b"wrote" not in proc.stdout
+    assert proc.stderr == b""
+
+    with_count = run_cli(["--count", str(source)])
+    assert b"wrote" not in with_count.stdout
+    assert with_count.stderr == b"emails=1 ips=1 cards=0 phones=1\n"
+
+
+def test_fr047_stdin_is_not_read_under_out_dir(run_cli, tmp_path):
+    source = write(tmp_path / "app.log", b"plain\n")
+    proc = run_cli(
+        ["--out-dir", str(tmp_path / "clean"), str(source)],
+        stdin=b"SENTINEL jane@example.com\n",
+    )
+    assert proc.returncode == 0
+    assert b"SENTINEL" not in (tmp_path / "clean" / "app.log").read_bytes()
+
+
+# --------------------------------------------------------------------------
+# FR-044 — an output file is byte-identical to the stdout run of the same input
+# --------------------------------------------------------------------------
+
+
+ODD_SAMPLE = (
+    b"user jane@example.com\r\n"
+    b"caf\xe9 undecodable \xff byte\n"
+    b"call +14155552671 and +1234567\n"
+    b"card 4111111111111111 and +4111111111111111\n"
+    b"no final newline"
+)
+
+
+def test_fr044_output_file_bytes_equal_the_stdout_run_of_the_same_input(
+    run_cli, tmp_path
+):
+    """The sink's four open() arguments are what make this exact, not close.
+
+    CRLF, a missing final newline, and an undecodable byte all have to survive
+    identically down both destinations (FR-044, FR-005, FR-005b).
+    """
+    source = write(tmp_path / "odd.log", ODD_SAMPLE)
+    out = tmp_path / "clean"
+
+    to_stdout = run_cli([str(source)])
+    to_folder = run_cli(["--out-dir", str(out), str(source)])
+
+    assert to_stdout.returncode == to_folder.returncode == 0
+    written = (out / "odd.log").read_bytes()
+    assert written == to_stdout.stdout
+    assert b"\r\n" in written
+    assert b"\xff" in written
+    assert not written.endswith(b"\n")
+
+
+def test_fr044_a_crlf_file_is_not_translated_on_the_way_out(run_cli, tmp_path):
+    source = write(tmp_path / "crlf.log", b"one 10.0.0.7\r\ntwo\r\n")
+    out = tmp_path / "clean"
+    run_cli(["--out-dir", str(out), str(source)])
+    assert (out / "crlf.log").read_bytes() == b"one [IP]\r\ntwo\r\n"
+
+
+def test_fr044_several_files_each_match_their_own_stdout_run(run_cli, tmp_path):
+    sources = [
+        write(tmp_path / "a.log", SAMPLE_ONE),
+        write(tmp_path / "b.log", SAMPLE_TWO),
+        write(tmp_path / "c.log", ODD_SAMPLE),
+    ]
+    out = tmp_path / "clean"
+
+    proc = run_cli(["--out-dir", str(out), *(str(p) for p in sources)])
+    assert proc.stdout == b"wrote 3 files\n"
+
+    for source in sources:
+        alone = run_cli([str(source)])
+        assert (out / source.name).read_bytes() == alone.stdout
diff --git a/tests/cli/test_out_dir_failures.py b/tests/cli/test_out_dir_failures.py
