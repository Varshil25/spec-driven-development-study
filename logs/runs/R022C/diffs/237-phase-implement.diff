@@ -0,0 +1,575 @@
+"""CLI-contract tests for the output folder: FR-007, FR-011..FR-027.
+
+Every test here runs the real command in a subprocess via the run_cli fixture,
+so stdout, stderr, the files on disk, and the exit status are the ones the
+process actually produced. Test ids are fixed by the requirement -> test map in
+specs/002-phone-redact-out-dir/quickstart.md (the SC-004 coverage artifact).
+
+Output-file contents are read in **binary** wherever line fidelity is the point:
+FR-015 is a claim about bytes, and a text-mode read would translate the CRLF
+terminators that are exactly what the claim is about.
+"""
+
+import os
+import time
+
+import pytest
+
+
+# --- FR-011, FR-013, FR-014: the option, and where output goes -----------
+
+
+def test_fr011_out_dir_value_taken_literally_in_any_position(
+    run_cli, tmp_path, monkeypatch
+):
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+    web = tmp_path / "web.log"
+    web.write_text("GET / from 10.0.0.7\n", encoding="utf-8")
+
+    # Before, between, and after FILE arguments, and alongside --count.
+    for index, args in enumerate(
+        (
+            ("--out-dir", "{dir}", app, web),
+            (app, "--out-dir", "{dir}", web),
+            (app, web, "--out-dir", "{dir}"),
+            ("--count", app, "--out-dir", "{dir}", web),
+        )
+    ):
+        out_dir = tmp_path / f"clean{index}"
+        filled = [str(out_dir) if arg == "{dir}" else arg for arg in args]
+        result = run_cli(*filled)
+        assert result.returncode == 0, result.stderr
+        assert result.stdout == "wrote 2 files\n"
+        assert (out_dir / "app.log").read_text(encoding="utf-8") == "user [EMAIL]\n"
+        assert (out_dir / "web.log").read_text(encoding="utf-8") == "GET / from [IP]\n"
+
+    # Contract W-10: the token after --out-dir is taken *literally*, whatever
+    # its shape. "--count" becomes the folder name and is NOT enabled as an
+    # option, so no tally is printed and stderr is empty.
+    #
+    # The folder name has to stay relative for the token to start with "-", so
+    # the subprocess's working directory is moved into tmp_path first -- it
+    # inherits the parent's cwd, and conftest.py stays unchanged (SC-005).
+    monkeypatch.chdir(tmp_path)
+    result = run_cli("--out-dir", "--count", app)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "wrote 1 files\n"
+    assert result.stderr == ""
+    assert (tmp_path / "--count").is_dir()
+    assert (tmp_path / "--count" / "app.log").read_text(
+        encoding="utf-8"
+    ) == "user [EMAIL]\n"
+
+
+def test_fr013_redacted_lines_go_to_files_not_stdout(run_cli, tmp_path):
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\ntel +14155552671\n", encoding="utf-8")
+    out_dir = tmp_path / "clean"
+
+    result = run_cli("--out-dir", out_dir, app)
+    assert result.returncode == 0, result.stderr
+    # Only the one line -- no redacted content, and no per-file progress.
+    assert result.stdout == "wrote 1 files\n"
+    assert "[EMAIL]" not in result.stdout
+    assert "[PHONE]" not in result.stdout
+    assert (out_dir / "app.log").read_text(encoding="utf-8") == (
+        "user [EMAIL]\ntel [PHONE]\n"
+    )
+
+
+def test_fr014_output_named_by_basename_only(run_cli, tmp_path):
+    nested = tmp_path / "logs" / "2026"
+    nested.mkdir(parents=True)
+    (nested / "app.log").write_text("user jane@example.com\n", encoding="utf-8")
+    out_dir = tmp_path / "clean"
+
+    result = run_cli("--out-dir", out_dir, nested / "app.log")
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "wrote 1 files\n"
+    # The final path component only (contract W-4).
+    assert sorted(os.listdir(out_dir)) == ["app.log"]
+    # The input's directories are NOT reproduced inside the folder.
+    assert not (out_dir / "logs").exists()
+
+
+# --- FR-015, FR-016, FR-017: fidelity, creation, truncation --------------
+
+
+def test_fr015_output_file_byte_identical_to_stdout_including_crlf_and_no_final_newline(
+    run_cli, tmp_path
+):
+    # Written as bytes so no encoding layer in the test can normalise anything.
+    # No trailing newline on the last line, deliberately.
+    body = b"a@b.io\r\n\r\nno final newline 10.0.0.7"
+    source = tmp_path / "fidelity.log"
+    source.write_bytes(body)
+    out_dir = tmp_path / "clean"
+
+    to_stdout = run_cli(source)
+    assert to_stdout.returncode == 0, to_stdout.stderr
+
+    to_folder = run_cli("--out-dir", out_dir, source)
+    assert to_folder.returncode == 0, to_folder.stderr
+    assert to_folder.stdout == "wrote 1 files\n"
+
+    # The decisive assertion: the file's *bytes* equal the stdout bytes exactly.
+    # This is the whole of FR-015, and the one invariant that breaks silently if
+    # the output file's open arguments diverge from the stdout wrapper's.
+    assert (out_dir / "fidelity.log").read_bytes() == to_stdout.stdout.encode("utf-8")
+    assert (out_dir / "fidelity.log").read_bytes() == (
+        b"[EMAIL]\r\n\r\nno final newline [IP]"
+    )
+    # No newline is invented for the final line.
+    assert not (out_dir / "fidelity.log").read_bytes().endswith(b"\n")
+
+
+def test_fr016_creates_dir_with_missing_parents_and_reuses_existing(run_cli, tmp_path):
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+
+    # Missing intermediate directories are created in full.
+    deep = tmp_path / "out" / "2026" / "clean"
+    result = run_cli("--out-dir", deep, app)
+    assert result.returncode == 0, result.stderr
+    assert deep.is_dir()
+    assert (deep / "app.log").read_text(encoding="utf-8") == "user [EMAIL]\n"
+
+    # A second run into an already-existing folder reuses it, and leaves an
+    # unrelated pre-existing file in it untouched.
+    unrelated = deep / "keep.txt"
+    unrelated.write_text("do not touch\n", encoding="utf-8")
+    result = run_cli("--out-dir", deep, app)
+    assert result.returncode == 0, result.stderr
+    assert unrelated.read_text(encoding="utf-8") == "do not touch\n"
+    assert sorted(os.listdir(deep)) == ["app.log", "keep.txt"]
+
+
+def test_fr017_existing_output_file_truncated_no_leftover_bytes(run_cli, tmp_path):
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+    out_dir = tmp_path / "clean"
+    out_dir.mkdir()
+    # Pre-fill the output file with far more content than the run will write.
+    (out_dir / "app.log").write_text("X" * 5000, encoding="utf-8")
+
+    result = run_cli("--out-dir", out_dir, app)
+    assert result.returncode == 0, result.stderr
+
+    expected = b"user [EMAIL]\n"
+    written = (out_dir / "app.log").read_bytes()
+    # Size equals the redacted content exactly: no trailing remnant survives.
+    assert written == expected
+    assert len(written) == len(expected)
+    assert b"X" not in written
+
+
+# --- FR-018, FR-021, FR-022: the wrote line, last-wins, the default ------
+
+
+def test_fr018_wrote_n_files_line_counts_files_processed_and_exits_zero(
+    run_cli, tmp_path
+):
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+    web = tmp_path / "web.log"
+    web.write_text("GET / from 10.0.0.7\n", encoding="utf-8")
+
+    # Two FILE arguments.
+    result = run_cli("--out-dir", tmp_path / "c1", app, web)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "wrote 2 files\n"
+
+    # One FILE argument: the plural noun is fixed, with no pluralisation
+    # branch, so this reads "1 files" by design (R5.12).
+    result = run_cli("--out-dir", tmp_path / "c2", app)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "wrote 1 files\n"
+
+    # The same path given twice is two independent sources, read twice and
+    # written twice, so it still counts 2 (R5.11).
+    result = run_cli("--out-dir", tmp_path / "c3", app, app)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "wrote 2 files\n"
+
+    # Two inputs sharing a basename collide on one output path; both are
+    # counted, and the *second* argument's content is what survives.
+    first_dir = tmp_path / "a"
+    second_dir = tmp_path / "b"
+    first_dir.mkdir()
+    second_dir.mkdir()
+    (first_dir / "app.log").write_text("first a@b.io\n", encoding="utf-8")
+    (second_dir / "app.log").write_text("second 1.2.3.4\n", encoding="utf-8")
+    collide = tmp_path / "c4"
+    result = run_cli(
+        "--out-dir", collide, first_dir / "app.log", second_dir / "app.log"
+    )
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "wrote 2 files\n"
+    assert sorted(os.listdir(collide)) == ["app.log"]
+    assert (collide / "app.log").read_text(encoding="utf-8") == "second [IP]\n"
+
+    # A readable but empty input produces an empty output file, still counted.
+    empty = tmp_path / "empty.log"
+    empty.write_bytes(b"")
+    empty_dir = tmp_path / "c5"
+    result = run_cli("--out-dir", empty_dir, empty)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "wrote 1 files\n"
+    assert (empty_dir / "empty.log").read_bytes() == b""
+
+
+def test_fr021_last_out_dir_value_wins(run_cli, tmp_path):
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+    first = tmp_path / "first"
+    second = tmp_path / "second"
+
+    result = run_cli("--out-dir", first, "--out-dir", second, app)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "wrote 1 files\n"
+    assert (second / "app.log").read_text(encoding="utf-8") == "user [EMAIL]\n"
+    # The discarded value never reaches makedirs, so `first` is never created.
+    assert not first.exists()
+
+
+def test_fr022_without_out_dir_output_unchanged_and_no_file_created(run_cli, tmp_path):
+    work = tmp_path / "work"
+    work.mkdir()
+    app = work / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+    web = work / "web.log"
+    web.write_text("GET / from 10.0.0.7\n", encoding="utf-8")
+
+    before = sorted(os.listdir(work))
+    result = run_cli(app, web)
+    assert result.returncode == 0, result.stderr
+    # Redacted lines go to stdout, exactly as they always have.
+    assert result.stdout == "user [EMAIL]\nGET / from [IP]\n"
+    # No `wrote N files` line.
+    assert "wrote" not in result.stdout
+    assert result.stderr == ""
+    # No file created anywhere.
+    assert sorted(os.listdir(work)) == before
+    assert sorted(os.listdir(tmp_path)) == ["work"]
+
+
+# --- FR-019: folder mode with a tally ------------------------------------
+
+
+def test_fr019_out_dir_with_count_writes_both_lines_in_order(run_cli, tmp_path):
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+    web = tmp_path / "web.log"
+    web.write_text("GET / from 10.0.0.7\n", encoding="utf-8")
+    out_dir = tmp_path / "clean"
+
+    # Contract W-5, the normative block.
+    result = run_cli("--count", "--out-dir", out_dir, app, web)
+    assert result.returncode == 0, result.stderr
+    # stdout carries only the wrote line -- no redacted content.
+    assert result.stdout == "wrote 2 files\n"
+    # Exactly one tally, covering all files combined.
+    assert result.stderr == "emails=1 ips=1 cards=0 phones=0\n"
+    assert result.stderr.count("\n") == 1
+
+    # Merged into one pipe, the tally is observably *after* the stdout line,
+    # which is what "after all standard output" means in folder mode (R4.9).
+    merged = run_cli(
+        "--count", "--out-dir", tmp_path / "clean2", app, web, merge_stderr=True
+    )
+    assert merged.returncode == 0
+    assert merged.stdout.splitlines() == [
+        "wrote 2 files",
+        "emails=1 ips=1 cards=0 phones=0",
+    ]
+
+
+# --- FR-007: the phone rule reaches every destination --------------------
+
+
+def test_fr007_phone_redacted_for_stdin_files_stdout_and_out_dir(run_cli, tmp_path):
+    body = "user jane@example.com tel +14155552671 from 10.0.0.7\n"
+    expected = "user [EMAIL] tel [PHONE] from [IP]\n"
+
+    app = tmp_path / "app.log"
+    app.write_text(body, encoding="utf-8")
+    out_dir = tmp_path / "clean"
+
+    # stdin -> stdout.
+    via_stdin = run_cli(stdin=body)
+    assert via_stdin.returncode == 0, via_stdin.stderr
+    assert via_stdin.stdout == expected
+
+    # FILE -> stdout.
+    via_file = run_cli(app)
+    assert via_file.returncode == 0, via_file.stderr
+    assert via_file.stdout == expected
+
+    # FILE -> --out-dir. Identical redaction, byte for byte.
+    via_folder = run_cli("--out-dir", out_dir, app)
+    assert via_folder.returncode == 0, via_folder.stderr
+    assert (out_dir / "app.log").read_bytes() == expected.encode("utf-8")
+
+
+# --- FR-012, FR-020: command-line misuse --------------------------------
+#
+# SC-006 requires each of these to assert the diagnostic *and* the exit status.
+# For OS failures the reason text comes from the OS, so a stable substring is
+# asserted rather than the whole strerror string (contract C-4, 001/D-009).
+
+USAGE_LINE = "usage: python -m logredact [--count] [FILE ...]\n"
+
+
+def test_fr012_out_dir_without_value_usage_error_nothing_read(run_cli, tmp_path):
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+
+    # Contract W-7: --out-dir as the final token, with nothing after it.
+    result = run_cli(app, "--out-dir")
+    assert result.returncode == 2
+    # The usage line is the **unchanged v1 text** and deliberately does not
+    # mention --out-dir (research D-105, R7.2).
+    assert result.stderr == USAGE_LINE + "logredact: --out-dir requires a directory\n"
+    # Nothing on stdout, and app.log is never opened: no redacted content.
+    assert result.stdout == ""
+    assert "[EMAIL]" not in result.stdout
+    # No directory is created anywhere.
+    assert sorted(os.listdir(tmp_path)) == ["app.log"]
+
+
+def test_fr020_out_dir_without_file_errors_without_reading_stdin(run_cli, tmp_path):
+    nope = tmp_path / "nope"
+
+    # Contract W-8: stdin is supplied, but must not be read. Without this
+    # check the run would fall through to the stdin branch and stream redacted
+    # data to stdout, making the option look as though it had worked.
+    result = run_cli("--out-dir", nope, stdin="a@b.io\n")
+    assert result.returncode == 2
+    # No usage line here: this is a semantic failure, not a malformed command
+    # line (R7.1).
+    assert result.stderr == "logredact: --out-dir requires at least one FILE\n"
+    assert result.stdout == ""
+    assert "[EMAIL]" not in result.stdout
+    # The folder is not created, so this invocation has no filesystem effect.
+    assert not nope.exists()
+
+
+# --- FR-024, FR-025: the folder and the output file ----------------------
+
+
+def test_fr024_uncreatable_dir_names_path_and_exits_2(run_cli, tmp_path):
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+
+    # Case 1 (contract W-9): the folder path is an existing regular file.
+    plain = tmp_path / "plainfile"
+    plain.write_text("in the way\n", encoding="utf-8")
+    result = run_cli("--out-dir", plain, app)
+    assert result.returncode == 2
+    assert f"logredact: {plain}: " in result.stderr
+    assert "File exists" in result.stderr
+    assert result.stdout == ""
+    assert "wrote" not in result.stdout
+    # The input was never opened, and the blocking file is untouched.
+    assert plain.read_text(encoding="utf-8") == "in the way\n"
+
+    # Case 2: a *parent* component of the folder path is a regular file. The
+    # diagnostic names the path **as the user gave it**, not the failing
+    # intermediate component (research D-107).
+    blocker = tmp_path / "blocker"
+    blocker.write_text("also in the way\n", encoding="utf-8")
+    nested = blocker / "clean"
+    result = run_cli("--out-dir", nested, app)
+    assert result.returncode == 2
+    assert f"logredact: {nested}: " in result.stderr
+    assert result.stdout == ""
+    assert "wrote" not in result.stdout
+    # Exactly one diagnostic line, and no traceback.
+    assert result.stderr.count("\n") == 1
+    assert "Traceback" not in result.stderr
+
+
+def test_fr025_unwritable_output_file_names_output_path_and_exits_2(run_cli, tmp_path):
+    nested = tmp_path / "logs" / "2026"
+    nested.mkdir(parents=True)
+    app = nested / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+
+    # A directory sits exactly where the output file should go, so creating it
+    # fails -- while the *input* is perfectly readable.
+    out_dir = tmp_path / "clean2"
+    (out_dir / "app.log").mkdir(parents=True)
+
+    result = run_cli("--out-dir", out_dir, app)
+    assert result.returncode == 2
+    # The diagnostic names the **output** path, not the input path. That
+    # distinction is FR-025 vs FR-023.
+    assert f"logredact: {out_dir / 'app.log'}: " in result.stderr
+    assert "Is a directory" in result.stderr
+    assert str(app) not in result.stderr
+    assert result.stdout == ""
+    assert "wrote" not in result.stdout
+    assert "Traceback" not in result.stderr
+
+
+# --- FR-023, FR-026: sequencing and suppression --------------------------
+
+
+def test_fr023_unreadable_file_names_input_path_stops_and_exits_2(run_cli, tmp_path):
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+    missing = tmp_path / "missing.log"
+    later = tmp_path / "later.log"
+    later.write_text("LATER 10.0.0.7\n", encoding="utf-8")
+    out_dir = tmp_path / "clean"
+
+    # Contract W-6: readable, then missing, then a third that must stay unread.
+    result = run_cli("--out-dir", out_dir, app, missing, later, "--count")
+    assert result.returncode == 2
+    # The first input's output file has been written and stays written: it is
+    # already-sanitised data and is not retracted (R7.5).
+    assert (out_dir / "app.log").read_text(encoding="utf-8") == "user [EMAIL]\n"
+    # The diagnostic names the **input** path (FR-023, not FR-025).
+    assert f"logredact: {missing}: " in result.stderr
+    assert "No such file or directory" in result.stderr
+    # No later FILE is opened.
+    assert not (out_dir / "later.log").exists()
+    # Because the input is opened first, no stray empty output file is created
+    # for the failing input (R7.4).
+    assert not (out_dir / "missing.log").exists()
+    assert sorted(os.listdir(out_dir)) == ["app.log"]
+    # Neither line, and --count does not change that.
+    assert "wrote" not in result.stdout
+    assert "emails=" not in result.stderr
+
+
+def test_fr026_no_wrote_line_and_no_tally_on_any_exit_2_path(run_cli, tmp_path):
+    """All five new failure modes, plus the pre-existing unrecognised option.
+
+    Every case runs **with --count**, which is the point: the flag must not be
+    able to coax a tally out of a failing run (FR-026, R4.5a).
+    """
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+
+    plain = tmp_path / "plainfile"
+    plain.write_text("in the way\n", encoding="utf-8")
+
+    blocked_dir = tmp_path / "blocked"
+    (blocked_dir / "app.log").mkdir(parents=True)
+
+    cases = {
+        # FR-012: --out-dir with no value.
+        "no_value": (app, "--count", "--out-dir"),
+        # FR-020: --out-dir with no FILE.
+        "no_file": ("--count", "--out-dir", tmp_path / "unused"),
+        # FR-024: folder path is an existing regular file.
+        "uncreatable_dir": ("--count", "--out-dir", plain, app),
+        # FR-025: output file cannot be created.
+        "unwritable_output": ("--count", "--out-dir", blocked_dir, app),
+        # FR-023: unreadable FILE.
+        "unreadable_input": (
+            "--count",
+            "--out-dir",
+            tmp_path / "c_unreadable",
+            tmp_path / "missing.log",
+        ),
+        # 001/FR-024: the pre-existing unrecognised-option path.
+        "unrecognized_option": ("--count", "--verbose", app),
+    }
+
+    for name, args in cases.items():
+        result = run_cli(*args, stdin="LEAK x@y.io\n")
+        assert result.returncode == 2, f"{name}: expected exit 2, got {result.returncode}"
+        # No `wrote N files` line on stdout, in any of them.
+        assert "wrote" not in result.stdout, name
+        # No tally on stderr, in any of them.
+        assert "emails=" not in result.stderr, name
+        # And a diagnostic was actually produced -- failing silently would
+        # satisfy the two assertions above while being far worse.
+        assert result.stderr != "", name
+        assert "Traceback" not in result.stderr, name
+
+
+# --- Success criteria spanning the whole feature -------------------------
+
+
+def test_sc001_worked_examples_reproduce_exactly(run_cli, tmp_path):
+    """The normative W-1, W-2, and W-3 blocks from contracts/cli.md.
+
+    Byte-for-byte: which stream each byte goes to, the files created, their
+    contents, and the exit status.
+    """
+    # W-1 -- phone redaction on a piped stream.
+    result = run_cli(stdin="call +14155552671 now\n")
+    assert result.stdout == "call [PHONE] now\n"
+    assert result.stderr == ""
+    assert result.returncode == 0
+
+    # W-2 -- the four-figure tally.
+    result = run_cli("--count", stdin="a@b.io +442071838750\n")
+    assert result.stdout == "[EMAIL] [PHONE]\n"
+    assert result.stderr == "emails=1 ips=0 cards=0 phones=1\n"
+    assert result.returncode == 0
+
+    # W-3 -- output folder. Two files, a folder that does not exist yet.
+    app = tmp_path / "app.log"
+    app.write_text("user jane@example.com\n", encoding="utf-8")
+    web = tmp_path / "web.log"
+    web.write_text("GET / from 10.0.0.7\n", encoding="utf-8")
+    clean = tmp_path / "clean"
+    assert not clean.exists()
+
+    result = run_cli("--out-dir", clean, app, web)
+    assert result.stdout == "wrote 2 files\n"
+    assert result.stderr == ""
+    assert result.returncode == 0
+    # `clean/` is created if absent, holding one file per input.
+    assert sorted(os.listdir(clean)) == ["app.log", "web.log"]
+    assert (clean / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert (clean / "web.log").read_bytes() == b"GET / from [IP]\n"
+
+
+def test_sc007_streams_large_input_to_folder_within_budget(run_cli, tmp_path):
+    big = tmp_path / "big.log"
+    with open(big, "w", encoding="utf-8", newline="") as handle:
+        for index in range(100_000):
+            handle.write(
+                f"{index} user jane@example.com from 10.0.0.7 "
+                f"card 4111 1111 1111 1111 tel +442071838750\n"
+            )
+
+    # To stdout, within the budget.
+    started = time.monotonic()
+    to_stdout = run_cli(big)
+    stdout_elapsed = time.monotonic() - started
+    assert to_stdout.returncode == 0, to_stdout.stderr
+    assert stdout_elapsed < 10, f"stdout took {stdout_elapsed:.2f}s, budget is 10s"
+
+    # To a folder, within the same budget.
+    out_dir = tmp_path / "bigout"
+    started = time.monotonic()
+    to_folder = run_cli("--count", "--out-dir", out_dir, big)
+    folder_elapsed = time.monotonic() - started
+    assert to_folder.returncode == 0, to_folder.stderr
+    assert folder_elapsed < 10, f"--out-dir took {folder_elapsed:.2f}s, budget is 10s"
+    assert to_folder.stdout == "wrote 1 files\n"
+    assert to_folder.stderr == (
+        "emails=100000 ips=100000 cards=100000 phones=100000\n"
+    )
+
+    # The two destinations agree byte for byte.
+    assert (out_dir / "big.log").read_bytes() == to_stdout.stdout.encode("utf-8")
+
+    # A 1 MB single line through stdin, to show memory does not track line
+    # length: only one line is ever resident.
+    long_line = "x" * 1_000_000 + " +442071838750\n"
+    result = run_cli(stdin=long_line)
+    assert result.returncode == 0
+    assert result.stdout == "x" * 1_000_000 + " [PHONE]\n"
+    # 1_000_000 x's + " " + "[PHONE]" (7) + "\n". The quickstart quotes
+    # 1000008 for this line, but its own breakdown sums to 1000009; the
+    # arithmetic here is the breakdown, not the typo.
+    assert len(result.stdout) == 1_000_000 + 1 + len("[PHONE]") + 1
+    assert len(result.stdout) == 1_000_009
