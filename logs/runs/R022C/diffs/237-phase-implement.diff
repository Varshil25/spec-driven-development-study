+"""Engine-level tests for the phone rule: FR-001..FR-006, FR-009.
+
+These call redact_text directly rather than through a subprocess, because the
+recognition criteria are a property of the engine, not of the command line
+(quickstart "Requirement -> test map"). The CLI-level phone test is
+test_out_dir.py::test_fr007_phone_redacted_for_stdin_files_stdout_and_out_dir.
+"""
+
+from logredact.redact import Counts, redact_text
+
+
+# --- FR-001, FR-002, FR-003: recognition and replacement -----------------
+
+
+def test_fr001_phone_replaced_with_placeholder():
+    # Spec Scenario 1.1.
+    assert redact_text("call +14155552671 now")[0] == "call [PHONE] now"
+    # Spec Scenario 1.2 -- every occurrence, not just the first.
+    assert (
+        redact_text("+442071838750 and +14155552671")[0] == "[PHONE] and [PHONE]"
+    )
+
+
+def test_fr002_recognises_plus_then_8_to_15_digits():
+    # The two realistic lengths from the spec: 11 and 12 digits.
+    assert redact_text("+14155552671")[0] == "[PHONE]"
+    assert redact_text("+442071838750")[0] == "[PHONE]"
+    # The exact bounds, which is where an off-by-one in {8,15} would show.
+    assert redact_text("+12345678")[0] == "[PHONE]"          # exactly 8
+    assert redact_text("+123456789012345")[0] == "[PHONE]"   # exactly 15
+
+
+def test_fr003_plus_sign_is_consumed_by_the_placeholder():
+    # The "+" is inside the match, so no stray sign is left beside the
+    # placeholder. This is what a lookbehind-based rule would get wrong.
+    output = redact_text("+14155552671")[0]
+    assert output == "[PHONE]"
+    assert "+" not in output
+
+
+# --- FR-004, FR-005: the bounds, and what must not change ----------------
+
+
+def test_fr004_sixteen_or_more_digits_never_partially_replaced():
+    # Spec Scenario 1.4. A "+" then 16 digits is abandoned entirely: the
+    # candidate is not shortened to a 15-digit match.
+    line = "ref +1234567890123456"
+    output = redact_text(line)[0]
+    assert output == line
+    # Asserted specifically, so a corrupted partial such as "[PHONE]67" --
+    # which would also leak part of the value -- fails this test.
+    assert "[PHONE]" not in output
+
+
+def test_fr005_too_few_digits_unchanged_and_preceding_text_unconstrained():
+    # Too few digits: 7 is not a phone number (spec Scenario 1.3).
+    assert redact_text("ext +1234567")[0] == "ext +1234567"
+    # Arithmetic is untouched (spec Scenario 1.5).
+    assert redact_text("total 100+25 units")[0] == "total 100+25 units"
+    # What precedes the "+" places no constraint on the match: there is no
+    # leading lookbehind, deliberately (D-101).
+    assert redact_text("100+14155552671")[0] == "100[PHONE]"
+    # The match starts at the *second* "+", because \+ cannot match a "+" that
+    # is followed by another "+".
+    assert redact_text("++14155552671")[0] == "+[PHONE]"
+    # Separators inside the number are not permitted (spec Edge Cases).
+    assert redact_text("+1 415 555 2671")[0] == "+1 415 555 2671"
+    assert redact_text("+1-415-555-2671")[0] == "+1-415-555-2671"
+
+
+# --- FR-006: precedence across all four rules ----------------------------
+
+
+def test_fr006_precedence_email_ipv4_phone_card_and_placeholders_not_reexamined():
+    # Email wins at an equal start position, so the whole address goes and the
+    # domain is not left exposed as "[PHONE]@b.io" would leave it (R3.18).
+    assert redact_text("+12345678@b.io")[0] == "[EMAIL]"
+    # Email also wins from an earlier start.
+    assert redact_text("x+12345678@b.io")[0] == "[EMAIL]"
+    # Adjacent and non-overlapping: both rules fire.
+    assert (
+        redact_text("jane@example.com+14155552671")[0] == "[EMAIL][PHONE]"
+    )
+    # The dotted form is an IPv4 address, not a phone number.
+    assert redact_text("+1.2.3.4")[0] == "+[IP]"
+    # 16 digits, so the phone rule declines under FR-004; the card pass then
+    # sees the raw digits and they are Luhn-valid (R3.10a).
+    assert redact_text("+4111111111111111")[0] == "+[CARD]"
+    # All four rules on one line, in the spec's own example (Scenario 1.6).
+    assert (
+        redact_text("a@b.io 10.0.0.7 4111 1111 1111 1111 +442071838750")[0]
+        == "[EMAIL] [IP] [CARD] [PHONE]"
+    )
+    # A placeholder already in the input is never re-examined, and never counted.
+    redacted, counts = redact_text("[PHONE] already here")
+    assert redacted == "[PHONE] already here"
+    assert counts.phones == 0
+
+
+# --- FR-009: the phones figure ------------------------------------------
+
+
+def test_fr009_phones_counts_occurrences_and_zero_when_none():
+    # Occurrences, not distinct values: the same number three times is three.
+    _, counts = redact_text("+14155552671 +14155552671 +14155552671")
+    assert counts.phones == 3
+
+    # Nothing redactable gives zeroes across the board, not omissions.
+    redacted, counts = redact_text("nothing sensitive here")
+    assert redacted == "nothing sensitive here"
+    assert counts == Counts(0, 0, 0, 0)
+
+    # The other three figures keep their existing meanings on a mixed line.
+    _, counts = redact_text(
+        "a@b.io c@d.io 10.0.0.7 4111 1111 1111 1111 +442071838750"
+    )
+    assert counts == Counts(emails=2, ips=1, cards=1, phones=1)