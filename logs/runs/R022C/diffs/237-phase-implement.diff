+def test_fr027_v1_contract_examples_unchanged(run_cli, tmp_path):
+    """The v1 contract's E-1..E-7, re-run against the changed tool.
+
+    All reproduce unchanged **except E-3's tally line**, which gains the fourth
+    figure. This is the whole of FR-027 and SC-005 at the contract level
+    (specs/001-logredact-cli/contracts/cli.md).
+    """
+    # E-1 -- stdin, mixed values.
+    result = run_cli(stdin="user jane@example.com from 10.0.0.7\n")
+    assert result.stdout == "user [EMAIL] from [IP]\n"
+    assert result.stderr == ""
+    assert result.returncode == 0
+
+    # E-2 -- grouped card redacted, Luhn-invalid run preserved.
+    result = run_cli(stdin="paid with 4111 1111 1111 1111, ref 1234567890123\n")
+    assert result.stdout == "paid with [CARD], ref 1234567890123\n"
+    assert result.returncode == 0
+
+    # E-3 -- the one change: the tally gains `phones=0`. stdout is untouched.
+    result = run_cli("--count", stdin="a@b.io 1.2.3.4\n")
+    assert result.stdout == "[EMAIL] [IP]\n"
+    assert result.stderr == "emails=1 ips=1 cards=0 phones=0\n"
+    assert result.returncode == 0
+
+    first = tmp_path / "a.log"
+    first.write_text("first a@b.io\n", encoding="utf-8")
+    second = tmp_path / "b.log"
+    second.write_text("second 1.2.3.4\n", encoding="utf-8")
+
+    # E-4 -- files in argument order, stdin ignored.
+    result = run_cli(first, second, stdin="LEAK x@y.io\n")
+    assert result.stdout == "first [EMAIL]\nsecond [IP]\n"
+    assert "LEAK" not in result.stdout
+    assert result.returncode == 0
+
+    # E-5 -- unreadable file mid-list: earlier output stays, no tally, exit 2.
+    missing = tmp_path / "missing.log"
+    result = run_cli(first, missing, "--count")
+    assert result.returncode == 2
+    assert result.stdout == "first [EMAIL]\n"
+    assert f"logredact: {missing}: " in result.stderr
+    assert "No such file or directory" in result.stderr
+    assert "emails=" not in result.stderr
+
+    # E-6 -- unrecognised option. The usage line is byte-identical to v1 and
+    # still does not mention --out-dir (research D-105).
+    result = run_cli("--verbose", first)
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr == (
+        "usage: python -m logredact [--count] [FILE ...]\n"
+        "logredact: unrecognized option: --verbose\n"
+    )
+
+    # E-7 -- closed output: status 141, no traceback. Driven directly rather
+    # than through run_cli, because a closed pipe is the whole point.
+    import signal
+    import subprocess
+    import sys
+    from pathlib import Path
+
+    big = tmp_path / "big.log"
+    big.write_text("a@b.io\n" * 50_000, encoding="utf-8")
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(Path(__file__).resolve().parent.parent / "src")
+    producer = subprocess.Popen(
+        [sys.executable, "-m", "logredact", str(big)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        env=env,
+    )
+    head = subprocess.run(
+        ["head", "-2"], stdin=producer.stdout, stdout=subprocess.PIPE, check=False
+    )
+    producer.stdout.close()
+    producer.wait()
+    stderr = producer.stderr.read().decode("utf-8")
+    producer.stderr.close()
+    assert head.stdout == b"[EMAIL]\n[EMAIL]\n"
+    # Popen reports a signal death as a negative signal number; the shell
+    # renders that same outcome as 128 + SIGPIPE = 141, which is the figure the
+    # contract quotes. Both are the same event.
+    assert producer.returncode == -signal.SIGPIPE, producer.returncode
+    assert 128 + signal.SIGPIPE == 141
+    # stderr is empty -- no traceback (research D-010).
+    assert stderr == ""
