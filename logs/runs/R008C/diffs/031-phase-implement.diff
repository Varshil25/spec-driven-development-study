+    def add_many(self, bookmarks: Iterable[tuple[str, str, Iterable[str]]]) -> list[int]:
+        """Store several ``(url, title, tags)`` triples in one transaction.
+
+        Either every bookmark is stored or, if the database rejects one of
+        them, none of them are.  Returns the new ids in input order.
+        """
+        ids: list[int] = []
+        with self._conn:
+            for url, title, tags in bookmarks:
+                cursor = self._conn.execute(
+                    "INSERT INTO bookmarks (url, title) VALUES (?, ?)", (url, title)
+                )
+                bookmark_id = int(cursor.lastrowid)
+                self._conn.executemany(
+                    "INSERT INTO tags (bookmark_id, tag) VALUES (?, ?)",
+                    [(bookmark_id, tag) for tag in sorted(set(tags))],
+                )
+                ids.append(bookmark_id)
+        return ids
+
