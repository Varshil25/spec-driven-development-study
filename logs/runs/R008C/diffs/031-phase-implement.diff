+def cmd_import(args: argparse.Namespace, store: Store) -> int:
+    """Add every bookmark in a file, or nothing at all if it is unusable."""
+    try:
+        text = read_import_file(args.file)
+        if args.format == "csv":
+            new = read_csv(text)
+        else:
+            new = read_json(text)
+    except BadImportFile as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return EXIT_BAD_IMPORT
+    store.add_many(new)
+    print(f"imported {len(new)}")
+    return EXIT_OK
+
+
+def read_import_file(path: str) -> str:
+    try:
+        # newline="" leaves line endings alone, as the csv module wants.
+        with open(path, encoding="utf-8", newline="") as handle:
+            return handle.read()
+    except UnicodeDecodeError:
+        raise BadImportFile(f"{path} is not valid UTF-8 text") from None
+    except OSError as exc:
+        raise BadImportFile(f"could not read {path}: {exc.strerror or exc}") from None
+
+
+def read_csv(text: str) -> list[NewBookmark]:
+    """Parse the CSV that ``export --format csv`` writes."""
+    try:
+        rows = list(csv.reader(io.StringIO(text, newline="")))
+    except csv.Error as exc:
+        raise BadImportFile(f"not valid CSV: {exc}") from None
+    if not rows:
+        raise BadImportFile(
+            "not valid CSV: the file is empty, expected the header row "
+            + ",".join(CSV_HEADER)
+        )
+    if tuple(field.strip() for field in rows[0]) != CSV_HEADER:
+        raise BadImportFile(
+            "not valid CSV: the header row must be "
+            + ",".join(CSV_HEADER)
+            + f", got {','.join(rows[0])!r}"
+        )
+    new = []
+    for number, row in enumerate(rows[1:], start=2):
+        where = f"line {number}"
+        if len(row) != len(CSV_HEADER):
+            raise BadImportFile(
+                f"{where}: expected {len(CSV_HEADER)} fields, got {len(row)}"
+            )
+        _ignored_id, url, title, tags = row
+        new.append(make_bookmark(url, title, parse_tags(tags), where))
+    return new
+
+
+def read_json(text: str) -> list[NewBookmark]:
+    """Parse the JSON that ``export --format json`` writes."""
+    try:
+        data = json.loads(text)
+    except ValueError as exc:
+        raise BadImportFile(f"not valid JSON: {exc}") from None
+    if not isinstance(data, list):
+        raise BadImportFile(
+            f"not valid JSON: expected an array of bookmarks, got {type_name(data)}"
+        )
+    new = []
+    for index, item in enumerate(data, start=1):
+        where = f"item {index}"
+        if not isinstance(item, dict):
+            raise BadImportFile(
+                f"{where}: expected an object, got {type_name(item)}"
+            )
+        if "url" not in item:
+            raise BadImportFile(f'{where}: missing "url"')
+        title = item.get("title", "")
+        if not isinstance(title, str):
+            raise BadImportFile(
+                f'{where}: "title" must be a string, got {type_name(title)}'
+            )
+        new.append(make_bookmark(item["url"], title, json_tags(item, where), where))
+    return new
+
+
+def json_tags(item: dict, where: str) -> tuple[str, ...]:
+    """The ``tags`` value of a JSON bookmark, with the rules ``add`` uses.
+
+    The tags already arrive as a list, so unlike ``--tags`` there is nothing
+    to split; whitespace is stripped, blanks dropped and duplicates
+    collapsed, and the result is sorted alphabetically.
+    """
+    raw = item.get("tags", [])
+    if not isinstance(raw, list) or not all(isinstance(tag, str) for tag in raw):
+        raise BadImportFile(f'{where}: "tags" must be a list of strings')
+    tags = {tag.strip() for tag in raw}
+    tags.discard("")
+    return tuple(sorted(tags))
+
+
+def make_bookmark(
+    url: object, title: str, tags: tuple[str, ...], where: str
+) -> NewBookmark:
+    """Check one imported bookmark the way ``add`` checks its arguments."""
+    if not isinstance(url, str):
+        raise BadImportFile(f'{where}: "url" must be a string, got {type_name(url)}')
+    if not url.startswith(ALLOWED_SCHEMES):
+        raise BadImportFile(f"{where}: url must start with http:// or https://: {url}")
+    return NewBookmark(url, title, tags)
+
+
+def type_name(value: object) -> str:
+    """A JSON-flavoured name for a value's type, for error messages."""
+    return {
+        type(None): "null",
+        bool: "a boolean",
+        int: "a number",
+        float: "a number",
+        str: "a string",
+        list: "an array",
+        dict: "an object",
+    }.get(type(value), type(value).__name__)
+
+
