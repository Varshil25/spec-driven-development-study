+def write_html(bookmarks: Iterable[Bookmark]) -> None:
+    """Print the bookmarks as an HTML page, one list item per bookmark."""
+    print(HTML_PROLOGUE)
+    for bookmark in bookmarks:
+        href = html.escape(bookmark.url, quote=True)
+        title = html.escape(bookmark.title, quote=False)
+        tags = html.escape(bookmark.tag_string, quote=False)
+        print(f'<li><a href="{href}">{title}</a> <small>{tags}</small></li>')
+    print(HTML_EPILOGUE)
+
