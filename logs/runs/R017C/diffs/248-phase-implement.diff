+++ b/tests/test_burn.py
@@ -0,0 +1,470 @@
+"""Burn-after-reading: a snippet that ceases to exist upon its first successful read.
+
+Covers FR-030, FR-031, FR-044, FR-045, FR-046, FR-047, FR-049, FR-054, SR-016,
+SR-017, SR-020, SC-011, SC-014, SC-015.
+
+The combined burn+password sequences live at the end of this module (User Story 3);
+the password requirements themselves are covered in ``tests/test_password.py``.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+import time
+
+import pytest
+
+#: Long enough that a truncated body is unmistakable, and that a partial write would
+#: have to cross several socket buffers to go unnoticed.
+LONG_CONTENT = "complete-or-nothing line\n" * 400
+
+#: Every method the service does not route. None may ever disclose content.
+UNROUTED_METHODS = ("PUT", "PATCH", "HEAD", "OPTIONS")
+
+
+def read_json(server, paste_id, **kwargs):
+    return server.get(f"/pastes/{paste_id}", **kwargs)
+
+
+def read_raw(server, paste_id, **kwargs):
+    return server.get(f"/pastes/{paste_id}/raw", **kwargs)
+
+
+# --- FR-030: the field is accepted, and absence means false ----------------------
+
+
+def test_FR_030_burn_after_reading_is_accepted_true_false_and_absent(server):
+    """FR-030: true, false, and absence are all accepted; absence means false."""
+    one_time = server.create("burns", burn_after_reading=True)
+    explicit_false = server.create("stays-a", burn_after_reading=False)
+    absent = server.create("stays-b")
+
+    for created in (one_time, explicit_false, absent):
+        assert server.record_exists(created["id"])
+
+    # The two non-burning pastes are readable repeatedly and report ``false``.
+    for created, text in ((explicit_false, "stays-a"), (absent, "stays-b")):
+        for _ in range(3):
+            response = read_json(server, created["id"])
+            assert response.status == 200
+            assert response.json()["content"] == text
+            assert response.json()["burn_after_reading"] is False
+
+    # The one-time paste reports ``true`` on the single read it has.
+    response = read_json(server, one_time["id"])
+    assert response.status == 200
+    assert response.json()["burn_after_reading"] is True
+
+
+def test_FR_030_explicit_false_behaves_exactly_as_absence(server):
+    """FR-030: `false` and an absent field are indistinguishable from outside."""
+    explicit = server.create("same-text", burn_after_reading=False)
+    absent = server.create("same-text")
+
+    first = read_json(server, explicit["id"]).json()
+    second = read_json(server, absent["id"]).json()
+
+    # Identical apart from the fields that are necessarily per-paste.
+    for body in (first, second):
+        body.pop("id")
+        body.pop("created_at")
+    assert first == second
+
+    # Both survive the read.
+    assert read_json(server, explicit["id"]).status == 200
+    assert read_json(server, absent["id"]).status == 200
+
+
+# --- FR-031: anything that is not a boolean is rejected ---------------------------
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["true", "false", 0, 1, -1, None, [], {}, 1.0],
+    ids=["str-true", "str-false", "zero", "one", "minus-one", "null", "list", "object", "float"],
+)
+def test_FR_031_non_boolean_burn_after_reading_is_400_and_creates_nothing(server, value):
+    """FR-031: a non-boolean burn_after_reading is 400 and creates nothing."""
+    before = sorted(os.listdir(server.data_dir))
+
+    response = server.post_json({"content": "rejected", "burn_after_reading": value})
+
+    assert response.status == 400, (value, response.body)
+    assert response.json() == {"error": "burn_after_reading must be true or false"}
+    assert sorted(os.listdir(server.data_dir)) == before, (
+        "FR-031: a rejected submission must leave nothing on disk"
+    )
+
+
+# --- FR-044 / FR-045: return, then destroy ----------------------------------------
+
+
+def test_FR_044_structured_read_is_identical_to_an_ordinary_paste_then_destroys(server):
+    """FR-044, SC-011: the single read is an ordinary read; then the paste is gone."""
+    ordinary = server.create(LONG_CONTENT, expires_in=3600)
+    one_time = server.create(LONG_CONTENT, expires_in=3600, burn_after_reading=True)
+
+    ordinary_response = read_json(server, ordinary["id"])
+    burn_response = read_json(server, one_time["id"])
+
+    assert burn_response.status == ordinary_response.status == 200
+    assert burn_response.header("Content-Type") == ordinary_response.header("Content-Type")
+
+    expected = ordinary_response.json()
+    actual = burn_response.json()
+    # Everything matches apart from the identifier and the flag under test.
+    assert actual["content"] == expected["content"] == LONG_CONTENT
+    assert set(actual) == set(expected)
+    assert expected["burn_after_reading"] is False
+    assert actual["burn_after_reading"] is True
+    assert actual["protected"] == expected["protected"] is False
+
+    assert not server.record_exists(one_time["id"]), (
+        "FR-044: the record must be gone from the data directory after the read"
+    )
+
+
+def test_FR_045_every_later_request_is_404_after_the_single_read(server):
+    """FR-045: after the read, structured, raw, and revocation are all 404."""
+    created = server.create("one shot", burn_after_reading=True)
+    token = created["delete_token"]
+
+    assert read_json(server, created["id"]).status == 200
+
+    assert read_json(server, created["id"]).status == 404
+    assert read_raw(server, created["id"]).status == 404
+    revocation = server.delete(f"/pastes/{created['id']}", token)
+    assert revocation.status == 404, (
+        "FR-045: even the correct delete token must report 404 after consumption"
+    )
+    assert revocation.json() == {"error": "not found"}
+
+
+def test_FR_044_raw_read_consumes_and_returns_the_exact_bytes(server):
+    """FR-044, FR-045: a raw read consumes exactly as a structured read does."""
+    created = server.create(LONG_CONTENT, burn_after_reading=True)
+
+    response = read_raw(server, created["id"])
+
+    assert response.status == 200
+    assert response.header("Content-Type") == "text/plain; charset=utf-8"
+    assert response.header("X-Content-Type-Options") == "nosniff"
+    assert response.body == LONG_CONTENT.encode("utf-8"), (
+        "FR-039: the raw body is byte-for-byte the content, with no trailing newline"
+    )
+    assert not response.body.endswith(b"\n\n")
+
+    assert not server.record_exists(created["id"])
+    assert read_raw(server, created["id"]).status == 404
+    assert read_json(server, created["id"]).status == 404
+    assert server.delete(f"/pastes/{created['id']}", created["delete_token"]).status == 404
+
+
+# --- FR-046: no unsuccessful request consumes -------------------------------------
+
+
+def test_FR_046_refused_and_unrouted_requests_never_consume(server):
+    """FR-046, SC-014: a refused or unrouted request leaves the single read intact."""
+    created = server.create(LONG_CONTENT, burn_after_reading=True)
+    paste_id = created["id"]
+    path = f"/pastes/{paste_id}"
+
+    # A revocation with a wrong token, and one with no token at all.
+    assert server.delete(path, "x" * 43).status == 403
+    assert server.delete(path).status == 403
+
+    # Addresses that do not route.
+    assert server.get(f"{path}/other").status == 404
+    assert server.get(f"{path}/").status == 404
+    assert server.get(f"{path}/raw/").status == 404
+
+    # Methods that do not route.
+    for method in ("PUT", "PATCH", "HEAD"):
+        assert server.request(method, path).status == 404, method
+
+    # The paste is untouched: it still has its one read, with the whole content.
+    assert server.record_exists(paste_id)
+    response = read_json(server, paste_id)
+    assert response.status == 200
+    assert response.json()["content"] == LONG_CONTENT
+
+
+# --- FR-049: expiry applies independently of consumption --------------------------
+
+
+def test_FR_049_unread_one_time_paste_still_expires(server):
+    """FR-049: an unread one-time paste past its expiry is non-existent."""
+    expiring = server.create("gone by the clock", expires_in=1, burn_after_reading=True)
+    control = server.create("still here", burn_after_reading=True)
+
+    time.sleep(2.2)
+
+    assert read_json(server, expiring["id"]).status == 404
+    assert read_raw(server, expiring["id"]).status == 404
+
+    # The control proves the clock, not the feature, removed the first one.
+    assert read_json(server, control["id"]).status == 200
+    assert read_json(server, control["id"]).status == 404
+
+
+# --- FR-047 / SR-016: the claim is atomic -----------------------------------------
+
+
+def _race(server, paste_id, reader, thread_count=24):
+    """Run ``thread_count`` simultaneous reads; return the list of responses."""
+    barrier = threading.Barrier(thread_count)
+    responses = []
+    lock = threading.Lock()
+
+    def run() -> None:
+        barrier.wait()
+        response = reader(server, paste_id)
+        with lock:
+            responses.append(response)
+
+    threads = [threading.Thread(target=run) for _ in range(thread_count)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=60)
+
+    assert len(responses) == thread_count
+    return responses
+
+
+def test_FR_047_concurrent_structured_reads_yield_exactly_one_200(server):
+    """FR-047, SR-016, SC-015: N concurrent reads → one complete 200, N-1 404s."""
+    created = server.create(LONG_CONTENT, burn_after_reading=True)
+
+    responses = _race(server, created["id"], read_json)
+    statuses = [response.status for response in responses]
+
+    assert statuses.count(200) == 1, statuses
+    assert statuses.count(404) == len(statuses) - 1, statuses
+    assert 403 not in statuses
+    assert 500 not in statuses, "SR-016: contention must never yield 500"
+
+    winner = next(r for r in responses if r.status == 200)
+    assert winner.json()["content"] == LONG_CONTENT, (
+        "FR-047: the one successful read must carry the complete, untruncated content"
+    )
+    assert not server.record_exists(created["id"])
+
+
+def test_FR_047_concurrent_raw_reads_yield_exactly_one_200(server):
+    """FR-047, SR-016: the raw route gives the same single-winner guarantee."""
+    created = server.create(LONG_CONTENT, burn_after_reading=True)
+
+    responses = _race(server, created["id"], read_raw)
+    statuses = [response.status for response in responses]
+
+    assert statuses.count(200) == 1, statuses
+    assert statuses.count(404) == len(statuses) - 1, statuses
+    assert 500 not in statuses
+
+    winner = next(r for r in responses if r.status == 200)
+    assert winner.body == LONG_CONTENT.encode("utf-8"), (
+        "FR-047: no read may return partial or truncated text"
+    )
+    for loser in responses:
+        if loser.status == 404:
+            assert loser.json() == {"error": "not found"}
+
+
+def test_SR_016_concurrent_read_and_revocation_disclose_content_at_most_once(server):
+    """SR-016: a read racing a revocation — content at most once, paste gone after."""
+    created = server.create(LONG_CONTENT, burn_after_reading=True)
+    paste_id = created["id"]
+    token = created["delete_token"]
+    path = f"/pastes/{paste_id}"
+
+    thread_count = 24
+    barrier = threading.Barrier(thread_count)
+    results = []
+    lock = threading.Lock()
+
+    def run(index: int) -> None:
+        barrier.wait()
+        if index % 2:
+            response = server.delete(path, token)
+            kind = "delete"
+        else:
+            response = read_json(server, paste_id)
+            kind = "read"
+        with lock:
+            results.append((kind, response))
+
+    threads = [threading.Thread(target=run, args=(i,)) for i in range(thread_count)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=60)
+
+    reads = [response for kind, response in results if kind == "read"]
+    deletes = [response for kind, response in results if kind == "delete"]
+
+    successful_reads = [r for r in reads if r.status == 200]
+    assert len(successful_reads) <= 1, "SR-016: content returned more than once"
+    for response in successful_reads:
+        assert response.json()["content"] == LONG_CONTENT
+
+    assert sum(1 for r in deletes if r.status == 204) <= 1
+    assert all(r.status in (200, 404) for r in reads), [r.status for r in reads]
+    assert all(r.status in (204, 404) for r in deletes), [r.status for r in deletes]
+    assert all(r.status != 500 for _, r in results)
+
+    assert not server.record_exists(paste_id), "the paste is gone either way"
+    assert read_json(server, paste_id).status == 404
+
+
+# --- SR-017: nothing bypasses the destruction -------------------------------------
+
+
+def test_SR_017_no_route_method_or_encoding_serves_a_consumed_paste(server):
+    """SR-017: after consumption, no address, method, or encoding returns content."""
+    content = "already burned"
+    created = server.create(content, burn_after_reading=True)
+    paste_id = created["id"]
+    token = created["delete_token"]
+
+    assert read_json(server, paste_id).status == 200  # the single read
+
+    attempts = [
+        ("GET", f"/pastes/{paste_id}"),
+        ("GET", f"/pastes/{paste_id}/raw"),
+        ("GET", f"/pastes/{paste_id}/raw/"),
+        ("GET", f"/pastes/{paste_id}/anything"),
+        ("GET", f"/pastes/{paste_id[:-1]}%{ord(paste_id[-1]):02X}"),
+        ("GET", f"/pastes/{paste_id[:-1]}%25{ord(paste_id[-1]):02X}"),
+        ("HEAD", f"/pastes/{paste_id}"),
+        ("PUT", f"/pastes/{paste_id}"),
+        ("PATCH", f"/pastes/{paste_id}"),
+        ("OPTIONS", f"/pastes/{paste_id}"),
+    ]
+    for method, path in attempts:
+        response = server.request(method, path)
+        assert response.status != 200, (method, path, response.status)
+        assert content.encode("utf-8") not in response.body, (method, path)
+
+    revocation = server.delete(f"/pastes/{paste_id}", token)
+    assert revocation.status == 404
+    assert content.encode("utf-8") not in revocation.body
+
+
+# --- SR-020: fail closed when the claim cannot be completed -----------------------
+
+
+def test_SR_020_a_failing_claim_is_a_generic_500_and_discloses_nothing(server):
+    """SR-020: an unexpected claim failure yields 500 and never serves the content."""
+    content = "never-disclosed-payload"
+    created = server.create(content, burn_after_reading=True)
+    paste_id = created["id"]
+
+    store = server.store
+    original = store.consume_record
+    calls = []
+
+    def exploding_consume(target_id):
+        calls.append(target_id)
+        raise OSError(13, "permission denied", "/root/secret/path.json")
+
+    store.consume_record = exploding_consume
+    try:
+        response = read_json(server, paste_id)
+
+        assert response.status == 500
+        assert response.json() == {"error": "internal error"}
+        assert content.encode("utf-8") not in response.body
+        assert calls == [paste_id], (
+            "SR-020: the failure must occur at the claim, after the liveness check"
+        )
+
+        raw_response = read_raw(server, paste_id)
+        assert raw_response.status == 500
+        assert content.encode("utf-8") not in raw_response.body
+    finally:
+        store.consume_record = original
+
+    # The paste was never served, so its single read is still intact — and is still
+    # served exactly once once the claim works again.
+    assert read_json(server, paste_id).status == 200
+    assert read_json(server, paste_id).status == 404
+
+
+# --- FR-054: every error this story can produce keeps the standard shape ----------
+
+
+def test_FR_054_every_error_body_is_exactly_one_non_echoing_error_key(server):
+    """FR-054: 400, 404, and 500 bodies are all `{"error": "<message>"}`."""
+    bad_request = server.post_json({"content": "x", "burn_after_reading": "yes"})
+    not_found = server.get("/pastes/" + "A" * 22)
+
+    created = server.create("burned away", burn_after_reading=True)
+    read_json(server, created["id"])
+    consumed = read_json(server, created["id"])
+
+    store = server.store
+    original = store.consume_record
+    live = server.create("live one", burn_after_reading=True)
+    store.consume_record = lambda _id: (_ for _ in ()).throw(OSError("boom"))
+    try:
+        internal = read_json(server, live["id"])
+    finally:
+        store.consume_record = original
+
+    for response in (bad_request, not_found, consumed, internal):
+        assert response.header("Content-Type") == "application/json; charset=utf-8"
+        body = response.json()
+        assert set(body) == {"error"}, body
+        assert isinstance(body["error"], str) and body["error"], body
+        assert "yes" not in body["error"], "the message must not echo the input"
+        assert "burned away" not in body["error"]
+        assert "live one" not in body["error"]
+
+    assert bad_request.status == 400
+    assert not_found.status == 404
+    assert consumed.status == 404
+    assert internal.status == 500
+
+
+# --- User Story 3: the two options compose in the only safe order -----------------
+
+
+@pytest.mark.parametrize("consume_with_raw", [False, True], ids=["structured", "raw"])
+def test_FR_046_a_refused_read_never_consumes_a_combined_paste(server, consume_with_raw):
+    """FR-046, FR-044, FR-045: a reader without the password never burns the read."""
+    password=[REDACTED:assigned_secret]
+    content = "both-protections-payload"
+    created = server.create(content, password=[REDACTED:assigned_secret], burn_after_reading=True)
+    paste_id = created["id"]
+
+    # Neither a missing nor a wrong password consumes the single read.
+    for reader in (read_json, read_raw):
+        assert reader(server, paste_id).status == 403
+        assert reader(server, paste_id, password=[REDACTED:assigned_secret]).status == 403
+        assert reader(server, paste_id, password=[REDACTED:assigned_secret][:-1]).status == 403
+    assert server.record_exists(paste_id), (
+        "FR-046: a stranger with the link must not be able to destroy the paste"
+    )
+
+    # The holder of the password takes the read, in whichever form.
+    if consume_with_raw:
+        granted = read_raw(server, paste_id, password=[REDACTED:assigned_secret])
+        assert granted.status == 200
+        assert granted.body == content.encode("utf-8")
+        assert granted.header("Content-Type") == "text/plain; charset=utf-8"
+    else:
+        granted = read_json(server, paste_id, password=[REDACTED:assigned_secret])
+        assert granted.status == 200
+        body = granted.json()
+        assert body["content"] == content
+        assert body["burn_after_reading"] is True
+        assert body["protected"] is True
+
+    # And it is gone — even for the holder of the password.
+    assert not server.record_exists(paste_id)
+    for reader in (read_json, read_raw):
+        assert reader(server, paste_id, password=[REDACTED:assigned_secret]).status == 404
+        assert reader(server, paste_id).status == 404
+    assert server.delete(f"/pastes/{paste_id}", created["delete_token"]).status == 404
