+"""Password-protected pastes: reading requires the password set at creation.
+
+Covers FR-032, FR-033, FR-034, FR-035, FR-038, FR-040, FR-041, FR-042, FR-043,
+FR-050, SR-013, SR-014, SR-015, SR-017, SR-018, SR-019, SC-012, SC-013, SC-016,
+SC-017.
+
+The burn-after-reading requirements are covered in ``tests/test_burn.py``; the
+combined-paste sequences are split between the two modules.
+"""
+
+from __future__ import annotations
+
+import base64
+import os
+import pathlib
+import re
+import time
+
+import pytest
+
+from pastebin import models
+
+SRC = pathlib.Path(__file__).resolve().parent.parent / "src" / "pastebin"
+
+#: A password exercising every category FR-034 names: spaces, punctuation, emoji,
+#: combining marks, and non-ASCII letters.
+AWKWARD_PASSWORDS = [
+    "correct horse battery staple",
+    "p@$$w0rd!#%^&*()_+-=[]{}|;:',.<>/?`~\\\"",
+    "🔑🗝️🔐 unlock 🧨",
+    "égalité combining",
+    "Паро́ль-Ωμέγα-日本語-עברית",
+]
+
+
+def read_json(server, paste_id, **kwargs):
+    return server.get(f"/pastes/{paste_id}", **kwargs)
+
+
+def read_raw(server, paste_id, **kwargs):
+    return server.get(f"/pastes/{paste_id}/raw", **kwargs)
+
+
+READ_FORMS = [read_json, read_raw]
+READ_FORM_IDS = ["structured", "raw"]
+
+
+def content_of(response, expected: str) -> bool:
+    """True when ``response`` carried ``expected``, in whichever read form."""
+    if response.header("Content-Type") == "application/json; charset=utf-8":
+        return response.json().get("content") == expected
+    return response.body == expected.encode("utf-8")
+
+
+# --- FR-032: the field is accepted at both ends of its range ----------------------
+
+
+def test_FR_032_one_character_and_128_character_passwords_are_accepted(server):
+    """FR-032: a 1-character and a 128-character password are both accepted."""
+    shortest = "x"
+    longest = "L" * 128
+
+    short_paste = server.create("guarded-by-one", password=[REDACTED:assigned_secret])
+    long_paste = server.create("guarded-by-many", password=longest)
+
+    for paste, password, text in (
+        (short_paste, shortest, "guarded-by-one"),
+        (long_paste, longest, "guarded-by-many"),
+    ):
+        assert read_json(server, paste["id"]).status == 403
+        granted = read_json(server, paste["id"], password=[REDACTED:assigned_secret])
+        assert granted.status == 200
+        assert granted.json()["content"] == text
+        assert granted.json()["protected"] is True
+
+
+def test_FR_032_absent_password_means_unprotected(server):
+    """FR-032: a paste created without a password needs none to read."""
+    created = server.create("open to all")
+
+    response = read_json(server, created["id"])
+
+    assert response.status == 200
+    assert response.json()["protected"] is False
+    assert server.record_file(created["id"])["password"] is None
+
+
+# --- FR-033: type and length rejection, measured in characters --------------------
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["", "q" * 129, None, 5, True, [], {}],
+    ids=["empty", "129-chars", "null", "number", "bool", "list", "object"],
+)
+def test_FR_033_invalid_password_is_400_and_creates_nothing(server, value):
+    """FR-033: a non-string or out-of-range password is 400 and creates nothing."""
+    before = sorted(os.listdir(server.data_dir))
+
+    response = server.post_json({"content": "rejected", "password": value})
+
+    assert response.status == 400, (value, response.body)
+    assert response.json() == {
+        "error": "password must be a string of 1 to 128 characters"
+    }
+    assert sorted(os.listdir(server.data_dir)) == before
+
+
+def test_FR_033_length_bound_is_counted_in_characters_not_bytes(server):
+    """FR-033: 128 multi-byte characters are accepted — the bound is characters."""
+    password = "🔑" * 128
+    assert len(password) == 128
+    assert len(password.encode("utf-8")) == 512, "the discriminating case must be multi-byte"
+
+    created = server.create("counted in characters", password=[REDACTED:assigned_secret])
+
+    assert read_json(server, created["id"]).status == 403
+    granted = read_json(server, created["id"], password=[REDACTED:assigned_secret])
+    assert granted.status == 200
+    assert granted.json()["content"] == "counted in characters"
+
+    # And one character more is still rejected, so the bound really is 128.
+    rejected = server.post_json({"content": "x", "password": "🔑" * 129})
+    assert rejected.status == 400
+
+
+# --- FR-034: any character a text value can hold ----------------------------------
+
+
+@pytest.mark.parametrize("password", AWKWARD_PASSWORDS)
+def test_FR_034_identical_password_grants_access_in_both_read_forms(server, password):
+    """FR-034, SC-013: spaces, punctuation, emoji, marks, and non-ASCII round-trip."""
+    content = "payload for an awkward password"
+    created = server.create(content, password=[REDACTED:assigned_secret])
+
+    structured = read_json(server, created["id"], password=[REDACTED:assigned_secret])
+    assert structured.status == 200
+    assert structured.json()["content"] == content
+
+    raw = read_raw(server, created["id"], password=[REDACTED:assigned_secret])
+    assert raw.status == 200
+    assert raw.body == content.encode("utf-8")
+
+
+# --- FR-040: the refusal table ----------------------------------------------------
+
+
+@pytest.mark.parametrize("reader", READ_FORMS, ids=READ_FORM_IDS)
+def test_FR_040_only_the_exact_password_is_accepted(server, reader):
+    """FR-040: missing, empty, near-miss, and over-long values are all 403."""
+    password=[REDACTED:assigned_secret]
+    content = "guarded text"
+    created = server.create(content, password=[REDACTED:assigned_secret])
+    paste_id = created["id"]
+
+    # No header at all.
+    assert reader(server, paste_id).status == 403
+
+    wrong_values = [
+        password.lower(),                # wrong case
+        password.upper(),                # wrong case
+        password + " ",                  # trailing whitespace
+        password[:-1],                   # truncated
+        password[:5],                    # a correct prefix
+        password + "extra",              # over-long
+        "",                              # empty, via the helper
+    ]
+    for value in wrong_values:
+        response = reader(server, paste_id, password=value)
+        assert response.status == 403, (value, response.status)
+
+    # The exact value, and only it, is accepted.
+    granted = reader(server, paste_id, password=[REDACTED:assigned_secret])
+    assert granted.status == 200
+    assert content_of(granted, content)
+
+
+# --- FR-041: a refusal discloses nothing and changes nothing ----------------------
+
+
+@pytest.mark.parametrize("reader", READ_FORMS, ids=READ_FORM_IDS)
+def test_FR_041_refused_read_discloses_nothing_and_leaves_the_paste_readable(
+    server, reader
+):
+    """FR-041, SC-012: a 403 carries the standard body and no part of the content."""
+    password=[REDACTED:assigned_secret]
+    content = "topsecret-marker-string"
+    created = server.create(content, password=[REDACTED:assigned_secret])
+    paste_id = created["id"]
+
+    for attempt in (None, "wrong", password[:-1]):
+        response = (
+            reader(server, paste_id)
+            if attempt is None
+            else reader(server, paste_id, password=attempt)
+        )
+        assert response.status == 403
+        assert response.json() == {"error": "invalid paste password"}
+        assert content.encode("utf-8") not in response.body
+        for size in range(4, len(content) + 1):
+            assert content[:size].encode("utf-8") not in response.body
+        assert content not in response.header_text
+
+    # Unchanged and still readable by someone who holds the password.
+    granted = reader(server, paste_id, password=[REDACTED:assigned_secret])
+    assert granted.status == 200
+    assert content_of(granted, content)
+
+
+# --- FR-042: the header is ignored on an unprotected paste ------------------------
+
+
+def test_FR_042_password_header_has_no_effect_on_an_unprotected_paste(server):
+    """FR-042: an unprotected paste reads identically with or without a header."""
+    content = "nothing to guard"
+    created = server.create(content)
+    paste_id = created["id"]
+
+    plain = read_json(server, paste_id)
+    plausible = read_json(server, paste_id, password=[REDACTED:assigned_secret])
+    garbage = read_json(server, paste_id, password="🙈" * 20)
+
+    for response in (plain, plausible, garbage):
+        assert response.status == 200
+        assert response.json()["protected"] is False
+    assert plain.body == plausible.body == garbage.body, (
+        "FR-042: the header's value must have no effect whatsoever"
+    )
+
+    raw_plain = read_raw(server, paste_id)
+    raw_with_header = read_raw(server, paste_id, password=[REDACTED:assigned_secret])
+    assert raw_plain.status == raw_with_header.status == 200
+    assert raw_plain.body == raw_with_header.body == content.encode("utf-8")
+
+
+# --- FR-050: revocation needs the token, and only the token -----------------------
+
+
+def test_FR_050_revocation_needs_the_token_alone_and_never_the_password(server):
+    """FR-050: the password neither substitutes for the token nor is required."""
+    password=[REDACTED:assigned_secret]
+    created = server.create("revoke me", password=[REDACTED:assigned_secret])
+    paste_id = created["id"]
+    token = created["delete_token"]
+    path = f"/pastes/{paste_id}"
+
+    # A correct password in place of the token is not a credential for revocation.
+    assert server.delete(path, password).status == 403
+    # A correct password alongside a wrong token does not help either.
+    wrong = server.request(
+        "DELETE", path, None, {"X-Delete-Token": "z" * 43}, password=[REDACTED:assigned_secret]
+    )
+    assert wrong.status == 403
+    assert server.record_exists(paste_id)
+
+    # The token alone, with no password header, revokes.
+    assert server.delete(path, token).status == 204
+    assert read_json(server, paste_id, password=[REDACTED:assigned_secret]).status == 404
+    assert read_raw(server, paste_id, password=[REDACTED:assigned_secret]).status == 404
+
+
+# --- FR-035 / FR-038 / SR-013: what is stored, and what is returned ---------------
+
+
+@pytest.mark.parametrize(
+    "options",
+    [
+        {},
+        {"burn_after_reading": True},
+        {"password": "Storage-Shape-Check-1"},
+        {"burn_after_reading": True, "password": "Storage-Shape-Check-2"},
+    ],
+    ids=["neither", "burn-only", "password-only", "both"],
+)
+def test_FR_035_creation_response_is_exactly_three_fields_for_every_combination(
+    server, options
+):
+    """FR-035, SR-013: the 201 body never echoes or reports either option."""
+    response = server.post_json({"content": "creation shape", **options})
+
+    assert response.status == 201
+    body = response.json()
+    assert set(body) == {"id", "delete_token", "url"}
+    assert body["url"] == f"/pastes/{body['id']}"
+
+    combined = response.header_text + "\n" + response.body.decode("utf-8")
+    assert "burn_after_reading" not in combined
+    assert "protected" not in combined
+    password=[REDACTED:assigned_secret]("password")
+    if password:
+        assert password not in combined
+
+
+def test_SR_013_password_is_stored_only_as_a_salted_slow_hash(server):
+    """SR-013, SC-017: the stored verifier is PBKDF2, salted, and non-recoverable."""
+    password=[REDACTED:assigned_secret]
+    created = server.create("hashed storage", password=[REDACTED:assigned_secret])
+
+    record = server.record_file(created["id"])
+    verifier = record["password"]
+
+    assert set(verifier) == {"algorithm", "iterations", "salt", "hash"}
+    assert verifier["algorithm"] == "pbkdf2_sha256"
+    assert verifier["iterations"] == 600000
+    assert re.fullmatch(r"[0-9a-f]{32}", verifier["salt"]), verifier["salt"]
+    assert re.fullmatch(r"[0-9a-f]{64}", verifier["hash"]), verifier["hash"]
+
+    # The plaintext appears nowhere under the data directory, in any form.
+    for path in pathlib.Path(server.data_dir).rglob("*"):
+        if path.is_file():
+            blob = path.read_bytes()
+            assert password.encode("utf-8") not in blob, path
+            assert password.encode("utf-16-le") not in blob, path
+
+    # The hash is not an encoding of the password.
+    assert verifier["hash"] != password.encode("utf-8").hex()
+    assert verifier["hash"] != base64.b64encode(password.encode("utf-8")).decode()
+    assert password not in verifier["hash"]
+
+
+def test_SR_013_same_password_yields_a_different_salt_and_hash_per_paste(server):
+    """SR-013: the salt is drawn per paste, so stored hashes are unrelated."""
+    password=[REDACTED:assigned_secret]
+    first = server.create("paste one", password=[REDACTED:assigned_secret])
+    second = server.create("paste two", password=[REDACTED:assigned_secret])
+
+    one = server.record_file(first["id"])["password"]
+    two = server.record_file(second["id"])["password"]
+
+    assert one["salt"] != two["salt"], "SR-013: the salt must be drawn per paste"
+    assert one["hash"] != two["hash"], "SR-013: per-paste salts make hashes unrelated"
+
+    # Both still verify against the one password that made them.
+    assert read_json(server, first["id"], password=[REDACTED:assigned_secret]).status == 200
+    assert read_json(server, second["id"], password=[REDACTED:assigned_secret]).status == 200
+
+
+def test_FR_038_protected_reports_only_whether_and_is_a_bare_boolean(server):
+    """FR-038, SR-019: no response carries the password or any value derived from it."""
+    password=[REDACTED:assigned_secret]
+    created = server.create("whether only", password=[REDACTED:assigned_secret])
+    verifier = server.record_file(created["id"])["password"]
+
+    response = read_json(server, created["id"], password=[REDACTED:assigned_secret])
+
+    assert response.status == 200
+    body = response.json()
+    assert body["protected"] is True
+    assert type(body["protected"]) is bool
+
+    combined = response.header_text + "\n" + response.body.decode("utf-8")
+    assert password not in combined
+    assert verifier["salt"] not in combined
+    assert verifier["hash"] not in combined
+    assert "pbkdf2" not in combined.lower()
+    assert "iterations" not in combined.lower()
+
+
+# --- SR-014: constant-time verification -------------------------------------------
+
+
+def test_SR_014_implementation_uses_hmac_compare_digest(server):
+    """SR-014: password verification is ``hmac.compare_digest``, never ``==``."""
+    models_source = (SRC / "models.py").read_text(encoding="utf-8")
+    assert "hmac.compare_digest(" in models_source, (
+        "SR-014: the verification path must use a constant-time comparison"
+    )
+
+    offenders = []
+    for module in sorted(SRC.glob("*.py")):
+        for number, line in enumerate(
+            module.read_text(encoding="utf-8").splitlines(), start=1
+        ):
+            stripped = line.strip()
+            if stripped.startswith("#"):
+                continue
+            if re.search(r"password|hash|digest", stripped, re.IGNORECASE) and (
+                re.search(r"[!=]=", stripped)
+            ):
+                offenders.append(f"{module.name}:{number}: {stripped}")
+    assert not offenders, (
+        "SR-014: a password or its digest must never be compared with == or !=\n"
+        + "\n".join(offenders)
+    )
+
+
+def test_SR_014_near_miss_and_prefix_passwords_are_rejected(server):
+    """SR-014: a last-character miss and a correct prefix are both refused."""
+    password=[REDACTED:assigned_secret]
+    created = server.create("near misses", password=[REDACTED:assigned_secret])
+    paste_id = created["id"]
+
+    near_miss = password[:-1] + ("Z" if password[-1] != "Z" else "Y")
+    assert read_json(server, paste_id, password=[REDACTED:assigned_secret]).status == 403
+    assert read_json(server, paste_id, password=[REDACTED:assigned_secret][: len(password) // 2]).status == 403
+    assert read_raw(server, paste_id, password=[REDACTED:assigned_secret]).status == 403
+
+    assert read_json(server, paste_id, password=[REDACTED:assigned_secret]).status == 200
+
+
+# --- SR-015: authorization on every read, never cached ----------------------------
+
+
+def test_SR_015_every_read_is_checked_and_nothing_is_cached(server):
+    """SR-015: two successful reads each need the header; a later one without is 403."""
+    password=[REDACTED:assigned_secret]
+    created = server.create("re-checked", password=[REDACTED:assigned_secret])
+    paste_id = created["id"]
+
+    for _ in range(2):
+        response = read_json(server, paste_id, password=[REDACTED:assigned_secret])
+        assert response.status == 200
+        assert response.header("Set-Cookie") is None, (
+            "SR-015: no session may be established"
+        )
+
+    # A correct read grants nothing to the next, header-less one.
+    assert read_json(server, paste_id).status == 403
+    assert read_raw(server, paste_id).status == 403
+
+
+def test_SR_015_no_client_supplied_claim_other_than_the_password_grants_access(server):
+    """SR-015: cookies, sessions, and Authorization headers change no outcome."""
+    password=[REDACTED:assigned_secret]
+    created = server.create("claims ignored", password=[REDACTED:assigned_secret])
+    path = f"/pastes/{created['id']}"
+
+    claims = {
+        "Cookie": "session=admin; authenticated=true",
+        "Authorization": "Bearer let-me-in",
+        "X-Forwarded-For": "127.0.0.1",
+        "X-Paste-Protected": "false",
+    }
+    refused = server.request("GET", path, None, claims)
+    assert refused.status == 403
+    assert refused.json() == {"error": "invalid paste password"}
+
+    # And the same claims alongside the correct password neither help nor hinder.
+    granted = server.request("GET", path, None, claims, password=[REDACTED:assigned_secret])
+    assert granted.status == 200
+    assert granted.header("Set-Cookie") is None
+
+
+def test_SR_015_a_read_of_one_paste_grants_no_access_to_another(server):
+    """SR-015: access is per-paste; it is never carried across identifiers."""
+    password_a = "Paste-A-Secret-11"
+    password_b = "Paste-B-Secret-22"
+    paste_a = server.create("alpha content", password=[REDACTED:assigned_secret])
+    paste_b = server.create("beta content", password=[REDACTED:assigned_secret])
+
+    assert read_json(server, paste_a["id"], password=[REDACTED:assigned_secret]).status == 200
+
+    assert read_json(server, paste_b["id"]).status == 403
+    assert read_json(server, paste_b["id"], password=[REDACTED:assigned_secret]).status == 403
+    assert read_json(server, paste_b["id"], password=[REDACTED:assigned_secret]).status == 200
+
+
+# --- SR-018 / SR-019: bounded work, and nothing disclosed -------------------------
+
+
+def test_SR_018_validation_precedes_hashing(server, monkeypatch):
+    """SR-018: an invalid password shape is rejected before any key derivation."""
+    def explode(_password):  # pragma: no cover - must never be reached
+        raise AssertionError("SR-018: hashing ran before validation accepted the shape")
+
+    monkeypatch.setattr(models, "hash_password", explode)
+
+    for value in ["", "z" * 129, None, 7, [], {}]:
+        response = server.post_json({"content": "x", "password": value})
+        assert response.status == 400, value
+        assert response.json()["error"] == (
+            "password must be a string of 1 to 128 characters"
+        )
+
+
+def test_SR_018_a_read_without_a_password_header_runs_no_key_derivation(server, monkeypatch):
+    """SR-018: a missing header is refused without provoking a KDF run."""
+    password=[REDACTED:assigned_secret]
+    created = server.create("bounded work", password=[REDACTED:assigned_secret])
+
+    def explode(*_args):  # pragma: no cover - must never be reached
+        raise AssertionError("SR-018: a KDF ran for a request that supplied nothing")
+
+    monkeypatch.setattr(models, "verify_password", explode)
+
+    assert read_json(server, created["id"]).status == 403
+    assert read_raw(server, created["id"]).status == 403
+    empty = server.request(
+        "GET", f"/pastes/{created['id']}", headers={"X-Paste-Password": ""}
+    )
+    assert empty.status == 403
+
+
+def test_SR_019_the_refusal_message_is_a_fixed_non_revealing_constant(server):
+    """SR-019: the 403 message does not vary with the value, or with its absence."""
+    password=[REDACTED:assigned_secret]
+    protected = server.create("redacted", password=[REDACTED:assigned_secret])
+    paste_id = protected["id"]
+
+    messages = set()
+    bodies = set()
+    for attempt in (None, "", "wrong", password[:-1], "🙈" * 40, "a" * 500):
+        if attempt is None:
+            response = read_json(server, paste_id)
+        else:
+            response = server.request(
+                "GET",
+                f"/pastes/{paste_id}",
+                headers={"X-Paste-Password": attempt.encode("utf-8").decode("latin-1")},
+            )
+        assert response.status == 403
+        messages.add(response.json()["error"])
+        bodies.add(response.body)
+
+    assert messages == {"invalid paste password"}, messages
+    assert len(bodies) == 1, "SR-019: the refusal body must not vary with the input"
+
+
+def test_SR_019_no_response_discloses_a_password_salt_hash_or_parameter(server):
+    """SR-019, SC-017: no body or header ever carries secret or hashing material."""
+    password=[REDACTED:assigned_secret]
+    created = server.create("redaction check", password=[REDACTED:assigned_secret])
+    verifier = server.record_file(created["id"])["password"]
+
+    responses = [
+        server.post_json({"content": "another", "password": password}),
+        read_json(server, created["id"]),
+        read_json(server, created["id"], password="wrong"),
+        read_json(server, created["id"], password=[REDACTED:assigned_secret]),
+        read_raw(server, created["id"], password=[REDACTED:assigned_secret]),
+        server.delete(f"/pastes/{created['id']}"),
+        server.get("/pastes/" + "B" * 22),
+    ]
+
+    for response in responses:
+        combined = response.header_text + "\n" + response.body.decode("utf-8", "replace")
+        assert password not in combined, response.status
+        assert verifier["salt"] not in combined, response.status
+        assert verifier["hash"] not in combined, response.status
+        assert "pbkdf2" not in combined.lower(), response.status
+        assert "iterations" not in combined.lower(), response.status
+
+
+# --- FR-043: non-existence outranks a permission failure --------------------------
+
+
+def _vanished_protected_pastes(server, password):
+    """Four identifiers that must all be indistinguishable from never-issued ones."""
+    never_issued = "N" * 22
+
+    expired = server.create("expired text", expires_in=1, password=[REDACTED:assigned_secret])["id"]
+
+    revoked_paste = server.create("revoked text", password=[REDACTED:assigned_secret])
+    revoked = revoked_paste["id"]
+
+    consumed_paste = server.create(
+        "consumed text", password=[REDACTED:assigned_secret], burn_after_reading=True
+    )
+    consumed = consumed_paste["id"]
+
+    # Revoke one, consume the other, and let the third expire.
+    assert server.delete(f"/pastes/{revoked}", revoked_paste["delete_token"]).status == 204
+    assert read_json(server, consumed, password=[REDACTED:assigned_secret]).status == 200
+    time.sleep(2.2)
+
+    return {
+        "never issued": never_issued,
+        "expired": expired,
+        "revoked": revoked,
+        "consumed": consumed,
+    }
+
+
+def test_FR_043_unknown_expired_revoked_and_consumed_are_404_whatever_the_password(
+    server,
+):
+    """FR-043, SC-016: twelve cases, all 404 — a refusal never confirms an id is real."""
+    password=[REDACTED:assigned_secret]
+    pastes = _vanished_protected_pastes(server, password)
+
+    attempts = {
+        "no header": {},
+        "wrong password": {"password": "definitely-not-it"},
+        "correct password": {"password": password},
+    }
+
+    results = {}
+    for label, paste_id in pastes.items():
+        for attempt, kwargs in attempts.items():
+            response = read_json(server, paste_id, **kwargs)
+            results[(label, attempt)] = response.status
+            assert response.json() == {"error": "not found"}, (label, attempt)
+
+    assert len(results) == 12, results
+    assert set(results.values()) == {404}, results
+    assert 403 not in results.values(), (
+        "FR-043: non-existence must be reported in preference to a permission failure"
+    )
+
+    # A reference point: an identifier that was never issued is byte-identical.
+    reference = read_json(server, "N" * 22).body
+    for paste_id in pastes.values():
+        assert read_json(server, paste_id, password=[REDACTED:assigned_secret]).body == reference
+
+
+def test_FR_043_the_raw_route_keeps_the_same_precedence(server):
+    """FR-043: the raw read reports 404 for a vanished paste, whatever is supplied."""
+    password=[REDACTED:assigned_secret]
+    pastes = _vanished_protected_pastes(server, password)
+
+    for paste_id in pastes.values():
+        for kwargs in ({}, {"password": "wrong"}, {"password": password}):
+            response = read_raw(server, paste_id, **kwargs)
+            assert response.status == 404
+            assert response.json() == {"error": "not found"}
+
+
+# --- SR-015 / SR-017: a combined paste is bypassable by nothing -------------------
+
+
+def test_SR_017_no_route_method_or_encoding_bypasses_or_consumes_a_combined_paste(
+    server,
+):
+    """SR-015, SR-017: nothing serves or consumes a one-time protected paste early."""
+    password=[REDACTED:assigned_secret]
+    content = "combined-secret-marker"
+    created = server.create(content, password=[REDACTED:assigned_secret], burn_after_reading=True)
+    paste_id = created["id"]
+    path = f"/pastes/{paste_id}"
+
+    # ``password_is_irrelevant`` marks the attempts whose refusal must not depend on
+    # the password: an unroutable method or address is refused even for the caller
+    # who holds it, so those are retried *with* the correct password below.
+    attempts = [
+        ("HEAD", path, None, True),
+        ("PUT", path, None, True),
+        ("PATCH", path, None, True),
+        ("OPTIONS", path, None, True),
+        # A refused revocation: the password is not a revocation credential, and a
+        # wrong token is refused — neither may consume the single read (FR-046).
+        ("DELETE", path, {"X-Delete-Token": "y" * 43}, True),
+        ("DELETE", path, {"X-Delete-Token": password}, True),
+        ("DELETE", path, None, True),
+        ("GET", f"{path}/raw/", None, True),
+        ("GET", f"{path}/anything", None, True),
+        # A disguised spelling of the paste's own address. Decoding it must land on
+        # the same password check, not around it — so it is only ever tried *without*
+        # the password: with the password it is simply the paste's address, and
+        # serving it would be correct rather than a bypass.
+        ("GET", f"/pastes/{paste_id[:-1]}%{ord(paste_id[-1]):02X}", None, False),
+        ("GET", f"/pastes/{paste_id[:-1]}%25{ord(paste_id[-1]):02X}", None, False),
+    ]
+
+    for method, target, headers, password_is_irrelevant in attempts:
+        # First with no password at all: nothing may serve the text to a caller who
+        # cannot prove they hold it, by any route, method, or encoding (SR-017).
+        response = server.request(method, target, None, headers)
+        assert response.status != 200, (method, target, response.status)
+        assert content.encode("utf-8") not in response.body, (method, target)
+
+        if password_is_irrelevant:
+            # And again holding the password, so the refusal is the route's or the
+            # method's own and not merely a missing credential.
+            response = server.request(method, target, None, headers, password=[REDACTED:assigned_secret])
+            assert response.status != 200, (method, target, response.status)
+            assert content.encode("utf-8") not in response.body, (method, target)
+
+    # Critically: none of that consumed the paste. It still has its single read, and
+    # it still requires the password to take it.
+    assert server.record_exists(paste_id)
+    assert read_json(server, paste_id).status == 403
+    assert read_json(server, paste_id, password="wrong").status == 403
+
+    granted = read_json(server, paste_id, password=[REDACTED:assigned_secret])
+    assert granted.status == 200
+    assert granted.json()["content"] == content
+    assert read_json(server, paste_id, password=[REDACTED:assigned_secret]).status == 404
