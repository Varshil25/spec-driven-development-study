+++ b/tests/test_compat.py
@@ -0,0 +1,496 @@
+"""Compatibility and durability: existing snippets and existing clients keep working.
+
+Covers FR-036, FR-037, FR-039, FR-048, FR-051, FR-052, FR-053, SR-020, SC-018,
+SC-019, SC-020.
+
+Records written before this feature carry neither new key. They must read back
+identically, report both flags false, and need no migration — which is exactly why
+``RECORD_FIELDS`` was not extended.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import pathlib
+import time
+
+import pytest
+
+STRUCTURED_KEYS = {
+    "id",
+    "content",
+    "created_at",
+    "expires_at",
+    "burn_after_reading",
+    "protected",
+}
+
+#: The header set the 001 contract fixes for a successful raw read, plus the two the
+#: stdlib always emits.
+RAW_HEADER_NAMES = {"server", "date", "content-type", "content-length", "x-content-type-options"}
+
+
+def read_json(server, paste_id, **kwargs):
+    return server.get(f"/pastes/{paste_id}", **kwargs)
+
+
+def read_raw(server, paste_id, **kwargs):
+    return server.get(f"/pastes/{paste_id}/raw", **kwargs)
+
+
+def plant_record(server, paste_id: str, record: dict) -> str:
+    """Write a record file by hand, exactly as a prior version would have."""
+    path = os.path.join(server.data_dir, paste_id + ".json")
+    payload = json.dumps(record, ensure_ascii=False).encode("utf-8")
+    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    with os.fdopen(descriptor, "wb") as handle:
+        handle.write(payload)
+    return paste_id
+
+
+# --- FR-037: both flags on every successful structured read -----------------------
+
+
+@pytest.mark.parametrize(
+    "options",
+    [
+        {},
+        {"burn_after_reading": False},
+        {"burn_after_reading": True},
+        {"password": "Flags-Always-Present-1"},
+        {"burn_after_reading": True, "password": "Flags-Always-Present-2"},
+    ],
+    ids=["neither", "burn-false", "burn-true", "password", "both"],
+)
+def test_FR_037_both_flags_are_present_on_every_successful_structured_read(
+    server, options
+):
+    """FR-037: burn_after_reading and protected are on every read, as bare booleans."""
+    created = server.create("flag carrier", **options)
+    password=[REDACTED:assigned_secret]("password")
+
+    response = read_json(
+        server, created["id"], **({"password": password} if password else {})
+    )
+
+    assert response.status == 200
+    body = response.json()
+    assert set(body) == STRUCTURED_KEYS, body
+    assert type(body["burn_after_reading"]) is bool
+    assert type(body["protected"]) is bool
+    assert body["burn_after_reading"] is bool(options.get("burn_after_reading", False))
+    assert body["protected"] is (password is not None)
+
+    # FR-013 still holds: the revocation secret is in neither the body nor a header.
+    assert created["delete_token"] not in response.body.decode("utf-8")
+    assert created["delete_token"] not in response.header_text
+    assert "delete_token" not in body
+
+
+# --- FR-039: the raw response is completely unchanged -----------------------------
+
+
+def test_FR_039_raw_response_carries_neither_flag_in_body_or_headers(server):
+    """FR-039: the raw body is the content alone; no header carries either flag."""
+    password=[REDACTED:assigned_secret]
+    content = "raw bytes, nothing added"
+    created = server.create(content, password=[REDACTED:assigned_secret], burn_after_reading=True)
+
+    response = read_raw(server, created["id"], password=[REDACTED:assigned_secret])
+
+    assert response.status == 200
+    assert response.body == content.encode("utf-8")
+    assert response.header("Content-Type") == "text/plain; charset=utf-8"
+    assert response.header("X-Content-Type-Options") == "nosniff"
+    assert {name.lower() for name in dict(response.headers)} == RAW_HEADER_NAMES, (
+        response.headers
+    )
+
+    combined = response.header_text + "\n" + response.body.decode("utf-8")
+    assert "burn_after_reading" not in combined
+    assert "protected" not in combined
+
+
+def test_FR_039_raw_headers_match_an_ordinary_paste_exactly(server):
+    """FR-039: a protected one-time paste's raw headers equal an ordinary paste's."""
+    content = "identical header set"
+    ordinary = server.create(content)
+    special = server.create(content, password=[REDACTED:assigned_secret], burn_after_reading=True)
+
+    plain = read_raw(server, ordinary["id"])
+    guarded = read_raw(server, special["id"], password=[REDACTED:assigned_secret])
+
+    def comparable(response):
+        return {
+            name.lower(): value
+            for name, value in response.headers
+            if name.lower() != "date"
+        }
+
+    assert comparable(plain) == comparable(guarded)
+    assert plain.body == guarded.body
+
+
+# --- FR-036: the new fields are validated before the size rule --------------------
+
+#: Over the 65 536-byte content cap, but under the 66 560-byte declared-length cap —
+#: so the body is read and the validation rules decide the outcome.
+OVERSIZED_CONTENT = "o" * 66000
+
+#: Over the declared-length cap, so the framing guard refuses it unread.
+UNREADABLE_CONTENT = "u" * 70000
+
+
+def test_FR_036_an_invalid_new_field_outranks_an_oversized_body(server):
+    """FR-036: invalid new field + oversized content is 400, never 413."""
+    for field, value, message in (
+        ("burn_after_reading", "yes", "burn_after_reading must be true or false"),
+        ("password", "", "password must be a string of 1 to 128 characters"),
+        ("password", 5, "password must be a string of 1 to 128 characters"),
+    ):
+        response = server.post_json(
+            {"content": OVERSIZED_CONTENT, field: value}
+        )
+        assert response.status == 400, (field, value, response.status)
+        assert response.json() == {"error": message}
+
+
+def test_FR_036_valid_new_fields_with_oversized_content_is_still_413(server):
+    """FR-036, FR-027: the control — valid new fields leave 413 in force."""
+    response = server.post_json(
+        {
+            "content": OVERSIZED_CONTENT,
+            "burn_after_reading": True,
+            "password": "Valid-Field-Oversized-4",
+        }
+    )
+
+    assert response.status == 413
+    assert response.json() == {
+        "error": "content exceeds the maximum size of 65536 bytes"
+    }
+
+
+def test_FR_036_a_declared_length_over_the_cap_is_still_413_with_the_body_unread(server):
+    """FR-036, FR-029: the framing guard still outranks everything, body unread."""
+    body = json.dumps(
+        {"content": UNREADABLE_CONTENT, "burn_after_reading": "invalid"}
+    ).encode("utf-8")
+    assert len(body) > 66560
+
+    response = server.post_raw(body, {"Content-Type": "application/json"})
+
+    assert response.status == 413, response.status
+    assert response.json() == {
+        "error": "content exceeds the maximum size of 65536 bytes"
+    }
+
+
+# --- FR-051: a record carrying neither key is a perfectly good paste --------------
+
+
+def test_FR_051_a_legacy_record_reads_back_unchanged_and_reports_both_flags_false(
+    server,
+):
+    """FR-051, SC-019: a pre-feature record needs no migration and is not corrupt."""
+    paste_id = "LegacyRecord0123456789"[:22]
+    assert len(paste_id) == 22
+    token = "t" * 43
+    record = {
+        "id": paste_id,
+        "content": "written before this feature existed",
+        "created_at": "2026-11-01T09:41:07Z",
+        "expires_at": None,
+        "delete_token": token,
+    }
+    plant_record(server, paste_id, record)
+    assert oct(os.stat(os.path.join(server.data_dir, paste_id + ".json")).st_mode)[-3:] == "600"
+
+    response = read_json(server, paste_id)
+
+    assert response.status == 200
+    body = response.json()
+    assert set(body) == STRUCTURED_KEYS
+    assert body["content"] == record["content"]
+    assert body["created_at"] == record["created_at"]
+    assert body["expires_at"] is None
+    assert body["burn_after_reading"] is False, "FR-051: absent means not one-time"
+    assert body["protected"] is False, "FR-051: absent means not protected"
+
+    # It needs no password, serves its raw form, and reads repeatedly.
+    assert read_json(server, paste_id).status == 200
+    raw = read_raw(server, paste_id)
+    assert raw.status == 200
+    assert raw.body == record["content"].encode("utf-8")
+
+    # And it is still revocable with its original token.
+    assert server.delete(f"/pastes/{paste_id}", token).status == 204
+    assert read_json(server, paste_id).status == 404
+
+
+def test_FR_051_an_explicit_null_password_is_unprotected_not_corrupt(server):
+    """FR-051: `password: null` means unprotected, exactly as absence does."""
+    paste_id = "NullPasswordRecord1234"[:22]
+    plant_record(
+        server,
+        paste_id,
+        {
+            "id": paste_id,
+            "content": "explicitly unprotected",
+            "created_at": "2026-11-01T09:41:07Z",
+            "expires_at": None,
+            "delete_token": "n" * 43,
+            "burn_after_reading": False,
+            "password": None,
+        },
+    )
+
+    response = read_json(server, paste_id)
+
+    assert response.status == 200
+    assert response.json()["protected"] is False
+    assert response.json()["burn_after_reading"] is False
+
+
+# --- FR-052 / FR-048: both options, and destruction, survive a restart ------------
+
+
+def test_FR_052_both_options_survive_a_restart(server):
+    """FR-052, SC-018: after a restart the paste is still one-time, still protected."""
+    password=[REDACTED:assigned_secret]
+    one_time = server.create("still one-time", burn_after_reading=True)
+    protected = server.create("still protected", password=[REDACTED:assigned_secret])
+
+    server.restart()
+
+    # Still protected, by the same password and no other.
+    assert read_json(server, protected["id"]).status == 403
+    assert read_json(server, protected["id"], password="wrong").status == 403
+    granted = read_json(server, protected["id"], password=[REDACTED:assigned_secret])
+    assert granted.status == 200
+    assert granted.json()["content"] == "still protected"
+    assert granted.json()["protected"] is True
+
+    # Still one-time: one read, then gone.
+    first = read_json(server, one_time["id"])
+    assert first.status == 200
+    assert first.json()["burn_after_reading"] is True
+    assert read_json(server, one_time["id"]).status == 404
+
+    # Both original delete tokens still revoke what is left.
+    assert server.delete(
+        f"/pastes/{protected['id']}", protected["delete_token"]
+    ).status == 204
+
+
+def test_FR_048_destruction_on_read_is_durable_across_a_restart(server):
+    """FR-048, SC-018: a consumed paste stays non-existent after a restart."""
+    created = server.create("consumed before the restart", burn_after_reading=True)
+    paste_id = created["id"]
+
+    assert read_json(server, paste_id).status == 200
+    assert not server.record_exists(paste_id)
+
+    server.restart()
+
+    assert read_json(server, paste_id).status == 404
+    assert read_raw(server, paste_id).status == 404
+    assert server.delete(f"/pastes/{paste_id}", created["delete_token"]).status == 404
+
+
+# --- FR-053: a pre-feature client observes exactly two added fields ---------------
+
+
+def test_FR_053_a_client_using_neither_field_sees_only_the_two_added_flags(server):
+    """FR-053, SC-020: every 001 status, header, body shape, and message is intact."""
+    content = "an ordinary paste, as before"
+
+    creation = server.post_json({"content": content, "expires_in": 3600})
+    assert creation.status == 201
+    assert creation.header("Content-Type") == "application/json; charset=utf-8"
+    assert set(creation.json()) == {"id", "delete_token", "url"}
+    created = creation.json()
+    paste_id = created["id"]
+
+    # The structured read: the 001 four fields, plus exactly the two FR-037 adds.
+    read = read_json(server, paste_id)
+    assert read.status == 200
+    assert set(read.json()) == STRUCTURED_KEYS
+    assert set(read.json()) - {"burn_after_reading", "protected"} == {
+        "id",
+        "content",
+        "created_at",
+        "expires_at",
+    }, "FR-053: the two flags are the only permitted difference"
+    assert read.json()["content"] == content
+
+    # The raw read: wholly unchanged.
+    raw = read_raw(server, paste_id)
+    assert raw.status == 200
+    assert raw.body == content.encode("utf-8")
+    assert {name.lower() for name in dict(raw.headers)} == RAW_HEADER_NAMES
+
+    # Every 001 error message is unchanged, and still reachable the same way.
+    assert server.post_json({}).json() == {"error": "content is required"}
+    assert server.post_json({"content": 5}).json() == {
+        "error": "content must be a string"
+    }
+    assert server.post_json({"content": "x", "expires_in": 0}).json() == {
+        "error": "expires_in must be an integer between 1 and 2592000"
+    }
+    assert server.get("/pastes/" + "Z" * 22).json() == {"error": "not found"}
+    assert server.get("/nope").json() == {"error": "not found"}
+    assert server.delete(f"/pastes/{paste_id}", "w" * 43).json() == {
+        "error": "invalid delete token"
+    }
+
+    # Revocation: still 204, still with no body.
+    revocation = server.delete(f"/pastes/{paste_id}", created["delete_token"])
+    assert revocation.status == 204
+    assert revocation.body == b""
+
+
+def test_FR_053_unknown_fields_are_still_ignored(server):
+    """FR-053, FR-009: a key this feature does not define still causes no rejection."""
+    response = server.post_json(
+        {"content": "ignored extras", "nickname": "x", "burn": True, "pass": "y"}
+    )
+
+    assert response.status == 201
+    body = read_json(server, response.json()["id"]).json()
+    assert body["burn_after_reading"] is False
+    assert body["protected"] is False
+
+
+# --- SR-020: a record whose protection state cannot be determined is gone ---------
+
+MALFORMED_BURN = ["true", 0, 1, None, [], {}, 1.5]
+
+MALFORMED_PASSWORD = [
+    "a string",
+    [],
+    5,
+    {"algorithm": "pbkdf2_sha256", "iterations": 600000, "salt": "ab" * 16},
+    {
+        "algorithm": "pbkdf2_sha256",
+        "iterations": 600000,
+        "salt": "ab" * 16,
+        "hash": "cd" * 32,
+        "extra": 1,
+    },
+    {
+        "algorithm": "md5",
+        "iterations": 600000,
+        "salt": "ab" * 16,
+        "hash": "cd" * 32,
+    },
+    {
+        "algorithm": "pbkdf2_sha256",
+        "iterations": 600000,
+        "salt": "not hex at all!" + "z" * 17,
+        "hash": "cd" * 32,
+    },
+    {
+        "algorithm": "pbkdf2_sha256",
+        "iterations": 600000,
+        "salt": "ab" * 16,
+        "hash": "cd" * 8,
+    },
+    {
+        "algorithm": "pbkdf2_sha256",
+        "iterations": 0,
+        "salt": "ab" * 16,
+        "hash": "cd" * 32,
+    },
+]
+
+
+def _planted(server, index: int, **extra) -> str:
+    paste_id = f"PlantedRecord{index:09d}"[:22]
+    assert len(paste_id) == 22
+    plant_record(
+        server,
+        paste_id,
+        {
+            "id": paste_id,
+            "content": "must-never-be-served",
+            "created_at": "2026-11-01T09:41:07Z",
+            "expires_at": None,
+            "delete_token": "p" * 43,
+            **extra,
+        },
+    )
+    return paste_id
+
+
+@pytest.mark.parametrize("value", MALFORMED_BURN, ids=[repr(v) for v in MALFORMED_BURN])
+def test_SR_020_a_malformed_burn_flag_makes_the_paste_non_existent(server, value):
+    """SR-020: an undeterminable one-time marking is 404, never served twice."""
+    paste_id = _planted(server, 1, burn_after_reading=value)
+
+    for reader in (read_json, read_raw):
+        response = reader(server, paste_id)
+        assert response.status == 404, (value, response.status)
+        assert response.json() == {"error": "not found"}
+        assert b"must-never-be-served" not in response.body
+
+
+@pytest.mark.parametrize(
+    "value", MALFORMED_PASSWORD, ids=[str(i) for i in range(len(MALFORMED_PASSWORD))]
+)
+def test_SR_020_a_malformed_password_verifier_makes_the_paste_non_existent(
+    server, value
+):
+    """SR-020: an undeterminable protection state is 404, never served unprotected."""
+    paste_id = _planted(server, 2, password=value)
+
+    for reader in (read_json, read_raw):
+        response = reader(server, paste_id)
+        assert response.status == 404, (value, response.status)
+        assert response.json() == {"error": "not found"}
+        assert b"must-never-be-served" not in response.body
+
+    # And no password unlocks it either — it does not exist at all.
+    assert read_json(server, paste_id, password=[REDACTED:assigned_secret]).status == 404
+
+
+def test_SR_020_an_absurd_iteration_count_is_refused_promptly_without_running_the_kdf(
+    server,
+):
+    """SR-018, SR-020: a planted 10**12 iteration count is rejected, not executed."""
+    paste_id = _planted(
+        server,
+        3,
+        password={
+            "algorithm": "pbkdf2_sha256",
+            "iterations": 10**12,
+            "salt": "ab" * 16,
+            "hash": "cd" * 32,
+        },
+    )
+
+    started = time.monotonic()
+    response = read_json(server, paste_id, password=[REDACTED:assigned_secret])
+    elapsed = time.monotonic() - started
+
+    assert response.status == 404
+    assert response.json() == {"error": "not found"}
+    assert elapsed < 2.0, (
+        "SR-018: the iteration bound must be checked before any key derivation, "
+        f"but the response took {elapsed:.1f}s"
+    )
+
+
+def test_SR_020_a_planted_record_never_becomes_readable_after_a_restart(server):
+    """SR-020: an unusable record stays unusable; it is never repaired or served."""
+    paste_id = _planted(server, 4, burn_after_reading="true", password=[REDACTED:assigned_secret])
+
+    assert read_json(server, paste_id).status == 404
+    server.restart()
+    assert read_json(server, paste_id).status == 404
+    assert read_raw(server, paste_id).status == 404
+
+    # It is still on disk — nothing was rewritten or deleted behind the operator's
+    # back; it simply stops resolving to a paste (the 001 FR-024 rule).
+    assert pathlib.Path(server.data_dir, paste_id + ".json").exists()
diff --git a/tests/test_create.py b/tests/test_create.py
index 954c25a..0a111c2 100644
--- a/tests/test_create.py
+++ b/tests/test_create.py
@@ -98,7 +98,15 @@ def test_FR_009_unknown_fields_are_ignored_and_never_stored(server):
