+"""Redact personal data from log files.
+
+The package exposes the redaction primitives used by the command-line
+interface (``python -m logredact``):
+
+* :func:`redact_line` -- redact a single string, returning the counts.
+* :class:`Counts` -- the per-category tally of replacements.
+* :func:`luhn_ok` -- the Luhn checksum used to validate card numbers.
+"""
+
+from .redact import CARD, EMAIL, IP, Counts, luhn_ok, redact_line
+
+__all__ = ["CARD", "EMAIL", "IP", "Counts", "luhn_ok", "redact_line"]
+__version__ = "1.0.0"
