+"""Command-line interface: ``python -m logredact [--count] [FILE ...]``."""
+
+from __future__ import annotations
+
+import argparse
+import io
+import os
+import sys
+from typing import IO, Iterable, Sequence
+
+from .redact import Counts, redact_line
+
+PROG = "python -m logredact"
+EXIT_OK = 0
+EXIT_UNREADABLE = 2
+
+# Log files are not always clean UTF-8, and this tool must not corrupt the
+# lines it passes through.  Undecodable bytes are kept as surrogates on input
+# and written back out unchanged; newline="" keeps CRLF endings intact.
+_ENCODING = "utf-8"
+_ERRORS = "surrogateescape"
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog=PROG,
+        description=(
+            "Copy log lines to standard output with e-mail addresses, IPv4 "
+            "addresses and payment card numbers replaced by [EMAIL], [IP] "
+            "and [CARD]."
+        ),
+    )
+    parser.add_argument(
+        "--count",
+        action="store_true",
+        help=(
+            "after all output has been written, print "
+            "'emails=N ips=N cards=N' to standard error"
+        ),
+    )
+    parser.add_argument(
+        "files",
+        metavar="FILE",
+        nargs="*",
+        help=(
+            "input files, read in order; standard input when none is given "
+            "or for a FILE of '-'"
+        ),
+    )
+    return parser
+
+
+def _as_byte_safe(stream: IO[str]) -> IO[str]:
+    """Make a standard stream byte-transparent, if it supports it."""
+    try:
+        stream.reconfigure(  # type: ignore[union-attr]
+            encoding=_ENCODING, errors=_ERRORS, newline=""
+        )
+    except (AttributeError, io.UnsupportedOperation, ValueError):
+        pass  # e.g. a StringIO in tests: leave it as it is
+    return stream
+
+
+def _redact_stream(lines: Iterable[str], out: IO[str], totals: Counts) -> None:
+    for line in lines:
+        redacted, counts = redact_line(line)
+        totals.add(counts)
+        out.write(redacted)
+
+
+def _discard_stdout() -> None:
+    """Point stdout at /dev/null after a broken pipe, so exit stays quiet."""
+    try:
+        devnull = os.open(os.devnull, os.O_WRONLY)
+        os.dup2(devnull, sys.stdout.fileno())
+    except (OSError, ValueError, AttributeError):
+        pass
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = _build_parser().parse_args(argv)
+
+    out = _as_byte_safe(sys.stdout)
+    totals = Counts()
+
+    try:
+        if not args.files:
+            _redact_stream(_as_byte_safe(sys.stdin), out, totals)
+        else:
+            for path in args.files:
+                try:
+                    if path == "-":
+                        _redact_stream(_as_byte_safe(sys.stdin), out, totals)
+                        continue
+                    with open(
+                        path, encoding=_ENCODING, errors=_ERRORS, newline=""
+                    ) as handle:
+                        _redact_stream(handle, out, totals)
+                except OSError as exc:
+                    out.flush()
+                    reason = exc.strerror or str(exc)
+                    print(f"{PROG}: cannot read {path}: {reason}",
+                          file=sys.stderr)
+                    return EXIT_UNREADABLE
+        out.flush()
+    except BrokenPipeError:
+        # The reader went away (e.g. `| head`); stop without a traceback.
+        _discard_stdout()
+        return EXIT_OK
+
+    if args.count:
+        print(totals.summary(), file=sys.stderr)
+    return EXIT_OK
