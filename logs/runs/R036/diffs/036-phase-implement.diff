+"""Pattern matching and replacement rules for :mod:`logredact`.
+
+Three kinds of personal data are recognised, and they are replaced in this
+order: e-mail addresses, IPv4 addresses, then payment card numbers.  The
+order matters only in that the placeholders inserted by an earlier step
+(``[EMAIL]``, ``[IP]``) contain no digits and so cannot be re-matched by a
+later one.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+EMAIL = "[EMAIL]"
+IP = "[IP]"
+CARD = "[CARD]"
+
+# --------------------------------------------------------------------------
+# e-mail addresses
+# --------------------------------------------------------------------------
+# The local part is restricted to the characters that occur in practice
+# (letters, digits, ``.``, ``_``, ``%``, ``+``, ``-``) so that a log line
+# such as ``user=jane@example.com`` keeps its ``user=`` prefix.  Dots must
+# separate non-empty runs, which keeps a leading or trailing dot outside the
+# match.  The domain is one or more labels followed by an alphabetic TLD.
+_EMAIL_RE = re.compile(
+    r"""
+    [A-Za-z0-9_%+\-]+ (?: \. [A-Za-z0-9_%+\-]+ )*     # local part
+    @
+    (?: [A-Za-z0-9] (?: [A-Za-z0-9\-]* [A-Za-z0-9] )? \. )+   # domain labels
+    [A-Za-z]{2,}                                      # top-level domain
+    """,
+    re.VERBOSE,
+)
+
+# --------------------------------------------------------------------------
+# IPv4 addresses
+# --------------------------------------------------------------------------
+# Each octet is 0-255 with no leading zeros.  The surrounding assertions keep
+# a dotted run longer than four octets from matching one of its own slices:
+# ``999.1.1.1`` and ``1.2.3.4.5`` are left alone, while a sentence-final
+# ``10.0.0.7.`` still matches.
+_OCTET = r"(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"
+_IP_RE = re.compile(
+    rf"(?<![0-9.])(?:{_OCTET}\.){{3}}{_OCTET}(?!\.?[0-9])",
+)
+
+# --------------------------------------------------------------------------
+# payment card numbers
+# --------------------------------------------------------------------------
+_MIN_CARD_DIGITS = 13
+_MAX_CARD_DIGITS = 19
+_WORD_RE = re.compile(r"\w")
+# A chunk is a maximal run of digit groups joined by single spaces or single
+# hyphens; a lone separator (or a doubled one) ends the chunk.
+_CHUNK_RE = re.compile(r"[0-9](?:[ \-]?[0-9])*")
+_GROUP_RE = re.compile(r"[0-9]+")
+
+
+@dataclass
+class Counts:
+    """How many replacements of each kind were made."""
+
+    emails: int = 0
+    ips: int = 0
+    cards: int = 0
+
+    def add(self, other: "Counts") -> None:
+        self.emails += other.emails
+        self.ips += other.ips
+        self.cards += other.cards
+
+    def summary(self) -> str:
+        """Render the ``--count`` summary line."""
+        return f"emails={self.emails} ips={self.ips} cards={self.cards}"
+
+
+def luhn_ok(digits: str) -> bool:
+    """Return True if ``digits`` satisfies the Luhn checksum."""
+    if not digits:
+        return False
+    total = 0
+    for index, char in enumerate(reversed(digits)):
+        value = ord(char) - 48
+        if index % 2 == 1:
+            value *= 2
+            if value > 9:
+                value -= 9
+        total += value
+    return total % 10 == 0
+
+
+def _is_word(char: str) -> bool:
+    return _WORD_RE.match(char) is not None
+
+
+def _chunk_spans(text: str, chunk: str, offset: int) -> list[tuple[int, int]]:
+    """Find the card spans inside one chunk, as offsets into ``text``.
+
+    A candidate is a run of whole digit groups totalling 13 to 19 digits.  The
+    longest candidate starting at a given group wins, so a fully grouped
+    number such as ``4111 1111 1111 1111`` is matched as a single card.  A
+    candidate that fails the Luhn checksum is rejected and shorter candidates
+    -- and then later starting groups -- are tried instead, so a valid card
+    sitting next to an unrelated digit run is still found.
+    """
+    groups = _GROUP_RE.findall(chunk)
+    sizes = [len(group) for group in groups]
+    # Groups are joined by exactly one separator, so offsets follow from the
+    # sizes alone.
+    starts: list[int] = []
+    position = 0
+    for size in sizes:
+        starts.append(position)
+        position += size + 1
+    last = len(groups) - 1
+
+    # A chunk touching a letter, digit or underscore is not a card on that
+    # side; digits cannot touch it, as chunks are maximal.
+    left_free = offset == 0 or not _is_word(text[offset - 1])
+    end_of_chunk = offset + len(chunk)
+    right_free = (
+        end_of_chunk >= len(text) or not _is_word(text[end_of_chunk])
+    )
+
+    spans: list[tuple[int, int]] = []
+    first = 0
+    while first <= last:
+        if first == 0 and not left_free:
+            first += 1
+            continue
+
+        # Candidate end groups, shortest first, capped at 19 digits.
+        candidates: list[tuple[int, int]] = []
+        total = 0
+        for index in range(first, last + 1):
+            total += sizes[index]
+            if total > _MAX_CARD_DIGITS:
+                break
+            candidates.append((index, total))
+
+        match_end = None
+        for index, total in reversed(candidates):  # longest first
+            if total < _MIN_CARD_DIGITS:
+                break
+            if index == last and not right_free:
+                continue
+            if luhn_ok("".join(groups[first : index + 1])):
+                match_end = index
+                break
+
+        if match_end is None:
+            first += 1
+        else:
+            spans.append(
+                (
+                    offset + starts[first],
+                    offset + starts[match_end] + sizes[match_end],
+                )
+            )
+            first = match_end + 1
+    return spans
+
+
+def _find_card_spans(text: str) -> list[tuple[int, int]]:
+    """Locate the spans of every card number in ``text``."""
+    spans: list[tuple[int, int]] = []
+    for match in _CHUNK_RE.finditer(text):
+        chunk = match.group()
+        if len(chunk) < _MIN_CARD_DIGITS:
+            continue  # too short to hold 13 digits, separators included
+        spans.extend(_chunk_spans(text, chunk, match.start()))
+    return spans
+
+
+def _redact_cards(text: str) -> tuple[str, int]:
+    spans = _find_card_spans(text)
+    if not spans:
+        return text, 0
+    pieces: list[str] = []
+    previous = 0
+    for start, end in spans:
+        pieces.append(text[previous:start])
+        pieces.append(CARD)
+        previous = end
+    pieces.append(text[previous:])
+    return "".join(pieces), len(spans)
+
+
+def redact_line(text: str) -> tuple[str, Counts]:
+    """Redact ``text`` and report how many replacements were made.
+
+    Text with nothing to redact is returned unchanged.
+    """
+    text, emails = _EMAIL_RE.subn(EMAIL, text)
+    text, ips = _IP_RE.subn(IP, text)
+    text, cards = _redact_cards(text)
+    return text, Counts(emails=emails, ips=ips, cards=cards)
