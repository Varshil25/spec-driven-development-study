+"""Tests for the logredact package and its command-line interface."""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC = REPO_ROOT / "src"
+sys.path.insert(0, str(SRC))
+
+from logredact import luhn_ok, redact_line  # noqa: E402
+
+
+def redact(text: str) -> str:
+    return redact_line(text)[0]
+
+
+def counts(text: str) -> tuple[int, int, int]:
+    tally = redact_line(text)[1]
+    return tally.emails, tally.ips, tally.cards
+
+
+def run_cli(*args: str, stdin: bytes = b"") -> subprocess.CompletedProcess:
+    env = dict(os.environ, PYTHONPATH=str(SRC))
+    return subprocess.run(
+        [sys.executable, "-m", "logredact", *args],
+        input=stdin,
+        capture_output=True,
+        env=env,
+        cwd=REPO_ROOT,
+    )
+
+
+class EmailTests(unittest.TestCase):
+    def test_simple_address(self):
+        self.assertEqual(redact("user jane@example.com here"),
+                         "user [EMAIL] here")
+
+    def test_dots_plus_and_subdomains(self):
+        self.assertEqual(redact("jane.doe+test@mail.example.com"), "[EMAIL]")
+
+    def test_short_tld(self):
+        self.assertEqual(redact("a@b.io"), "[EMAIL]")
+
+    def test_surrounding_punctuation_is_kept(self):
+        self.assertEqual(redact("<jane@example.com>, ok"), "<[EMAIL]>, ok")
+        self.assertEqual(redact("mail jane@example.com."), "mail [EMAIL].")
+
+    def test_key_value_prefix_is_kept(self):
+        self.assertEqual(redact("user=jane@example.com"), "user=[EMAIL]")
+
+    def test_non_addresses_are_untouched(self):
+        for text in ("@example.com", "jane@", "jane@localhost", "a @ b.io",
+                     "100@200", "not.an.email"):
+            with self.subTest(text=text):
+                self.assertEqual(redact(text), text)
+
+    def test_several_addresses_on_one_line(self):
+        self.assertEqual(redact("a@b.io, c@d.org"), "[EMAIL], [EMAIL]")
+        self.assertEqual(counts("a@b.io, c@d.org"), (2, 0, 0))
+
+
+class IpTests(unittest.TestCase):
+    def test_private_and_public_addresses(self):
+        self.assertEqual(redact("from 10.0.0.7"), "from [IP]")
+        self.assertEqual(redact("192.168.0.10"), "[IP]")
+        self.assertEqual(redact("255.255.255.255"), "[IP]")
+        self.assertEqual(redact("0.0.0.0"), "[IP]")
+
+    def test_out_of_range_octets_are_untouched(self):
+        for text in ("999.1.1.1", "256.1.1.1", "1.1.1.256", "300.300.300.300"):
+            with self.subTest(text=text):
+                self.assertEqual(redact(text), text)
+
+    def test_too_few_or_too_many_octets(self):
+        for text in ("1.2.3", "1.2.3.4.5", "10.0.0.7.8"):
+            with self.subTest(text=text):
+                self.assertEqual(redact(text), text)
+
+    def test_leading_zero_octet_is_untouched(self):
+        self.assertEqual(redact("010.0.0.1"), "010.0.0.1")
+
+    def test_adjacent_punctuation(self):
+        self.assertEqual(redact("ip=1.2.3.4, port 80"), "ip=[IP], port 80")
+        self.assertEqual(redact("(10.0.0.7)"), "([IP])")
+        self.assertEqual(redact("host 10.0.0.7."), "host [IP].")
+        self.assertEqual(redact("10.0.0.7:8080"), "[IP]:8080")
+
+    def test_several_addresses_on_one_line(self):
+        self.assertEqual(redact("1.2.3.4 -> 5.6.7.8"), "[IP] -> [IP]")
+        self.assertEqual(counts("1.2.3.4 -> 5.6.7.8"), (0, 2, 0))
+
+
+class CardTests(unittest.TestCase):
+    def test_plain_sixteen_digits(self):
+        self.assertEqual(redact("4111111111111111"), "[CARD]")
+
+    def test_space_and_hyphen_groups(self):
+        self.assertEqual(redact("paid with 4111 1111 1111 1111, ok"),
+                         "paid with [CARD], ok")
+        self.assertEqual(redact("4111-1111-1111-1111"), "[CARD]")
+
+    def test_thirteen_and_nineteen_digit_cards(self):
+        self.assertEqual(redact("4222222222222"), "[CARD]")          # 13
+        self.assertEqual(redact("4111111111111111110"), "[CARD]")    # 19
+
+    def test_luhn_failures_are_untouched(self):
+        for text in ("1234567890123", "4111111111111112",
+                     "4111 1111 1111 1112"):
+            with self.subTest(text=text):
+                self.assertEqual(redact(text), text)
+
+    def test_length_bounds(self):
+        # 12 digits is too short even though 4111111111119 (13) is valid.
+        self.assertEqual(redact("411111111111"), "411111111111")
+        # 20 digits is too long, and no 13-19 digit slice of it may match.
+        twenty = "41111111111111111115"
+        self.assertEqual(redact(twenty), twenty)
+
+    def test_valid_card_next_to_invalid_digits(self):
+        self.assertEqual(
+            redact("paid with 4111 1111 1111 1111, ref 1234567890123"),
+            "paid with [CARD], ref 1234567890123",
+        )
+        self.assertEqual(
+            redact("ref 1234567890123 card 4111111111111111"),
+            "ref 1234567890123 card [CARD]",
+        )
+
+    def test_digits_glued_to_letters_are_untouched(self):
+        for text in ("abc4111111111111111", "4111111111111111abc",
+                     "deadbeef4111111111111111"):
+            with self.subTest(text=text):
+                self.assertEqual(redact(text), text)
+
+    def test_double_separator_breaks_the_number(self):
+        self.assertEqual(redact("4111  1111 1111 1111"),
+                         "4111  1111 1111 1111")
+
+    def test_two_cards_on_one_line(self):
+        line = "4111111111111111 and 5500005555555559"
+        self.assertEqual(redact(line), "[CARD] and [CARD]")
+        self.assertEqual(counts(line), (0, 0, 2))
+
+    def test_ip_is_not_a_card(self):
+        self.assertEqual(redact("192.168.0.10"), "[IP]")
+
+    def test_luhn_helper(self):
+        self.assertTrue(luhn_ok("4111111111111111"))
+        self.assertTrue(luhn_ok("79927398713"))
+        self.assertFalse(luhn_ok("79927398710"))
+        self.assertFalse(luhn_ok(""))
+
+
+class CombinedTests(unittest.TestCase):
+    def test_all_three_on_one_line(self):
+        line = "jane@example.com 10.0.0.7 4111 1111 1111 1111"
+        self.assertEqual(redact(line), "[EMAIL] [IP] [CARD]")
+        self.assertEqual(counts(line), (1, 1, 1))
+
+    def test_clean_line_is_unchanged(self):
+        line = "INFO  starting service, pid 4321, version 2.7"
+        self.assertEqual(redact(line), line)
+        self.assertEqual(counts(line), (0, 0, 0))
+
+    def test_email_at_ip_literal(self):
