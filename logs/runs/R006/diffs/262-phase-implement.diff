+"""Contract tests for User Story 4 — failure modes (FR-012, FR-018, SR-001…SR-003, SR-008).
+
+Contract IDs are from contracts/cli.md. Every failure mode asserts three things: the diagnostic
+names the source, nothing of the input leaks onto stderr, and the status is 2 (or 141 for a
+closed pipe).
+"""
+
+import ast
+import os
+import re
+import signal
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from conftest import SRC, cli_argv, cli_env
+
+A_CONTENT = b"first jane@example.com\n"
+A_REDACTED = b"first [EMAIL]\n"
+B_CONTENT = b"second 10.0.0.7\n"
+B_REDACTED = b"second [IP]\n"
+
+CAP = 1 << 20
+
+
+def write_pair(tmp_path):
+    a = tmp_path / "a.log"
+    b = tmp_path / "b.log"
+    a.write_bytes(A_CONTENT)
+    b.write_bytes(B_CONTENT)
+    return a, b
+
+
+def write_over_length(tmp_path, name="long.log"):
+    """Two ordinary lines, then a line of CAP + 1 characters including its terminator."""
+    path = tmp_path / name
+    path.write_bytes(A_CONTENT + B_CONTENT + b"x" * CAP + b"\n")
+    return path
+
+
+# ===============================================================================================
+# T027 — operands are used exactly as supplied (SR-008)
+# ===============================================================================================
+
+
+def test_no_path_construction(run_cli, tmp_path):
+    """SR-008: no resolution, normalisation, joining, or globbing of an operand.
+
+    The diagnostic for a failing operand quotes it exactly as written on the command line, which
+    is also how a caller recognises which of their arguments failed (FR-012).
+    """
+    nested = tmp_path / "sub"
+    nested.mkdir()
+    target = nested / "a.log"
+    target.write_bytes(A_CONTENT)
+
+    # 1. A relative operand containing `..` is passed to open() as given, not resolved away.
+    status, stdout, stderr = run_cli("../sub/a.log", cwd=nested)
+    assert (status, stdout, stderr) == (0, A_REDACTED, b"")
+
+    # ... and when such an operand fails, the diagnostic quotes it as written, not resolved.
+    status, stdout, stderr = run_cli("../sub/missing.log", cwd=nested)
+    assert status == 2
+    assert b"'../sub/missing.log'" in stderr
+    assert bytes(str(tmp_path), "utf-8") not in stderr
+    assert stdout == b""
+
+    # 2. A symlink is opened as supplied.
+    link = nested / "link.log"
+    link.symlink_to(target)
+    status, stdout, stderr = run_cli(str(link))
+    assert (status, stdout, stderr) == (0, A_REDACTED, b"")
+
+    # 3. A glob character is not expanded: `*.log` is a literal file name, so it does not exist
+    #    even though a.log and link.log are both present in the working directory.
+    status, stdout, stderr = run_cli("*.log", cwd=nested)
+    assert status == 2
+    assert b"'*.log'" in stderr
+    assert stdout == b""
+
+    # 4. A literal file whose name contains a glob character is read, again as supplied.
+    starred = nested / "*.log"
+    starred.write_bytes(A_CONTENT)
+    try:
+        status, stdout, stderr = run_cli("*.log", cwd=nested)
+        assert (status, stdout, stderr) == (0, A_REDACTED, b"")
+    finally:
+        os.unlink(starred)
+
+
+# ===============================================================================================
+# T034 — the argument allowlist (SR-001, A-5, C-15, C-20)
+# ===============================================================================================
+
+REJECTED_OPTIONS = ["--verbose", "-h", "--help", "--cou", "--count=1"]
+
+
+@pytest.mark.parametrize("option", REJECTED_OPTIONS)
+def test_rejected_options(option, tmp_path):
+    """C-15, SR-001: rejected on stderr, nothing on stdout, nothing read, status 2."""
+    payload = b"jane@example.com\n"
+    read_fd, write_fd = os.pipe()
+    os.write(write_fd, payload)
+    os.close(write_fd)
+    try:
+        completed = subprocess.run(
+            cli_argv(option),
+            stdin=read_fd,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            env=cli_env(),
+            timeout=60,
+            check=False,
+        )
+        assert completed.returncode == 2
+        assert completed.stdout == b""
+        assert option.split("=")[0].encode() in completed.stderr
+        assert b"usage: python -m logredact" in completed.stderr
+        assert b"Traceback" not in completed.stderr
+        # nothing was read: the payload is still queued in the pipe
+        assert os.read(read_fd, len(payload)) == payload
+    finally:
+        os.close(read_fd)
+
+
+def test_help_is_not_written_to_stdout(run_cli):
+    """SR-001: `-h`/`--help` must not write to stdout nor exit 0 (research.md R9)."""
+    for option in ("-h", "--help"):
+        status, stdout, stderr = run_cli(option)
+        assert status == 2
+        assert stdout == b""
+        assert stderr != b""
+
+
+def test_double_dash_separator(run_cli, tmp_path):
+    """C-20: `--` followed by `-weird.log` treats it as a file operand."""
+    weird = tmp_path / "-weird.log"
+    weird.write_bytes(A_CONTENT)
+    status, stdout, stderr = run_cli("--", "-weird.log", cwd=tmp_path)
+    assert (status, stdout, stderr) == (0, A_REDACTED, b"")
+
+    # and without `--` it is rejected as an unknown option, not silently treated as a file
+    status, stdout, stderr = run_cli("-weird.log", cwd=tmp_path)
+    assert status == 2
+    assert stdout == b""
+
+
+# ===============================================================================================
+# T035 — unreadable operands (FR-012, SC-007, C-11…C-13)
+# ===============================================================================================
+
+
+def test_missing_file(run_cli, tmp_path):
+    """C-11: a path that does not exist."""
+    missing = tmp_path / "does-not-exist.log"
+    status, stdout, stderr = run_cli(str(missing))
+    assert status == 2
+    assert stdout == b""
+    assert str(missing).encode() in stderr
+    assert b"No such file or directory" in stderr
+    assert b"Traceback" not in stderr
+
+
+def test_directory_operand(run_cli, tmp_path):
+    """C-12: a path naming a directory."""
+    status, stdout, stderr = run_cli(str(tmp_path))
+    assert status == 2
+    assert stdout == b""
+    assert str(tmp_path).encode() in stderr
+    assert b"Is a directory" in stderr
+    assert b"Traceback" not in stderr
+
+
+@pytest.mark.skipif(os.geteuid() == 0, reason="root bypasses file permissions")
+def test_unreadable_permissions(run_cli, tmp_path):
+    """C-13: a path whose permissions deny reading."""
+    denied = tmp_path / "denied.log"
+    denied.write_bytes(A_CONTENT)
+    os.chmod(denied, 0o000)
+    try:
+        status, stdout, stderr = run_cli(str(denied))
+        assert status == 2
+        assert stdout == b""
+        assert str(denied).encode() in stderr
+        assert b"Permission denied" in stderr
+        assert b"Traceback" not in stderr
+    finally:
+        os.chmod(denied, 0o600)
+
+
+# ===============================================================================================
+# T036 — continue past an unreadable operand (FR-012, research.md R10, C-23…C-26)
+# ===============================================================================================
+
+
+def test_continues_past_unreadable_operand(run_cli, tmp_path):
+    """C-23: `a.log missing.log b.log` still redacts both readable operands."""
+    a, b = write_pair(tmp_path)
+    missing = tmp_path / "missing.log"
+    status, stdout, stderr = run_cli(str(a), str(missing), str(b))
+    assert stdout == A_REDACTED + B_REDACTED
+    assert status == 2
+    assert b"missing.log" in stderr
+    assert b"Traceback" not in stderr
+
+
+def test_reports_every_unreadable_operand(run_cli, tmp_path):
+    """C-24: one diagnostic per failing operand, in operand order."""
+    a, _ = write_pair(tmp_path)
+    first = tmp_path / "missing1.log"
+    second = tmp_path / "missing2.log"
+    status, stdout, stderr = run_cli(str(first), str(second), str(a))
+    assert status == 2
+    assert stdout == A_REDACTED
+
+    lines = stderr.splitlines()
+    assert len(lines) == 2, stderr
+    assert b"missing1.log" in lines[0]
+    assert b"missing2.log" in lines[1]
+
+
+def test_no_tally_when_an_operand_failed(run_cli, tmp_path):
+    """C-26: with `--count`, a failed run writes no tally at all."""
+    a, _ = write_pair(tmp_path)
+    missing = tmp_path / "missing.log"
+    status, stdout, stderr = run_cli("--count", str(a), str(missing))
+    assert status == 2
+    assert stdout == A_REDACTED
+    assert b"emails=" not in stderr
+    assert b"missing.log" in stderr
+
+
+# ===============================================================================================
+# T037 — the line-length cap (FR-018, SR-005, C-16…C-18, C-25)
+# ===============================================================================================
+
+
+def test_over_length_line(run_cli, tmp_path):
+    """C-16: the first two lines appear; no part of the third does; status 2."""
+    long_log = write_over_length(tmp_path)
+    status, stdout, stderr = run_cli(str(long_log))
+    assert status == 2
+    assert stdout == A_REDACTED + B_REDACTED
+    assert b"x" not in stdout
+    assert str(long_log).encode() in stderr
+    assert b"line exceeds the maximum length of 1048576 characters" in stderr
+    assert b"Traceback" not in stderr
+
+
+@pytest.mark.slow
+def test_line_exactly_at_cap(run_cli, tmp_path):
+    """C-17: a line of exactly 1 MiB *including* its terminator is redacted normally."""
+    # the space matters: without it the filler would be part of the domain's last label, and
+    # `jane@example.comxxx…` is then one (correctly redacted) email address
+    value = b"jane@example.com "
+    filler = b"x" * (CAP - len(value) - 1)
+    at_cap = tmp_path / "at-cap.log"
+    at_cap.write_bytes(value + filler + b"\n")
+    assert len(at_cap.read_bytes()) == CAP
+
+    status, stdout, stderr = run_cli(str(at_cap))
+    assert status == 0
+    assert stdout == b"[EMAIL] " + filler + b"\n"
+    assert stderr == b""
+
+
+def test_no_tally_on_over_length(run_cli, tmp_path):
+    """C-18: no tally is written for a run that ends on an over-length line."""
+    long_log = write_over_length(tmp_path)
+    status, stdout, stderr = run_cli("--count", str(long_log))
+    assert status == 2
+    assert stdout == A_REDACTED + B_REDACTED
+    assert b"emails=" not in stderr
+
+
+def test_over_length_line_stops_remaining_operands(run_cli, tmp_path):
+    """C-25: the run stops at once — a later readable operand is never read.
+
+    This is the deliberate counterpart to C-23: FR-018 requires an over-length line to stop
+    processing, while an unreadable operand is skipped and the run continues (research.md R10).
+    """
+    long_log = write_over_length(tmp_path)
+    a, _ = write_pair(tmp_path)
+    status, stdout, stderr = run_cli(str(long_log), str(a))
+    assert status == 2
+    assert stdout == A_REDACTED + B_REDACTED  # the two short lines of long.log only
+    assert b"first [EMAIL]\nfirst [EMAIL]" not in stdout
+    assert stdout.count(A_REDACTED) == 1
+    assert str(long_log).encode() in stderr
+    assert str(a).encode() not in stderr
+
+
+# ===============================================================================================
+# T038 — diagnostic hygiene (SR-002, SR-003, SC-008, C-14)
+# ===============================================================================================
+
+SENSITIVE = b"jane.doe@example.com 192.168.0.10 4111 1111 1111 1111\n"
+LEAKS = [b"jane", b"example.com", b"192.168", b"4111", b"1111", b"doe"]
+
+
+def _failure_runs(tmp_path):
+    """Every handled failure path, as `(label, argv, stdin)` triples."""
+    sensitive = tmp_path / "sensitive.log"
+    sensitive.write_bytes(SENSITIVE)
+    over_length = tmp_path / "over.log"
+    over_length.write_bytes(SENSITIVE + b"x" * CAP + b"\n")
+    return [
+        ("missing operand", [str(tmp_path / "missing.log")], b""),
+        ("directory operand", [str(tmp_path)], b""),
+        ("rejected option", ["--verbose"], SENSITIVE),
+        ("over-length file", ["--count", str(over_length)], b""),
+        ("over-length stdin", ["--count"], SENSITIVE + b"x" * CAP + b"\n"),
+        ("missing then readable", [str(tmp_path / "gone.log"), str(sensitive)], b""),
+    ]
+
+
+def test_diagnostic_has_no_input_data(tmp_path):
+    """SR-003, SC-008: no input line, match, or fragment of one appears on stderr."""
+    for label, argv, stdin in _failure_runs(tmp_path):
+        completed = subprocess.run(
+            cli_argv(*argv),
+            input=stdin,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            env=cli_env(),
+            timeout=120,
+            check=False,
+        )
+        assert completed.returncode == 2, (label, completed.returncode)
+        for leak in LEAKS:
+            assert leak not in completed.stderr, (label, leak, completed.stderr)
+        assert b"[EMAIL]" not in completed.stderr, label
+        assert b"[CARD]" not in completed.stderr, label
+
+
+def test_no_traceback_on_any_error_path(tmp_path):
+    """C-14: stderr carries no Python traceback on any handled failure path."""
+    for label, argv, stdin in _failure_runs(tmp_path):
+        completed = subprocess.run(
+            cli_argv(*argv),
+            input=stdin,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            env=cli_env(),
+            timeout=120,
+            check=False,
+        )
+        assert b"Traceback" not in completed.stderr, (label, completed.stderr)
+        assert b"Exception ignored" not in completed.stderr, (label, completed.stderr)
+        assert b"Error:" not in completed.stderr, (label, completed.stderr)
+        assert completed.stderr.endswith(b"\n"), label
+
+
+def test_shell_metacharacters_in_operand_name(run_cli, tmp_path):
+    """SR-002: an operand is a plain file name, never anything a shell would interpret."""
+    name = "a;b|c$(id)`id`&d.log"
+    path = tmp_path / name
+    path.write_bytes(A_CONTENT)
+
+    status, stdout, stderr = run_cli(name, cwd=tmp_path)
+    assert (status, stdout, stderr) == (0, A_REDACTED, b"")
+
+    status, stdout, stderr = run_cli("missing;$(id)`id`.log", cwd=tmp_path)
+    assert status == 2
+    assert b"'missing;$(id)`id`.log'" in stderr
+    assert b"uid=" not in stderr
+    assert b"uid=" not in stdout
+
+
+def test_no_subprocess_import():
+    """SR-002: the shipped package starts no process and evaluates no code."""
+    forbidden_modules = {"subprocess", "shlex", "pty", "popen2", "commands"}
+    offences = []
+    for source_file in sorted(Path(SRC).rglob("*.py")):
+        tree = ast.parse(source_file.read_text(), filename=str(source_file))
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Import):
+                for alias in node.names:
+                    if alias.name.split(".")[0] in forbidden_modules:
+                        offences.append((source_file.name, alias.name))
+            elif isinstance(node, ast.ImportFrom):
+                if (node.module or "").split(".")[0] in forbidden_modules:
+                    offences.append((source_file.name, node.module))
+            elif isinstance(node, ast.Call):
+                target = node.func
+                if isinstance(target, ast.Name) and target.id in {"eval", "exec", "compile"}:
+                    offences.append((source_file.name, target.id))
+                if isinstance(target, ast.Attribute) and target.attr in {
+                    "system",
+                    "popen",
+                    "spawn",
+                    "spawnl",
+                    "spawnv",
+                    "execv",
+                    "execl",
+                }:
+                    offences.append((source_file.name, target.attr))
+    assert offences == []
+
+
+def test_requirement_to_test_mapping():
+    """SC-002, Principle III: no requirement is left unmapped, and no name has drifted.
+
+    plan.md records the requirement-to-test mapping so an unmapped requirement is visible before
+    implementation starts. Checking it here turns the implementation gate into something that
+    fails loudly instead of something a reader has to re-verify by hand.
+    """
+    specs = Path(__file__).resolve().parent.parent / "specs" / "001-logredact-cli"
+    plan = (specs / "plan.md").read_text()
+
+    defined = set()
+    for source_file in sorted(Path(__file__).resolve().parent.glob("test_*.py")):
+        tree = ast.parse(source_file.read_text(), filename=str(source_file))
+        for node in tree.body:
+            if isinstance(node, ast.FunctionDef) and node.name.startswith("test_"):
+                defined.add((source_file.name, node.name))
+    by_name = {}
+    for file_name, test_name in defined:
+        by_name.setdefault(test_name, set()).add(file_name)
+
+    expected = (
+        {"FR-%03d" % n for n in range(1, 19)}
+        | {"SR-%03d" % n for n in range(1, 10)}
+        | {"SC-%03d" % n for n in range(1, 11)}
+    )
+
+    mapped = set()
+    unknown = []
+    wrong_file = []
+    for row in plan.splitlines():
+        if not re.match(r"^\| (FR|SR|SC)-\d+", row):
+            continue
+        cells = row.split("|")
+        requirement = cells[1].strip().split()[0]
+        mapped.add(requirement)
+        cell = cells[2]
+        files = re.findall(r"test_[A-Za-z0-9_]+\.py", cell)
+        for name in sorted(set(re.findall(r"test_[A-Za-z0-9_]+", re.sub(r"test_[A-Za-z0-9_]+\.py", "", cell)))):
+            if name not in by_name:
+                unknown.append((requirement, name))
+            elif files and not (set(files) & by_name[name]):
+                wrong_file.append((requirement, name, sorted(by_name[name])))
+
+    assert unknown == [], unknown
+    assert wrong_file == [], wrong_file
+    assert expected - mapped == set(), sorted(expected - mapped)
+    # SC-002 is the only item the table maps to itself: it is this check.
+    unmapped_to_a_test = {
+        requirement
+        for requirement in expected
+        if not re.search(
+            r"^\| " + requirement + r"[^|]*\|[^|]*test_", plan, re.MULTILINE
+        )
+    }
+    assert unmapped_to_a_test == {"SC-002"}, sorted(unmapped_to_a_test)
+
+
+def test_only_standard_library_imports():
+    """Principle I: no third-party module is imported by shipped code."""
+    allowed = set(sys.stdlib_module_names) | {"logredact"}
+    offences = []
+    for source_file in sorted(Path(SRC).rglob("*.py")):
+        tree = ast.parse(source_file.read_text(), filename=str(source_file))
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Import):
+                for alias in node.names:
+                    if alias.name.split(".")[0] not in allowed:
+                        offences.append((source_file.name, alias.name))
+            elif isinstance(node, ast.ImportFrom) and node.level == 0:
+                if (node.module or "").split(".")[0] not in allowed:
+                    offences.append((source_file.name, node.module))
+    assert offences == []
+
+
+# ===============================================================================================
+# T039 — write failures and a closed downstream pipe (SR-009, A-7, C-22)
+# ===============================================================================================
+
+
+@pytest.mark.skipif(not os.path.exists("/dev/full"), reason="needs /dev/full")
+def test_write_failure_fails_run(tmp_path):
+    """SR-009: a run whose output could not be written is never reported as success."""
+    with open("/dev/full", "wb") as sink:
+        completed = subprocess.run(
+            cli_argv("--count"),
+            input=b"jane@example.com\n" * 100,
+            stdout=sink,
+            stderr=subprocess.PIPE,
+            env=cli_env(),
+            timeout=60,
+            check=False,
+        )
+    assert completed.returncode == 2, completed.stderr
+    assert b"cannot write output" in completed.stderr
+    assert b"emails=" not in completed.stderr
+    assert b"Traceback" not in completed.stderr
+    assert b"Exception ignored" not in completed.stderr
+
+
+def test_broken_pipe_status_141(tmp_path):
+    """C-22, A-7: stdout closed early gives no traceback and status 141."""
+    source = tmp_path / "many.log"
+    source.write_bytes(b"jane@example.com\n" * 300000)
+
+    head = subprocess.Popen(
+        ["head", "-1"], stdin=subprocess.PIPE, stdout=subprocess.PIPE
+    )
+    with open(source, "rb") as handle:
+        tool = subprocess.Popen(
+            cli_argv(),
+            stdin=handle,
+            stdout=head.stdin,
+            stderr=subprocess.PIPE,
+            env=cli_env(),
+        )
+    head.stdin.close()
+    head_output = head.stdout.read()
+    head.stdout.close()
+    head.wait(timeout=60)
+    stderr = tool.communicate(timeout=120)[1]
+
+    assert head_output == b"[EMAIL]\n"
+    assert tool.returncode == 128 + signal.SIGPIPE
+    assert tool.returncode == 141
+    assert b"Traceback" not in stderr
+    assert b"Exception ignored" not in stderr
+    assert b"emails=" not in stderr
