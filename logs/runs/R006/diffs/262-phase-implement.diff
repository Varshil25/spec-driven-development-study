index 0000000..2fb9cf7
--- /dev/null
+++ b/src/logredact/redact.py
@@ -0,0 +1,197 @@
+"""Recognition and replacement rules.
+
+Pure: text in, redacted text out plus counter increments. No I/O happens here, which is what lets
+the recognition cases run as fast in-process unit tests (plan.md Structure Decision).
+
+The three fixed categories, their placeholders and their precedence are constants, not
+configuration: A-9 leaves nothing to configure, so no option, environment variable or file can
+change any value below (SR-005, FR-006, data-model.md Module-level constants).
+"""
+
+import re
+
+MAX_LINE_CHARS = 1 << 20
+"""1,048,576 characters *including* the line terminator. The cap is inclusive: a line of exactly
+1 MiB is accepted, one character more is refused (SR-005, FR-018)."""
+
+MIN_CARD_DIGITS = 13
+MAX_CARD_DIGITS = 19
+
+EMAIL_PLACEHOLDER = "[EMAIL]"
+IP_PLACEHOLDER = "[IP]"
+CARD_PLACEHOLDER = "[CARD]"
+
+
+# ===============================================================================================
+# Patterns
+# ===============================================================================================
+
+_EMAIL = (
+    # DO NOT REMOVE this lookbehind. It is required for linear-time matching (SR-005), not
+    # cosmetic. Without it the engine re-consumes the whole local-part run at every start
+    # position inside it, which is quadratic: measured 7,142 ms for an 80 KB line, extrapolating
+    # to ~1.5 hours for one 1 MiB line — a usable denial of service. With it, every position but
+    # the first character of a run fails in one comparison (measured 1.2 ms at 80 KB).
+    #
+    # It provably does not change which text matches: the local part must end at the `@`, so
+    # every start position inside one run reaches the same `@` and evaluates the same domain
+    # text. Rejecting all but the run's first start removes duplicate work, never a match.
+    # (research.md R5, contracts/redaction-rules.md)
+    r"(?<![A-Za-z0-9._%+-])"
+    r"[A-Za-z0-9._%+-]+"  # local part (FR-004)
+    r"@"
+    r"[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*"  # dot-separated letter/digit/hyphen labels
+    r"\.[A-Za-z]{2,}"  # last label: at least two letters, and at least two labels (R6)
+)
+
+# Each octet is 0-255 with no leading zeros beyond a single `0` (FR-005). The branches are
+# mutually exclusive, so there is nothing to backtrack into: linear by construction (SR-005).
+_OCTET = r"(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])"
+
+_IPV4 = (
+    r"(?<![0-9.])"  # FR-013: not flanked by a digit or a dot
+    + _OCTET
+    + r"(?:\."
+    + _OCTET
+    + r"){3}"
+    r"(?![0-9.])"
+)
+
+# A *maximal* run of digit groups joined by single spaces or single hyphens. Doubled separators
+# deliberately do not match `[ -]`, which is what leaves `4111  1111  1111  1111` and
+# `4111--1111--1111--1111` alone (FR-006, research.md R8).
+#
+# `[0-9]` rather than `\d`: FR-006 says *decimal* digits and A-4 limits the rules to the ASCII
+# range, whereas `\d` would also match non-ASCII decimal digits, which `ord(ch) - 48` below
+# cannot score.
+_CARD_RUN = r"(?<![0-9])[0-9]+(?:[ -][0-9]+)*"
+
+#: One compiled pattern, three named alternatives **in precedence order**. The alternation order
+#: *is* the precedence — there is no enum, registry or rule table (FR-014, A-2, research.md R4).
+PATTERN = re.compile(
+    "(?P<email>" + _EMAIL + ")|(?P<ip>" + _IPV4 + ")|(?P<card>" + _CARD_RUN + ")"
+)
+
+
+# ===============================================================================================
+# Card candidate selection
+# ===============================================================================================
+
+
+def _longest_candidate(run, start, end):
+    """Length in characters of the longest card candidate starting at `run[start]`, else 0.
+
+    A candidate is a contiguous sequence of *whole* groups whose total digit count is 13 to 19,
+    whose internal separators are all the same single space or single hyphen, and whose digits
+    pass Luhn. `start` must be a group's first digit; a candidate may only end at a group's last
+    digit, which is exactly FR-013's "not flanked by a digit".
+
+    The Luhn sum is kept incrementally in two parities and in O(1) extra memory, because
+    appending a digit flips the doubling parity of every earlier digit:
+
+        A' = B + digit          A = sum with the rightmost digit *not* doubled (the real sum)
+        B' = A + doubled(digit) B = sum with the rightmost digit doubled
+
+    This is not a premature micro-optimisation. The straightforward version — tokenise the run,
+    join each candidate and re-checksum it — measured 15.8 s for one adversarial 1 MiB line and
+    allocated ~500,000 strings for it, breaking the fixed memory bound of SC-010. Do not
+    "simplify" it back (SR-005, SC-010, research.md R8).
+    """
+    a = 0
+    b = 0
+    digits = 0
+    separator = ""
+    best = 0
+    index = start
+    while index < end:
+        value = ord(run[index]) - 48
+        if 0 <= value <= 9:
+            a, b = b + value, a + (2 * value - 9 if value > 4 else 2 * value)
+            digits += 1
+            index += 1
+            if digits > MAX_CARD_DIGITS:
+                break
+            # A candidate must end at a group's last digit, so only consider it when the next
+            # character is not a digit.
+            if digits >= MIN_CARD_DIGITS and (
+                index >= end or not "0" <= run[index] <= "9"
+            ):
+                if a % 10 == 0:
+                    best = index - start
+        else:
+            # A separator. The first one crossed fixes the candidate's separator; a different
+            # one ends the candidate (FR-006 "the same separator character throughout").
+            character = run[index]
+            if separator == "":
+                separator = character
+            elif character != separator:
+                break
+            index += 1
+    return best
+
+
+def _redact_cards(run, tally):
+    """Replace every card candidate inside one matched digit run.
+
+    Candidates are selected leftmost first, longest at that position; scanning continues after
+    the replaced candidate. Every character of the run that is not part of a redacted candidate
+    is reproduced unchanged — including the separator between two adjacent cards, which an
+    earlier design swallowed (FR-008, Phase 0 regression, research.md R8).
+    """
+    end = len(run)
+    pieces = None  # built only once something is actually redacted
+    copied = 0  # how much of `run` has been copied into `pieces`
+    index = 0
+    while index < end:
+        length = _longest_candidate(run, index, end)
+        if length:
+            if pieces is None:
+                pieces = []
+            pieces.append(run[copied:index])
+            pieces.append(CARD_PLACEHOLDER)
+            tally["cards"] += 1
+            index += length
+            copied = index
+            # Step over the separator that follows the candidate; it is preserved, because the
+            # next copied slice starts at `copied`.
+            while index < end and not ("0" <= run[index] <= "9"):
+                index += 1
+        else:
+            # No candidate starts here: step to the first digit of the next group.
+            while index < end and "0" <= run[index] <= "9":
+                index += 1
+            while index < end and not ("0" <= run[index] <= "9"):
+                index += 1
+    if pieces is None:
+        return run
+    pieces.append(run[copied:])
+    return "".join(pieces)
+
+
+# ===============================================================================================
+# Replacement
+# ===============================================================================================
+
+
+def _replace(match, tally):
+    """Replace one match with its kind's placeholder, counting it once (A-1, FR-014)."""
+    kind = match.lastgroup
+    if kind == "email":
+        tally["emails"] += 1
+        return EMAIL_PLACEHOLDER
+    if kind == "ip":
+        tally["ips"] += 1
+        return IP_PLACEHOLDER
+    # A card run may contain zero, one or several candidates; each redaction counts once.
+    return _redact_cards(match.group(), tally)
+
+
+def redact_line(text, tally):
+    """Return `text` with every match replaced, incrementing `tally` once per replacement.
+
+    `re.sub`'s own semantics deliver FR-014 — leftmost match, non-overlapping matches,
+    alternatives tried in written order, and replaced text never re-scanned — so there is no
+    bookkeeping of our own here. No match list is accumulated, so memory stays bounded by one
+    line (FR-016, research.md R4).
+    """
+    return PATTERN.sub(lambda match: _replace(match, tally), text)
