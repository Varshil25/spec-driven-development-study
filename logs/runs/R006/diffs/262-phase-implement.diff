+++ b/tests/test_cli_files.py
@@ -0,0 +1,138 @@
+"""Contract tests for User Story 2 — named FILE operands (FR-001, FR-003, FR-017, SR-007)."""
+
+import os
+import subprocess
+
+from conftest import cli_argv, cli_env
+
+A_CONTENT = b"first jane@example.com\n"
+A_REDACTED = b"first [EMAIL]\n"
+B_CONTENT = b"second 10.0.0.7\nthird 4111 1111 1111 1111\n"
+B_REDACTED = b"second [IP]\nthird [CARD]\n"
+
+
+def write_pair(tmp_path):
+    a = tmp_path / "a.log"
+    b = tmp_path / "b.log"
+    a.write_bytes(A_CONTENT)
+    b.write_bytes(B_CONTENT)
+    return a, b
+
+
+def test_two_operands(run_cli, tmp_path):
+    """C-07: stdout is redacted `a.log` immediately followed by redacted `b.log`."""
+    a, b = write_pair(tmp_path)
+    status, stdout, stderr = run_cli(str(a), str(b))
+    assert stdout == A_REDACTED + B_REDACTED
+    assert stderr == b""
+    assert status == 0
+
+
+def test_operand_order(run_cli, tmp_path):
+    """C-08: operand order is honoured, never sorted."""
+    a, b = write_pair(tmp_path)
+    status, stdout, _ = run_cli(str(a), str(b))
+    assert status == 0
+    assert stdout == A_REDACTED + B_REDACTED
+
+
+def test_reverse_order(run_cli, tmp_path):
+    """C-08: the reverse operand order gives the reverse output order."""
+    a, b = write_pair(tmp_path)
+    status, stdout, _ = run_cli(str(b), str(a))
+    assert status == 0
+    assert stdout == B_REDACTED + A_REDACTED
+
+
+def test_repeated_operand(run_cli, tmp_path):
+    """C-10: the same operand twice yields its redacted contents twice."""
+    a, _ = write_pair(tmp_path)
+    status, stdout, stderr = run_cli(str(a), str(a))
+    assert stdout == A_REDACTED + A_REDACTED
+    assert stderr == b""
+    assert status == 0
+
+
+def test_stdin_not_read_when_operand_given(tmp_path):
+    """C-09: with an operand present, piped stdin is neither blocked on nor consumed."""
+    a, _ = write_pair(tmp_path)
+    payload = b"ignored jane@example.com\n"
+    read_fd, write_fd = os.pipe()
+    os.write(write_fd, payload)
+    os.close(write_fd)
+    try:
+        completed = subprocess.run(
+            cli_argv(str(a)),
+            stdin=read_fd,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            env=cli_env(),
+            timeout=60,
+            check=False,
+        )
+        assert completed.returncode == 0
+        assert completed.stdout == A_REDACTED
+        assert completed.stderr == b""
+        # The payload is still queued in the pipe, so it was never consumed. Had the tool read
+        # it, every writer would be closed and this read would return b"" at EOF.
+        assert os.read(read_fd, len(payload)) == payload
+    finally:
+        os.close(read_fd)
+
+
+def test_operands_unmodified(run_cli, tmp_path):
+    """FR-017: operand content and mtime are unchanged after the run."""
+    a, b = write_pair(tmp_path)
+    before = {p: (p.read_bytes(), os.stat(p).st_mtime_ns) for p in (a, b)}
+
+    status, stdout, _ = run_cli(str(a), str(b))
+    assert status == 0
+    assert stdout == A_REDACTED + B_REDACTED
+
+    for path, (content, mtime) in before.items():
+        assert path.read_bytes() == content
+        assert os.stat(path).st_mtime_ns == mtime
+
+
+def _snapshot(root):
+    entries = {}
+    for current, directories, files in os.walk(root):
+        directories.sort()
+        for name in sorted(files) + sorted(directories):
+            path = os.path.join(current, name)
+            info = os.stat(path, follow_symlinks=False)
+            entries[os.path.relpath(path, root)] = (info.st_size, info.st_mtime_ns)
+    return entries
+
+
+def test_no_files_created_or_modified(run_cli, tmp_path):
+    """SR-007: nothing is created — no temporary file, no cache, no log file."""
+    a, b = write_pair(tmp_path)
+    before = _snapshot(tmp_path)
+
+    status, stdout, _ = run_cli(str(a), str(b), "--count", cwd=tmp_path)
+    assert status == 0
+    assert stdout == A_REDACTED + B_REDACTED
+
+    assert _snapshot(tmp_path) == before
+
+
+def test_empty_operand_file(run_cli, tmp_path):
+    """An empty file contributes nothing and is not an error (FR-015)."""
+    empty = tmp_path / "empty.log"
+    empty.write_bytes(b"")
+    a, _ = write_pair(tmp_path)
+    status, stdout, stderr = run_cli(str(empty), str(a), str(empty))
+    assert (status, stdout, stderr) == (0, A_REDACTED, b"")
+
+
+def test_operand_without_final_newline_concatenates_exactly(run_cli, tmp_path):
+    """FR-008, FR-009: no terminator is added between operands."""
+    first = tmp_path / "first.log"
+    second = tmp_path / "second.log"
+    first.write_bytes(b"no newline jane@example.com")
+    second.write_bytes(b"next 10.0.0.7\n")
+    status, stdout, stderr = run_cli(str(first), str(second))
+    assert stdout == b"no newline [EMAIL]next [IP]\n"
+    assert stderr == b""
+    assert status == 0
