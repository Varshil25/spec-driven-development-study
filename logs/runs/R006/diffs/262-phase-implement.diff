+"""Resource bounds: linear time and bounded memory (SR-005, SC-006, SC-010).
+
+These are the tripwires for the two Phase 0 defects. A regression in the email pattern does not
+present as a slowdown but as a hang: the unguarded pattern took an extrapolated ~1.5 hours on a
+single 1 MiB line (research.md R5, R14). Every test here is marked `slow` but is kept runnable,
+never skipped.
+"""
+
+import io
+import os
+import subprocess
+import sys
+import time
+import tracemalloc
+
+import pytest
+
+from conftest import cli_argv, cli_env
+from logredact.cli import STREAM_SETTINGS, main
+from logredact.redact import redact_line
+
+#: Doubling sizes, topping out at the 1 MiB line cap.
+SIZES = [262144, 524288, 1048576]
+
+#: The adversarial line shapes research.md R5 and R8 measured.
+SHAPES = {
+    "no-at-run": lambda n: "a" * n,
+    "at-then-dots": lambda n: "a" * (n // 2) + "@" + "1." * (n // 4),
+    "space-digits": lambda n: "1 " * (n // 2),
+    "hyphen-digits": lambda n: "1-" * (n // 2),
+    "dots": lambda n: "." * n,
+    "card-prefix": lambda n: "4111 " * (n // 5),
+}
+
+#: Generous ceiling for one 1 MiB line: measured worst case was 3.4 s (research.md R14).
+CEILING_SECONDS = 10.0
+
+
+def _time_redaction(text):
+    tally = {"emails": 0, "ips": 0, "cards": 0}
+    started = time.monotonic()
+    redact_line(text, tally)
+    return time.monotonic() - started
+
+
+@pytest.mark.slow
+@pytest.mark.parametrize("shape", sorted(SHAPES))
+def test_adversarial_lines_are_linear(shape):
+    """Time must roughly double as the line doubles, never quadruple (SR-005)."""
+    build = SHAPES[shape]
+    elapsed = [_time_redaction(build(size)) for size in SIZES]
+
+    assert elapsed[-1] < CEILING_SECONDS, (shape, dict(zip(SIZES, elapsed)))
+
+    floor = 0.002  # below this the measurement is timer noise, not work
+    for previous, current in zip(elapsed, elapsed[1:]):
+        if previous < floor:
+            continue
+        assert current / previous < 3.0, (shape, dict(zip(SIZES, elapsed)))
+
+
+#: Realistic log line, as research.md R14 measured throughput on.
+REALISTIC_LINE = b"user jane@example.com from 10.0.0.7 card 4111 1111 1111 1111 ok\n"
+
+#: Address-space ceiling for the large run. Measured: a 200 MiB input completes under 48 MiB.
+ADDRESS_SPACE_CAP = 64 * 1024 * 1024
+
+_FEEDER = """
+import sys
+target = int(sys.argv[1])
+block = sys.stdin.buffer.read()
+written = 0
+out = sys.stdout.buffer
+try:
+    while written < target:
+        out.write(block)
+        written += len(block)
+    out.flush()
+except BrokenPipeError:
+    pass
+"""
+
+
+def _run_capped(total_bytes, block):
+    """Feed `total_bytes` of `block` through the tool, with its address space capped.
+
+    The cap is the instrument. A child's `ru_maxrss` is useless here because Linux copies the
+    parent's high-water mark across fork, so a child of pytest reports pytest's peak; an
+    enforced `RLIMIT_AS` is immune to that. If peak memory grew with input size, a 200 MiB input
+    could not complete under a 64 MiB ceiling at all.
+    """
+
+    def cap_address_space():
+        import resource
+
+        resource.setrlimit(resource.RLIMIT_AS, (ADDRESS_SPACE_CAP, ADDRESS_SPACE_CAP))
+
+    feeder = subprocess.Popen(
+        [sys.executable, "-c", _FEEDER, str(total_bytes)],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+    )
+    feeder.stdin.write(block)
+    feeder.stdin.close()
+    tool = subprocess.Popen(
+        cli_argv("--count"),
+        stdin=feeder.stdout,
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.PIPE,
+        env=cli_env(),
+        preexec_fn=cap_address_space,
+    )
+    feeder.stdout.close()
+    stderr = tool.communicate(timeout=900)[1]
+    feeder.kill()
+    feeder.wait(timeout=60)
+    return tool.returncode, stderr
+
+
+def _traced_peak(payload, monkeypatch):
+    """Traced peak allocation of one in-process run over `payload`.
+
+    Tracing starts after `payload` exists, so the figure is what the run itself allocates. The
+    sink is `os.devnull`, not a buffer, so the output cannot pollute the measurement.
+    """
+    source = io.TextIOWrapper(io.BytesIO(payload), **STREAM_SETTINGS)
+    with open(os.devnull, "w", **STREAM_SETTINGS) as sink:
+        monkeypatch.setattr(sys, "stdin", source)
+        monkeypatch.setattr(sys, "stdout", sink)
+        tracemalloc.start()
+        try:
+            tracemalloc.reset_peak()
+            status = main([])
+            _, peak = tracemalloc.get_traced_memory()
+        finally:
+            tracemalloc.stop()
+    return status, peak
+
+
+@pytest.mark.slow
+def test_peak_memory_independent_of_input_size(monkeypatch):
+    """SC-006, FR-016: peak memory is bounded by a line and does not grow with input size."""
+    # 1. ~200 MiB of realistic log lines — around 100x the tool's peak — completes with status 0
+    #    through an address space capped far below the input size.
+    total = 200 * 1024 * 1024
+    block = REALISTIC_LINE * 1000
+    status, stderr = _run_capped(total, block)
+    expected = (total // len(block) + 1) * 1000
+    assert status == 0, stderr
+    assert stderr == b"emails=%d ips=%d cards=%d\n" % (expected, expected, expected)
+
+    # 2. And the traced peak itself is flat: 10x the input allocates no more.
+    small_status, small_peak = _traced_peak(REALISTIC_LINE * 32768, monkeypatch)
+    large_status, large_peak = _traced_peak(REALISTIC_LINE * 327680, monkeypatch)
+    assert (small_status, large_status) == (0, 0)
+    assert large_peak < small_peak * 1.5, (small_peak, large_peak)
+    assert large_peak < 4 * 1024 * 1024, large_peak
+
+
+@pytest.mark.slow
+def test_over_length_line_not_loaded_into_memory(monkeypatch):
+    """SC-010, SR-005: an over-length line is refused without being read into memory.
+
+    An 8 MiB single line stands in for the spec's 1 GB case. Tracing starts *after* the input is
+    built, so the peak below is what the run itself allocates: research.md R2 measured 2.01 MiB,
+    i.e. the cap plus one 8 KiB read chunk, not the length of the offending line.
+    """
+    line_bytes = 8 * 1024 * 1024
+    source = io.BytesIO(b"x" * line_bytes + b"\n")
+    sink = io.BytesIO()
+    errors = io.StringIO()
+    monkeypatch.setattr(sys, "stdin", io.TextIOWrapper(source, **STREAM_SETTINGS))
+    monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(sink, **STREAM_SETTINGS))
+    monkeypatch.setattr(sys, "stderr", errors)
+
+    tracemalloc.start()
+    try:
+        tracemalloc.reset_peak()
+        status = main([])
+        _, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+
+    assert status == 2
+    assert sink.getvalue() == b""
+    assert "line exceeds the maximum length" in errors.getvalue()
+    assert "standard input" in errors.getvalue()
+    assert peak < line_bytes // 2, peak