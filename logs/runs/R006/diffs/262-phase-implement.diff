+++ b/src/logredact/cli.py
@@ -0,0 +1,212 @@
+"""Command-line interface: argument allowlist, input sources, line loop, diagnostics, tally.
+
+Standard output carries the redacted input and nothing else, ever. Standard error carries
+diagnostics and the `--count` tally only, and never any input data (SR-003,
+contracts/cli.md Streams).
+"""
+
+import argparse
+import os
+import signal
+import sys
+
+from .redact import MAX_LINE_CHARS, redact_line
+
+EXIT_OK = 0
+EXIT_ERROR = 2
+EXIT_SIGPIPE = 128 + signal.SIGPIPE  # 141, the usual convention for a closed pipe (A-7)
+
+PROG = "python -m logredact"
+
+#: The name a diagnostic uses for standard input (A-6, FR-018).
+STDIN_NAME = "standard input"
+
+# Shared text-stream settings for every input and for standard output (research.md R3).
+# `surrogateescape` maps each undecodable byte to a lone surrogate and re-encodes it to the
+# identical byte on output (A-4); `newline=""` disables newline translation, so `\n`, `\r\n`, a
+# lone `\r` and a missing final terminator all survive unchanged (FR-009).
+STREAM_SETTINGS = {"encoding": "utf-8", "errors": "surrogateescape", "newline": ""}
+
+
+class _OverLengthLine(Exception):
+    """A line exceeded the cap, so the run must stop at once (FR-018).
+
+    Carried as an exception rather than a return code because it unwinds past the per-source
+    loop: FR-018 says the tool "MUST stop processing", so no later operand is read. Its argument
+    is the source's display name — never any part of the offending line (SR-003).
+    """
+
+
+def _error(message):
+    """Write one diagnostic line to standard error (Principle II, SR-003).
+
+    `message` is assembled from fixed literals plus, at most, the operand the caller supplied
+    and the operating system's own `strerror`. No input line, match, or fragment of one is ever
+    formatted into a diagnostic, and the input is never used as a format string (SR-002, SR-003).
+    """
+    sys.stderr.write(PROG + ": error: " + message + "\n")
+
+
+def _reason(exc):
+    """The operating system's message for an `OSError` — it names the file and the reason."""
+    return exc.strerror if exc.strerror else str(exc)
+
+
+def _report_unreadable(display_name, exc):
+    _error("cannot read '" + display_name + "': " + _reason(exc))
+
+
+def _write_tally(tally):
+    """Write the one-line run tally to standard error (FR-010, SR-004).
+
+    A fixed format string over the three `int` counters, so nothing derived from the data can
+    reach it: no sample value, no line number, no file name (research.md R10).
+    """
+    sys.stderr.write(
+        "emails=%d ips=%d cards=%d\n" % (tally["emails"], tally["ips"], tally["cards"])
+    )
+
+
+def _abandon_stdout():
+    """Point the standard-output descriptor at `os.devnull`.
+
+    After a failed write the unwritten data is still in the buffer, and after a closed pipe there
+    is no reader left. In both cases the interpreter would try to flush again during shutdown and
+    emit a second, unhandled failure — `Exception ignored in: <_io.TextIOWrapper ...>` — on
+    standard error, after the run had already reported the problem properly. Redirecting the
+    descriptor makes that final flush a no-op.
+
+    The standard Python idiom, in preference to restoring `SIGPIPE` to `SIG_DFL`, which would
+    change interpreter-wide signal state (research.md R11).
+    """
+    devnull = os.open(os.devnull, os.O_WRONLY)
+    try:
+        os.dup2(devnull, sys.stdout.fileno())
+    finally:
+        os.close(devnull)
+
+
+def _build_parser():
+    """The strict argument allowlist of SR-001.
+
+    `add_help=False` and `allow_abbrev=False` are required, not stylistic: the argparse defaults
+    would accept `--cou` as an abbreviation of `--count` and would make `-h` write help to
+    *standard output* and exit *0*, both of which SR-001 forbids (research.md R9).
+    """
+    parser = argparse.ArgumentParser(
+        prog=PROG,
+        add_help=False,
+        allow_abbrev=False,
+        usage="%(prog)s [--count] [FILE ...]",
+    )
+    parser.add_argument("--count", action="store_true")
+    parser.add_argument("files", nargs="*", metavar="FILE")
+    return parser
+
+
+def _redact_stream(stream, display_name, tally, out):
+    """Redact `stream` line by line onto `out`.
+
+    Returns `True` when the whole stream was processed and `False` when a read failed, in which
+    case the failure has already been reported and the rest of this source is skipped (FR-012,
+    A-6). Raises `_OverLengthLine` when a line exceeds the cap (FR-018).
+
+    `readline(MAX_LINE_CHARS + 1)` is what bounds peak memory to one line: it stops at the first
+    of a terminator, the limit, or EOF, so a chunk shorter than the limit is a complete line, a
+    chunk of exactly the limit is an over-length line, and no line is ever read beyond the cap
+    plus one `TextIOWrapper` read chunk before being rejected (FR-016, SR-005, research.md R2).
+    """
+    while True:
+        try:
+            chunk = stream.readline(MAX_LINE_CHARS + 1)
+        except OSError as exc:
+            # Caught narrowly, at the read boundary only, and always reported (Principle II).
+            _report_unreadable(display_name, exc)
+            return False
+        if chunk == "":
+            return True
+        if len(chunk) == MAX_LINE_CHARS + 1:
+            # No part of this line — redacted, unredacted, or truncated — is written (FR-018).
+            raise _OverLengthLine(display_name)
+        out.write(redact_line(chunk, tally))
+
+
+def _run(args, out):
+    """Redact every source onto `out` in operand order. Returns the exit status."""
+    # One mutable tally for the whole run, threaded into redact_line and incremented by the
+    # replacer. Accumulated across all sources: there is no per-file tally (FR-010, A-1).
+    tally = {"emails": 0, "ips": 0, "cards": 0}
+
+    # One run-level flag. Status 2 is a single failure status however many operands failed: not
+    # a count, and no distinct status per failure kind (A-5, FR-012, research.md R10).
+    failed = False
+
+    # The ordered operand list argparse produced *is* the representation: no sorting, no
+    # de-duplication, no source class. `None` stands for standard input, which is read only when
+    # there are no operands (FR-002, FR-003, data-model.md Input source).
+    try:
+        for operand in args.files if args.files else [None]:
+            if operand is None:
+                stream = sys.stdin
+                stream.reconfigure(**STREAM_SETTINGS)
+                if not _redact_stream(stream, STDIN_NAME, tally, out):
+                    failed = True
+                continue
+
+            try:
+                # The operand string is passed verbatim: no os.path.join, no resolve, no glob,
+                # no normalisation, and never opened for writing, creation or truncation
+                # (SR-008, FR-017).
+                handle = open(operand, "r", **STREAM_SETTINGS)
+            except OSError as exc:
+                # Reported and skipped: every remaining operand is still processed and the status
+                # is settled at the end of the run (FR-012, research.md R10). This is the
+                # deliberate counterpart to the over-length line below, which stops the run.
+                _report_unreadable(operand, exc)
+                failed = True
+                continue
+            with handle:
+                if not _redact_stream(handle, operand, tally, out):
+                    failed = True
+    except _OverLengthLine as over_length:
+        # Output already written for earlier lines remains written (FR-018), so flush it before
+        # reporting, and read no later operand.
+        out.flush()
+        _error(
+            str(over_length)
+            + ": line exceeds the maximum length of "
+            + str(MAX_LINE_CHARS)
+            + " characters"
+        )
+        return EXIT_ERROR
+
+    # Flush before the tally so a caller watching both streams sees the complete log first
+    # (A-3), and before returning success so a buffered ENOSPC or EIO cannot surface after a 0
+    # exit (SR-009, research.md R12).
+    out.flush()
+    if failed:
+        return EXIT_ERROR
+    # The tally is written only when --count was given *and* the run is exiting 0, so a partial
+    # tally can never be mistaken for a complete one (FR-010, FR-018, research.md R10).
+    if args.count:
+        _write_tally(tally)
+    return EXIT_OK
+
+
+def main(argv=None):
+    """Entry point. Returns the process exit status: 0, 2, or 141 and nothing else."""
+    args = _build_parser().parse_args(argv)
+    sys.stdout.reconfigure(**STREAM_SETTINGS)
+    try:
+        return _run(args, sys.stdout)
+    except BrokenPipeError:
+        # Standard output was closed early by the consumer. Not a successful run (A-7).
+        _abandon_stdout()
+        return EXIT_SIGPIPE
+    except OSError as exc:
+        # Reached only from a write or flush on standard output: every read is handled at its own
+        # boundary above. A run whose output was not fully written is never reported as a success
+        # (SR-009, research.md R12).
+        _error("cannot write output: " + _reason(exc))
+        _abandon_stdout()
+        return EXIT_ERROR
