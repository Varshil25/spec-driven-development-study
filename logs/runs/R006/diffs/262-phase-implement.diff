+"""Contract tests for User Story 1 — the piped stream (FR-001, FR-002, FR-009, FR-015).
+
+Everything here runs the real `python -m logredact` in a subprocess and compares raw bytes, which
+is the only way to verify FR-001 and the byte-for-byte guarantees against the delivered interface
+(research.md R13).
+"""
+
+import pytest
+
+
+def test_module_invocation(run_cli):
+    """C-01: the tool is invocable as `python -m logredact` (FR-001)."""
+    status, stdout, stderr = run_cli(stdin=b"user jane@example.com from 10.0.0.7\n")
+    assert (status, stdout, stderr) == (0, b"user [EMAIL] from [IP]\n", b"")
+
+
+def test_reads_stdin_when_no_operands(run_cli):
+    """C-01: with no operand the input comes from standard input (FR-002)."""
+    status, stdout, stderr = run_cli(stdin=b"host 10.0.0.7\n")
+    assert status == 0
+    assert stdout == b"host [IP]\n"
+    assert stderr == b""
+
+
+WORKED_EXAMPLES = [
+    # C-01
+    (b"user jane@example.com from 10.0.0.7\n", b"user [EMAIL] from [IP]\n"),
+    # C-02 — the Luhn-failing 13-digit run is untouched
+    (
+        b"paid with 4111 1111 1111 1111, ref 1234567890123\n",
+        b"paid with [CARD], ref 1234567890123\n",
+    ),
+    # C-03 — the out-of-range quad is untouched
+    (b"host 999.1.1.1 and 192.168.0.10\n", b"host 999.1.1.1 and [IP]\n"),
+]
+
+
+@pytest.mark.parametrize("stdin,expected", WORKED_EXAMPLES)
+def test_worked_examples(run_cli, stdin, expected):
+    """SC-001: all three worked examples reproduce byte-for-byte, stderr empty, status 0."""
+    status, stdout, stderr = run_cli(stdin=stdin)
+    assert stdout == expected
+    assert stderr == b""
+    assert status == 0
+
+
+PASSTHROUGH = [
+    b"GET /health 200 in 3ms\n",
+    b"2026-11-05T10:00:00Z INFO service started\n",
+    b"release v1.2.3-rc4 deployed\n",
+    b"[EMAIL] already present\n",
+    b"ref 1234567890123 rejected\n",
+    b"host 999.1.1.1 unreachable\n",
+    b"user@localhost connected\n",
+]
+
+
+def test_passthrough_byte_identical(run_cli):
+    """C-21: input with no redactable values comes back byte-for-byte (FR-009)."""
+    payload = b"".join(PASSTHROUGH)
+    status, stdout, stderr = run_cli(stdin=payload)
+    assert stdout == payload
+    assert stderr == b""
+    assert status == 0
+
+
+TERMINATOR_CASES = [
+    b"a@b.io\n",
+    b"a@b.io\r\n",
+    b"a@b.io\r",
+    b"a@b.io",
+    b"one\ntwo\r\nthree\rfour",
+    b"\n\n\n",
+    b"\r\n\r\n",
+]
+
+
+@pytest.mark.parametrize("stdin", TERMINATOR_CASES)
+def test_crlf_and_missing_final_newline(run_cli, stdin):
+    """FR-009: `\\n`, `\\r\\n`, a lone `\\r` and a missing final terminator are all exact."""
+    status, stdout, stderr = run_cli(stdin=stdin)
+    expected = stdin.replace(b"a@b.io", b"[EMAIL]")
+    assert stdout == expected
+    assert stderr == b""
+    assert status == 0
+
+
+def test_invalid_utf8_passed_through(run_cli):
+    """A-4: bytes that are not valid UTF-8 survive unchanged."""
+    stdin = b"caf\xe9 jane@example.com \xff\xfe\n"
+    status, stdout, stderr = run_cli(stdin=stdin)
+    assert stdout == b"caf\xe9 [EMAIL] \xff\xfe\n"
+    assert b"\xe9" in stdout
+    assert stderr == b""
+    assert status == 0
+
+
+def test_empty_stdin(run_cli):
+    """C-05: empty input gives empty output and status 0."""
+    status, stdout, stderr = run_cli(stdin=b"")
+    assert (status, stdout, stderr) == (0, b"", b"")
+
+
+def test_status_zero_on_success(run_cli):
+    """C-05, FR-015: any run that is not an error exits 0."""
+    for stdin in (b"", b"\n", b"nothing to redact\n", b"jane@example.com\n"):
+        status, _, stderr = run_cli(stdin=stdin)
+        assert status == 0
+        assert stderr == b""
+
+
+def test_many_lines_in_one_stream(run_cli):
+    """Lines are processed independently and concatenated in order (FR-008, FR-016)."""
+    stdin = b"".join(b"line %d jane@example.com\n" % n for n in range(500))
+    expected = b"".join(b"line %d [EMAIL]\n" % n for n in range(500))
+    status, stdout, stderr = run_cli(stdin=stdin)
+    assert stdout == expected
+    assert stderr == b""
+    assert status == 0
