+    "4111111111111111110",
+]
+
+PLACEHOLDERS = (EMAIL_PLACEHOLDER, IP_PLACEHOLDER, CARD_PLACEHOLDER)
+
+
+def test_clean_corpus_unchanged():
+    """SC-003: 100% of lines with no personal data come back byte-for-byte identical."""
+    unchanged = [line for line in CLEAN_CORPUS if redact(line) == line]
+    assert len(unchanged) == len(CLEAN_CORPUS), [
+        line for line in CLEAN_CORPUS if redact(line) != line
+    ]
+
+
+def test_near_miss_corpus_untouched():
+    """SC-004: 0 of the near-miss values are redacted."""
+    redacted = []
+    total = new_tally()
+    for line in NEAR_MISS_CORPUS:
+        out, tally = redact_counting(line)
+        if out != line:
+            redacted.append((line, out))
+        for key in total:
+            total[key] += tally[key]
+    assert redacted == []
+    assert total == {"emails": 0, "ips": 0, "cards": 0}
