+        if not any(out == "value=" + p + "|end\n" for p in PLACEHOLDERS):
+            survivors.append((value, out))
+            continue
+        if any(fragment in out for fragment in _fragments(value)):
+            survivors.append((value, out))
+    assert survivors == []
