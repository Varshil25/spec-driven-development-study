+"""Contract tests for User Story 3 — the `--count` tally (FR-010, FR-011, SR-004, A-3)."""
+
+import re
+import subprocess
+
+from conftest import cli_argv, cli_env
+
+TALLY = re.compile(rb"^emails=\d+ ips=\d+ cards=\d+\n$")
+
+
+def test_count_format(run_cli):
+    """C-04: the worked example, byte-for-byte on both streams."""
+    status, stdout, stderr = run_cli("--count", stdin=b"a@b.io 1.2.3.4\n")
+    assert stdout == b"[EMAIL] [IP]\n"
+    assert stderr == b"emails=1 ips=1 cards=0\n"
+    assert status == 0
+
+
+def test_zero_counts(run_cli):
+    """C-06: empty input still reports an all-zero tally, status 0."""
+    status, stdout, stderr = run_cli("--count", stdin=b"")
+    assert (status, stdout, stderr) == (0, b"", b"emails=0 ips=0 cards=0\n")
+
+
+def test_totals_across_operands(run_cli, tmp_path):
+    """Story 3 scenario 3: totals are per run, not per file."""
+    a = tmp_path / "a.log"
+    b = tmp_path / "b.log"
+    a.write_bytes(b"jane@example.com 10.0.0.7\n")
+    b.write_bytes(b"jane@example.com 4111 1111 1111 1111\njane@example.com\n")
+
+    status, stdout, stderr = run_cli("--count", str(a), str(b))
+    assert status == 0
+    assert stdout == b"[EMAIL] [IP]\n[EMAIL] [CARD]\n[EMAIL]\n"
+    assert stderr == b"emails=3 ips=1 cards=1\n"
+
+    # the same operand twice counts twice (A-1)
+    status, _, stderr = run_cli("--count", str(a), str(a))
+    assert status == 0
+    assert stderr == b"emails=2 ips=2 cards=0\n"
+
+
+def test_no_stderr_without_count(run_cli, tmp_path):
+    """FR-011: without the flag, a successful run writes nothing at all to stderr."""
+    a = tmp_path / "a.log"
+    a.write_bytes(b"jane@example.com 10.0.0.7 4111 1111 1111 1111\n")
+    for args, stdin in (((str(a),), b""), ((), b"jane@example.com\n"), ((), b"")):
+        status, _, stderr = run_cli(*args, stdin=stdin)
+        assert status == 0
+        assert stderr == b""
+
+
+def test_summary_after_output():
+    """A-3: stdout is complete and flushed before the tally is written.
+
+    Both streams are merged into one pipe, so the order below is the order the writes happened.
+    """
+    completed = subprocess.run(
+        cli_argv("--count"),
+        input=b"jane@example.com\n10.0.0.7\n4111111111111111\n",
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        env=cli_env(),
+        timeout=60,
+        check=False,
+    )
+    assert completed.returncode == 0
+    assert completed.stdout == b"[EMAIL]\n[IP]\n[CARD]\nemails=1 ips=1 cards=1\n"
+
+
+def test_summary_not_in_redirected_stdout(run_cli, tmp_path):
+    """C-19: with stdout redirected to a file, the tally is not in that file."""
+    out = tmp_path / "out.log"
+    with open(out, "wb") as sink:
+        completed = subprocess.run(
+            cli_argv("--count"),
+            input=b"jane@example.com 1.2.3.4\n",
+            stdout=sink,
+            stderr=subprocess.PIPE,
+            env=cli_env(),
+            timeout=60,
+            check=False,
+        )
+    assert completed.returncode == 0
+    assert out.read_bytes() == b"[EMAIL] [IP]\n"
+    assert b"emails=" not in out.read_bytes()
+    assert completed.stderr == b"emails=1 ips=1 cards=0\n"
+
+
+def test_summary_is_exactly_three_integers(run_cli, tmp_path):
+    """SR-004, SC-008, SC-009: no sample value, line number or file name reaches the tally."""
+    source = tmp_path / "payments.log"
+    source.write_bytes(
+        b"jane.doe@example.com paid with 4111 1111 1111 1111 from 192.168.0.10\n"
+        b"second line a@b.io 10.0.0.7 4111-1111-1111-1111\n"
+    )
+    status, _, stderr = run_cli("--count", str(source))
+    assert status == 0
+    assert TALLY.match(stderr), stderr
+    assert stderr == b"emails=2 ips=2 cards=2\n"
+
+    for leak in (
+        b"jane",
+        b"example.com",
+        b"4111",
+        b"192.168",
+        b"10.0.0.7",
+        b"payments.log",
+        b"line",
+        b"1:",
+        b"2:",
+    ):
+        assert leak not in stderr
