new file mode 100644
index 0000000..e3c7f93
--- /dev/null
+++ b/tests/test_redaction_rules.py
@@ -0,0 +1,388 @@
+"""Unit tests for the recognition rules (FR-004…008, FR-013, FR-014, SR-002, SR-006).
+
+These call `redact_line()` directly, which is fast and lets the exact string and the exact tally
+be asserted (research.md R13). Every table row in contracts/redaction-rules.md appears below.
+"""
+
+import pytest
+
+from logredact.redact import (
+    CARD_PLACEHOLDER,
+    EMAIL_PLACEHOLDER,
+    IP_PLACEHOLDER,
+    redact_line,
+)
+
+
+def redact(text):
+    """Redact `text`, discarding the tally."""
+    return redact_line(text, new_tally())
+
+
+def redact_counting(text):
+    """Redact `text`, returning `(output, tally)`."""
+    tally = new_tally()
+    return redact_line(text, tally), tally
+
+
+def new_tally():
+    return {"emails": 0, "ips": 0, "cards": 0}
+
+
+# --- Luhn-valid card numbers, one per length FR-006 allows (13…19) --------------------------
+
+VALID_CARDS = [
+    "4222222222222",        # 13
+    "30569309025904",       # 14
+    "378282246310005",      # 15
+    "4111111111111111",     # 16
+    "41111111111111113",    # 17
+    "411111111111111118",   # 18
+    "4111111111111111110",  # 19
+]
+
+
+# ===========================================================================================
+# T009 — email shapes (FR-004)
+# ===========================================================================================
+
+EMAIL_ROWS = [
+    ("jane@example.com", EMAIL_PLACEHOLDER),
+    ("jane.doe+test@mail.example.com", EMAIL_PLACEHOLDER),
+    # the sentence period is not part of the match
+    ("mail jane@example.com.", "mail " + EMAIL_PLACEHOLDER + "."),
+    # email precedence: redacted once, as one email, not carved into an IPv4 address
+    ("a@1.2.3.4.example.com", EMAIL_PLACEHOLDER),
+    # a domain needs at least one dot (research.md R6)
+    ("user@localhost", "user@localhost"),
+    # no local part
+    ("@property", "@property"),
+    # last label shorter than two letters
+    ("jane@example.c", "jane@example.c"),
+]
+
+
+@pytest.mark.parametrize("text,expected", EMAIL_ROWS)
+def test_email_shapes(text, expected):
+    assert redact(text) == expected
+
+
+# ===========================================================================================
+# T010 — IPv4 shapes (FR-005, FR-013, research.md R7)
+# ===========================================================================================
+
+
+@pytest.mark.parametrize("text", ["0.0.0.0", "255.255.255.255", "192.168.0.10"])
+def test_ipv4_shapes(text):
+    assert redact(text) == IP_PLACEHOLDER
+
+
+@pytest.mark.parametrize("text", ["999.1.1.1", "256.1.1.1", "1.2.3", "1.2.3.4.5"])
+def test_ipv4_out_of_range(text):
+    assert redact(text) == text
+
+
+def test_ipv4_flanked_by_digit_or_dot():
+    # leading zero is not a valid octet, and the inner 1.2.3.4 is blocked by the preceding digit
+    assert redact("01.2.3.4") == "01.2.3.4"
+    # flanked by `v` and `-`, neither a digit nor a dot, so FR-013 does not block it
+    assert redact("v10.0.0.7-beta") == "v" + IP_PLACEHOLDER + "-beta"
+
+
+# ===========================================================================================
+# T011 — card groupings, Luhn, flanking, separator preservation
+#        (FR-006, FR-007, FR-008, FR-013)
+# ===========================================================================================
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "4111111111111111",
+        "4111 1111 1111 1111",
+        "4111-1111-1111-1111",
+    ],
+)
+def test_card_groupings(text):
+    assert redact(text) == CARD_PLACEHOLDER
+
+
+@pytest.mark.parametrize("text", VALID_CARDS)
+def test_card_every_allowed_length(text):
+    assert redact(text) == CARD_PLACEHOLDER
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "1234567890123",          # 13 digits, Luhn fails
+        "4111  1111  1111  1111",  # doubled separators
+        "4111 1111-1111 1111",    # mixed separators
+        "4111--1111--1111--1111",  # doubled separators
+    ],
+)
+def test_luhn_failure_untouched(text):
+    assert redact(text) == text
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "1234114111111111111111",  # 22-digit group; the valid 16-digit substring is flanked
+        "94111 1111 1111 1111",    # the valid card would start mid-group
+        "4111 1111 1111 11110",    # the valid card would end mid-group
+    ],
+)
+def test_card_flanked_by_digit(text):
+    assert redact(text) == text
+
+
+def test_card_sub_candidate_after_bare_numbers():
+    """A card that follows other bare numbers is still a card (research.md R8)."""
+    assert (
+        redact("log 1 2 3 4111 1111 1111 1111 end")
+        == "log 1 2 3 " + CARD_PLACEHOLDER + " end"
+    )
+
+
+def test_card_not_blocked_by_a_non_digit():
+    assert redact("x4111 1111 1111 1111") == "x" + CARD_PLACEHOLDER
+
+
+def test_separator_between_adjacent_cards_preserved():
+    """Phase 0 regression: the separator between two adjacent cards was being swallowed.
+
+    `[CARD][CARD]` instead of `[CARD] [CARD]` is an FR-008 violation (research.md R8).
+    """
+    out, tally = redact_counting("4111 1111 1111 1111 4111 1111 1111 1111")
+    assert out == CARD_PLACEHOLDER + " " + CARD_PLACEHOLDER
+    assert tally["cards"] == 2
+
+    out, tally = redact_counting("4111-1111-1111-1111-4111-1111-1111-1111")
+    assert out == CARD_PLACEHOLDER + "-" + CARD_PLACEHOLDER
+    assert tally["cards"] == 2
+
+
+# ===========================================================================================
+# T012 — precedence, no re-scanning, counting (FR-014, A-1, A-2)
+# ===========================================================================================
+
+
+def test_email_beats_ipv4():
+    out, tally = redact_counting("a@1.2.3.4.example.com")
+    assert out == EMAIL_PLACEHOLDER
+    assert tally == {"emails": 1, "ips": 0, "cards": 0}
+
+
+def test_placeholder_not_rescanned():
+    """A line that literally contains a placeholder is ordinary text (FR-014)."""
+    for text in ("[EMAIL]", "[IP]", "[CARD]", "already [EMAIL] and [CARD] here"):
+        out, tally = redact_counting(text)
+        assert out == text
+        assert tally == {"emails": 0, "ips": 0, "cards": 0}
+
+    # the output of a redaction, fed back in, is stable
+    once = redact("user jane@example.com from 10.0.0.7")
+    assert redact(once) == once
+
+
+def test_counts_once_per_replacement():
+    """Counts are per replacement made, not per distinct value (A-1)."""
+    out, tally = redact_counting("jane@example.com jane@example.com jane@example.com")
+    assert out == " ".join([EMAIL_PLACEHOLDER] * 3)
+    assert tally["emails"] == 3
+
+    out, tally = redact_counting("10.0.0.7 10.0.0.7")
+    assert out == IP_PLACEHOLDER + " " + IP_PLACEHOLDER
+    assert tally["ips"] == 2
+
+    out, tally = redact_counting(
+        "a@b.io 1.2.3.4 4111111111111111 a@b.io 1.2.3.4 4111111111111111"
+    )
+    assert tally == {"emails": 2, "ips": 2, "cards": 2}
+
+
+# ===========================================================================================
+# T013 — pass-through, complete replacement, inert format specifiers
+#        (FR-008, SR-006, SR-002)
+# ===========================================================================================
+
+
+def test_surrounding_text_preserved():
+    assert (
+        redact("user jane@example.com from 10.0.0.7\n")
+        == "user " + EMAIL_PLACEHOLDER + " from " + IP_PLACEHOLDER + "\n"
+    )
+    assert (
+        redact("paid with 4111 1111 1111 1111, ref 1234567890123\n")
+        == "paid with " + CARD_PLACEHOLDER + ", ref 1234567890123\n"
+    )
+    assert redact("  spaced\t\tand\ttabbed  \r\n") == "  spaced\t\tand\ttabbed  \r\n"
+
+
+def _fragments(value, minimum=3):
+    for size in range(minimum, len(value) + 1):
+        for start in range(len(value) - size + 1):
+            yield value[start : start + size]
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "jane.doe+test@sub.example.org",
+        "192.168.0.10",
+        "4111 1111 1111 1111",
+        "4111-1111-1111-1111",
+        "378282246310005",
+    ],
+)
+def test_no_fragment_of_match_survives(value):
+    """SR-006: no digits, characters, or length information from the original survive."""
+    out = redact("<<" + value + ">>")
+    assert out in (
+        "<<" + EMAIL_PLACEHOLDER + ">>",
+        "<<" + IP_PLACEHOLDER + ">>",
+        "<<" + CARD_PLACEHOLDER + ">>",
+    )
+    for digit in "0123456789":
+        assert digit not in out
+    for fragment in _fragments(value):
+        assert fragment not in out
+    # the placeholder is a fixed literal, so the output length is the placeholder's length and
+    # carries no information about how long the original value was
+    assert len(out) - len("<<>>") in (
+        len(EMAIL_PLACEHOLDER),
+        len(IP_PLACEHOLDER),
+        len(CARD_PLACEHOLDER),
+    )
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "100%s of requests",
+        "template {} and {0} and {name}",
+        "printf %(x)d style",
+        "%n %s %% $(whoami) `id`",
+        "{email} 100%% jane@example.com",
+    ],
+)
+def test_format_specifiers_in_input_are_inert(text):
+    """SR-002: no part of the input is ever interpreted as a format string."""
+    out = redact(text)
+    expected = text.replace("jane@example.com", EMAIL_PLACEHOLDER)
+    assert out == expected
+
+
+# ===========================================================================================
+# T014 — corpora (SC-003, SC-004, SC-005)
+# ===========================================================================================
