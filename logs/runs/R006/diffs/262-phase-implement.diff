@@ -0,0 +1,52 @@
+"""Shared test harness.
+
+The contract tests run the real command in a subprocess and compare **raw bytes** on stdout and
+stderr plus the exit status. Bytes rather than decoded text is deliberate: the byte-for-byte
+guarantees of FR-009 and the invalid-UTF-8 pass-through of A-4 cannot be asserted on a decoded
+string, because the decoding would hide exactly the difference under test (research.md R13).
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC = REPO_ROOT / "src"
+
+#: Shape of a diagnostic prefix, as contracts/cli.md specifies it.
+ERROR_PREFIX = b"python -m logredact: error:"
+
+
+def cli_env():
+    """Environment for a child process running the tool: `src/` on PYTHONPATH (A-10)."""
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+    return env
+
+
+def cli_argv(*args):
+    """The argument vector for `python -m logredact ...`."""
+    return [sys.executable, "-m", "logredact", *args]
+
+
+@pytest.fixture
+def run_cli():
+    """Run `python -m logredact *args` and return `(status, stdout_bytes, stderr_bytes)`."""
+
+    def _run(*args, stdin=b"", cwd=None, timeout=300, stdout=None):
+        completed = subprocess.run(
+            cli_argv(*args),
+            input=stdin,
+            stdout=subprocess.PIPE if stdout is None else stdout,
+            stderr=subprocess.PIPE,
+            env=cli_env(),
+            cwd=None if cwd is None else str(cwd),
+            timeout=timeout,
+            check=False,
+        )
+        return completed.returncode, completed.stdout, completed.stderr
+
+    return _run
