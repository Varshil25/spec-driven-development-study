+    "ref 41111111111111111101 long\n",
+    "ref 41111111111111111103333 long\n",
+    # mis-separated groupings
+    "ref 4111  1111  1111  1111 doubled\n",
+    "ref 4111 1111-1111 1111 mixed\n",
+    "ref 4111--1111--1111--1111 doubled\n",
+    "ref 4111_1111_1111_1111 underscores\n",
+    # a valid card flanked by digits is not a card
+    "ref 1234114111111111111111 flanked\n",
+    "ref 94111 1111 1111 1111 flanked\n",
+    "ref 4111 1111 1111 11110 flanked\n",
+    # non-email uses of `@`
