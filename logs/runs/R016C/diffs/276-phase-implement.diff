@@ -0,0 +1,215 @@
+"""User Story 1 end-to-end: international phone numbers become [PHONE].
+
+Covers FR-001 to FR-005 through the real ``python -m logredact`` process, one test (or
+parametrised case) per row of the tables in
+specs/002-phone-redaction-out-dir/contracts/redaction-rules.md.
+
+Every invocation here runs with no FILE operands and no flags, which is User Story 1's
+stated independent test: the story owns the redacted text only, and the tally belongs to
+User Story 3.
+"""
+
+import pytest
+
+
+def redacted(run_cli, payload: bytes) -> bytes:
+    """Pipe ``payload`` through the CLI and return stdout, asserting a clean run."""
+    result = run_cli(input=payload)
+    assert result.returncode == 0, result.stderr
+    assert result.stderr == b""
+    return result.stdout
+
+
+# --- FR-001, FR-002: the grammar and its inclusive boundaries --------------------------
+
+
+@pytest.mark.parametrize(
+    "line,expected",
+    [
+        (b"+14155552671", b"[PHONE]"),
+        (b"+442071838750", b"[PHONE]"),
+        # The range boundaries are inclusive at both ends.
+        (b"+12345678", b"[PHONE]"),
+        (b"+123456789012345", b"[PHONE]"),
+        # Leading zeros are digits like any other.
+        (b"+012345678", b"[PHONE]"),
+    ],
+)
+def test_fr001_fr002_a_plus_and_eight_to_fifteen_digits_becomes_phone(
+    run_cli, line, expected
+):
+    """FR-001, FR-002: + followed by 8-15 digits inclusive becomes [PHONE]."""
+    assert redacted(run_cli, line + b"\n") == expected + b"\n"
+
+
+def test_fr002_eight_digits_is_the_inclusive_lower_boundary(run_cli):
+    """FR-002: 8 digits is in range, 7 is not — the boundary is inclusive."""
+    assert redacted(run_cli, b"+12345678\n") == b"[PHONE]\n"
+    assert redacted(run_cli, b"+1234567\n") == b"+1234567\n"
+
+
+def test_fr002_fifteen_digits_is_the_inclusive_upper_boundary(run_cli):
+    """FR-002: 15 digits is in range, 16 is not — the boundary is inclusive."""
+    assert redacted(run_cli, b"+123456789012345\n") == b"[PHONE]\n"
+    assert redacted(run_cli, b"+1234567890123456\n") == b"+1234567890123456\n"
+
+
+# --- FR-003: runs outside the range are reproduced whole, with no fragment redacted ----
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        b"ext +1234567",  # 7 digits, below the range
+        b"ref +1234567890123456",  # 16 digits, above it
+        b"+1234567890123456789012",  # 22 digits, same rule
+        b"dial 14155552671 please",  # no +
+        b"+ 14155552671",  # run broken by a space
+        b"+1 415 555 2671",  # run broken; the parts then fail the card length rule
+    ],
+)
+def test_fr003_a_run_outside_the_range_is_left_completely_unchanged(run_cli, line):
+    """FR-003: an out-of-range run is reproduced whole, with no fragment redacted.
+
+    In particular a 16-digit run must not have its first 15 digits replaced, which is
+    what the pattern's trailing (?!\\d) guard prevents: without it the engine would emit
+    "[PHONE]6".
+    """
+    out = redacted(run_cli, line + b"\n")
+    assert out == line + b"\n"
+    assert b"[PHONE]" not in out
+
+
+def test_fr003_no_fragment_of_an_over_long_run_is_redacted(run_cli):
+    """FR-003: a 16-digit run yields no [PHONE] anywhere, not even a partial one."""
+    out = redacted(run_cli, b"ref +1234567890123456\n")
+    assert b"[PHONE]" not in out
+    assert b"+1234567890123456" in out
+
+
+# --- FR-004: boundary adjacency, every occurrence, precedence --------------------------
+
+
+@pytest.mark.parametrize(
+    "line,expected",
+    [
+        (b"call +14155552671.", b"call [PHONE]."),
+        (b"+12345678a", b"[PHONE]a"),
+        (b"(+12345678)", b"([PHONE])"),
+        # No leading guard: a + preceded by any character still begins a candidate.
+        (b"tel:+14155552671", b"tel:[PHONE]"),
+        (b"++12345678", b"+[PHONE]"),
+    ],
+)
+def test_fr004_adjacent_characters_neither_extend_nor_block_the_run(
+    run_cli, line, expected
+):
+    """FR-004: a non-digit neighbour is preserved and does not extend the digit run."""
+    assert redacted(run_cli, line + b"\n") == expected + b"\n"
+
+
+def test_fr004_each_run_on_a_line_is_judged_on_its_own(run_cli):
+    """FR-004: a below-range run beside an in-range one leaves the first alone."""
+    assert redacted(run_cli, b"+1234567 +12345678\n") == b"+1234567 [PHONE]\n"
+
+
+def test_fr004_every_occurrence_on_a_line_is_replaced(run_cli):
+    """FR-004: two phone numbers on one line become two placeholders, not just one."""
+    assert redacted(run_cli, b"uk +442071838750 us +14155552671\n") == (
+        b"uk [PHONE] us [PHONE]\n"
+    )
+
+
+def test_fr004_a_line_that_is_one_phone_number_becomes_exactly_the_placeholder(run_cli):
+    """FR-004: the whole line is the value, so the whole line is the placeholder, and
+    the line terminator is preserved exactly."""
+    assert redacted(run_cli, b"+14155552671\n") == b"[PHONE]\n"
+    assert redacted(run_cli, b"+14155552671\r\n") == b"[PHONE]\r\n"
+    assert redacted(run_cli, b"+14155552671") == b"[PHONE]"
+
+
+# --- FR-005: the three existing categories are untouched -------------------------------
+
+
+def test_fr005_the_three_existing_categories_still_redact_as_before(run_cli):
+    """FR-005: email, IPv4 and card behaviour is unchanged by the new category."""
+    assert redacted(run_cli, b"user jane@example.com from 10.0.0.7\n") == (
+        b"user [EMAIL] from [IP]\n"
+    )
+    assert redacted(run_cli, b"paid with 4111 1111 1111 1111\n") == b"paid with [CARD]\n"
+
+
+def test_fr005_the_existing_near_miss_rules_are_unchanged(run_cli):
+    """FR-005: 001's near-miss behaviour survives — 999.1.1.1 whole, 123 1.2.3.4 split."""
+    assert redacted(run_cli, b"host 999.1.1.1 unreachable\n") == (
+        b"host 999.1.1.1 unreachable\n"
+    )
+    assert redacted(run_cli, b"123 1.2.3.4\n") == b"123 [IP]\n"
+
+
+# --- The whole surface User Story 1 owns (spec US1 Independent Test) --------------------
+
+#: Every US1 case in one corpus, in the order the story's scenarios list them.
+US1_CORPUS = (
+    b"call +14155552671 now\n"
+    b"uk +442071838750 us +14155552671\n"
+    b"ext +1234567\n"
+    b"ref +1234567890123456\n"
+    b"dial 14155552671 please\n"
+    b"+12345678\n"
+    b"+123456789012345\n"
+    b"+012345678\n"
+    b"+ 14155552671\n"
+    b"+1 415 555 2671\n"
+    b"call +14155552671.\n"
+    b"(+12345678)\n"
+    b"tel:+14155552671\n"
+    b"++12345678\n"
+    b"+1234567 +12345678\n"
+    b"user jane@example.com from 10.0.0.7\n"
+    b"paid with 4111 1111 1111 1111\n"
+    b"host 999.1.1.1 unreachable\n"
+    b"123 1.2.3.4\n"
+)
+
+US1_EXPECTED = (
+    b"call [PHONE] now\n"
+    b"uk [PHONE] us [PHONE]\n"
+    b"ext +1234567\n"
+    b"ref +1234567890123456\n"
+    b"dial 14155552671 please\n"
+    b"[PHONE]\n"
+    b"[PHONE]\n"
+    b"[PHONE]\n"
+    b"+ 14155552671\n"
+    b"+1 415 555 2671\n"
+    b"call [PHONE].\n"
+    b"([PHONE])\n"
+    b"tel:[PHONE]\n"
+    b"+[PHONE]\n"
+    b"+1234567 [PHONE]\n"
+    b"user [EMAIL] from [IP]\n"
+    b"paid with [CARD]\n"
+    b"host 999.1.1.1 unreachable\n"
+    b"123 [IP]\n"
+)
+
+
+def test_us1_the_whole_corpus_produces_exactly_the_expected_bytes(run_cli):
+    """FR-001 to FR-005: US1's independent test over its whole corpus at once.
+
+    Piped in with no FILE operands and no flags, exactly the expected stdout bytes come
