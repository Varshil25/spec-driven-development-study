+def test_sc010_the_out_dir_path_meets_the_same_budget(run_cli, tmp_path):
+    """SC-010: 100,000 lines through --out-dir in under 10 seconds.
+
+    The file-writing path must not cost materially more than the stdout path: the design
+    prototype measured ~0.04 s for the copy on top of ~0.96 s for the redaction. The run
+    also has to produce exactly one status line on stdout and one four-field summary on
+    stderr, so the budget is not met by skipping work.
+    """
+    big = _generate(tmp_path / "big.log", LINE_COUNT)
+    out = tmp_path / "clean"
+
+    start = time.perf_counter()
+    result = run_cli("--count", "--out-dir", str(out), big)
+    elapsed = time.perf_counter() - start
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == b"wrote 1 files\n"
+    assert result.stderr == (
+        f"emails={LINE_COUNT} ips={LINE_COUNT} cards={LINE_COUNT} "
+        f"phones={LINE_COUNT}\n".encode()
+    )
+    written = (out / "big.log").read_bytes()
+    assert written.count(b"[PHONE]") == LINE_COUNT
+    assert written.count(b"\n") == LINE_COUNT
+    assert elapsed < BUDGET_SECONDS, f"took {elapsed:.2f}s, budget {BUDGET_SECONDS}s"
+
+
+def test_sc010_memory_does_not_grow_with_operand_count(run_cli, tmp_path):
+    """SC-010: at most one input and one output are open, so many operands stay flat.
+
+    Measured on the CLI's own loop in-process rather than through a subprocess, because
+    the claim is about what the tool holds, not what the OS reports. Ten times the
+    operands must not move the peak: each output is closed before the next input opens.
+    """
+    import logredact.cli as cli
+
+    payload = LINE.format(index=1234)
+    source = tmp_path / "src.log"
+    source.write_text(payload, encoding="utf-8", newline="")
+
+    def peak_for(operand_count):
+        out = tmp_path / f"out{operand_count}"
+        args = cli._build_parser().parse_intermixed_args(
+            ["--out-dir", str(out), *([str(source)] * operand_count)]
+        )
+        # _run reconfigures sys.stdin/sys.stdout, which pytest has replaced with capture
+        # stubs that have no reconfigure(). Swap in real streams for the call. stdin is
+        # never read in output-folder mode; stdout receives only the status line.
+        saved = sys.stdin, sys.stdout
+        with (
+            open(os.devnull, "r") as devnull,
+            open(tmp_path / f"stdout{operand_count}.txt", "w") as fake_stdout,
+        ):
+            sys.stdin, sys.stdout = devnull, fake_stdout
+            tracemalloc.start()
+            try:
+                tracemalloc.reset_peak()
+                assert cli._run(args) == 0
+                return tracemalloc.get_traced_memory()[1]
+            finally:
+                tracemalloc.stop()
+                sys.stdin, sys.stdout = saved
+
+    small_peak = peak_for(10)
+    large_peak = peak_for(100)
+    line_bytes = len(payload.encode())
+
+    assert large_peak < small_peak + 100 * line_bytes, (
+        f"peak grew from {small_peak} to {large_peak} bytes for 10x the operands"
+    )
