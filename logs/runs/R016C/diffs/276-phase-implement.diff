new file mode 100644
index 0000000..ab40ae8
--- /dev/null
+++ b/tests/test_out_dir_errors.py
@@ -0,0 +1,305 @@
+"""User Story 2 failure paths: output-folder mode fails loudly.
+
+Covers FR-015 to FR-018 and FR-020's collision case through the real
+``python -m logredact`` process. No test here is skipped or xfailed (constitution
+gate 2): the obstacles are file-type and path-length based, so they defeat a process
+running as uid 0 just as they defeat an unprivileged one. The single permission-bit case
+probes first and asserts whichever contract applies, rather than being skipped.
+"""
+
+import hashlib
+import os
+
+
+def write(path, data: bytes):
+    path.write_bytes(data)
+    return str(path)
+
+
+def digest(path) -> str:
+    with open(path, "rb") as handle:
+        return hashlib.sha256(handle.read()).hexdigest()
+
+
+def assert_names_path_with_a_reason(stderr: bytes, path: str, verb: str):
+    """FR-015/FR-017: the diagnostic carries the offending path *and* a non-empty reason.
+
+    ``verb`` is "read" for an input failure or "write" for an output failure — the
+    attribution is by the operation that raised, so the two are never interchangeable.
+    The reason comes from ``OSError.strerror``, so this matches on structure rather than
+    exact OS wording.
+    """
+    assert path.encode() in stderr, stderr
+    line = stderr.decode("utf-8", "surrogateescape").strip()
+    assert line.startswith(f"logredact: cannot {verb} "), line
+    _, _, reason = line.rpartition(": ")
+    assert reason, line
+    assert reason != path, line
+
+
+def assert_no_status_line_and_no_summary(result):
+    """FR-015/FR-017: a failed run reports neither `wrote N files` nor a tally."""
+    assert b"wrote" not in result.stdout
+    assert b"emails=" not in result.stderr
+    assert b"emails=" not in result.stdout
+    assert b"phones=" not in result.stderr
+
+
+# --- FR-015, FR-016: an unreadable operand ---------------------------------------------
+
+
+def test_fr015_fr016_an_unreadable_second_operand_fails_and_leaves_no_output_for_it(
+    run_cli, tmp_path
+):
+    """FR-015, FR-016: the first operand's output is kept, the second's never appears.
+
+    Exit 2, a diagnostic naming the unreadable operand with a reason, and — critically —
+    no `wrote N files` on stdout, so a partially filled folder cannot read as a complete
+    one.
+    """
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    missing = str(tmp_path / "nope.log")
+    out = tmp_path / "clean"
+
+    result = run_cli("--out-dir", str(out), a, missing)
+    assert result.returncode == 2
+    assert_names_path_with_a_reason(result.stderr, missing, "read")
+    assert_no_status_line_and_no_summary(result)
+    assert result.stdout == b""
+    # The completed work is kept; the failed operand left nothing behind.
+    assert (out / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert not (out / "nope.log").exists()
+    assert sorted(p.name for p in out.iterdir()) == ["app.log"]
+
+
+def test_fr015_an_unreadable_operand_with_count_reports_no_summary(run_cli, tmp_path):
+    """FR-015/FR-007: adding --count to a failed run still produces no tally."""
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    missing = str(tmp_path / "nope.log")
+    out = tmp_path / "clean"
+
+    result = run_cli("--count", "--out-dir", str(out), a, missing)
+    assert result.returncode == 2
+    assert_no_status_line_and_no_summary(result)
+    assert_names_path_with_a_reason(result.stderr, missing, "read")
+
+
+# --- FR-018: --out-dir with zero operands ----------------------------------------------
+
+
+def test_fr018_the_option_with_zero_operands_is_rejected_exactly(run_cli, tmp_path):
+    """FR-018: the diagnostic is the specified sentence, not an argparse usage block."""
+    out = tmp_path / "fresh"
+
+    result = run_cli("--out-dir", str(out))
+    assert result.returncode == 2
+    assert result.stderr == b"logredact: --out-dir requires at least one FILE\n"
+    assert result.stdout == b""
+
+
+def test_fr018_the_destination_is_not_created_when_there_are_no_operands(
+    run_cli, tmp_path
+):
+    """FR-018: the check runs before makedirs, so no directory appears."""
+    out = tmp_path / "fresh"
+
+    result = run_cli("--out-dir", str(out))
+    assert result.returncode == 2
+    assert not out.exists()
+
+
+def test_fr018_standard_input_is_not_read_when_there_are_no_operands(run_cli, tmp_path):
+    """FR-018: stdin is never read in output-folder mode, so input that would otherwise
+    be echoed produces nothing at all."""
+    out = tmp_path / "fresh"
+
+    result = run_cli("--out-dir", str(out), input=b"user jane@example.com\n")
+    assert result.returncode == 2
+    assert result.stdout == b""
+    assert b"[EMAIL]" not in result.stdout
+    assert result.stderr == b"logredact: --out-dir requires at least one FILE\n"
+
+
+def test_fr018_zero_operands_with_count_reports_no_summary(run_cli, tmp_path):
+    """FR-018/FR-007: the early rejection suppresses the tally too."""
+    out = tmp_path / "fresh"
+
+    result = run_cli("--count", "--out-dir", str(out))
+    assert result.returncode == 2
+    assert_no_status_line_and_no_summary(result)
+
+
+# --- FR-017: the destination cannot be created or written ------------------------------
+
+
+def test_fr017_a_destination_that_is_a_regular_file_fails(run_cli, tmp_path):
+    """FR-017: DIR naming an existing regular file → exit 2 naming DIR.
+
+    File-type based, so it fails for root as well as an unprivileged user.
+    """
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    not_a_dir = write(tmp_path / "notadir", b"")
+
+    result = run_cli("--out-dir", not_a_dir, a)
+    assert result.returncode == 2
+    assert_names_path_with_a_reason(result.stderr, not_a_dir, "write")
+    assert_no_status_line_and_no_summary(result)
+    assert result.stdout == b""
+
+
+def test_fr017_an_output_name_colliding_with_a_subdirectory_fails(run_cli, tmp_path):
+    """FR-017: DIR/app.log already exists as a directory → exit 2 naming the joined path.
+
+    File-type based, so it fails for root as well. The diagnostic must name the *output*
+    path, not the operand — the attribution comes from the operation that raised.
+    """
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    out = tmp_path / "clean3"
+    (out / "app.log").mkdir(parents=True)
+
+    result = run_cli("--out-dir", str(out), a)
+    assert result.returncode == 2
+    assert_names_path_with_a_reason(result.stderr, str(out / "app.log"), "write")
+    assert_no_status_line_and_no_summary(result)
+    assert result.stdout == b""
+
+
+def test_fr017_an_over_long_destination_component_fails(run_cli, tmp_path):
+    """FR-017: an ENAMETOOLONG component defeats makedirs for any user, root included."""
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    too_long = str(tmp_path / ("x" * 5000))
+
+    result = run_cli("--out-dir", too_long, a)
+    assert result.returncode == 2
+    assert_names_path_with_a_reason(result.stderr, too_long, "write")
+    assert_no_status_line_and_no_summary(result)
+    assert result.stdout == b""
+
+
+def test_fr017_an_uncreatable_destination_with_count_reports_no_summary(
+    run_cli, tmp_path
+):
+    """FR-017/FR-007: an output failure suppresses the tally as well as the status line."""
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    not_a_dir = write(tmp_path / "notadir", b"")
+
+    result = run_cli("--count", "--out-dir", not_a_dir, a)
+    assert result.returncode == 2
+    assert_no_status_line_and_no_summary(result)
+
+
+def test_fr017_an_unwritable_destination_directory_is_reported_or_written(
+    run_cli, tmp_path
+):
+    """FR-017: a mode 0o500 destination → diagnostic naming the output path, exit 2.
+
+    Runs unconditionally rather than being skipped (constitution gate 2). A process with
+    uid 0 bypasses permission bits entirely, so 0o500 is not unwritable *for that
+    process*; the test probes with a real write attempt first, then asserts the FR-017
+    failure contract if the probe failed or the ordinary success contract if it
+    succeeded. Either way the tool must not produce a silent wrong answer. This is the
+    pattern feature 001 already uses for its unreadable-file case.
+    """
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    out = tmp_path / "locked"
+    out.mkdir()
+    os.chmod(out, 0o500)
+
+    probe = out / "probe.tmp"
+    try:
+        with open(probe, "w", encoding="utf-8"):
+            pass
+        writable = True
+        probe.unlink()
+    except OSError:
+        writable = False
+
+    try:
+        result = run_cli("--out-dir", str(out), a)
+        if writable:
+            assert result.returncode == 0, result.stderr
+            assert result.stdout == b"wrote 1 files\n"
+            assert (out / "app.log").read_bytes() == b"user [EMAIL]\n"
+        else:
+            assert result.returncode == 2
+            assert_names_path_with_a_reason(result.stderr, str(out / "app.log"), "write")
+            assert_no_status_line_and_no_summary(result)
+            assert result.stdout == b""
+    finally:
+        # Restore the mode so pytest's tmp_path cleanup can remove the tree.
+        os.chmod(out, 0o700)
+
+
+# --- FR-020: an output path that collides with an input operand ------------------------
+
+
+def test_fr020_an_output_path_equal_to_an_input_operand_is_refused(run_cli, tmp_path):
+    """FR-020: the tool MUST never modify or truncate a FILE operand.
+
+    Naming the input's own directory as DIR makes the output path *be* the input path.
+    Opening that path for writing would truncate the operand to zero bytes before it had
+    been read, destroying the user's log and reporting success — the silent-wrong-answer
+    class Principle II exists to prevent. The collision is therefore refused before
+    anything is opened for writing: exit 2, a diagnostic naming the path, and the operand
+    byte-unchanged.
+    """
+    logs = tmp_path / "logs"
+    logs.mkdir()
+    payload = b"user jane@example.com from 10.0.0.7\n"
+    a = write(logs / "app.log", payload)
+    before = digest(a)
+
+    result = run_cli("--out-dir", str(logs), a)
+    assert result.returncode == 2
+    assert_names_path_with_a_reason(result.stderr, str(logs / "app.log"), "write")
+    assert_no_status_line_and_no_summary(result)
+    assert result.stdout == b""
+    # The operand is exactly as it was: not truncated, not redacted in place.
+    assert digest(a) == before
+    assert (logs / "app.log").read_bytes() == payload
+
+
+def test_fr020_an_earlier_operand_is_not_destroyed_by_a_later_collision(
+    run_cli, tmp_path
+):
+    """FR-020/FR-016: the collision is caught per operand, after earlier ones succeeded.
+
+    The first operand lives elsewhere and is written normally; the second collides. The
+    run fails, the second operand survives untouched, and the first operand's output is
+    kept.
+    """
+    logs = tmp_path / "logs"
+    logs.mkdir()
+    other = tmp_path / "other"
+    other.mkdir()
+    first = write(other / "a.log", b"a@b.io\n")
+    payload = b"user jane@example.com\n"
+    second = write(logs / "b.log", payload)
+
+    result = run_cli("--out-dir", str(logs), first, second)
+    assert result.returncode == 2
+    assert (logs / "b.log").read_bytes() == payload
+    assert (logs / "a.log").read_bytes() == b"[EMAIL]\n"
+    assert_no_status_line_and_no_summary(result)
+
+
+def test_fr020_a_distinct_file_of_the_same_name_in_the_destination_is_still_replaced(
+    run_cli, tmp_path
+):
+    """FR-011/FR-020: the refusal is about identity, not about the name.
+
+    DIR/app.log existing as an unrelated file is the ordinary FR-011 replacement case and
+    must still succeed — only a target that *is* the operand being read is refused.
+    """
+    logs = tmp_path / "logs"
+    logs.mkdir()
+    a = write(logs / "app.log", b"user jane@example.com\n")
+    out = tmp_path / "clean"
+    out.mkdir()
+    (out / "app.log").write_bytes(b"unrelated older content\n")
+
+    result = run_cli("--out-dir", str(out), a)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == b"wrote 1 files\n"
+    assert (out / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert (logs / "app.log").read_bytes() == b"user jane@example.com\n"
