new file mode 100644
index 0000000..b68da99
--- /dev/null
+++ b/tests/test_out_dir.py
@@ -0,0 +1,336 @@
+"""User Story 2 end-to-end: --out-dir writes one redacted file per input.
+
+Covers FR-008 to FR-014 and FR-019 to FR-021 through the real ``python -m logredact``
+process. The failure paths (FR-015 to FR-018) live in tests/test_out_dir_errors.py; the
+two files are kept apart because their fixtures are opposites — a folder to inspect
+versus a folder that must *not* appear.
+"""
+
+import hashlib
+import os
+
+import pytest
+
+
+def write(path, data: bytes):
+    path.write_bytes(data)
+    return str(path)
+
+
+def digest(path) -> str:
+    """The SHA-256 of a file's bytes, for before/after comparison (FR-020)."""
+    with open(path, "rb") as handle:
+        return hashlib.sha256(handle.read()).hexdigest()
+
+
+# --- FR-008, FR-009, FR-012, FR-013, FR-021: the worked example ------------------------
+
+
+def test_fr008_fr009_fr012_worked_example_3_one_file_per_input(run_cli, tmp_path):
+    """FR-008, FR-009, FR-012, FR-013, FR-021: contract worked example 3.
+
+    Two operands, a folder that does not yet exist: the folder appears holding exactly
+    two files named after the inputs with the right redacted content, stdout carries only
+    the status line, stderr is empty and the status is 0.
+    """
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    b = write(tmp_path / "web.log", b"GET / from 10.0.0.7\n")
+    out = tmp_path / "clean"
+
+    result = run_cli("--out-dir", str(out), a, b)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == b"wrote 2 files\n"
+    assert result.stderr == b""
+    assert (out / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert (out / "web.log").read_bytes() == b"GET / from [IP]\n"
+    assert sorted(p.name for p in out.iterdir()) == ["app.log", "web.log"]
+
+
+def test_fr010_missing_parents_of_the_destination_are_created(run_cli, tmp_path):
+    """FR-010: DIR and every missing parent are created, not reported as an error."""
+    a = write(tmp_path / "app.log", b"tel +14155552671\n")
+    out = tmp_path / "out" / "deep" / "nested"
+    assert not out.exists()
+
+    result = run_cli("--out-dir", str(out), a)
+    assert result.returncode == 0, result.stderr
+    assert out.is_dir()
+    assert (out / "app.log").read_bytes() == b"tel [PHONE]\n"
+
+
+def test_fr009_the_output_is_named_from_the_basename_only(run_cli, tmp_path):
+    """FR-009: logs/app.log → DIR/app.log — the leading directories are dropped."""
+    logs = tmp_path / "logs"
+    logs.mkdir()
+    a = write(logs / "app.log", b"user jane@example.com\n")
+    out = tmp_path / "clean"
+
+    result = run_cli("--out-dir", str(out), a)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == b"wrote 1 files\n"
+    assert (out / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert not (out / "logs").exists()
+    assert sorted(p.name for p in out.iterdir()) == ["app.log"]
+
+
+def test_fr011_an_existing_target_file_is_fully_replaced(run_cli, tmp_path):
+    """FR-011: none of the previous content survives — the file is truncated, not appended.
+
+    The stale content is deliberately longer than the new content, so an append or a
+    partial overwrite would leave a recognisable tail behind.
+    """
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    out = tmp_path / "clean"
+    out.mkdir()
+    stale = b"STALE CONTENT THAT MUST NOT SURVIVE " * 50
+    (out / "app.log").write_bytes(stale)
+
+    result = run_cli("--out-dir", str(out), a)
+    assert result.returncode == 0, result.stderr
+    assert (out / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert b"STALE" not in (out / "app.log").read_bytes()
+
+
+def test_fr010_an_existing_destination_is_used_as_is_and_bystanders_are_untouched(
+    run_cli, tmp_path
+):
+    """FR-010: an existing DIR is not an error, and files in it that share no name
+    with an operand are left exactly as they were."""
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    out = tmp_path / "clean"
+    out.mkdir()
+    bystander = out / "unrelated.txt"
+    bystander.write_bytes(b"do not touch me\n")
+
+    result = run_cli("--out-dir", str(out), a)
+    assert result.returncode == 0, result.stderr
+    assert bystander.read_bytes() == b"do not touch me\n"
+    assert sorted(p.name for p in out.iterdir()) == ["app.log", "unrelated.txt"]
+
+
+def test_fr012_an_empty_input_produces_an_empty_output_that_still_counts(
+    run_cli, tmp_path
+):
+    """FR-012: a 0-byte input yields a 0-byte output file, and N still counts it."""
+    empty = write(tmp_path / "empty.log", b"")
+    out = tmp_path / "clean"
+
+    result = run_cli("--out-dir", str(out), empty)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == b"wrote 1 files\n"
+    assert (out / "empty.log").exists()
+    assert (out / "empty.log").read_bytes() == b""
+
+
+@pytest.mark.parametrize("count", [1, 2, 3])
+def test_fr012_the_word_files_is_never_pluralised(run_cli, tmp_path, count):
+    """FR-012: `wrote 1 files` is correct and deliberate — the word is literally `files`
+    for every N, including 1."""
+    names = []
+    for index in range(count):
+        names.append(write(tmp_path / f"f{index}.log", b"a@b.io\n"))
+    out = tmp_path / "clean"
+
+    result = run_cli("--out-dir", str(out), *names)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == f"wrote {count} files\n".encode()
+    assert b"file\n" not in result.stdout
+
+
+def test_fr013_stdout_carries_the_status_line_and_no_redacted_text(run_cli, tmp_path):
+    """FR-013: in output-folder mode no log text reaches stdout at all."""
+    a = write(tmp_path / "app.log", b"user jane@example.com from 10.0.0.7\n")
+    out = tmp_path / "clean"
+
+    result = run_cli("--out-dir", str(out), a)
+    assert result.stdout == b"wrote 1 files\n"
+    assert b"[EMAIL]" not in result.stdout
+    assert b"[IP]" not in result.stdout
+    assert b"jane" not in result.stdout
+
+
+def test_fr012_no_status_line_appears_without_the_option(run_cli, tmp_path):
+    """FR-012: `wrote N files` belongs to output-folder mode only."""
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+
+    result = run_cli(a)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == b"user [EMAIL]\n"
+    assert b"wrote" not in result.stdout
+    assert b"wrote" not in result.stderr
+
+
+# --- FR-019: the option is accepted in any position ------------------------------------
+
+
+@pytest.mark.parametrize(
+    "args_builder",
+    [
+        lambda out, a, b: ("--out-dir", out, a, b),
+        lambda out, a, b: (a, b, "--out-dir", out),
+        lambda out, a, b: (a, "--out-dir", out, b),
+    ],
+    ids=["option-first", "option-last", "option-between-operands"],
+)
+def test_fr019_the_option_is_accepted_before_among_and_after_the_operands(
+    run_cli, tmp_path, args_builder
+):
+    """FR-019: --out-dir in any position behaves identically (parse_intermixed_args)."""
+    a = write(tmp_path / "a.log", b"a@b.io\n")
+    b = write(tmp_path / "b.log", b"1.2.3.4\n")
+    out = tmp_path / "clean"
+
+    result = run_cli(*args_builder(str(out), a, b))
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == b"wrote 2 files\n"
+    assert (out / "a.log").read_bytes() == b"[EMAIL]\n"
+    assert (out / "b.log").read_bytes() == b"[IP]\n"
+
+
+# --- FR-020: input files are never modified --------------------------------------------
+
+
+def test_fr020_the_input_files_are_byte_unchanged(run_cli, tmp_path):
+    """FR-020: no operand is opened for writing, truncated, or modified."""
+    payload_a = b"user jane@example.com from 10.0.0.7\n"
+    payload_b = b"paid with 4111 1111 1111 1111\n"
+    a = write(tmp_path / "app.log", payload_a)
+    b = write(tmp_path / "web.log", payload_b)
+    before = (digest(a), digest(b))
+    out = tmp_path / "clean"
+
+    result = run_cli("--out-dir", str(out), a, b)
+    assert result.returncode == 0, result.stderr
+    assert (digest(a), digest(b)) == before
+    assert open(a, "rb").read() == payload_a
+    assert open(b, "rb").read() == payload_b
+
+
+# --- FR-014: byte fidelity of the written files ----------------------------------------
+
+
+def test_fr014_an_output_file_is_byte_identical_to_the_stdout_path(run_cli, tmp_path):
+    """FR-014: what lands in DIR/<name> is exactly what stdout would have received."""
+    payload = b"user jane@example.com\r\n\ttrailing   \nno final newline"
+    a = write(tmp_path / "odd.log", payload)
+    out = tmp_path / "clean"
+
+    via_dir = run_cli("--out-dir", str(out), a)
+    via_stdout = run_cli(a)
+    assert via_dir.returncode == 0, via_dir.stderr
+    assert via_stdout.returncode == 0, via_stdout.stderr
+    assert (out / "odd.log").read_bytes() == via_stdout.stdout
+
+
+# --- Multiplicity: one write per operand (FR-012, contract table) ----------------------
+
+
+def test_fr012_two_operands_sharing_a_basename_write_one_file_and_count_two(
+    run_cli, tmp_path
+):
+    """FR-012: a/app.log and b/app.log both write DIR/app.log — the second wins, N is 2.
+
+    N counts one write per operand, not one file on disk, so the status line reports 2
+    even though only one file remains.
+    """
+    first = tmp_path / "a"
+    second = tmp_path / "b"
+    first.mkdir()
+    second.mkdir()
+    a = write(first / "app.log", b"FIRST a@b.io\n")
+    b = write(second / "app.log", b"SECOND 1.2.3.4\n")
+    out = tmp_path / "clean"
+
+    result = run_cli("--out-dir", str(out), a, b)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == b"wrote 2 files\n"
+    assert sorted(p.name for p in out.iterdir()) == ["app.log"]
+    # The second operand's content, written last, is what survives.
+    assert (out / "app.log").read_bytes() == b"SECOND [IP]\n"
+    assert b"FIRST" not in (out / "app.log").read_bytes()
+
+
+def test_fr012_the_same_file_named_twice_behaves_identically(run_cli, tmp_path):
+    """FR-012: one operand repeated is read twice and counted twice."""
+    a = write(tmp_path / "app.log", b"user jane@example.com\n")
+    out = tmp_path / "clean"
+
+    result = run_cli("--out-dir", str(out), a, a)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == b"wrote 2 files\n"
+    assert sorted(p.name for p in out.iterdir()) == ["app.log"]
+    assert (out / "app.log").read_bytes() == b"user [EMAIL]\n"
+
+
+def test_sc008_the_concatenated_outputs_equal_the_stdout_of_the_same_run(
+    run_cli, tmp_path
+):
+    """SC-008: for a successful multi-file run, the output files concatenated in operand
+    order are byte-identical to the stdout of the same run without --out-dir."""
+    a = write(tmp_path / "a.log", b"user jane@example.com\r\nsecond line\n")
+    b = write(tmp_path / "b.log", b"GET / from 10.0.0.7\n")
+    c = write(tmp_path / "c.log", b"tel +14155552671 no trailing newline")
+    out = tmp_path / "clean"
+
+    via_dir = run_cli("--out-dir", str(out), a, b, c)
+    via_stdout = run_cli(a, b, c)
+    assert via_dir.returncode == 0, via_dir.stderr
+    assert via_stdout.returncode == 0, via_stdout.stderr
+
+    concatenated = b"".join(
+        (out / name).read_bytes() for name in ("a.log", "b.log", "c.log")
+    )
+    assert concatenated == via_stdout.stdout
+
+
+# --- Ordering: status line after every write, summary after that (Edge Cases) ----------
+
+
+def test_fr012_the_status_line_appears_only_after_every_output_file_is_complete(
+    run_cli, tmp_path
+):
+    """FR-012 Edge Case "Ordering": `wrote N files` follows every output file's close.
+
+    Observable form of the guarantee: whenever the status line is present, every output
+    file is already on disk with its complete content. The converse — no status line
+    when a later operand failed — is pinned in tests/test_out_dir_errors.py.
+    """
+    payload = b"user jane@example.com\n" * 2000
+    names = [write(tmp_path / f"f{i}.log", payload) for i in range(5)]
+    out = tmp_path / "clean"
+
+    result = run_cli("--out-dir", str(out), *names)
+    assert result.stdout == b"wrote 5 files\n"
+    for i in range(5):
+        assert (out / f"f{i}.log").read_bytes() == b"user [EMAIL]\n" * 2000
+
+
+def test_fr012_the_summary_follows_the_status_line_on_a_merged_stream(tmp_path):
+    """FR-012/FR-007 Edge Case "Ordering": stdout's status line, then stderr's summary.
+
+    Captured separately the two streams carry no relative order, so this run merges them
+    into one pipe: the single flush before the summary is what makes `wrote N files`
+    land first. Without it the buffered status line would appear *after* the unbuffered
+    summary.
+    """
+    import subprocess
+    import sys
+
+    from conftest import SRC
+
+    a = write(tmp_path / "a.log", b"user jane@example.com\n" * 2000)
+    out = tmp_path / "clean"
+
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+    merged = subprocess.run(
+        [sys.executable, "-m", "logredact", "--count", "--out-dir", str(out), a],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        env=env,
+    )
+
+    assert merged.returncode == 0, merged.stdout
+    assert merged.stdout == (
+        b"wrote 1 files\nemails=2000 ips=0 cards=0 phones=0\n"
+    )
