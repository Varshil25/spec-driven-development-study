+    bare run has no "+", and a run broken by a space is two runs that each fail the card
+    length rule too — so nothing on any line may change, on either the stdin or the file
+    path.
+    """
+    payload = (
+        b"+1234567\n"
+        b"+1234567890123456\n"
+        b"14155552671\n"
+        b"+ 14155552671\n"
+        b"+1 415 555 2671\n"
+    )
+    out = both_paths(run_cli, tmp_path, payload)
+    assert out == payload
+    assert b"[PHONE]" not in out
+
+
+def test_sc006_the_v2_corpus_is_unchanged_by_the_new_category(run_cli, tmp_path):
+    """FR-005/SC-006: quickstart V2 — input with no phone number redacts exactly as 001.
+
+    This is the corpus whose pre-change output was captured as the regression baseline:
+    the three existing categories and the two documented near-misses must all behave
+    exactly as they did before phone recognition existed.
+    """
+    payload = (
+        b"user jane@example.com from 10.0.0.7\n"
+        b"paid with 4111 1111 1111 1111\n"
+        b"host 999.1.1.1 unreachable\n"
+        b"123 1.2.3.4\n"
+    )
+    assert both_paths(run_cli, tmp_path, payload) == (
+        b"user [EMAIL] from [IP]\n"
+        b"paid with [CARD]\n"
+        b"host 999.1.1.1 unreachable\n"
+        b"123 [IP]\n"
+    )
+
+
+def test_fr014_an_output_file_is_byte_identical_to_the_input_and_to_stdout(
+    run_cli, tmp_path
+):
+    """FR-014: quickstart V9 — the output-folder path has the stdout path's fidelity.
+
+    The payload has nothing to redact and every awkward feature at once: a \\r\\n ending,
+    bytes that are not valid UTF-8, a tab-and-trailing-space line, and a final line with
+    no newline. The file written into DIR must be byte-identical to the input *and* to
+    what the same run without --out-dir sends to stdout — the two cmp checks V9 performs.
+    """
+    payload = (
+        b"plain\r\n"
+        b"latin\xff\xfe bytes\n"
+        b"\ttrailing   \n"
+        b"no final newline"
+    )
+    path = write(tmp_path / "odd.log", payload)
+    out = tmp_path / "clean"
+
+    via_dir = run_cli("--out-dir", str(out), path)
+    assert via_dir.returncode == 0, via_dir.stderr
+    assert via_dir.stdout == b"wrote 1 files\n"
+    assert via_dir.stderr == b""
+
+    written = (out / "odd.log").read_bytes()
+    # cmp odd.log clean/odd.log
+    assert written == payload
+    assert not written.endswith(b"\n")
+
+    # cmp via_stdout.log clean/odd.log
+    via_stdout = run_cli(path)
+    assert via_stdout.returncode == 0, via_stdout.stderr
+    assert written == via_stdout.stdout
+
+
+def test_fr014_output_file_fidelity_holds_when_there_is_also_something_to_redact(
+    run_cli, tmp_path
+):
+    """FR-014: the redactions are the *only* difference between input and output file."""
+    payload = b"caf\xe9 jane@example.com\r\n\ttel +14155552671   \nlast 1.2.3.4"
+    path = write(tmp_path / "mixed.log", payload)
+    out = tmp_path / "clean"
+
+    via_dir = run_cli("--out-dir", str(out), path)
+    assert via_dir.returncode == 0, via_dir.stderr
+    written = (out / "mixed.log").read_bytes()
+    assert written == b"caf\xe9 [EMAIL]\r\n\ttel [PHONE]   \nlast [IP]"
+    assert written == run_cli(path).stdout
