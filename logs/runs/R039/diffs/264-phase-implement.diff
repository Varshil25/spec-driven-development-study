+def test_every_runtime_import_is_standard_library():
+    """FR-015 / Principle I: nothing outside the standard library is imported.
+
+    Parsed rather than grepped, so an import cannot hide inside a function body
+    or behind unusual whitespace.
+    """
+    stdlib = set(sys.stdlib_module_names)
+    modules = _shipped_modules()
+    assert modules
+
+    imported = set()
+    for path in modules:
+        with open(path, encoding="utf-8") as handle:
+            tree = ast.parse(handle.read(), filename=path)
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Import):
+                for alias in node.names:
+                    imported.add(alias.name.split(".")[0])
+            elif isinstance(node, ast.ImportFrom):
+                if node.level:
+                    # A relative import of this package's own modules.
+                    continue
+                if node.module:
+                    imported.add(node.module.split(".")[0])
+
+    assert imported, "expected at least one import"
+    outside = sorted(name for name in imported if name not in stdlib)
+    assert outside == [], f"non-stdlib runtime imports: {outside}"
+    # The planned import set (plan.md Technical Context).
+    assert imported <= {"re", "sys", "os", "io", "argparse", "typing"}, imported
+
