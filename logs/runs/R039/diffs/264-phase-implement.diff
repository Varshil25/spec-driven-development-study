+++ b/src/logredact/redact.py
@@ -0,0 +1,202 @@
+"""Recognition patterns for the three redaction categories.
+
+Pure values and pure functions over ``str``: no I/O, no process, and no
+filesystem access happens in this module (plan.md Structure Decision), which is
+what lets the recognition rules (FR-004 - FR-009) and the adversarial timing
+budget (SC-008) be tested in isolation.
+
+Every character class is written out explicitly and is ASCII only. The regex
+shorthand classes for digits, word characters, and word boundaries are
+deliberately absent from this file: on ``str`` patterns the digit shorthand also
+matches non-ASCII decimal digits, which would feed non-ASCII text to the Luhn
+check and silently produce garbage (research.md D-004).
+
+The authoritative grammar is contracts/redaction-rules.md; the patterns below
+are a verbatim transcription of it.
+"""
+
+import re
+
+# Fixed, non-reversible placeholders: no padding, length hint, hash, or counter,
+# so no input value is recoverable from the output (SR-002,
+# contracts/redaction-rules.md section 6).
+EMAIL_PLACEHOLDER = "[EMAIL]"
+IP_PLACEHOLDER = "[IP]"
+CARD_PLACEHOLDER = "[CARD]"
+
+# Email, rank 1 (FR-004). The leading lookbehind rejects a start whose preceding
+# character is itself local-part-valid and the trailing lookahead rejects an end
+# followed by a label-valid character, so a match is never extended into, nor
+# truncated by, an adjacent valid character. Every quantifier is bounded
+# (research.md D-005).
+_EMAIL = (
+    r"(?<![A-Za-z0-9._%+-])"
+    r"[A-Za-z0-9._%+-]{1,256}"
+    r"@"
+    r"(?:[A-Za-z0-9-]{1,63}\.){1,16}"
+    r"[A-Za-z]{2,63}"
+    r"(?![A-Za-z0-9-])"
+)
+
+# IPv4 octet, rank 2 (FR-005): one to three digits with a numeric value of 0-255
+# inclusive, leading zeros permitted. Fixed width, no quantifier.
+_OCTET = r"(?:25[0-5]|2[0-4][0-9]|[01][0-9][0-9]|[0-9][0-9]|[0-9])"
+
+_IPV4 = r"(?<![0-9.])" + _OCTET + r"(?:\." + _OCTET + r"){3}" + r"(?![0-9.])"
+
+# One combined alternation in rank order. Listing the email alternative first is
+# what encodes the email-before-IPv4 half of the FR-008 precedence; ``finditer``
+# over it supplies leftmost, non-overlapping, greedy-longest matches (FR-009).
+EMAIL_OR_IP = re.compile(r"(?P<email>" + _EMAIL + r")|(?P<ip>" + _IPV4 + r")")
+
+# Maximal ASCII digit runs, used to drive card detection. A candidate can only
+# begin at the start of a maximal run and end at the end of one, which is
+# exactly FR-007's "not immediately preceded or followed by another digit" with
+# no separate boundary test (research.md D-003).
+DIGIT_RUN = re.compile(r"[0-9]+")
+
+# Card bounds and the only two permitted separators (FR-006).
+CARD_MIN_DIGITS = 13
+CARD_MAX_DIGITS = 19
+CARD_SEPARATORS = (" ", "-")
+
+
+def luhn_ok(digits):
+    """Return ``True`` when ``digits`` passes the Luhn checksum.
+
+    Right to left, double every second digit, subtract 9 from any doubled value
+    above 9, sum all; valid when the sum mod 10 is 0
+    (contracts/redaction-rules.md section 3).
+
+    ``digits`` is only ever reached holding ASCII ``[0-9]`` characters, which the
+    explicit classes in :data:`DIGIT_RUN` guarantee -- the shorthand digit class
+    would have admitted non-ASCII decimal digits here and made ``ord(ch) - 48``
+    produce garbage (research.md D-004).
+    """
+    total = 0
+    double = False
+    for character in reversed(digits):
+        value = ord(character) - 48
+        if double:
+            value *= 2
+            if value > 9:
+                value -= 9
+        total += value
+        double = not double
+    return total % 10 == 0
+
+
+def find_card_spans(text):
+    """Return the non-overlapping card spans in ``text`` as ``(start, end)``.
+
+    A pure function over one text slice, implementing
+    contracts/redaction-rules.md section 3 step by step:
+
+    1. Find **maximal** ASCII digit runs. A candidate can therefore only begin
+       at a run start and end at a run end, which *is* FR-007's
+       "not immediately preceded or followed by another digit" -- no separate
+       boundary test is needed.
+    2. Two consecutive runs chain when exactly one character separates them and
+       it is ``' '`` or ``'-'``. Kinds may be mixed; a double separator does not
+       chain.
+    3. For each run *i* left to right, walk forward over chained runs
+       accumulating the digit total and stop as soon as the total exceeds 19,
+       recording the **largest** *j* whose total is 13-19 digits and whose
+       concatenated digits pass Luhn. Stopping at 19 bounds enumeration to at
+       most 19 runs per start position (SR-006).
+    4. On a recorded candidate emit the span from the start of run *i* to the end
+       of run *j* and resume at run *j+1*; otherwise advance to run *i+1*.
+    """
+    runs = [match.span() for match in DIGIT_RUN.finditer(text)]
+    spans = []
+    index = 0
+    while index < len(runs):
+        total = 0
+        best = -1
+        forward = index
+        while forward < len(runs):
+            if forward > index:
+                previous_end = runs[forward - 1][1]
+                if runs[forward][0] - previous_end != 1:
+                    break
+                if text[previous_end] not in CARD_SEPARATORS:
+                    break
+            run_start, run_end = runs[forward]
+            total += run_end - run_start
+            if total > CARD_MAX_DIGITS:
+                break
+            if total >= CARD_MIN_DIGITS:
+                digits = "".join(
+                    text[start:end] for start, end in runs[index:forward + 1]
+                )
+                if luhn_ok(digits):
+                    best = forward
+            forward += 1
+        if best >= 0:
+            spans.append((runs[index][0], runs[best][1]))
+            index = best + 1
+        else:
+            index += 1
+    return spans
+
+
+def redact_line(line):
+    """Return ``(redacted_line, counts)`` for one line of text.
+
+    The three-stage pipeline of research.md D-003:
+
+    1. ``finditer`` the combined email/IPv4 alternation for leftmost,
+       non-overlapping, rank-ordered matches.
+    2. Run card detection **only inside the gaps** stage 1 left uncovered. That
+       gap restriction is what implements the rest of FR-008's precedence: an
+       email or IPv4 match suppresses any overlapping card candidate, even one
+       starting earlier.
+    3. Rebuild the line by concatenating **verbatim** input slices with
+       **literal** placeholder strings.
+
+    No replacement template is used anywhere, so backreference or template syntax
+    in the input -- ``\\1``, ``\\g<0>``, ``${x}``, or the literal text
+    ``[EMAIL]`` -- cannot alter a substitution (SR-004, G-2), and appended
+    placeholder text is never re-scanned (FR-008).
+
+    ``counts`` is keyed ``"emails"``, ``"ips"``, ``"cards"`` with one increment
+    per replacement.
+    """
+    counts = {"emails": 0, "ips": 0, "cards": 0}
+
+    # Stage 1: email and IPv4, in rank order.
+    matches = []
+    gaps = []
+    covered_to = 0
+    for match in EMAIL_OR_IP.finditer(line):
+        start, end = match.span()
+        if match.group("email") is not None:
+            matches.append((start, end, EMAIL_PLACEHOLDER))
+            counts["emails"] += 1
+        else:
+            matches.append((start, end, IP_PLACEHOLDER))
+            counts["ips"] += 1
+        if start > covered_to:
+            gaps.append((covered_to, start))
+        covered_to = end
+    if covered_to < len(line):
+        gaps.append((covered_to, len(line)))
+
+    # Stage 2: cards, in the gaps only.
+    for gap_start, gap_end in gaps:
+        for start, end in find_card_spans(line[gap_start:gap_end]):
+            matches.append((gap_start + start, gap_start + end, CARD_PLACEHOLDER))
+            counts["cards"] += 1
+
+    # Stage 3: rebuild. Matches are sorted by start and never overlap, so
+    # ``previous.end <= next.start`` holds for consecutive pairs (data-model.md
+    # section 5).
+    matches.sort()
+    pieces = []
+    position = 0
+    for start, end, placeholder in matches:
+        pieces.append(line[position:start])
+        pieces.append(placeholder)
+        position = end
+    pieces.append(line[position:])
+    return "".join(pieces), counts
