+# --------------------------------------------------------------------------
+# SR-007: fail-closed output
+# --------------------------------------------------------------------------
+
+
+class _FailingWrite:
+    """A stdout whose ``write`` raises, as a real full disk or closed pipe would."""
+
+    def __init__(self):
+        self.flushed = False
+
+    def write(self, _text):
+        raise OSError(28, "No space left on device")
+
+    def flush(self):
+        self.flushed = True
+
+
+class _FailingFlush:
+    """A stdout that accepts writes but fails to flush them."""
+
+    def __init__(self):
+        self.written = []
+
+    def write(self, text):
+        self.written.append(text)
+        return len(text)
+
+    def flush(self):
+        raise OSError(5, "Input/output error")
+
+
+def test_write_failure_is_reported_and_exits_non_zero():
+    """SR-007 / INV-6: a truncated stream is never reported as success."""
+    err = io.StringIO()
+    status = cli.main(
+        [],
+        stdin=io.StringIO("user jane@example.com\n"),
+        stdout=_FailingWrite(),
+        stderr=err,
+    )
+    assert status != 0
+    assert status == 2
+    message = err.getvalue()
+    assert message != ""
+    assert message.count("\n") == 1
+    assert "Traceback" not in message
+    # SR-001: the diagnostic reports the write failure without echoing input.
+    assert "jane" not in message
+    # The failure is reported for what it is. A write failure that fell through
+    # to the "cannot read" handler would exit 2 for the wrong reason and tell
+    # the caller to look at the wrong end of the pipeline.
+    assert "write" in message
+    assert "cannot read" not in message
+
+
+def test_flush_failure_is_reported_and_exits_non_zero():
+    """SR-007: the final flush is wrapped too, not only the writes."""
+    err = io.StringIO()
+    status = cli.main(
+        [],
+        stdin=io.StringIO("user jane@example.com\n"),
+        stdout=_FailingFlush(),
+        stderr=err,
+    )
+    assert status == 2
+    message = err.getvalue()
+    assert message != ""
+    assert "Traceback" not in message
+    assert "jane" not in message
+
