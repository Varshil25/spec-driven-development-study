new file mode 100644
index 0000000..286ff77
--- /dev/null
+++ b/src/logredact/cli.py
@@ -0,0 +1,333 @@
+"""Command-line surface: argument parsing, input sources, bounded reads, output.
+
+Everything with a side effect lives here; the matching engine is in
+:mod:`logredact.redact` (plan.md Structure Decision).
+
+``main`` returns an exit status rather than raising ``SystemExit``, and takes its
+three streams as keyword arguments defaulting to the real ``sys`` streams. That
+is what makes the output-write-failure path (SR-007) and the standard-input path
+reachable by deterministic in-process tests on any uid (research.md D-008).
+"""
+
+import argparse
+import os
+import sys
+
+from .redact import redact_line
+
+# Maximum decoded content per line: 1 MiB = 1 048 576 characters (SR-005).
+# Reads are bounded by this, so peak memory is bounded by it regardless of total
+# input size (FR-016, SC-007).
+MAX_LINE = 1024 * 1024
+
+# Encoding policy, applied identically to every input file and to standard input
+# and standard output (research.md D-001). ``surrogateescape`` is the only
+# standard-library error handler that round-trips exactly, so bytes that are not
+# valid UTF-8 reach the output unchanged rather than failing or becoming U+FFFD
+# (FR-017). ``newline=""`` on both sides means newline sequences are neither
+# translated nor normalised, so "\n", "\r\n", and a lone "\r" are preserved
+# exactly (FR-003).
+_ENCODING = "utf-8"
+_ERRORS = "surrogateescape"
+_NEWLINE = ""
+
+STDIN_NAME = "<stdin>"
+
+# Diagnostic prefix, matching the invocation form so a message read out of a
+# surrounding script's log identifies its source.
+_PROG = "python -m logredact"
+
+
+def _report_unreadable(err, name, error):
+    """Write the one-line "cannot read" diagnostic for ``error`` to ``err``.
+
+    Says what was rejected and why, in terms the caller can act on
+    (Principle II). The only input-derived string is ``name`` -- a path from the
+    invoking user's own command line, or ``<stdin>`` -- so no input line
+    content, matched value, or fragment of one can reach stderr (SR-001), and
+    the message is never a stack trace (SR-009).
+    """
+    detail = error.strerror
+    if not detail:
+        detail = str(error) or error.__class__.__name__
+    source = name if name is not None else "input"
+    err.write(f"{_PROG}: cannot read {source}: {detail}\n")
+
+
+def _report_over_long(err, name):
+    """Report a line whose content exceeds ``MAX_LINE``.
+
+    Names the input source and states the limit, and **does not quote the line**
+    -- the rejected content is exactly what must not reach stderr (SR-005,
+    SR-001).
+    """
+    err.write(
+        f"{_PROG}: {name}: line exceeds the maximum of {MAX_LINE} characters\n"
+    )
+
+
+def _report_write_failure(err, error):
+    """Report a failure to write or flush standard output (SR-007)."""
+    detail = error.strerror
+    if not detail:
+        detail = str(error) or error.__class__.__name__
+    err.write(f"{_PROG}: cannot write to standard output: {detail}\n")
+
+
+def _fail_output(err, error):
+    """Report an output failure. Returns 2, or exits at once on a broken pipe.
+
+    A write or flush failure is never swallowed: a truncated stream must not be
+    reported as success (SR-007, INV-6, Principle II).
+
+    ``BrokenPipeError`` is handled by exiting immediately rather than returning,
+    because CPython flushes ``sys.stdout`` during interpreter shutdown; with the
+    pipe already broken that flush raises again, prints
+    ``Exception ignored in: <stdout>`` to stderr -- polluting FR-011 and SR-001
+    -- and replaces the documented status with 120 (research.md D-006). Stderr
+    is flushed first so the diagnostic is not lost. Letting the error propagate
+    instead is not an option: that prints a stack trace (SR-009).
+    """
+    _report_write_failure(err, error)
+    if isinstance(error, BrokenPipeError):
+        err.flush()
+        os._exit(2)
+    return 2
+
+
+def build_parser():
+    """Return the argument parser for ``python -m logredact``.
+
+    ``argparse`` already satisfies FR-012 and FR-014 as-is: it accepts
+    ``--count`` in any position, collects the remaining arguments positionally in
+    the order given, prints usage to stderr and exits 2 on an unrecognised
+    option, and treats a bare ``-`` as a positional rather than an option
+    (research.md D-007).
+    """
+    parser = argparse.ArgumentParser(
+        prog="python -m logredact",
+        description=(
+            "Replace email addresses, IPv4 addresses, and Luhn-valid payment "
+            "card numbers in log text with fixed placeholders."
+        ),
+    )
+    parser.add_argument(
+        "--count",
+        action="store_true",
+        help="also write 'emails=N ips=N cards=N' to standard error",
+    )
+    parser.add_argument(
+        "files",
+        nargs="*",
+        metavar="FILE",
+        help="input path, read in the order given; standard input when omitted",
+    )
+    return parser
+
+
+def _configure(stream):
+    """Apply the shared encoding and newline policy to ``stream``.
+
+    Real ``sys`` streams are text wrappers and are reconfigured in place.
+    Injected test doubles need not support reconfiguration; absence of the method
+    is a capability check, not a swallowed failure.
+    """
+    reconfigure = getattr(stream, "reconfigure", None)
+    if reconfigure is not None:
+        reconfigure(encoding=_ENCODING, errors=_ERRORS, newline=_NEWLINE)
+    return stream
+
+
+def _open_source(path):
+    """Open ``path`` read-only under the shared encoding policy.
+
+    Mode is ``"r"`` and only ``"r"``: no create, truncate, or append mode is ever
+    used, so the tool cannot modify an input file (SR-008, G-3). ``path`` is used
+    verbatim -- not resolved, normalised, or containment-checked -- per SR-009.
+    """
+    return open(path, "r", encoding=_ENCODING, errors=_ERRORS, newline=_NEWLINE)
+
+
+def _partition(argv):
+    """Return ``argv`` regrouped as options, then ``--``, then FILE paths.
+
+    FR-012 requires ``--count`` in **any** position with every non-option
+    argument treated as a FILE path in the order given, so ``a --count b`` is
+    equivalent to ``--count a b`` (contracts/cli.md Arguments).
+
+    ``argparse`` alone does not deliver that: with a ``nargs="*"`` positional it
+    stops collecting at the first option and rejects the arguments after it
+    ("unrecognized arguments: b"), contradicting research.md D-007's assumption
+    that argparse satisfies FR-012 unaided. Regrouping before parsing keeps
+    argparse responsible for options, usage, help, and the exit-2 usage error
+    (FR-014) while making the requirement hold.
+
+    No option in this tool takes a value -- ``--count``, ``-h``, and ``--help``
+    are the entire surface -- so no token can be the value of a preceding
+    option, and the split is unambiguous. The emitted ``--`` is what keeps a
+    path that begins with ``-`` literal, so a FILE of ``-`` stays a relative
+    path rather than becoming a standard-input alias. A ``--`` already present
+    in ``argv`` is honoured: every token after it is a path.
+    """
+    options = []
+    paths = []
+    paths_only = False
+    for token in argv:
+        if paths_only:
+            paths.append(token)
+        elif token == "--":
+            paths_only = True
+        elif token.startswith("-") and token != "-":
+            options.append(token)
+        else:
+            paths.append(token)
+    return options + ["--"] + paths
+
+
+def _iter_sources(files, stdin):
+    """Yield one ``(name, stream)`` pair per input source, in argument order.
+
+    A generator rather than a class, because an ``InputSource`` is nothing more
+    than that pair (data-model.md section 2, Principle IV).
+
+    When ``files`` is empty the single source is standard input, named
+    ``<stdin>``. Otherwise each FILE is opened **lazily when it is reached** and
+    **closed before the next one is opened**, so output for file *n* has already
+    been written when file *n+1* is opened (contracts/cli.md "Ordering and
+    failure semantics"), and standard input is never opened or read at all
+    (FR-002, US2-5).
+
+    A FILE of ``-`` is a literal relative path, never a standard-input alias
+    (contracts/cli.md Arguments). Paths are passed to ``open`` verbatim -- not
+    resolved, normalised, or containment-checked (SR-009) -- and never for
+    writing (SR-008).
+    """
+    if not files:
+        yield STDIN_NAME, stdin
+        return
+    for path in files:
+        try:
+            stream = _open_source(path)
+        except OSError as error:
+            # Caught only to guarantee the path is available to the diagnostic,
+            # then re-raised unchanged: an injected failure may carry no
+            # filename of its own. Nothing is discarded (Principle II).
+            if error.filename is None:
+                error.filename = path
+            raise
+        try:
+            yield path, stream
+        finally:
+            stream.close()
+
+
+def main(argv, *, stdin=None, stdout=None, stderr=None):
+    """Run the tool and return its exit status. Never raises ``SystemExit``."""
+    out = _configure(sys.stdout if stdout is None else stdout)
+    err = _configure(sys.stderr if stderr is None else stderr)
+
+    parser = build_parser()
+    saved_stdout, saved_stderr = sys.stdout, sys.stderr
+    sys.stdout, sys.stderr = out, err
+    try:
+        options = parser.parse_args(_partition(argv))
+    except SystemExit as exc:
+        return _exit_code(exc)
+    finally:
+        sys.stdout, sys.stderr = saved_stdout, saved_stderr
+
+    counts = {"emails": 0, "ips": 0, "cards": 0}
+    source_stdin = _configure(sys.stdin if stdin is None else stdin)
+
+    # Every source is consumed in argument order, each with the same bounded
+    # read loop, so file n's output is written before file n+1 is opened
+    # (US2-1, US2-2).
+    try:
+        for name, stream in _iter_sources(options.files, source_stdin):
+            status = _consume(name, stream, out, err, counts)
+            if status != 0:
+                return status
+    except OSError as error:
+        # Raised by the lazy open in ``_iter_sources`` -- FileNotFoundError,
+        # PermissionError, IsADirectoryError, and any other OSError subclass.
+        # Caught to add context and report, never to discard: the run stops here
+        # with a diagnostic and status 2 (FR-013, Principle II). Read and write
+        # failures are handled inside ``_consume``, so they never reach this
+        # handler.
+        _report_unreadable(err, error.filename, error)
+        return 2
+
+    # Exit status 0 is produced only once the full redacted stream has reached
+    # stdout, so the final flush is part of the success condition rather than an
+    # afterthought (FR-014, SR-007, INV-6).
+    try:
+        out.flush()
+    except OSError as error:
+        return _fail_output(err, error)
+
+    # The summary is written on the success path only: after the final stdout
+    # flush has succeeded, never before it, never to stdout, and never on a
+    # failing run -- every failure path above returns without reaching here
+    # (FR-010, US3-4, US4-5). It is three integers, so it carries no input
+    # content by construction (SR-001).
+    if options.count:
+        err.write(
+            "emails={emails} ips={ips} cards={cards}\n".format(**counts)
+        )
+    return 0
+
+
+def _consume(name, stream, out, err, counts):
+    """Redact every line of one source. Return 0 on success, 2 on failure.
+
+    Reads with ``readline(MAX_LINE + 1)`` rather than iterating the stream or
+    calling ``readline()`` bare, both of which are unbounded: a single very long
+    line would otherwise be materialised whole in memory (research.md D-002,
+    SR-005).
+
+    Each chunk carries its terminator exactly as read, and a final line that
+    arrived without one gains none, which is FR-003 / US1-6.
+    """
+    while True:
+        try:
+            chunk = stream.readline(MAX_LINE + 1)
+        except OSError as error:
+            # A failure part way through a source is reported with that source's
+            # name and stops the run; output already written is kept (FR-013,
+            # US4-4).
+            _report_unreadable(err, name, error)
+            return 2
+        if not chunk:
+            return 0
+
+        # A chunk is terminated when it ends with "\n" or "\r". ``readline``
+        # returned at most MAX_LINE + 1 characters, so an *unterminated* chunk
+        # longer than MAX_LINE proves the line's content exceeds the limit. It
+        # is rejected, never silently truncated (SR-005, Principle II,
+        # research.md D-002). A chunk of MAX_LINE content characters plus its
+        # terminator is exactly at the limit and legal -- including D-002's
+        # benign case where a "\r\n" terminator is split across two chunks, for
+        # which the bytes written stay byte-identical and no rule spans a line
+        # boundary.
+        if len(chunk) > MAX_LINE and not chunk.endswith(("\n", "\r")):
+            _report_over_long(err, name)
+            return 2
+
+        text, delta = redact_line(chunk)
+        try:
+            out.write(text)
+        except OSError as error:
+            return _fail_output(err, error)
+        counts["emails"] += delta["emails"]
+        counts["ips"] += delta["ips"]
+        counts["cards"] += delta["cards"]
+
+
+def _exit_code(exc):
+    """Translate the ``SystemExit`` argparse raises into a status to return."""
+    code = exc.code
+    if code is None:
+        return 0
+    if isinstance(code, int):
+        return code
+    return 2
