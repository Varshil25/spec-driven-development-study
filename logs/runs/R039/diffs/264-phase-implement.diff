new file mode 100644
index 0000000..9ce0bc4
--- /dev/null
+++ b/tests/test_performance.py
@@ -0,0 +1,123 @@
+"""SR-006, SC-007, SC-008: bounded matching time and throughput.
+
+Deterministic and network-free (Principle III). Budgets are the ones stated in
+the specification, and the design measured large margins against them
+(research.md D-005: 117 ms worst adversarial line against a 1 s budget;
+D-010: 1.9 s for 10 MB against a 10 s budget), so these assertions do not depend
+on the speed of the machine to within an order of magnitude.
+"""
+
+import time
+
+import pytest
+
+from logredact.redact import redact_line
+from conftest import run_cli
+
+# SC-008: each adversarial line must complete well inside one second.
+ADVERSARIAL_BUDGET_SECONDS = 1.0
+# SC-007: 10 MB must redact in under ten seconds.
+THROUGHPUT_BUDGET_SECONDS = 10.0
+
+ADVERSARIAL_LINES = {
+    "digit-run": "9" * 10000,
+    "separator-run": "1 " * 5000,
+    "label-run": "a." * 2500 + "@" + "a." * 2500,
+    "dotted-digits": "1." * 5000,
+    "local-part-run": "a" * 10000 + "@",
+}
+
+
+@pytest.mark.parametrize("name", sorted(ADVERSARIAL_LINES))
+def test_adversarial_line_completes_inside_the_budget(name):
+    """SR-006 / SC-008: no catastrophic backtracking on any pathological shape."""
+    line = ADVERSARIAL_LINES[name]
+    assert len(line) >= 10000
+
+    start = time.perf_counter()
+    result, _counts = redact_line(line)
+    elapsed = time.perf_counter() - start
+
+    assert result is not None
+    assert elapsed < ADVERSARIAL_BUDGET_SECONDS, (
+        f"{name}: {elapsed:.3f}s exceeds the {ADVERSARIAL_BUDGET_SECONDS}s budget"
+    )
+
+
+def test_matching_time_grows_linearly_in_line_length():
+    """SR-006 / G-5: linear, not quadratic -- doubling the line roughly doubles
+    the time, so a ten-fold increase cannot blow past the budget."""
+    unit = "1 "
+
+    def elapsed_for(repeat):
+        line = unit * repeat
+        start = time.perf_counter()
+        redact_line(line)
+        return time.perf_counter() - start
+
+    # Warm up, so first-call overhead does not dominate the smaller sample.
+    elapsed_for(1000)
+
+    small = elapsed_for(2500)
+    large = elapsed_for(10000)
+    # Four times the input. Linear would be ~4x; allow a generous factor for
+    # timer noise while still failing loudly on quadratic behaviour (~16x).
+    assert large < max(small * 10, 0.05), (
+        f"4x the input took {large:.4f}s against {small:.4f}s -- not linear"
+    )
+
+
+def test_all_adversarial_lines_in_one_run_stay_inside_the_budget(tmp_path):
+    """SC-008 end to end through the real entry point (quickstart Scenario 6)."""
+    path = tmp_path / "adversarial.log"
+    path.write_text("\n".join(ADVERSARIAL_LINES[name] for name in sorted(ADVERSARIAL_LINES)) + "\n")
+
+    start = time.perf_counter()
+    status, _out, err = run_cli([str(path)])
+    elapsed = time.perf_counter() - start
+
+    assert status == 0
+    assert err == b""
+    # Five lines, each budgeted at one second, plus interpreter startup.
+    assert elapsed < len(ADVERSARIAL_LINES) * ADVERSARIAL_BUDGET_SECONDS
+
+
+def test_ten_megabytes_redacts_inside_the_budget(tmp_path):
+    """SC-007: throughput on a representative log (research.md D-010)."""
+    line = (
+        "2026-11-21T10:00:00 INFO user jane.doe@example.com from 10.0.0.7 "
+        "paid 4111 1111 1111 1111 ok\n"
+    )
+    repeats = (10 * 1024 * 1024) // len(line) + 1
+    path = tmp_path / "big.log"
+    with open(path, "w", encoding="utf-8", newline="") as handle:
+        handle.writelines([line] * repeats)
+    size = path.stat().st_size
+    assert size >= 10 * 1024 * 1024
+
+    start = time.perf_counter()
+    status, out, err = run_cli([str(path)])
+    elapsed = time.perf_counter() - start
+
+    assert status == 0
+    assert err == b""
+    # Every line was redacted, and nothing leaked.
+    assert out.count(b"[EMAIL]") == repeats
+    assert out.count(b"[IP]") == repeats
+    assert out.count(b"[CARD]") == repeats
+    assert b"jane.doe@example.com" not in out
+    assert elapsed < THROUGHPUT_BUDGET_SECONDS, (
+        f"{size} bytes took {elapsed:.2f}s, over the "
+        f"{THROUGHPUT_BUDGET_SECONDS}s budget"
+    )
+
+
+def test_a_line_at_the_limit_is_matched_in_bounded_time():
+    """SR-006: the worst case the per-line ceiling permits is still bounded."""
+    line = "1 " * (1024 * 1024 // 2)
+    start = time.perf_counter()
+    redact_line(line)
+    elapsed = time.perf_counter() - start
+    # 1 MiB is ~105x the 10 000-character adversarial line; linear time means
+    # well inside a few seconds.
+    assert elapsed < 30.0, f"a 1 MiB separator run took {elapsed:.2f}s"
diff --git a/tests/test_precedence.py b/tests/test_precedence.py
new file mode 100644
index 0000000..18dfaf0
--- /dev/null
+++ b/tests/test_precedence.py
@@ -0,0 +1,99 @@
+"""FR-008 / FR-009 precedence, overlap, and ordering.
+
+Precedence is **email (1) -> IPv4 (2) -> card (3)**, applied **before** position,
+so a higher-ranked match suppresses an overlapping card candidate even one that
+starts earlier. Within a category leftmost wins and at a shared start the longest
+valid candidate wins. Matches never overlap, and placeholders are never nested,
+doubly substituted, or re-scanned.
+"""
+
+import pytest
+
+from logredact.redact import (
+    CARD_PLACEHOLDER,
+    EMAIL_PLACEHOLDER,
+    IP_PLACEHOLDER,
+    redact_line,
+)
+
+
+def redacted(text):
+    result, _counts = redact_line(text)
+    return result
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        # Email outranks card at the same start.
+        ("12345678903@example.com", "[EMAIL]"),
+        ("4111111111111111@a.com", "[EMAIL]"),
+        # Not an email (final label is not alphabetic), so IPv4 applies.
+        ("a@1.2.3.4", "a@[IP]"),
+        # A failed card candidate must not block the IPv4 or email match that
+        # starts later inside the same digit region.
+        ("12 34.5.6.7", "12 [IP]"),
+        ("12 34@x.com", "12 [EMAIL]"),
+        # Several matches of different categories on one line.
+        ("a@b.io 1.2.3.4", "[EMAIL] [IP]"),
+        ("user jane@example.com from 10.0.0.7", "user [EMAIL] from [IP]"),
+    ],
+)
+def test_precedence_results(line, expected):
+    assert redacted(line) == expected
+
+
+def test_email_suppresses_an_overlapping_card_candidate():
+    """FR-008: precedence is applied before position."""
+    line = "4111111111111111@a.com"
+    result, counts = redact_line(line)
+    assert result == EMAIL_PLACEHOLDER
+    assert counts["emails"] == 1
+    assert counts["cards"] == 0
+    assert CARD_PLACEHOLDER not in result
+
+
+def test_matches_never_overlap_and_are_ordered_left_to_right():
+    line = "a@b.io 1.2.3.4 4111 1111 1111 1111"
+    result, counts = redact_line(line)
+    assert result == "[EMAIL] [IP] [CARD]"
+    assert counts == {"emails": 1, "ips": 1, "cards": 1}
+    # Placeholders appear in input order.
+    assert result.index(EMAIL_PLACEHOLDER) < result.index(IP_PLACEHOLDER)
+    assert result.index(IP_PLACEHOLDER) < result.index(CARD_PLACEHOLDER)
+
+
+def test_longest_candidate_wins_at_a_shared_start():
+    """FR-009: at one start position the longest valid card candidate is taken."""
+    # Both a 14-digit and a 16-digit candidate start at offset 0; the longer one
+    # must be chosen, so the trailing group is consumed rather than left behind.
+    assert redacted("41111111111111 11") == CARD_PLACEHOLDER
+
+
+def test_placeholder_text_in_the_input_is_not_substituted_again():
+    """FR-008 / SR-004: inserted text is never re-scanned, and literal
+    placeholder text in the input passes through inertly."""
+    line = "[EMAIL] was already redacted, now a@b.io"
+    result, counts = redact_line(line)
+    assert result == "[EMAIL] was already redacted, now [EMAIL]"
+    # Exactly one replacement happened: the pre-existing literal was not counted.
+    assert counts["emails"] == 1
+    assert result.count(EMAIL_PLACEHOLDER) == 2
+
+
+def test_placeholders_are_never_nested():
+    line = "[IP] 10.0.0.7 [CARD]"
+    result, _counts = redact_line(line)
+    assert result == "[IP] [IP] [CARD]"
+    assert "[[" not in result
+    assert "]]" not in result
+
+
+def test_each_replacement_increments_exactly_one_counter():
+    _result, counts = redact_line("a@b.io a@b.io 1.2.3.4 4111111111111111")
+    assert counts == {"emails": 2, "ips": 1, "cards": 1}
+
+
+def test_unmatched_text_between_matches_is_verbatim():
+    line = "A\ta@b.io  B\t1.2.3.4   C"
+    assert redacted(line) == "A\t[EMAIL]  B\t[IP]   C"
diff --git a/tests/test_redact_card.py b/tests/test_redact_card.py
new file mode 100644
index 0000000..a94d50a
--- /dev/null
+++ b/tests/test_redact_card.py
@@ -0,0 +1,131 @@
+"""FR-006 / FR-007 payment card recognition, Luhn, grouping, and boundaries.
+
+Rules under test (contracts/redaction-rules.md section 3): 13 to 19 digits
+inclusive counting digits only; contiguous, or groups of one or more digits
+joined by **single** ``' '`` or ``'-'`` separators with separators never at the
+start or end of the match and kinds mixable; Luhn must pass; and the character
+immediately before or after the match must not be a digit.
+"""
+
+import pytest
+
+from logredact.redact import luhn_ok, redact_line
+
+# Luhn-valid 16-digit value, written contiguously and in groups.
+VALID_16 = "4111111111111111"
+# Luhn-valid 13-digit value -- the minimum accepted length.
+VALID_13 = "4111111111119"
+# Luhn-valid but only 12 digits -- below the minimum.
+VALID_12 = "411111111117"
+# 13 digits whose Luhn checksum fails.
+INVALID_13 = "1234567890123"
+
+
+def redacted(text):
+    result, _counts = redact_line(text)
+    return result
+
+
+def test_luhn_accepts_and_rejects():
+    """The checksum itself, independent of any scanning (FR-006, FR-007)."""
+    assert luhn_ok(VALID_16) is True
+    assert luhn_ok(VALID_13) is True
+    assert luhn_ok(VALID_12) is True
+    assert luhn_ok(INVALID_13) is False
+    # Changing one digit breaks the checksum.
+    assert luhn_ok("4111111111111112") is False
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        # Contiguous.
+        (VALID_16, "[CARD]"),
+        # Single-space groups.
+        ("4111 1111 1111 1111", "[CARD]"),
+        # Mixed single separators.
+        ("4111-1111 1111-1111", "[CARD]"),
+        # All hyphens.
+        ("4111-1111-1111-1111", "[CARD]"),
+        # Irregular group sizes: any grouping of 1+ digits is accepted.
+        ("4 111111111111111", "[CARD]"),
+        ("41111111111111 11", "[CARD]"),
+        # 13 digits -- the minimum.
+        (VALID_13, "[CARD]"),
+        # Letters do not block the match; a non-digit neighbour is fine.
+        ("x" + VALID_16, "x[CARD]"),
+        ("edge" + VALID_16 + "edge", "edge[CARD]edge"),
+        ("paid with 4111 1111 1111 1111, ok", "paid with [CARD], ok"),
+    ],
+)
+def test_card_is_replaced(line, expected):
+    assert redacted(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        # A double separator does not chain, and no part reaches 13 digits.
+        "4111  1111 1111 1111",
+        "4111--1111-1111-1111",
+        # Luhn fails.
+        INVALID_13,
+        # Luhn passes but there are only 12 digits.
+        VALID_12,
+        # 20 contiguous digits: no 13-19 digit candidate ends at a run end.
+        "4" + "1" * 19,
+        # Non-ASCII decimal digits are not digits here (research.md D-004).
+        "١٢٣٤٥٦٧٨٩٠١٢٣",
+        # A separator kind that is not a single space or hyphen.
+        "4111_1111_1111_1111",
+        "4111.1111.1111.1111",
+    ],
+)
+def test_non_card_is_unchanged(line):
+    assert redacted(line) == line
+    assert "[CARD]" not in redacted(line)
+
+
+def test_digit_adjacent_candidate_is_rejected():
+    """FR-007: the character before or after the match must not be a digit."""
+    # A 20-digit contiguous run contains a Luhn-valid 16-digit prefix, but that
+    # prefix does not end at a run end, so nothing is redacted.
+    line = VALID_16 + "1234"
+    assert len(line) == 20
+    assert redacted(line) == line
+
+
+def test_longer_trailing_group_is_left_alone():
+    """The 16-digit candidate ends at a run end; 20 digits exceeds the maximum."""
+    assert redacted("4111 1111 1111 1111 1234") == "[CARD] 1234"
+
+
+def test_separator_is_never_at_the_start_or_end_of_the_match():
+    result = redacted("ref -4111 1111 1111 1111- end")
+    assert result == "ref -[CARD]- end"
+
+
+def test_card_flush_against_line_start_and_end():
+    assert redacted(VALID_16 + " tail") == "[CARD] tail"
+    assert redacted("head " + VALID_16) == "head [CARD]"
+
+
+def test_luhn_invalid_sequence_beside_a_valid_one():
+    """A rejected candidate must not hide or absorb a later valid one."""
+    result, counts = redact_line("paid with 4111 1111 1111 1111, ref " + INVALID_13)
+    assert result == "paid with [CARD], ref " + INVALID_13
+    assert counts["cards"] == 1
+
+
+def test_multiple_cards_on_one_line():
+    result, counts = redact_line(VALID_16 + " and " + VALID_13)
+    assert result == "[CARD] and [CARD]"
+    assert counts["cards"] == 2
+
+
+def test_original_value_is_absent_as_a_substring():
+    """SR-002: no prefix or suffix of the number survives."""
+    result = redacted("card 4111 1111 1111 1111 end")
+    assert "4111" not in result
+    assert "1111" not in result
+    assert result == "card [CARD] end"
diff --git a/tests/test_redact_email.py b/tests/test_redact_email.py
new file mode 100644
index 0000000..4fc8802
--- /dev/null
+++ b/tests/test_redact_email.py
@@ -0,0 +1,102 @@
+"""FR-004 email recognition and boundaries, plus SR-002 no-partial-disclosure.
+
+Grammar under test (contracts/redaction-rules.md section 1): a local part of one
+or more characters from letters, digits, ``.``, ``_``, ``%``, ``+``, ``-``; a
+single ``@``; one or more dot-separated labels of letters, digits, ``-``; and a
+final label of at least two characters, letters only.
+"""
+
+import pytest
+
+from logredact.redact import redact_line
+
+
+def redacted(text):
+    result, _counts = redact_line(text)
+    return result
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        # Multi-label domain with "+" and "." in the local part.
+        ("jane.doe+test@mail.example.com", "[EMAIL]"),
+        # Final label "io" is exactly two letters -- the minimum.
+        ("a@b.io", "[EMAIL]"),
+        # A trailing dot is a label separator, not a label character, so a
+        # sentence-final address is still recognised in full.
+        ("jane@example.com.", "[EMAIL]."),
+        # Single-character local part drawn from each permitted class.
+        ("x_1%2+3-4.5@sub.example.org", "[EMAIL]"),
+        # Flush against the start and the end of the line.
+        ("a@b.io rest", "[EMAIL] rest"),
+        ("rest a@b.io", "rest [EMAIL]"),
+    ],
+)
+def test_email_is_replaced(line, expected):
+    assert redacted(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        # Final label is not letters-only. Truncating to a shorter valid label is
+        # forbidden, so the whole value is left intact.
+        "a@b.co1",
+        # Final label is a single letter.
+        "a@b.c",
+        # No local part at all.
+        "@b.io",
+        # No domain.
+        "a@",
+        # A bare "@" with no address around it.
+        "plain @ text",
+    ],
+)
+def test_non_email_is_unchanged(line):
+    assert redacted(line) == line
+
+
+def test_truncation_to_a_shorter_label_is_not_emitted():
+    """``a@b.co1`` must not become ``[EMAIL]1`` (FR-004, SR-002)."""
+    assert redacted("a@b.co1") == "a@b.co1"
+    assert "[EMAIL]" not in redacted("a@b.co1")
+
+
+def test_ipv4_domain_is_not_an_email():
+    """A bare IPv4 domain fails the final-label rule, so the IPv4 rule applies."""
+    assert redacted("a@1.2.3.4") == "a@[IP]"
+
+
+def test_over_long_local_part_emits_no_partial_match():
+    """SR-002: a value beyond the bound survives whole rather than leaking a prefix."""
+    line = "a" * 300 + "@b.io"
+    result = redacted(line)
+    assert result == line
+    assert "[EMAIL]" not in result
+    # No prefix or suffix of the address was replaced: the full original text,
+    # including the domain, is still present exactly once.
+    assert result.count("@b.io") == 1
+
+
+def test_adjacent_local_part_character_does_not_shift_the_match():
+    """The lookbehind stops a match from starting mid-local-part (FR-004)."""
+    # The run before "@" is one local part; there is no shorter valid start.
+    assert redacted("abc" + "@") == "abc@"
+
+
+def test_original_value_is_absent_as_a_substring():
+    """SR-002 / INV-2: no fragment of the recognised address survives."""
+    value = "jane.doe+test@mail.example.com"
+    result = redacted("user " + value + " ok")
+    assert result == "user [EMAIL] ok"
+    assert value not in result
+    assert "jane" not in result
+    assert "example" not in result
+
+
+def test_counts_one_increment_per_replacement():
+    _result, counts = redact_line("a@b.io and c@d.io")
+    assert counts["emails"] == 2
+    assert counts["ips"] == 0
+    assert counts["cards"] == 0
diff --git a/tests/test_redact_ipv4.py b/tests/test_redact_ipv4.py
new file mode 100644
index 0000000..b4b9c4d
--- /dev/null
+++ b/tests/test_redact_ipv4.py
@@ -0,0 +1,89 @@
+"""FR-005 IPv4 recognition and boundaries.
+
+Grammar under test (contracts/redaction-rules.md section 2): exactly four
+dot-separated octets of one to three digits, each with a numeric value of 0 to
+255 inclusive, leading zeros permitted. A candidate immediately preceded or
+followed by a digit or a ``.`` is not redacted.
+"""
+
+import pytest
+
+from logredact.redact import redact_line
+
+
+def redacted(text):
+    result, _counts = redact_line(text)
+    return result
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ("10.0.0.7", "[IP]"),
+        # Leading zeros are permitted; the rule is the numeric value (010 == 10).
+        ("010.0.0.7", "[IP]"),
+        ("0.0.0.0", "[IP]"),
+        ("255.255.255.255", "[IP]"),
+        # Every octet alternative: 25x, 2[0-4]x, [01]xx, two digits, one digit.
+        ("250.249.199.9", "[IP]"),
+        ("hit 10.0.0.7 today", "hit [IP] today"),
+    ],
+)
+def test_ipv4_is_replaced(line, expected):
+    assert redacted(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        # 999 is not an octet, and the interior candidate 99.1.1.1 is
+        # digit-preceded.
+        "999.1.1.1",
+        # Five groups: the candidate is dot-bounded on at least one side.
+        "1.2.3.4.5",
+        # 256 exceeds 255; interior candidates are digit-preceded.
+        "256.1.1.1",
+        # Three groups only.
+        "1.2.3",
+        # A trailing dot makes the candidate dot-followed.
+        "1.2.3.4.",
+        # A leading dot makes the candidate dot-preceded.
+        ".1.2.3.4",
+    ],
+)
+def test_non_ipv4_is_unchanged(line):
+    assert redacted(line) == line
+    assert "[IP]" not in redacted(line)
+
+
+def test_ipv4_flush_against_line_start_and_end():
+    """A value flush against either end of the line is still redacted."""
+    assert redacted("10.0.0.7 tail") == "[IP] tail"
+    assert redacted("head 10.0.0.7") == "head [IP]"
+    assert redacted("10.0.0.7") == "[IP]"
+
+
+def test_ipv4_after_an_at_sign():
+    """``@`` is neither a digit nor a dot, so it does not block the match."""
+    assert redacted("a@1.2.3.4") == "a@[IP]"
+
+
+def test_multiple_ipv4_matches_on_one_line():
+    result, counts = redact_line("from 10.0.0.7 to 192.168.1.1")
+    assert result == "from [IP] to [IP]"
+    assert counts["ips"] == 2
+    assert counts["emails"] == 0
+    assert counts["cards"] == 0
+
+
+def test_original_value_is_absent_as_a_substring():
+    """SR-002: no fragment of the recognised address survives."""
+    result = redacted("peer 10.0.0.7 closed")
+    assert "10.0.0.7" not in result
+    assert "10.0" not in result
+    assert result == "peer [IP] closed"
+
+
+def test_rejected_candidate_does_not_hide_a_later_match():
+    """A failed candidate consumes nothing, so a later match is still found."""
+    assert redacted("999.1.1.1 and 10.0.0.7") == "999.1.1.1 and [IP]"
diff --git a/tests/test_security.py b/tests/test_security.py
new file mode 100644
index 0000000..bfc7335
--- /dev/null
+++ b/tests/test_security.py
@@ -0,0 +1,543 @@
+"""Security requirements SR-001 - SR-004, SR-007 - SR-009, FR-015, SC-010.
+
+Constitution Principle V requires every security requirement to be covered by
+automated tests "including negative tests that prove the control rejects
+malicious input", on the same terms as any other requirement. Each test below
+names the requirement it pins.
+"""
+
+import ast
+import io
+import os
+import sys
+
+import pytest
+
+from logredact import cli
+from logredact.redact import redact_line
+from conftest import REPO_ROOT, SRC_DIR, run_cli
+
+SENSITIVE_LINE = b"user jane@example.com from 10.0.0.7 paid 4111 1111 1111 1111\n"
+SENSITIVE_FRAGMENTS = (
+    b"jane",
+    b"example.com",
+    b"jane@example.com",
+    b"10.0.0.7",
+    b"10.0.0",
+    b"4111",
+    b"1111",
+    b"4111 1111 1111 1111",
+)
+
+
+# --------------------------------------------------------------------------
+# SR-001: no input content in any diagnostic or in the summary
+# --------------------------------------------------------------------------
+
+
+def test_no_input_content_in_the_summary():
+    """SR-001: the tally is three integers and nothing else."""
+    _status, _out, err = run_cli(["--count"], stdin_bytes=SENSITIVE_LINE)
+    assert err == b"emails=1 ips=1 cards=1\n"
+    for fragment in SENSITIVE_FRAGMENTS:
+        assert fragment not in err
+
+
+def test_no_input_content_in_a_read_diagnostic(tmp_path):
+    """SR-001: a failure after reading sensitive lines still leaks nothing."""
+    good = tmp_path / "good.log"
+    good.write_bytes(SENSITIVE_LINE)
+    missing = str(tmp_path / "missing.log")
+    status, _out, err = run_cli([str(good), missing])
+    assert status == 2
+    for fragment in SENSITIVE_FRAGMENTS:
+        assert fragment not in err
+    # Only the caller's own supplied path appears.
+    assert missing.encode() in err
+
+
+def test_no_input_content_in_a_usage_diagnostic():
+    """SR-001: argparse names only the offending option string."""
+    status, _out, err = run_cli(["--bogus"], stdin_bytes=SENSITIVE_LINE)
+    assert status == 2
+    for fragment in SENSITIVE_FRAGMENTS:
+        assert fragment not in err
+
+
+# --------------------------------------------------------------------------
+# SR-002: whole values are replaced; no prefix or suffix survives
+# --------------------------------------------------------------------------
+
+
+def test_original_values_are_absent_as_substrings_of_the_output():
+    """SR-002 / INV-2 / SC-001 at the byte level."""
+    status, out, _err = run_cli([], stdin_bytes=SENSITIVE_LINE)
+    assert status == 0
+    assert out == b"user [EMAIL] from [IP] paid [CARD]\n"
+    for fragment in SENSITIVE_FRAGMENTS:
+        assert fragment not in out
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "jane.doe+test@mail.example.com",
+        "a@b.io",
+        "10.0.0.7",
+        "255.255.255.255",
+        "4111111111111111",
+        "4111 1111 1111 1111",
+        "4111-1111-1111-1111",
+    ],
+)
+def test_no_fragment_of_a_recognised_value_survives(value):
+    """SR-002 / G-6: a whole recognised value is replaced, never a part of it."""
+    result, _counts = redact_line("before " + value + " after")
+    assert value not in result
+    # Every maximal alphanumeric run of the original value is gone as well.
+    for part in value.replace("@", " ").replace(".", " ").replace("-", " ").split():
+        if len(part) >= 2:
+            assert part not in result, part
+    assert result in ("before [EMAIL] after", "before [IP] after", "before [CARD] after")
+
+
+def test_over_long_local_part_emits_no_partial_match():
+    """SR-002: a value past the bound survives intact rather than leaking a prefix."""
+    line = "x" * 300 + "@b.io"
+    result, counts = redact_line(line)
+    assert result == line
+    assert counts["emails"] == 0
+    assert "[EMAIL]" not in result
+
+
+def test_placeholders_disclose_nothing_about_the_value():
+    """SR-002: no length hint, hash, or partial value in the placeholder."""
+    short, _counts = redact_line("a@b.io")
+    long, _counts = redact_line("jane.doe+test@mail.example.com")
+    # Two very different addresses produce byte-identical output.
+    assert short == long == "[EMAIL]"
+
+
+# --------------------------------------------------------------------------
+# SR-003: redaction is unconditional
+# --------------------------------------------------------------------------
+
+
+def test_all_three_categories_redact_with_no_flag():
+    """SR-003: the safe behaviour needs no configuration."""
+    status, out, err = run_cli([], stdin_bytes=SENSITIVE_LINE)
+    assert status == 0
+    assert out == b"user [EMAIL] from [IP] paid [CARD]\n"
+    assert err == b""
+
+
+def test_the_option_surface_is_only_count_and_help():
+    """SR-003: no option exists that could disable or weaken a category."""
+    parser = cli.build_parser()
+    flags = set()
+    for action in parser._actions:
+        flags.update(action.option_strings)
+    assert flags == {"-h", "--help", "--count"}
+
+
+def test_count_changes_only_the_summary():
+    """SR-003: stdout is byte-identical with and without the flag."""
+    _status, plain, plain_err = run_cli([], stdin_bytes=SENSITIVE_LINE)
+    _status, counted, _err = run_cli(["--count"], stdin_bytes=SENSITIVE_LINE)
+    assert plain == counted
+    assert plain_err == b""
+
+
+def test_no_environment_variable_disables_redaction(tmp_path):
+    """SR-003: redaction cannot be weakened from the environment."""
+    path = tmp_path / "in.log"
+    path.write_bytes(SENSITIVE_LINE)
+    env_names = ("LOGREDACT", "LOGREDACT_DISABLE", "NO_REDACT", "REDACT")
+    source = _read_sources()
+    for name in env_names:
+        assert name not in source
+    # ``os`` is imported for the broken-pipe exit only, never to read config.
+    assert "environ" not in source
+    assert "getenv" not in source
+    status, out, _err = run_cli([str(path)])
+    assert status == 0
+    assert out == b"user [EMAIL] from [IP] paid [CARD]\n"
+
+
+# --------------------------------------------------------------------------
+# SR-004: input is inert data
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        rb"\1",
+        rb"\g<0>",
+        rb"${x}",
+        rb"{x}",
+        rb"%s",
+        rb"[EMAIL]",
+        rb"[IP]",
+        rb"[CARD]",
+        rb"$(rm -rf /)",
+        rb"`whoami`",
+        rb"; cat /etc/passwd",
+        rb"&& echo pwned",
+        rb"| tee /tmp/pwned",
+        rb"'; DROP TABLE logs; --",
+        rb"<script>alert(1)</script>",
+        rb"../../etc/passwd",
+        rb"\x00\n\r",
+        rb"{{7*7}}",
+    ],
+)
+def test_metacharacters_pass_through_inertly(payload):
+    """SR-004 / G-1 / G-2: input is never evaluated or interpolated."""
+    line = b"before " + payload + b" after\n"
+    status, out, err = run_cli([], stdin_bytes=line)
+    assert status == 0
+    assert out == line
+    assert err == b""
+
+
+def test_template_syntax_cannot_alter_a_substitution():
+    """SR-004 / G-2: placeholders are inserted literally, not as templates."""
+    line = rb"\g<0> a@b.io \1 10.0.0.7 ${x}" + b"\n"
+    status, out, _err = run_cli([], stdin_bytes=line)
+    assert status == 0
+    assert out == rb"\g<0> [EMAIL] \1 [IP] ${x}" + b"\n"
+
+
+def test_literal_placeholder_in_the_input_is_not_counted_or_rescanned():
+    """FR-008 / SR-004: inserted text is never re-scanned."""
+    result, counts = redact_line("[EMAIL] [IP] [CARD] a@b.io")
+    assert result == "[EMAIL] [IP] [CARD] [EMAIL]"
+    assert counts == {"emails": 1, "ips": 0, "cards": 0}
+
+
+def test_no_shell_or_subprocess_or_eval_in_the_shipped_code():
+    """SR-004 / INV-5 / G-1: nothing executes, deserialises, or shells out."""
+    source = _read_sources()
+    for forbidden in (
+        "subprocess",
+        "os.system",
+        "os.popen",
+        "shell=True",
+        "eval(",
+        "exec(",
+        "pickle",
+        "marshal",
+        "__import__",
+        "yaml",
+        "shlex",
+    ):
+        assert forbidden not in source, forbidden
+    # The only ``compile`` in shipped code is ``re.compile`` for the patterns:
+    # nothing compiles or evaluates a string as code.
