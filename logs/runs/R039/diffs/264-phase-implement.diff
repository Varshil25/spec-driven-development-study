@@ -0,0 +1,52 @@
+"""FR-017: bytes that are not valid UTF-8 round-trip unchanged (research.md D-001).
+
+``errors="surrogateescape"`` is the only standard-library handler that is exactly
+round-tripping, so undecodable bytes reach the output as themselves rather than
+failing the run or becoming U+FFFD.
+"""
+
+from conftest import run_cli
+
+MIXED = b"caf\xe9 jane@example.com \xff\xfe 10.0.0.7\n"
+MIXED_REDACTED = b"caf\xe9 [EMAIL] \xff\xfe [IP]\n"
+
+REPLACEMENT_CHARACTER = b"\xef\xbf\xbd"  # UTF-8 encoding of U+FFFD
+
+
+def test_non_utf8_bytes_pass_through_unchanged_via_stdin():
+    status, out, err = run_cli([], stdin_bytes=MIXED)
+    assert status == 0
+    assert err == b""
+    assert out == MIXED_REDACTED
+
+
+def test_undecodable_bytes_are_present_and_not_substituted():
+    _status, out, _err = run_cli([], stdin_bytes=MIXED)
+    assert b"\xe9" in out
+    assert b"\xff" in out
+    assert b"\xfe" in out
+    assert REPLACEMENT_CHARACTER not in out
+
+
+def test_redaction_still_fires_around_undecodable_bytes():
+    _status, out, _err = run_cli([], stdin_bytes=MIXED)
+    assert b"[EMAIL]" in out
+    assert b"[IP]" in out
+    assert b"jane@example.com" not in out
+    assert b"10.0.0.7" not in out
+
+
+def test_valid_multibyte_utf8_is_preserved():
+    """Well-formed non-ASCII text is untouched; no rule admits a non-ASCII
+    character, so it can never be mistaken for a recognised value."""
+    line = "café über 你好 a@b.io\n".encode("utf-8")
+    status, out, _err = run_cli([], stdin_bytes=line)
+    assert status == 0
+    assert out == "café über 你好 [EMAIL]\n".encode("utf-8")
+
+
+def test_undecodable_byte_adjacent_to_a_match():
+    """A lone surrogate next to a value does not extend or block the match."""
+    status, out, _err = run_cli([], stdin_bytes=b"\xffa@b.io\xff\n")
+    assert status == 0
+    assert out == b"\xff[EMAIL]\xff\n"
diff --git a/tests/test_limits.py b/tests/test_limits.py
new file mode 100644
index 0000000..24cf163
--- /dev/null
+++ b/tests/test_limits.py
@@ -0,0 +1,203 @@
+"""SR-005 per-line ceiling and FR-016 bounded memory (INV-3, SC-007).
+
+Reads are bounded with ``readline(MAX_LINE + 1)``, so peak memory is bounded by
+the per-line limit no matter how large the total input is. A line whose content
+exceeds the limit is **rejected**, never silently truncated (Principle II).
+"""
+
+import io
+import tracemalloc
+
+from logredact import cli
+from logredact.cli import MAX_LINE
+from conftest import run_cli
+
+
+def test_the_limit_is_one_mebibyte():
+    """SR-005: 1 MiB = 1 048 576 characters of decoded content."""
+    assert MAX_LINE == 1024 * 1024
+    assert MAX_LINE == 1048576
+
+
+def test_line_exactly_at_the_limit_succeeds(tmp_path):
+    """A line of exactly MAX_LINE content characters is legal."""
+    path = tmp_path / "at-limit.log"
+    path.write_bytes(b"x" * MAX_LINE + b"\n")
+    status, out, err = run_cli([str(path)])
+    assert status == 0
+    assert err == b""
+    assert out == b"x" * MAX_LINE + b"\n"
+
+
+def test_line_at_the_limit_with_a_redactable_value(tmp_path):
+    """Redaction still works on a line right at the ceiling."""
+    value = b"a@b.io"
+    # The padding is separated from the value: run it straight into the address
+    # and the local part would be over a million characters, which correctly
+    # exceeds the {1,256} bound and emits no match at all (SR-002).
+    padding = b"x" * (MAX_LINE - len(value) - 1) + b" "
+    path = tmp_path / "at-limit-value.log"
+    path.write_bytes(padding + value + b"\n")
+    assert len(padding + value) == MAX_LINE
+    status, out, err = run_cli([str(path)])
+    assert status == 0
+    assert err == b""
+    assert out == padding + b"[EMAIL]\n"
+
+
+def test_over_long_line_fails_with_status_two(tmp_path):
+    """SR-005: exceeding the limit fails loudly rather than truncating."""
+    path = tmp_path / "too-long.log"
+    path.write_bytes(b"x" * (MAX_LINE + 10) + b"\n")
+    status, _out, err = run_cli([str(path)])
+    assert status == 2
+    text = err.decode()
+    # Names the input source.
+    assert str(path) in text
+    # States the limit.
+    assert str(MAX_LINE) in text
+    # One line, no stack trace.
+    assert text.count("\n") == 1
+    assert "Traceback" not in text
+
+
+def test_over_long_line_diagnostic_does_not_quote_the_line(tmp_path):
+    """SR-001: the rejected line's content must not reach stderr."""
+    path = tmp_path / "too-long-secret.log"
+    path.write_bytes(b"jane@example.com " + b"y" * (MAX_LINE + 10) + b"\n")
+    status, _out, err = run_cli([str(path)])
+    assert status == 2
+    text = err.decode()
+    assert "y" * 20 not in text
+    assert "jane" not in text
+    assert "@example.com" not in text
+    # A diagnostic naming a path plus a limit is short; a quoted line is not.
+    assert len(err) < 500
+
+
+def test_over_long_line_is_not_silently_truncated(tmp_path):
+    """Principle II: no partial output is passed off as a complete redaction."""
+    path = tmp_path / "too-long-2.log"
+    path.write_bytes(b"x" * (MAX_LINE + 10) + b"\n")
+    status, out, _err = run_cli([str(path)])
+    assert status == 2
+    # Whatever reached stdout, the run did not report success.
+    assert status != 0
+    assert len(out) <= MAX_LINE + 1
+
+
+def test_over_long_line_on_stdin_is_also_rejected():
+    """The ceiling applies to standard input as well as to named files."""
+    status, _out, err = run_cli([], stdin_bytes=b"x" * (MAX_LINE + 10) + b"\n")
+    assert status == 2
+    text = err.decode()
+    assert "<stdin>" in text
+    assert str(MAX_LINE) in text
+
+
+def test_over_long_line_stops_the_run_before_later_files(tmp_path):
+    """A rejected line stops processing; a later file is not emitted."""
+    first = tmp_path / "first.log"
+    first.write_bytes(b"x" * (MAX_LINE + 10) + b"\n")
+    second = tmp_path / "second.log"
+    second.write_bytes(b"SECOND MUST NOT APPEAR\n")
+    status, out, _err = run_cli([str(first), str(second)])
+    assert status == 2
+    assert b"SECOND MUST NOT APPEAR" not in out
+
+
+def test_no_summary_on_an_over_long_line(tmp_path):
+    """US4-5: a failing run produces no tally, even with ``--count``."""
+    path = tmp_path / "too-long-3.log"
+    path.write_bytes(b"a@b.io\n" + b"x" * (MAX_LINE + 10) + b"\n")
+    status, _out, err = run_cli(["--count", str(path)])
+    assert status == 2
+    assert b"emails=" not in err
+
+
+class _SyntheticLines:
+    """A line source that holds no backlog: the same ``str`` every call.
+
+    Returning one shared object means the *harness* allocates nothing per line,
+    so a peak-memory measurement reflects the tool's own per-line work rather
+    than the test's bookkeeping.
+    """
+
+    def __init__(self, line, count):
+        self.line = line
+        self.remaining = count
+
+    def readline(self, _limit=-1):
+        if self.remaining <= 0:
+            return ""
+        self.remaining -= 1
+        return self.line
+
+
+class _Sink:
+    """A stdout that counts bytes and keeps nothing."""
+
+    def __init__(self):
+        self.written = 0
+
+    def write(self, text):
+        self.written += len(text)
+        return len(text)
+
+    def flush(self):
+        pass
+
+
+def test_peak_memory_is_bounded_by_the_per_line_limit():
+    """INV-3 / FR-016 / SC-007: total input size is unbounded.
+
+    Streams an input far larger in total than the per-line limit and asserts
+    peak Python allocation stays below the limit itself -- which is only
+    possible if lines are processed one at a time.
+    """
+    line = "2026-11-21 INFO user a@b.io from 1.2.3.4 paid 4111111111111111 ok\n"
+    count = 200_000
+    total = len(line) * count
+    # The total input is many times the per-line ceiling.
+    assert total > 8 * MAX_LINE
+
+    source = _SyntheticLines(line, count)
+    sink = _Sink()
+
+    tracemalloc.start()
+    try:
+        status = cli.main([], stdin=source, stdout=sink, stderr=io.StringIO())
+        _current, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+
+    assert status == 0
+    assert sink.written > 0
+    # Peak stays under the per-line limit even though the input is ~13 MB.
+    assert peak < MAX_LINE, (
+        f"peak {peak} bytes should stay below the per-line limit {MAX_LINE} "
+        f"while streaming {total} bytes"
+    )
+
+
+def test_peak_memory_does_not_grow_with_total_input():
+    """INV-3: ten times the input must not mean ten times the memory."""
+    line = "plain log line with a@b.io in it\n"
+
+    def peak_for(count):
+        source = _SyntheticLines(line, count)
+        tracemalloc.start()
+        try:
+            status = cli.main(
+                [], stdin=source, stdout=_Sink(), stderr=io.StringIO()
+            )
+            _current, peak = tracemalloc.get_traced_memory()
+        finally:
+            tracemalloc.stop()
+        assert status == 0
+        return peak
+
+    small = peak_for(10_000)
+    large = peak_for(100_000)
+    # Ten times the input, essentially the same peak.
+    assert large < small * 2
