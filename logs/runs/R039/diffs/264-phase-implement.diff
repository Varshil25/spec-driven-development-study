new file mode 100644
index 0000000..38516d5
--- /dev/null
+++ b/tests/test_cli_files.py
@@ -0,0 +1,174 @@
+"""User Story 2: named FILE arguments (FR-002, FR-012, US2-1 - US2-5).
+
+Files are read in argument order and emitted as one concatenated redacted
+stream; standard input is not read at all when FILEs are present.
+"""
+
+import os
+import subprocess
+import sys
+
+import pytest
+
+from conftest import REPO_ROOT, SRC_DIR, run_cli
+
+A_CONTENT = b"from a jane@example.com\n"
+A_REDACTED = b"from a [EMAIL]\n"
+B_CONTENT = b"from b 10.0.0.7\n"
+B_REDACTED = b"from b [IP]\n"
+
+MIXED = b"caf\xe9 jane@example.com \xff\xfe 10.0.0.7\n"
+MIXED_REDACTED = b"caf\xe9 [EMAIL] \xff\xfe [IP]\n"
+
+
+@pytest.fixture
+def logs(tmp_path):
+    """Two small files with known content, plus an empty one."""
+    a = tmp_path / "a.log"
+    a.write_bytes(A_CONTENT)
+    b = tmp_path / "b.log"
+    b.write_bytes(B_CONTENT)
+    empty = tmp_path / "empty.log"
+    empty.write_bytes(b"")
+    return str(a), str(b), str(empty)
+
+
+def test_single_file_is_redacted(logs):
+    a, _b, _empty = logs
+    status, out, err = run_cli([a])
+    assert status == 0
+    assert out == A_REDACTED
+    assert err == b""
+
+
+def test_files_are_emitted_in_argument_order(logs):
+    """US2-1: all of a's lines before all of b's."""
+    a, b, _empty = logs
+    status, out, err = run_cli([a, b])
+    assert status == 0
+    assert out == A_REDACTED + B_REDACTED
+    assert err == b""
+
+
+def test_reversing_the_arguments_reverses_the_output(logs):
+    """US2-2."""
+    a, b, _empty = logs
+    status, out, _err = run_cli([b, a])
+    assert status == 0
+    assert out == B_REDACTED + A_REDACTED
+
+
+def test_empty_file_contributes_nothing_and_exits_zero(logs):
+    """US2-3."""
+    _a, _b, empty = logs
+    status, out, err = run_cli([empty])
+    assert status == 0
+    assert out == b""
+    assert err == b""
+
+
+def test_empty_file_between_two_others(logs):
+    a, b, empty = logs
+    status, out, _err = run_cli([a, empty, b])
+    assert status == 0
+    assert out == A_REDACTED + B_REDACTED
+
+
+def test_same_file_named_twice_is_emitted_twice(logs):
+    """US2-4."""
+    a, _b, _empty = logs
+    status, out, _err = run_cli([a, a])
+    assert status == 0
+    assert out == A_REDACTED + A_REDACTED
+
+
+def test_stdin_is_not_read_when_a_file_is_given(logs):
+    """US2-5 / FR-002: the run must not block and must ignore piped text.
+
+    ``run_cli`` closes the child's stdin after writing, so a tool that *did*
+    read stdin would still terminate -- the assertion that matters is that the
+    piped text is absent from the output.
+    """
+    a, _b, _empty = logs
+    status, out, err = run_cli([a], stdin_bytes=b"SHOULD NOT APPEAR\n")
+    assert status == 0
+    assert out == A_REDACTED
+    assert b"SHOULD NOT APPEAR" not in out
+    assert b"SHOULD NOT APPEAR" not in err
+
+
+def test_stdin_is_not_read_even_when_it_would_block(logs):
+    """US2-5: with a FILE argument the tool never waits on standard input.
+
+    stdin is left open and empty-but-unclosed by giving the child a pipe that is
+    never written to; a tool that read stdin would hang and hit the timeout.
+    """
+    import os
+    import subprocess
+    import sys
+
+    from conftest import REPO_ROOT, SRC_DIR
+
+    a, _b, _empty = logs
+    env = dict(os.environ)
+    env["PYTHONPATH"] = SRC_DIR
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    process = subprocess.Popen(
+        [sys.executable, "-B", "-m", "logredact", a],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        cwd=REPO_ROOT,
+        env=env,
+    )
+    try:
+        out, err = process.communicate(timeout=30)
+    except subprocess.TimeoutExpired:
+        process.kill()
+        process.communicate()
+        pytest.fail("the tool blocked on standard input despite a FILE argument")
+    assert process.returncode == 0
+    assert out == A_REDACTED
+    assert err == b""
+
+
+@pytest.mark.parametrize("position", ["before", "middle", "after"])
+def test_count_flag_position_does_not_change_stdout(logs, position):
+    """FR-012: ``--count`` is accepted in any position among the FILE arguments."""
+    a, b, _empty = logs
+    if position == "before":
+        args = ["--count", a, b]
+    elif position == "middle":
+        args = [a, "--count", b]
+    else:
+        args = [a, b, "--count"]
+    status, out, _err = run_cli(args)
+    assert status == 0
+    assert out == A_REDACTED + B_REDACTED
+
+
+def test_all_non_option_arguments_are_files_in_order(logs):
+    """FR-012: every non-option argument is a FILE path, in the order given."""
+    a, b, empty = logs
+    status, out, _err = run_cli([b, empty, a, b])
+    assert status == 0
+    assert out == B_REDACTED + A_REDACTED + B_REDACTED
+
+
+def test_non_utf8_bytes_round_trip_from_a_named_file(tmp_path):
+    """FR-017 across the file path as well as the stdin path."""
+    path = tmp_path / "mixed.log"
+    path.write_bytes(MIXED)
+    status, out, err = run_cli([str(path)])
+    assert status == 0
+    assert err == b""
+    assert out == MIXED_REDACTED
+    assert b"\xef\xbf\xbd" not in out
+
+
+def test_multi_line_file_preserves_line_order_and_terminators(tmp_path):
+    path = tmp_path / "many.log"
+    path.write_bytes(b"one a@b.io\r\ntwo 1.2.3.4\rthree plain\nfour 4111111111111111")
+    status, out, _err = run_cli([str(path)])
+    assert status == 0
+    assert out == b"one [EMAIL]\r\ntwo [IP]\rthree plain\nfour [CARD]"
diff --git a/tests/test_cli_stream.py b/tests/test_cli_stream.py
new file mode 100644
index 0000000..addfccc
--- /dev/null
+++ b/tests/test_cli_stream.py
@@ -0,0 +1,118 @@
+"""User Story 1 end to end: FR-001, FR-002 (stdin), FR-003, FR-011, SC-003.
+
+Every assertion here is on **raw bytes** from a real ``python -m logredact``
+subprocess, because FR-003, FR-017, and SR-002 are claims about bytes rather than
+about decoded text (research.md D-009).
+"""
+
+import os
+
+import pytest
+
+from conftest import REPO_ROOT, run_cli
+
+
+def test_package_lives_under_src_and_is_runnable():
+    """FR-001: ``python -m logredact`` with ``src/`` on the module search path."""
+    package = os.path.join(REPO_ROOT, "src", "logredact")
+    assert os.path.isdir(package)
+    for module in ("__init__.py", "__main__.py", "cli.py", "redact.py"):
+        assert os.path.isfile(os.path.join(package, module))
+    status, _out, _err = run_cli([], stdin_bytes=b"")
+    assert status == 0
+
+
+def test_stdin_is_read_when_no_file_argument():
+    """FR-002, US1-1: exact bytes out, status 0, stderr empty (FR-011)."""
+    status, out, err = run_cli([], stdin_bytes=b"user jane@example.com from 10.0.0.7\n")
+    assert status == 0
+    assert out == b"user [EMAIL] from [IP]\n"
+    assert err == b""
+
+
+def test_card_redacted_and_luhn_invalid_run_left_alone():
+    """US1-2."""
+    status, out, err = run_cli(
+        [], stdin_bytes=b"paid with 4111 1111 1111 1111, ref 1234567890123"
+    )
+    assert status == 0
+    assert out == b"paid with [CARD], ref 1234567890123"
+    assert err == b""
+
+
+@pytest.mark.parametrize(
+    ("stdin_bytes", "expected"),
+    [
+        (b"jane.doe+test@mail.example.com logged in\n", b"[EMAIL] logged in\n"),
+        (b"hit 999.1.1.1 today\n", b"hit 999.1.1.1 today\n"),
+        (b"a@1.2.3.4\n", b"a@[IP]\n"),
+        (b"4111 1111 1111 1111 1234\n", b"[CARD] 1234\n"),
+        (b"over 1.2.3.4.5 here\n", b"over 1.2.3.4.5 here\n"),
+        (b"zero 010.0.0.7 ok\n", b"zero [IP] ok\n"),
+        (b"4111-1111 1111-1111\n", b"[CARD]\n"),
+        (b"4111  1111 1111 1111\n", b"4111  1111 1111 1111\n"),
+        (b"12345678903@example.com\n", b"[EMAIL]\n"),
+    ],
+)
+def test_quickstart_scenario_one_table(stdin_bytes, expected):
+    status, out, err = run_cli([], stdin_bytes=stdin_bytes)
+    assert status == 0
+    assert out == expected
+    assert err == b""
+
+
+def test_line_with_nothing_redactable_is_byte_identical():
+    """US1-5, SC-003: original whitespace and punctuation preserved exactly."""
+    line = b"2026-11-21T10:00:00\tINFO  [worker-3]  done; 42% (ok!)\n"
+    status, out, err = run_cli([], stdin_bytes=line)
+    assert status == 0
+    assert out == line
+    assert err == b""
+
+
+def test_no_trailing_newline_is_added():
+    """US1-6: input whose final line lacks a terminator gains none."""
+    status, out, _err = run_cli([], stdin_bytes=b"no newline jane@example.com")
+    assert status == 0
+    assert out == b"no newline [EMAIL]"
+    assert out[-1:] != b"\n"
+    assert 0x0A not in out
+
+
+def test_crlf_and_lone_cr_terminators_are_preserved():
+    """FR-003: newline sequences are neither translated nor normalised."""
+    status, out, err = run_cli(
+        [], stdin_bytes=b"a@b.io\r\nnext 10.0.0.7\rlast\n"
+    )
+    assert status == 0
+    assert out == b"[EMAIL]\r\nnext [IP]\rlast\n"
+    assert err == b""
+
+
+def test_multiple_lines_appear_in_input_order():
+    """SC-003: every line appears in the output, in input order."""
+    status, out, err = run_cli(
+        [], stdin_bytes=b"one a@b.io\ntwo 1.2.3.4\nthree plain\n"
+    )
+    assert status == 0
+    assert out == b"one [EMAIL]\ntwo [IP]\nthree plain\n"
+    assert err == b""
+
+
+def test_empty_stdin_produces_empty_stdout():
+    status, out, err = run_cli([], stdin_bytes=b"")
+    assert status == 0
+    assert out == b""
+    assert err == b""
+
+
+def test_sensitive_values_are_absent_from_output_bytes():
+    """SC-001 / SR-002 at the byte level."""
+    status, out, _err = run_cli(
+        [],
+        stdin_bytes=b"jane@example.com 10.0.0.7 4111 1111 1111 1111\n",
+    )
+    assert status == 0
+    assert out == b"[EMAIL] [IP] [CARD]\n"
+    for leak in (b"jane", b"example.com", b"10.0.0", b"4111", b"1111"):
+        assert leak not in out
