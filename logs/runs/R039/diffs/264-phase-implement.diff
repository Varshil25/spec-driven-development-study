+"""``python -m logredact`` entry point.
+
+A thin shell and nothing else: importing this module executes it, so it holds no
+argument handling, no stream setup, and no logic. Tests import
+:mod:`logredact.cli` instead (plan.md Structure Decision).
+"""
+
+import sys
+
+from .cli import main
+
+sys.exit(main(sys.argv[1:]))
