@@ -0,0 +1,99 @@
+"""Shared helpers and sample constants for the logredact suite.
+
+Two test styles are used, as fixed by research.md D-009:
+
+``run_cli``
+    A subprocess run of the real ``python -m logredact`` entry point. It returns
+    **raw bytes** for stdout and stderr and never decodes them, because FR-003,
+    FR-017, and SR-002 are assertions about bytes.
+
+``call_main``
+    An in-process call to ``cli.main`` with injected stream objects. This is what
+    reaches the failure paths the environment cannot produce -- permission denied
+    as root, and an output write failure (research.md D-008).
+"""
+
+import io
+import os
+import subprocess
+import sys
+
+import pytest
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SRC_DIR = os.path.join(REPO_ROOT, "src")
+
+# Shared samples used across the suite. The gate in quickstart.md scans the
+# suite's own output for these, so they must never be echoed by a passing test
+# (SC-010).
+SAMPLE_EMAIL = "jane@example.com"
+SAMPLE_IP = "10.0.0.7"
+SAMPLE_CARD = "4111 1111 1111 1111"
+SAMPLE_CARD_DIGITS = "4111111111111111"
+SAMPLE_NOT_A_CARD = "1234567890123"  # 13 digits, Luhn fails
+
+EMAIL_PLACEHOLDER = "[EMAIL]"
+IP_PLACEHOLDER = "[IP]"
+CARD_PLACEHOLDER = "[CARD]"
+
+
+def run_cli(args, stdin_bytes=b"", cwd=None):
+    """Run ``python -B -m logredact`` as a subprocess.
+
+    Returns ``(status, stdout_bytes, stderr_bytes)``. ``-B`` plus
+    ``PYTHONDONTWRITEBYTECODE=1`` suppress CPython's own bytecode cache, so an
+    assertion about artifacts on disk is about the tool's behaviour rather than
+    the interpreter's (research.md D-009).
+    """
+    env = dict(os.environ)
+    env["PYTHONPATH"] = SRC_DIR
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    completed = subprocess.run(
+        [sys.executable, "-B", "-m", "logredact", *args],
+        input=stdin_bytes,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        cwd=cwd if cwd is not None else REPO_ROOT,
+        env=env,
+        timeout=120,
+    )
+    return completed.returncode, completed.stdout, completed.stderr
+
+
+def call_main(argv, stdin_text="", stdout=None, stderr=None):
+    """Call ``cli.main`` in process with injected streams.
+
+    Returns ``(status, stdout_text, stderr_text)``. When a caller supplies its
+    own ``stdout`` or ``stderr`` object, the text for that stream is returned as
+    ``None`` -- the caller owns it and knows how to inspect it.
+    """
+    from logredact import cli
+
+    out = io.StringIO() if stdout is None else stdout
+    err = io.StringIO() if stderr is None else stderr
+    status = cli.main(
+        argv,
+        stdin=io.StringIO(stdin_text),
+        stdout=out,
+        stderr=err,
+    )
+    return (
+        status,
+        out.getvalue() if stdout is None else None,
+        err.getvalue() if stderr is None else None,
+    )
+
+
+@pytest.fixture
+def write_log(tmp_path):
+    """Write ``content`` to ``name`` under a temporary directory; return its path."""
+
+    def _write(name, content):
+        path = tmp_path / name
+        if isinstance(content, bytes):
+            path.write_bytes(content)
+        else:
+            path.write_text(content, encoding="utf-8", newline="")
+        return str(path)
+
+    return _write
