+def test_broken_pipe_does_not_print_a_traceback_or_change_the_status():
+    """SR-009 / research.md D-006: the documented status survives a broken pipe.
+
+    ``head -1`` closes the pipe while the tool is still writing. Letting
+    ``BrokenPipeError`` propagate would print a stack trace and turn the status
+    into 120.
+    """
+    import subprocess
+
+    env = dict(os.environ)
+    env["PYTHONPATH"] = SRC_DIR
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    producer = subprocess.Popen(
+        [sys.executable, "-B", "-m", "logredact"],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        cwd=REPO_ROOT,
+        env=env,
+    )
+    # Many lines, so the writer is still going when the reader goes away.
+    payload = b"user jane@example.com from 10.0.0.7\n" * 200_000
+    producer.stdin.write(payload[:4096])
+    producer.stdin.flush()
+    producer.stdout.close()  # the reader disappears
+    try:
+        producer.stdin.write(payload)
+        producer.stdin.flush()
+        producer.stdin.close()
+    except (BrokenPipeError, OSError):
+        pass
+    _out, err = producer.communicate(timeout=60)
+    assert b"Traceback" not in err
+    assert b"Exception ignored" not in err
+    assert producer.returncode in (0, 2), producer.returncode
+
