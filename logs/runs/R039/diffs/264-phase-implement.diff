@@ -0,0 +1,214 @@
+"""User Story 3: the ``--count`` summary (FR-010 - FR-012, SR-003, SC-004, SC-005).
+
+With ``--count``, exactly one line ``emails=N ips=N cards=N`` is written to
+standard error after all redacted output has been written and flushed. Each ``N``
+is a total number of **replacements** across all input -- not lines affected, not
+files, not distinct values.
+"""
+
+import io
+
+import pytest
+
+from logredact import cli
+from conftest import run_cli
+
+NO_SUMMARY_KEY = b"emails="
+
+
+def test_summary_format_is_exact():
+    """SC-004: lowercase keys, single ``=``, single spaces, newline-terminated."""
+    status, out, err = run_cli(["--count"], stdin_bytes=b"a@b.io 1.2.3.4\n")
+    assert status == 0
+    assert out == b"[EMAIL] [IP]\n"
+    assert err == b"emails=1 ips=1 cards=0\n"
+
+
+def test_summary_counts_all_three_categories():
+    status, out, err = run_cli(
+        ["--count"], stdin_bytes=b"a@b.io 1.2.3.4 4111111111111111\n"
+    )
+    assert status == 0
+    assert out == b"[EMAIL] [IP] [CARD]\n"
+    assert err == b"emails=1 ips=1 cards=1\n"
+
+
+def test_zero_counts_when_nothing_is_redactable():
+    """US3-2: a run with no redactable values still reports all three zeros."""
+    status, out, err = run_cli(["--count"], stdin_bytes=b"nothing to see here\n")
+    assert status == 0
+    assert out == b"nothing to see here\n"
+    assert err == b"emails=0 ips=0 cards=0\n"
+
+
+def test_zero_counts_on_empty_input():
+    """US3-2: empty input is a successful run with a zero tally."""
+    status, out, err = run_cli(["--count"], stdin_bytes=b"")
+    assert status == 0
+    assert out == b""
+    assert err == b"emails=0 ips=0 cards=0\n"
+
+
+def test_repeated_value_counts_once_per_occurrence():
+    """US3-3: counts are replacements, not distinct values -- twice counts twice."""
+    status, out, err = run_cli(["--count"], stdin_bytes=b"a@b.io and a@b.io\n")
+    assert status == 0
+    assert out == b"[EMAIL] and [EMAIL]\n"
+    assert err == b"emails=2 ips=0 cards=0\n"
+
+
+def test_counts_are_totals_across_files_and_lines(tmp_path):
+    """FR-010: totals over all input, with multiple occurrences per line."""
+    first = tmp_path / "first.log"
+    first.write_bytes(
+        b"a@b.io c@d.io 1.2.3.4\n"
+        b"4111111111111111 4111 1111 1111 1111\n"
+    )
+    second = tmp_path / "second.log"
+    second.write_bytes(b"e@f.io 9.9.9.9 8.8.8.8\n")
+
+    status, out, err = run_cli(["--count", str(first), str(second)])
+    assert status == 0
+    # 3 emails, 3 IPv4 addresses, 2 cards -- replacements, not lines or files.
+    assert err == b"emails=3 ips=3 cards=2\n"
+    assert out == (
+        b"[EMAIL] [EMAIL] [IP]\n"
+        b"[CARD] [CARD]\n"
+        b"[EMAIL] [IP] [IP]\n"
+    )
+
+
+def test_counts_are_not_per_line_or_per_file(tmp_path):
+    """The same file twice doubles the tally, because it is read twice (US2-4)."""
+    path = tmp_path / "one.log"
+    path.write_bytes(b"a@b.io\n")
+    _status, _out, once = run_cli(["--count", str(path)])
+    _status, _out, twice = run_cli(["--count", str(path), str(path)])
+    assert once == b"emails=1 ips=0 cards=0\n"
+    assert twice == b"emails=2 ips=0 cards=0\n"
+
+
+def test_summary_never_appears_on_stdout():
+    """SC-005 / US3-4: the two streams stay separate."""
+    _status, out, err = run_cli(["--count"], stdin_bytes=b"a@b.io 1.2.3.4\n")
+    assert NO_SUMMARY_KEY not in out
+    assert b"ips=" not in out
+    assert b"cards=" not in out
+    # And the summary carries no log text.
+    assert b"[EMAIL]" not in err
+    assert b"[IP]" not in err
+
+
+def test_stderr_is_empty_without_the_flag():
+    """FR-011 / INV-7: a successful run without ``--count`` writes nothing to stderr."""
+    status, out, err = run_cli([], stdin_bytes=b"a@b.io 1.2.3.4\n")
+    assert status == 0
+    assert out == b"[EMAIL] [IP]\n"
+    assert err == b""
+
+
+@pytest.mark.parametrize(
+    "stdin_bytes",
+    [
+        b"a@b.io 1.2.3.4 4111111111111111\n",
+        b"nothing redactable at all\n",
+        b"",
+        b"no trailing newline a@b.io",
+        b"caf\xe9 a@b.io \xff\n",
+    ],
+)
+def test_stdout_is_byte_identical_with_and_without_the_flag(stdin_bytes):
+    """SR-003: ``--count`` affects only the summary, never the redaction."""
+    status_plain, out_plain, err_plain = run_cli([], stdin_bytes=stdin_bytes)
+    status_count, out_count, _err = run_cli(["--count"], stdin_bytes=stdin_bytes)
+    assert status_plain == status_count == 0
+    assert out_plain == out_count
+    assert err_plain == b""
+
+
+@pytest.mark.parametrize("position", ["before", "middle", "after"])
+def test_flag_position_does_not_change_stdout_or_counts(tmp_path, position):
+    """FR-012: ``--count`` is accepted in any position among the FILE arguments."""
+    first = tmp_path / "first.log"
+    first.write_bytes(b"a@b.io\n")
+    second = tmp_path / "second.log"
+    second.write_bytes(b"1.2.3.4\n")
+    a, b = str(first), str(second)
+    args = {
+        "before": ["--count", a, b],
+        "middle": [a, "--count", b],
+        "after": [a, b, "--count"],
+    }[position]
+
+    status, out, err = run_cli(args)
+    assert status == 0
+    assert out == b"[EMAIL]\n[IP]\n"
+    assert err == b"emails=1 ips=1 cards=0\n"
+
+
+class _Recorder:
+    """A text stream that records the order of ``write`` and ``flush`` calls.
+
+    Used to assert the ordering requirement in US3-4 -- that the summary is
+    written only after the redacted output has been written *and* flushed --
+    which a finished subprocess's captured bytes cannot show.
+    """
+
+    def __init__(self, label, log):
+        self.label = label
+        self.log = log
+
+    def write(self, text):
+        self.log.append((self.label, "write", text))
+        return len(text)
+
+    def flush(self):
+        self.log.append((self.label, "flush", None))
+
+
+def test_summary_is_written_after_stdout_is_written_and_flushed():
+    """US3-4 / FR-010: ordering, not just stream separation."""
+    log = []
+    out = _Recorder("stdout", log)
+    err = _Recorder("stderr", log)
+    status = cli.main(
+        ["--count"],
+        stdin=io.StringIO("a@b.io\n1.2.3.4\n"),
+        stdout=out,
+        stderr=err,
+    )
+    assert status == 0
+
+    labels = [entry[0] for entry in log]
+    summary_index = labels.index("stderr")
+    # Every stdout write happened before anything reached stderr.
+    assert all(label == "stdout" for label in labels[:summary_index])
+    assert "stdout" not in labels[summary_index:]
+    # A stdout flush happened before the summary was written.
+    assert ("stdout", "flush", None) in log[:summary_index]
+    # Exactly one stderr write, and it is the whole summary line.
+    stderr_writes = [entry for entry in log if entry[0] == "stderr" and entry[1] == "write"]
+    assert len(stderr_writes) == 1
+    assert stderr_writes[0][2] == "emails=1 ips=1 cards=0\n"
+
+
+def test_summary_is_a_single_line_with_no_padding():
+    """SC-004: no leading or trailing padding around the three fields."""
+    _status, _out, err = run_cli(["--count"], stdin_bytes=b"a@b.io\n")
+    text = err.decode("ascii")
+    assert text.count("\n") == 1
+    assert text.endswith("\n")
+    assert text == text.lstrip()
+    assert text[:-1] == text[:-1].strip()
+    assert "  " not in text
+
+
+def test_summary_carries_no_input_content():
+    """SR-001: three integers by construction -- no input text can reach stderr."""
+    _status, _out, err = run_cli(
+        ["--count"], stdin_bytes=b"secret-token user@corp.example 10.1.2.3\n"
+    )
+    assert err == b"emails=1 ips=1 cards=0\n"
+    assert b"secret-token" not in err
+    assert b"corp" not in err
+    assert b"10.1" not in err
