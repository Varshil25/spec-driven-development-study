new file mode 100644
index 0000000..85b9520
--- /dev/null
+++ b/tests/test_cli_errors.py
@@ -0,0 +1,244 @@
+"""User Story 4: unreadable input and bad usage fail loudly (FR-013, FR-014).
+
+Every case asserts **both** the exit status and the message content, which
+Constitution Principle III requires of a failure path. Also covered: SR-001 (no
+input content in any diagnostic), SR-009 (never a stack trace), SC-006 (no
+failure case exits 0), and US4-5 (no summary on a failing run).
+
+Permission-denied is reached by monkeypatching the ``cli`` module's ``open``
+rather than by ``chmod``: this environment runs as root, where ``chmod 000`` does
+not prevent reading, and Principle III forbids a uid-conditional ``skipif`` or
+``xfail`` (research.md D-008). The directory case exercises the real
+``except OSError`` path against the real filesystem on any uid.
+"""
+
+import builtins
+import io
+
+import pytest
+
+from logredact import cli
+from conftest import run_cli
+
+SENSITIVE = b"user jane@example.com from 10.0.0.7 card 4111 1111 1111 1111\n"
+REDACTED = b"user [EMAIL] from [IP] card [CARD]\n"
+
+
+def assert_clean_diagnostic(err_bytes, path):
+    """Shared assertions every diagnostic must satisfy."""
+    text = err_bytes.decode("utf-8", "surrogateescape")
+    # Names the problem, in terms the caller can act on (Principle II).
+    assert path in text
+    assert text.endswith("\n")
+    # SR-009: never a stack trace.
+    assert "Traceback" not in text
+    assert "File \"" not in text
+    assert "logredact/cli.py" not in text
+    # SR-001: no input content, matched value, or fragment of one.
+    for leak in ("jane", "example.com", "10.0.0", "4111", "1111"):
+        assert leak not in text
+
+
+def test_missing_path_is_reported_and_exits_two(tmp_path):
+    """US4-1 / FR-013."""
+    missing = str(tmp_path / "does-not-exist.log")
+    status, out, err = run_cli([missing])
+    assert status == 2
+    assert out == b""
+    assert_clean_diagnostic(err, missing)
+
+
+def test_directory_path_is_reported_and_exits_two(tmp_path):
+    """US4-3: the real ``IsADirectoryError`` path, reproducible on any uid."""
+    status, out, err = run_cli([str(tmp_path)])
+    assert status == 2
+    assert out == b""
+    assert_clean_diagnostic(err, str(tmp_path))
+
+
+def test_permission_denied_is_reported_and_exits_two(tmp_path, monkeypatch):
+    """US4-2: injected ``PermissionError``, deterministic as root (D-008)."""
+    path = tmp_path / "denied.log"
+    path.write_bytes(SENSITIVE)
+
+    def deny(*_args, **_kwargs):
+        raise PermissionError(13, "Permission denied")
+
+    monkeypatch.setattr(cli, "open", deny, raising=False)
+
+    err = io.StringIO()
+    out = io.StringIO()
+    status = cli.main([str(path)], stdin=io.StringIO(""), stdout=out, stderr=err)
+    assert status == 2
+    assert out.getvalue() == ""
+    assert_clean_diagnostic(err.getvalue().encode("utf-8"), str(path))
+
+
+def test_read_failure_after_a_successful_open_is_reported(tmp_path, monkeypatch):
+    """FR-013: the read loop is wrapped too, not only the open (SR-007 sibling)."""
+    path = tmp_path / "flaky.log"
+    path.write_bytes(SENSITIVE)
+
+    class Unreadable:
+        def readline(self, _limit=-1):
+            raise OSError(5, "Input/output error")
+
+        def close(self):
+            pass
+
+    monkeypatch.setattr(cli, "open", lambda *a, **k: Unreadable(), raising=False)
+
+    err = io.StringIO()
+    out = io.StringIO()
+    status = cli.main([str(path)], stdin=io.StringIO(""), stdout=out, stderr=err)
+    assert status == 2
+    assert_clean_diagnostic(err.getvalue().encode("utf-8"), str(path))
+
+
+def test_partial_output_is_kept_and_the_run_stops(tmp_path):
+    """US4-4: the readable file's output is already on stdout; exit 2."""
+    good = tmp_path / "good.log"
+    good.write_bytes(SENSITIVE)
+    missing = str(tmp_path / "missing.log")
+
+    status, out, err = run_cli([str(good), missing])
+    assert status == 2
+    # Output already written is kept, not discarded.
+    assert out == REDACTED
+    # The diagnostic names the *second* file.
+    assert_clean_diagnostic(err, missing)
+
+
+def test_a_file_after_the_failing_one_is_never_opened(tmp_path, monkeypatch):
+    """US4-4: processing stops at the first unreadable file."""
+    good = tmp_path / "good.log"
+    good.write_bytes(b"first a@b.io\n")
+    missing = str(tmp_path / "missing.log")
+    third = tmp_path / "third.log"
+    third.write_bytes(b"THIRD MUST NOT BE READ\n")
+
+    opened = []
+    real_open = builtins.open
+
+    def recording_open(path, *args, **kwargs):
+        opened.append(path)
+        return real_open(path, *args, **kwargs)
+
+    monkeypatch.setattr(cli, "open", recording_open, raising=False)
+
+    out = io.StringIO()
+    err = io.StringIO()
+    status = cli.main(
+        [str(good), missing, str(third)],
+        stdin=io.StringIO(""),
+        stdout=out,
+        stderr=err,
+    )
+    assert status == 2
+    assert opened == [str(good), missing]
+    assert str(third) not in opened
+    assert out.getvalue() == "first [EMAIL]\n"
+    assert "THIRD" not in out.getvalue()
+
+
+def test_unrecognised_option_prints_usage_and_exits_two():
+    """US4-6 / FR-014."""
+    status, out, err = run_cli(["--bogus"])
+    assert status == 2
+    assert out == b""
+    assert b"usage:" in err
+    assert b"--bogus" in err
+    assert b"Traceback" not in err
+
+
+def test_unrecognised_option_in_process_returns_two_without_raising():
+    """FR-014 / contracts/cli.md: ``main`` returns a status, never raises SystemExit.
+
+    argparse writes to the real ``sys`` streams by default, so this also pins
+    that its output is routed to the **injected** stderr.
+    """
+    out = io.StringIO()
+    err = io.StringIO()
+    status = cli.main(["--bogus"], stdin=io.StringIO(""), stdout=out, stderr=err)
+    assert status == 2
+    assert "usage:" in err.getvalue()
+    assert "--bogus" in err.getvalue()
+    assert out.getvalue() == ""
+
+
+def test_help_goes_to_stdout_and_exits_zero():
+    """contracts/cli.md Arguments: ``-h``/``--help`` is not a failure."""
+    for flag in ("-h", "--help"):
+        status, out, err = run_cli([flag])
+        assert status == 0
+        assert b"usage:" in out
+        assert b"--count" in out
+        assert err == b""
+
+
+def test_help_in_process_returns_zero_and_writes_to_injected_stdout():
+    out = io.StringIO()
+    err = io.StringIO()
+    status = cli.main(["--help"], stdin=io.StringIO(""), stdout=out, stderr=err)
+    assert status == 0
+    assert "usage:" in out.getvalue()
+    assert err.getvalue() == ""
+
+
+def test_no_summary_on_a_failing_run(tmp_path):
+    """US4-5: ``--count`` plus a failing path produces no tally at all."""
+    missing = str(tmp_path / "missing.log")
+    status, out, err = run_cli(["--count", missing])
+    assert status == 2
+    assert out == b""
+    assert b"emails=" not in err
+    assert b"ips=" not in err
+    assert b"cards=" not in err
+
+
+def test_no_summary_after_partial_output(tmp_path):
+    """US4-5: not even when some output succeeded first."""
+    good = tmp_path / "good.log"
+    good.write_bytes(SENSITIVE)
+    missing = str(tmp_path / "missing.log")
+    status, out, err = run_cli(["--count", str(good), missing])
+    assert status == 2
+    assert out == REDACTED
+    assert b"emails=" not in err
+
+
+@pytest.mark.parametrize("case", ["missing", "directory", "bad-option"])
+def test_no_failure_case_exits_zero(tmp_path, case):
+    """SC-006: failure is distinguishable from success by status alone."""
+    args = {
+        "missing": [str(tmp_path / "nope.log")],
+        "directory": [str(tmp_path)],
+        "bad-option": ["--bogus"],
+    }[case]
+    status, _out, err = run_cli(args)
+    assert status == 2
+    assert status != 0
+    assert err != b""
+    assert b"Traceback" not in err
+
+
+def test_dash_is_a_literal_path_not_a_stdin_alias():
+    """contracts/cli.md Arguments: ``-`` is an ordinary relative path."""
+    status, out, err = run_cli(["-"], stdin_bytes=SENSITIVE)
+    assert status == 2
+    assert out == b""
+    # It was treated as a path and failed per the error contract, and the piped
+    # text was never read.
+    assert b"-" in err
+    assert b"jane" not in err
+
+
+def test_diagnostic_names_only_the_callers_own_path(tmp_path):
+    """SR-001 / SR-009: the only input-derived string permitted is the path."""
+    sensitive_name = tmp_path / "missing.log"
+    status, _out, err = run_cli([str(sensitive_name)])
+    assert status == 2
+    text = err.decode()
+    assert str(sensitive_name) in text
+    # One line only.
+    assert text.count("\n") == 1
