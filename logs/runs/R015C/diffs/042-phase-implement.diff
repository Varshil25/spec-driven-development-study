+# --- creating archives -----------------------------------------------------
+
+
+class _Source(NamedTuple):
+    """One thing to put into a new archive."""
+
+    path: Path  # what to read from disk
+    arcname: str  # the member name it gets inside the archive
+
+
+def _arcname_for(path: str) -> str:
+    """Turn a command-line PATH into the member name it should be stored under.
+
+    Names are relative to the current directory, so ``./photos`` and ``photos/``
+    both become ``photos``. Anything that would not be a relative name inside the
+    archive (an absolute path, or one leading outside the current directory) is
+    rejected rather than silently rewritten.
+    """
+    if not path:
+        raise SourceError("'': not a path")
+    normalized = os.path.normpath(path)
+    escapes = normalized == ".." or normalized.startswith(".." + os.sep)
+    if os.path.isabs(normalized) or escapes:
+        raise SourceError(f"{path}: not a path relative to the current directory")
+    return PurePath(normalized).as_posix()
+
+
+def _scandir_sorted(directory: Path) -> List[os.DirEntry]:
+    """List *directory* in a stable order, so archives come out deterministic."""
+    try:
+        with os.scandir(directory) as entries:
+            return sorted(entries, key=lambda entry: entry.name)
+    except OSError as exc:
+        raise TarxError(f"{directory}: {exc.strerror or exc}") from None
+
+
+def _collect(paths: Iterable[os.PathLike | str], archive_real: str) -> List[_Source]:
+    """Resolve the PATHs into the members of a new archive, in order.
+
+    Every path is checked here, before the archive is written, so that a missing
+    path leaves no file behind. Directories are walked depth-first; the archive
+    being written is never put inside itself. A symlink named directly on the
+    command line is followed (the user asked for that file or directory by name);
+    symlinks found inside a directory are stored as symlinks instead, which is
+    what ``tar`` does and keeps the walk from leaving the tree or looping.
+    """
+    sources: List[_Source] = []
+    seen: set[str] = set()
+
+    def add(path: Path, arcname: str) -> bool:
+        if arcname in seen or os.path.realpath(path) == archive_real:
+            return False
+        seen.add(arcname)
+        sources.append(_Source(path, arcname))
+        return True
+
+    def walk(directory: Path, arcname: str) -> None:
+        for entry in _scandir_sorted(directory):
+            child = Path(entry.path)
+            child_arcname = f"{arcname}/{entry.name}"
+            if not entry.is_symlink() and entry.is_dir():
+                if add(child, child_arcname):
+                    walk(child, child_arcname)
+            else:
+                add(child, child_arcname)
+
+    for raw in paths:
+        given = os.fspath(raw)
+        arcname = _arcname_for(given)
+        # os.path.exists() follows symlinks, so a dangling one counts as missing.
+        if not os.path.exists(given):
+            raise SourceError(f"{given}: no such file or directory")
+        source = Path(os.path.realpath(given) if os.path.islink(given) else given)
+        if source.is_dir():
+            if add(source, arcname):
+                walk(source, arcname)
+        else:
+            add(source, arcname)
+
+    return sources
+
+
+def _write_mode(path: str) -> str:
+    """``w:gz`` for ``.tar.gz``/``.tgz`` names, plain ``w`` for anything else."""
+    return "w:gz" if path.lower().endswith((".tar.gz", ".tgz")) else "w"
+
+
+def _add_member(tar: tarfile.TarFile, source: _Source) -> int:
+    """Add one source to *tar*. Returns 1 for a regular file, 0 for anything else."""
+    try:
+        info = tar.gettarinfo(str(source.path), arcname=source.arcname)
+    except OSError as exc:
+        raise TarxError(f"{source.path}: {exc.strerror or exc}") from None
+    if info is None:
+        # A socket or similar: tar has no member type for it, so skip it.
+        return 0
+    try:
+        if info.isreg():
+            with open(source.path, "rb") as stream:
+                tar.addfile(info, stream)
+            return 1
+        tar.addfile(info)
+        return 0
+    except OSError as exc:
+        raise TarxError(f"{source.path}: {exc.strerror or exc}") from None
+    except tarfile.TarError as exc:
+        raise TarxError(f"{source.path}: {exc}") from None
+
+
+def create_archive(
+    archive: os.PathLike | str,
+    paths: Iterable[os.PathLike | str],
+    overwrite: bool = False,
+) -> int:
+    """Create a tar archive at *archive* holding each of *paths*.
+
+    Each path is a file or directory relative to the current directory, and is
+    stored under that relative name; a directory brings everything inside it.
+    The archive is gzip-compressed when its name ends in ``.tar.gz`` or ``.tgz``.
+    An existing archive is only replaced when *overwrite* is true. Returns the
+    number of regular files added.
+    """
+    path = os.fspath(archive)
+    archive_path = Path(path)
+
+    if os.path.lexists(archive_path):
+        if os.path.isdir(archive_path) and not os.path.islink(archive_path):
+            raise OverwriteError(f"{path}: exists as a directory, refusing to replace it")
+        if not overwrite:
+            raise OverwriteError(f"{path}: already exists (use --overwrite to replace it)")
+
+    sources = _collect(paths, os.path.realpath(archive_path))
+
+    # Build the archive beside its final name and move it into place at the end:
+    # a failure part-way through then leaves no half-written archive, and an
+    # archive being replaced is only replaced once the new one is complete.
+    parent = archive_path.parent
+    try:
+        handle, temporary = tempfile.mkstemp(
+            dir=parent, prefix=f".{archive_path.name}.", suffix=".part"
+        )
+    except OSError as exc:
+        raise TarxError(f"{path}: {exc.strerror or exc}") from None
+
+    added = 0
+    try:
+        with open(handle, "wb") as raw:
+            with tarfile.open(fileobj=raw, mode=_write_mode(path)) as tar:
+                for source in sources:
+                    added += _add_member(tar, source)
+        os.replace(temporary, archive_path)
+    except OSError as exc:  # no space left, unwritable directory, ...
+        _discard(temporary)
+        raise TarxError(f"{path}: {exc.strerror or exc}") from None
+    except tarfile.TarError as exc:  # pragma: no cover - defensive
+        _discard(temporary)
+        raise TarxError(f"{path}: {exc}") from None
+    except BaseException:
+        _discard(temporary)
+        raise
+    return added
+
+
+def _discard(temporary: str) -> None:
+    """Remove a half-written archive, so a failed create leaves nothing behind."""
+    with contextlib.suppress(OSError):
+        os.unlink(temporary)
