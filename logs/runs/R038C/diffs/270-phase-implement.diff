+"""FR-030, FR-031 and FR-040: the command surface this feature adds.
+
+Feature 001's ``tests/contract/test_cli_surface.py`` still owns the original five subcommands
+and is not edited (SC-011); this module covers the sixth and the third export format.
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from bookmarks import cli
+
+posix_only = pytest.mark.skipif(
+    os.name != "posix", reason="file mode bits are a POSIX concept (plan.md Target Platform)"
+)
+
+HEADER = "id,url,title,tags\n"
+
+
+# --- FR-030: the sixth subcommand ---------------------------------------------------------
+
+
+def test_sixth_subcommand_exists():
+    args = cli.build_parser().parse_args(["import", "f", "--format", "csv"])
+
+    assert args.command == "import"
+    assert args.file == "f"
+    assert args.fmt == "csv"
+    assert args.db == "bookmarks.db"
+
+
+def test_import_uses_global_db_option(run, tmp_path, write_file, stored_bookmarks):
+    """``--db`` precedes the command and is honoured exactly as for the other five (FR-030)."""
+    chosen = str(tmp_path / "chosen.db")
+    path = write_file("in.csv", HEADER + "1,https://a.example,Alpha,\n")
+
+    args = cli.build_parser().parse_args(["--db", chosen, "import", "f", "--format", "json"])
+    assert args.db == chosen
+
+    assert run("--db", chosen, "import", path, "--format", "csv")[:2] == (0, "imported 1\n")
+    assert stored_bookmarks(chosen) == [(1, "https://a.example", "Alpha")]
+    assert not os.path.exists(str(tmp_path / "bookmarks.db"))
+
+
+@posix_only
+def test_import_creates_missing_database(run, tmp_path, write_file):
+    """A successful import creates an absent database file at mode 0600 (FR-030, SR-005)."""
+    target = tmp_path / "fresh.db"
+    path = write_file("in.csv", HEADER + "1,https://a.example,Alpha,\n")
+    assert not target.exists()
+
+    assert run("--db", str(target), "import", path, "--format", "csv")[0] == 0
+
+    assert target.exists()
+    assert target.stat().st_mode & 0o777 == 0o600
+
+
+# --- FR-031: FILE and --format are both required, and nothing is inferred -----------------
+
+
+@pytest.mark.parametrize(
+    "argv",
+    (
+        ("import",),
+        ("import", "in.csv"),
+        ("import", "--format", "csv"),
+    ),
+    ids=("neither", "no format", "no file"),
+)
+def test_import_requires_file_and_format(argv, run, db):
+    status, out, err = run("--db", db, *argv)
+
+    assert status == 2
+    assert out == ""
+    assert len(err.splitlines()) == 1, err
+
+
+@pytest.mark.parametrize("fmt", ("html", "CSV", "JSON", "xml", "", "csv,json"))
+def test_import_rejects_other_formats(fmt, run, db, write_file):
+    path = write_file("in.csv", HEADER)
+
+    status, out, err = run("--db", db, "import", path, "--format", fmt)
+
+    assert status == 2, fmt
+    assert out == ""
+    assert len(err.splitlines()) == 1, err
+
+
+def test_format_is_not_inferred_from_extension(run, tmp_path, write_file, stored_bookmarks):
+    """The format comes from ``--format`` alone — never from the name or the content (FR-031)."""
+    misnamed = write_file(
+        "x.csv", '[{"url": "https://a.example", "title": "Alpha", "tags": []}]'
+    )
+
+    as_json = str(tmp_path / "as-json.db")
+    assert run("--db", as_json, "import", misnamed, "--format", "json")[:2] == (
+        0,
+        "imported 1\n",
+    )
+    assert stored_bookmarks(as_json) == [(1, "https://a.example", "Alpha")]
+
+    as_csv = str(tmp_path / "as-csv.db")
+    status, out, err = run("--db", as_csv, "import", misnamed, "--format", "csv")
+    assert (status, out) == (2, "")
+    assert len(err.splitlines()) == 1, err
+    assert stored_bookmarks(as_csv) == []
+
+    # And the other way round: a CSV document named .json is unreadable as JSON.
+    other = write_file("y.json", HEADER + "1,https://b.example,Beta,\n")
+    assert run("--db", str(tmp_path / "t.db"), "import", other, "--format", "json")[0] == 2
+    assert run("--db", str(tmp_path / "u.db"), "import", other, "--format", "csv")[0] == 0
+
+
+# --- FR-040: export now accepts three formats, and still only three -----------------------
+
+
+@pytest.mark.parametrize("fmt", ("csv", "json", "html"))
+def test_export_accepts_three_formats(fmt, run, db):
+    run("--db", db, "add", "https://a.example", "--title", "Alpha", "--tags", "x")
+
+    args = cli.build_parser().parse_args(["export", "--format", fmt])
+    assert args.fmt == fmt
+
+    status, out, err = run("--db", db, "export", "--format", fmt)
+
+    assert (status, err) == (0, "")
+    assert out != ""
+
+
+@pytest.mark.parametrize("fmt", ("HTML", "Html", "xml", "", "txt", "csv,json"))
+def test_export_rejects_other_formats(fmt, run, db):
+    status, out, err = run("--db", db, "export", "--format", fmt)
+
+    assert status == 2, fmt
+    assert out == ""
+    assert len(err.splitlines()) == 1, err
