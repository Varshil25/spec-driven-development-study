+def test_an_unusable_collection_is_status_one_not_two(run, tmp_path, write_file):
+    """The failure table's last row: a broken *collection* stays status 1 (FR-005, FR-039)."""
+    corrupt = tmp_path / "corrupt.db"
+    corrupt.write_bytes(b"not a database\n" * 64)
+    path = write_file("in.csv", HEADER + "1,https://a.example,Alpha,\n")
+
+    status, out, err = run("--db", str(corrupt), "import", path, "--format", "csv")
+
+    assert status == 1
+    assert out == ""
+    assert len(err.splitlines()) == 1, err
+
+
+def test_a_bad_input_file_beats_a_bad_collection(run, tmp_path):
+    """Where both are faulty the input file is diagnosed first, so status 2 wins."""
+    corrupt = tmp_path / "corrupt.db"
+    corrupt.write_bytes(b"not a database\n" * 64)
+    missing = str(tmp_path / "absent.csv")
+
+    status, out, err = run("--db", str(corrupt), "import", missing, "--format", "csv")
+
+    assert status == 2
+    assert err == f"cannot read {missing!r}: it is not a readable file\n"
