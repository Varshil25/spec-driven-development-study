+"""FR-038, FR-039 and SC-012: ``import``'s success output and its whole failure contract.
+
+``test_every_input_fault_exits_two_with_nothing_stored`` is parametrised over **every row** of
+the failure table in ``contracts/cli-contract.md``, so a new failure mode cannot be added to
+the implementation without a row here, and no documented row can quietly start returning 0.
+"""
+
+from __future__ import annotations
+
+import builtins
+import json
+import os
+
+import pytest
+
+HEADER = "id,url,title,tags\n"
+MAX_IMPORT_BYTES = 32 * 1024 * 1024
+
+
+# --- FR-038: success -----------------------------------------------------------------------
+
+
+def test_success_prints_only_the_count(run, db, write_file):
+    path = write_file(
+        "in.csv",
+        HEADER + "7,https://a.example,Alpha,\"x,y\"\n8,https://b.example,Beta,\n",
+    )
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert status == 0
+    assert out == "imported 2\n"
+    assert err == ""
+
+
+@pytest.mark.parametrize(
+    "fmt,text", (("csv", HEADER), ("json", "[]")), ids=("csv header alone", "empty json array")
+)
+def test_empty_input_is_success(
+    fmt, text, run, db, write_file, stored_bookmarks, stored_tag_links
+):
+    """US1 AS7: a file holding no bookmarks prints ``imported 0`` and changes nothing."""
+    run("--db", db, "add", "https://kept.example", "--title", "Kept", "--tags", "k")
+    before, before_tags = stored_bookmarks(db), stored_tag_links(db)
+    path = write_file(f"empty.{fmt}", text)
+
+    status, out, err = run("--db", db, "import", path, "--format", fmt)
+
+    assert status == 0
+    assert out == "imported 0\n"
+    assert err == ""
+    assert stored_bookmarks(db) == before
+    assert stored_tag_links(db) == before_tags
+
+
+# --- FR-039 / SC-012: every documented input fault -----------------------------------------
+#
+# Each builder returns (path, fmt, expected_stderr). ``None`` for the expected text means the
+# message is argparse's own, so only its shape is asserted.
+
+
+def _missing_path(tmp_path, write_file, monkeypatch):
+    path = str(tmp_path / "no-such-file.csv")
+    return path, "csv", f"cannot read {path!r}: it is not a readable file\n"
+
+
+def _directory(tmp_path, write_file, monkeypatch):
+    path = str(tmp_path)
+    return path, "csv", f"cannot read {path!r}: it is not a readable file\n"
+
+
+def _dangling_symlink(tmp_path, write_file, monkeypatch):
+    path = tmp_path / "dangling.csv"
+    os.symlink(str(tmp_path / "absent.csv"), str(path))
+    return str(path), "csv", f"cannot read {str(path)!r}: it is not a readable file\n"
+
+
+def _fifo(tmp_path, write_file, monkeypatch):
+    path = tmp_path / "pipe.csv"
+    os.mkfifo(str(path))
+    return str(path), "csv", f"cannot read {str(path)!r}: it is not a readable file\n"
+
+
+def _unreadable(tmp_path, write_file, monkeypatch):
+    """A file the process may not read.
+
+    The mode bits are set for realism, but the denial is also injected at ``open`` so the row
+    is exercised identically whether or not the suite happens to run as a superuser (a
+    superuser bypasses the mode bits, and SC-010 allows no conditional skip).
+    """
+    path = write_file("secret.csv", HEADER + "1,https://a.example,A,\n")
+    os.chmod(path, 0o400)
+    real_open = builtins.open
+
+    def denied(file, *args, **kwargs):
+        if file == path:
+            raise PermissionError(13, "Permission denied", path)
+        return real_open(file, *args, **kwargs)
+
+    monkeypatch.setattr(builtins, "open", denied)
+    return path, "csv", f"cannot read {path!r}: permission denied\n"
+
+
