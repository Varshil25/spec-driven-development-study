@@ -0,0 +1,134 @@
+"""FR-041, FR-042 and FR-044: the exact bytes of ``export --format html``.
+
+The page is a fixed eight-line skeleton with one ``<li>`` line per bookmark between ``<ul>``
+and ``</ul>``, in ascending identifier order. Nothing else is in the page: no CSS, no
+JavaScript, no heading, no identifier column, no counts, no external resource.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+
+import pytest
+
+PROLOGUE = (
+    "<!DOCTYPE html>",
+    "<html>",
+    '<head><meta charset="utf-8"><title>Bookmarks</title></head>',
+    "<body>",
+    "<ul>",
+)
+EPILOGUE = ("</ul>", "</body>", "</html>")
+
+
+@pytest.fixture
+def seeded(run, db):
+    """Three bookmarks: one with tags, one with neither title nor tags, one needing escapes."""
+    run("--db", db, "add", "https://docs.python.org", "--title", "Python docs", "--tags", "python,docs")
+    run("--db", db, "add", "https://example.com")
+    run(
+        "--db",
+        db,
+        "add",
+        'https://x.example/?a=1&b="2"',
+        "--title",
+        '<b>bold</b> & "quoted"',
+        "--tags",
+        "a<b,c&d",
+    )
+    return db
+
+
+def test_page_skeleton_is_exact(seeded, run):
+    """FR-041 / US2 AS1: the first five and last three lines, each newline-terminated."""
+    status, out, err = run("--db", seeded, "export", "--format", "html")
+
+    assert status == 0
+    assert err == ""
+    assert out.endswith("\n")
+    lines = out.split("\n")[:-1]  # the trailing "" after the final newline
+
+    assert tuple(lines[:5]) == PROLOGUE
+    assert tuple(lines[-3:]) == EPILOGUE
+
+    # Every line outside <ul>/</ul> is accounted for: there is nothing else in the page.
+    body = lines[5:-3]
+    assert body and all(line.startswith("<li><a href=") for line in body)
+    assert all(line.endswith("</li>") for line in body)
+
+
+def test_one_li_line_per_bookmark_in_id_order(run, db):
+    """FR-042: the count equals the bookmark count and the order is ascending by identifier."""
+    urls = [f"https://s{n}.example" for n in (5, 1, 9, 3)]
+    for n, url in enumerate(urls, 1):
+        run("--db", db, "add", url, "--title", f"T{n}")
+
+    out = run("--db", db, "export", "--format", "html")[1]
+    items = [line for line in out.splitlines() if line.startswith("<li>")]
+
+    assert len(items) == len(urls)
+    assert items == [
+        f'<li><a href="{url}">T{n}</a> <small></small></li>'
+        for n, url in enumerate(urls, 1)
+    ]
+
+
+def test_li_line_is_byte_exact(run, db):
+    """US2 AS2, byte-for-byte — note the single space between ``</a>`` and ``<small>``."""
+    run("--db", db, "add", "https://docs.python.org", "--title", "Python docs", "--tags", "python,docs")
+
+    out = run("--db", db, "export", "--format", "html")[1]
+
+    assert (
+        '<li><a href="https://docs.python.org">Python docs</a> <small>docs,python</small></li>\n'
+        in out
+    )
+
+
+def test_empty_title_and_tags_still_emit_a_line(run, db):
+    """US2 AS3: empty link text and an empty ``<small>``, and the line is still written."""
+    run("--db", db, "add", "https://example.com")
+
+    out = run("--db", db, "export", "--format", "html")[1]
+
+    assert '<li><a href="https://example.com"></a> <small></small></li>\n' in out
+    assert len([line for line in out.splitlines() if line.startswith("<li>")]) == 1
+
+
+def test_html_tags_match_csv_tags(seeded, run):
+    """FR-042: each ``<small>`` text is that bookmark's ``tags`` field from the CSV export."""
+    html = run("--db", seeded, "export", "--format", "html")[1]
+    csv_text = run("--db", seeded, "export", "--format", "csv")[1]
+
+    rows = list(csv.reader(io.StringIO(csv_text, newline="")))
+    assert rows[0] == ["id", "url", "title", "tags"]
+    csv_tags = [row[3] for row in rows[1:]]
+
+    items = [line for line in html.splitlines() if line.startswith("<li>")]
+    assert len(items) == len(csv_tags)
+
+    for item, tags in zip(items, csv_tags):
+        rendered = item.split("<small>")[1].split("</small>")[0]
+        # The HTML field is the CSV field, escaped for element text and nothing more.
+        expected = tags.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
+        assert rendered == expected
+
+
+def test_empty_collection_prints_bare_skeleton(run, db):
+    """FR-044 / US2 AS5: exactly the eight skeleton lines, status 0, stderr empty."""
+    status, out, err = run("--db", db, "export", "--format", "html")
+
+    assert status == 0
+    assert err == ""
+    assert out == "".join(f"{line}\n" for line in PROLOGUE + EPILOGUE)
+    assert len(out.splitlines()) == 8
+    assert "<li>" not in out
+
+
+def test_the_page_carries_no_styling_or_script(seeded, run):
+    """The spec's Assumptions: a plain page with no external resource of any kind."""
+    out = run("--db", seeded, "export", "--format", "html")[1]
+
+    for absent in ("<style", "<script", "<link", "<h1", "<table", "onclick", "src="):
+        assert absent not in out, absent
