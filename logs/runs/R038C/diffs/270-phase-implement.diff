+@pytest.mark.parametrize("build", FAULT_PARAMS)
+def test_every_input_fault_exits_two_with_nothing_stored(
+    build, run, tmp_path, write_file, monkeypatch, stored_bookmarks, stored_tag_links
+):
+    """FR-039, SC-012: status 2, empty stdout, one stderr line, and nothing stored."""
+    db = str(tmp_path / "target.db")
+    run("--db", db, "add", "https://kept.example", "--title", "Kept", "--tags", "k")
+    before, before_tags = stored_bookmarks(db), stored_tag_links(db)
+    assert before and before_tags
+
+    path, fmt, expected = build(tmp_path, write_file, monkeypatch)
+
+    status, out, err = run("--db", db, "import", path, "--format", fmt)
+
+    assert status == 2
+    assert out == ""
+    assert len(err.splitlines()) == 1, err
+    assert err == expected
+    assert stored_bookmarks(db) == before
+    assert stored_tag_links(db) == before_tags
+
