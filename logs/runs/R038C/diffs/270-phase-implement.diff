+    assert run("--db", db, "import", source, "--format", "json")[:2] == (0, "imported 2\n")
+
+    assert run("--db", db, "list")[1] == (
+        "1\thttps://a.example\tAlpha\tx,y\n2\thttps://b.example\tBeta\t\n"
+    )
+    assert run("--db", db, "search", "Beta")[1] == "2\thttps://b.example\tBeta\t\n"
+    assert run("--db", db, "list", "--tag", "x")[1] == "1\thttps://a.example\tAlpha\tx,y\n"
+    assert run("--db", db, "export", "--format", "csv")[1] == (
+        "id,url,title,tags\n"
+        '1,https://a.example,Alpha,"x,y"\n'
+        "2,https://b.example,Beta,\n"
+    )
+    assert run("--db", db, "add", "https://c.example")[:2] == (0, "3\n")
+    assert run("--db", db, "delete", "1") == (0, "", "")
+    assert run("--db", db, "list")[1] == (
+        "2\thttps://b.example\tBeta\t\n3\thttps://c.example\t\t\n"
+    )
diff --git a/tests/integration/test_performance_v2.py b/tests/integration/test_performance_v2.py
new file mode 100644
index 0000000..3e4a5b9
--- /dev/null
+++ b/tests/integration/test_performance_v2.py
@@ -0,0 +1,82 @@
+"""SC-013: HTML export of 10,000 bookmarks under a second; import of 10,000 under ten.
+
+Same discarding-sink style as feature 001's ``tests/integration/test_performance.py``, so what
+is measured is the command rather than the test's copy of its output.
+"""
+
+from __future__ import annotations
+
+import sys
+from time import perf_counter
+
+import pytest
+
+from bookmarks import cli
+
+COUNT = 10_000
+EXPORT_LIMIT_SECONDS = 1.0
+IMPORT_LIMIT_SECONDS = 10.0
+
+HEADER = "id,url,title,tags\n"
+
+
+class _DiscardingStream:
+    """Output is discarded so the measurement is the command, not the capture buffer."""
+
+    def write(self, text: str) -> int:
+        return len(text)
+
+    def flush(self) -> None:
+        pass
+
+
+@pytest.mark.slow
+def test_html_export_of_10k_under_one_second(tmp_path, bulk_seed, monkeypatch):
+    path = str(tmp_path / "big.db")
+    bulk_seed(path, COUNT)
+    monkeypatch.setattr(sys, "stdout", _DiscardingStream())
+
+    started = perf_counter()
+    status = cli.main(["--db", path, "export", "--format", "html"])
+    elapsed = perf_counter() - started
+
+    assert status == 0
+    assert elapsed < EXPORT_LIMIT_SECONDS, f"html export took {elapsed:.3f}s"
+
+
+@pytest.mark.slow
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_import_of_10k_under_ten_seconds(fmt, tmp_path, monkeypatch):
+    source = str(tmp_path / f"ten-thousand.{fmt}")
+    if fmt == "csv":
+        with open(source, "w", encoding="utf-8", newline="") as handle:
+            handle.write(HEADER)
+            for n in range(COUNT):
+                handle.write(f"{n},https://e.example/{n},Title {n},\"tag{n % 7},shared\"\n")
+    else:
+        import json
+
+        with open(source, "w", encoding="utf-8") as handle:
+            handle.write(
+                json.dumps(
+                    [
+                        {
+                            "url": f"https://e.example/{n}",
+                            "title": f"Title {n}",
+                            "tags": [f"tag{n % 7}", "shared"],
+                        }
+                        for n in range(COUNT)
+                    ]
+                )
+            )
+
+    db = str(tmp_path / f"target-{fmt}.db")
+    sink = _DiscardingStream()
+    monkeypatch.setattr(sys, "stdout", sink)
+
+    started = perf_counter()
+    status = cli.main(["--db", db, "import", source, "--format", fmt])
+    elapsed = perf_counter() - started
+
+    assert status == 0
+    assert elapsed < IMPORT_LIMIT_SECONDS, f"{fmt} import took {elapsed:.3f}s"
diff --git a/tests/integration/test_story5_import.py b/tests/integration/test_story5_import.py
new file mode 100644
index 0000000..7f9c954
--- /dev/null
+++ b/tests/integration/test_story5_import.py
@@ -0,0 +1,204 @@
+"""User Story 1, AS1–AS7 end to end: bringing an existing collection in from a file.
+
+FR-034 (file ids ignored), FR-036 (file order becomes identifier order) and FR-037 (existing
+bookmarks untouched, no deduplication).
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+HEADER = "id,url,title,tags\n"
+
+AS1_JSON = (
+    '[{"url": "https://docs.python.org", "title": "Python docs", "tags": ["python", "docs"]},'
+    ' {"url": "https://example.com", "title": "Example", "tags": []}]'
+)
+AS1_LISTING = (
+    "1\thttps://docs.python.org\tPython docs\tdocs,python\n"
+    "2\thttps://example.com\tExample\t\n"
+)
+
+
+def test_us1_as1_json_import_then_list(run, db, write_file):
+    """US1 AS1, byte-for-byte: ``imported 2``, then the two documented listing lines."""
+    path = write_file("in.json", AS1_JSON)
+
+    status, out, err = run("--db", db, "import", path, "--format", "json")
+
+    assert (status, out, err) == (0, "imported 2\n", "")
+    assert run("--db", db, "list") == (0, AS1_LISTING, "")
+
+
+def test_us1_as2_csv_import_then_list(run, db, write_file):
+    """US1 AS2: the same collection expressed as CSV lists identically."""
+    path = write_file(
+        "in.csv",
+        HEADER
+        + '1,https://docs.python.org,Python docs,"python,docs"\n'
+        + "2,https://example.com,Example,\n",
+    )
+
+    assert run("--db", db, "import", path, "--format", "csv")[:2] == (0, "imported 2\n")
+    assert run("--db", db, "list")[1] == AS1_LISTING
+
+
+# --- FR-034 / AS4: the file's own identifiers have no influence ----------------------------
+
+
+def test_file_ids_are_ignored(run, tmp_path, write_file, stored_bookmarks):
+    """A file with ids 7, 8, 9 imported into an empty collection produces 1, 2, 3."""
+    numbered = write_file(
+        "numbered.csv",
+        HEADER
+        + "7,https://a.example,Alpha,\n8,https://b.example,Beta,\n9,https://c.example,Gamma,\n",
+    )
+    first = str(tmp_path / "first.db")
+    assert run("--db", first, "import", numbered, "--format", "csv")[:2] == (0, "imported 3\n")
+    expected = [
+        (1, "https://a.example", "Alpha"),
+        (2, "https://b.example", "Beta"),
+        (3, "https://c.example", "Gamma"),
+    ]
+    assert stored_bookmarks(first) == expected
+
+    # An absent id field (CSV: empty; JSON: key omitted) and a non-numeric one import the same.
+    blank = write_file(
+        "blank.csv",
+        HEADER
+        + ",https://a.example,Alpha,\nnot-a-number,https://b.example,Beta,\n"
+        + '"7,8",https://c.example,Gamma,\n',
+    )
+    second = str(tmp_path / "second.db")
+    assert run("--db", second, "import", blank, "--format", "csv")[:2] == (0, "imported 3\n")
+    assert stored_bookmarks(second) == expected
+
+    as_json = write_file(
+        "ids.json",
+        json.dumps(
+            [
+                {"id": 7, "url": "https://a.example", "title": "Alpha", "tags": []},
+                {"id": "eight", "url": "https://b.example", "title": "Beta", "tags": []},
+                {"url": "https://c.example", "title": "Gamma", "tags": []},
+            ]
+        ),
+    )
+    third = str(tmp_path / "third.db")
+    assert run("--db", third, "import", as_json, "--format", "json")[:2] == (0, "imported 3\n")
+    assert stored_bookmarks(third) == expected
+
+
+# --- FR-036 / AS1, AS3: file order becomes identifier order --------------------------------
+
+
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_ids_follow_file_order(fmt, run, tmp_path, write_file, stored_bookmarks):
+    """Ascending identifier order reproduces file order, in both formats."""
+    urls = [f"https://s{n}.example" for n in (3, 1, 2)]
+    if fmt == "csv":
+        text = HEADER + "".join(f"{n},{url},T{n},\n" for n, url in enumerate(urls, 1))
+    else:
+        text = json.dumps([{"url": url, "title": f"T{n}", "tags": []} for n, url in enumerate(urls, 1)])
+    path = write_file(f"order.{fmt}", text)
+
+    empty = str(tmp_path / f"empty-{fmt}.db")
+    assert run("--db", empty, "import", path, "--format", fmt)[:2] == (0, "imported 3\n")
+    assert [row[1] for row in stored_bookmarks(empty)] == urls
+
+    # Into a collection already holding 1 and 2, the three records take 3, 4 and 5 in order.
+    seeded = str(tmp_path / f"seeded-{fmt}.db")
+    run("--db", seeded, "add", "https://first.example", "--title", "First")
+    run("--db", seeded, "add", "https://second.example", "--title", "Second")
+
+    assert run("--db", seeded, "import", path, "--format", fmt)[:2] == (0, "imported 3\n")
+    assert stored_bookmarks(seeded) == [
+        (1, "https://first.example", "First"),
+        (2, "https://second.example", "Second"),
+        (3, urls[0], "T1"),
+        (4, urls[1], "T2"),
+        (5, urls[2], "T3"),
+    ]
+
+
+# --- FR-037 / AS3: nothing existing is disturbed, and nothing is deduplicated --------------
+
+
+def test_existing_bookmarks_untouched(run, db, write_file, stored_bookmarks, stored_tag_links):
+    """Prior rows, titles and tag links are byte-identical after an import."""
+    run("--db", db, "add", "https://keep.example", "--title", "Keep", "--tags", "k,j")
+    run("--db", db, "add", "https://also.example", "--title", "Also", "--tags", "k")
+    before, before_tags = stored_bookmarks(db), stored_tag_links(db)
+
+    path = write_file("in.csv", HEADER + "1,https://new.example,New,n\n")
+    assert run("--db", db, "import", path, "--format", "csv")[:2] == (0, "imported 1\n")
+
+    after, after_tags = stored_bookmarks(db), stored_tag_links(db)
+    assert after[: len(before)] == before
+    assert after_tags[: len(before_tags)] == before_tags
+    assert after[len(before) :] == [(3, "https://new.example", "New")]
+
+
+def test_import_never_deduplicates(run, db, write_file, stored_bookmarks):
+    """A URL already stored, and a URL repeated inside the file, each add a new bookmark."""
+    run("--db", db, "add", "https://dup.example", "--title", "Original")
+
+    path = write_file(
+        "dup.csv",
+        HEADER + "1,https://dup.example,Again,\n2,https://dup.example,And again,\n",
+    )
+    assert run("--db", db, "import", path, "--format", "csv")[:2] == (0, "imported 2\n")
+
+    assert stored_bookmarks(db) == [
+        (1, "https://dup.example", "Original"),
+        (2, "https://dup.example", "Again"),
+        (3, "https://dup.example", "And again"),
+    ]
+
+    # Importing the same file a second time appends two more, never merging.
+    assert run("--db", db, "import", path, "--format", "csv")[:2] == (0, "imported 2\n")
+    assert len(stored_bookmarks(db)) == 5
+
+
+# --- AS5, AS6, AS7 at the story level ------------------------------------------------------
+
+
+def test_us1_as5_unreadable_path(run, db, tmp_path):
+    """US1 AS5: an unreadable path is an input failure that stores nothing."""
+    missing = str(tmp_path / "nope.csv")
+
+    status, out, err = run("--db", db, "import", missing, "--format", "csv")
+
+    assert (status, out) == (2, "")
+    assert len(err.splitlines()) == 1
+    assert run("--db", db, "list")[1] == ""
+
+
+def test_us1_as6_last_record_invalid_imports_nothing(
+    run, tmp_path, write_file, stored_bookmarks
+):
+    """US1 AS6: not one bookmark is added — and the database file is not even created."""
+    db = str(tmp_path / "atomic.db")
+    path = write_file(
+        "mixed.csv",
+        HEADER + "1,https://good.example,Good,\n2,ftp://bad.example,Bad,\n",
+    )
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert (status, out) == (2, "")
+    assert len(err.splitlines()) == 1
+    assert stored_bookmarks(db) == []
+    import os
+
+    assert not os.path.exists(db), "a rejected import must not create the collection"
+
+
+@pytest.mark.parametrize("fmt,text", (("csv", HEADER), ("json", "[]")))
+def test_us1_as7_empty_file_is_a_success(fmt, text, run, db, write_file):
+    """US1 AS7: a file holding no bookmarks is ``imported 0`` with status 0."""
+    path = write_file(f"empty.{fmt}", text)
+
+    assert run("--db", db, "import", path, "--format", fmt) == (0, "imported 0\n", "")
+    assert run("--db", db, "list")[1] == ""
diff --git a/tests/integration/test_story6_html_export.py b/tests/integration/test_story6_html_export.py
new file mode 100644
index 0000000..ef84c67
--- /dev/null
+++ b/tests/integration/test_story6_html_export.py
@@ -0,0 +1,143 @@
+"""User Story 2, AS1–AS5 end to end: reading the collection as a web page.
+
+Driven through the ``run`` fixture, exactly as a person would run the command and redirect the
+output to a file.
+"""
+
+from __future__ import annotations
+
+from html.parser import HTMLParser
+
+SKELETON = (
+    "<!DOCTYPE html>\n"
+    "<html>\n"
+    '<head><meta charset="utf-8"><title>Bookmarks</title></head>\n'
+    "<body>\n"
+    "<ul>\n"
+    "{items}"
+    "</ul>\n"
+    "</body>\n"
+    "</html>\n"
+)
+
+
+def test_as1_seeded_collection_exports_the_specified_page(run, db):
+    """US2 AS1 and AS2: the whole page, byte-for-byte, with status 0 and empty stderr."""
+    run(
+        "--db",
+        db,
+        "add",
+        "https://docs.python.org",
+        "--title",
+        "Python docs",
+        "--tags",
+        "python,docs",
+    )
+    run("--db", db, "add", "https://a.example", "--title", "Alpha", "--tags", "b,a")
+
+    status, out, err = run("--db", db, "export", "--format", "html")
+
+    assert (status, err) == (0, "")
+    assert out == SKELETON.format(
+        items=(
+            '<li><a href="https://docs.python.org">Python docs</a>'
+            " <small>docs,python</small></li>\n"
+            '<li><a href="https://a.example">Alpha</a> <small>a,b</small></li>\n'
+        )
+    )
+
+
+def test_as3_a_bookmark_with_no_title_and_no_tags_still_gets_its_line(run, db):
+    run("--db", db, "add", "https://b.example")
+
+    out = run("--db", db, "export", "--format", "html")[1]
+
+    assert out == SKELETON.format(
+        items='<li><a href="https://b.example"></a> <small></small></li>\n'
+    )
+
+
+def test_as4_escaped_characters_keep_the_page_well_formed(run, db):
+    """US2 AS4: ``<``, ``>``, ``&`` and ``"`` appear escaped, per context."""
+    run(
+        "--db",
+        db,
+        "add",
+        'https://x.example/?a=1&b="2"',
+        "--title",
+        '<script>alert(1)</script> & "quoted"',
+        "--tags",
+        "a<b,c&d",
+    )
+
+    status, out, err = run("--db", db, "export", "--format", "html")
+
+    assert (status, err) == (0, "")
+    assert out == SKELETON.format(
+        items=(
+            '<li><a href="https://x.example/?a=1&amp;b=&quot;2&quot;">'
+            '&lt;script&gt;alert(1)&lt;/script&gt; &amp; "quoted"</a>'
+            " <small>a&lt;b,c&amp;d</small></li>\n"
+        )
+    )
+
+    # And a standard parser recovers the originals (SC-014).
+    class _Reader(HTMLParser):
+        def __init__(self):
+            super().__init__(convert_charrefs=True)
+            self.href = None
+            self.text = ""
+            self.tags = ""
+            self.where = None
+
+        def handle_starttag(self, tag, attrs):
+            self.where = tag
+            if tag == "a":
+                self.href = dict(attrs).get("href")
+
+        def handle_endtag(self, tag):
+            self.where = None
+
+        def handle_data(self, data):
+            if self.where == "a":
+                self.text += data
+            elif self.where == "small":
+                self.tags += data
+
+    reader = _Reader()
+    reader.feed(out)
+    reader.close()
+
+    assert reader.href == 'https://x.example/?a=1&b="2"'
+    assert reader.text == '<script>alert(1)</script> & "quoted"'
+    assert reader.tags == "a<b,c&d"
+
+
+def test_as5_an_empty_collection_prints_the_bare_skeleton(run, db):
+    status, out, err = run("--db", db, "export", "--format", "html")
+
+    assert (status, out, err) == (0, SKELETON.format(items=""), "")
+
+
+def test_html_does_not_disturb_the_other_two_formats(run, db):
+    """US2 AS6 at the story level: csv and json are untouched by the new format existing."""
+    run("--db", db, "add", "https://a.example", "--title", "Alpha", "--tags", "x")
+
+    csv_before = run("--db", db, "export", "--format", "csv")[1]
+    run("--db", db, "export", "--format", "html")
+    assert run("--db", db, "export", "--format", "csv")[1] == csv_before
+    assert csv_before == "id,url,title,tags\n1,https://a.example,Alpha,x\n"
+    assert run("--db", db, "export", "--format", "json")[1] == (
+        '[{"id": 1, "url": "https://a.example", "title": "Alpha", "tags": ["x"]}]\n'
+    )
+
+
+def test_the_page_can_be_redirected_to_a_file_and_reread(run, db, tmp_path):
+    """The practical scenario: redirect to a file and open it — the bytes survive unchanged."""
+    run("--db", db, "add", "https://a.example", "--title", "Alpha", "--tags", "x")
+    page = run("--db", db, "export", "--format", "html")[1]
+
+    target = tmp_path / "page.html"
+    target.write_text(page, encoding="utf-8", newline="")
+
+    assert target.read_text(encoding="utf-8") == page
diff --git a/tests/integration/test_story7_roundtrip.py b/tests/integration/test_story7_roundtrip.py
new file mode 100644
index 0000000..e5093a7
--- /dev/null
+++ b/tests/integration/test_story7_roundtrip.py
@@ -0,0 +1,135 @@
+"""User Story 3, AS1–AS4: export and import are inverses (SC-008, SC-009).
+
+Comparisons drop the identifier, because identifiers are renumbered from 1 in the copy by
+design (FR-034) — everything else must match exactly, including titles holding commas, double
+quotes, newlines, tabs and non-ASCII text.
+
+A listing line cannot be split on ``\\n`` here (FR-009 stores a newline inside a title
+verbatim, so one bookmark can span two physical lines), so "the listing without the identifier
+column" is read from the stored rows instead, which is the same information without the
+ambiguity.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+AWKWARD = (
+    ("https://one.example", 'has, a comma and "quotes" and ünïcode', "z,a"),
+    ("https://two.example", "two\nlines", ""),
+    ("https://three.example", "a\ttab", "b,a,c"),
+    ("https://four.example", "", "solo"),
+    ("https://five.example/?a=1&b=2", "<tags> & ampersands", "a<b,c&d"),
+    ("https://six.example", "trailing space ", "  spaced  ,x"),
+    ("https://seven.example", "Ünïcode Ťitle 😀", "ünïcode,emoji"),
+)
+
+
+@pytest.fixture
+def content(stored_bookmarks, stored_tag_links):
+    """Return ``content(path) -> [(url, title, tags), ...]`` in identifier order, ids dropped."""
+
+    def _content(path: str) -> list[tuple]:
+        by_bookmark: dict[int, list[str]] = {}
+        for bookmark_id, tag in stored_tag_links(path):
+            by_bookmark.setdefault(bookmark_id, []).append(tag)
+        return [
+            (url, title, tuple(by_bookmark.get(bookmark_id, ())))
+            for bookmark_id, url, title in stored_bookmarks(path)
+        ]
+
+    return _content
+
+
+@pytest.fixture
+def source(run, tmp_path):
+    path = str(tmp_path / "source.db")
+    for url, title, tags in AWKWARD:
+        assert run("--db", path, "add", url, "--title", title, "--tags", tags)[0] == 0
+    return path
+
+
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_export_import_is_an_inverse(fmt, source, run, tmp_path, write_file, content):
+    """US3 AS1/AS2/AS3, SC-009: every URL, title and tag set survives, in the same order."""
+    status, exported, err = run("--db", source, "export", "--format", fmt)
+    assert (status, err) == (0, "")
+
+    round_trip = write_file(f"round.{fmt}", exported)
+    copy = str(tmp_path / f"copy-{fmt}.db")
+
+    assert run("--db", copy, "import", round_trip, "--format", fmt)[:2] == (
+        0,
+        f"imported {len(AWKWARD)}\n",
+    )
+
+    assert content(copy) == content(source)
+
+    # The copy re-exports to the same bytes as the original: the two halves agree exactly.
+    assert run("--db", copy, "export", "--format", fmt)[1] == exported
+
+
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_identifiers_are_renumbered_from_one_in_the_copy(
+    fmt, source, run, tmp_path, write_file, content, stored_bookmarks
+):
+    """US3 AS1: a gap in the source's identifiers closes up in the copy (FR-034)."""
+    assert run("--db", source, "delete", "3")[0] == 0
+    source_ids = [row[0] for row in stored_bookmarks(source)]
+    assert source_ids == [1, 2, 4, 5, 6, 7], "the source should now have a gap"
+
+    exported = run("--db", source, "export", "--format", fmt)[1]
+    copy = str(tmp_path / f"renumbered-{fmt}.db")
+    path = write_file(f"gap.{fmt}", exported)
+
+    assert run("--db", copy, "import", path, "--format", fmt)[:2] == (0, "imported 6\n")
+
+    assert [row[0] for row in stored_bookmarks(copy)] == [1, 2, 3, 4, 5, 6]
+    assert content(copy) == content(source)
+
+
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_a_newline_in_a_title_survives_the_round_trip(fmt, run, tmp_path, write_file):
+    """The quoting clause of FR-032, isolated: an embedded newline is data, not a row break."""
+    title = "line one\nline two\nline three"
+    source = str(tmp_path / "s.db")
+    run("--db", source, "add", "https://n.example", "--title", title, "--tags", "t")
+
+    exported = run("--db", source, "export", "--format", fmt)[1]
+    path = write_file(f"n.{fmt}", exported)
+    copy = str(tmp_path / "c.db")
+
+    assert run("--db", copy, "import", path, "--format", fmt)[:2] == (0, "imported 1\n")
+    assert run("--db", copy, "list")[1] == f"1\thttps://n.example\t{title}\tt\n"
+
+
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_empty_collection_round_trips(fmt, run, tmp_path, write_file):
+    """US3 AS4: exporting an empty collection and importing the result changes nothing."""
+    empty = str(tmp_path / "empty.db")
+    exported = run("--db", empty, "export", "--format", fmt)[1]
+
+    path = write_file(f"empty.{fmt}", exported)
+    target = str(tmp_path / f"target-{fmt}.db")
+
+    assert run("--db", target, "import", path, "--format", fmt) == (0, "imported 0\n", "")
+    assert run("--db", target, "list")[1] == ""
+
+
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_thousand_bookmarks_in_one_command(
+    fmt, run, tmp_path, write_file, bulk_seed, stored_bookmarks, content
+):
+    """SC-008: 1,000 bookmarks move in a single invocation, with an exact count."""
+    source = str(tmp_path / "thousand.db")
+    bulk_seed(source, 1000)
+
+    exported = run("--db", source, "export", "--format", fmt)[1]
+    path = write_file(f"thousand.{fmt}", exported)
+    target = str(tmp_path / f"target-{fmt}.db")
+
+    status, out, err = run("--db", target, "import", path, "--format", fmt)
+
+    assert (status, out, err) == (0, "imported 1000\n", "")
+    assert len(stored_bookmarks(target)) == 1000
+    assert content(target) == content(source)
diff --git a/tests/security/test_security_html_escaping.py b/tests/security/test_security_html_escaping.py
new file mode 100644
index 0000000..a3af816
--- /dev/null
+++ b/tests/security/test_security_html_escaping.py
@@ -0,0 +1,136 @@
+"""SR-012 and SC-014: stored data can never become markup, and a parser recovers it exactly.
+
+The second test is the strong one: rather than asserting the absence of particular dangerous
+substrings, it feeds the page to the standard library's own HTML parser and demands that every
+stored URL, title and tag string come back out unchanged, on the first attempt. Tests may
+import anything they like — only the shipped package is bound by the import whitelist.
+"""
+
+from __future__ import annotations
+
+from html.parser import HTMLParser
+
+import pytest
+
+HOSTILE = (
+    ("https://a.example", "<script>alert(1)</script>", "x"),
+    ("https://b.example", '" onmouseover=x', "y"),
+    ("https://c.example", "a & b", "a&b"),
+    ('https://d.example/?a="1"&b=<2>', "quoted url", "a<b,c&d"),
+    ("https://e.example", "</a></li></ul><h1>escaped?</h1>", "z"),
+    ("https://f.example", "&amp;&lt;already escaped&gt;", "&amp;"),
+    ("https://g.example", "ünïcode — em dash and \U0001f600", "ünïcode"),
+    ("https://h.example", "", ""),
+)
+
+
+@pytest.fixture
+def hostile_collection(run, db):
+    for url, title, tags in HOSTILE:
+        assert run("--db", db, "add", url, "--title", title, "--tags", tags)[0] == 0
+    return db
+
+
+def test_stored_data_cannot_become_markup(hostile_collection, run):
+    """No raw ``<script>``, and no ``"`` can break out of an ``href`` (SR-012)."""
+    status, page, err = run("--db", hostile_collection, "export", "--format", "html")
+
+    assert status == 0
+    assert err == ""
+
+    assert "<script>" not in page
+    assert "</script>" not in page
+    assert "<h1>" not in page
+
+    # The stored text ``" onmouseover=x`` *is* in the page -- it is a title, and a quote in
+    # element text needs no escape (FR-043). What must be impossible is that quote landing
+    # inside an attribute value, which is what the per-line check below establishes.
+    assert "onmouseover=x" in page
+
+    for line in page.splitlines():
+        if not line.startswith("<li>"):
+            continue
+        href_value = line.split('<li><a href="', 1)[1].split('"', 1)[0]
+        for attack in ("onmouseover", "onclick", "onerror", "javascript:"):
+            assert attack not in href_value, line
+        # The href value runs from the first quote after `href=` to the next quote, and no
+        # unescaped quote may appear inside it.
+        attribute = line.split('<li><a href="', 1)[1]
+        value, _, rest = attribute.partition('"')
+        # ``partition`` stops at the first quote; that it is immediately followed by ``>``
+        # proves the attribute was closed there, i.e. no stored quote appeared inside the
+        # value and nothing broke out of it. A quote in the *title* is element text and is
+        # deliberately left literal (FR-043), so the line's total quote count is not the test.
+        assert rest.startswith(">"), line
+        assert '"' not in value, line
+
+
+def test_the_li_lines_are_well_formed_whatever_is_stored(hostile_collection, run):
+    page = run("--db", hostile_collection, "export", "--format", "html")[1]
+    items = [line for line in page.splitlines() if line.startswith("<li>")]
+
+    assert len(items) == len(HOSTILE)
+    for line in items:
+        assert line.count("<li>") == line.count("</li>") == 1
+        assert line.count("<a href=") == line.count("</a>") == 1
+        assert line.count("<small>") == line.count("</small>") == 1
+
+
+class _Collector(HTMLParser):
+    """Collect (href, link text, small text) for every ``<li>`` of the page."""
+
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.items: list[list] = []
+        self._where: str | None = None
+
+    def handle_starttag(self, tag, attrs):
+        if tag == "li":
+            self.items.append([None, "", ""])
+        elif tag == "a":
+            self.items[-1][0] = dict(attrs).get("href")
+            self._where = "a"
+        elif tag == "small":
+            self._where = "small"
+
+    def handle_endtag(self, tag):
+        if tag in ("a", "small"):
+            self._where = None
+
+    def handle_data(self, data):
+        if self._where == "a":
+            self.items[-1][1] += data
+        elif self._where == "small":
+            self.items[-1][2] += data
+
+
+def test_html_parser_recovers_originals(hostile_collection, run):
+    """SC-014: ``html.parser`` recovers every stored value exactly, on the first attempt."""
+    page = run("--db", hostile_collection, "export", "--format", "html")[1]
+
+    parser = _Collector()
+    parser.feed(page)
+    parser.close()
+
+    assert len(parser.items) == len(HOSTILE)
+    for (url, title, tag_text), (href, text, small) in zip(HOSTILE, parser.items):
+        assert href == url, f"URL not recovered: {url!r} -> {href!r}"
+        assert text == title, f"title not recovered: {title!r} -> {text!r}"
+        expected_tags = ",".join(sorted({t.strip() for t in tag_text.split(",") if t.strip()}))
+        assert small == expected_tags, f"tags not recovered: {tag_text!r} -> {small!r}"
+
+
+def test_the_parser_round_trip_also_holds_for_a_title_with_a_newline(run, db):
+    """A stored newline puts a physical line break inside the link text, and still round-trips."""
+    title = "two\nlines"
+    run("--db", db, "add", "https://n.example", "--title", title, "--tags", "t")
+
+    page = run("--db", db, "export", "--format", "html")[1]
+    parser = _Collector()
+    parser.feed(page)
+    parser.close()
+
+    assert len(parser.items) == 1
+    assert parser.items[0][0] == "https://n.example"
+    assert parser.items[0][1] == title
+    assert parser.items[0][2] == "t"
diff --git a/tests/security/test_security_html_streaming.py b/tests/security/test_security_html_streaming.py
new file mode 100644
index 0000000..3cf51ea
--- /dev/null
+++ b/tests/security/test_security_html_streaming.py
@@ -0,0 +1,138 @@
+"""SR-019: HTML export streams, and import memory is bounded by its input, not the collection.
+
+The export half reuses feature 001's harness (``tests/security/test_security_streaming.py``)
+unchanged in shape: a discarding sink, ``tracemalloc`` around one in-process ``cli.main`` call,
+and the same ceiling.
+
+The import half is the different claim: ``import`` *does* materialise its input (research.md
+R8, plan.md Complexity Tracking), so what SR-019 requires -- and what is asserted here -- is
+that its peak does not grow with how many bookmarks the collection **already holds**.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+import tracemalloc
+
+import pytest
+
+from bookmarks import cli
+
+SMALL = 5_000
+LARGE = 50_000
+
+# The same ceiling feature 001 uses for a 50,000-bookmark export.
+PEAK_CEILING_BYTES = 2 * 1024 * 1024
+
+HEADER = "id,url,title,tags\n"
+
+
+class _DiscardingStream:
+    """A write-only sink: no buffer grows as the export streams through it."""
+
+    def __init__(self) -> None:
+        self.written = 0
+
+    def write(self, text: str) -> int:
+        self.written += len(text)
+        return len(text)
+
+    def flush(self) -> None:
+        pass
+
+
+def _peak(argv: list[str], monkeypatch) -> tuple[int, int]:
+    sink = _DiscardingStream()
+    monkeypatch.setattr(sys, "stdout", sink)
+    tracemalloc.start()
+    try:
+        status = cli.main(argv)
+        _, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+    assert status == 0, argv
+    return peak, sink.written
+
+
+@pytest.mark.slow
+def test_html_export_of_50k_is_memory_bounded(tmp_path, bulk_seed, monkeypatch):
+    small_path = str(tmp_path / "small.db")
+    large_path = str(tmp_path / "large.db")
+    bulk_seed(small_path, SMALL)
+    bulk_seed(large_path, LARGE)
+
+    small_peak, small_bytes = _peak(["--db", small_path, "export", "--format", "html"], monkeypatch)
+    large_peak, large_bytes = _peak(["--db", large_path, "export", "--format", "html"], monkeypatch)
+
+    # The output really did grow ten-fold ...
+    assert large_bytes > small_bytes * 8
+    # ... while the memory held to produce it did not grow with it.
+    assert large_peak < PEAK_CEILING_BYTES, f"peak {large_peak} bytes"
+    assert large_peak < small_peak * 2, f"{small_peak} -> {large_peak} bytes"
+
+
+def _write_records(path: str, fmt: str, count: int) -> None:
+    if fmt == "csv":
+        with open(path, "w", encoding="utf-8", newline="") as handle:
+            handle.write(HEADER)
+            for n in range(count):
+                handle.write(f"{n},https://i.example/{n},Title {n},tag{n % 7}\n")
+    else:
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write("[")
+            for n in range(count):
+                handle.write("," if n else "")
+                handle.write(
+                    json.dumps(
+                        {
+                            "url": f"https://i.example/{n}",
+                            "title": f"Title {n}",
+                            "tags": [f"tag{n % 7}"],
+                        }
+                    )
+                )
+            handle.write("]")
+
+
+@pytest.mark.slow
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_import_memory_does_not_grow_with_collection(fmt, tmp_path, bulk_seed, monkeypatch):
+    """The same 50,000-record file costs the same whether the target holds 0 or 50,000."""
+    source = str(tmp_path / f"records.{fmt}")
+    _write_records(source, fmt, LARGE)
+
+    into_empty = str(tmp_path / f"empty-{fmt}.db")
+    empty_peak, _ = _peak(["--db", into_empty, "import", source, "--format", fmt], monkeypatch)
+
+    into_full = str(tmp_path / f"full-{fmt}.db")
+    bulk_seed(into_full, LARGE)
+    full_peak, _ = _peak(["--db", into_full, "import", source, "--format", fmt], monkeypatch)
+
+    # The collection really was 50,000 bookmarks larger ...
+    assert len(open(source, encoding="utf-8").read()) > 0
+    # ... and the peak did not move with it.
+    assert full_peak < empty_peak * 2, f"{empty_peak} -> {full_peak} bytes"
+
+
+@pytest.mark.slow
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_import_peak_is_bounded_by_the_input_not_the_record_count_squared(
+    fmt, tmp_path, monkeypatch
+):
+    """Ten times the records costs on the order of ten times the memory, not more."""
+    small_source = str(tmp_path / f"small.{fmt}")
+    large_source = str(tmp_path / f"large.{fmt}")
+    _write_records(small_source, fmt, SMALL)
+    _write_records(large_source, fmt, LARGE)
+
+    small_peak, _ = _peak(
+        ["--db", str(tmp_path / f"s-{fmt}.db"), "import", small_source, "--format", fmt],
+        monkeypatch,
+    )
+    large_peak, _ = _peak(
+        ["--db", str(tmp_path / f"l-{fmt}.db"), "import", large_source, "--format", fmt],
+        monkeypatch,
+    )
+
+    assert large_peak < small_peak * 20, f"{small_peak} -> {large_peak} bytes"
diff --git a/tests/security/test_security_import_atomicity.py b/tests/security/test_security_import_atomicity.py
new file mode 100644
index 0000000..1d4f434
--- /dev/null
+++ b/tests/security/test_security_import_atomicity.py
@@ -0,0 +1,138 @@
+"""SR-015: an import commits as one unit or not at all.
+
+Two distinct mechanisms are under test, and both matter:
+
+* an **input** fault is decided before the collection is opened, so no write is attempted;
+* a **storage** fault happens inside one ``with connection:`` transaction, so ``sqlite3``
+  rolls every insert of the import back — including the ``AUTOINCREMENT`` high-water mark, so
+  the identifier the next successful ``add`` receives is unaffected (research.md R4).
+"""
+
+from __future__ import annotations
+
+import os
+
+from bookmarks import storage
+
+HEADER = "id,url,title,tags\n"
+
+
+def _hundred_records(last_url: str) -> str:
+    rows = [f"{n},https://e.example/{n},T{n},\"t{n},shared\"\n" for n in range(1, 100)]
+    rows.append(f"100,{last_url},Last,last\n")
+    return HEADER + "".join(rows)
+
+
+def test_last_record_invalid_adds_none_of_the_first_99(
+    run, tmp_path, write_file, database_fingerprint, stored_bookmarks, stored_tag_links
+):
+    """100 records whose last URL is invalid: zero new bookmark rows, zero new tag links."""
+    db = str(tmp_path / "atomic.db")
+    run("--db", db, "add", "https://kept.example", "--title", "Kept", "--tags", "k")
+    before, before_tags = stored_bookmarks(db), stored_tag_links(db)
+    before_print = database_fingerprint(db)
+
+    path = write_file("hundred.csv", _hundred_records("ftp://bad.example"))
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert (status, out) == (2, "")
+    assert err == (
+        "record 100: invalid URL: it must begin with the lowercase prefix "
+        "'http://' or 'https://'\n"
+    )
+    assert stored_bookmarks(db) == before
+    assert stored_tag_links(db) == before_tags
+    assert database_fingerprint(db) == before_print
+
+    # The same file with a valid last record imports all 100, so the file itself was fine.
+    good = write_file("hundred-good.csv", _hundred_records("https://good.example"))
+    assert run("--db", db, "import", good, "--format", "csv")[:2] == (0, "imported 100\n")
+    assert len(stored_bookmarks(db)) == len(before) + 100
+
+
+def test_storage_failure_mid_write_rolls_back(
+    run, tmp_path, write_file, monkeypatch, stored_bookmarks, stored_tag_links
+):
+    """An insert that raises part-way through leaves the collection byte-identical."""
+    db = str(tmp_path / "rollback.db")
+    run("--db", db, "add", "https://kept.example", "--title", "Kept", "--tags", "k")
+    before, before_tags = stored_bookmarks(db), stored_tag_links(db)
+
+    path = write_file(
+        "five.csv",
+        HEADER + "".join(f"{n},https://e.example/{n},T{n},t{n}\n" for n in range(1, 6)),
+    )
+
+    # The tag insert is pointed at a table that does not exist, so it raises *after* the
+    # first bookmark row has already been inserted inside the import's transaction — the
+    # same injection feature 001 uses for `add`.
+    monkeypatch.setattr(
+        storage,
+        "INSERT_TAG_SQL",
+        "INSERT INTO no_such_table(bookmark_id, tag) VALUES (?, ?)",
+    )
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert status == 1
+    assert out == ""
+    assert len(err.splitlines()) == 1, err
+    assert stored_bookmarks(db) == before, "a partial import survived the rollback"
+    assert stored_tag_links(db) == before_tags, "an orphan tag association survived"
+
+    monkeypatch.undo()
+
+    # And the collection is still usable afterwards.
+    assert run("--db", db, "import", path, "--format", "csv")[:2] == (0, "imported 5\n")
+
+
+def test_next_add_identifier_is_unaffected(run, tmp_path, write_file, stored_bookmarks):
+    """SR-015's last clause: the abandoned import does not consume identifiers."""
+    db = str(tmp_path / "ids.db")
+    assert run("--db", db, "add", "https://one.example", "--title", "One")[1] == "1\n"
+
+    # A failed import of five records: the first four are valid, the fifth is not.
+    rows = "".join(f"{n},https://e.example/{n},T{n},\n" for n in range(1, 5))
+    path = write_file("five.csv", HEADER + rows + "5,ftp://bad.example,Bad,\n")
+    assert run("--db", db, "import", path, "--format", "csv")[0] == 2
+
+    # The next add receives 2 — exactly what it would have received without the import.
+    assert run("--db", db, "add", "https://two.example", "--title", "Two")[1] == "2\n"
+    assert stored_bookmarks(db) == [
+        (1, "https://one.example", "One"),
+        (2, "https://two.example", "Two"),
+    ]
+
+
+def test_a_storage_failure_also_leaves_the_identifier_sequence_alone(
+    run, tmp_path, write_file, monkeypatch
+):
+    """The ``sqlite_sequence`` high-water mark rolls back with the data (research.md R4)."""
+    db = str(tmp_path / "seq.db")
+    assert run("--db", db, "add", "https://one.example")[1] == "1\n"
+
+    path = write_file(
+        "five.csv",
+        HEADER + "".join(f"{n},https://e.example/{n},T{n},t{n}\n" for n in range(1, 6)),
+    )
+    monkeypatch.setattr(
+        storage,
+        "INSERT_TAG_SQL",
+        "INSERT INTO no_such_table(bookmark_id, tag) VALUES (?, ?)",
+    )
+    assert run("--db", db, "import", path, "--format", "csv")[0] == 1
+    monkeypatch.undo()
+
+    assert run("--db", db, "add", "https://two.example")[1] == "2\n"
+
+
+def test_an_input_fault_never_creates_the_collection(run, tmp_path, write_file):
+    """SR-015 via R3: the database file is not even created when the input is rejected."""
+    db = str(tmp_path / "never.db")
+    path = write_file("bad.csv", "wrong,header,here,now\n")
+
+    assert run("--db", db, "import", path, "--format", "csv")[0] == 2
+
+    assert not os.path.exists(db)
+    assert sorted(os.listdir(tmp_path)) == ["bad.csv"]
diff --git a/tests/security/test_security_import_limits.py b/tests/security/test_security_import_limits.py
new file mode 100644
index 0000000..130e058
--- /dev/null
+++ b/tests/security/test_security_import_limits.py
@@ -0,0 +1,230 @@
+"""SR-014: every import input has an enforced maximum, and parsing never recurses unbounded.
+
+FILE at most 32 MiB, at most 50,000 records, and each record subject to the per-field limits
+of SR-006 — which are inherited by *calling* ``add``'s validators, not restated. Deeply nested
+JSON is a one-line rejection, not a ``RecursionError`` escaping to the user.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+
+import pytest
+
+from bookmarks import cli
+
+HEADER = "id,url,title,tags\n"
+
+MAX_IMPORT_BYTES = 32 * 1024 * 1024
+MAX_IMPORT_RECORDS = 50_000
+
+
+def test_the_limit_constants_are_the_documented_ones():
+    assert cli.MAX_IMPORT_BYTES == MAX_IMPORT_BYTES == 33_554_432
+    assert cli.MAX_IMPORT_RECORDS == MAX_IMPORT_RECORDS
+
+
+@pytest.mark.slow
+def test_file_one_byte_over_limit_rejected(run, tmp_path, stored_bookmarks):
+    """33,554,433 bytes is rejected — by one ``stat``, before a byte is read."""
+    path = str(tmp_path / "huge.csv")
+    size = MAX_IMPORT_BYTES + 1
+    with open(path, "wb") as handle:
+        handle.write(HEADER.encode("utf-8"))
+        handle.write(b"x" * (size - len(HEADER)))
+    assert os.path.getsize(path) == size
+    db = str(tmp_path / "lim.db")
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert (status, out) == (2, "")
+    assert err == (
+        f"{path!r} is too large to import: {size} bytes, "
+        f"at most {MAX_IMPORT_BYTES} allowed\n"
+    )
+    assert stored_bookmarks(db) == []
+
+
+@pytest.mark.slow
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_record_count_over_limit_rejected(fmt, run, tmp_path, stored_bookmarks):
+    """50,001 records is rejected; exactly 50,000 is accepted, so the bound is the documented one."""
+    db = str(tmp_path / "lim.db")
+
+    over = str(tmp_path / f"over.{fmt}")
+    _write_records(over, fmt, MAX_IMPORT_RECORDS + 1)
+
+    status, out, err = run("--db", db, "import", over, "--format", fmt)
+
+    assert (status, out) == (2, "")
+    assert err == f"too many bookmarks to import: at most {MAX_IMPORT_RECORDS} allowed\n"
+    assert stored_bookmarks(db) == []
+
+    at_limit = str(tmp_path / f"at.{fmt}")
+    _write_records(at_limit, fmt, MAX_IMPORT_RECORDS)
+    assert run("--db", db, "import", at_limit, "--format", fmt)[:2] == (
+        0,
+        f"imported {MAX_IMPORT_RECORDS}\n",
+    )
+
+
+def _write_records(path: str, fmt: str, count: int) -> None:
+    if fmt == "csv":
+        with open(path, "w", encoding="utf-8", newline="") as handle:
+            handle.write(HEADER)
+            for n in range(count):
+                handle.write(f"{n},https://e.example/{n},T{n},\n")
+    else:
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write("[")
+            for n in range(count):
+                handle.write("," if n else "")
+                handle.write(
+                    json.dumps({"url": f"https://e.example/{n}", "title": f"T{n}", "tags": []})
+                )
+            handle.write("]")
+
+
+# One character over each SR-006 per-field limit, with the message `add` itself gives.
+FIELD_LIMIT_CASES = {
+    "url 8193 characters": (
+        "https://e.example/" + "u" * (8193 - len("https://e.example/")),
+        "T",
+        "",
+        "record 1: URL is too long: 8193 characters, at most 8192 allowed\n",
+    ),
+    "title 4097 characters": (
+        "https://a.example",
+        "t" * 4097,
+        "",
+        "record 1: title is too long: 4097 characters, at most 4096 allowed\n",
+    ),
+    "tag text 4097 characters": (
+        "https://a.example",
+        "T",
+        "g" * 4097,
+        "record 1: tag list is too long: 4097 characters, at most 4096 allowed\n",
+    ),
+    "65 distinct tags": (
+        "https://a.example",
+        "T",
+        ",".join(f"t{n}" for n in range(65)),
+        "record 1: too many tags: 65, at most 64 allowed\n",
+    ),
+    "a 129-character tag": (
+        "https://a.example",
+        "T",
+        "g" * 129,
+        "record 1: tag is too long: 129 characters, at most 128 allowed\n",
+    ),
+}
+
+
+@pytest.mark.parametrize("name", list(FIELD_LIMIT_CASES))
+def test_each_field_limit_rejected_one_char_over(
+    name, run, db, write_file, stored_bookmarks, stored_tag_links
+):
+    url, title, tag_text, expected = FIELD_LIMIT_CASES[name]
+    path = write_file(
+        "over.json", json.dumps([{"url": url, "title": title, "tags": tag_text.split(",")}])
+    )
+
+    status, out, err = run("--db", db, "import", path, "--format", "json")
+
+    assert (status, out) == (2, ""), name
+    assert err == expected, name
+    assert stored_bookmarks(db) == []
+    assert stored_tag_links(db) == []
+
+
+@pytest.mark.parametrize("name", list(FIELD_LIMIT_CASES))
+def test_each_field_limit_accepts_exactly_the_limit(name, run, tmp_path, write_file):
+    """The counterpart: at the limit the record imports, so the bound is off-by-none."""
+    url, title, tag_text, _ = FIELD_LIMIT_CASES[name]
+    if name == "url 8193 characters":
+        url = url[:-1]
+    elif name == "title 4097 characters":
+        title = title[:-1]
+    elif name == "tag text 4097 characters":
+        # Exactly 4096 characters of tag text, while each tag stays within its own 128-character
+        # limit: 32 entries of 127 characters plus 31 commas is 4095, and one extra character
+        # on the last entry (making it 128) reaches 4096.
+        tag_text = ",".join(f"t{n:03d}" + "x" * 123 for n in range(32)) + "x"
+        assert len(tag_text) == 4096
+    elif name == "65 distinct tags":
+        tag_text = ",".join(f"t{n}" for n in range(64))
+    elif name == "a 129-character tag":
+        tag_text = "g" * 128
+
+    path = write_file(
+        "at.json", json.dumps([{"url": url, "title": title, "tags": tag_text.split(",")}])
+    )
+
+    assert run("--db", str(tmp_path / "at.db"), "import", path, "--format", "json")[:2] == (
+        0,
+        "imported 1\n",
+    )
+
+
+@pytest.mark.parametrize("field", (1, 2, 3))
+def test_a_field_beyond_the_csv_readers_own_limit_is_a_clean_rejection(
+    field, run, db, write_file, stored_bookmarks
+):
+    """A field over the ``csv`` module's 131,072-character field limit makes the reader itself
+    raise, which must still surface as one status-2 line rather than a traceback (SR-014,
+    SR-018). The file is well under the 32 MiB gate, so nothing earlier catches it.
+    """
+    giant = "x" * 200_000
+    row = ["1", "https://a.example", "Alpha", "t"]
+    row[field] = giant if field != 1 else "https://a.example/" + giant
+    path = write_file("giant.csv", "id,url,title,tags\n" + ",".join(row) + "\n")
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert (status, out) == (2, "")
+    assert len(err.splitlines()) == 1, err
+    lowered = err.lower()
+    for forbidden in ("traceback", "_csv", ".py", "line "):
+        assert forbidden not in lowered, err
+    assert stored_bookmarks(db) == []
+
+
+def test_a_giant_header_field_is_also_a_clean_rejection(run, db, write_file):
+    """The same hazard on the very first row, where the header is read."""
+    path = write_file("giant-header.csv", "id,url,title," + "t" * 200_000 + "\n")
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert (status, out) == (2, "")
+    assert len(err.splitlines()) == 1, err
+    assert "traceback" not in err.lower()
+
+
+def test_deeply_nested_json_rejected(run, db, write_file, stored_bookmarks):
+    """100,000 levels of nesting: one clean line, no ``RecursionError``, no traceback."""
+    path = write_file("deep.json", "[" * 100_000 + "]" * 100_000)
+
+    status, out, err = run("--db", db, "import", path, "--format", "json")
+
+    assert (status, out) == (2, "")
+    assert err == "invalid JSON: the document is nested too deeply\n"
+    assert len(err.splitlines()) == 1
+    lowered = err.lower()
+    for forbidden in ("traceback", "recursion", "maximum", ".py", "line "):
+        assert forbidden not in lowered, err
+    assert stored_bookmarks(db) == []
+
+
+def test_a_deeply_nested_but_shallow_enough_document_is_still_shape_checked(
+    run, db, write_file
+):
+    """Nesting that the parser tolerates is rejected by the shape rules, not accepted."""
+    path = write_file("nested.json", "[" * 20 + "]" * 20)
+
+    status, out, err = run("--db", db, "import", path, "--format", "json")
+
+    assert (status, out) == (2, "")
+    assert err == (
+        "invalid JSON: record 1 must be an object with 'url', 'title' and 'tags'\n"
+    )
diff --git a/tests/security/test_security_import_messages.py b/tests/security/test_security_import_messages.py
new file mode 100644
index 0000000..acff62e
--- /dev/null
+++ b/tests/security/test_security_import_messages.py
@@ -0,0 +1,220 @@
+"""SR-018: every expected failure of ``import`` is one clean, actionable line.
+
+The forbidden vocabulary is deliberately the same list feature 001's
+``test_security_no_traceback.py`` uses, so the new command is held to the identical standard —
+which is also why positions are reported as ``row N`` / ``record N`` and never ``line N``, and
+why paths are rendered with ``repr`` rather than as ``file "..."``.
+"""
+
+from __future__ import annotations
+
+import builtins
+
+import pytest
+
+SQL_TEXT = ("SELECT", "INSERT", "DELETE", "UPDATE", "PRAGMA", "FROM bookmarks", "VALUES (")
+INTERNALS = ("traceback", "sqlite", 'file "', "line ", ".py")
+
+HEADER = "id,url,title,tags\n"
+
+
+def _cases(tmp_path, write_file, run, monkeypatch):
+    """Build every documented failure, each as (name, argv, supplied_paths)."""
+    good = write_file("good.csv", HEADER + "1,https://a.example,Alpha,\n")
+
+    usable = str(tmp_path / "usable.db")
+    run("--db", usable, "add", "https://seed.example", "--title", "Seed")
+
+    corrupt = tmp_path / "corrupt.db"
+    corrupt.write_bytes(b"not a database\n" * 64)
+    missing_parent = str(tmp_path / "no-such-directory" / "x.db")
+
+    unreadable = write_file("denied.csv", HEADER)
+    real_open = builtins.open
+
+    def denied(file, *args, **kwargs):
+        if file == unreadable:
+            raise PermissionError(13, "Permission denied", unreadable)
+        return real_open(file, *args, **kwargs)
+
+    monkeypatch.setattr(builtins, "open", denied)
+
+    not_utf8 = write_file("bad.csv", b"\xff\xfe\xff")
+
+    def csv_file(name, text):
+        return write_file(name, text)
+
+    cases = [
+        # --- argument faults -------------------------------------------------------------
+        ("missing file argument", ("import", "--format", "csv"), ()),
+        ("missing format option", ("import", good), (good,)),
+        ("unsupported import format", ("import", good, "--format", "html"), (good,)),
+        # --- the file itself -------------------------------------------------------------
+        (
+            "path does not exist",
+            ("import", str(tmp_path / "absent.csv"), "--format", "csv"),
+            (str(tmp_path / "absent.csv"),),
+        ),
+        ("path is a directory", ("import", str(tmp_path), "--format", "csv"), (str(tmp_path),)),
+        ("path cannot be read", ("import", unreadable, "--format", "csv"), (unreadable,)),
+        (
+            "not valid utf-8",
+            ("import", not_utf8, "--format", "csv"),
+            (not_utf8,),
+        ),
+        # --- CSV shape -------------------------------------------------------------------
+        ("csv empty", ("import", csv_file("e.csv", ""), "--format", "csv"), ()),
+        (
+            "csv header wrong",
+            ("import", csv_file("h.csv", "a,b,c,d\n"), "--format", "csv"),
+            (),
+        ),
+        (
+            "csv field count",
+            ("import", csv_file("f.csv", HEADER + "1,https://a.example,A\n"), "--format", "csv"),
+            (),
+        ),
+        (
+            "csv blank row",
+            (
+                "import",
+                csv_file("b.csv", HEADER + "1,https://a.example,A,\n\n2,https://b.example,B,\n"),
+                "--format",
+                "csv",
+            ),
+            (),
+        ),
+        # --- JSON shape ------------------------------------------------------------------
+        ("json unparsable", ("import", csv_file("u.json", "{"), "--format", "json"), ()),
+        (
+            "json too deep",
+            ("import", csv_file("d.json", "[" * 100_000 + "]" * 100_000), "--format", "json"),
+            (),
+        ),
+        ("json not an array", ("import", csv_file("o.json", "{}"), "--format", "json"), ()),
+        (
+            "json element shape",
+            ("import", csv_file("s.json", "[1]"), "--format", "json"),
+            (),
+        ),
+        (
+            "json tags shape",
+            (
+                "import",
+                csv_file(
+                    "t.json", '[{"url": "https://a.example", "title": "A", "tags": "a"}]'
+                ),
+                "--format",
+                "json",
+            ),
+            (),
+        ),
+        # --- record content --------------------------------------------------------------
+        (
+            "record url rejected",
+            ("import", csv_file("r.csv", HEADER + "1,ftp://bad.example,A,\n"), "--format", "csv"),
+            (),
+        ),
+        (
+            "record field oversized",
+            (
+                "import",
+                csv_file("l.csv", HEADER + f"1,https://a.example,{'t' * 4097},\n"),
+                "--format",
+                "csv",
+            ),
+            (),
+        ),
+    ]
+
+    # --- the collection, which stays status 1 ---------------------------------------------
+    database_cases = [
+        ("unusable database", str(corrupt), ("import", good, "--format", "csv"), (good,)),
+        (
+            "missing parent directory",
+            missing_parent,
+            ("import", good, "--format", "csv"),
+            (good, missing_parent),
+        ),
+    ]
+    return usable, cases, database_cases
+
+
+def _assert_one_clean_line(err: str, supplied_paths) -> None:
+    assert len(err.splitlines()) == 1, err
+    assert err.endswith("\n")
+    assert err.strip() != ""
+    assert len(err.split()) >= 3, err
+
+    for keyword in SQL_TEXT:
+        assert keyword not in err, f"message contains SQL text {keyword!r}: {err!r}"
+
+    lowered = err.lower()
+    for internal in INTERNALS:
+        assert internal not in lowered, f"message discloses {internal!r}: {err!r}"
+
+    # The only absolute path allowed is one the invocation itself supplied.
+    for token in err.split():
+        bare = token.strip("'\"`,.:;()[]{}")
+        if bare.startswith("/"):
+            assert bare in supplied_paths, f"message leaks the path {bare!r}: {err!r}"
+
+
+CASE_NAMES = (
+    "missing file argument",
+    "missing format option",
+    "unsupported import format",
+    "path does not exist",
+    "path is a directory",
+    "path cannot be read",
+    "not valid utf-8",
+    "csv empty",
+    "csv header wrong",
+    "csv field count",
+    "csv blank row",
+    "json unparsable",
+    "json too deep",
+    "json not an array",
+    "json element shape",
+    "json tags shape",
+    "record url rejected",
+    "record field oversized",
+)
+
+DATABASE_CASE_NAMES = ("unusable database", "missing parent directory")
+
+
+@pytest.mark.parametrize("name", CASE_NAMES)
+def test_every_failure_is_one_clean_line(name, run, tmp_path, write_file, monkeypatch):
+    usable, cases, _ = _cases(tmp_path, write_file, run, monkeypatch)
+    by_name = {case[0]: case[1:] for case in cases}
+    assert set(by_name) == set(CASE_NAMES), "the case table and the id list have drifted"
+    argv, supplied = by_name[name]
+
+    status, out, err = run("--db", usable, *argv)
+
+    assert status == 2, name
+    assert out == ""
+    _assert_one_clean_line(err, set(supplied) | {usable})
+
+
+@pytest.mark.parametrize("name", DATABASE_CASE_NAMES)
+def test_a_broken_collection_is_also_one_clean_line(
+    name, run, tmp_path, write_file, monkeypatch
+):
+    """The two status-1 rows of the failure contract are held to the same standard."""
+    _, _, database_cases = _cases(tmp_path, write_file, run, monkeypatch)
+    by_name = {case[0]: case[1:] for case in database_cases}
+    db, argv, supplied = by_name[name]
+
+    status, out, err = run("--db", db, *argv)
+
+    assert status == 1, name
+    assert out == ""
+    _assert_one_clean_line(err, set(supplied) | {db})
+
+
+def test_the_successful_path_writes_nothing_to_stderr(run, db, write_file):
+    path = write_file("good.csv", HEADER + "1,https://a.example,Alpha,\n")
+
+    assert run("--db", db, "import", path, "--format", "csv") == (0, "imported 1\n", "")
diff --git a/tests/security/test_security_import_no_execution.py b/tests/security/test_security_import_no_execution.py
new file mode 100644
index 0000000..3220ead
--- /dev/null
+++ b/tests/security/test_security_import_no_execution.py
@@ -0,0 +1,145 @@
+"""SR-016: FILE's content is data, never code, a command, a template or a reference to follow.
+
+The file's fields are filled with the things that would matter if any of them were ever
+interpreted — shell metacharacters, a command substitution, a path-traversal sequence, a
+template expression and an unreachable URL — and every one must come back out of the
+collection as the literal text that went in.
+
+``socket`` and ``os.posix_spawn`` are replaced with functions that fail the test if they are
+called at all, so "no network access and no process spawned" is asserted rather than assumed.
+Tests may import whatever they like; only the shipped package is bound by the import whitelist.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import socket
+
+import pytest
+
+HEADER = "id,url,title,tags\n"
+
+# Values that must be stored verbatim. Each would have a visible effect if interpreted.
+HOSTILE_TITLES = (
+    "$(touch /tmp/pwned-by-import)",
+    "`id`",
+    "; rm -rf /",
+    "../../etc/passwd",
+    "{{7*7}}",
+    "${HOME}",
+    "<!--#exec cmd=\"id\"-->",
+)
+
+HOSTILE_URL = "http://127.0.0.1:1/unreachable"
+
+
+@pytest.fixture
+def no_processes_or_sockets(monkeypatch):
+    """Make any socket or process creation an immediate, attributable test failure."""
+    calls: list[str] = []
+
+    def refuse(name):
+        def _refuse(*args, **kwargs):
+            calls.append(name)
+            raise AssertionError(f"import called {name}")
+
+        return _refuse
+
+    monkeypatch.setattr(socket, "socket", refuse("socket.socket"))
+    monkeypatch.setattr(socket, "create_connection", refuse("socket.create_connection"))
+    monkeypatch.setattr(socket, "getaddrinfo", refuse("socket.getaddrinfo"))
+    if hasattr(os, "posix_spawn"):
+        monkeypatch.setattr(os, "posix_spawn", refuse("os.posix_spawn"))
+    monkeypatch.setattr(os, "system", refuse("os.system"))
+    return calls
+
+
+def _tree(root) -> set[str]:
+    return {str(path.relative_to(root)) for path in root.rglob("*")}
+
+
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_file_content_is_never_executed_or_fetched(
+    fmt,
+    run,
+    tmp_path,
+    write_file,
+    no_processes_or_sockets,
+    stored_bookmarks,
+    stored_tag_links,
+):
+    titles = list(HOSTILE_TITLES)
+    urls = [HOSTILE_URL] + [f"https://e.example/{n}" for n in range(1, len(titles))]
+    tag_texts = ["../../etc/passwd", "$(id)", "a;b", "{{x}}", "`y`", "${Z}", "a<b"]
+
+    if fmt == "csv":
+        import csv as _csv
+        import io
+
+        buffer = io.StringIO()
+        writer = _csv.writer(buffer, lineterminator="\n")
+        writer.writerow(("id", "url", "title", "tags"))
+        for n, (url, title, tags) in enumerate(zip(urls, titles, tag_texts), 1):
+            writer.writerow((n, url, title, tags))
+        text = buffer.getvalue()
+    else:
+        text = json.dumps(
+            [
+                {"url": url, "title": title, "tags": tags.split(",")}
+                for url, title, tags in zip(urls, titles, tag_texts)
+            ]
+        )
+
+    path = write_file(f"hostile.{fmt}", text)
+    db = str(tmp_path / "hostile.db")
+    before_tree = _tree(tmp_path)
+
+    status, out, err = run("--db", db, "import", path, "--format", fmt)
+
+    assert (status, out, err) == (0, f"imported {len(titles)}\n", "")
+    assert no_processes_or_sockets == [], no_processes_or_sockets
+
+    # 1. Every value is in the collection as literal text.
+    assert stored_bookmarks(db) == [
+        (n, url, title) for n, (url, title) in enumerate(zip(urls, titles), 1)
+    ]
+    stored = dict.fromkeys(tag for _, tag in stored_tag_links(db))
+    assert "../../etc/passwd" in stored
+    assert "$(id)" in stored
+
+    # 2. The command substitution did not run.
+    assert not os.path.exists("/tmp/pwned-by-import")
+
+    # 3. The traversal sequence was not resolved, and no file appeared anywhere under the
+    #    temporary tree other than the collection itself.
+    assert _tree(tmp_path) - before_tree == {"hostile.db"}
+
+
+def test_a_traversal_sequence_in_the_url_field_is_still_only_a_url(
+    run, db, write_file, no_processes_or_sockets, stored_bookmarks
+):
+    """``http://`` plus traversal is a URL string, not a path that gets opened."""
+    url = "http://127.0.0.1:1/../../../etc/passwd"
+    path = write_file("t.csv", HEADER + f"1,{url},Traversal,\n")
+
+    assert run("--db", db, "import", path, "--format", "csv")[:2] == (0, "imported 1\n")
+
+    assert stored_bookmarks(db) == [(1, url, "Traversal")]
+    assert no_processes_or_sockets == []
+
+
+def test_a_file_url_or_other_scheme_inside_the_file_is_rejected_not_followed(
+    run, db, write_file, no_processes_or_sockets
+):
+    """FR-008 is what keeps a ``file://`` reference out; it is never opened to find out."""
+    path = write_file("f.csv", HEADER + "1,file:///etc/passwd,Local,\n")
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert status == 2
+    assert err == (
+        "record 1: invalid URL: it must begin with the lowercase prefix "
+        "'http://' or 'https://'\n"
+    )
+    assert no_processes_or_sockets == []
diff --git a/tests/security/test_security_import_readonly.py b/tests/security/test_security_import_readonly.py
new file mode 100644
index 0000000..e3596ba
--- /dev/null
+++ b/tests/security/test_security_import_readonly.py
@@ -0,0 +1,123 @@
+"""SR-017: FILE is opened for reading only, and nothing else on the filesystem is touched.
+
+The collection deliberately lives in its own directory here, so "the database directory holds
+only the database file" is a real assertion rather than one confused by the import file sitting
+beside it.
+"""
+
+from __future__ import annotations
+
+import os
+import stat
+
+import pytest
+
+HEADER = "id,url,title,tags\n"
+
+GOOD = HEADER + "1,https://a.example,Alpha,\"x,y\"\n2,https://b.example,Beta,\n"
+BAD = HEADER + "1,https://a.example,Alpha,\n2,ftp://bad.example,Beta,\n"
+
+
+@pytest.mark.parametrize(
+    "content,expected_status", ((GOOD, 0), (BAD, 2)), ids=("successful", "failed")
+)
+def test_input_file_is_untouched(
+    content, expected_status, run, tmp_path, write_file, database_fingerprint
+):
+    """After a successful *and* after a failed import, FILE's bytes, size and mtime are equal."""
+    path = write_file("in.csv", content)
+    before = database_fingerprint(path)
+    assert before is not None
+
+    db_dir = tmp_path / "collection"
+    db_dir.mkdir()
+    db = str(db_dir / "bookmarks.db")
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert status == expected_status
+    assert database_fingerprint(path) == before, "the import file was modified"
+
+    # Reading it again gives the same bytes, so nothing was consumed or truncated either.
+    assert open(path, encoding="utf-8", newline="").read() == content
+
+
+@pytest.mark.parametrize(
+    "content,expected_status", ((GOOD, 0), (BAD, 2)), ids=("successful", "failed")
+)
+def test_no_extra_files_created(content, expected_status, run, tmp_path, write_file):
+    """The database's directory holds only the database file — no journal, temp file or copy."""
+    path = write_file("in.csv", content)
+    db_dir = tmp_path / "collection"
+    db_dir.mkdir()
+    db = str(db_dir / "bookmarks.db")
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+    assert status == expected_status
+
+    if expected_status == 0:
+        assert sorted(os.listdir(db_dir)) == ["bookmarks.db"]
+    else:
+        # A rejected import does not even create the collection (research.md R3).
+        assert sorted(os.listdir(db_dir)) == []
+
+    # And nothing was dropped beside the input file either.
+    assert sorted(os.listdir(tmp_path)) == ["collection", "in.csv"]
+
+
+def test_an_import_into_an_existing_collection_leaves_no_journal(run, tmp_path, write_file):
+    """The commit path is exercised against a pre-existing file, where a journal would appear."""
+    path = write_file("in.csv", GOOD)
+    db_dir = tmp_path / "collection"
+    db_dir.mkdir()
+    db = str(db_dir / "bookmarks.db")
+    run("--db", db, "add", "https://seed.example", "--title", "Seed", "--tags", "s")
+
+    assert run("--db", db, "import", path, "--format", "csv")[:2] == (0, "imported 2\n")
+
+    assert sorted(os.listdir(db_dir)) == ["bookmarks.db"]
+
+
+def test_a_file_in_a_read_only_directory_still_imports(run, tmp_path, stored_bookmarks):
+    """SR-017's counterpart: read-only access to FILE's directory is enough to import it."""
+    source_dir = tmp_path / "source"
+    source_dir.mkdir()
+    path = source_dir / "in.csv"
+    with open(path, "w", encoding="utf-8", newline="") as handle:
+        handle.write(GOOD)
+
+    original_mode = stat.S_IMODE(source_dir.stat().st_mode)
+    os.chmod(source_dir, 0o500)
+    try:
+        db = str(tmp_path / "ro.db")
+        assert run("--db", db, "import", str(path), "--format", "csv")[:2] == (
+            0,
+            "imported 2\n",
+        )
+        assert len(stored_bookmarks(db)) == 2
+        assert sorted(os.listdir(source_dir)) == ["in.csv"]
+    finally:
+        os.chmod(source_dir, original_mode)
+
+
+def test_the_input_file_is_never_opened_for_writing(run, tmp_path, write_file, monkeypatch):
+    """Belt and braces: every ``open`` of FILE during an import is a read-only one."""
+    import builtins
+
+    path = write_file("in.csv", GOOD)
+    real_open = builtins.open
+    modes: list[str] = []
+
+    def recording(file, mode="r", *args, **kwargs):
+        if file == path:
+            modes.append(mode)
+        return real_open(file, mode, *args, **kwargs)
+
+    monkeypatch.setattr(builtins, "open", recording)
+
+    assert run("--db", str(tmp_path / "rw.db"), "import", path, "--format", "csv")[0] == 0
+
+    assert modes, "the import never opened FILE at all"
+    for mode in modes:
+        assert mode in ("r", "rt", "rb"), mode
+        assert "w" not in mode and "a" not in mode and "+" not in mode and "x" not in mode
