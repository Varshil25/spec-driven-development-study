+def _escape_text(value: str) -> str:
+    """Escape a value destined for HTML element text: ``&``, ``<``, ``>`` (FR-043).
+
+    ``&`` **must** be replaced first, or the ``&`` of a ``&lt;`` produced a moment later would
+    itself be escaped into ``&amp;lt;``. A double quote needs no escape here -- it is only
+    dangerous inside an attribute value -- so a stored ``"`` stays literal, which is what
+    keeps US2 scenario 2's line byte-for-byte.
+
+    Deliberately not ``html.escape``: feature 001's
+    ``test_security_stdlib_only.py::test_whole_package_imports_only_these_standard_modules``
+    asserts the package's imports are within a whitelist that excludes ``html``, and SC-011
+    forbids editing that test (research.md R2, plan.md Complexity Tracking).
+    """
+    return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
