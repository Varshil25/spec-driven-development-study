index 0000000..e17bec1
--- /dev/null
+++ b/tests/security/test_security_import_shape.py
@@ -0,0 +1,107 @@
+"""SR-013: the import file is wholly untrusted and validated against the allowed shape.
+
+Allow-list, not deny-list: the CSV header must *equal* ``id,url,title,tags``, every data row
+must hold exactly four fields, and a JSON document must be an array of objects carrying
+``url``/``title``/``tags`` with the stated types. Nothing is coerced, defaulted or skipped.
+
+Each shape is checked twice: against a collection that already holds bookmarks, and against a
+database path that does not exist — which must still not exist afterwards.
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+HEADER = "id,url,title,tags\n"
+GOOD_ROW = "1,https://a.example,Alpha,x\n"
+
+# The 14 malformed shapes SR-013 names. Values are (format, content) where content is ``str``
+# for text input and ``bytes`` where the point of the case is the bytes themselves.
+MALFORMED_SHAPES = {
+    "wrong csv header": ("csv", "a,b,c,d\n" + GOOD_ROW),
+    "reordered csv header": ("csv", "url,id,title,tags\n" + GOOD_ROW),
+    "upper-case csv header": ("csv", "ID,URL,TITLE,TAGS\n" + GOOD_ROW),
+    "csv row of three fields": ("csv", HEADER + "1,https://a.example,Alpha\n"),
+    "csv row of five fields": ("csv", HEADER + "1,https://a.example,Alpha,x,extra\n"),
+    "blank row between data rows": (
+        "csv",
+        HEADER + GOOD_ROW + "\n" + "2,https://b.example,Beta,y\n",
+    ),
+    "top-level json object": (
+        "json",
+        '{"url": "https://a.example", "title": "Alpha", "tags": []}',
+    ),
+    "non-object array element": ("json", '["https://a.example"]'),
+    "missing title": ("json", '[{"url": "https://a.example", "tags": []}]'),
+    "tags as a string": (
+        "json",
+        '[{"url": "https://a.example", "title": "Alpha", "tags": "x,y"}]',
+    ),
+    "tags holding a number": (
+        "json",
+        '[{"url": "https://a.example", "title": "Alpha", "tags": [1]}]',
+    ),
+    "invalid utf-8 bytes": ("csv", HEADER.encode("utf-8") + b"1,https://a.example,\xff,\n"),
+    "utf-8 byte-order mark": ("csv", b"\xef\xbb\xbf" + HEADER.encode("utf-8") + GOOD_ROW.encode()),
+    "zero-byte file": ("csv", ""),
+}
+
+
+@pytest.mark.parametrize("name", list(MALFORMED_SHAPES))
+def test_malformed_shapes_are_rejected_with_nothing_stored(
+    name,
+    run,
+    tmp_path,
+    write_file,
+    database_fingerprint,
+    stored_bookmarks,
+    stored_tag_links,
+):
+    fmt, content = MALFORMED_SHAPES[name]
+    path = write_file(f"in.{fmt}", content)
+
+    # 1. Against a collection that already holds data: unchanged, bytes and mtime included.
+    existing = str(tmp_path / "existing.db")
+    run("--db", existing, "add", "https://kept.example", "--title", "Kept", "--tags", "k")
+    before = database_fingerprint(existing)
+    before_rows, before_tags = stored_bookmarks(existing), stored_tag_links(existing)
+    assert before is not None and before_rows and before_tags
+
+    status, out, err = run("--db", existing, "import", path, "--format", fmt)
+
+    assert status == 2, name
+    assert out == ""
+    assert len(err.splitlines()) == 1, err
+    assert stored_bookmarks(existing) == before_rows
+    assert stored_tag_links(existing) == before_tags
+    assert database_fingerprint(existing) == before, name
+
+    # 2. Against a database path that does not exist: it must still not exist.
+    absent = str(tmp_path / "absent.db")
+    assert database_fingerprint(absent) is None
+
+    status, out, err = run("--db", absent, "import", path, "--format", fmt)
+
+    assert status == 2, name
+    assert out == ""
+    assert len(err.splitlines()) == 1, err
+    assert database_fingerprint(absent) is None, name
+    assert not os.path.exists(absent)
+
+
+def test_the_corresponding_well_formed_shapes_are_accepted(run, tmp_path, write_file):
+    """The allow-list is not vacuous: the exact accepted shapes do import."""
+    good_csv = write_file("good.csv", HEADER + GOOD_ROW)
+    good_json = write_file(
+        "good.json", '[{"url": "https://a.example", "title": "Alpha", "tags": ["x"]}]'
+    )
+
+    assert run("--db", str(tmp_path / "c.db"), "import", good_csv, "--format", "csv")[:2] == (
+        0,
+        "imported 1\n",
+    )
+    assert run("--db", str(tmp_path / "j.db"), "import", good_json, "--format", "json")[
+        :2
+    ] == (0, "imported 1\n")
diff --git a/tests/unit/test_html_escaping.py b/tests/unit/test_html_escaping.py
new file mode 100644
index 0000000..7780af0
--- /dev/null
+++ b/tests/unit/test_html_escaping.py
@@ -0,0 +1,65 @@
+"""FR-043: per-context escaping of bookmark text placed into the HTML page.
+
+These functions are hand-rolled rather than ``html.escape`` because feature 001's import
+whitelist excludes ``html`` and SC-011 forbids editing that test (research.md R2). The one real
+hazard of hand-rolling is replacement order, and ``test_ampersand_is_escaped_first`` is the
+test that pins it.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from bookmarks import output
+
+
+def test_element_text_escapes_amp_lt_gt():
+    assert output._escape_text("&<>") == "&amp;&lt;&gt;"
+    assert output._escape_text("a & b < c > d") == "a &amp; b &lt; c &gt; d"
+    assert output._escape_text("<script>alert(1)</script>") == (
+        "&lt;script&gt;alert(1)&lt;/script&gt;"
+    )
+    # A double quote needs no escape in element text, and must be left exactly as stored.
+    assert output._escape_text('say "hi"') == 'say "hi"'
+
+
+def test_attribute_also_escapes_quote():
+    assert output._escape_attr('&<>"') == "&amp;&lt;&gt;&quot;"
+    assert output._escape_attr('https://x.example/?a=1&b="2"') == (
+        "https://x.example/?a=1&amp;b=&quot;2&quot;"
+    )
+    assert output._escape_attr('" onmouseover=x') == "&quot; onmouseover=x"
+
+
+def test_ampersand_is_escaped_first():
+    """The ordering hazard: ``&`` before ``<``, or ``&lt;`` would become ``&amp;lt;``."""
+    assert output._escape_text("&amp;") == "&amp;amp;"
+    assert output._escape_attr("&quot;") == "&amp;quot;"
+
+    for escape in (output._escape_text, output._escape_attr):
+        assert "&amp;lt;" not in escape("<")
+        assert escape("<") == "&lt;"
+        assert escape("&<") == "&amp;&lt;"
+        # Double-escaping is detectable in one direction only, which is why it is asserted
+        # from both ends: the result of escaping once must not contain a doubly-escaped form.
+        assert escape("&&") == "&amp;&amp;"
+
+
+@pytest.mark.parametrize(
+    "value",
+    (
+        "",
+        "Python docs",
+        "docs,python",
+        "https://docs.python.org",
+        "ünïcode and emoji \U0001f600",
+        "a tab\there",
+        "two\nlines",
+        "a'b",
+        "100% of 5 = 5",
+    ),
+)
+def test_unescapable_text_is_literal(value):
+    """Text holding none of the escapable characters is returned byte-for-byte (FR-043)."""
+    assert output._escape_text(value) == value
+    assert output._escape_attr(value) == value
diff --git a/tests/unit/test_import_records.py b/tests/unit/test_import_records.py
new file mode 100644
index 0000000..81bb248
--- /dev/null
+++ b/tests/unit/test_import_records.py
@@ -0,0 +1,296 @@
+"""FR-032, FR-033, FR-035: the shape rules and the record rules ``import`` enforces.
+
+Unit-level in intent — each test pins one parsing or validation rule — but driven through
+``cli.main`` via the ``run`` fixture, because a rule is only observable from outside as an exit
+status plus what did or did not reach the collection.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+
+import pytest
+
+HEADER = "id,url,title,tags\n"
+
+
+def _csv(*rows: tuple) -> str:
+    """Render a CSV document with the standard writer, so quoting matches what ``export`` writes."""
+    buffer = io.StringIO()
+    writer = csv.writer(buffer, lineterminator="\n")
+    writer.writerow(("id", "url", "title", "tags"))
+    for row in rows:
+        writer.writerow(row)
+    return buffer.getvalue()
+
+
+# --- FR-032: CSV shape --------------------------------------------------------------------
+
+
+BAD_CSV_SHAPES = {
+    "reordered header": "url,id,title,tags\n1,https://a.example,A,\n",
+    "re-cased header": "ID,URL,TITLE,TAGS\n1,https://a.example,A,\n",
+    "truncated header": "id,url,title\n1,https://a.example,A\n",
+    "extended header": "id,url,title,tags,extra\n1,https://a.example,A,,x\n",
+    "first row is data": "1,https://a.example,A,\n",
+    "three field row": HEADER + "1,https://a.example,A\n",
+    "five field row": HEADER + "1,https://a.example,A,,extra\n",
+}
+
+
+@pytest.mark.parametrize("name", list(BAD_CSV_SHAPES))
+def test_csv_header_and_four_fields_required(
+    name, run, db, write_file, stored_bookmarks
+):
+    """The header must be exactly ``id,url,title,tags`` and every data row exactly 4 fields."""
+    path = write_file("in.csv", BAD_CSV_SHAPES[name])
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert status == 2, name
+    assert out == ""
+    assert len(err.splitlines()) == 1, err
+    assert stored_bookmarks(db) == []
+
+
+def test_csv_header_alone_is_accepted(run, db, write_file):
+    """The counterpart: the exact header with no data rows is valid input (FR-038)."""
+    path = write_file("in.csv", HEADER)
+
+    assert run("--db", db, "import", path, "--format", "csv")[:2] == (0, "imported 0\n")
+
+
+def test_csv_quoting_round_trips(run, db, write_file, stored_bookmarks):
+    """A field holding a comma, a double quote and a newline is recovered unchanged."""
+    title = 'a, comma and "quotes"\nand a second physical line'
+    path = write_file("in.csv", _csv(("7", "https://a.example", title, "x")))
+
+    status, out, err = run("--db", db, "import", path, "--format", "csv")
+
+    assert (status, out, err) == (0, "imported 1\n", "")
+    assert stored_bookmarks(db) == [(1, "https://a.example", title)]
+
+
+def test_csv_tags_field_uses_add_rules(run, db, write_file, stored_tag_links):
+    """``"a,,b"`` in the tags field is the tag text ``add --tags`` would receive: tags a and b."""
+    path = write_file("in.csv", _csv(("1", "https://a.example", "A", "a,,b")))
+
+    assert run("--db", db, "import", path, "--format", "csv")[0] == 0
+    assert stored_tag_links(db) == [(1, "a"), (1, "b")]
+
+
+# --- FR-033: JSON shape -------------------------------------------------------------------
+
+
+NOT_AN_ARRAY = {
+    "object": '{"url": "https://a.example", "title": "A", "tags": []}',
+    "string": '"https://a.example"',
+    "number": "42",
+    "null": "null",
+    "true": "true",
+}
+
+NOT_AN_OBJECT_ELEMENT = {
+    "string element": '["https://a.example"]',
+    "number element": "[7]",
+    "null element": "[null]",
+    "array element": '[["https://a.example", "A", []]]',
+}
+
+
+@pytest.mark.parametrize("name", list(NOT_AN_ARRAY))
+def test_json_array_of_objects_required_top_level(name, run, db, write_file, stored_bookmarks):
+    path = write_file("in.json", NOT_AN_ARRAY[name])
+
+    status, out, err = run("--db", db, "import", path, "--format", "json")
+
+    assert (status, out) == (2, ""), name
+    assert err == "invalid JSON: the document must be an array of bookmark objects\n"
+    assert stored_bookmarks(db) == []
+
+
+@pytest.mark.parametrize("name", list(NOT_AN_OBJECT_ELEMENT))
+def test_json_array_of_objects_required(name, run, db, write_file, stored_bookmarks):
+    """An array element that is not an object is rejected (FR-033)."""
+    path = write_file("in.json", NOT_AN_OBJECT_ELEMENT[name])
+
+    status, out, err = run("--db", db, "import", path, "--format", "json")
+
+    assert (status, out) == (2, ""), name
+    assert err == (
+        "invalid JSON: record 1 must be an object with 'url', 'title' and 'tags'\n"
+    )
+    assert stored_bookmarks(db) == []
+
+
+BAD_JSON_RECORDS = {
+    "missing url": '[{"title": "A", "tags": []}]',
+    "missing title": '[{"url": "https://a.example", "tags": []}]',
+    "missing tags": '[{"url": "https://a.example", "title": "A"}]',
+    "url is a number": '[{"url": 42, "title": "A", "tags": []}]',
+    "url is a boolean": '[{"url": true, "title": "A", "tags": []}]',
+    "url is null": '[{"url": null, "title": "A", "tags": []}]',
+    "title is a number": '[{"url": "https://a.example", "title": 1, "tags": []}]',
+    "title is null": '[{"url": "https://a.example", "title": null, "tags": []}]',
+    "tags is a string": '[{"url": "https://a.example", "title": "A", "tags": "a,b"}]',
+    "tags is an object": '[{"url": "https://a.example", "title": "A", "tags": {"a": 1}}]',
+    "tags is null": '[{"url": "https://a.example", "title": "A", "tags": null}]',
+    "tags holds a number": '[{"url": "https://a.example", "title": "A", "tags": [1]}]',
+    "tags holds a boolean": '[{"url": "https://a.example", "title": "A", "tags": [true]}]',
+    "tags holds null": '[{"url": "https://a.example", "title": "A", "tags": [null]}]',
+    "tags holds an array": '[{"url": "https://a.example", "title": "A", "tags": [["a"]]}]',
+}
+
+
+@pytest.mark.parametrize("name", list(BAD_JSON_RECORDS))
+def test_json_requires_all_three_keys_with_types(
+    name, run, db, write_file, stored_bookmarks, stored_tag_links
+):
+    """Nothing is defaulted and nothing is coerced: each of these exits 2 (FR-033)."""
+    path = write_file("in.json", BAD_JSON_RECORDS[name])
+
+    status, out, err = run("--db", db, "import", path, "--format", "json")
+
+    assert (status, out) == (2, ""), name
+    assert len(err.splitlines()) == 1, err
+    assert err.startswith("invalid JSON: record 1 "), err
+    assert stored_bookmarks(db) == []
+    assert stored_tag_links(db) == []
+
+
+def test_json_extra_keys_ignored(run, db, write_file, stored_bookmarks, stored_tag_links):
+    """Any other key, ``id`` included, is silently discarded (FR-033, FR-034)."""
+    path = write_file(
+        "in.json",
+        '[{"id": 7, "colour": "red", "url": "https://a.example", "title": "Alpha",'
+        ' "tags": ["x"], "nested": {"deep": [1, 2]}}]',
+    )
+
+    status, out, err = run("--db", db, "import", path, "--format", "json")
+
+    assert (status, out, err) == (0, "imported 1\n", "")
+    assert stored_bookmarks(db) == [(1, "https://a.example", "Alpha")]
+    assert stored_tag_links(db) == [(1, "x")]
+
+
+# --- FR-035: a record is added exactly as `add` would add it -------------------------------
+
+
+RECORD_TRIPLES = (
+    ("https://a.example", "Alpha", "x,y"),
+    ("https://b.example", "", ""),
+    ("https://c.example", "has, a comma", "a,,b"),
+    ("https://d.example", 'has "quotes"', " a , b "),
+    ("https://e.example", "ünïcode and a\ttab", "a,a"),
+    ("https://f.example", "two\nlines", "z,a"),
+    ("https://g.example/?a=1&b=2", "<script>alert(1)</script>", "a<b"),
+)
+
+
+@pytest.mark.parametrize("triple", RECORD_TRIPLES, ids=[t[0] for t in RECORD_TRIPLES])
+def test_imported_record_matches_add_exactly(
+    triple, run, tmp_path, write_file, stored_bookmarks, stored_tag_links
+):
+    """The rows ``import`` writes equal the rows ``add`` writes for the same values (FR-035)."""
+    url, title, tag_text = triple
+
+    by_add = str(tmp_path / "by-add.db")
+    assert run("--db", by_add, "add", url, "--title", title, "--tags", tag_text)[0] == 0
+
+    by_csv = str(tmp_path / "by-csv.db")
+    csv_path = write_file("one.csv", _csv(("99", url, title, tag_text)))
+    assert run("--db", by_csv, "import", csv_path, "--format", "csv")[0] == 0
+
+    by_json = str(tmp_path / "by-json.db")
+    import json as _json
+
+    json_path = write_file(
+        "one.json",
+        _json.dumps(
+            [{"url": url, "title": title, "tags": tag_text.split(",")}], ensure_ascii=False
+        ),
+    )
+    assert run("--db", by_json, "import", json_path, "--format", "json")[0] == 0
+
+    assert stored_bookmarks(by_csv) == stored_bookmarks(by_add)
+    assert stored_tag_links(by_csv) == stored_tag_links(by_add)
+    assert stored_bookmarks(by_json) == stored_bookmarks(by_add)
+    assert stored_tag_links(by_json) == stored_tag_links(by_add)
+
+
+CSV_TAG_CASES = (
+    ("", ()),
+    (",", ()),
+    ("a,,b", ("a", "b")),
+    (" a , b ", ("a", "b")),
+    ("a,a", ("a",)),
+    ("b,a", ("a", "b")),
+    ("  ", ()),
+)
+
+JSON_TAG_CASES = (
+    ([], ()),
+    (["a", "a"], ("a",)),
+    ([" a ", "b "], ("a", "b")),
+    ([""], ()),
+    (["a,b"], ("a", "b")),
+    (["b", "a"], ("a", "b")),
+)
+
+
+@pytest.mark.parametrize("tag_text,expected", CSV_TAG_CASES, ids=[c[0] or "empty" for c in CSV_TAG_CASES])
+def test_degenerate_tag_values_csv(tag_text, expected, run, db, write_file, stored_tag_links):
+    """Degenerate tag text resolves exactly as ``parse_tags`` resolves it — never a rejection."""
+    path = write_file("in.csv", _csv(("1", "https://a.example", "A", tag_text)))
+
+    assert run("--db", db, "import", path, "--format", "csv")[:2] == (0, "imported 1\n")
+    assert stored_tag_links(db) == [(1, tag) for tag in sorted(expected)]
+
+
+@pytest.mark.parametrize(
+    "tags,expected", JSON_TAG_CASES, ids=[str(c[0]) for c in JSON_TAG_CASES]
+)
+def test_degenerate_tag_values(tags, expected, run, db, write_file, stored_tag_links):
+    """A JSON ``tags`` array is joined with commas and then parsed by ``add``'s rules."""
+    import json as _json
+
+    path = write_file(
+        "in.json", _json.dumps([{"url": "https://a.example", "title": "A", "tags": tags}])
+    )
+
+    assert run("--db", db, "import", path, "--format", "json")[:2] == (0, "imported 1\n")
+    assert stored_tag_links(db) == [(1, tag) for tag in sorted(expected)]
+
+
+BAD_URLS = ("ftp://example.com", "javascript:alert(1)", "HTTPS://example.com", "example.com", "")
+
+
+@pytest.mark.parametrize("url", BAD_URLS, ids=[u or "empty" for u in BAD_URLS])
+@pytest.mark.parametrize("fmt", ("csv", "json"))
+def test_invalid_url_fails_whole_import(
+    url, fmt, run, db, write_file, stored_bookmarks, stored_tag_links
+):
+    """A URL ``add`` would reject fails the whole import, with ``add``'s own wording (FR-035)."""
+    import json as _json
+
+    if fmt == "csv":
+        text = _csv(("1", "https://good.example", "Good", "g"), ("2", url, "Bad", ""))
+    else:
+        text = _json.dumps(
+            [
+                {"url": "https://good.example", "title": "Good", "tags": ["g"]},
+                {"url": url, "title": "Bad", "tags": []},
