+def test_feature_001_test_files_are_unmodified():
+    """SC-011: an edit to a feature-001 test module fails the suite rather than passing."""
+    actual = {}
+    for relative in sorted(FEATURE_001_DIGESTS):
+        path = TESTS_DIR / relative
+        assert path.is_file(), f"feature-001 test module {relative} is missing"
+        actual[relative] = hashlib.sha256(path.read_bytes()).hexdigest()
+
+    assert actual == FEATURE_001_DIGESTS
+
+    # And no 001 module was *removed* by renaming it out of the set: every test module under
+    # tests/ is either a recorded 001 module or a feature-002 addition.
+    present = {
+        str(path.relative_to(TESTS_DIR)) for path in TESTS_DIR.rglob("test_*.py")
+    }
+    assert set(FEATURE_001_DIGESTS) <= present
