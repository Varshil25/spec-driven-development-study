+"""The extraction round-trip and its failure contract.
+
+Covers FR-004, FR-005, FR-006, FR-007, FR-008, FR-013, FR-014, FR-018, FR-019,
+and SC-002.
+"""
+
+import pytest
+
+import helpers
+from conftest import PHOTOS
+
+
+def test_extract_gzip_round_trip(run_cli, photos_gz, tmp_path):
+    """FR-004, FR-005, FR-006: both files land with identical contents, stdout is
+    exactly the success line, exit 0 (SC-002)."""
+    dest = tmp_path / "out"
+    result = run_cli(["extract", str(photos_gz), str(dest)])
+    assert result.status == 0
+    assert result.stdout == "extracted 2 files\n"
+    assert result.stderr == ""
+    for name, data in PHOTOS.items():
+        assert (dest / name).read_bytes() == data
+
+
+def test_extract_plain_round_trip(run_cli, photos_tar, tmp_path):
+    """FR-004, FR-005, FR-008: an uncompressed archive round-trips identically."""
+    dest = tmp_path / "out"
+    result = run_cli(["extract", str(photos_tar), str(dest)])
+    assert result.status == 0
+    assert result.stdout == "extracted 2 files\n"
+    for name, data in PHOTOS.items():
+        assert (dest / name).read_bytes() == data
+
+
+def test_extract_nested_directories_and_zero_byte_member(run_cli, tmp_path):
+    """FR-004, FR-019: directories are created, a zero-byte file is zero bytes,
+    and the count excludes directories."""
+    archive = helpers.write_archive(
+        tmp_path / "nested.tar",
+        [
+            helpers.dir_member("top/"),
+            helpers.dir_member("top/mid/"),
+            helpers.dir_member("top/mid/deep/"),
+            helpers.file_member("top/mid/deep/empty.bin", b""),
+            helpers.file_member("top/mid/payload.bin", b"payload"),
+        ],
+    )
+    dest = tmp_path / "out"
+    result = run_cli(["extract", str(archive), str(dest)])
+    assert result.status == 0
+    assert result.stdout == "extracted 2 files\n"
+    assert (dest / "top/mid/deep").is_dir()
+    assert (dest / "top/mid/deep/empty.bin").read_bytes() == b""
+    assert (dest / "top/mid/deep/empty.bin").stat().st_size == 0
+    assert (dest / "top/mid/payload.bin").read_bytes() == b"payload"
+
+
+def test_extract_creates_missing_dest_and_parents(run_cli, photos_gz, tmp_path):
+    """FR-007: a destination that does not exist, including missing parents, is
+    created."""
+    dest = tmp_path / "a" / "b" / "c" / "out"
+    result = run_cli(["extract", str(photos_gz), str(dest)])
+    assert result.status == 0
+    assert dest.is_dir()
+    assert (dest / "photos/a.jpg").read_bytes() == PHOTOS["photos/a.jpg"]
+
+
+def test_extract_empty_archive_creates_dest_and_counts_zero(
+    run_cli, empty_archive, tmp_path
+):
+    """FR-018, FR-006: an empty archive is a plain success — DEST is created and
+    ``extracted 0 files`` is printed."""
+    dest = tmp_path / "out"
+    result = run_cli(["extract", str(empty_archive), str(dest)])
+    assert result.status == 0
+    assert result.stdout == "extracted 0 files\n"
+    assert dest.is_dir()
+    assert list(dest.iterdir()) == []
+
+
+def test_extract_single_file_is_not_pluralised(run_cli, tmp_path):
+    """FR-006: the success line is ``extracted 1 files`` — no pluralisation."""
+    archive = helpers.build_files(tmp_path / "one.tar", {"only.txt": b"solo"})
+    result = run_cli(["extract", str(archive), str(tmp_path / "out")])
+    assert result.status == 0
+    assert result.stdout == "extracted 1 files\n"
+
+
+def test_extract_gzip_archive_misnamed_tar(run_cli, tmp_path):
+    """FR-008: the format comes from the content, so a gzip archive named
+    ``.tar`` still extracts."""
+    archive = helpers.build_files(
+        tmp_path / "misnamed.tar", {"a.txt": b"alpha"}, compressed=True
+    )
+    result = run_cli(["extract", str(archive), str(tmp_path / "out")])
+    assert result.status == 0
+    assert (tmp_path / "out" / "a.txt").read_bytes() == b"alpha"
+
+
+def test_extract_plain_archive_misnamed_gz(run_cli, tmp_path):
+    """FR-008: and a plain archive named ``.tar.gz`` extracts too."""
+    archive = helpers.build_files(tmp_path / "misnamed.tar.gz", {"a.txt": b"alpha"})
+    result = run_cli(["extract", str(archive), str(tmp_path / "out")])
+    assert result.status == 0
+    assert (tmp_path / "out" / "a.txt").read_bytes() == b"alpha"
