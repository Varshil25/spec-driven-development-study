+"""Format detection, archive opening, and lazy bounded member iteration — the
+things that must happen before any member is trusted.
+
+The resource bounds live here as fixed constants, not configuration (SR-005,
+Principle IV). Iteration is deliberately lazy: ``getmembers()`` would read the
+entire archive index before returning, so a ten-million-member archive would be
+fully parsed before the member cap could fire (research.md R-003, R-005).
+"""
+
+import gzip
+import os
+import tarfile
+import zlib
+from pathlib import Path
+
+from .errors import TarxError
+from .paths import escape_name
+
+#: At most this many members in one archive (SR-005).
+MAX_MEMBERS = 10_000
+
+#: At most this many uncompressed bytes across all members, 1 GiB (SR-005).
+MAX_TOTAL_BYTES = 1 << 30
+
+#: At most this many bytes in any single member, 1 GiB (SR-005).
+MAX_MEMBER_BYTES = 1 << 30
+
+#: Copy granularity for the write phase, 64 KiB — so no member's contents are
+#: ever held whole in memory (SC-007).
+COPY_CHUNK_BYTES = 64 * 1024
+
+#: gzip's leading magic bytes (RFC 1952).
+_GZIP_MAGIC = b"\x1f\x8b"
+
+
+def _reason(exc: BaseException) -> str:
+    """A short, safe explanation of a read failure.
+
+    Never ``repr(exc)`` and never a traceback; the text is escaped so a corrupt
+    archive cannot smuggle terminal control sequences out through an error
+    message (SR-007, SR-008, R-010).
+    """
+    if isinstance(exc, EOFError):
+        text = "unexpected end of data"
+    elif isinstance(exc, zlib.error):
+        text = "corrupt compressed data"
+    elif isinstance(exc, OSError):
+        text = exc.strerror or "cannot be read"
+    else:
+        text = str(exc) or exc.__class__.__name__
+    return escape_name(text)
+
+
+def _archive_error(path: object, exc: BaseException) -> TarxError:
+    """Build the single message shape used for every unreadable/invalid archive."""
+    return TarxError(
+        f"{escape_name(os.fspath(path))}: not a readable tar archive: {_reason(exc)}"
+    )
+
+
+def sniff_compression(path) -> str:
+    """Return ``"gzip"`` or ``"none"`` from the archive's *content* (FR-008).
+
+    The filename is never consulted, so ``.tar``, ``.tar.gz``, ``.tgz``, and
+    misnamed archives all behave correctly. Only these two formats are accepted:
+    ``mode="r:*"`` was rejected because it would silently also accept bzip2 and
+    xz, widening both the scope and the decompression-bomb surface (R-002).
+    """
+    with open(path, "rb") as handle:
+        return "gzip" if handle.read(2) == _GZIP_MAGIC else "none"
+
+
+def open_archive(path) -> tarfile.TarFile:
+    """Open ``path`` as a tar archive, choosing the mode by content (FR-008).
+
+    Every way the archive can be missing, unreadable, or invalid becomes a
+    :class:`~tarx.errors.TarxError` naming the archive path (FR-013, R-010).
+    ``EOFError`` matters in particular: a gzip magic prefix followed by garbage
+    raises it, and it is *not* an ``OSError``, so without this it would escape as
+    a traceback and violate SR-008.
+    """
+    try:
+        compression = sniff_compression(path)
+        mode = "r:gz" if compression == "gzip" else "r:"
+        return tarfile.open(name=os.fspath(path), mode=mode)
+    except (tarfile.TarError, EOFError, gzip.BadGzipFile, zlib.error, OSError) as exc:
+        raise _archive_error(path, exc) from exc
+
+
+def iter_members(tar: tarfile.TarFile):
+    """Yield every member of ``tar`` lazily, enforcing the SR-005 bounds as each
+    header is read.
+
+    Bounds are checked incrementally rather than over a materialised list, which
+    is the only way the member cap can fire *before* a hostile archive has been
+    fully parsed (R-003, R-005). Both commands iterate through here, so ``list``
+    is bounded exactly as ``extract`` is (contracts/cli.md ``list`` section).
+
+    The read-failure set from :func:`open_archive` is re-wrapped here too, because
+    a truncated archive surfaces during iteration rather than at open (R-010).
+    """
+    archive_label = escape_name(tar.name) if tar.name else "archive"
+    count = 0
+    total_declared = 0
+    try:
+        for member in tar:
+            count += 1
+            if count > MAX_MEMBERS:
+                raise TarxError(
+                    f"{archive_label}: too many members: the limit is "
+                    f"{MAX_MEMBERS} members per archive, exceeded at member "
+                    f"{escape_name(member.name)}"
+                )
+            declared = member.size or 0
+            if declared > MAX_MEMBER_BYTES:
+                raise TarxError(
+                    f"member {escape_name(member.name)}: declared size {declared} "
+                    f"bytes exceeds the per-member limit of {MAX_MEMBER_BYTES} bytes"
+                )
+            total_declared += declared
+            if total_declared > MAX_TOTAL_BYTES:
+                raise TarxError(
+                    f"{archive_label}: total declared size exceeds the limit of "
+                    f"{MAX_TOTAL_BYTES} bytes, exceeded at member "
+                    f"{escape_name(member.name)}"
+                )
+            yield member
+    except TarxError:
+        raise
+    except (tarfile.TarError, EOFError, gzip.BadGzipFile, zlib.error, OSError) as exc:
+        raise _archive_error(Path(tar.name) if tar.name else "archive", exc) from exc
diff --git a/src/tarx/cli.py b/src/tarx/cli.py
new file mode 100644
index 0000000..9b0e0e7
--- /dev/null
+++ b/src/tarx/cli.py
@@ -0,0 +1,170 @@
+"""The command-line surface: argument parsing, dispatch, stdout writing, and the
+single place an exit status is chosen.
+
+``errors.py`` is the only place an exit status is *defined*; ``main`` below is the
+only place one is *chosen*. That pairing is what makes FR-015's "no other exit
+status may be produced" checkable by reading one function (R-009).
+"""
+
+import argparse
+import os
+import sys
+
+from . import archive
+from . import extract
+from .errors import TarxError
+from .paths import escape_name
+
+#: Prefix for every diagnostic line, matching the ``prog`` argparse uses.
+_PROG = "python -m tarx"
+
+
+def build_parser() -> argparse.ArgumentParser:
+    """The whole accepted command line (FR-001, SR-010).
+
+    argparse already does exactly what FR-001 demands — a missing command, an
+    unknown command, a missing or extra positional, and an unknown option each
+    write a usage message to stderr and exit 2 — so reusing it is the smallest
+    design that conforms (R-004, Principle IV).
+    """
+    parser = argparse.ArgumentParser(
+        prog=_PROG,
+        description="List or extract tar archives (plain or gzip-compressed).",
+    )
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    list_parser = subparsers.add_parser(
+        "list", help="print every member name, one per line, in archive order"
+    )
+    list_parser.add_argument("archive", metavar="ARCHIVE", help="path to the archive")
+
+    extract_parser = subparsers.add_parser(
+        "extract", help="write the archive's files and directories beneath DEST"
+    )
+    extract_parser.add_argument(
+        "archive", metavar="ARCHIVE", help="path to the archive"
+    )
+    extract_parser.add_argument(
+        "dest", metavar="DEST", help="destination directory, created if absent"
+    )
+    extract_parser.add_argument(
+        "--overwrite",
+        action="store_true",
+        help="replace the contents of existing regular files",
+    )
+    return parser
+
+
+def _parse(argv) -> argparse.Namespace:
+    """Parse and validate ``argv``, raising ``SystemExit`` on a usage error.
+
+    The empty-string checks are ours rather than argparse's: argparse happily
+    accepts ``""`` for a positional, and SR-010 requires the archive and
+    destination paths to be non-empty.
+    """
+    parser = build_parser()
+    args = parser.parse_args(argv)
+    if args.archive == "":
+        parser.error("ARCHIVE must not be empty")
+    if getattr(args, "dest", None) == "":
+        parser.error("DEST must not be empty")
+    return args
+
+
+def _fail(message: str) -> None:
+    """Write one diagnostic line to stderr (FR-016)."""
+    print(f"{_PROG}: error: {message}", file=sys.stderr)
+
+
+def _silence_stdout_at_shutdown() -> None:
+    """Point fd 1 at ``/dev/null`` after a broken pipe (R-011).
+
+    Without this the interpreter's shutdown flush writes to the dead pipe and
+    prints ``Exception ignored in: <_io.TextIOWrapper name='<stdout>'...>``,
+    which would be a crash report on stderr and so a breach of SR-008 and the
+    Edge Case that ``list | head -1`` must terminate cleanly.
+    """
+    try:
+        fileno = sys.stdout.fileno()
+    except (AttributeError, OSError, ValueError):
+        return  # Not a real file descriptor (in-process capture); nothing to do.
+    devnull = os.open(os.devnull, os.O_WRONLY)
+    os.dup2(devnull, fileno)
+    os.close(devnull)
+
+
+def run_list(archive_path: str) -> int:
+    """``list ARCHIVE`` (FR-002, FR-003, FR-018, SR-005, SR-007, R-014).
+
+    Every member is printed regardless of kind — the member-kind restrictions
+    that ``extract`` applies are deliberately *not* applied here, because
+    refusing to list an archive because it contains a symlink would defeat the
+    purpose of having a safe way to inspect untrusted input. The resource bounds
+    *are* applied, via :func:`~tarx.archive.iter_members`.
+
+    Names are collected before any are printed. SR-005 requires an exceeded
+    bound to be an error "never a truncated best-effort result", and FR-013
+    requires a truncated archive — which only fails part-way through iteration —
+    to leave stdout empty rather than holding a partial listing. Collecting
+    first is what makes both true, and it stays within bounded memory because
+    ``MAX_MEMBERS`` already caps how many names there can be.
+
+    This function performs no filesystem write of any kind.
+    """
+    with archive.open_archive(archive_path) as tar:
+        names = [escape_name(member.name) for member in archive.iter_members(tar)]
+
+    try:
+        for name in names:
+            print(name)
+    except BrokenPipeError:
+        _silence_stdout_at_shutdown()
+        # A broken pipe is a failure, so it is 2. A POSIX tool killed by SIGPIPE
+        # would exit 141; FR-015 permits no status beyond 0, 2 and 3 (R-011).
+        return 2
+    return 0
+
+
+def run_extract(archive_path: str, dest: str, overwrite: bool) -> int:
+    """``extract ARCHIVE DEST [--overwrite]`` (FR-006, FR-016, FR-019).
+
+    On success, stdout receives exactly one line and nothing else. On failure the
+    exception carries the message to the single handler in :func:`main`, so no
+    success line can ever accompany a non-zero status.
+    """
+    files_written = extract.extract_archive(archive_path, dest, overwrite=overwrite)
+    print(f"extracted {files_written} files")
+    return 0
+
+
+def main(argv=None) -> int:
+    """Parse, dispatch, and turn any failure into a status (FR-015, FR-016).
+
+    Every exit status the tool can produce is returned from this function: 0 on
+    success, ``err.exit_code`` for a :class:`~tarx.errors.TarxError` (2, or 3 for
+    an overwrite conflict), and 2 for a usage error or an unforeseen ``OSError``.
+    There is no bare ``except``; the broadest catch is ``OSError``, and its
+    message is built from ``strerror`` rather than ``repr`` so no traceback or
+    internal detail reaches stderr (SR-008, R-009).
+    """
+    try:
+        args = _parse(argv)
+    except SystemExit as exc:
+        # argparse has already written usage to stderr (or --help to stdout).
+        return 0 if exc.code in (0, None) else 2
+
+    try:
+        if args.command == "list":
+            return run_list(args.archive)
+        return run_extract(args.archive, args.dest, args.overwrite)
+    except TarxError as err:
+        _fail(err.message)
+        return err.exit_code
+    except OSError as exc:
+        detail = exc.strerror or "operation failed"
+        target = exc.filename
+        if target:
+            _fail(f"{escape_name(str(target))}: {escape_name(detail)}")
+        else:
+            _fail(escape_name(detail))
+        return 2
diff --git a/src/tarx/errors.py b/src/tarx/errors.py
new file mode 100644
index 0000000..47a3794
--- /dev/null
+++ b/src/tarx/errors.py
@@ -0,0 +1,37 @@
+"""The complete error model for tarx.
+
+Exactly two exception classes exist, and exactly two ``exit_code`` values. Adding a
+third of either would break FR-015's promise that no other exit status can be
+produced, so this file is deliberately the only place an exit status is *defined*
+(``cli.main`` is the only place one is *chosen*). See data-model.md section 7 and
+research.md R-009.
+"""
+
+
+class TarxError(Exception):
+    """Every failure except an overwrite conflict (exit 2).
+
+    ``message`` is a single line, operator-actionable, naming the archive path,
+    member name, or destination path at issue (FR-017). Member names must already
+    be passed through :func:`tarx.paths.escape_name` by the raising code (SR-007),
+    and the message must never carry member contents, environment values, or
+    traceback text (SR-008).
+    """
+
+    exit_code = 2
+
+    def __init__(self, message: str) -> None:
+        super().__init__(message)
+        self.message = message
+
+
+class OverwriteConflict(TarxError):
+    """Extraction refused *solely* because it would overwrite an existing regular
+    file and ``--overwrite`` was not given (exit 3).
+
+    This class has exactly one raise site in the package — the destination-state
+    check in :mod:`tarx.extract` — which is what makes FR-009's "solely" a
+    structural property rather than a convention.
+    """
+
+    exit_code = 3
diff --git a/src/tarx/extract.py b/src/tarx/extract.py
new file mode 100644
index 0000000..f6f2516
--- /dev/null
+++ b/src/tarx/extract.py
@@ -0,0 +1,392 @@
+"""The validate-then-write sequence.
+
+Pass 1 (:func:`build_plan`) checks every member and writes nothing. Pass 2
+(:func:`apply_plan`) writes. The boundary between them is visible in
+:func:`extract_archive`, which is where FR-014 and SC-006 are enforced.
+
+Pass 2 never calls ``TarFile.extract``/``extractall``: it opens each file itself
+with ``os.open(..., O_CREAT | (O_EXCL or O_TRUNC) | O_NOFOLLOW, 0o600)`` and
+streams contents in fixed-size chunks. That single choice delivers
+narrowest-permissions-at-creation, refusal to follow symlinks, bounded memory for
+arbitrarily large members, and the guarantee that archive permission, ownership,
+and timestamp metadata is never even consulted (SR-004, SR-006, SC-007, R-007).
+"""
+
+import errno
+import os
+import stat
+import tarfile
+from dataclasses import dataclass
+from pathlib import Path
+from typing import List, Literal
+
+from . import archive as _archive
+from . import paths
+from .errors import OverwriteConflict, TarxError
+from .paths import escape_name
+
+
+@dataclass
+class PlannedEntry:
+    """One validated, ready-to-write unit — the whole plan record.
+
+    ``member_name`` keeps the *raw* name, escaped only at print time, so the
+    escaping decision lives in exactly one place (SR-007, data-model.md
+    section 5).
+    """
+
+    member_name: str
+    kind: Literal["file", "dir"]
+    dest_path: Path
+    declared_size: int
+    tarinfo: tarfile.TarInfo
+    exists_as_file: bool = False
+
+
+def _kind_description(member: tarfile.TarInfo) -> str:
+    """What an unsupported member actually is, in operator-facing words (FR-017)."""
+    if member.issym():
+        return "a symbolic link"
+    if member.islnk():
+        return "a hard link"
+    if member.ischr():
+        return "a character device"
+    if member.isblk():
+        return "a block device"
+    if member.isfifo():
+        return "a FIFO"
+    return "an unsupported member type"
+
+
+def prepare_destination(dest) -> Path:
+    """Make ``dest`` absolute, verify it is usable, and create it if absent.
+
+    This runs *before* Pass 1 for three reasons: FR-018's empty archive must
+    still leave ``DEST`` created; the destination-state checks need a real
+    directory to stat against; and FR-007 wants an unusable destination reported
+    before anything else is attempted. Creating an empty directory destroys
+    nothing, so SC-006's guarantee about destination *contents* still holds
+    (R-013, data-model.md section 4).
+    """
+    root = Path(os.path.abspath(dest))
+    shown = escape_name(str(root))
+    if os.path.lexists(root):
+        # ``isdir`` follows symlinks on purpose: a symlinked DEST chosen by the
+        # user is honoured (SR-004); one pointing at a non-directory is not.
+        if not os.path.isdir(root):
+            raise TarxError(f"{shown}: destination exists and is not a directory")
+        return root
+    try:
+        os.makedirs(root, mode=0o700, exist_ok=True)
+    except OSError as exc:
+        raise TarxError(
+            f"{shown}: cannot create the destination directory: "
+            f"{escape_name(exc.strerror or 'operation failed')}"
+        ) from exc
+    return root
+
+
+def _check_destination_state(
+    kind: str, dest_path: Path, member_name: str, overwrite: bool
+) -> bool:
+    """Decide what the existing state at ``dest_path`` means for this member.
+
+    Uses ``os.path.lstat`` exclusively — never ``os.stat`` — so a symlink is seen
+    as itself rather than as whatever it points at (R-013).
+
+    Returns:
+        ``True`` when an existing regular file is to be rewritten in place
+        (``--overwrite``), ``False`` otherwise.
+
+    Raises:
+        OverwriteConflict: an existing regular file with no ``--overwrite``. This
+            is the *only* raise site for exit status 3 in the whole package,
+            which is what makes FR-009's "refused solely because of overwrite"
+            structurally true.
+        TarxError: any type conflict or unexpected existing entry type.
+    """
+    shown = escape_name(member_name)
+    shown_path = escape_name(str(dest_path))
+    try:
+        info = os.lstat(dest_path)
+    except FileNotFoundError:
+        return False
+    except OSError as exc:
+        raise TarxError(
+            f"{shown_path}: cannot be examined: "
+            f"{escape_name(exc.strerror or 'operation failed')}"
+        ) from exc
+
+    mode = info.st_mode
+    if kind == "file":
+        if stat.S_ISREG(mode):
+            if overwrite:
+                return True
+            raise OverwriteConflict(
+                f"{shown_path}: a regular file already exists there; pass "
+                "--overwrite to replace it"
+            )
+        if stat.S_ISDIR(mode):
+            raise TarxError(
+                f"member {shown}: {shown_path} already exists as a directory, so "
+                "the file member cannot be written there"
+            )
+        if stat.S_ISLNK(mode):
+            raise TarxError(
+                f"member {shown}: {shown_path} already exists as a symbolic link, "
+                "which this tool refuses to follow or replace"
+            )
+        raise TarxError(
+            f"member {shown}: {shown_path} already exists and is neither a regular "
+            "file nor a directory"
+        )
+
+    # Directory member.
+    if stat.S_ISDIR(mode):
+        return False  # Reused silently — never an overwrite conflict (FR-012).
+    if stat.S_ISLNK(mode):
+        raise TarxError(
+            f"member {shown}: {shown_path} already exists as a symbolic link, "
+            "which this tool refuses to follow or replace"
+        )
+    raise TarxError(
+        f"member {shown}: {shown_path} already exists as a regular file, so the "
+        "directory member cannot be created there"
+    )
+
+
+def build_plan(tar: tarfile.TarFile, dest_root: Path, overwrite: bool) -> List[PlannedEntry]:
+    """Pass 1 — validate every member and return the plan. Writes nothing.
+
+    The checks run in exactly this order, so the first failure wins
+    (data-model.md section 5):
+
+    1. name shape (:func:`~tarx.paths.validate_member_name`, SR-001);
+    2. containment (:func:`~tarx.paths.map_member_path`, SR-001);
+    3. member kind — anything that is not a regular file or a directory is
+       refused unconditionally, never skipped (SR-002, SR-003, R-014);
+    4. resource bounds, enforced incrementally by
+       :func:`~tarx.archive.iter_members` as each header is read (SR-005);
+    5. no existing symlink among the destination path's components (SR-004);
+    6. uniqueness of the mapped destination path (SR-009, R-012);
+    7. the existing destination state (FR-009, FR-011, FR-012).
+    """
+    plan: List[PlannedEntry] = []
+    claimed = {}
+    dirs_planned = set()
+
+    def plan_ancestors(dest_path: Path, member: tarfile.TarInfo) -> None:
+        """Plan any missing directory between ``dest_root`` and ``dest_path``.
+
+        Archives routinely record ``a/b.txt`` with no ``a/`` member of their own,
+        and FR-004 requires the member's relative path to be preserved, so the
+        intervening directories have to be created. They are planned rather than
+        created on demand in Pass 2, so an ancestor that already exists as a
+        regular file is still a type conflict caught before any write
+        (FR-004, FR-011, FR-014).
+        """
+        partial = dest_root
+        for part in dest_path.relative_to(dest_root).parts[:-1]:
+            partial = partial / part
+            if partial in dirs_planned:
+                continue
+            _check_destination_state("dir", partial, member.name, overwrite)
+            dirs_planned.add(partial)
+            plan.append(
+                PlannedEntry(
+                    member_name=member.name,
+                    kind="dir",
+                    dest_path=partial,
+                    declared_size=0,
+                    tarinfo=member,
+                )
+            )
+
+    for member in _archive.iter_members(tar):
+        paths.validate_member_name(member.name)
+        dest_path = paths.map_member_path(dest_root, member.name)
+
+        if member.isdir():
+            kind = "dir"
+        elif member.isreg():
+            kind = "file"
+        else:
+            raise TarxError(
+                f"member {escape_name(member.name)}: refusing "
+                f"{_kind_description(member)}; only regular files and directories "
+                "can be extracted"
+            )
+
+        paths.assert_no_symlink_components(dest_root, dest_path, member.name)
+
+        previous = claimed.get(dest_path)
+        if previous is not None:
+            raise TarxError(
+                f"members {escape_name(previous)} and {escape_name(member.name)} "
+                f"both map to {escape_name(str(dest_path))}; refusing the archive"
+            )
+        claimed[dest_path] = member.name
+
+        plan_ancestors(dest_path, member)
+
+        if kind == "file" and dest_path in dirs_planned:
+            raise TarxError(
+                f"member {escape_name(member.name)}: another member of the archive "
+                f"needs {escape_name(str(dest_path))} to be a directory, so the "
+                "file member cannot be written there"
+            )
+
+        exists_as_file = _check_destination_state(
+            kind, dest_path, member.name, overwrite
+        )
+        if kind == "dir":
+            if dest_path in dirs_planned:
+                continue
+            dirs_planned.add(dest_path)
+        plan.append(
+            PlannedEntry(
+                member_name=member.name,
+                kind=kind,
+                dest_path=dest_path,
+                declared_size=0 if kind == "dir" else (member.size or 0),
+                tarinfo=member,
+                exists_as_file=exists_as_file,
+            )
+        )
+
+    return plan
+
+
+def _open_for_write(entry: PlannedEntry) -> int:
+    """Open ``entry.dest_path`` with the narrowest permissions at creation.
+
+    ``O_NOFOLLOW`` closes the time-of-check-to-time-of-use window left by Pass
+    1's symlink walk, ``O_EXCL`` (or ``O_TRUNC`` when deliberately overwriting)
+    makes the pre-existence decision at the syscall, and the mode argument sets
+    ``0o600`` at creation rather than with a later ``chmod`` (SR-004, SR-006,
+    R-007).
+    """
+    flags = os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW
+    flags |= os.O_TRUNC if entry.exists_as_file else os.O_EXCL
+    try:
+        return os.open(entry.dest_path, flags, 0o600)
+    except OSError as exc:
+        shown = escape_name(entry.member_name)
+        shown_path = escape_name(str(entry.dest_path))
+        if exc.errno == errno.ELOOP:
+            raise TarxError(
+                f"member {shown}: {shown_path} is a symbolic link, which this tool "
+                "refuses to follow"
+            ) from exc
+        raise TarxError(
+            f"member {shown}: cannot write {shown_path}: "
+            f"{escape_name(exc.strerror or 'operation failed')}"
+        ) from exc
+
+
+def _copy_member(tar: tarfile.TarFile, entry: PlannedEntry, total_actual: int) -> int:
+    """Stream one member's contents to disk, counting the bytes actually read.
+
+    The copy is done in ``COPY_CHUNK_BYTES`` chunks so no member's contents are
+    ever held whole in memory, whatever its size (SC-007).
+
+    The byte counters are SR-005's second line of defence: declared sizes were
+    already bounded in Pass 1, and here the *real* bytes are bounded too, so an
+    archive whose headers understate its size is still stopped. The bounds are
+    read from :mod:`tarx.archive` at call time rather than captured at import,
+    which is also what makes this counter testable. Crossing a bound here is the
+    single documented case where the destination may be left partially written,
+    so the message says so (SR-005, SC-006).
+    """
+    try:
+        source = tar.extractfile(entry.tarinfo)
+    except (tarfile.TarError, EOFError, OSError) as exc:
+        raise TarxError(
+            f"member {escape_name(entry.member_name)}: cannot be read from the "
+            "archive"
+        ) from exc
+
+    fd = _open_for_write(entry)
+    member_actual = 0
+    try:
+        with os.fdopen(fd, "wb") as sink:
+            if source is None:
+                return total_actual
+            while True:
+                chunk = source.read(_archive.COPY_CHUNK_BYTES)
+                if not chunk:
+                    break
+                member_actual += len(chunk)
+                total_actual += len(chunk)
+                if (
+                    member_actual > _archive.MAX_MEMBER_BYTES
+                    or total_actual > _archive.MAX_TOTAL_BYTES
+                ):
+                    raise TarxError(
+                        f"member {escape_name(entry.member_name)}: the bytes "
+                        "actually read exceed a resource bound, so the archive's "
+                        "headers understated its size; the destination may "
+                        "contain a partial extraction"
+                    )
+                sink.write(chunk)
+            if member_actual != entry.declared_size:
+                # Defence in depth behind the Pass 1 data-presence probe: the
+                # archive would have to have changed underneath us to get here,
+                # and a short member means FR-005's byte-for-byte guarantee is
+                # already broken, so fail loudly rather than keep the stub.
+                raise TarxError(
+                    f"member {escape_name(entry.member_name)}: the archive "
+                    f"supplied {member_actual} bytes where its header declared "
+                    f"{entry.declared_size}; the destination may contain a "
+                    "partial extraction"
+                )
+    finally:
+        if source is not None:
+            source.close()
+    return total_actual
+
+
+def apply_plan(tar: tarfile.TarFile, plan: List[PlannedEntry]) -> int:
+    """Pass 2 — write the plan and return the count of regular files written.
+
+    Directories are created with ``os.mkdir(path, 0o700)``, tolerating one that
+    already exists (FR-012). Files go through :func:`_copy_member`. Because
+    ``TarFile.extract``/``extractall`` is never called, archive permission,
+    ownership, and timestamp metadata is never consulted, so setuid, setgid, and
+    sticky bits can never be set (SR-006).
+    """
+    files_written = 0
+    total_actual = 0
+
+    for entry in plan:
+        if entry.kind == "dir":
+            try:
+                os.mkdir(entry.dest_path, 0o700)
+            except FileExistsError:
+                pass  # Pre-existing directories are reused (FR-012).
+            except OSError as exc:
+                raise TarxError(
+                    f"member {escape_name(entry.member_name)}: cannot create "
+                    f"{escape_name(str(entry.dest_path))}: "
+                    f"{escape_name(exc.strerror or 'operation failed')}"
+                ) from exc
+        else:
+            total_actual = _copy_member(tar, entry, total_actual)
+            files_written += 1
+
+    return files_written
+
+
+def extract_archive(archive_path, dest, overwrite: bool = False) -> int:
+    """Extract ``archive_path`` into ``dest`` and return the files-written count.
+
+    The two-pass boundary is visible in this one function, because that is where
+    FR-014 and SC-006 are enforced: every check has run by the time
+    :func:`apply_plan` is reached, so a refused archive leaves the destination's
+    contents byte-for-byte unchanged (data-model.md sections 6 and 9).
+    """
+    dest_root = prepare_destination(dest)
+    with _archive.open_archive(archive_path) as tar:
+        plan = build_plan(tar, dest_root, overwrite)
+        # --- Nothing has been written below DEST before this line (FR-014). ---
+        return apply_plan(tar, plan)
