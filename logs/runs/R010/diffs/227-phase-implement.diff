@@ -0,0 +1,185 @@
+"""Every decision about a member *name*: rendering it safely for display,
+validating its shape, mapping it to a destination path, and refusing a symlink
+inside the destination.
+
+Keeping all four in one module is what makes SR-001, SR-004, and SR-007
+reviewable in one place (plan.md "Structure Decision").
+"""
+
+import os
+import re
+import unicodedata
+from pathlib import Path, PurePosixPath
+
+from .errors import TarxError
+
+#: A Windows drive prefix such as ``C:`` (SR-001).
+_DRIVE_PREFIX = re.compile(r"^[A-Za-z]:")
+
+#: Unicode general categories whose characters are never safe to emit raw:
+#: control, format, surrogate, private-use, and unassigned (R-008).
+_UNSAFE_CATEGORIES = frozenset({"Cc", "Cf", "Cs", "Co", "Cn"})
+
+#: Familiar short escapes, preferred over the numeric forms where they apply.
+_SHORT_ESCAPES = {
+    "\\": "\\\\",
+    "\n": "\\n",
+    "\r": "\\r",
+    "\t": "\\t",
+}
+
+
+def _needs_escape(ch: str) -> bool:
+    """Whether ``ch`` must be rendered in an escaped form (SR-007, R-008)."""
+    code = ord(ch)
+    if code < 0x20 or code == 0x7F or 0x80 <= code <= 0x9F:
+        return True
+    return unicodedata.category(ch) in _UNSAFE_CATEGORIES
+
+
+def _escape_char(ch: str) -> str:
+    """Render one character that :func:`_needs_escape` accepted."""
+    code = ord(ch)
+    if code <= 0xFF:
+        return f"\\x{code:02x}"
+    if code <= 0xFFFF:
+        return f"\\u{code:04x}"
+    return f"\\U{code:08x}"
+
+
+def escape_name(name: str) -> str:
+    """Render ``name`` safe for stdout or stderr (SR-007).
+
+    A character is escaped when it is a C0 control, ``DEL``, a C1 control, or has
+    Unicode category ``Cc``, ``Cf``, ``Cs``, ``Co``, or ``Cn``. Short forms
+    ``\\n``, ``\\r``, ``\\t`` and ``\\\\`` are used where they apply, otherwise
+    ``\\xXX``, ``\\uXXXX``, or ``\\UXXXXXXXX``. A literal backslash becomes
+    ``\\\\`` so the rendering is unambiguous.
+
+    Every other character — including all printable non-ASCII — is emitted
+    unchanged, so names with spaces, accents, or CJK characters appear faithfully
+    (contracts/cli.md "Name escaping on output").
+
+    The result is a *display* form, not always a shell-pasteable path: SR-007
+    deliberately ranks terminal safety above round-tripping.
+    """
+    out = []
+    for ch in name:
+        short = _SHORT_ESCAPES.get(ch)
+        if short is not None:
+            out.append(short)
+        elif _needs_escape(ch):
+            out.append(_escape_char(ch))
+        else:
+            out.append(ch)
+    return "".join(out)
+
+
+def _components(name: str) -> tuple:
+    """The surviving path components of ``name``.
+
+    Empty components (from ``a//b`` or a trailing ``/``) and ``.`` components are
+    dropped — ``tar -cf`` conventionally emits ``./x`` and ``dir/`` — while ``..``
+    is never dropped, only refused by :func:`validate_member_name` (R-006).
+    """
+    return tuple(
+        part for part in name.split("/") if part not in ("", ".")
+    )
+
+
+def validate_member_name(name: str) -> tuple:
+    """Check a member name's *shape* and return its surviving components.
+
+    Validation is purely lexical and runs on the name as recorded in the archive
+    header, so it cannot be defeated by filesystem state, and it is deliberately
+    kept separate from the symlink question (R-006, R-007). The checks run in the
+    order below and the first failure wins (data-model.md section 5 rule 1):
+
+    1. the name must be non-empty;
+    2. it must not be absolute (no leading ``/``);
+    3. it must not begin with a backslash — this covers both ``\\dir\\file`` and
+       the ``\\\\server\\share`` UNC prefix;
+    4. it must not carry a ``C:``-style drive prefix;
+    5. no path component may be ``..``.
+
+    Raises:
+        TarxError: naming the escaped member, on the first rule that fails
+            (SR-001).
+    """
+    if not name:
+        raise TarxError("archive contains a member with an empty name")
+    shown = escape_name(name)
+    if PurePosixPath(name).is_absolute():
+        raise TarxError(
+            f"member {shown}: refusing an absolute member path; every member must "
+            "lie inside the destination"
+        )
+    if name.startswith("\\"):
+        raise TarxError(
+            f"member {shown}: refusing a member path beginning with a backslash; "
+            "every member must lie inside the destination"
+        )
+    if _DRIVE_PREFIX.match(name):
+        raise TarxError(
+            f"member {shown}: refusing a member path with a drive prefix; every "
+            "member must lie inside the destination"
+        )
+    components = _components(name)
+    if ".." in components:
+        raise TarxError(
+            f"member {shown}: refusing a member path containing '..'; every member "
+            "must lie inside the destination"
+        )
+    return components
+
+
+def map_member_path(dest_root, name: str) -> Path:
+    """Map a validated member name onto ``dest_root`` and confirm containment.
+
+    The containment test is a belt-and-braces check on top of
+    :func:`validate_member_name`: the mapped path must equal ``dest_root`` or lie
+    under it, compared with ``os.path.normpath``.
+
+    ``pathlib.Path.resolve()`` is deliberately *not* used — it follows symlinks
+    and would mask the very escape SR-004 guards. A bare ``startswith`` is
+    deliberately not used either; the comparison appends the path separator so
+    ``/tmp/destfoo`` is not mistaken for something inside ``/tmp/dest``
+    (SR-001, R-006, data-model.md section 5 rule 2).
+    """
+    root = os.path.normpath(str(dest_root))
+    mapped = os.path.normpath(os.path.join(root, *_components(name)))
+    if mapped != root and not mapped.startswith(root + os.sep):
+        raise TarxError(
+            f"member {escape_name(name)}: refusing a member path that resolves "
+            f"outside the destination {escape_name(root)}"
+        )
+    return Path(mapped)
+
+
+def assert_no_symlink_components(dest_root, dest_path, member_name: str) -> None:
+    """Refuse a destination path any of whose components is already a symlink.
+
+    Walks the components below ``dest_root`` and tests each with
+    ``os.path.islink``. ``dest_root`` itself is *not* tested: a symlinked ``DEST``
+    supplied by the user is honoured, because the boundary is the user's choice —
+    what SR-004 refuses is a symlink *inside* it (R-007, data-model.md section 5
+    rule 5).
+    """
+    root = Path(os.path.abspath(dest_root))
+    try:
+        relative = Path(dest_path).relative_to(root)
+    except ValueError:  # pragma: no cover - containment already guarantees this
+        raise TarxError(
+            f"member {escape_name(member_name)}: destination path lies outside "
+            f"{escape_name(str(root))}"
+        ) from None
+
+    partial = root
+    for part in relative.parts:
+        partial = partial / part
+        if os.path.islink(partial):
+            raise TarxError(
+                f"member {escape_name(member_name)}: refusing to follow the "
+                f"existing symbolic link {escape_name(str(partial))} inside the "
+                "destination"
+            )
