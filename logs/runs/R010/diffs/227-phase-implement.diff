+
+def test_extract_awkward_but_legal_names_round_trip(run_cli, tmp_path):
+    """FR-004, FR-005, SC-002: spaces, non-ASCII characters, and a very long path
+    are reproduced faithfully on disk."""
+    long_path = "/".join(["d" * 40] * 5) + "/deep file.txt"
+    payload = {
+        "a folder/my photo ü.jpg": b"accented",
+        "漢字/テスト.txt": b"cjk",
+        "with spaces everywhere/and more spaces.txt": b"spaced",
