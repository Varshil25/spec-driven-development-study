+++ b/tests/helpers.py
@@ -0,0 +1,193 @@
+"""In-process tar archive builders for the test suite, including hostile members.
+
+No binary fixtures are committed and no elevated privileges are needed: every
+hostile member is constructed by setting ``TarInfo`` fields directly and calling
+``addfile()``, because the tool under test rejects such members from their
+*headers* and never needs a real device node or escaping symlink to exist on disk
+(research.md R-016, SC-005).
+"""
+
+import io
+import os
+import tarfile
+from typing import NamedTuple, Optional
+
+
+class MemberSpec(NamedTuple):
+    """One member to write: its header plus the bytes to store for it."""
+
+    info: tarfile.TarInfo
+    data: Optional[bytes]
+
+
+def _info(
+    name: str,
+    *,
+    typeflag: bytes = tarfile.REGTYPE,
+    size: int = 0,
+    linkname: str = "",
+    mode: int = 0o644,
+) -> tarfile.TarInfo:
+    """A fully determined ``TarInfo`` — no ambient uid/gid/mtime leaking in."""
+    info = tarfile.TarInfo(name)
+    info.type = typeflag
+    info.size = size
+    info.linkname = linkname
+    info.mode = mode
+    info.mtime = 0
+    info.uid = 0
+    info.gid = 0
+    info.uname = ""
+    info.gname = ""
+    return info
+
+
+# --- member factories -------------------------------------------------------
+
+
+def file_member(
+    name: str, data: bytes = b"", *, mode: int = 0o644, declared_size: int = None
+) -> MemberSpec:
+    """A regular-file member. ``declared_size`` overrides the header's size."""
+    size = len(data) if declared_size is None else declared_size
+    return MemberSpec(_info(name, size=size, mode=mode), data)
+
+
+def dir_member(name: str, *, mode: int = 0o755) -> MemberSpec:
+    """A directory member."""
+    return MemberSpec(_info(name, typeflag=tarfile.DIRTYPE, mode=mode), None)
+
+
+def symlink_member(name: str, target: str = "target.txt") -> MemberSpec:
+    """A symbolic-link member (SR-002)."""
+    return MemberSpec(
+        _info(name, typeflag=tarfile.SYMTYPE, linkname=target, mode=0o777), None
+    )
+
+
+def hardlink_member(name: str, target: str = "target.txt") -> MemberSpec:
+    """A hard-link member (SR-002)."""
+    return MemberSpec(_info(name, typeflag=tarfile.LNKTYPE, linkname=target), None)
+
+
+def chardev_member(name: str) -> MemberSpec:
+    """A character-device member (SR-003)."""
+    return MemberSpec(_info(name, typeflag=tarfile.CHRTYPE), None)
+
+
+def blockdev_member(name: str) -> MemberSpec:
+    """A block-device member (SR-003)."""
+    return MemberSpec(_info(name, typeflag=tarfile.BLKTYPE), None)
+
+
+def fifo_member(name: str) -> MemberSpec:
+    """A FIFO member (SR-003)."""
+    return MemberSpec(_info(name, typeflag=tarfile.FIFOTYPE), None)
+
+
+def unknown_type_member(name: str) -> MemberSpec:
+    """A member of a type the tool has no name for at all (SR-003)."""
+    return MemberSpec(_info(name, typeflag=b"X"), None)
+
+
+# --- archive writers --------------------------------------------------------
+
+
+def write_archive(path, specs, *, compressed: bool = False):
+    """Write ``specs`` to ``path`` in the given order.
+
+    Order is preserved exactly, which is what makes the archive-order assertions
+    in the listing tests meaningful (FR-002).
+    """
+    mode = "w:gz" if compressed else "w"
+    with tarfile.open(path, mode) as tar:
+        for info, data in specs:
+            if data is None:
+                tar.addfile(info)
+            else:
+                tar.addfile(info, io.BytesIO(data))
+    return path
+
+
+def build_files(path, mapping, *, compressed: bool = False):
+    """Build an archive of regular files from a ``{name: bytes}`` mapping."""
+    return write_archive(
+        path, [file_member(name, data) for name, data in mapping.items()],
+        compressed=compressed,
+    )
+
+
+def build_empty(path, *, compressed: bool = False):
+    """A *valid* archive with no members — two zero blocks (FR-018, R-010)."""
+    return write_archive(path, [], compressed=compressed)
+
+
+def build_many_members(path, count: int):
+    """An archive of ``count`` zero-byte regular files, for the member cap."""
+    return write_archive(path, [file_member(f"m{i:06d}.txt") for i in range(count)])
+
+
+def build_declared_sizes(path, sizes):
+    """Build a well-formed archive from ``[(name, declared_size), ...]``.
+
+    The member data blocks are written as sparse holes — seek forward, write one
+    byte — so an archive declaring gigabytes costs almost no disk and almost no
+    time. ``tarfile`` *seeks* past member data when skipping to the next header,
+    so the holes are never read. This is what lets the SR-005 bounds be tested at
+    their real documented values rather than at reduced stand-ins.
+    """
+    with open(path, "wb") as handle:
+        for name, size in sizes:
+            handle.write(_info(name, size=size).tobuf(format=tarfile.GNU_FORMAT))
+            padded = size + (-size % 512)
+            if padded:
+                handle.seek(padded - 1, os.SEEK_CUR)
+                handle.write(b"\0")
+        handle.write(b"\0" * 1024)
+    return path
+
+
+def build_understated_size(path, name: str = "trap.txt", declared: int = 4):
+    """An archive whose header understates a member's real content length.
+
+    Written byte-by-byte rather than through ``addfile``, because ``addfile``
+    stores exactly ``info.size`` bytes and so cannot produce this shape. The
+    excess data is deliberately non-zero so it cannot be mistaken for the
+    archive's terminating zero blocks (SR-005).
+    """
+    info = _info(name, size=declared)
+    header = info.tobuf(format=tarfile.GNU_FORMAT)
+    excess = b"X" * 1024
+    path.write_bytes(header + excess + b"\0" * 1024)
+    return path
+
+
+def build_truncated(path, *, compressed: bool = False):
+    """An archive cut off part-way through a member's data (FR-013, R-010).
+
+    The cut has to land *inside* the member's data region: ``tarfile`` pads an
+    archive out to a 10 KiB blocking factor, so merely dropping the tail removes
+    only zero padding and leaves a perfectly readable archive.
+    """
+    full = path.with_name(path.name + ".full")
+    build_files(full, {"a.txt": b"alpha" * 200}, compressed=compressed)
+    data = full.read_bytes()
+    full.unlink()
+    path.write_bytes(data[: 512 + 400])
+    return path
+
+
+def build_garbage(path):
+    """Arbitrary binary data that is not a tar archive at all (FR-013)."""
+    path.write_bytes(b"\x00\x01\x02not a tar archive at all\xff" * 40)
+    return path
+
+
+def build_gzip_garbage(path):
+    """gzip magic bytes followed by garbage.
+
+    Verified in R-010 to raise ``EOFError``, which is *not* an ``OSError`` and
+    would escape as a traceback if it were not caught explicitly (SR-008).
+    """
+    path.write_bytes(b"\x1f\x8b" + b"\xde\xad\xbe\xef" * 64)
+    return path
diff --git a/tests/test_cli_contract.py b/tests/test_cli_contract.py
new file mode 100644
index 0000000..f666b3f
--- /dev/null
+++ b/tests/test_cli_contract.py
@@ -0,0 +1,309 @@
+"""The command-line surface itself: usage errors, stream discipline, and the
+exhaustiveness of the exit-status set.
+
+Covers FR-001, FR-015, FR-016, FR-017, SR-008, SR-010, SC-004.
+"""
+
+import ast
+from pathlib import Path
+
+import pytest
+
+import helpers
+
+#: Every invocation contracts/cli.md "Usage errors" requires to fail with 2.
+USAGE_ERROR_ARGV = [
+    pytest.param([], id="no-command"),
+    pytest.param(["delete", "x.tar"], id="unrecognised-command"),
+    pytest.param(["extract", "x.tar"], id="missing-required-argument"),
+    pytest.param(["list", "a.tar", "b.tar"], id="extra-argument"),
+    pytest.param(["list", "--verbose", "a.tar"], id="unrecognised-option"),
+    pytest.param(["list", "--overwrite", "a.tar"], id="overwrite-on-list"),
+    pytest.param(["list", ""], id="empty-archive-for-list"),
+    pytest.param(["extract", "", "out"], id="empty-archive-for-extract"),
+    pytest.param(["extract", "x.tar", ""], id="empty-dest"),
+]
+
+#: Strings that would betray a leaked traceback (SR-008).
+TRACEBACK_MARKERS = ("Traceback (most recent call last)", ", line ", "File \"")
+
+
+@pytest.mark.parametrize("argv", USAGE_ERROR_ARGV)
+def test_usage_errors_go_to_stderr_and_exit_2(run_cli, argv):
+    """FR-001, SR-010: a usage error writes to stderr, leaves stdout empty, exits 2."""
+    result = run_cli(argv)
+    assert result.status == 2
+    assert result.stdout == ""
+    assert result.stderr != ""
+
+
+@pytest.mark.parametrize("argv", USAGE_ERROR_ARGV)
+def test_usage_errors_carry_no_traceback_and_no_success_line(run_cli, argv):
+    """SR-008, FR-016: no traceback text and never a success line on failure."""
+    result = run_cli(argv)
+    for marker in TRACEBACK_MARKERS:
+        assert marker not in result.stderr
+    assert "extracted" not in result.stdout
+    assert "extracted" not in result.stderr
+
+
+def test_help_writes_usage_to_stdout_and_exits_0(run_cli):
+    """FR-001: ``--help`` is the one case where stdout carries non-command text."""
+    result = run_cli(["--help"])
+    assert result.status == 0
+    assert "usage: python -m tarx" in result.stdout
+    assert result.stderr == ""
+
+
+@pytest.mark.parametrize("command", ["list", "extract"])
+def test_subcommand_help_exits_0(run_cli, command):
+    """FR-001: each subcommand documents itself and exits 0."""
+    result = run_cli([command, "--help"])
+    assert result.status == 0
+    assert "usage: python -m tarx" in result.stdout
+
+
+def test_only_two_commands_exist(run_cli):
+    """FR-001: exactly ``list`` and ``extract`` — nothing else is accepted."""
+    from tarx import cli
+
+    parser = cli.build_parser()
+    actions = [a for a in parser._actions if hasattr(a, "choices") and a.choices]
+    (subparsers,) = actions
+    assert set(subparsers.choices) == {"list", "extract"}
+
+
+def test_overwrite_is_the_only_option_and_only_on_extract(run_cli):
+    """SR-010: ``--overwrite`` is accepted by ``extract`` and rejected by ``list``."""
+    from tarx import cli
+
+    parser = cli.build_parser()
+    (subparsers,) = [a for a in parser._actions if hasattr(a, "choices") and a.choices]
+    extract_options = {
+        option
+        for action in subparsers.choices["extract"]._actions
+        for option in action.option_strings
+    }
+    list_options = {
+        option
+        for action in subparsers.choices["list"]._actions
+        for option in action.option_strings
+    }
+    assert "--overwrite" in extract_options
+    assert "--overwrite" not in list_options
+
+
+def test_error_messages_name_what_was_rejected(run_cli, tmp_path):
+    """FR-017: a failure names the archive path the operator passed in."""
+    missing = tmp_path / "absent.tar"
+    result = run_cli(["list", str(missing)])
+    assert result.status == 2
+    assert str(missing) in result.stderr
+    assert result.stdout == ""
+
+
+def test_list_failure_prints_nothing_on_stdout(run_cli, tmp_path):
+    """FR-001, FR-016: a failing ``list`` writes no data to stdout."""
+    garbage = helpers.build_garbage(tmp_path / "garbage.tar")
+    result = run_cli(["list", str(garbage)])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert str(garbage) in result.stderr
+
+
+# --- SC-004: the exit-status set is exhaustive -------------------------------
+
+
+def _status_scenarios(tmp_path):
+    """Every specified scenario paired with the status it must produce.
+
+    Built as data so the assertion below can check both directions: each of 0, 2
+    and 3 is produced by its own scenarios, and no scenario produces anything
+    outside ``{0, 2, 3}`` (SC-004, FR-015).
+    """
+    photos = helpers.build_files(tmp_path / "ok.tar", {"a.txt": b"alpha"})
+    empty = helpers.build_empty(tmp_path / "empty.tar")
+    garbage = helpers.build_garbage(tmp_path / "garbage.tar")
+    truncated = helpers.build_truncated(tmp_path / "truncated.tar")
+    gz_garbage = helpers.build_gzip_garbage(tmp_path / "badgz.tar.gz")
+    zero = tmp_path / "zero.tar"
+    zero.write_bytes(b"")
+    traversal = helpers.write_archive(
+        tmp_path / "traversal.tar", [helpers.file_member("../esc.txt", b"x")]
+    )
+    symlink = helpers.write_archive(
+        tmp_path / "symlink.tar", [helpers.symlink_member("link")]
+    )
+    device = helpers.write_archive(
+        tmp_path / "device.tar", [helpers.chardev_member("dev/null")]
+    )
+    duplicate = helpers.write_archive(
+        tmp_path / "duplicate.tar",
+        [helpers.file_member("a/b", b"one"), helpers.file_member("./a/b", b"two")],
+    )
+    oversized = helpers.build_declared_sizes(
+        tmp_path / "oversized.tar", [("big", (1 << 30) + 1)]
+    )
+    dest_is_file = tmp_path / "dest-file"
+    dest_is_file.write_bytes(b"in the way")
+    occupied = tmp_path / "occupied"
+    occupied.mkdir(mode=0o700)
+    (occupied / "a.txt").write_bytes(b"existing")
+    type_conflict = tmp_path / "type-conflict"
+    type_conflict.mkdir(mode=0o700)
+    (type_conflict / "a.txt").mkdir(mode=0o700)
+
+    return [
+        # status 0 — the successes
+        (["list", str(photos)], 0),
+        (["list", str(empty)], 0),
+        (["extract", str(photos), str(tmp_path / "out-a")], 0),
+        (["extract", str(empty), str(tmp_path / "out-b")], 0),
+        (["extract", str(photos), str(occupied), "--overwrite"], 0),
+        # status 2 — every other failure
+        ([], 2),
+        (["delete", str(photos)], 2),
+        (["list", ""], 2),
+        (["list", str(tmp_path / "absent.tar")], 2),
+        (["list", str(garbage)], 2),
+        (["list", str(truncated)], 2),
+        (["list", str(gz_garbage)], 2),
+        (["list", str(zero)], 2),
+        (["extract", str(garbage), str(tmp_path / "out-c")], 2),
+        (["extract", str(traversal), str(tmp_path / "out-d")], 2),
+        (["extract", str(symlink), str(tmp_path / "out-e")], 2),
+        (["extract", str(device), str(tmp_path / "out-f")], 2),
+        (["extract", str(duplicate), str(tmp_path / "out-g")], 2),
+        (["extract", str(oversized), str(tmp_path / "out-h")], 2),
+        (["extract", str(photos), str(dest_is_file)], 2),
+        (["extract", str(photos), str(type_conflict)], 2),
+        (["extract", str(photos), str(type_conflict), "--overwrite"], 2),
+        # status 3 — solely an overwrite conflict
+        (["extract", str(photos), str(occupied)], 3),
+    ]
+
+
+def test_exit_status_matrix_is_exhaustive(run_cli, tmp_path):
+    """SC-004, FR-015: 0, 2 and 3 are each produced by their specified scenarios,
+    and no invocation produces any other status."""
+    scenarios = _status_scenarios(tmp_path)
+    observed = {}
+    for argv, expected in scenarios:
+        result = run_cli(argv)
+        assert result.status == expected, (argv, result.stderr)
+        observed.setdefault(result.status, []).append(argv)
+
+    assert set(observed) == {0, 2, 3}
+    assert all(status in {0, 2, 3} for status in observed)
+
+
+def test_failing_invocations_never_print_a_success_line(run_cli, tmp_path):
+    """FR-016, invariant 3: a non-zero status is never joined by a success line."""
+    for argv, expected in _status_scenarios(tmp_path):
+        result = run_cli(argv)
+        if expected != 0:
+            assert "extracted" not in result.stdout, argv
+
+
+# --- structural invariants (contracts/cli.md, plan.md Constitution Check) ----
+
+RUNTIME_SOURCES = sorted(
+    (Path(__file__).resolve().parents[1] / "src" / "tarx").glob("*.py")
+)
+
+
+def test_runtime_sources_were_found():
+    """The structural audits below are worthless if they scan nothing."""
+    assert {path.name for path in RUNTIME_SOURCES} == {
+        "__init__.py",
+        "__main__.py",
+        "archive.py",
+        "cli.py",
+        "errors.py",
+        "extract.py",
+        "paths.py",
+    }
+
+
+def test_exit_statuses_are_defined_only_in_errors_and_chosen_only_in_cli():
+    """FR-015, invariant 1: ``errors.py`` is the only module that *defines* an
+    exit status and ``cli.py`` the only one that *reads* one, which is what makes
+    "no other exit status may be produced" auditable by reading one function."""
+    definers, readers = set(), set()
+    for path in RUNTIME_SOURCES:
+        tree = ast.parse(path.read_text(encoding="utf-8"), str(path))
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Assign) and any(
+                isinstance(target, ast.Name) and target.id == "exit_code"
+                for target in node.targets
+            ):
+                definers.add(path.name)
+            if isinstance(node, ast.Attribute) and node.attr == "exit_code":
+                readers.add(path.name)
+
+    assert definers == {"errors.py"}
+    assert readers == {"cli.py"}
+
+
+def test_only_the_two_specified_exit_statuses_are_defined():
+    """FR-015: the package defines exactly two non-zero statuses — 2 and 3 — and
+    status 3 belongs to exactly one exception class."""
+    from tarx.errors import OverwriteConflict, TarxError
+
+    assert TarxError.exit_code == 2
+    assert OverwriteConflict.exit_code == 3
+    assert issubclass(OverwriteConflict, TarxError)
+    assert TarxError.__subclasses__() == [OverwriteConflict]
+
+
+def test_status_3_has_exactly_one_raise_site():
+    """FR-009, FR-015: ``OverwriteConflict`` is raised in exactly one place, which
+    is what makes "refused *solely* because of overwrite" structurally true
+    rather than merely conventional."""
+    raise_sites = []
+    for path in RUNTIME_SOURCES:
+        tree = ast.parse(path.read_text(encoding="utf-8"), str(path))
+        for node in ast.walk(tree):
+            if (
+                isinstance(node, ast.Raise)
+                and isinstance(node.exc, ast.Call)
+                and isinstance(node.exc.func, ast.Name)
+                and node.exc.func.id == "OverwriteConflict"
+            ):
+                raise_sites.append(f"{path.name}:{node.lineno}")
+    assert len(raise_sites) == 1, raise_sites
+    assert raise_sites[0].startswith("extract.py:")
+
+
+def test_no_runtime_code_can_create_a_link(tmp_path):
+    """SR-002, invariant 7: no link of any kind is ever created, because the
+    runtime calls nothing that could create one."""
+    forbidden = {"symlink", "link", "symlink_to", "hardlink_to", "mknod", "mkfifo"}
+    for path in RUNTIME_SOURCES:
+        tree = ast.parse(path.read_text(encoding="utf-8"), str(path))
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Attribute):
+                assert node.attr not in forbidden, f"{path}: {node.attr}"
+            if isinstance(node, ast.Name):
+                assert node.id not in forbidden, f"{path}: {node.id}"
+
+
+def test_no_runtime_code_uses_a_bare_except():
+    """SR-008, Principle II: nothing is swallowed by a bare ``except``; the
+    broadest catch in the package is ``OSError``."""
+    for path in RUNTIME_SOURCES:
+        tree = ast.parse(path.read_text(encoding="utf-8"), str(path))
+        for node in ast.walk(tree):
+            if isinstance(node, ast.ExceptHandler):
+                assert node.type is not None, f"{path}: bare except at line {node.lineno}"
+
+
+def test_extraction_never_delegates_to_tarfiles_own_writer():
+    """SR-006, FR-014: ``TarFile.extract``/``extractall`` is never called, which is
+    why archive permission, ownership, and timestamp metadata can never be
+    applied and why writing cannot begin before validation ends."""
+    for path in RUNTIME_SOURCES:
+        tree = ast.parse(path.read_text(encoding="utf-8"), str(path))
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
+                assert node.func.attr not in {"extract", "extractall"}, path
