+"""The protective default, the deliberate opt-in, and the type conflicts that are
+distinct from both.
+
+Covers FR-009, FR-010, FR-011, FR-012, and SC-006.
+"""
+
+import pytest
+
+import helpers
+
+
+@pytest.fixture
+def archive(tmp_path):
+    """Two regular files inside a directory, plus one at the top level."""
+    return helpers.write_archive(
+        tmp_path / "payload.tar",
+        [
+            helpers.dir_member("d/"),
+            helpers.file_member("d/a.txt", b"archived-a"),
+            helpers.file_member("d/b.txt", b"archived-b"),
+            helpers.file_member("top.txt", b"archived-top"),
+        ],
+    )
+
+
+def test_refuses_to_overwrite_an_existing_file(
+    run_cli, archive, tmp_path, snapshot_tree
+):
+    """FR-009: without ``--overwrite`` an existing regular file at a mapped path
+    means nothing is written, the path is named on stderr, no success line is
+    printed, and the status is 3 (SC-006)."""
+    dest = tmp_path / "out"
+    (dest / "d").mkdir(mode=0o700, parents=True)
+    (dest / "d" / "b.txt").write_bytes(b"pre-existing")
+    before = snapshot_tree(dest)
+
+    result = run_cli(["extract", str(archive), str(dest)])
+
+    assert result.status == 3
+    assert result.stdout == ""
+    assert "extracted" not in result.stdout
+    assert str(dest / "d" / "b.txt") in result.stderr
+    assert snapshot_tree(dest) == before
+    assert (dest / "d" / "b.txt").read_bytes() == b"pre-existing"
+    assert not (dest / "d" / "a.txt").exists()
+    assert not (dest / "top.txt").exists()
+
+
+def test_overwrite_conflict_message_mentions_the_opt_in(run_cli, archive, tmp_path):
+    """FR-017: the message tells the operator what would permit the write."""
+    dest = tmp_path / "out"
+    (dest / "d").mkdir(mode=0o700, parents=True)
+    (dest / "d" / "a.txt").write_bytes(b"pre-existing")
+    result = run_cli(["extract", str(archive), str(dest)])
+    assert result.status == 3
+    assert "--overwrite" in result.stderr
+
+
+def test_only_the_first_conflicting_path_is_reported(
+    run_cli, archive, tmp_path, snapshot_tree
+):
+    """FR-009: with several conflicts, the message names only the *first* one in
+    archive order."""
+    dest = tmp_path / "out"
+    (dest / "d").mkdir(mode=0o700, parents=True)
+    (dest / "d" / "a.txt").write_bytes(b"first-conflict")
+    (dest / "d" / "b.txt").write_bytes(b"second-conflict")
+    (dest / "top.txt").write_bytes(b"third-conflict")
+    before = snapshot_tree(dest)
+
+    result = run_cli(["extract", str(archive), str(dest)])
+
+    assert result.status == 3
+    assert str(dest / "d" / "a.txt") in result.stderr
+    assert str(dest / "d" / "b.txt") not in result.stderr
+    assert str(dest / "top.txt") not in result.stderr
+    assert result.stderr.count("\n") == 1
+    assert snapshot_tree(dest) == before
+
+
+def test_overwrite_replaces_contents_and_counts_every_file(
+    run_cli, archive, tmp_path
+):
+    """FR-010, FR-019: ``--overwrite`` replaces existing contents and the success
+    line counts every regular file written, not only the replaced ones."""
+    dest = tmp_path / "out"
+    (dest / "d").mkdir(mode=0o700, parents=True)
+    (dest / "d" / "a.txt").write_bytes(b"stale-and-longer-than-the-replacement")
+
+    result = run_cli(["extract", str(archive), str(dest), "--overwrite"])
+
+    assert result.status == 0
+    assert result.stdout == "extracted 3 files\n"
+    assert result.stderr == ""
+    assert (dest / "d" / "a.txt").read_bytes() == b"archived-a"
+    assert (dest / "d" / "b.txt").read_bytes() == b"archived-b"
+    assert (dest / "top.txt").read_bytes() == b"archived-top"
+
+
+def test_extract_twice_then_overwrite(run_cli, archive, tmp_path, snapshot_tree):
+    """FR-009, FR-010: the three-run journey — success, refusal with an untouched
+    destination, then a deliberate overwrite."""
+    dest = tmp_path / "out"
+
+    first = run_cli(["extract", str(archive), str(dest)])
+    assert first.status == 0
+    assert first.stdout == "extracted 3 files\n"
+    after_first = snapshot_tree(dest)
+
+    second = run_cli(["extract", str(archive), str(dest)])
+    assert second.status == 3
+    assert second.stdout == ""
+    assert snapshot_tree(dest) == after_first
+
+    third = run_cli(["extract", str(archive), str(dest), "--overwrite"])
+    assert third.status == 0
+    assert third.stdout == "extracted 3 files\n"
+    assert snapshot_tree(dest) == after_first
+
+
+def test_existing_directories_are_reused_without_error(run_cli, archive, tmp_path):
+    """FR-012: overwrite protection applies to regular files only — pre-existing
+    directories are reused silently, with no message and no ``--overwrite``."""
+    dest = tmp_path / "out"
+    (dest / "d").mkdir(mode=0o700, parents=True)
+
+    result = run_cli(["extract", str(archive), str(dest)])
+
+    assert result.status == 0
+    assert result.stdout == "extracted 3 files\n"
+    assert result.stderr == ""
+    assert (dest / "d" / "a.txt").read_bytes() == b"archived-a"
+
+
+@pytest.mark.parametrize("extra", [[], ["--overwrite"]], ids=["default", "overwrite"])
+def test_file_member_onto_existing_directory_is_a_type_conflict(
+    run_cli, archive, tmp_path, snapshot_tree, extra
+):
+    """FR-011: a file member whose path already exists as a directory is a type
+    conflict — exit 2, destination unchanged, with or without ``--overwrite``."""
+    dest = tmp_path / "out"
+    (dest / "d" / "a.txt").mkdir(mode=0o700, parents=True)
+    before = snapshot_tree(dest)
+
+    result = run_cli(["extract", str(archive), str(dest)] + extra)
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert str(dest / "d" / "a.txt") in result.stderr
+    assert "directory" in result.stderr
+    assert snapshot_tree(dest) == before
+
+
+@pytest.mark.parametrize("extra", [[], ["--overwrite"]], ids=["default", "overwrite"])
+def test_directory_member_onto_existing_file_is_a_type_conflict(
+    run_cli, archive, tmp_path, snapshot_tree, extra
+):
+    """FR-011: a directory member whose path already exists as a regular file is a
+    type conflict — exit 2, destination unchanged, with or without
+    ``--overwrite``."""
+    dest = tmp_path / "out"
+    dest.mkdir(mode=0o700)
+    (dest / "d").write_bytes(b"a file where a directory should be")
+    before = snapshot_tree(dest)
+
+    result = run_cli(["extract", str(archive), str(dest)] + extra)
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert str(dest / "d") in result.stderr
+    assert snapshot_tree(dest) == before
+    assert (dest / "d").read_bytes() == b"a file where a directory should be"
+
+
+def test_type_conflict_is_status_2_not_3(run_cli, archive, tmp_path):
+    """FR-011, FR-015: a type conflict is never reported as an overwrite conflict,
+    so a script can tell the two apart."""
+    dest = tmp_path / "out"
+    (dest / "d" / "a.txt").mkdir(mode=0o700, parents=True)
+    result = run_cli(["extract", str(archive), str(dest)])
+    assert result.status == 2
+
+
+# --- --overwrite relaxes case 10 and nothing else ---------------------------
+
+
+def _hostile_archives(tmp_path):
+    """One archive per contracts/cli.md failure case that ``--overwrite`` must not
+    suppress."""
+    return {
+        "traversal": helpers.write_archive(
+            tmp_path / "traversal.tar", [helpers.file_member("../esc.txt", b"x")]
+        ),
+        "absolute": helpers.write_archive(
+            tmp_path / "absolute.tar", [helpers.file_member("/abs.txt", b"x")]
+        ),
+        "symlink-member": helpers.write_archive(
+            tmp_path / "symlink.tar", [helpers.symlink_member("link")]
+        ),
+        "device-member": helpers.write_archive(
+            tmp_path / "device.tar", [helpers.chardev_member("dev/zero")]
+        ),
+        "duplicate": helpers.write_archive(
+            tmp_path / "duplicate.tar",
+            [helpers.file_member("a/b", b"one"), helpers.file_member("./a/b", b"two")],
+        ),
+        "exceeded-bound": helpers.build_declared_sizes(
+            tmp_path / "bound.tar", [("big.bin", (1 << 30) + 1)]
+        ),
+        "invalid-archive": helpers.build_garbage(tmp_path / "garbage.tar"),
+    }
+
+
+@pytest.mark.parametrize(
+    "case",
+    [
+        "traversal",
+        "absolute",
+        "symlink-member",
+        "device-member",
+        "duplicate",
+        "exceeded-bound",
+        "invalid-archive",
+    ],
+)
+def test_overwrite_does_not_suppress_any_other_refusal(
+    run_cli, tmp_path, snapshot_tree, case
+):
+    """FR-010, SC-006: ``--overwrite`` changes only the existing-regular-file case.
+    Every other refusal in the contract's failure table still exits 2 and still
+    leaves the destination unchanged when the flag is given."""
+    archives = _hostile_archives(tmp_path)
+    dest = tmp_path / "dest"
+    dest.mkdir(mode=0o700)
+    (dest / "bystander.txt").write_bytes(b"untouched")
+    before = snapshot_tree(dest)
+
+    result = run_cli(["extract", str(archives[case]), str(dest), "--overwrite"])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert result.stderr != ""
+    assert snapshot_tree(dest) == before
+    assert not (tmp_path / "esc.txt").exists()
+    assert not (tmp_path / "abs.txt").exists()
+
+
+def test_overwrite_still_refuses_a_symlink_at_the_target_path(
+    run_cli, tmp_path, snapshot_tree
+):
+    """FR-010, SR-004: ``--overwrite`` permits replacing a regular file, never a
+    symbolic link — the link's target is left alone."""
+    outside = tmp_path / "outside.txt"
+    outside.write_bytes(b"original")
+    dest = tmp_path / "dest"
+    dest.mkdir(mode=0o700)
+    (dest / "a.txt").symlink_to(outside)
+    before = snapshot_tree(dest)
+
+    archive = helpers.build_files(tmp_path / "payload.tar", {"a.txt": b"replacement"})
+    result = run_cli(["extract", str(archive), str(dest), "--overwrite"])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert snapshot_tree(dest) == before
+    assert outside.read_bytes() == b"original"
