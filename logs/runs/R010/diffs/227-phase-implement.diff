@@ -0,0 +1,91 @@
+"""Performance and memory bounds.
+
+Covers SC-007 and contract invariant 8 ("no member's contents are ever held whole
+in memory").
+"""
+
+import time
+import tracemalloc
+
+import helpers
+
+#: SC-007's corpus: a 1,000-member, ~50 MB archive.
+MEMBER_COUNT = 1_000
+MEMBER_BYTES = 50_000
+
+#: SC-007's budget.
+TIME_BUDGET_SECONDS = 5.0
+
+
+def _large_archive(path):
+    """Build the SC-007 archive. Contents vary per member so a compressing
+    filesystem cannot flatter the measurement."""
+    specs = [
+        helpers.file_member(
+            f"tree/{i // 100:02d}/member{i:04d}.bin",
+            bytes((i + j) % 256 for j in range(256)) * (MEMBER_BYTES // 256),
+        )
+        for i in range(MEMBER_COUNT)
+    ]
+    return helpers.write_archive(path, specs)
+
+
+def test_list_and_extract_a_1000_member_50mb_archive_within_budget(
+    run_cli, tmp_path
+):
+    """SC-007: listing or extracting a 1,000-member, 50 MB archive completes in
+    under 5 seconds."""
+    archive = _large_archive(tmp_path / "big.tar")
+    assert archive.stat().st_size > 45_000_000
+
+    started = time.monotonic()
+    listed = run_cli(["list", str(archive)])
+    list_seconds = time.monotonic() - started
+    assert listed.status == 0
+    assert len(listed.stdout.splitlines()) == MEMBER_COUNT
+    assert list_seconds < TIME_BUDGET_SECONDS, f"list took {list_seconds:.2f}s"
+
+    started = time.monotonic()
+    extracted = run_cli(["extract", str(archive), str(tmp_path / "out")])
+    extract_seconds = time.monotonic() - started
+    assert extracted.status == 0
+    assert extracted.stdout == f"extracted {MEMBER_COUNT} files\n"
+    assert extract_seconds < TIME_BUDGET_SECONDS, f"extract took {extract_seconds:.2f}s"
+
+
+def test_no_member_is_held_whole_in_memory(run_cli, tmp_path):
+    """SC-007, invariant 8: extracting a member far larger than the copy chunk
+    keeps peak memory far below the member's size, proving the contents are
+    streamed rather than materialised."""
+    member_size = 16 * 1024 * 1024
+    archive = helpers.build_files(
+        tmp_path / "huge.tar", {"huge.bin": b"\xa5" * member_size}
+    )
+
+    tracemalloc.start()
+    try:
+        result = run_cli(["extract", str(archive), str(tmp_path / "out")])
+        _current, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+
+    assert result.status == 0
+    assert (tmp_path / "out" / "huge.bin").stat().st_size == member_size
+    assert peak < member_size // 4, f"peak traced memory was {peak} bytes"
+
+
+def test_listing_a_large_archive_stays_within_bounded_memory(run_cli, tmp_path):
+    """SC-007: ``list`` holds member names, which ``MAX_MEMBERS`` already bounds,
+    and never a member's contents."""
+    archive = _large_archive(tmp_path / "big.tar")
+
+    tracemalloc.start()
+    try:
+        result = run_cli(["list", str(archive)])
+        _current, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+
+    assert result.status == 0
+    # Names plus the captured stdout, nowhere near the archive's ~50 MB.
+    assert peak < 8 * 1024 * 1024, f"peak traced memory was {peak} bytes"
