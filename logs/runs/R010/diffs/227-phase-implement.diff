+
+@pytest.mark.parametrize(
+    "builder",
+    ["missing", "garbage", "truncated", "zero_byte", "gzip_garbage"],
+    ids=["missing", "arbitrary-binary", "truncated", "zero-byte", "gzip-garbage"],
+)
+def test_extract_invalid_archive_creates_no_files_in_a_fresh_dest(
+    run_cli, tmp_path, snapshot_tree, builder
+):
+    """FR-013, FR-014: with a destination that did not exist, DEST itself may be
