index 0000000..46c5d74
--- /dev/null
+++ b/tests/test_security.py
@@ -0,0 +1,453 @@
+"""The adversarial corpus.
+
+Every test here runs a hostile archive and asserts both the refusal *and* that
+the destination's contents are unchanged (SC-005, SC-006).
+
+Covers SR-001, SR-002, SR-003, SR-004, SR-006, SR-007, SR-008, SR-009.
+"""
+
+import os
+import stat
+
+import pytest
+
+import helpers
+
+TRACEBACK_MARKERS = ("Traceback (most recent call last)", ", line ", "File \"")
+
+#: Member names that must never be mapped inside the destination (SR-001).
+ESCAPING_NAMES = [
+    pytest.param("../esc.txt", id="parent-traversal"),
+    pytest.param("a/../../esc.txt", id="traversal-through-subdirectory"),
+    pytest.param("/abs.txt", id="absolute-posix"),
+    pytest.param("\\abs.txt", id="leading-backslash"),
+    pytest.param("\\\\server\\share\\x.txt", id="unc-prefix"),
+    pytest.param("C:\\x.txt", id="drive-letter"),
+    pytest.param("..", id="bare-dotdot"),
+    pytest.param("", id="empty-name"),
+]
+
+
+@pytest.fixture
+def prepared_dest(tmp_path, snapshot_tree):
+    """A destination holding one innocent file, snapshotted before the run.
+
+    Returning a non-empty destination is deliberate: an empty one could not tell
+    "nothing was written" apart from "everything was deleted".
+    """
+    dest = tmp_path / "dest"
+    dest.mkdir(mode=0o700)
+    (dest / "bystander.txt").write_bytes(b"untouched")
+    return dest
+
+
+# --- SR-001: path containment ----------------------------------------------
+
+
+@pytest.mark.parametrize("name", ESCAPING_NAMES)
+def test_refuses_member_escaping_the_destination(
+    run_cli, tmp_path, snapshot_tree, prepared_dest, name
+):
+    """SR-001: a member whose path does not lie inside DEST is refused, nothing
+    is written, and the payload provably never appears outside DEST."""
+    archive = helpers.write_archive(
+        tmp_path / "escape.tar", [helpers.file_member(name, b"pwned")]
+    )
+    before = snapshot_tree(prepared_dest)
+    result = run_cli(["extract", str(archive), str(prepared_dest)])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert result.stderr != ""
+    assert snapshot_tree(prepared_dest) == before
+    assert not (tmp_path / "esc.txt").exists()
+    assert not (tmp_path / "abs.txt").exists()
+    assert not (tmp_path / "x.txt").exists()
+
+
+@pytest.mark.parametrize("name", ESCAPING_NAMES[:6])
+def test_escaping_member_is_named_in_the_message(
+    run_cli, tmp_path, snapshot_tree, prepared_dest, name
+):
+    """SR-001, FR-017, SC-006: the refusal names the offending member, and the
+    destination is byte-for-byte unchanged."""
+    archive = helpers.write_archive(
+        tmp_path / "escape.tar", [helpers.file_member(name, b"pwned")]
+    )
+    before = snapshot_tree(prepared_dest)
+    result = run_cli(["extract", str(archive), str(prepared_dest)])
+    assert result.status == 2
+    assert snapshot_tree(prepared_dest) == before
+    # The name is escaped for display; its printable tail is still identifiable.
+    assert name.split("\\")[-1].split("/")[-1] in result.stderr
+
+
+def test_leading_dot_components_are_dropped_not_refused(run_cli, tmp_path):
+    """SR-001: ``./x`` is the conventional output of ``tar -cf`` and is accepted,
+    mapping to ``x`` — only ``..`` is refused."""
+    archive = helpers.build_files(tmp_path / "dotted.tar", {"./a/b.txt": b"dotted"})
+    dest = tmp_path / "out"
+    result = run_cli(["extract", str(archive), str(dest)])
+    assert result.status == 0
+    assert (dest / "a" / "b.txt").read_bytes() == b"dotted"
+
+
+# --- SR-002: links are refused, never created, never skipped ----------------
+
+
+@pytest.mark.parametrize(
+    "member",
+    [
+        pytest.param(helpers.symlink_member("link.txt", "../../etc/passwd"), id="symlink"),
+        pytest.param(helpers.hardlink_member("hard.txt", "a.txt"), id="hardlink"),
+    ],
+)
+def test_refuses_link_members(
+    run_cli, tmp_path, snapshot_tree, prepared_dest, member
+):
+    """SR-002: a symbolic- or hard-link member is refused by name, never silently
+    skipped, and no link is created anywhere."""
+    archive = helpers.write_archive(
+        tmp_path / "links.tar", [helpers.file_member("a.txt", b"alpha"), member]
+    )
+    before = snapshot_tree(prepared_dest)
+    result = run_cli(["extract", str(archive), str(prepared_dest)])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert member.info.name in result.stderr
+    assert snapshot_tree(prepared_dest) == before
+    # Not skipped: the *other*, valid member was not written either (FR-014).
+    assert not (prepared_dest / "a.txt").exists()
+    for _, (kind, _value) in before.items():
+        assert kind != "symlink"
+
+
+def test_link_member_rejection_mentions_its_kind(run_cli, tmp_path, prepared_dest):
+    """SR-002, FR-017: the message says what the member actually is."""
+    archive = helpers.write_archive(
+        tmp_path / "sym.tar", [helpers.symlink_member("link.txt")]
+    )
+    result = run_cli(["extract", str(archive), str(prepared_dest)])
+    assert result.status == 2
+    assert "symbolic link" in result.stderr
+
+
+# --- SR-003: special files are refused --------------------------------------
+
+
+@pytest.mark.parametrize(
+    "member,kind_text",
+    [
+        pytest.param(helpers.chardev_member("dev/zero"), "character device", id="chrdev"),
+        pytest.param(helpers.blockdev_member("dev/sda"), "block device", id="blkdev"),
+        pytest.param(helpers.fifo_member("pipe"), "FIFO", id="fifo"),
+    ],
+)
+def test_refuses_special_file_members(
+    run_cli, tmp_path, snapshot_tree, prepared_dest, member, kind_text
+):
+    """SR-003: a device, FIFO, or otherwise unsupported member is refused, naming
+    the member and its kind."""
+    archive = helpers.write_archive(tmp_path / "special.tar", [member])
+    before = snapshot_tree(prepared_dest)
+    result = run_cli(["extract", str(archive), str(prepared_dest)])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert member.info.name in result.stderr
+    assert kind_text in result.stderr
+    assert snapshot_tree(prepared_dest) == before
+
+
+def test_member_of_an_unreadable_type_is_refused(
+    run_cli, tmp_path, snapshot_tree, prepared_dest
+):
+    """SR-003: a member carrying a type flag outside the tar format is refused —
+    ``tarfile`` cannot even parse the header, so the archive itself is rejected,
+    which is still exit 2 with nothing written."""
+    archive = helpers.write_archive(
+        tmp_path / "mystery.tar", [helpers.unknown_type_member("mystery")]
+    )
+    before = snapshot_tree(prepared_dest)
+    result = run_cli(["extract", str(archive), str(prepared_dest)])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert str(archive) in result.stderr
+    assert snapshot_tree(prepared_dest) == before
+
+
+def test_unsupported_kind_description_has_a_catch_all(tmp_path):
+    """SR-003: the kind description names every type the format can carry and
+    falls back to a generic phrase, so no member type can slip through unnamed."""
+    import tarfile as _tarfile
+
+    from tarx import extract as extract_mod
+
+    cases = {
+        _tarfile.SYMTYPE: "symbolic link",
+        _tarfile.LNKTYPE: "hard link",
+        _tarfile.CHRTYPE: "character device",
+        _tarfile.BLKTYPE: "block device",
+        _tarfile.FIFOTYPE: "FIFO",
+        b"X": "unsupported member type",
+    }
+    for typeflag, expected in cases.items():
+        info = _tarfile.TarInfo("m")
+        info.type = typeflag
+        assert expected in extract_mod._kind_description(info)
+
+
+# --- SR-004: never follow a symlink that already exists inside DEST ---------
+
+
+def test_refuses_symlink_as_path_component_inside_dest(
+    run_cli, tmp_path, snapshot_tree
+):
+    """SR-004: an existing symlink inside DEST is refused rather than followed,
+    nothing is written, and the symlink's target is untouched."""
+    outside = tmp_path / "outside"
+    outside.mkdir(mode=0o700)
+    (outside / "a.txt").write_bytes(b"original")
+
+    dest = tmp_path / "dest"
+    dest.mkdir(mode=0o700)
+    (dest / "sub").symlink_to(outside, target_is_directory=True)
+
+    archive = helpers.build_files(tmp_path / "sneaky.tar", {"sub/a.txt": b"hijacked"})
+    before = snapshot_tree(dest)
+    result = run_cli(["extract", str(archive), str(dest)])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "sub/a.txt" in result.stderr
+    assert snapshot_tree(dest) == before
+    assert (outside / "a.txt").read_bytes() == b"original"
+
+
+def test_refuses_symlink_at_the_member_path_itself(run_cli, tmp_path, snapshot_tree):
+    """SR-004: the final component being an existing symlink is refused too."""
+    outside = tmp_path / "outside.txt"
+    outside.write_bytes(b"original")
+    dest = tmp_path / "dest"
+    dest.mkdir(mode=0o700)
+    (dest / "a.txt").symlink_to(outside)
+
+    archive = helpers.build_files(tmp_path / "sneaky.tar", {"a.txt": b"hijacked"})
+    before = snapshot_tree(dest)
+    for argv_extra in ([], ["--overwrite"]):
+        result = run_cli(
+            ["extract", str(archive), str(dest)] + argv_extra
+        )
+        assert result.status == 2
+        assert result.stdout == ""
+        assert snapshot_tree(dest) == before
+        assert outside.read_bytes() == b"original"
+
+
+def test_symlinked_dest_supplied_by_the_user_is_honoured(run_cli, tmp_path):
+    """SR-004: the boundary is the user's choice — a symlinked DEST works; what is
+    refused is a symlink *inside* it."""
+    real = tmp_path / "real"
+    real.mkdir(mode=0o700)
+    dest = tmp_path / "dest-link"
+    dest.symlink_to(real, target_is_directory=True)
+
+    archive = helpers.build_files(tmp_path / "ok.tar", {"a.txt": b"alpha"})
+    result = run_cli(["extract", str(archive), str(dest)])
+    assert result.status == 0
+    assert (real / "a.txt").read_bytes() == b"alpha"
+
+
+# --- SR-006: narrowest permissions, set at creation -------------------------
+
+
+def test_created_entries_have_narrowest_permissions(run_cli, tmp_path):
+    """SR-006: files are 0o600 and directories 0o700; archive mode bits, setuid,
+    setgid, and sticky are never applied, and timestamps are not restored."""
+    previous_umask = os.umask(0o022)
+    try:
+        archive = helpers.write_archive(
+            tmp_path / "modes.tar",
+            [
+                helpers.dir_member("d/", mode=0o7777),
+                helpers.file_member("d/f.txt", b"payload", mode=0o7777),
+            ],
+        )
+        dest = tmp_path / "out"
+        result = run_cli(["extract", str(archive), str(dest)])
+    finally:
+        os.umask(previous_umask)
+
+    assert result.status == 0
+    dir_mode = stat.S_IMODE((dest / "d").stat().st_mode)
+    file_mode = stat.S_IMODE((dest / "d" / "f.txt").stat().st_mode)
+    assert dir_mode == 0o700
+    assert file_mode == 0o600
+    for mode in (dir_mode, file_mode):
+        assert not mode & stat.S_ISUID
+        assert not mode & stat.S_ISGID
+        assert not mode & stat.S_ISVTX
+    # Timestamps and ownership are not restored: the archive records mtime 0.
+    assert (dest / "d" / "f.txt").stat().st_mtime > 0
+    assert (dest / "d" / "f.txt").stat().st_uid == os.getuid()
+
+
+def test_overwrite_also_never_applies_archive_modes(run_cli, tmp_path):
+    """SR-006: an overwriting write sets 0o600 at creation just the same."""
+    previous_umask = os.umask(0o022)
+    try:
+        archive = helpers.write_archive(
+            tmp_path / "modes.tar", [helpers.file_member("f.txt", b"new", mode=0o7777)]
+        )
+        dest = tmp_path / "out"
+        dest.mkdir(mode=0o700)
+        existing = dest / "f.txt"
+        existing.write_bytes(b"old")
+        existing.chmod(0o644)
+        result = run_cli(["extract", str(archive), str(dest), "--overwrite"])
+    finally:
+        os.umask(previous_umask)
+
+    assert result.status == 0
+    assert existing.read_bytes() == b"new"
+    assert stat.S_IMODE(existing.stat().st_mode) in (0o600, 0o644)
+    assert not stat.S_IMODE(existing.stat().st_mode) & stat.S_ISUID
+
+
+# --- SR-007: control characters in names are escaped on output --------------
+
+
+def test_control_characters_in_name_are_escaped_on_stdout(run_cli, tmp_path):
+    """SR-007: a crafted name cannot inject an extra output line or a terminal
+    control sequence — one member always occupies exactly one line."""
+    archive = helpers.write_archive(
+        tmp_path / "evil.tar",
+        [
+            helpers.file_member("evil\nextracted 99 files", b"x"),
+            helpers.file_member("boom\x1b[2J", b"x"),
+        ],
+    )
+    result = run_cli(["list", str(archive)])
+    assert result.status == 0
+    assert result.stdout.count("\n") == 2
+    assert "evil\\nextracted 99 files" in result.stdout
+    assert "boom\\x1b[2J" in result.stdout
+    assert "\x1b" not in result.stdout
+    assert "\r" not in result.stdout
+
+
+def test_control_characters_in_name_are_escaped_on_stderr(run_cli, tmp_path):
+    """SR-007: the same escaping applies to a member named in an error message."""
+    archive = helpers.write_archive(
+        tmp_path / "evil.tar", [helpers.symlink_member("bad\nname\x1b[2J")]
+    )
+    result = run_cli(["extract", str(archive), str(tmp_path / "out")])
+    assert result.status == 2
+    assert result.stderr.count("\n") == 1
+    assert "\x1b" not in result.stderr
+    assert "bad\\nname\\x1b[2J" in result.stderr
+
+
+def test_printable_non_ascii_names_are_printed_unchanged(run_cli, tmp_path):
+    """SR-007: names made only of printable characters are printed unchanged."""
+    archive = helpers.build_files(
+        tmp_path / "unicode.tar",
+        {"my photo ü.jpg": b"a", "\u6f22\u5b57.txt": b"b"},
+    )
+    result = run_cli(["list", str(archive)])
+    assert result.status == 0
+    assert result.stdout == "my photo ü.jpg\n\u6f22\u5b57.txt\n"
+
+
+# --- SR-008: output hygiene -------------------------------------------------
+
+
+def test_messages_leak_no_contents_no_environment_no_traceback(
+    run_cli, tmp_path, monkeypatch, prepared_dest
+):
+    """SR-008: no member contents, no environment variable values, and no
+    traceback text appears in any failure message."""
+    monkeypatch.setenv("TARX_TEST_SECRET", "s3cret-value-do-not-leak")
+    secret_payload = b"MEMBER-CONTENTS-DO-NOT-LEAK"
+    archives = [
+        helpers.write_archive(
+            tmp_path / "traversal.tar",
+            [helpers.file_member("../esc.txt", secret_payload)],
+        ),
+        helpers.write_archive(
+            tmp_path / "symlink.tar", [helpers.symlink_member("link")]
+        ),
+        helpers.write_archive(
+            tmp_path / "device.tar", [helpers.chardev_member("dev/zero")]
+        ),
+        helpers.build_garbage(tmp_path / "garbage.tar"),
+        helpers.build_gzip_garbage(tmp_path / "badgz.tar.gz"),
+        helpers.write_archive(
+            tmp_path / "duplicate.tar",
+            [
+                helpers.file_member("a/b", secret_payload),
+                helpers.file_member("./a/b", secret_payload),
+            ],
+        ),
+    ]
+    for archive in archives:
+        for argv in (
+            ["list", str(archive)],
+            ["extract", str(archive), str(prepared_dest)],
+        ):
+            result = run_cli(argv)
+            if result.status == 0:
+                continue
+            assert "MEMBER-CONTENTS-DO-NOT-LEAK" not in result.stderr
+            assert "s3cret-value-do-not-leak" not in result.stderr
+            assert "TARX_TEST_SECRET" not in result.stderr
+            for marker in TRACEBACK_MARKERS:
+                assert marker not in result.stderr, (argv, result.stderr)
+            assert result.stderr.count("\n") == 1
+
+
+# --- SR-009: two members, one destination path ------------------------------
+
+
+@pytest.mark.parametrize(
+    "first,second",
+    [
+        pytest.param("a/b", "./a/b", id="dot-prefixed-duplicate"),
+        pytest.param("a/b", "a//b", id="double-slash-duplicate"),
+        pytest.param("a/b", "a/b", id="identical-duplicate"),
+    ],
+)
+def test_refuses_two_members_mapping_to_one_path(
+    run_cli, tmp_path, snapshot_tree, prepared_dest, first, second
+):
+    """SR-009: a second member claiming an already-claimed destination path is
+    refused, naming both members and the path, with nothing written."""
+    archive = helpers.write_archive(
+        tmp_path / "duplicate.tar",
+        [helpers.file_member(first, b"one"), helpers.file_member(second, b"two")],
+    )
+    before = snapshot_tree(prepared_dest)
+    result = run_cli(["extract", str(archive), str(prepared_dest)])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert first in result.stderr
+    assert second in result.stderr
+    assert str(prepared_dest / "a" / "b") in result.stderr
+    assert snapshot_tree(prepared_dest) == before
+
+
+def test_duplicate_rejection_is_not_relaxed_by_overwrite(
+    run_cli, tmp_path, snapshot_tree, prepared_dest
+):
+    """SR-009: ``--overwrite`` does not permit the FR-009 bypass it protects."""
+    archive = helpers.write_archive(
+        tmp_path / "duplicate.tar",
+        [helpers.file_member("a/b", b"one"), helpers.file_member("./a/b", b"two")],
+    )
+    before = snapshot_tree(prepared_dest)
+    result = run_cli(["extract", str(archive), str(prepared_dest), "--overwrite"])
+    assert result.status == 2
+    assert snapshot_tree(prepared_dest) == before
