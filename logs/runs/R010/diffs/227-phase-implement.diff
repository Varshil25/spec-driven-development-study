+    elif builder == "truncated":
+        helpers.build_truncated(archive)
+    elif builder == "gzip_garbage":
+        helpers.build_gzip_garbage(archive)
+    elif builder == "zero_byte":
+        archive.write_bytes(b"")
+
+    dest = tmp_path / "out"
+    result = run_cli(["extract", str(archive), str(dest)])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert snapshot_tree(dest) in (None, {})
+
+
+def test_extract_dest_exists_as_regular_file(run_cli, photos_gz, tmp_path):
+    """FR-007: a destination that exists and is not a directory exits 2 naming
