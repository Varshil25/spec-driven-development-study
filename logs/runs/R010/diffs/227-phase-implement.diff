+"""The requirement-coverage gate.
+
+Covers SC-008 and constitution Principle III: every ``FR-xxx`` and ``SR-xxx``
+identifier in the specification must appear in the name or docstring of at least
+one automated test. This turns the spec-to-test mapping from a convention that
+drifts into a check that fails when it does (research.md R-015).
+"""
+
+import ast
+import re
+from pathlib import Path
+
+import pytest
+
+TESTS_DIR = Path(__file__).resolve().parent
+REPO_ROOT = TESTS_DIR.parent
+SPEC_PATHS = sorted(REPO_ROOT.glob("specs/*/spec.md"))
+
+#: The identifier shapes the constitution requires to be covered by tests.
+IDENTIFIER = re.compile(r"\b(?:FR|SR)-\d{3}\b")
+
+
+def _specified_identifiers():
+    """Every FR-xxx/SR-xxx identifier the specifications define."""
+    found = set()
+    for spec in SPEC_PATHS:
+        found.update(IDENTIFIER.findall(spec.read_text(encoding="utf-8")))
+    return found
+
+
+def _identifiers_referenced_by_tests():
+    """Identifiers appearing in a test function's name or docstring.
+
+    Deliberately narrower than grepping the whole file: SC-008 asks for the
+    identifier to be carried by a *test*, so a passing mention in a helper or a
+    comment does not count as coverage.
+    """
+    found = set()
+    for module_path in sorted(TESTS_DIR.glob("test_*.py")):
+        tree = ast.parse(module_path.read_text(encoding="utf-8"), str(module_path))
+        for node in ast.walk(tree):
+            if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                continue
+            if not node.name.startswith("test"):
+                continue
+            found.update(IDENTIFIER.findall(node.name))
+            docstring = ast.get_docstring(node) or ""
+            found.update(IDENTIFIER.findall(docstring))
+    return found
+
+
+def test_specifications_were_found():
+    """SC-008: the gate is worthless if it silently finds no specification."""
+    assert SPEC_PATHS, "no specs/*/spec.md found to check against"
+    assert _specified_identifiers(), "no FR-xxx/SR-xxx identifiers found in the spec"
+
+
+def test_every_requirement_identifier_is_referenced_by_a_test():
+    """SC-008: 100% auditable requirement coverage — every FR-xxx and SR-xxx in
+    the specification is named by at least one test (Principle III)."""
+    specified = _specified_identifiers()
+    referenced = _identifiers_referenced_by_tests()
+    unreferenced = sorted(specified - referenced)
+    assert not unreferenced, (
+        "these requirement identifiers have no test naming them: "
+        + ", ".join(unreferenced)
+    )
+
+
+def test_no_test_claims_an_identifier_the_spec_does_not_define():
+    """SC-008: coverage claims are checked in both directions, so a typo in a
+    docstring cannot silently stand in for real coverage."""
+    specified = _specified_identifiers()
+    referenced = _identifiers_referenced_by_tests()
+    invented = sorted(referenced - specified)
+    assert not invented, (
+        "these identifiers are claimed by tests but are not in the spec: "
+        + ", ".join(invented)
+    )