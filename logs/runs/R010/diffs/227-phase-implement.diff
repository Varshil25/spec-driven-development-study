+"""Resource bounds: the member cap, the declared-size caps, and the actual-byte
+counter that catches an archive whose headers understate its real size.
+
+Covers SR-005 (and SC-006's single documented exception to it).
+"""
+
+import io
+import tarfile
+
+import pytest
+
+import helpers
+from tarx import archive as archive_mod
+
+
+def test_bounds_have_their_specified_values():
+    """SR-005: the three bounds are fixed constants with the documented values —
+    10,000 members, 1 GiB total, 1 GiB per member."""
+    assert archive_mod.MAX_MEMBERS == 10_000
+    assert archive_mod.MAX_TOTAL_BYTES == 1 << 30
+    assert archive_mod.MAX_MEMBER_BYTES == 1 << 30
+    assert archive_mod.COPY_CHUNK_BYTES == 64 * 1024
+
+
+@pytest.fixture
+def dest(tmp_path):
+    """A destination holding one innocent file, so "nothing written" is provable."""
+    directory = tmp_path / "dest"
+    directory.mkdir(mode=0o700)
+    (directory / "bystander.txt").write_bytes(b"untouched")
+    return directory
+
+
+def test_extract_refuses_archive_over_the_member_cap(
+    run_cli, tmp_path, dest, snapshot_tree
+):
+    """SR-005: 10,001 members exceeds the cap — exit 2 naming the bound, nothing
+    written."""
+    archive = helpers.build_many_members(tmp_path / "many.tar", 10_001)
+    before = snapshot_tree(dest)
+    result = run_cli(["extract", str(archive), str(dest)])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "10000" in result.stderr
+    assert snapshot_tree(dest) == before
+
+
+def test_extract_accepts_an_archive_exactly_at_the_member_cap(run_cli, tmp_path):
+    """SR-005: the bound is inclusive — exactly 10,000 members is accepted, so the
+    refusal above is the cap firing rather than an off-by-one."""
+    archive = helpers.build_many_members(tmp_path / "exact.tar", 10_000)
+    result = run_cli(["extract", str(archive), str(tmp_path / "out")])
+    assert result.status == 0
+    assert result.stdout == "extracted 10000 files\n"
+
+
+def test_list_refuses_archive_over_the_member_cap(run_cli, tmp_path):
+    """SR-005: the bounds apply to ``list`` as well as ``extract``."""
+    archive = helpers.build_many_members(tmp_path / "many.tar", 10_001)
+    result = run_cli(["list", str(archive)])
+    assert result.status == 2
+    assert "10000" in result.stderr
+
+
+def test_extract_refuses_oversized_single_member(
+    run_cli, tmp_path, dest, snapshot_tree
+):
+    """SR-005: a member declaring more than 1 GiB is refused by its header, before
+    any write."""
+    archive = helpers.build_declared_sizes(
+        tmp_path / "big.tar", [("big.bin", (1 << 30) + 1)]
+    )
+    before = snapshot_tree(dest)
+    result = run_cli(["extract", str(archive), str(dest)])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "big.bin" in result.stderr
+    assert str(1 << 30) in result.stderr
+    assert snapshot_tree(dest) == before
+
+
+def test_extract_refuses_declared_sizes_summing_past_the_total(
+    run_cli, tmp_path, dest, snapshot_tree
+):
+    """SR-005: the running sum of declared sizes is bounded at 1 GiB total, even
+    when every individual member is within the per-member bound."""
+    archive = helpers.build_declared_sizes(
+        tmp_path / "sum.tar", [("a.bin", 1 << 30), ("b.bin", 1)]
+    )
+    before = snapshot_tree(dest)
+    result = run_cli(["extract", str(archive), str(dest)])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "b.bin" in result.stderr
+    assert snapshot_tree(dest) == before
+
+
+def test_list_refuses_declared_sizes_summing_past_the_total(run_cli, tmp_path):
+    """SR-005: the total-size bound applies to ``list`` too."""
+    archive = helpers.build_declared_sizes(
+        tmp_path / "sum.tar", [("a.bin", 1 << 30), ("b.bin", 1)]
+    )
+    result = run_cli(["list", str(archive)])
+    assert result.status == 2
+    assert result.stdout == ""
+
+
+def test_header_understating_content_never_writes_more_than_declared(
+    run_cli, tmp_path
+):
+    """SR-005: an archive whose header understates a member's real content length
+    can never cause more bytes to be written than the header declared.
+
+    The tar format locates every member by its header, so data beyond a member's
+    declared size is not part of any member; ``tarfile`` stops at the first block
+    that is not a valid header, exactly as ``tar`` itself does. What SR-005 needs
+    is the guarantee asserted here — the understatement cannot be turned into
+    unbounded writing — plus the actual-byte counter exercised below.
+    """
+    archive = helpers.build_understated_size(tmp_path / "trap.tar", declared=4)
+    dest = tmp_path / "out"
+    result = run_cli(["extract", str(archive), str(dest)])
+
+    assert result.status == 0
+    written = dest / "trap.txt"
+    assert written.stat().st_size == 4
+    assert b"X" * 5 not in written.read_bytes()
+
+
+def test_actual_byte_counter_aborts_and_reports_partial_extraction(
+    run_cli, tmp_path, monkeypatch
+):
+    """SR-005, SC-006: the Pass 2 actual-byte counter fires when a member's real
+    content exceeds a bound despite a conforming declared size, and its message
+    states the destination may hold a partial extraction.
+
+    ``tarfile``'s own ``ExFileObject`` truncates reads at the declared size
+    (research.md R-005), so the lying stream is injected here to exercise the
+    defence-in-depth counter that SR-005 requires regardless.
+    """
+    archive = helpers.build_files(tmp_path / "trap.tar", {"f.bin": b"abcd"})
+    monkeypatch.setattr(archive_mod, "MAX_MEMBER_BYTES", 8)
+
+    def lying_extractfile(self, member):
+        return io.BytesIO(b"Z" * 1000)
+
+    monkeypatch.setattr(tarfile.TarFile, "extractfile", lying_extractfile)
+
+    dest = tmp_path / "out"
+    result = run_cli(["extract", str(archive), str(dest)])
+
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "f.bin" in result.stderr
+    assert "partial extraction" in result.stderr
+
+
+def test_actual_byte_counter_bounds_the_running_total(run_cli, tmp_path, monkeypatch):
+    """SR-005: the *total* actual-byte bound is enforced in the copy loop too, not
+    only the per-member one — here only ``MAX_TOTAL_BYTES`` is lowered, so the
+    per-member bound cannot be what fires."""
+    archive = helpers.build_files(tmp_path / "trap.tar", {"a.bin": b"aa"})
+    monkeypatch.setattr(archive_mod, "MAX_TOTAL_BYTES", 5)
+    assert archive_mod.MAX_MEMBER_BYTES == 1 << 30
+
+    def lying_extractfile(self, member):
+        return io.BytesIO(b"Z" * 10)
+
+    monkeypatch.setattr(tarfile.TarFile, "extractfile", lying_extractfile)
+
+    result = run_cli(["extract", str(archive), str(tmp_path / "out")])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "partial extraction" in result.stderr
+
+
+def test_short_member_is_refused_rather_than_silently_truncated(
+    run_cli, tmp_path, monkeypatch
+):
+    """SR-005, FR-005: a member supplying fewer bytes than its header declared is
+    an error, never a silently truncated file."""
+    archive = helpers.build_files(tmp_path / "short.tar", {"a.bin": b"abcdefgh"})
+
+    def lying_extractfile(self, member):
+        return io.BytesIO(b"ab")
+
+    monkeypatch.setattr(tarfile.TarFile, "extractfile", lying_extractfile)
+
+    result = run_cli(["extract", str(archive), str(tmp_path / "out")])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert "a.bin" in result.stderr
+    assert "partial extraction" in result.stderr
+
+
+def test_actual_byte_abort_is_the_documented_exception_to_sc_006(
+    run_cli, tmp_path, monkeypatch
+):
+    """SR-005, SC-006: the actual-byte abort is the *single* case allowed to leave
+    the destination differing, and it must say so in its message.
+
+    Every other refusal asserts an unchanged destination; this one asserts the
+    opposite expectation explicitly, so the exception is a reviewed decision
+    rather than a gap in the other tests.
+    """
+    archive = helpers.build_files(tmp_path / "trap.tar", {"f.bin": b"abcd"})
+    monkeypatch.setattr(archive_mod, "MAX_MEMBER_BYTES", 8)
+
+    def lying_extractfile(self, member):
+        return io.BytesIO(b"Z" * 1000)
+
+    monkeypatch.setattr(tarfile.TarFile, "extractfile", lying_extractfile)
+
+    dest = tmp_path / "out"
+    result = run_cli(["extract", str(archive), str(dest)])
+
+    assert result.status == 2
+    assert "partial extraction" in result.stderr
+    # The partial file is permitted to exist here — and the message says so.
+    assert (dest / "f.bin").exists()
+
+
+def test_every_bound_refusal_is_an_error_never_a_truncated_result(
+    run_cli, tmp_path, dest
+):
+    """SR-005: exceeding a bound is always an error, never a best-effort partial
+    listing or a success line with a reduced count."""
+    archives = [
+        helpers.build_many_members(tmp_path / "many.tar", 10_001),
+        helpers.build_declared_sizes(tmp_path / "big.tar", [("b", (1 << 30) + 1)]),
+        helpers.build_declared_sizes(
+            tmp_path / "sum.tar", [("a", 1 << 30), ("b", 1)]
+        ),
+    ]
+    for archive in archives:
+        for argv in (
+            ["list", str(archive)],
+            ["extract", str(archive), str(dest)],
+        ):
+            result = run_cli(argv)
+            assert result.status == 2, argv
+            assert "extracted" not in result.stdout, argv
+            assert result.stderr != ""
