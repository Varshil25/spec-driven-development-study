+    }
+    archive = helpers.build_files(tmp_path / "awkward.tar", payload)
+    dest = tmp_path / "out"
+    result = run_cli(["extract", str(archive), str(dest)])
+    assert result.status == 0
+    assert result.stdout == f"extracted {len(payload)} files\n"
+    for name, data in payload.items():
+        assert (dest / name).read_bytes() == data
+
+
+@pytest.mark.parametrize(
+    "builder",
+    ["missing", "garbage", "truncated", "zero_byte", "gzip_garbage"],
+    ids=["missing", "arbitrary-binary", "truncated", "zero-byte", "gzip-garbage"],
+)
