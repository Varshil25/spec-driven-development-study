+"""Shared fixtures: archives built into ``tmp_path``, an in-process CLI runner,
+and the destination snapshotter that SC-006's before/after comparisons use.
+"""
+
+import io
+import os
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+from typing import NamedTuple
+
+import pytest
+
+import helpers
+from tarx import cli
+
+#: The canonical two-file payload used across the round-trip tests.
+PHOTOS = {"photos/a.jpg": b"alpha", "photos/b.jpg": b"beta"}
+
+
+class CliRun(NamedTuple):
+    """What one in-process invocation produced."""
+
+    status: int
+    stdout: str
+    stderr: str
+
+
+@pytest.fixture
+def run_cli():
+    """Invoke ``tarx.cli.main(argv)`` in-process, capturing both streams.
+
+    Returns the status ``main`` *returned* rather than a process exit code, which
+    is the same value ``__main__.py`` hands to ``SystemExit`` (R-004).
+    """
+
+    def _run(argv):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            status = cli.main(list(argv))
+        return CliRun(status, out.getvalue(), err.getvalue())
+
+    return _run
+
+
+@pytest.fixture
+def snapshot_tree():
+    """Snapshot a directory as ``{relative path: (kind, bytes-or-None)}``.
+
+    Uses ``lstat``/``islink`` so a symlink is recorded as itself rather than its
+    target, and stores file contents so the comparison is byte-for-byte rather
+    than merely structural (SC-006).
+    """
+
+    def _snapshot(root):
+        root = Path(root)
+        if not root.exists() and not root.is_symlink():
+            return None
+        tree = {}
+        for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
+            here = Path(dirpath)
+            for name in list(dirnames) + list(filenames):
+                path = here / name
+                rel = str(path.relative_to(root))
+                if path.is_symlink():
+                    tree[rel] = ("symlink", os.readlink(path).encode())
+                elif path.is_dir():
+                    tree[rel] = ("dir", None)
+                elif path.is_file():
+                    tree[rel] = ("file", path.read_bytes())
+                else:
+                    tree[rel] = ("other", None)
+        return tree
+
+    return _snapshot
+
+
+@pytest.fixture
+def photos_gz(tmp_path):
+    """A gzip-compressed archive: ``photos/``, ``photos/a.jpg``, ``photos/b.jpg``."""
+    specs = [helpers.dir_member("photos/")] + [
+        helpers.file_member(name, data) for name, data in PHOTOS.items()
+    ]
+    return helpers.write_archive(tmp_path / "photos.tar.gz", specs, compressed=True)
+
+
+@pytest.fixture
+def photos_tar(tmp_path):
+    """The uncompressed equivalent of :func:`photos_gz`."""
+    specs = [helpers.dir_member("photos/")] + [
+        helpers.file_member(name, data) for name, data in PHOTOS.items()
+    ]
+    return helpers.write_archive(tmp_path / "photos.tar", specs)
+
+
+@pytest.fixture
+def empty_archive(tmp_path):
+    """A valid archive with no members at all (FR-018)."""
+    return helpers.build_empty(tmp_path / "empty.tar")
