+"""Listing: archive order, every member type, and provable non-destructiveness.
+
+Covers FR-002, FR-003, FR-008, FR-018, SR-005, SR-007.
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+import helpers
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+def test_list_prints_names_in_archive_order(run_cli, tmp_path):
+    """FR-002: stdout is exactly the member names, one per line, in archive order."""
+    archive = helpers.write_archive(
+        tmp_path / "photos.tar.gz",
+        [
+            helpers.file_member("photos/a.jpg", b"alpha"),
+            helpers.file_member("photos/b.jpg", b"beta"),
+        ],
+        compressed=True,
+    )
+    result = run_cli(["list", str(archive)])
+    assert result.status == 0
+    assert result.stdout == "photos/a.jpg\nphotos/b.jpg\n"
+    assert result.stderr == ""
+
+
+def test_list_preserves_a_non_alphabetical_archive_order(run_cli, tmp_path):
+    """FR-002: the order is the archive's, not a sorted one."""
+    names = ["z.txt", "m.txt", "a.txt", "nested/b.txt", "nested/a.txt"]
+    archive = helpers.write_archive(
+        tmp_path / "ordered.tar", [helpers.file_member(n, b"x") for n in names]
+    )
+    result = run_cli(["list", str(archive)])
+    assert result.status == 0
+    assert result.stdout == "".join(f"{n}\n" for n in names)
+
+
+def test_list_includes_every_member_type(run_cli, tmp_path):
+    """FR-003: every member name is printed regardless of type — directories,
+    symbolic links, hard links, and device nodes included.
+
+    A directory member recorded as ``d/`` is reported by the tar reader as ``d``;
+    the name printed is the member's name as the format decodes it, with no
+    per-type decoration added or removed by this tool.
+    """
+    specs = [
+        helpers.dir_member("d/"),
+        helpers.file_member("d/f.txt", b"payload"),
+        helpers.symlink_member("d/link", "f.txt"),
+        helpers.hardlink_member("d/hard", "d/f.txt"),
+        helpers.chardev_member("d/chr"),
+        helpers.blockdev_member("d/blk"),
+        helpers.fifo_member("d/fifo"),
+    ]
+    archive = helpers.write_archive(tmp_path / "mixed.tar", specs)
+    result = run_cli(["list", str(archive)])
+    assert result.status == 0
+    assert result.stdout == (
+        "d\nd/f.txt\nd/link\nd/hard\nd/chr\nd/blk\nd/fifo\n"
+    )
+    assert len(result.stdout.splitlines()) == len(specs)
+
+
+def test_list_empty_archive_prints_nothing(run_cli, empty_archive):
+    """FR-018: an archive with no members prints nothing and exits 0."""
+    result = run_cli(["list", str(empty_archive)])
+    assert result.status == 0
+    assert result.stdout == ""
+    assert result.stderr == ""
+
+
+@pytest.mark.parametrize(
+    "builder",
+    ["missing", "garbage", "truncated", "zero_byte", "gzip_garbage"],
+    ids=["missing", "arbitrary-binary", "truncated", "zero-byte", "gzip-garbage"],
+)
+def test_list_invalid_archive_exits_2_with_empty_stdout(run_cli, tmp_path, builder):
+    """FR-013, FR-016: an unreadable archive names the archive on stderr and
+    leaves stdout completely empty — not a partial listing."""
+    archive = tmp_path / "input.tar"
+    if builder == "garbage":
+        helpers.build_garbage(archive)
+    elif builder == "truncated":
+        helpers.build_truncated(archive)
+    elif builder == "gzip_garbage":
+        helpers.build_gzip_garbage(archive)
+    elif builder == "zero_byte":
+        archive.write_bytes(b"")
+
+    result = run_cli(["list", str(archive)])
+    assert result.status == 2
+    assert result.stdout == ""
+    assert str(archive) in result.stderr
+
+
+def test_list_detects_the_format_from_content_not_the_filename(run_cli, tmp_path):
+    """FR-008: the same bytes list identically whatever the file is called."""
+    payload = {"photos/a.jpg": b"alpha", "photos/b.jpg": b"beta"}
+    gz_as_tar = helpers.build_files(
+        tmp_path / "gz-named-tar.tar", payload, compressed=True
+    )
+    plain_as_gz = helpers.build_files(tmp_path / "plain-named-gz.tar.gz", payload)
+
+    first = run_cli(["list", str(gz_as_tar)])
+    second = run_cli(["list", str(plain_as_gz)])
+    assert first.status == second.status == 0
+    assert first.stdout == second.stdout == "photos/a.jpg\nphotos/b.jpg\n"
+
+
+def test_list_changes_nothing_on_the_filesystem(run_cli, tmp_path, snapshot_tree):
+    """FR-003: a snapshot of the working tree before and after every run — over
+    valid, hostile, and invalid archives alike — is unchanged."""
+    work = tmp_path / "work"
+    work.mkdir(mode=0o700)
+    (work / "bystander.txt").write_bytes(b"untouched")
+    (work / "sub").mkdir(mode=0o700)
+    (work / "sub" / "nested.txt").write_bytes(b"also untouched")
+
+    archives = [
+        helpers.build_files(work / "ok.tar", {"a.txt": b"alpha"}),
+        helpers.build_empty(work / "empty.tar"),
+        helpers.write_archive(
+            work / "hostile.tar",
+            [
+                helpers.file_member("../esc.txt", b"pwned"),
+                helpers.file_member("/abs.txt", b"pwned"),
+                helpers.symlink_member("link", "/etc/passwd"),
+                helpers.chardev_member("dev/zero"),
+            ],
+        ),
+        helpers.build_garbage(work / "garbage.tar"),
+        work / "absent.tar",
+    ]
+    before = snapshot_tree(work)
+    for archive in archives:
+        run_cli(["list", str(archive)])
+    assert snapshot_tree(work) == before
+    assert not (tmp_path / "esc.txt").exists()
+    assert not (tmp_path / "abs.txt").exists()
+
+
+def test_list_escapes_control_characters_so_one_member_is_one_line(run_cli, tmp_path):
+    """SR-007: a real newline and an ESC byte in a member name are escaped, so
+    three members still produce exactly three output lines."""
+    archive = helpers.write_archive(
+        tmp_path / "evil.tar",
+        [
+            helpers.file_member("plain.txt", b"x"),
+            helpers.file_member("evil\nextracted 99 files", b"x"),
+            helpers.file_member("boom\x1b[2Jcleared", b"x"),
+        ],
+    )
+    result = run_cli(["list", str(archive)])
+    assert result.status == 0
+    lines = result.stdout.splitlines()
+    assert len(lines) == 3
+    assert lines == [
+        "plain.txt",
+        "evil\\nextracted 99 files",
+        "boom\\x1b[2Jcleared",
+    ]
+    assert "\x1b" not in result.stdout
+
+
+def test_list_applies_the_resource_bounds(run_cli, tmp_path):
+    """SR-005: the member cap and the declared-size bounds apply to ``list``."""
+    too_many = helpers.build_many_members(tmp_path / "many.tar", 10_001)
+    result = run_cli(["list", str(too_many)])
+    assert result.status == 2
+    assert result.stdout == ""
+
+    too_big = helpers.build_declared_sizes(
+        tmp_path / "big.tar", [("big.bin", (1 << 30) + 1)]
+    )
+    result = run_cli(["list", str(too_big)])
+    assert result.status == 2
+    assert result.stdout == ""
+
+
+def test_list_applies_bounds_but_not_member_kind_restrictions(run_cli, tmp_path):
+    """FR-003, SR-002, SR-005, R-014: the asymmetry that makes listing the safe way
+    to inspect untrusted input — a symlink member lists fine (exit 0) where
+    ``extract`` on the same archive refuses it (exit 2), yet both are bounded."""
+    archive = helpers.write_archive(
+        tmp_path / "symlink.tar",
+        [
+            helpers.file_member("a.txt", b"alpha"),
+            helpers.symlink_member("link", "/etc/passwd"),
+            helpers.chardev_member("dev/zero"),
+        ],
+    )
+    listed = run_cli(["list", str(archive)])
+    assert listed.status == 0
+    assert listed.stdout == "a.txt\nlink\ndev/zero\n"
+
+    extracted = run_cli(["extract", str(archive), str(tmp_path / "out")])
+    assert extracted.status == 2
+    assert "link" in extracted.stderr
+
+    bounded = run_cli(["list", str(helpers.build_many_members(tmp_path / "m.tar", 10_001))])
+    assert bounded.status == 2
+
+
+def test_list_survives_a_broken_pipe_without_a_crash_report(tmp_path):
+    """FR-015, FR-016, R-011: ``python -m tarx list big.tar | head -1`` terminates
+    with status 2 and no interpreter shutdown noise on stderr.
+
+    Run as a real subprocess because a broken pipe is a property of a real file
+    descriptor, not of an in-process stream.
+    """
+    archive = helpers.build_many_members(tmp_path / "many.tar", 9_000)
+    env = dict(os.environ, PYTHONPATH="src")
+    process = subprocess.Popen(
+        [sys.executable, "-m", "tarx", "list", str(archive)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        cwd=REPO_ROOT,
+        env=env,
+    )
+    assert process.stdout.readline()  # consume one line, then hang up
+    process.stdout.close()
+    stderr = process.stderr.read()
+    process.stderr.close()
+    status = process.wait(timeout=60)
+
+    assert status == 2
+    assert b"Exception ignored" not in stderr
+    assert b"Traceback" not in stderr
+    assert b"BrokenPipeError" not in stderr
