+def test_a_truncated_output_file_never_accompanies_exit_zero(tmp_path, monkeypatch):
+    """002 SR-009: a write failure part way through is never a success.
+
+    Injected, because a full disk cannot be produced on demand. The run must
+    exit 2, so the incomplete file on disk is never reported as a complete
+    bundle (research.md D-114).
+    """
+    import builtins
+
+    work = tmp_path / "trunc"
+    work.mkdir()
+    source = work / "in.log"
+    source.write_bytes(SENSITIVE_LINE_4 * 4)
+    clean = work / "clean"
+
+    real_open = builtins.open
+    state = {"writes": 0}
+
+    class _FailsAfterOneWrite:
+        def __init__(self, stream):
+            self._stream = stream
+
+        def write(self, text):
+            state["writes"] += 1
+            if state["writes"] > 1:
+                raise OSError(28, "No space left on device")
+            return self._stream.write(text)
+
+        def flush(self):
+            self._stream.flush()
+
+        def close(self):
+            self._stream.close()
+
+    def wrapping_open(target, *args, **kwargs):
+        stream = real_open(target, *args, **kwargs)
+        if isinstance(target, int):
+            return _FailsAfterOneWrite(stream)
+        return stream
+
+    monkeypatch.setattr(cli, "open", wrapping_open, raising=False)
+
+    out = io.StringIO()
+    err = io.StringIO()
+    status = cli.main(
+        ["--count", "--out-dir", str(clean), str(source)],
+        stdin=io.StringIO(""),
+        stdout=out,
+        stderr=err,
+    )
+    assert status == 2
+    assert out.getvalue() == ""
+    assert "emails=" not in err.getvalue()
+    assert str(clean / "in.log") in err.getvalue()
+    # A partial file remains; the exit status and absent tally are the signal.
+    with open(clean / "in.log", "rb") as handle:
+        partial = handle.read()
+    assert len(partial) < len(REDACTED_LINE_4 * 4)
+    # And even the partial content carries nothing unredacted (SR-010).
+    for fragment in SENSITIVE_FRAGMENTS + PHONE_FRAGMENTS:
+        assert fragment not in partial
