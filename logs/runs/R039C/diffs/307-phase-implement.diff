@@ -0,0 +1,494 @@
+"""User Story 2: ``--out-dir DIR`` success paths (FR-006 - FR-011, FR-013).
+
+``--out-dir DIR`` writes each FILE's redacted stream to ``DIR/<basename>``
+instead of to standard output, creating DIR and its missing parents, replacing
+an existing regular file of that name in full, and reporting ``wrote N files``
+on standard output when every FILE has been processed
+(002 contracts/cli.md Destinations).
+
+Assertions are at the **byte** level, through ``run_cli`` and
+``read_bytes_of``: FR-013 and SR-010 are requirements about bytes, not about
+decoded text. Failure paths live in ``test_cli_out_dir_errors.py`` and the
+security properties in ``test_out_dir_security.py``.
+"""
+
+import os
+
+import pytest
+
+from conftest import (
+    DIR_MODE,
+    FILE_MODE,
+    files_under,
+    mode_of,
+    read_bytes_of,
+    run_cli,
+)
+
+APP_LINE = b"user jane@example.com\n"
+APP_REDACTED = b"user [EMAIL]\n"
+WEB_LINE = b"GET / from 10.0.0.7\n"
+WEB_REDACTED = b"GET / from [IP]\n"
+PHONE_LINE = b"call +14155552671\n"
+PHONE_REDACTED = b"call [PHONE]\n"
+
+
+@pytest.fixture
+def work(tmp_path):
+    """A working directory holding ``app.log``, ``web.log``, and ``tel.log``.
+
+    ``app.log`` sits under ``logs/2026/`` so the FR-007 assertion that the
+    input's directory components do not travel has something to travel from.
+    """
+    root = tmp_path / "work"
+    (root / "logs" / "2026").mkdir(parents=True)
+    (root / "logs" / "2026" / "app.log").write_bytes(APP_LINE)
+    (root / "web.log").write_bytes(WEB_LINE)
+    (root / "tel.log").write_bytes(PHONE_LINE)
+    return root
+
+
+# --------------------------------------------------------------------------
+# FR-006: the option's forms, position, and repetition
+# --------------------------------------------------------------------------
+
+
+def test_the_separate_value_form(work):
+    status, out, err = run_cli(
+        ["--out-dir", "clean", "web.log"], cwd=str(work)
+    )
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert err == b""
+    assert read_bytes_of(work / "clean" / "web.log") == WEB_REDACTED
+
+
+def test_the_equals_value_form(work):
+    status, out, err = run_cli(["--out-dir=clean", "web.log"], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert err == b""
+    assert read_bytes_of(work / "clean" / "web.log") == WEB_REDACTED
+
+
+@pytest.mark.parametrize(
+    "args",
+    [
+        ["--out-dir", "clean", "web.log", "tel.log"],
+        ["web.log", "--out-dir", "clean", "tel.log"],
+        ["web.log", "tel.log", "--out-dir", "clean"],
+        ["--out-dir=clean", "web.log", "tel.log"],
+        ["web.log", "--out-dir=clean", "tel.log"],
+    ],
+)
+def test_the_option_is_honoured_in_any_position(work, args):
+    """FR-006: position never changes which arguments are FILEs."""
+    status, out, err = run_cli(args, cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 2 files\n"
+    assert err == b""
+    assert read_bytes_of(work / "clean" / "web.log") == WEB_REDACTED
+    assert read_bytes_of(work / "clean" / "tel.log") == PHONE_REDACTED
+
+
+def test_the_value_is_never_treated_as_a_file(work):
+    """FR-006 / research.md D-105: ``clean`` is the DIR, not an input path.
+
+    Without ``_partition`` knowing that ``--out-dir`` takes a value, this
+    invocation would regroup to ``--out-dir -- clean web.log`` and argparse
+    would fail on a missing value while silently reading ``clean`` as a FILE --
+    a wrong answer, which Principle II calls the most severe defect class.
+    """
+    status, out, err = run_cli(["--out-dir", "clean", "web.log"], cwd=str(work))
+    assert status == 0
+    # Exactly one FILE was processed, so the tally is singular.
+    assert out == b"wrote 1 file\n"
+    assert err == b""
+    # And no output file was named after the DIR value.
+    assert not (work / "clean" / "clean").exists()
+    assert sorted(os.listdir(work / "clean")) == ["web.log"]
+
+
+def test_a_repeated_option_uses_the_last_occurrence(work):
+    """FR-006: argparse's store action keeps the last value (D-106)."""
+    status, out, err = run_cli(
+        ["--out-dir", "first", "--out-dir", "second", "web.log"], cwd=str(work)
+    )
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert err == b""
+    assert read_bytes_of(work / "second" / "web.log") == WEB_REDACTED
+    # The earlier value was never used, so nothing was created for it.
+    assert not (work / "first").exists()
+
+
+def test_the_option_abbreviation_of_both_options_still_resolves(work):
+    """FR-005 / D-105: ``allow_abbrev=False`` was not an option."""
+    status, out, err = run_cli(["--out", "clean", "--cou", "web.log"], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert err == b"emails=0 ips=1 cards=0 phones=0\n"
+    assert read_bytes_of(work / "clean" / "web.log") == WEB_REDACTED
+
+
+def test_a_file_named_dash_stays_a_literal_relative_path(work):
+    """D-105: ``--count --out-dir clean -`` leaves ``-`` an ordinary path."""
+    (work / "-").write_bytes(WEB_LINE)
+    status, out, err = run_cli(
+        ["--count", "--out-dir", "clean", "-"], cwd=str(work)
+    )
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert err == b"emails=0 ips=1 cards=0 phones=0\n"
+    assert read_bytes_of(work / "clean" / "-") == WEB_REDACTED
+
+
+def test_an_option_looking_token_after_the_option_fails_loudly(work):
+    """D-105 regrouping, plus argparse's own rule about option-looking values.
+
+    ``_partition`` groups the token after ``--out-dir`` with the options rather
+    than with the FILEs, exactly as D-105 tabulates. What D-105's table does
+    **not** say -- it describes the regrouping, not the parse -- is that
+    argparse then refuses a value that looks like an option, so this exits 2
+    with a usage error rather than creating a directory named ``--count``
+    (probed: ``error: argument --out-dir: expected one argument``).
+
+    Either way the requirement that matters holds: the token is never read as a
+    FILE, and the run fails loudly instead of answering wrongly (Principle II).
+    """
+    status, out, err = run_cli(["--out-dir", "--count", "web.log"], cwd=str(work))
+    assert status == 2
+    assert out == b""
+    assert b"usage:" in err
+    assert b"--out-dir" in err
+    assert b"Traceback" not in err
+    # No directory was created under either name, and nothing was written.
+    assert not (work / "--count").exists()
+    assert not (work / "clean").exists()
+    # And "--count" was not silently read as an input path.
+    assert b"cannot read" not in err
+
+
+# --------------------------------------------------------------------------
+# FR-007: output lands in DIR/<basename>, and nothing lands on stdout
+# --------------------------------------------------------------------------
+
+
+def test_redacted_lines_go_to_the_output_file_and_not_to_stdout(work):
+    """FR-007 / US2-2: stdout carries the tally and nothing else."""
+    status, out, err = run_cli(
+        ["--out-dir", "clean", "logs/2026/app.log", "web.log", "tel.log"],
+        cwd=str(work),
+    )
+    assert status == 0
+    assert out == b"wrote 3 files\n"
+    assert err == b""
+    # No redacted content, and no placeholder at all, reached stdout.
+    for marker in (b"[EMAIL]", b"[IP]", b"[PHONE]", b"[CARD]", b"user", b"GET"):
+        assert marker not in out
+    assert read_bytes_of(work / "clean" / "app.log") == APP_REDACTED
+    assert read_bytes_of(work / "clean" / "web.log") == WEB_REDACTED
+    assert read_bytes_of(work / "clean" / "tel.log") == PHONE_REDACTED
+
+
+def test_the_inputs_directory_components_do_not_travel(work):
+    """FR-007 / US2-5 / SR-005: the output name is the final component only."""
+    status, out, _err = run_cli(
+        ["--out-dir", "clean", "logs/2026/app.log"], cwd=str(work)
+    )
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert (work / "clean" / "app.log").is_file()
+    # No "clean/logs" exists, and the folder holds exactly the one file.
+    assert not (work / "clean" / "logs").exists()
+    assert sorted(os.listdir(work / "clean")) == ["app.log"]
+    assert files_under(work / "clean") == [str(work / "clean" / "app.log")]
+
+
+# --------------------------------------------------------------------------
+# FR-008: DIR and every missing parent are created
+# --------------------------------------------------------------------------
+
+
+def test_a_non_existent_nested_dir_is_created_in_full(work):
+    """FR-008 / US2-3: all three levels, each owner-only (SR-007, SC-007)."""
+    status, out, err = run_cli(
+        ["--out-dir", "reports/2026/clean", "web.log"], cwd=str(work)
+    )
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert err == b""
+    reports = work / "reports"
+    assert reports.is_dir()
+    assert (reports / "2026").is_dir()
+    assert (reports / "2026" / "clean").is_dir()
+    assert read_bytes_of(reports / "2026" / "clean" / "web.log") == WEB_REDACTED
+    # Every level the tool created, not only the leaf (research.md D-108).
+    for level in (reports, reports / "2026", reports / "2026" / "clean"):
+        assert mode_of(level) == DIR_MODE, level
+    assert mode_of(reports / "2026" / "clean" / "web.log") == FILE_MODE
+
+
+def test_an_existing_dir_is_used_as_is(work):
+    """FR-008 / SR-008 / O-3: an existing directory is not re-permissioned."""
+    existing = work / "clean"
+    existing.mkdir(mode=0o755)
+    os.chmod(existing, 0o755)
+    (existing / "unrelated.txt").write_bytes(b"keep me\n")
+
+    status, out, err = run_cli(["--out-dir", "clean", "web.log"], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert err == b""
+    # The mode the user chose is left alone.
+    assert mode_of(existing) == 0o755
+    # Unrelated files in it are untouched.
+    assert read_bytes_of(existing / "unrelated.txt") == b"keep me\n"
+    assert read_bytes_of(existing / "web.log") == WEB_REDACTED
+    # The output file itself is still owner-only.
+    assert mode_of(existing / "web.log") == FILE_MODE
+
+
+# --------------------------------------------------------------------------
+# FR-009: an existing file is replaced in full
+# --------------------------------------------------------------------------
+
+
+def test_an_existing_output_file_is_replaced_in_full(work):
+    """FR-009 / O-8: no remnant of longer previous content, never appended."""
+    clean = work / "clean"
+    clean.mkdir()
+    stale = b"X" * 29 + b"\n"
+    (clean / "app.log").write_bytes(stale)
+    assert len(stale) == 30
+
+    status, out, err = run_cli(
+        ["--out-dir", "clean", "logs/2026/app.log"], cwd=str(work)
+    )
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert err == b""
+
+    written = read_bytes_of(clean / "app.log")
+    assert written == APP_REDACTED
+    assert len(written) == 13
+    # Not appended, and no tail of the longer previous content survives.
+    assert b"X" not in written
+    assert not written.startswith(stale)
+    assert (clean / "app.log").stat().st_size == len(APP_REDACTED)
+
+
+def test_replacing_a_file_narrows_its_permissions(work):
+    """SR-007 / SC-007: a pre-existing 0o666 file ends the run at 0o600."""
+    clean = work / "clean"
+    clean.mkdir()
+    target = clean / "web.log"
+    target.write_bytes(b"stale\n")
+    os.chmod(target, 0o666)
+    assert mode_of(target) == 0o666
+
+    status, out, _err = run_cli(["--out-dir", "clean", "web.log"], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert mode_of(target) == FILE_MODE
+    assert read_bytes_of(target) == WEB_REDACTED
+
+
+# --------------------------------------------------------------------------
+# FR-010 / FR-011: the tally line
+# --------------------------------------------------------------------------
+
+
+def test_the_tally_is_singular_for_one_file(work):
+    """FR-010 / Assumptions: ``wrote 1 file``, not ``wrote 1 files``."""
+    status, out, err = run_cli(["--out-dir", "clean", "web.log"], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert b"1 files" not in out
+    assert err == b""
+
+
+def test_the_tally_is_plural_for_three_files(work):
+    status, out, err = run_cli(
+        ["--out-dir", "clean", "web.log", "tel.log", "logs/2026/app.log"],
+        cwd=str(work),
+    )
+    assert status == 0
+    assert out == b"wrote 3 files\n"
+    assert err == b""
+
+
+def test_the_tally_is_the_only_thing_on_stdout(work):
+    """FR-010: exactly one line, newline-terminated, no padding."""
+    _status, out, _err = run_cli(["--out-dir", "clean", "web.log"], cwd=str(work))
+    text = out.decode("ascii")
+    assert text == "wrote 1 file\n"
+    assert text.count("\n") == 1
+    assert text == text.lstrip()
+
+
+def test_no_tally_without_the_option(work):
+    """FR-010 / FR-017: the tally exists only in the output-folder mode."""
+    status, out, err = run_cli(["web.log"], cwd=str(work))
+    assert status == 0
+    assert out == WEB_REDACTED
+    assert b"wrote" not in out
+    assert err == b""
+
+
+def test_a_file_named_twice_counts_twice(work):
+    """FR-011: N counts FILE *arguments*, not distinct files."""
+    status, out, err = run_cli(
+        ["--out-dir", "clean", "web.log", "web.log"], cwd=str(work)
+    )
+    assert status == 0
+    assert out == b"wrote 2 files\n"
+    assert err == b""
+    # One file on disk, written twice, holding one copy of the output.
+    assert sorted(os.listdir(work / "clean")) == ["web.log"]
+    assert read_bytes_of(work / "clean" / "web.log") == WEB_REDACTED
+
+
+def test_two_files_sharing_a_basename_count_twice_and_the_later_wins(work):
+    """FR-011 / O-8: the second write replaces the first in full."""
+    other = work / "other" / "2026"
+    other.mkdir(parents=True)
+    (other / "web.log").write_bytes(b"second source +14155552671\n")
+
+    status, out, err = run_cli(
+        ["--out-dir", "clean", "web.log", "other/2026/web.log"], cwd=str(work)
+    )
+    assert status == 0
+    assert out == b"wrote 2 files\n"
+    assert err == b""
+    assert sorted(os.listdir(work / "clean")) == ["web.log"]
+    # The later FILE's redacted stream, with no remnant of the earlier one.
+    assert read_bytes_of(work / "clean" / "web.log") == b"second source [PHONE]\n"
+    assert b"[IP]" not in read_bytes_of(work / "clean" / "web.log")
+
+
+# --------------------------------------------------------------------------
+# FR-013: structure and encoding are preserved in output files
+# --------------------------------------------------------------------------
+
+
+def test_an_empty_input_gives_an_empty_output_file(work):
+    (work / "empty.log").write_bytes(b"")
+    status, out, err = run_cli(["--out-dir", "clean", "empty.log"], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert err == b""
+    target = work / "clean" / "empty.log"
+    assert target.is_file()
+    assert read_bytes_of(target) == b""
+    assert target.stat().st_size == 0
+
+
+def test_an_unterminated_final_line_gains_no_terminator(work):
+    (work / "bare.log").write_bytes(b"no newline at end jane@example.com")
+    status, out, _err = run_cli(["--out-dir", "clean", "bare.log"], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    written = read_bytes_of(work / "clean" / "bare.log")
+    assert written == b"no newline at end [EMAIL]"
+    assert not written.endswith(b"\n")
+    assert not written.endswith(b"\r")
+
+
+@pytest.mark.parametrize(
+    ("payload", "expected"),
+    [
+        (b"a@b.io\n", b"[EMAIL]\n"),
+        (b"a@b.io\r\n", b"[EMAIL]\r\n"),
+        (b"a@b.io\r", b"[EMAIL]\r"),
+        (b"one\ntwo\r\nthree\rfour\n", b"one\ntwo\r\nthree\rfour\n"),
+        (b"\n\r\n\r", b"\n\r\n\r"),
+    ],
+)
+def test_newline_sequences_are_written_exactly_as_read(work, payload, expected):
+    """FR-013 / O-12: never translated, never normalised."""
+    (work / "nl.log").write_bytes(payload)
+    status, out, _err = run_cli(["--out-dir", "clean", "nl.log"], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert read_bytes_of(work / "clean" / "nl.log") == expected
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        b"caf\xe9 jane@example.com\n",
+        b"\xff\xfe a@b.io \xff\n",
+        b"\x00 +14155552671 \x00\n",
+        b"\xe4\xb8\xad\xe6\x96\x87 10.0.0.7\n",
+    ],
+)
+def test_non_utf8_bytes_round_trip_into_the_output_file(work, payload):
+    """FR-013 / O-12: the identical encoding triple as stdout (001 D-001)."""
+    (work / "raw.log").write_bytes(payload)
+    status, out, err = run_cli(["--out-dir", "clean", "raw.log"], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert err == b""
+    written = read_bytes_of(work / "clean" / "raw.log")
+    for raw in (b"\xe9", b"\xff", b"\xfe", b"\x00", b"\xe4\xb8\xad"):
+        assert written.count(raw) == payload.count(raw)
+    assert b"jane@example.com" not in written
+    assert b"a@b.io" not in written
+    assert b"14155552671" not in written
+
+
+# --------------------------------------------------------------------------
+# SC-005: each output file equals the streaming output for that one FILE
+# --------------------------------------------------------------------------
+
+
+def test_each_output_file_is_byte_identical_to_the_streaming_mode(work):
+    """SC-005 / SR-003: ``--out-dir`` changes the destination and nothing else."""
+    (work / "mixed.log").write_bytes(
+        b"user jane@example.com from 10.0.0.7 card 4111 1111 1111 1111\n"
+        b"call +14155552671 and +442071838750\n"
+        b"near +1234567 and +1234567890123456\n"
+        b"caf\xe9 raw \xff bytes\r\n"
+        b"unterminated +4222222222222"
+    )
+    files = ["logs/2026/app.log", "web.log", "tel.log", "mixed.log"]
+
+    status, out, err = run_cli(["--out-dir", "clean", *files], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 4 files\n"
+    assert err == b""
+
+    for path in files:
+        piped_status, piped_out, piped_err = run_cli([path], cwd=str(work))
+        assert piped_status == 0, path
+        assert piped_err == b"", path
+        written = read_bytes_of(work / "clean" / os.path.basename(path))
+        assert written == piped_out, path
+
+
+def test_ten_files_into_a_nested_folder_all_match_the_streaming_mode(work):
+    """SC-005 at the scale the criterion names, into a nested DIR."""
+    names = []
+    for index in range(10):
+        name = f"log{index}.log"
+        (work / name).write_bytes(
+            f"line {index} user jane@example.com call +1415555267{index}\n".encode()
+        )
+        names.append(name)
+
+    status, out, err = run_cli(
+        ["--out-dir", "reports/2026/clean", *names], cwd=str(work)
+    )
+    assert status == 0
+    assert out == b"wrote 10 files\n"
+    assert err == b""
+
+    clean = work / "reports" / "2026" / "clean"
+    assert sorted(os.listdir(clean)) == sorted(names)
+    for name in names:
+        _status, piped_out, _err = run_cli([name], cwd=str(work))
+        assert read_bytes_of(clean / name) == piped_out, name
+        assert b"jane" not in piped_out
+    # Exactly ten files under the folder, and nothing else.
+    assert len(files_under(clean)) == 10
