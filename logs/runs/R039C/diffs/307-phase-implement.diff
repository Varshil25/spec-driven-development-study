+def test_at_most_one_output_file_is_open_at_a_time(work, monkeypatch):
+    """SR-011 / INV-12 / O-13: opened after its input, closed before the next."""
+    real_open = builtins.open
+    live = {"now": 0, "peak": 0}
+
+    class _Counting:
+        def __init__(self, stream):
+            self._stream = stream
+            live["now"] += 1
+            live["peak"] = max(live["peak"], live["now"])
+
+        def write(self, text):
+            return self._stream.write(text)
+
+        def flush(self):
+            self._stream.flush()
+
+        def close(self):
+            live["now"] -= 1
+            self._stream.close()
+
+    def wrapping_open(target, *args, **kwargs):
+        stream = real_open(target, *args, **kwargs)
+        if isinstance(target, int):
+            return _Counting(stream)
+        return stream
+
+    monkeypatch.setattr(cli, "open", wrapping_open, raising=False)
