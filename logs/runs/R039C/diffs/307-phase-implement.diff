@@ -0,0 +1,340 @@
+"""FR-005 / SC-003: feature 001's behaviour is byte-for-byte unchanged.
+
+"Everything else must keep working exactly as it does" is a requirement in its
+own right, so it gets a file a reviewer can point at rather than being implied
+by the absence of failures elsewhere (plan.md Project Structure).
+
+Every assertion here is written against **raw bytes** captured through
+``run_cli``, because FR-005 is a claim about bytes and not about decoded text.
+This file is written *before* any source change and must pass against the
+unmodified source as well as after it -- which is exactly what makes it a
+regression guard rather than a restatement of the new behaviour.
+
+Deliberately **not** asserted here: the ``--count`` summary's field list. FR-004
+supersedes 001's three-field form, and ``test_cli_count.py`` owns the new shape.
+The *absence* of a summary without ``--count`` is asserted, because that is
+unchanged.
+"""
+
+import pytest
+
+from logredact.cli import MAX_LINE
+from conftest import run_cli
+
+# Feature 001's own corpus line, from its quickstart and from spec 002 FR-005.
+CORPUS = b"user jane@example.com from 10.0.0.7 card 4111 1111 1111 1111\n"
+CORPUS_REDACTED = b"user [EMAIL] from [IP] card [CARD]\n"
+
+
+def test_the_001_corpus_line_is_unchanged():
+    """FR-005 / SC-003: the headline guarantee, byte for byte."""
+    status, out, err = run_cli([], stdin_bytes=CORPUS)
+    assert status == 0
+    assert out == CORPUS_REDACTED
+    assert err == b""
+
+
+def test_the_001_corpus_line_is_unchanged_from_a_file(tmp_path):
+    """The same guarantee through the FILE path rather than standard input."""
+    path = tmp_path / "001.log"
+    path.write_bytes(CORPUS)
+    status, out, err = run_cli([str(path)])
+    assert status == 0
+    assert out == CORPUS_REDACTED
+    assert err == b""
+
+
+# --------------------------------------------------------------------------
+# Ranks 1-3 recognition, unchanged (001 FR-004 - FR-007)
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        # Email, rank 1.
+        (b"a@b.io\n", b"[EMAIL]\n"),
+        (b"jane.doe+test@mail.example.com\n", b"[EMAIL]\n"),
+        (b"contact me at jane@example.com today\n", b"contact me at [EMAIL] today\n"),
+        # IPv4, rank 2.
+        (b"10.0.0.7\n", b"[IP]\n"),
+        (b"255.255.255.255\n", b"[IP]\n"),
+        (b"from 1.2.3.4 ok\n", b"from [IP] ok\n"),
+        # Not an IPv4 address: an octet out of range is left alone.
+        (b"256.1.1.1\n", b"256.1.1.1\n"),
+        # Card, rank 3, both separator kinds and none.
+        (b"4111111111111111\n", b"[CARD]\n"),
+        (b"4111 1111 1111 1111\n", b"[CARD]\n"),
+        (b"4111-1111-1111-1111\n", b"[CARD]\n"),
+        # 13 digits that fail Luhn are not a card.
+        (b"1234567890123\n", b"1234567890123\n"),
+        # Nothing redactable passes through untouched.
+        (b"plain log line\n", b"plain log line\n"),
+    ],
+)
+def test_rank_one_to_three_recognition_is_unchanged(line, expected):
+    status, out, err = run_cli([], stdin_bytes=line)
+    assert status == 0
+    assert out == expected
+    assert err == b""
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        # Email outranks a card candidate that starts earlier.
+        (b"4111111111111111@a.com\n", b"[EMAIL]\n"),
+        # Final label is not alphabetic, so rank 2 claims the address.
+        (b"a@1.2.3.4\n", b"a@[IP]\n"),
+        # A failed card candidate must not block a later match.
+        (b"12 34.5.6.7\n", b"12 [IP]\n"),
+        # Several categories on one line, in input order.
+        (b"a@b.io 1.2.3.4 4111 1111 1111 1111\n", b"[EMAIL] [IP] [CARD]\n"),
+        # Longest valid candidate at a shared start.
+        (b"41111111111111 11\n", b"[CARD]\n"),
+        # Literal placeholder text in the input is inert, never re-scanned.
+        (b"[EMAIL] now a@b.io\n", b"[EMAIL] now [EMAIL]\n"),
+    ],
+)
+def test_leftmost_longest_non_overlapping_matching_is_unchanged(line, expected):
+    """001 FR-008 / FR-009: precedence before position, no overlap, no nesting."""
+    status, out, err = run_cli([], stdin_bytes=line)
+    assert status == 0
+    assert out == expected
+    assert err == b""
+    assert b"[[" not in out
+    assert b"]]" not in out
+
+
+# --------------------------------------------------------------------------
+# Line structure, unchanged (001 FR-003)
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        b"a@b.io\n",
+        b"a@b.io\r\n",
+        b"a@b.io\r",
+        b"one\ntwo\r\nthree\rfour\n",
+        b"a@b.io\n\n\nb@c.io\n",
+        b"\n",
+        b"\r\n",
+        b"\r",
+    ],
+)
+def test_newline_sequences_are_preserved_exactly(payload):
+    """001 FR-003: "\\n", "\\r\\n", and a lone "\\r" are never translated."""
+    status, out, err = run_cli([], stdin_bytes=payload)
+    assert status == 0
+    assert err == b""
+    # Terminators survive position for position.
+    assert out.count(b"\r\n") == payload.count(b"\r\n")
+    assert out.count(b"\n") == payload.count(b"\n")
+    assert out.count(b"\r") == payload.count(b"\r")
+    assert out.endswith(payload[-1:])
+
+
+def test_an_unterminated_final_line_gains_no_terminator():
+    """001 FR-003 / US1-6."""
+    status, out, err = run_cli([], stdin_bytes=b"no newline at end a@b.io")
+    assert status == 0
+    assert out == b"no newline at end [EMAIL]"
+    assert not out.endswith(b"\n")
+    assert not out.endswith(b"\r")
+    assert err == b""
+
+
+def test_empty_input_gives_empty_output():
+    status, out, err = run_cli([], stdin_bytes=b"")
+    assert status == 0
+    assert out == b""
+    assert err == b""
+
+
+# --------------------------------------------------------------------------
+# Encoding, unchanged (001 FR-017)
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        b"caf\xe9 jane@example.com\n",          # lone Latin-1 byte
+        b"\xff\xfe a@b.io \xff\n",              # bytes that are never valid UTF-8
+        b"caf\xc3\xa9 a@b.io\n",                # well-formed UTF-8
+        b"\x00 a@b.io \x00\n",                  # NUL is ordinary data
+        b"\xe4\xb8\xad\xe6\x96\x87 10.0.0.7\n",  # multi-byte, no match inside
+    ],
+)
+def test_non_utf8_bytes_round_trip_unchanged(payload):
+    """001 FR-017: ``surrogateescape`` round-trips byte for byte."""
+    status, out, err = run_cli([], stdin_bytes=payload)
+    assert status == 0
+    assert err == b""
+    # Every byte outside the redacted spans is returned exactly as supplied.
+    for raw in (b"\xe9", b"\xff", b"\xfe", b"\x00", b"\xe4\xb8\xad"):
+        assert out.count(raw) == payload.count(raw)
+    assert b"jane@example.com" not in out
+    assert b"a@b.io" not in out
+
+
+# --------------------------------------------------------------------------
+# The per-line ceiling, unchanged (001 SR-005)
+# --------------------------------------------------------------------------
+
+
+def test_the_per_line_ceiling_is_still_one_mebibyte():
+    assert MAX_LINE == 1048576
+
+
+def test_a_line_at_the_ceiling_still_succeeds(tmp_path):
+    path = tmp_path / "at-limit.log"
+    path.write_bytes(b"x" * MAX_LINE + b"\n")
+    status, out, err = run_cli([str(path)])
+    assert status == 0
+    assert err == b""
+    assert out == b"x" * MAX_LINE + b"\n"
+
+
+def test_an_over_long_line_still_fails_loudly_without_quoting_itself(tmp_path):
+    """001 SR-005 / SR-001: names the source and the limit, quotes nothing."""
+    path = tmp_path / "too-long.log"
+    path.write_bytes(b"jane@example.com " + b"9" * (MAX_LINE + 10) + b"\n")
+    status, _out, err = run_cli([str(path)])
+    assert status == 2
+    text = err.decode()
+    assert str(path) in text
+    assert str(MAX_LINE) in text
+    assert text.count("\n") == 1
+    assert "Traceback" not in text
+    # The rejected content is exactly what must not reach stderr.
+    assert "9" * 20 not in text
+    assert "jane" not in text
+    assert len(err) < 500
+
+
+# --------------------------------------------------------------------------
+# Streams and statuses, unchanged (001 FR-011, FR-013, FR-014)
+# --------------------------------------------------------------------------
+
+
+def test_stderr_is_empty_on_a_successful_run_without_count():
+    """001 FR-011 / INV-7."""
+    status, out, err = run_cli([], stdin_bytes=CORPUS)
+    assert status == 0
+    assert out == CORPUS_REDACTED
+    assert err == b""
+
+
+def test_exit_status_zero_on_success_from_several_files(tmp_path):
+    first = tmp_path / "first.log"
+    first.write_bytes(b"a@b.io\n")
+    second = tmp_path / "second.log"
+    second.write_bytes(b"1.2.3.4\n")
+    status, out, err = run_cli([str(first), str(second)])
+    assert status == 0
+    assert out == b"[EMAIL]\n[IP]\n"
+    assert err == b""
+
+
+@pytest.mark.parametrize("case", ["missing", "directory", "bad-option", "dash"])
+def test_exit_status_two_on_failure(tmp_path, case):
+    """001 FR-013 / FR-014 / SC-006: failure stays distinguishable by status."""
+    args = {
+        "missing": [str(tmp_path / "nope.log")],
+        "directory": [str(tmp_path)],
+        "bad-option": ["--bogus"],
+        "dash": ["-"],
+    }[case]
+    status, _out, err = run_cli(args, stdin_bytes=CORPUS)
+    assert status == 2
+    assert err != b""
+    assert b"Traceback" not in err
+    assert b"jane" not in err
+
+
+def test_partial_output_is_kept_when_a_later_file_fails(tmp_path):
+    """001 US4-4: output already written to stdout is not discarded."""
+    good = tmp_path / "good.log"
+    good.write_bytes(CORPUS)
+    missing = str(tmp_path / "missing.log")
+    status, out, err = run_cli([str(good), missing])
+    assert status == 2
+    assert out == CORPUS_REDACTED
+    assert missing.encode() in err
+
+
+def test_help_still_goes_to_stdout_and_exits_zero():
+    """001 contracts/cli.md Arguments: ``-h``/``--help`` is not a failure."""
+    for flag in ("-h", "--help"):
+        status, out, err = run_cli([flag])
+        assert status == 0
+        assert b"usage:" in out
+        assert b"--count" in out
+        assert err == b""
+
+
+@pytest.mark.parametrize("position", ["before", "middle", "after"])
+def test_count_is_still_accepted_in_any_position(tmp_path, position):
+    """001 FR-012: option position never changes which arguments are FILEs.
+
+    The summary's *field list* is FR-004's business; what this pins is that
+    ``--count`` keeps working from any position and that stdout is unaffected.
+    """
+    first = tmp_path / "first.log"
+    first.write_bytes(b"a@b.io\n")
+    second = tmp_path / "second.log"
+    second.write_bytes(b"1.2.3.4\n")
+    a, b = str(first), str(second)
+    args = {
+        "before": ["--count", a, b],
+        "middle": [a, "--count", b],
+        "after": [a, b, "--count"],
+    }[position]
+    status, out, err = run_cli(args)
+    assert status == 0
+    assert out == b"[EMAIL]\n[IP]\n"
+    assert err.startswith(b"emails=1 ips=1 cards=0")
+
+
+def test_option_abbreviation_still_resolves(tmp_path):
+    """FR-005: ``--cou`` resolved to ``--count`` in 001 and must keep doing so.
+
+    This is why ``allow_abbrev=False`` was rejected in research.md D-105: it
+    would have turned an exit-0 invocation into an exit-2 usage error.
+    """
+    path = tmp_path / "in.log"
+    path.write_bytes(b"a@b.io\n")
