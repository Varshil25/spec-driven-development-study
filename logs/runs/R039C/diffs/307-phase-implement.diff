+@pytest.fixture
+def out_dir(tmp_path):
+    """A **non-existent** nested output folder path under ``tmp_path``.
+
+    Three levels deep, because SC-007 requires owner-only permissions on every
+    directory the tool creates -- including the intermediates that
+    ``os.makedirs(mode=...)`` would have left at ``0o755`` (research.md D-108).
+    Returned as a string: the DIR value is used by the tool exactly as given.
+    """
+    return str(tmp_path / "reports" / "2026" / "clean")
+
+
+def mode_of(path):
+    """Return the permission bits of ``path`` as an int, for SC-007.
+
+    Expected ``0o700`` for a directory the tool created and ``0o600`` for an
+    output file, whether created or replacing a pre-existing one.
+    """
+    return stat.S_IMODE(os.stat(path).st_mode)
+
+
+def files_under(root):
+    """Return every file below ``root``, as sorted absolute paths.
+
+    The SR-010 / SC-012 scan walks this list and reads each file, asserting no
+    prepared sample value survives anywhere under an output folder.
+    """
+    found = []
+    for base, _dirs, names in os.walk(root):
+        for name in sorted(names):
+            found.append(os.path.join(base, name))
+    return sorted(found)
+
+
+def dirs_under(root):
+    """Return ``root`` and every directory below it, as sorted absolute paths."""
+    found = [os.path.abspath(root)]
+    for base, dirs, _names in os.walk(root):
+        for name in sorted(dirs):
+            found.append(os.path.join(base, name))
+    return sorted(found)
+
+
+def running_as_root():
+    """Return ``True`` when the suite runs with uid 0.
+
+    An unwritable destination cannot be produced with ``chmod`` as root, so the
+    test chooses between ``os.chmod(parent, 0o500)`` and injecting the failure
+    through ``call_main`` with a patched ``os.open``. It never chooses to skip:
+    Constitution Principle III forbids ``skipif`` and ``xfail``
+    (research.md D-114).
+    """
+    return os.geteuid() == 0
