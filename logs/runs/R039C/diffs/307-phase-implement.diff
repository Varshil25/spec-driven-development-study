+def _ten_megabyte_log(path):
+    """Write a representative log of at least 10 MB at ``path``.
+
+    Returns ``(line, repeats)`` so a caller can assert the exact redaction
+    count rather than a lower bound.
+    """
+    line = (
+        "2026-11-21T10:00:00 INFO user jane.doe@example.com from 10.0.0.7 "
+        "paid 4111 1111 1111 1111 call +14155552671 ok\n"
+    )
+    repeats = (10 * 1024 * 1024) // len(line) + 1
+    with open(path, "w", encoding="utf-8", newline="") as handle:
+        handle.writelines([line] * repeats)
+    assert path.stat().st_size >= 10 * 1024 * 1024
+    return line, repeats
+
+
+def test_ten_megabytes_redacts_inside_the_budget_to_an_output_file(tmp_path):
+    """SC-009: the 10 MB / 10 s budget holds on the **output-file** destination.
+
+    002 SC-009 states the throughput budget for the feature as a whole, and
+    ``--out-dir`` is a second destination rather than a second redactor, so the
+    budget has to be met writing to a file and not only to standard output.
+    The run is also checked for the properties a faster-but-wrong
+    implementation would lose: every line redacted in every category, no
+    sample value surviving, and no redacted content on standard output.
+    """
+    source = tmp_path / "big.log"
+    _line, repeats = _ten_megabyte_log(source)
+    clean = tmp_path / "clean"
+
+    start = time.perf_counter()
+    status, out, err = run_cli(["--out-dir", str(clean), str(source)])
+    elapsed = time.perf_counter() - start
+
+    assert status == 0
+    assert err == b""
+    # The tally only, never the redacted stream (002 US2-2, FR-010).
+    assert out == b"wrote 1 file\n"
+
+    written = read_bytes_of(clean / "big.log")
+    assert written.count(b"[EMAIL]") == repeats
+    assert written.count(b"[IP]") == repeats
+    assert written.count(b"[CARD]") == repeats
+    assert written.count(b"[PHONE]") == repeats
+    assert b"jane.doe@example.com" not in written
+    assert b"14155552671" not in written
+
+    assert elapsed < THROUGHPUT_BUDGET_SECONDS, (
+        f"{source.stat().st_size} bytes to an output file took "
+        f"{elapsed:.2f}s, over the {THROUGHPUT_BUDGET_SECONDS}s budget"
+    )
+
+
+def test_ten_megabytes_is_byte_identical_on_both_destinations(tmp_path):
+    """SC-005 at scale: the destination changes where, never what.
+
+    Pairs with the two throughput tests above -- each destination is inside the
+    budget, and at 10 MB they still produce the identical byte stream, so
+    neither path is fast because it is doing less (002 SR-003).
+    """
+    source = tmp_path / "big.log"
+    _ten_megabyte_log(source)
+    clean = tmp_path / "clean"
+
+    status_stream, streamed, err_stream = run_cli([str(source)])
+    status_file, tally, err_file = run_cli(
+        ["--out-dir", str(clean), str(source)]
+    )
+
+    assert status_stream == status_file == 0
+    assert err_stream == err_file == b""
+    assert tally == b"wrote 1 file\n"
+    assert read_bytes_of(clean / "big.log") == streamed
+
