+"""Output-folder security requirements SR-005 - SR-008, SR-010, SR-012.
+
+Constitution Principle V requires every security requirement to be covered by
+automated tests "including negative tests that prove the control rejects
+malicious input", on the same terms as any other requirement. Writing to the
+filesystem is the threat surface feature 001 did not have at all, so every
+control gets both a **direct unit test** of the helper that implements it --
+``output_path_for`` and ``open_output``, fixed as an internal surface by
+002 contracts/cli.md -- and an **end-to-end** test through the real entry point.
+
+No ``skipif`` and no ``xfail`` anywhere: a case the environment cannot produce
+is injected instead (002 research.md D-114).
+"""
+
+import builtins
+import io
+import os
+import socket
+import stat
+
+import pytest
+
+from logredact import cli
+from logredact.cli import open_output, output_path_for
+from conftest import (
+    DIR_MODE,
+    FILE_MODE,
+    SAMPLE_VALUES,
+    dirs_under,
+    files_under,
+    mode_of,
+    read_bytes_of,
+    run_cli,
+)
+
+SENSITIVE = (
+    b"user jane@example.com from 10.0.0.7 paid 4111 1111 1111 1111 "
+    b"call +14155552671 and +442071838750\n"
+)
+REDACTED = b"user [EMAIL] from [IP] paid [CARD] call [PHONE] and [PHONE]\n"
+
+
+@pytest.fixture
+def work(tmp_path):
+    root = tmp_path / "work"
+    (root / "logs" / "2026").mkdir(parents=True)
+    (root / "logs" / "2026" / "app.log").write_bytes(SENSITIVE)
+    (root / "web.log").write_bytes(SENSITIVE)
+    return root
+
+
+# --------------------------------------------------------------------------
+# SR-005: the output name is the FILE's final path component, only
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("file_path", "expected_name"),
+    [
+        ("app.log", "app.log"),
+        ("logs/2026/app.log", "app.log"),
+        ("./logs/app.log", "app.log"),
+        ("../../etc/passwd", "passwd"),
+        ("/etc/passwd", "passwd"),
+        ("../../../../../../etc/shadow", "shadow"),
+        ("/a/b/c/d/e/f/g.log", "g.log"),
+        ("..//..//x.log", "x.log"),
+        ("-", "-"),
+        ("--count", "--count"),
+    ],
+)
+def test_output_path_for_keeps_only_the_final_component(
+    tmp_path, file_path, expected_name
+):
+    """SR-005 / O-5: directory components, ``..``, and an absolute root are
+    all discarded by ``basename`` alone, before anything else runs."""
+    out_dir = str(tmp_path)
+    assert output_path_for(out_dir, file_path) == os.path.join(
+        out_dir, expected_name
+    )
+    # Whatever the FILE said, the result is inside DIR and one level deep.
+    assert os.path.dirname(output_path_for(out_dir, file_path)) == out_dir
+
+
+@pytest.mark.parametrize("file_path", ["", ".", "..", "a/", "sub/..", "logs/", "/"])
+def test_output_path_for_refuses_an_unusable_final_component(tmp_path, file_path):
+    """SR-005 / O-7: a guess would be worse than a failure (Principle II)."""
+    with pytest.raises(ValueError) as raised:
+        output_path_for(str(tmp_path), file_path)
+    message = str(raised.value)
+    # SR-001: names only the caller's own strings, and is one line.
+    assert "\n" not in message
+    assert "Traceback" not in message
+
+
+def test_output_path_for_refuses_a_path_outside_the_resolved_dir(tmp_path):
+    """SR-005 / O-6: resolution happens on the path *within* DIR.
+
+    A link planted at the output path resolves to its target's directory, not
+    to DIR, so containment rejects it independently of ``O_NOFOLLOW`` -- two
+    mechanisms catching the same attack (002 research.md D-111).
+    """
+    clean = tmp_path / "clean"
+    clean.mkdir()
+    outside = tmp_path / "outside"
+    outside.mkdir()
+    os.symlink(outside / "escaped.log", clean / "web.log")
+
+    with pytest.raises(ValueError) as raised:
+        output_path_for(str(clean), "web.log")
+    assert "web.log" in str(raised.value)
+    # Nothing was created through the link.
+    assert not (outside / "escaped.log").exists()
+
+
+def test_deep_prefixes_and_traversal_all_write_only_inside_dir(tmp_path):
+    """SR-005 / SC-006 / G-3b end to end: nothing outside DIR is touched."""
+    root = tmp_path / "root"
+    (root / "logs" / "2026").mkdir(parents=True)
+    (root / "logs" / "2026" / "app.log").write_bytes(SENSITIVE)
+    outside = tmp_path / "outside.log"
+    outside.write_bytes(b"outside content\n")
+    absolute = tmp_path / "absolute.log"
+    absolute.write_bytes(b"absolute content\n")
+    sibling_before = sorted(os.listdir(tmp_path))
+
+    status, out, err = run_cli(
+        [
+            "--out-dir",
+            "jail",
+            "logs/2026/app.log",
+            "../outside.log",
+            str(absolute),
+        ],
+        cwd=str(root),
+    )
+    assert status == 0
+    assert out == b"wrote 3 files\n"
+    assert err == b""
+
+    jail = root / "jail"
+    assert sorted(os.listdir(jail)) == ["absolute.log", "app.log", "outside.log"]
+    # Every created path is a direct child of DIR.
+    for path in files_under(jail):
+        assert os.path.dirname(path) == str(jail)
+    # Nothing above DIR appeared, and the inputs are unchanged.
+    assert sorted(os.listdir(tmp_path)) == sibling_before
+    assert read_bytes_of(outside) == b"outside content\n"
+    assert read_bytes_of(absolute) == b"absolute content\n"
+    assert read_bytes_of(root / "logs" / "2026" / "app.log") == SENSITIVE
+    # No directory structure travelled with the inputs.
+    assert not (jail / "logs").exists()
+    assert dirs_under(jail) == [str(jail)]
+
+
+@pytest.mark.parametrize("file_arg", [".", "..", "sub/..", "logs/"])
+def test_an_unusable_final_component_fails_with_status_two(work, file_arg):
+    """SR-005 / O-7 end to end."""
+    (work / "sub").mkdir(exist_ok=True)
+    status, out, err = run_cli(
+        ["--count", "--out-dir", "clean", file_arg], cwd=str(work)
+    )
+    assert status == 2
+    assert err != b""
+    assert b"wrote" not in out
+    assert b"emails=" not in err
+    assert b"Traceback" not in err
+    # Nothing was written into DIR.
+    assert files_under(work / "clean") == []
+
+
+# --------------------------------------------------------------------------
+# SR-006: a link, directory, device, or pipe at the output path
+# --------------------------------------------------------------------------
+
+
+def test_a_planted_symlink_is_not_followed(work):
+    """SR-006 / SC-006: exit 2, a diagnostic naming the path, target never made."""
+    clean = work / "clean"
+    clean.mkdir()
+    escape = work / "escape.txt"
+    os.symlink(escape, clean / "web.log")
+    assert not escape.exists()
+
+    status, out, err = run_cli(
+        ["--count", "--out-dir", "clean", "web.log"], cwd=str(work)
+    )
+    assert status == 2
+    assert out == b""
+    text = err.decode()
+    assert "web.log" in text
+    # Two independent mechanisms refuse this, and either message is correct:
+    # containment sees the link's resolved parent is not DIR, and ``O_NOFOLLOW``
+    # plus the ``lstat`` pre-check see that the path is not a regular file
+    # (002 research.md D-111). Containment runs first, so for a link pointing
+    # *out* of DIR that is the wording the caller gets.
+    assert ("not a direct child" in text) or ("not a regular file" in text)
+    assert "Traceback" not in text
+    assert b"emails=" not in err
+    # The link target was never created -- the write did not happen anywhere.
+    assert not escape.exists()
+    # And the link itself is still a link, unchanged.
+    assert os.path.islink(clean / "web.log")
+
+
+def test_a_symlink_pointing_inside_dir_is_still_not_followed(work):
+    """SR-006: the case where ``O_NOFOLLOW`` is the mechanism that fires.
+
+    This link resolves to a direct child of DIR, so containment passes and the
+    regular-file guard is the only thing standing between the run and a write
+    through a link. It must still refuse.
+    """
+    clean = work / "clean"
+    clean.mkdir()
+    sibling = clean / "other.log"
+    os.symlink(sibling, clean / "web.log")
+
+    status, out, err = run_cli(
+        ["--count", "--out-dir", "clean", "web.log"], cwd=str(work)
+    )
+    assert status == 2
+    assert out == b""
+    text = err.decode()
+    assert "web.log" in text
+    assert "not a regular file" in text
+    assert b"emails=" not in err
+    # The link was not followed, so the sibling was never created.
+    assert not sibling.exists()
+    assert os.path.islink(clean / "web.log")
+
+
+def test_a_symlink_to_an_existing_outside_file_does_not_overwrite_it(work):
+    """SR-006 / SC-006: the pointed-to file is not truncated either."""
+    clean = work / "clean"
+    clean.mkdir()
+    victim = work / "victim.txt"
+    victim.write_bytes(b"precious\n")
+    os.symlink(victim, clean / "web.log")
+
+    status, _out, err = run_cli(["--out-dir", "clean", "web.log"], cwd=str(work))
+    assert status == 2
+    assert b"web.log" in err
+    assert read_bytes_of(victim) == b"precious\n"
+
+
+def test_open_output_refuses_a_symlink_directly(tmp_path):
+    """SR-006 as a unit test of the helper that enforces it."""
+    source = tmp_path / "in.log"
+    source.write_bytes(SENSITIVE)
+    target = tmp_path / "link"
+    escape = tmp_path / "escape.txt"
+    os.symlink(escape, target)
+
+    with open(source, "rb") as handle:
+        with pytest.raises(ValueError) as raised:
+            open_output(str(target), handle.fileno())
+    assert "not a regular file" in str(raised.value)
+    assert not escape.exists()
+
+
+def test_open_output_refuses_a_directory_directly(tmp_path):
+    """SR-006: checked on the descriptor, so there is no time-of-check gap."""
+    source = tmp_path / "in.log"
+    source.write_bytes(SENSITIVE)
+    target = tmp_path / "adir"
+    target.mkdir()
+
+    with open(source, "rb") as handle:
+        with pytest.raises(ValueError) as raised:
+            open_output(str(target), handle.fileno())
+    assert "not a regular file" in str(raised.value)
+    assert target.is_dir()
+
+
+def test_open_output_refuses_a_named_pipe_directly(tmp_path):
+    """SR-006 / Principle II: fails immediately, never blocks for a reader."""
+    source = tmp_path / "in.log"
+    source.write_bytes(SENSITIVE)
+    target = tmp_path / "pipe"
+    os.mkfifo(target)
+
+    with open(source, "rb") as handle:
+        with pytest.raises(ValueError) as raised:
+            open_output(str(target), handle.fileno())
+    assert "not a regular file" in str(raised.value)
+    assert stat.S_ISFIFO(os.lstat(target).st_mode)
+
+
+def test_a_unix_socket_at_the_output_path_fails_loudly(work):
+    """SR-006 / O-9: a connection endpoint is not a regular file either."""
+    clean = work / "clean"
+    clean.mkdir()
+    endpoint = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    try:
+        endpoint.bind(str(clean / "web.log"))
+        assert stat.S_ISSOCK(os.lstat(clean / "web.log").st_mode)
+        status, out, err = run_cli(
+            ["--count", "--out-dir", "clean", "web.log"], cwd=str(work)
+        )
+    finally:
+        endpoint.close()
+    assert status == 2
+    assert out == b""
+    assert b"web.log" in err
+    assert b"not a regular file" in err
+    assert b"emails=" not in err
+
+
+def test_a_device_at_the_output_path_fails_loudly(work):
+    """SR-006 / O-9: a character device is refused before any open.
+
+    ``/dev/null`` is used because it is a real character device on every POSIX
+    system, which keeps the case deterministic without creating a device node
+    (and therefore without a uid-conditional skip, which Principle III
+    forbids). The ``lstat`` pre-check refuses it, so nothing is opened.
+    """
+    assert stat.S_ISCHR(os.lstat("/dev/null").st_mode)
+    # An input FILE whose final path component is "null", so the derived output
+    # path is "/dev/null" -- a character device.
+    (work / "null").write_bytes(SENSITIVE)
+    status, out, err = run_cli(
+        ["--count", "--out-dir", "/dev", "null"], cwd=str(work)
+    )
+    assert status == 2
+    assert out == b""
+    assert b"null" in err
+    assert b"not a regular file" in err
+    assert b"emails=" not in err
+    # Still a character device, untouched.
+    assert stat.S_ISCHR(os.lstat("/dev/null").st_mode)
+
+
+# --------------------------------------------------------------------------
+# SR-007: owner-only permissions on everything the tool creates
+# --------------------------------------------------------------------------
+
+
+def test_every_created_directory_and_file_is_owner_only(work):
+    """SR-007 / SC-007: including the **intermediates** of a nested DIR."""
+    status, out, err = run_cli(
+        ["--out-dir", "perms/a/b", "web.log", "logs/2026/app.log"],
+        cwd=str(work),
+    )
+    assert status == 0
+    assert out == b"wrote 2 files\n"
+    assert err == b""
+
+    for directory in dirs_under(work / "perms"):
+        assert mode_of(directory) == DIR_MODE, directory
+    assert len(dirs_under(work / "perms")) == 3
+    for path in files_under(work / "perms"):
+        assert mode_of(path) == FILE_MODE, path
+    assert len(files_under(work / "perms")) == 2
+
+
+def test_a_permissive_umask_does_not_widen_what_is_created(work, monkeypatch):
+    """SR-007 / D-108: ``mkdir``'s mode is masked, so ``chmod`` is explicit.
+
+    Run in process with a deliberately permissive umask. Without the explicit
+    ``chmod`` after each ``mkdir`` the directories would come out ``0o777``.
+    """
+    previous = os.umask(0o000)
+    try:
+        out = io.StringIO()
+        err = io.StringIO()
+        status = cli.main(
+            ["--out-dir", str(work / "wide" / "a"), str(work / "web.log")],
+            stdin=io.StringIO(""),
+            stdout=out,
+            stderr=err,
+        )
+    finally:
+        os.umask(previous)
+    assert status == 0
+    assert out.getvalue() == "wrote 1 file\n"
+    for directory in dirs_under(work / "wide"):
+        assert mode_of(directory) == DIR_MODE, directory
+    assert mode_of(work / "wide" / "a" / "web.log") == FILE_MODE
+
+
+def test_a_pre_existing_output_file_is_narrowed_never_widened(work):
+    """SR-007 / SC-007: ``0o666`` in, ``0o600`` out."""
+    clean = work / "clean"
+    clean.mkdir()
+    target = clean / "web.log"
+    target.write_bytes(b"stale\n")
+    os.chmod(target, 0o666)
+
+    status, out, _err = run_cli(["--out-dir", "clean", "web.log"], cwd=str(work))
+    assert status == 0
+    assert out == b"wrote 1 file\n"
+    assert mode_of(target) == FILE_MODE
+    assert read_bytes_of(target) == REDACTED
+
+
+def test_a_pre_existing_narrow_output_file_is_not_widened(work):
+    """SR-007: ``fchmod`` narrows to 0o600; it never relaxes a stricter mode
+    into something more permissive than the requirement."""
+    clean = work / "clean"
+    clean.mkdir()
+    target = clean / "web.log"
+    target.write_bytes(b"stale\n")
+    os.chmod(target, 0o400)
+
+    status, _out, _err = run_cli(["--out-dir", "clean", "web.log"], cwd=str(work))
+    assert status == 0
+    assert mode_of(target) == FILE_MODE
+    assert mode_of(target) & 0o077 == 0
+
+
+def test_an_existing_directory_is_not_re_permissioned(work):
+    """SR-008 / O-3: the tool does not change modes it was not asked to."""
+    clean = work / "clean"
+    clean.mkdir()
+    os.chmod(clean, 0o755)
+    status, _out, _err = run_cli(["--out-dir", "clean", "web.log"], cwd=str(work))
+    assert status == 0
+    assert mode_of(clean) == 0o755
+
+
+def test_no_temporary_file_is_created_at_any_point(work, monkeypatch):
+    """SR-007 / O-14: every path opened for writing is an expected output path.
+
+    Asserted by recording the writes as they happen rather than by inspecting
+    the folder afterwards, because a temporary file that was created and then
+    renamed away would leave no trace to inspect.
+    """
+    real_os_open = os.open
+    opened_for_writing = []
+
+    def recording(path, flags, mode=0o777, **kwargs):
+        if flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT):
+            opened_for_writing.append(os.fspath(path))
+        return real_os_open(path, flags, mode, **kwargs)
+
+    monkeypatch.setattr(os, "open", recording)
+
+    clean = work / "clean"
+    out = io.StringIO()
+    err = io.StringIO()
+    status = cli.main(
+        [
+            "--out-dir",
+            str(clean),
+            str(work / "web.log"),
+            str(work / "logs" / "2026" / "app.log"),
+        ],
+        stdin=io.StringIO(""),
+        stdout=out,
+        stderr=err,
+    )
+    assert status == 0
+    assert opened_for_writing == [
+        str(clean / "web.log"),
+        str(clean / "app.log"),
+    ]
+    # And the folder holds exactly those two files, nothing else.
+    assert sorted(os.listdir(clean)) == ["app.log", "web.log"]
+    for name in opened_for_writing:
+        assert "tmp" not in os.path.basename(name).lower()
+
+
+# --------------------------------------------------------------------------
+# SR-008: input files are never written, and nothing outside DIR changes
+# --------------------------------------------------------------------------
+
+
+def test_out_dir_dot_is_refused_with_the_input_fully_intact(work):
+    """SR-008 / O-10 / G-4: refused before any truncation can happen."""
+    target = work / "web.log"
+    before = read_bytes_of(target)
+    before_stat = target.stat()
+
+    status, out, err = run_cli(
+        ["--count", "--out-dir", ".", "web.log"], cwd=str(work)
+    )
+    assert status == 2
+    assert out == b""
+    assert b"web.log" in err
+    assert b"emails=" not in err
+
+    after = target.stat()
+    assert read_bytes_of(target) == before
+    assert after.st_size == before_stat.st_size
+    assert after.st_mtime_ns == before_stat.st_mtime_ns
+    assert mode_of(target) == mode_of(target)
