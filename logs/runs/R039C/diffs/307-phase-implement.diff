+"""User Story 1: phone recognition and its boundaries (FR-001, FR-002, SR-002).
+
+Pure-function tests over :func:`logredact.redact.redact_line`, because the
+phone rule has no I/O in it: the grammar is
+``"+" ASCII-DIGIT{8,15}`` not immediately followed by an ASCII digit
+(contracts/redaction-rules.md section 2).
+
+The near-miss corpus is as important as the positive one. SC-002 requires a
+number that does not qualify to come back **byte-for-byte unchanged**, and
+SR-002 requires that rejecting an over-long candidate removes none of its
+digits -- a partial redaction would disclose part of the value while looking
+like a success.
+"""
+
+import pytest
+
+from logredact.redact import PHONE_PLACEHOLDER, redact_line
+from conftest import (
+    SAMPLE_PHONE,
+    SAMPLE_PHONE_2,
+    SAMPLE_PHONE_MAX,
+    SAMPLE_PHONE_MIN,
+    SAMPLE_LONG_PHONE,
+    SAMPLE_SHORT_PHONE,
+)
+
+# Arabic-Indic decimal digits: decimal digits to Unicode, not ASCII [0-9]
+# (FR-002, P-3). Written as escapes so the file stays ASCII-readable.
+ARABIC_INDIC_EIGHT = "١٢٣٤٥٦٧٨"
+
+
+def redacted(text):
+    result, _counts = redact_line(text)
+    return result
+
+
+# --------------------------------------------------------------------------
+# FR-001: a "+" plus 8 to 15 contiguous ASCII digits becomes [PHONE]
+# --------------------------------------------------------------------------
+
+
+def test_the_placeholder_is_the_fixed_literal():
+    """SR-001: a fixed literal with no length hint, padding, hash, or counter."""
+    assert PHONE_PLACEHOLDER == "[PHONE]"
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        # The headline case.
+        ("call +14155552671 now", "call [PHONE] now"),
+        # Both bounds qualify (P-2).
+        (SAMPLE_PHONE_MIN, PHONE_PLACEHOLDER),          # exactly 8 digits
+        (SAMPLE_PHONE_MAX, PHONE_PLACEHOLDER),          # exactly 15 digits
+        # Lengths in between.
+        ("+123456789", PHONE_PLACEHOLDER),
+        ("+12345678901234", PHONE_PLACEHOLDER),
+        # A trailing non-digit satisfies the right boundary (P-5).
+        ("+14155552671.", "[PHONE]."),
+        ("+14155552671,", "[PHONE],"),
+        ("+14155552671;", "[PHONE];"),
+        ("+14155552671)", "[PHONE])"),
+        ("+14155552671\t", "[PHONE]\t"),
+        # Flush against line start and line end.
+        ("+14155552671 trailing", "[PHONE] trailing"),
+        ("leading +14155552671", "leading [PHONE]"),
+        (SAMPLE_PHONE, PHONE_PLACEHOLDER),
+        # Every occurrence is replaced (P-7).
+        ("+14155552671 +442071838750", "[PHONE] [PHONE]"),
+        ("a +12345678 b +123456789012345 c", "a [PHONE] b [PHONE] c"),
+        # The character before the "+" is never examined (P-1).
+        ("x ++14155552671", "x +[PHONE]"),
+        ("100+14155552671", "100[PHONE]"),
+        ("abc+14155552671", "abc[PHONE]"),
+        ("-+14155552671", "-[PHONE]"),
+    ],
+)
+def test_phone_positives(line, expected):
+    assert redacted(line) == expected
+
+
+def test_both_bounds_are_inclusive():
+    """FR-001: 8 and 15 digits both qualify; 7 and 16 do not."""
+    for length in range(8, 16):
+        candidate = "+" + "1" * length
+        assert redacted(candidate) == PHONE_PLACEHOLDER, length
+    assert redacted("+" + "1" * 7) == "+" + "1" * 7
+    assert redacted("+" + "1" * 16) == "+" + "1" * 16
+
+
+def test_every_occurrence_is_counted():
+    """FR-004: counts are replacements, not lines and not distinct values."""
+    _result, counts = redact_line("+14155552671 +442071838750 +14155552671")
+    assert counts["phones"] == 3
+    assert counts["emails"] == 0
+    assert counts["ips"] == 0
+    assert counts["cards"] == 0
+
+
+def test_counts_carry_exactly_the_four_keys():
+    """FR-004 / data-model.md section 3: four keys, always present."""
+    _result, counts = redact_line("nothing here")
+    assert counts == {"emails": 0, "ips": 0, "cards": 0, "phones": 0}
+
+
+def test_the_second_plus_anchors_and_the_first_survives():
+    """P-1: the left context is not part of the match, so it is not removed."""
+    result, counts = redact_line("x ++14155552671")
+    assert result == "x +[PHONE]"
+    assert counts["phones"] == 1
+    # The surviving "+" is the input's own first one, verbatim.
+    assert result.index("+") == 2
+
+
+# --------------------------------------------------------------------------
+# FR-002: near-misses come back byte-for-byte unchanged
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        # Too short (P-2).
+        SAMPLE_SHORT_PHONE,            # 7 digits
+        "+1",
+        "+12",
+        "+1234567",
+        "tel +1234567 ext 9",
+        # Too long: 16 or more contiguous digits reject the whole candidate (P-5).
+        SAMPLE_LONG_PHONE,             # 16 digits
+        "+12345678901234567",          # 17 digits
+        "ref +1234567890123456 end",
+        # The digits are not contiguous with the "+" (P-2).
+        "+ 14155552671",
+        "+\t14155552671",
+        "+-14155552671",
+        "+(14155552671",
+        # Separated digit groups (P-2).
+        "+1 415 555 2671",
+        "+1-415-555-2671",
+        "+1.415.555.2671",
+        "+1(415)555-2671",
+        # Non-ASCII decimal digits (P-3, FR-002).
+        "+" + ARABIC_INDIC_EIGHT,
+        "+" + ARABIC_INDIC_EIGHT + ARABIC_INDIC_EIGHT,
+        # A bare plus, and plusses with nothing usable after them.
+        "+",
+        "++",
+        "+++",
+        "a + b",
+        "1 + 2 = 3",
+        # No "+" at all: a long digit run is not a phone number.
+        "14155552671",
+        "4155552671 called",
+    ],
+)
+def test_phone_near_misses_are_unchanged(line):
+    """SC-002: a number that does not qualify is returned verbatim."""
+    result, counts = redact_line(line)
+    assert result == line
+    assert counts["phones"] == 0
+    assert PHONE_PLACEHOLDER not in result
+
+
+def test_a_line_of_near_misses_is_byte_for_byte_unchanged():
+    """SC-002 as one line, mirroring quickstart Scenario 1's ``diff`` gate."""
+    line = (
+        "code +1234567 ref +1234567890123456 tel +1 415 555 2671 "
+        "+ 14155552671 + " + ARABIC_INDIC_EIGHT + "\n"
+    )
+    result, counts = redact_line(line)
+    assert result == line
+    assert counts == {"emails": 0, "ips": 0, "cards": 0, "phones": 0}
+
+
+def test_non_ascii_digits_are_not_counted_towards_the_length():
+    """FR-002 / P-3: mixing scripts cannot assemble a qualifying run."""
+    # Four ASCII digits then four Arabic-Indic ones: eight "digits" by a
+    # Unicode-aware reading, but only four ASCII ones, so nothing qualifies.
+    line = "+1234" + ARABIC_INDIC_EIGHT[:4]
+    assert redacted(line) == line
+
+
+# --------------------------------------------------------------------------
+# SR-002: no partial redaction, in either direction
+# --------------------------------------------------------------------------
+
+
+def test_no_digit_of_a_rejected_over_long_candidate_is_removed():
+    """SR-002 / P-5 / INV-9: rejecting must not strip a 15-digit prefix.
+
+    A pattern without the ``(?![0-9])`` lookahead would emit ``[PHONE]`` plus
+    the surplus digit -- a partial disclosure that still looks like a success.
+    """
+    for length in range(16, 25):
+        candidate = "+" + "1234567890123456789012345"[:length]
+        result, counts = redact_line(candidate)
+        assert result == candidate, length
+        assert counts["phones"] == 0, length
+        assert PHONE_PLACEHOLDER not in result, length
+        # Every digit of the input is still present, in the same count.
+        assert result.count("1") == candidate.count("1")
+        assert len(result) == len(candidate)
+
+
+def test_no_digit_of_an_accepted_number_survives_as_a_substring():
+    """SR-002 / G-7 / INV-9: the whole span is replaced, never a part of it."""
+    for value in (
+        SAMPLE_PHONE,
+        SAMPLE_PHONE_2,
+        SAMPLE_PHONE_MIN,
+        SAMPLE_PHONE_MAX,
+    ):
+        result = redacted("before " + value + " after")
+        assert result == "before [PHONE] after"
+        assert value not in result
+        # Not even the digits without the "+".
+        assert value[1:] not in result
+        # And no run of three or more of its digits survives.
+        digits = value[1:]
+        for start in range(len(digits) - 2):
+            assert digits[start:start + 3] not in result
+
+
+def test_the_placeholder_discloses_nothing_about_the_length():
+    """SR-001: an 8-digit and a 15-digit number produce identical output."""
+    short = redacted(SAMPLE_PHONE_MIN)
+    long = redacted(SAMPLE_PHONE_MAX)
+    assert short == long == PHONE_PLACEHOLDER
+
+
+def test_a_rejected_candidate_leaks_nothing_and_loses_nothing():
+    """SC-002 + SR-002 together on the 16-digit boundary case."""
+    result, counts = redact_line("ref " + SAMPLE_LONG_PHONE + " end")
+    assert result == "ref " + SAMPLE_LONG_PHONE + " end"
+    assert counts["phones"] == 0
+
+
+# --------------------------------------------------------------------------
+# Line scoping and structure (P-6)
+# --------------------------------------------------------------------------
+
+
+def test_matching_is_line_scoped():
+    """P-6: a number split across a terminator is not recognised."""
+    assert redacted("+1415\n5552671") == "+1415\n5552671"
+
+
+def test_the_terminator_is_preserved_with_a_match():
+    for terminator in ("\n", "\r\n", "\r"):
+        assert redacted("+14155552671" + terminator) == PHONE_PLACEHOLDER + terminator
+
+
+def test_unmatched_text_around_a_match_is_verbatim():
+    line = "A\t+14155552671  B\t+442071838750   C"
+    assert redacted(line) == "A\t[PHONE]  B\t[PHONE]   C"
+
+
+def test_a_literal_placeholder_in_the_input_is_inert():
+    """R-3: inserted placeholder text is never re-scanned."""
+    result, counts = redact_line("[PHONE] +14155552671")
+    assert result == "[PHONE] [PHONE]"
+    assert counts["phones"] == 1
+    assert result.count(PHONE_PLACEHOLDER) == 2
+    assert "[[" not in result
+    assert "]]" not in result
