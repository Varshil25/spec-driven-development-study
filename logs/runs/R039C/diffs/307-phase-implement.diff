+# --------------------------------------------------------------------------
+# Rank 4: phone is below card (002 FR-003, contracts/redaction-rules.md 3)
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        # Rank 1 beats rank 4: "+" and the digits are a valid email local part.
+        ("+14155552671@example.com", "[EMAIL]"),
+        ("+12345678@b.io", "[EMAIL]"),
+        # Rank 2 beats rank 4: the digit run after "+" is interrupted by "."
+        # before eight are reached, so rank 2 claims the address.
+        ("+10.0.0.7", "+[IP]"),
+        ("+255.255.255.255", "+[IP]"),
+        # Rank 3 beats rank 4 -- the case that makes 002 FR-005 literally true.
+        ("+4222222222222", "+[CARD]"),
+        ("call +4222222222222 now", "call +[CARD] now"),
+        # Adjacent spans of different ranks, each replaced exactly once.
+        ("4111111111111111+14155552671", "[CARD][PHONE]"),
+        ("a@b.io+14155552671", "[EMAIL][PHONE]"),
+        ("+14155552671 jane@example.com", "[PHONE] [EMAIL]"),
+        ("+12345678 4111111111111111", "[PHONE] [CARD]"),
+        ("+12345678 10.0.0.7", "[PHONE] [IP]"),
+        # All four ranks on one line, in input order.
+        (
+            "a@b.io 1.2.3.4 4111 1111 1111 1111 +14155552671",
+            "[EMAIL] [IP] [CARD] [PHONE]",
+        ),
+        # Inserted placeholder text is never re-scanned (R-3).
+        ("[PHONE] +14155552671", "[PHONE] [PHONE]"),
+        ("[CARD] +4222222222222", "[CARD] +[CARD]"),
+    ],
+)
+def test_four_rank_precedence_results(line, expected):
+    assert redacted(line) == expected
+
+
+def test_card_outranks_phone_so_nothing_redacted_today_changes():
+    """FR-003 / FR-005 / R-4: 13 digits passing Luhn stay ``+[CARD]``.
+
+    The leftover gap after the card claims the digits is the single character
+    ``"+"``, in which no phone can match. If phone ran at rank 3 instead, this
+    line would become ``+[PHONE]`` and reclassify text the tool already
+    redacts -- which FR-005 forbids outright.
+    """
+    result, counts = redact_line("+4222222222222")
+    assert result == "+" + CARD_PLACEHOLDER
+    assert counts["cards"] == 1
+    assert counts["phones"] == 0
+    assert PHONE_PLACEHOLDER not in result
+
+
+def test_email_suppresses_an_overlapping_phone_candidate():
+    """FR-003: rank 1 claims the span, so rank 4 is never offered it."""
+    result, counts = redact_line("+14155552671@example.com")
+    assert result == EMAIL_PLACEHOLDER
+    assert counts["emails"] == 1
+    assert counts["phones"] == 0
+    assert PHONE_PLACEHOLDER not in result
+
+
+def test_ipv4_suppresses_an_overlapping_phone_candidate():
+    """FR-003: rank 2 claims the address; the gap left is the bare ``"+"``."""
+    result, counts = redact_line("+10.0.0.7")
+    assert result == "+" + IP_PLACEHOLDER
+    assert counts["ips"] == 1
+    assert counts["phones"] == 0
+
+
+def test_adjacent_spans_of_different_ranks_are_each_replaced_once():
+    """INV-7 / R-2: each character is replaced at most once."""
+    result, counts = redact_line("4111111111111111+14155552671")
+    assert result == CARD_PLACEHOLDER + PHONE_PLACEHOLDER
+    assert counts == {"emails": 0, "ips": 0, "cards": 1, "phones": 1}
+    assert result.count(CARD_PLACEHOLDER) == 1
+    assert result.count(PHONE_PLACEHOLDER) == 1
+
+
+def test_placeholders_are_never_nested_across_four_ranks():
+    """INV-8 / R-2."""
+    line = "[PHONE] +14155552671 [CARD] +4222222222222 [IP] +10.0.0.7"
+    result, _counts = redact_line(line)
+    assert result == "[PHONE] [PHONE] [CARD] +[CARD] [IP] +[IP]"
+    assert "[[" not in result
+    assert "]]" not in result
+    assert "[PHONE][PHONE]" not in result
+
+
+def test_a_gap_abutting_a_higher_ranked_match_is_matched_soundly():
+    """contracts/redaction-rules.md section 3, slice-boundary soundness.
+
+    ``(?![0-9])`` is evaluated at the end of a **gap slice**, not of the whole
+    line, which would be unsound if a gap could end part-way through a digit
+    run. It cannot: a gap ends where a rank 1-3 match begins, and no rank 1-3
+    match can begin with a digit immediately preceded by a digit. These are the
+    tightest cases the grammar permits.
+    """
+    # Gap ends exactly where the card match begins, one space after the phone.
+    assert redacted("+12345678 4111111111111111") == "[PHONE] [CARD]"
+    # Gap begins exactly where the email match ends.
+    assert redacted("a@b.io+14155552671") == "[EMAIL][PHONE]"
+    # A 24-digit run after "+" is too long for a card (over 19) *and* too long
+    # for a phone (16 or more), so nothing at all is claimed and no digit is
+    # removed -- the lookahead is not satisfied at any of the eight lengths.
+    long_run = "+" + "1" * 24
+    assert redacted(long_run) == long_run
+    # A digit run that an unrecognised address interrupts: rank 2 does not
+    # apply (the leading octet is out of range and the lookbehind blocks a
+    # later start), so rank 4 claims the ten contiguous digits it can see.
+    assert redacted("+1234567810.0.0.7") == "[PHONE].0.0.7"
+
+
+def test_each_character_is_replaced_at_most_once_across_four_ranks():
+    """INV-7: the four stages partition the line; they never re-cover it."""
+    line = "a@b.io 1.2.3.4 4111 1111 1111 1111 +14155552671 +4222222222222"
+    result, counts = redact_line(line)
+    assert result == "[EMAIL] [IP] [CARD] [PHONE] +[CARD]"
+    assert counts == {"emails": 1, "ips": 1, "cards": 2, "phones": 1}
+    # One placeholder per replacement, and five replacements in total.
+    total = sum(counts.values())
+    assert total == 5
+    placeholders = (
+        result.count(EMAIL_PLACEHOLDER)
+        + result.count(IP_PLACEHOLDER)
+        + result.count(CARD_PLACEHOLDER)
+        + result.count(PHONE_PLACEHOLDER)
+    )
+    assert placeholders == total
