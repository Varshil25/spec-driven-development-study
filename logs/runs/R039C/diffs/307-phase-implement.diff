@@ -0,0 +1,612 @@
+"""User Story 4: every output-folder failure is loud (FR-012, FR-014, FR-015).
+
+Each case asserts **four** things, which is what 002 SC-008 requires and what
+Constitution Principle III demands of a failure path:
+
+1. exit status **2**;
+2. a non-empty diagnostic naming the problem on standard error;
+3. **no** ``wrote N files`` line on standard output;
+4. **no** ``--count`` summary on standard error.
+
+Never a half-filled folder reported as success.
+
+The two paths the environment cannot produce on its own -- an unwritable
+destination while running as root, and a failure in ``close`` -- are reached
+through ``call_main`` with a patched ``os.open`` and a patched ``open``, the
+same technique 001 D-008 used for the stdout write-failure path. Neither needs
+``skipif`` or ``xfail``, which Principle III forbids (002 research.md D-114).
+"""
+
+import builtins
+import io
+import os
+
+import pytest
+
+from logredact import cli
+from logredact.cli import MAX_LINE
+from conftest import read_bytes_of, run_cli, running_as_root
+
+SENSITIVE = b"user jane@example.com from 10.0.0.7 call +14155552671\n"
+REDACTED = b"user [EMAIL] from [IP] call [PHONE]\n"
+
+SUMMARY_FIELDS = (b"emails=", b"ips=", b"cards=", b"phones=")
+
+
+def assert_failed_cleanly(status, out, err, *, names=()):
+    """The four assertions every SC-008 case shares."""
+    assert status == 2
+    # A non-empty diagnostic naming the problem.
+    assert err != b""
+    text = err.decode("utf-8", "surrogateescape")
+    for fragment in names:
+        assert fragment in text, fragment
+    # No tally on stdout.
