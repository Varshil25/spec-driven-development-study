+        b"jane@example.com +14155552671 " + b"7" * (MAX_LINE + 10) + b"\n"
+    )
+    status, out, err = run_cli(
+        ["--count", "--out-dir", "clean", "secret-long.log"], cwd=str(work)
+    )
+    assert status == 2
+    assert b"wrote" not in out
+    assert b"emails=" not in err
+    text = err.decode()
+    # The limit is a number, so only *its* digits may appear.
+    assert str(MAX_LINE) in text
+    stripped = text.replace(str(MAX_LINE), "")
+    assert not any(character.isdigit() for character in stripped), stripped
+    assert "jane" not in text
+    assert "14155552671" not in text
+    assert len(err) < 500
+
+
+def test_an_over_long_line_leaves_no_complete_output_file(work):
+    """SR-009: a truncated output file never accompanies exit 0."""
+    good = work / "good.log"
+    good.write_bytes(b"a@b.io +14155552671\n")
+    bad = work / "bad.log"
+    bad.write_bytes(b"x" * (MAX_LINE + 10) + b"\n")
+
+    status, out, _err = run_cli(
+        ["--out-dir", "clean", "good.log", "bad.log"], cwd=str(work)
+    )
+    assert status == 2
+    assert b"wrote" not in out
+    clean = work / "clean"
+    # The first file completed and is kept; the second is empty or partial, and
+    # either way the run reported failure.
+    assert read_bytes_of(clean / "good.log") == b"[EMAIL] [PHONE]\n"
+    assert sorted(os.listdir(clean)) == ["bad.log", "good.log"]
+    assert read_bytes_of(clean / "bad.log") == b""
+
+
+def test_peak_memory_is_bounded_across_a_many_file_batch(work):
+    """SR-011 / SC-009: memory bounded by the per-line limit, not file count.
+
+    A batch of one hundred files, each far larger in total than any single
+    line, written to an output folder. Peak Python allocation must stay under
+    the per-line ceiling, which is only possible if each file is streamed line
+    by line and only one output file is open at a time.
+    """
+    line = b"2026-11-21 user a@b.io from 1.2.3.4 call +14155552671 ok\n"
+    per_file = 400
+    names = []
+    for index in range(100):
+        path = work / f"batch{index}.log"
+        path.write_bytes(line * per_file)
+        names.append(str(path))
+    total = len(line) * per_file * len(names)
+    assert total > 2 * MAX_LINE
+
+    clean = work / "clean"
+    tracemalloc.start()
+    try:
+        status = cli.main(
+            ["--out-dir", str(clean), *names],
+            stdin=io.StringIO(""),
+            stdout=_Sink(),
+            stderr=io.StringIO(),
+        )
+        _current, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+
+    assert status == 0
+    assert peak < MAX_LINE, (
+        f"peak {peak} bytes should stay below the per-line limit {MAX_LINE} "
+        f"while writing {total} bytes across {len(names)} files"
+    )
+    # All one hundred files were written.
+    assert len(files_under(clean)) == 100
+
+
+def test_peak_memory_does_not_grow_with_the_number_of_files(work):
+    """SR-011: ten times the files must not mean ten times the memory."""
+    line = b"plain log line with a@b.io and +14155552671 in it\n"
+
+    def peak_for(count, label):
+        names = []
+        for index in range(count):
+            path = work / f"{label}{index}.log"
+            path.write_bytes(line * 20)
+            names.append(str(path))
+        tracemalloc.start()
+        try:
+            status = cli.main(
+                ["--out-dir", str(work / ("out-" + label)), *names],
+                stdin=io.StringIO(""),
+                stdout=_Sink(),
+                stderr=io.StringIO(),
+            )
+            _current, peak = tracemalloc.get_traced_memory()
+        finally:
+            tracemalloc.stop()
+        assert status == 0
+        return peak
+
+    small = peak_for(10, "few")
+    large = peak_for(100, "many")
+    assert large < small * 3, (small, large)
