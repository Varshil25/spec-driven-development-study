+
+# ----------------------------------------------------------- FR-054 the unknown account
+
+
+def test_fr054_reset_for_an_unknown_account_exits_3_naming_it(seeded, run_cli):
+    """FR-054: a diagnostic naming the account on stderr, nothing on stdout, exit 3."""
