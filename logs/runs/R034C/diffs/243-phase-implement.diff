+    assert run_cli(["--store", str(store_path), "login", "alice"], NEW_PASSWORD + "\n") == (
+        4,
+        "",
+        "account locked\n",
+    )
+    assert run_cli(["--store", str(store_path), "unlock", "alice"])[0] == 0
+    assert run_cli(["--store", str(store_path), "login", "alice"], NEW_PASSWORD + "\n")[0] == 0
+
+
+def test_fr056_a_rejected_token_is_not_a_failed_login(seeded, run_cli, read_store):
+    """FR-056: the failure counter is never read or incremented by a reset."""
+    issue(seeded, run_cli)
+    for _ in range(6):
+        assert run_cli(
+            ["--store", str(seeded), "reset", "alice"], f"{'n' * 43}\n{NEW_PASSWORD}\n"
+        ) == REJECTED
+
+    record = read_store(seeded)["accounts"]["alice"]
