+
+def test_fr054_the_existence_check_consumes_no_standard_input(seeded):
+    """FR-054: the check precedes reading any line, as it does for unlock/passwd/delete."""
+    stdin_text = f"{'t' * 43}\n{NEW_PASSWORD}\n"
+    stdin = io.StringIO(stdin_text)
