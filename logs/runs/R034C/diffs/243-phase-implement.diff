+
+def test_fr055_end_of_input_is_never_an_empty_value(seeded, run_cli):
+    """FR-055: EOF and a present-but-empty line are different inputs with different replies."""
+    issue(seeded, run_cli)
+
+    # EOF where the token was required -> 2, naming the missing line.
+    assert run_cli(["--store", str(seeded), "reset", "alice"], "")[0] == 2
+    # A present-but-empty token line -> 1, because an empty token simply matches nothing.
+    assert run_cli(["--store", str(seeded), "reset", "alice"], f"\n{NEW_PASSWORD}\n") == REJECTED
+    # EOF where the password was required -> 2; a present-but-empty password line -> 2 for
+    # the length rule instead, and only after the token has been accepted.
+    token = issue(seeded, run_cli)
+    assert run_cli(["--store", str(seeded), "reset", "alice"], f"{token}\n")[2] == (
+        "no new password on standard input\n"
+    )
+    assert run_cli(["--store", str(seeded), "reset", "alice"], f"{token}\n\n")[2] == (
+        "password must be at least 12 characters\n"
+    )
+
+
+# --------------------------------------------- FR-056 the lock and the failure counter
+
+
+def test_fr056_a_reset_succeeds_on_a_locked_account_without_clearing_the_lock(
+    store_path, run_cli, read_store
+):
+    """FR-056: the reset works, and the account stays locked until unlock."""
+    seed(store_path, failed_logins=5, locked=True)
