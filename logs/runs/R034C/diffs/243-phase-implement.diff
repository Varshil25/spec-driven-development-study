+
+def test_fr055_end_of_input_is_checked_before_the_token_is_judged(seeded, run_cli):
+    """FR-055: a wrong token with a missing password line reports the missing line."""
+    issue(seeded, run_cli)
+    status, out, err = run_cli(["--store", str(seeded), "reset", "alice"], f"{'w' * 43}\n")
+    assert (status, out, err) == (2, "", "no new password on standard input\n")
