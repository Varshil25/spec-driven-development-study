+def test_fr055_a_token_with_no_following_line_reports_the_missing_password(seeded, run_cli):
+    """FR-055 / E9: exit 2 with a diagnostic, not an empty password."""
+    token = issue(seeded, run_cli)
+    before = seeded.read_bytes()
+
+    status, out, err = run_cli(["--store", str(seeded), "reset", "alice"], f"{token}\n")
+    assert (status, out, err) == (2, "", "no new password on standard input\n")
+    assert seeded.read_bytes() == before
