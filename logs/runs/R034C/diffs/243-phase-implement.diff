+"""A store written before this feature still loads, and strictness is not relaxed: FR-059.
+
+Two halves, and the second matters as much as the first. A pre-feature file must load
+*without complaint* and read as "no outstanding token" — and store validation must keep
+rejecting what it does not recognize rather than defaulting or ignoring it (FR-007). Two of
+these rejections close traps that would otherwise fail silently: ``reset_token: null`` would
+read as "no token", and ``expires_at: NaN`` — which ``json.loads`` accepts — would be a
+token permanently invalid while looking entirely ordinary (data-model.md rules 8-11, R-12).
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from accounts import passwords, store
+
+# A store file in exactly the shape feature 001 wrote: version 1, four keys per record,
+# no reset_token anywhere. The credential is real so that login still works against it.
+PASSWORD = "correct horse battery"
+NEW_PASSWORD = "a brand new secret"
+
+
+def write_pre_feature_store(path: Path, username: str = "carol") -> None:
+    salt = passwords.new_salt()
+    payload = {
+        "version": 1,
+        "accounts": {
+            username: {
+                "salt": store.encode(salt),
+                "verifier": store.encode(passwords.derive(PASSWORD, salt)),
+                "failed_logins": 0,
+                "locked": False,
+            }
+        },
+    }
+    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+@pytest.fixture
+def pre_feature(store_path: Path) -> Path:
+    write_pre_feature_store(store_path)
+    return store_path
+
+
+# ------------------------------------------------- FR-059 a pre-feature file still loads
+
+
+def test_fr059_a_pre_feature_store_loads_without_complaint(pre_feature):
+    """FR-059: the version stamp is still 1, so the file validates unchanged."""
+    accounts = store.load(pre_feature)
+    assert set(accounts) == {"carol"}
+    assert set(accounts["carol"]) == {"salt", "verifier", "failed_logins", "locked"}
+    assert store.VERSION == 1
+
+
+def test_fr059_every_existing_command_still_operates_on_a_pre_feature_store(
+    pre_feature, run_cli
+):
+    """FR-059 / FR-060: no migration step, so nothing changes for the five commands."""
+    assert run_cli(["--store", str(pre_feature), "login", "carol"], PASSWORD + "\n") == (
+        0,
+        "ok\n",
+        "",
+    )
+    assert run_cli(["--store", str(pre_feature), "unlock", "carol"]) == (0, "", "")
+    assert run_cli(["--store", str(pre_feature), "register", "dave"], "a second password\n") == (
+        0,
+        "registered dave\n",
+        "",
+    )
+    assert run_cli(
+        ["--store", str(pre_feature), "passwd", "carol"], f"{PASSWORD}\n{NEW_PASSWORD}\n"
+    ) == (0, "", "")
+    assert run_cli(["--store", str(pre_feature), "delete", "dave"], "a second password\n") == (
+        0,
+        "",
+        "",
+    )
+
+
+def test_fr059_a_pre_feature_account_behaves_as_having_no_outstanding_token(
+    pre_feature, run_cli
+):
+    """FR-059: absence of the key is "no outstanding token" — status 1, not an error."""
+    status, out, err = run_cli(
+        ["--store", str(pre_feature), "reset", "carol"], f"{'t' * 43}\n{NEW_PASSWORD}\n"
+    )
+    assert (status, out, err) == (1, "", "invalid token\n")
+
+
+def test_fr059_a_pre_feature_account_accepts_a_freshly_issued_token(
+    pre_feature, run_cli, read_store
+):
+    """FR-059: and can be given one, with no upgrade path to take first."""
+    status, out, err = run_cli(["--store", str(pre_feature), "reset-token", "carol"])
+    assert (status, err) == (0, "")
+    token = out[:-1]
+
+    assert run_cli(
+        ["--store", str(pre_feature), "reset", "carol"], f"{token}\n{NEW_PASSWORD}\n"
+    ) == (0, "password reset\n", "")
+    assert run_cli(["--store", str(pre_feature), "login", "carol"], NEW_PASSWORD + "\n")[0] == 0
+    assert "reset_token" not in read_store(pre_feature)["accounts"]["carol"]
+
+
+def test_fr059_loading_a_pre_feature_store_writes_nothing(pre_feature, run_cli):
+    """FR-059: no migration and no rewrite on load — a read-only command touches nothing."""
+    before = pre_feature.read_bytes()
+    assert run_cli(["--store", str(pre_feature), "login", "carol"], PASSWORD + "\n")[0] == 0
+    # login on success rewrites the store (it resets the counter), so use a path that does
+    # not: a rejected token writes nothing at all (research.md R-16).
+    after_login = pre_feature.read_bytes()
+    assert run_cli(["--store", str(pre_feature), "reset", "carol"], f"{'t' * 43}\nxxxxxxxxxxxx\n")[
+        0
+    ] == 1
+    assert pre_feature.read_bytes() == after_login
+    assert json.loads(before)["version"] == 1
+
+
+# ----------------------------------------- FR-059 strictness is preserved, not relaxed
+
+MALFORMED: dict[str, object] = {
+    "null": None,
+    "not an object (string)": "nope",
+    "not an object (list)": [],
+    "not an object (number)": 0,
+    "missing expires_at": {
+        "salt": "RkZGRkZGRkZGRkZGRkZGRg==",
+        "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+    },
+    "missing salt": {
+        "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+        "expires_at": 1763336400.0,
+    },
+    "extra key": {
+        "salt": "RkZGRkZGRkZGRkZGRkZGRg==",
+        "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+        "expires_at": 1763336400.0,
+        "ttl": 900,
+    },
+    "salt not 16 bytes": {
+        "salt": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+        "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+        "expires_at": 1763336400.0,
+    },
+    "salt not base64": {
+        "salt": "not base64 at all!!",
+        "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+        "expires_at": 1763336400.0,
+    },
+    "verifier not 32 bytes": {
+        "salt": "RkZGRkZGRkZGRkZGRkZGRg==",
+        "verifier": "RkZGRkZGRkZGRkZGRkZGRg==",
+        "expires_at": 1763336400.0,
+    },
+    "expires_at is a string": {
+        "salt": "RkZGRkZGRkZGRkZGRkZGRg==",
+        "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+        "expires_at": "soon",
+    },
+    "expires_at is a boolean": {
+        "salt": "RkZGRkZGRkZGRkZGRkZGRg==",
+        "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+        "expires_at": True,
+    },
+    "expires_at is null": {
+        "salt": "RkZGRkZGRkZGRkZGRkZGRg==",
+        "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+        "expires_at": None,
+    },
+}
+
+# json.loads accepts these three literals, so they must be written as raw JSON text rather
+# than produced by json.dumps from a Python float (data-model.md rule 10, research.md R-12).
+NON_FINITE = ("NaN", "Infinity", "-Infinity")
+
+
+def with_reset_token(path: Path, value: object) -> None:
+    """Write a store whose single account carries the given ``reset_token`` value."""
+    write_pre_feature_store(path)
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    payload["accounts"]["carol"]["reset_token"] = value
+    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+EVERY_COMMAND = [
+    (["register", "carol"], PASSWORD + "\n"),
+    (["login", "carol"], PASSWORD + "\n"),
+    (["unlock", "carol"], ""),
+    (["passwd", "carol"], f"{PASSWORD}\n{NEW_PASSWORD}\n"),
+    (["delete", "carol"], PASSWORD + "\n"),
+    (["reset-token", "carol"], ""),
+    (["reset", "carol"], f"{'t' * 43}\n{NEW_PASSWORD}\n"),
+]
+
+
+@pytest.mark.parametrize("case", sorted(MALFORMED), ids=sorted(MALFORMED))
+def test_fr059_a_malformed_reset_token_is_rejected_by_every_command(
+    case, store_path, run_cli
+):
+    """FR-059 / FR-007: a loud StoreError with status 2, never a defaulted value."""
+    with_reset_token(store_path, MALFORMED[case])
+
+    for tail, stdin_text in EVERY_COMMAND:
+        status, out, err = run_cli(["--store", str(store_path), *tail], stdin_text)
+        assert status == 2, (case, tail)
+        assert out == "", (case, tail)
+        assert err.startswith(f"not a valid store file: {store_path}: "), (case, err)
+        # The diagnostic names the account, the field, and the condition (rule 11)...
+        assert "account 'carol'" in err, (case, err)
+        assert "reset_token" in err, (case, err)
+        assert err.endswith("\n") and err.count("\n") == 1, (case, err)
+
+
+@pytest.mark.parametrize("literal", NON_FINITE, ids=NON_FINITE)
+def test_fr059_a_non_finite_expires_at_is_rejected(literal, store_path, run_cli):
+    """FR-059 / rule 10: NaN and +-Infinity are loud, not silently permanent states.
+
+    ``now < NaN`` is ``False`` for every ``now``, so a NaN window would be a token that
+    never validates while looking ordinary, and ``Infinity`` one that never expires. Both
+    are the plausible-wrong-answer class Principle II treats as the most severe defect.
+    """
+    write_pre_feature_store(store_path)
+    text = store_path.read_text(encoding="utf-8")
+    token_json = (
+        '{"salt": "RkZGRkZGRkZGRkZGRkZGRg==", '
+        '"verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=", '
+        f'"expires_at": {literal}}}'
+    )
+    payload = json.loads(text)
+    payload["accounts"]["carol"]["reset_token"] = "PLACEHOLDER"
+    text = json.dumps(payload, indent=2, sort_keys=True).replace('"PLACEHOLDER"', token_json)
+    store_path.write_text(text + "\n", encoding="utf-8")
+
+    # The literal really is in the file, and really is accepted by the JSON parser.
+    assert literal in store_path.read_text(encoding="utf-8")
+
+    status, out, err = run_cli(
+        ["--store", str(store_path), "reset", "carol"], f"{'t' * 43}\n{NEW_PASSWORD}\n"
+    )
+    assert (status, out) == (2, "")
+    assert err == (
+        f"not a valid store file: {store_path}: "
+        "account 'carol': reset_token: expires_at is not a finite number\n"
+    )
+
+
+def test_fr059_a_misspelled_reset_token_key_is_still_an_unknown_key(store_path, run_cli):
+    """FR-059 / rule 4: widening the known keys by one did not loosen the unknown check."""
+    write_pre_feature_store(store_path)
+    payload = json.loads(store_path.read_text(encoding="utf-8"))
+    payload["accounts"]["carol"]["reset_tokens"] = {}
+    store_path.write_text(json.dumps(payload, indent=2, sort_keys=True), encoding="utf-8")
+
+    status, out, err = run_cli(["--store", str(store_path), "login", "carol"], PASSWORD + "\n")
+    assert (status, out) == (2, "")
+    assert err == (
+        f"not a valid store file: {store_path}: account 'carol': unknown key: reset_tokens\n"
+    )
+
+
+def test_fr059_a_required_record_key_is_still_required(store_path, run_cli):
+    """FR-059: reset_token became optional; the original four did not."""
+    write_pre_feature_store(store_path)
+    payload = json.loads(store_path.read_text(encoding="utf-8"))
+    del payload["accounts"]["carol"]["locked"]
+    payload["accounts"]["carol"]["reset_token"] = {
+        "salt": "RkZGRkZGRkZGRkZGRkZGRg==",
+        "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+        "expires_at": 1763336400.0,
+    }
+    store_path.write_text(json.dumps(payload, indent=2, sort_keys=True), encoding="utf-8")
+
+    status, _, err = run_cli(["--store", str(store_path), "login", "carol"], PASSWORD + "\n")
+    assert status == 2
+    assert err.endswith("account 'carol': missing key: locked\n")
+
+
+def test_fr059_a_well_formed_reset_token_in_a_hand_written_store_is_accepted(
+    store_path, run_cli
+):
+    """FR-059: strictness is about rejecting the undefined, not about rejecting the key."""
+    with_reset_token(
+        store_path,
+        {
+            "salt": "RkZGRkZGRkZGRkZGRkZGRg==",
+            "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+            "expires_at": 1763336400.0,
+        },
+    )
+    # It loads, and behaves as a token that simply does not match what is presented.
+    assert run_cli(
+        ["--store", str(store_path), "reset", "carol"], f"{'t' * 43}\n{NEW_PASSWORD}\n"
+    ) == (1, "", "invalid token\n")
+    assert run_cli(["--store", str(store_path), "login", "carol"], PASSWORD + "\n")[0] == 0
+
+
+def test_fr059_an_integer_expires_at_is_accepted(store_path, run_cli):
+    """FR-059 / rule 10: an int or a float, as long as it is finite."""
+    with_reset_token(
+        store_path,
+        {
+            "salt": "RkZGRkZGRkZGRkZGRkZGRg==",
+            "verifier": "QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=",
+            "expires_at": 1763336400,
+        },
+    )
+    assert run_cli(["--store", str(store_path), "login", "carol"], PASSWORD + "\n")[0] == 0