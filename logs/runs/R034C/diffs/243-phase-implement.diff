+# --------------------------------------------------------------- FR-055 end of input
+
+
+def test_fr055_empty_standard_input_reports_the_missing_token_line(seeded, run_cli):
+    """FR-055 / E14: exit 2 with a diagnostic, not an empty token."""
+    issue(seeded, run_cli)
+    before = seeded.read_bytes()
+
+    status, out, err = run_cli(["--store", str(seeded), "reset", "alice"], "")
