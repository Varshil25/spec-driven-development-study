+
+
+def test_fr053_the_minimum_is_twelve_characters(seeded, run_cli):
+    """FR-053 / FR-011: 12 is accepted, 11 is not — the boundary, counted in code points."""
+    eleven = "elevenchars"
+    twelve = "twelvechars!"
+    assert len(eleven) == 11 and len(twelve) == 12
+
+    token = issue(seeded, run_cli)
