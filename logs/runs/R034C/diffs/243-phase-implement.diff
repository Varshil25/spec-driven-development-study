+"""Nothing that worked before has changed: FR-043, FR-060, FR-061, FR-062, SC-011.
+
+This file asserts what did *not* change. The nine behaviour test files for FR-001 - FR-038
+are the primary evidence and are untouched (SC-011); what remains to assert is the surface
+this feature adds *around* them — that ``--ttl`` is confined to one command, that the option
+is invisible to ``--help``, that ``--store`` still parses in every position it did, and that
+the two new commands stay inside the exit-status set and the stream discipline FR-004 and
+FR-005 already fixed.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from accounts import cli, passwords, store
+
+PASSWORD = "correct horse battery"
+NEW_PASSWORD = "a brand new secret"
+
+EXISTING_COMMANDS = ("register", "login", "unlock", "passwd", "delete")
+NEW_COMMANDS = ("reset-token", "reset")
+ALL_COMMANDS = EXISTING_COMMANDS + NEW_COMMANDS
+
+
+def seed(path: Path, username: str = "alice", password: str = PASSWORD, **kwargs) -> None:
+    salt = passwords.new_salt()
+    store.save(
+        path,
+        {
+            username: {
+                "salt": store.encode(salt),
+                "verifier": store.encode(passwords.derive(password, salt)),
+                "failed_logins": kwargs.get("failed_logins", 0),
+                "locked": kwargs.get("locked", False),
+            }
+        },
+    )
+
+
+def issue(path: Path, run_cli, username: str = "alice") -> str:
+    status, out, err = run_cli(["--store", str(path), "reset-token", username])
+    assert (status, err) == (0, "")
+    return out[:-1]
+
+
+# --------------------------------------------------------- FR-043 --ttl is out of scope
+
+
+@pytest.mark.parametrize("command", [*EXISTING_COMMANDS, "reset"], ids=lambda c: c)
+def test_fr043_ttl_is_a_usage_error_with_every_command_but_reset_token(
+    command, store_path, run_cli
+):
+    """FR-043 / E16: usage diagnostic on stderr, exit 2, store untouched."""
+    seed(store_path)
+    before = store_path.read_bytes()
+
+    status, out, err = run_cli(
+        ["--store", str(store_path), "--ttl", "60", command, "alice"], PASSWORD + "\n"
+    )
+
+    assert status == 2, command
+    assert out == "", command
+    assert "usage:" in err, command
+    assert "--ttl" in err, command
+    assert store_path.read_bytes() == before, command
+
+
+@pytest.mark.parametrize("command", [*EXISTING_COMMANDS, "reset"], ids=lambda c: c)
+def test_fr043_ttl_after_the_command_name_is_also_rejected(command, store_path, run_cli):
+    """FR-043: the scope rule does not depend on where on the line the option appears."""
+    seed(store_path)
+    status, out, err = run_cli(
+        ["--store", str(store_path), command, "alice", "--ttl", "60"], PASSWORD + "\n"
+    )
+    assert (status, out) == (2, ""), command
+    assert "usage:" in err, command
