+    token = issue(store_path, run_cli)
+    assert run_cli(
+        ["--store", str(store_path), "reset", "alice"], f"{token}\n{NEW_PASSWORD}\n"
+    )[0] == 0
+    # ...while login on the same account still does return 4, unchanged (FR-020).
+    assert run_cli(["--store", str(store_path), "login", "alice"], NEW_PASSWORD + "\n")[0] == 4
+
+
+# -------------------------------------------------------- FR-062 the stream discipline
+
+
+def test_fr062_success_leaves_stderr_empty_and_failure_leaves_stdout_empty(
+    store_path, run_cli
+):
+    """FR-062 / SC-017: results on stdout, diagnostics on stderr, one line each, never mixed."""
+    seed(store_path)
+    successes = failures = 0
+
+    def observe(tail: list[str], stdin_text: str = "") -> int:
+        nonlocal successes, failures
+        status, out, err = run_cli(["--store", str(store_path), *tail], stdin_text)
+        if status == 0:
+            assert err == "", (tail, err)
+            assert out.endswith("\n") and out.count("\n") == 1, (tail, out)
+            successes += 1
+        else:
+            assert out == "", (tail, out)
+            assert err != "", tail
+            # Usage errors carry argparse's multi-line usage block; every diagnostic this
+            # feature writes itself is a single "\n"-terminated line.
+            if "usage:" not in err:
+                assert err.endswith("\n") and err.count("\n") == 1, (tail, err)
+            failures += 1
+        return status
+
+    # Every failure path, against an outstanding token. A fresh token is issued before
+    # each path that needs a live one, because issuing supersedes the previous (FR-044).
+    token = issue(store_path, run_cli)
+    observe(["reset-token", "nobody"])
+    observe(["reset-token", "alice", "--ttl", "abc"])
+    observe(["reset", "nobody"], f"{token}\n{NEW_PASSWORD}\n")
+    observe(["reset", "alice"], "")
+    observe(["reset", "alice"], f"{'w' * 43}\n")
+    observe(["reset", "alice"], f"{'w' * 43}\n{NEW_PASSWORD}\n")
+    observe(["reset", "alice"], f"{token}\nshort\n")
+
+    # Both success paths: issuing, with and without an explicit window, and a reset with
+    # a token that issuing just produced.
+    assert observe(["reset-token", "alice"]) == 0
+    assert observe(["reset-token", "alice", "--ttl", "60"]) == 0
+    assert "reset_token" in store.load(store_path)["alice"]
+    token = issue(store_path, run_cli)
+    assert observe(["reset", "alice"], f"{token}\n{NEW_PASSWORD}\n") == 0
+
+    assert successes >= 3
+    assert failures >= 5
+
+
+def test_sc017_no_failure_path_of_a_new_command_exits_non_zero_in_silence(
+    store_path, run_cli
+):
+    """SC-017: every failure names the specific rule or condition that failed."""
+    seed(store_path)
+    token = issue(store_path, run_cli)
+
+    expected = {
+        "E1 short password": ((["reset", "alice"], f"{token}\nshort\n"), 2, "at least 12"),
+        "E4 reset-token": ((["reset-token", "nobody"], ""), 3, "no such account: nobody"),
+        "E4 reset": ((["reset", "nobody"], "a\nb\n"), 3, "no such account: nobody"),
+        "E9 no new password": ((["reset", "alice"], f"{token}\n"), 2, "no new password"),
+        "E14 no token": ((["reset", "alice"], ""), 2, "no token on standard input"),
+        "E15 invalid token": ((["reset", "alice"], f"{'w' * 43}\nlong enough here\n"), 1, "invalid token"),
+        "E16 ttl out of scope": ((["--ttl", "60", "login", "alice"], ""), 2, "--ttl is only valid"),
+        "E17 ttl not a number": ((["reset-token", "alice", "--ttl", "x"], ""), 2, "--ttl"),
+    }
+    for label, ((tail, stdin_text), code, fragment) in expected.items():
+        status, out, err = run_cli(["--store", str(store_path), *tail], stdin_text)
+        assert status == code, label
+        assert out == "", label
+        assert err != "", label
+        assert fragment in err, (label, err)
+
+
+def test_sc017_store_diagnostics_reach_the_new_commands_too(store_path, run_cli):
+    """SC-017 / E10-E12: the store failure paths are shared, not bypassed."""
+    store_path.write_text("this is not a store\n", encoding="utf-8")
+    for tail in (["reset-token", "alice"], ["reset", "alice"]):
+        status, out, err = run_cli(["--store", str(store_path), *tail], "a\nb\n")
+        assert (status, out) == (2, ""), tail
+        assert err.startswith(f"not a valid store file: {store_path}: "), tail
+
+    unwritable = store_path.parent / "nonexistent-dir" / "store.json"
+    status, out, err = run_cli(["--store", str(unwritable), "reset-token", "alice"])
+    # No such account in a store that does not exist, so E4 precedes any write (FR-045).
+    assert (status, out, err) == (3, "", "no such account: alice\n")
+
+
+@pytest.mark.parametrize(
+    "tail,stdin_text",
+    [(["reset-token", "alice"], ""), (["reset", "alice"], "TOKEN\n" + NEW_PASSWORD + "\n")],
+    ids=["reset-token", "reset"],
+)
+def test_sc017_a_failed_write_reports_e12_for_both_new_commands(
+    tail, stdin_text, store_path, run_cli, monkeypatch
+):
+    """SC-017 / E12: if the save fails, the command says so — status 2, nothing on stdout.
+
+    Both new commands are the only two outcomes this feature adds that write the store, so
+    both must reach the shared E12 path. The failure is injected at the final
+    ``os.replace``, as ``tests/test_store.py`` does for FR-008: the latest possible moment,
+    reached only after the command itself has succeeded.
+    """
+    seed(store_path)
+    token = issue(store_path, run_cli)
+    stdin_text = stdin_text.replace("TOKEN", token)
+    before = store_path.read_bytes()
+
+    def exploding_replace(src, dst):
+        raise OSError(28, "No space left on device")
+
+    monkeypatch.setattr(store.os, "replace", exploding_replace)
+    status, out, err = run_cli(["--store", str(store_path), *tail], stdin_text)
+
+    assert status == 2
+    assert out == ""
+    assert err.startswith(f"cannot write store file: {store_path}: ")
+    assert err.endswith("\n") and err.count("\n") == 1
+    # The previous store survives intact: nothing was half-applied (FR-008).
+    assert store_path.read_bytes() == before
