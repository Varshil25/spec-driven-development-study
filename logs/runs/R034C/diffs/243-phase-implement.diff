new file mode 100644
index 0000000..ae1c77c
--- /dev/null
+++ b/tests/test_reset.py
@@ -0,0 +1,548 @@
+"""Using a reset token: FR-048 - FR-056.
+
+The success path, the five indistinguishable rejection cases, the end-of-input rules, and
+the check order that decides which of two simultaneous problems is reported. Expiry is
+asserted at the ``commands.reset`` level with an explicit ``now`` so the boundary itself is
+testable rather than approximated by a sleep (plan.md Complexity Tracking, research.md
+R-18); ``tests/test_reset_end_to_end.py`` covers the real clock once.
+"""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+import pytest
+
+from accounts import cli, commands, passwords, store
+
+PASSWORD = "correct horse battery"
+NEW_PASSWORD = "a brand new secret"  # 18 characters
+REJECTED = (1, "", "invalid token\n")
+
+
+def seed(path: Path, username: str = "alice", password: str = PASSWORD, **kwargs) -> None:
+    salt = passwords.new_salt()
+    store.save(
+        path,
+        {
+            username: {
+                "salt": store.encode(salt),
+                "verifier": store.encode(passwords.derive(password, salt)),
+                "failed_logins": kwargs.get("failed_logins", 0),
+                "locked": kwargs.get("locked", False),
+            }
+        },
+    )
+
+
+def issue(path: Path, run_cli, username: str = "alice", *ttl: str) -> str:
+    """Issue a token for ``username`` and return it without its newline."""
+    argv = ["--store", str(path), "reset-token", username, *ttl]
+    status, out, err = run_cli(argv)
+    assert (status, err) == (0, ""), (status, err)
+    return out[:-1]
+
+
+def record_of(path: Path, username: str = "alice") -> dict:
+    return store.load(path)[username]
+
+
+@pytest.fixture
+def seeded(store_path: Path) -> Path:
+    seed(store_path)
+    return store_path
+
+
+# -------------------------------------------------------------- FR-048 the stdin protocol
+
+
+def test_fr048_the_token_is_read_from_the_first_line_and_the_password_from_the_second(
+    seeded, run_cli
+):
+    """FR-048: two lines, in that order, both from standard input."""
+    token = issue(seeded, run_cli)
+    status, out, err = run_cli(
+        ["--store", str(seeded), "reset", "alice"], f"{token}\n{NEW_PASSWORD}\n"
+    )
+    assert (status, out, err) == (0, "password reset\n", "")
+
+
+def test_fr048_the_two_lines_in_the_wrong_order_are_rejected(seeded, run_cli):
+    """FR-048: the order is fixed — a password on the first line is not a token."""
+    token = issue(seeded, run_cli)
+    assert run_cli(
+        ["--store", str(seeded), "reset", "alice"], f"{NEW_PASSWORD}\n{token}\n"
+    ) == REJECTED
+
+
+def test_fr048_neither_value_can_be_supplied_as_a_command_line_argument(seeded, run_cli):
+    """FR-048 / FR-003: there is no argument form that accepts a token or a password."""
+    token = issue(seeded, run_cli)
+    for extra in ([token], ["--token", token], [f"--token={token}"], ["--password", NEW_PASSWORD]):
+        status, out, _ = run_cli(["--store", str(seeded), "reset", "alice", *extra])
+        assert status == 2, extra
+        assert out == "", extra
+
+
+def test_fr048_only_two_lines_are_read_and_the_rest_of_the_input_is_ignored(seeded, run_cli):
+    """FR-048: nothing beyond the two lines the protocol defines is consumed."""
+    token = issue(seeded, run_cli)
+    stdin_text = f"{token}\n{NEW_PASSWORD}\nand a third line\n"
+    assert run_cli(["--store", str(seeded), "reset", "alice"], stdin_text) == (
+        0,
+        "password reset\n",
+        "",
+    )
+
+
+def test_fr048_a_trailing_newline_is_optional_on_the_password_line(seeded, run_cli):
+    """FR-048 / FR-017: exactly one trailing newline is removed if present."""
+    token = issue(seeded, run_cli)
+    assert run_cli(["--store", str(seeded), "reset", "alice"], f"{token}\n{NEW_PASSWORD}") == (
+        0,
+        "password reset\n",
+        "",
+    )
+
+
+# ----------------------------------------------------------------- FR-049 the success path
+
+
+def test_fr049_a_valid_token_and_a_long_enough_password_resets_and_exits_0(
+    seeded, run_cli, read_store
+):
+    """FR-049: `password reset` on stdout, empty stderr, status 0, password replaced."""
+    before = read_store(seeded)["accounts"]["alice"]
+    token = issue(seeded, run_cli)
+
+    status, out, err = run_cli(
+        ["--store", str(seeded), "reset", "alice"], f"{token}\n{NEW_PASSWORD}\n"
+    )
+    assert (status, out, err) == (0, "password reset\n", "")
+
+    after = read_store(seeded)["accounts"]["alice"]
+    assert after["salt"] != before["salt"]
+    assert after["verifier"] != before["verifier"]
+
+
+def test_fr049_the_replacement_uses_a_fresh_salt_even_for_an_unchanged_password(
+    seeded, run_cli, read_store
+):
+    """FR-049 / FR-036: the stored verifier differs even when the password does not."""
+    before = read_store(seeded)["accounts"]["alice"]
+    token = issue(seeded, run_cli)
+
+    assert run_cli(["--store", str(seeded), "reset", "alice"], f"{token}\n{PASSWORD}\n")[0] == 0
+
+    after = read_store(seeded)["accounts"]["alice"]
+    assert after["salt"] != before["salt"]
+    assert after["verifier"] != before["verifier"]
+    # ...and the password is genuinely still that one.
+    assert run_cli(["--store", str(seeded), "login", "alice"], PASSWORD + "\n")[0] == 0
+
+
+def test_fr049_the_reset_is_durable_at_the_moment_it_exits_0(seeded, run_cli, read_store):
+    """FR-049: a later, separate invocation sees the new password."""
+    token = issue(seeded, run_cli)
+    assert run_cli(["--store", str(seeded), "reset", "alice"], f"{token}\n{NEW_PASSWORD}\n")[0] == 0
+
+    # Durability is observable two ways: the file on disk already carries the change, and
+    # the next invocation acts on it.
+    assert record_of(seeded)["verifier"] == read_store(seeded)["accounts"]["alice"]["verifier"]
+    assert run_cli(["--store", str(seeded), "login", "alice"], NEW_PASSWORD + "\n")[0] == 0
+
+
+def test_fr049_the_token_record_is_removed_by_a_successful_reset(seeded, run_cli, read_store):
+    """FR-049 / FR-051: the key is gone, which is what makes the token single-use."""
+    token = issue(seeded, run_cli)
+    assert "reset_token" in read_store(seeded)["accounts"]["alice"]
+
+    assert run_cli(["--store", str(seeded), "reset", "alice"], f"{token}\n{NEW_PASSWORD}\n")[0] == 0
+
+    record = read_store(seeded)["accounts"]["alice"]
+    assert "reset_token" not in record
+    assert set(record) == {"salt", "verifier", "failed_logins", "locked"}
+
+
+# ----------------------------------------------------------- FR-050 the old password dies
+
+
+def test_fr050_the_new_password_logs_in_and_the_old_one_does_not(seeded, run_cli):
+    """FR-050: after a reset, the new password succeeds and the previous one is rejected."""
+    token = issue(seeded, run_cli)
+    assert run_cli(["--store", str(seeded), "reset", "alice"], f"{token}\n{NEW_PASSWORD}\n")[0] == 0
+
+    assert run_cli(["--store", str(seeded), "login", "alice"], NEW_PASSWORD + "\n") == (
+        0,
+        "ok\n",
+        "",
+    )
+    assert run_cli(["--store", str(seeded), "login", "alice"], PASSWORD + "\n") == (
+        1,
+        "",
+        "invalid credentials\n",
+    )
+
+
+# --------------------------------------------------- FR-051 / FR-052 the five rejections
+
+
+def test_fr051_a_used_token_cannot_be_used_again(seeded, run_cli):
+    """FR-051: the password set by the successful reset stays in force."""
+    token = issue(seeded, run_cli)
+    assert run_cli(["--store", str(seeded), "reset", "alice"], f"{token}\n{NEW_PASSWORD}\n")[0] == 0
+
+    assert run_cli(
+        ["--store", str(seeded), "reset", "alice"], f"{token}\nyet another secret\n"
+    ) == REJECTED
+    assert run_cli(["--store", str(seeded), "login", "alice"], NEW_PASSWORD + "\n")[0] == 0
+
+
+def test_fr052_all_five_rejection_cases_are_byte_identical(tmp_path, run_cli):
+    """FR-052 / SC-013: the response never reveals which of the five conditions applied."""
+    responses = {}
+
+    # (a) wrong token
+    wrong = tmp_path / "wrong.json"
+    seed(wrong)
+    issue(wrong, run_cli)
+    responses["wrong"] = run_cli(
+        ["--store", str(wrong), "reset", "alice"], f"{'x' * 43}\n{NEW_PASSWORD}\n"
+    )
+
+    # (b) already used
+    used = tmp_path / "used.json"
+    seed(used)
+    token = issue(used, run_cli)
+    assert run_cli(["--store", str(used), "reset", "alice"], f"{token}\n{NEW_PASSWORD}\n")[0] == 0
+    responses["used"] = run_cli(
+        ["--store", str(used), "reset", "alice"], f"{token}\n{NEW_PASSWORD}\n"
+    )
+
+    # (c) superseded
+    superseded = tmp_path / "superseded.json"
+    seed(superseded)
+    first = issue(superseded, run_cli)
+    issue(superseded, run_cli)
+    responses["superseded"] = run_cli(
+        ["--store", str(superseded), "reset", "alice"], f"{first}\n{NEW_PASSWORD}\n"
+    )
+
+    # (d) expired — issued with a one-second window, presented against a later clock
+    expired = tmp_path / "expired.json"
+    seed(expired)
+    accounts = store.load(expired)
+    issued = commands.reset_token(accounts, "alice", 1, 1_000.0)
+    store.save(expired, accounts)
+    result = commands.reset(store.load(expired), "alice", issued.out[:-1], NEW_PASSWORD, 5_000.0)
+    responses["expired"] = (result.code, result.out, result.err)
+
+    # (e) none ever issued
+    never = tmp_path / "never.json"
+    seed(never)
+    responses["never issued"] = run_cli(
+        ["--store", str(never), "reset", "alice"], f"{'y' * 43}\n{NEW_PASSWORD}\n"
+    )
+
+    assert len(responses) == 5
+    for case, response in responses.items():
+        assert response == REJECTED, case
+    assert len(set(responses.values())) == 1
+
+
+def test_fr052_a_rejected_token_changes_nothing_about_the_account(seeded, run_cli, read_store):
+    """FR-052: stored password, failed-login count, and lock state all unchanged."""
+    seed(seeded, failed_logins=2)
+    issue(seeded, run_cli)
+    before = read_store(seeded)["accounts"]["alice"]
+    raw_before = seeded.read_bytes()
+
+    assert run_cli(
+        ["--store", str(seeded), "reset", "alice"], f"{'z' * 43}\n{NEW_PASSWORD}\n"
+    ) == REJECTED
+
+    assert read_store(seeded)["accounts"]["alice"] == before
+    # No write at all on the rejection path (research.md R-16).
+    assert seeded.read_bytes() == raw_before
+    assert run_cli(["--store", str(seeded), "login", "alice"], PASSWORD + "\n")[0] == 0
+
+
+def test_fr052_an_empty_but_present_token_line_is_a_value_that_matches_nothing(
+    seeded, run_cli
+):
+    """FR-052 / spec edge case: an empty line is a token like any other, so status 1."""
+    issue(seeded, run_cli)
+    assert run_cli(["--store", str(seeded), "reset", "alice"], f"\n{NEW_PASSWORD}\n") == REJECTED
+
+
+def test_fr052_an_expired_token_record_is_not_swept(store_path):
+    """FR-052 / research.md R-16: no write on the expired path, so no mtime signal."""
+    seed(store_path)
+    accounts = store.load(store_path)
+    issued = commands.reset_token(accounts, "alice", 1, 1_000.0)
+    store.save(store_path, accounts)
+    raw_before = store_path.read_bytes()
+
+    loaded = store.load(store_path)
+    result = commands.reset(loaded, "alice", issued.out[:-1], NEW_PASSWORD, 5_000.0)
+
+    assert (result.code, result.out, result.err) == (1, "", "invalid token\n")
+    assert result.save is False
