+    assert record["locked"] is False
+    # Six wrong tokens is past the five-attempt lock threshold, and the account is open.
+    assert commands.LOCK_THRESHOLD == 5
+    assert run_cli(["--store", str(seeded), "login", "alice"], PASSWORD + "\n")[0] == 0
+
+
+def test_fr056_a_short_password_on_a_reset_is_not_a_failed_login(seeded, run_cli, read_store):
+    """FR-056: nor is a rejected new password."""
+    token = issue(seeded, run_cli)
+    for _ in range(6):
+        assert run_cli(["--store", str(seeded), "reset", "alice"], f"{token}\nshort\n")[0] == 2
+
