+
+# ----------------------------------------------------------- FR-053 a too-short password
+
+
+def test_fr053_a_short_new_password_is_reported_and_leaves_the_token_usable(
+    seeded, run_cli, read_store
+):
+    """FR-053 / SC-015: exit 2, nothing changed, and the very next attempt succeeds."""
+    token = issue(seeded, run_cli)
+    before = read_store(seeded)["accounts"]["alice"]
+
