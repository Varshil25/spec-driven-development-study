+# ------------------------------------------------------------- FR-041 the expiry boundary
+
+
+def test_fr041_a_token_is_valid_an_instant_before_its_window_elapses(store_path):
+    """FR-041: valid from the moment it is issued until SECONDS seconds have elapsed."""
+    seed(store_path)
+    accounts = store.load(store_path)
+    issued = commands.reset_token(accounts, "alice", 60, 1_000.0)
+    token=[REDACTED:assigned_secret][:-1]
+    expires_at = accounts["alice"]["reset_token"]["expires_at"]
+    assert expires_at == 1_060.0
+
+    result = commands.reset(accounts, "alice", token, NEW_PASSWORD, expires_at - 0.001)
+    assert (result.code, result.out, result.err) == (0, "password reset\n", "")
