+"""Real processes, real files: SC-010, SC-012, SC-013, SC-015.
+
+Some criteria are claims about the *process* — its real exit status, that nothing extra
+reaches the real streams, that ``TOKEN=$(... reset-token alice)`` captures a usable token,
+and that ``cli`` passes the actual clock rather than a stub — which an in-process call
+cannot honestly verify (001 research.md R-08, 002 R-18). These tests therefore run
+``python -m accounts`` through ``subprocess.run`` with ``PYTHONPATH=src``.
+
+> **Note on SC-010.** SC-010 requires "all four worked examples in the feature description"
+> to reproduce exactly, but the feature description recorded in ``spec.md``'s Input section
+> contains no worked examples — the same gap 001's contract records for SC-002. The four
+> asserted below are the ones ``contracts/cli-contract.md`` derives from the only fully
+> specified stdout/stderr/status triples in the spec: User Story 1 scenarios 1 and 2, User
+> Story 2 scenario 2, and User Story 3 scenarios 1 and 2. If the original description's
+> examples differ, this file is the single place to correct.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SRC = REPO_ROOT / "src"
+
+PASSWORD = "correct horse battery"
+NEW_PASSWORD = "a brand new secret"
+TOKEN_PATTERN = re.compile(r"\A[A-Za-z0-9_-]{43}\Z")
+
+
+def run(
+    store: Path, command: str, username: str, stdin_text: str = "", *extra: str
+) -> subprocess.CompletedProcess:
+    """Invoke the tool as a separate process, exactly as the contract documents it."""
+    argv = [
+        sys.executable, "-m", "accounts", "--store", str(store), command, username, *extra
+    ]
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(SRC)
+    completed = subprocess.run(
+        argv,
+        input=stdin_text,
+        capture_output=True,
+        text=True,
+        env=env,
+        cwd=REPO_ROOT,
+        timeout=60,
+    )
+    # FR-048 / SC-014: neither the token nor the password supplied on standard input is
+    # ever an element of the real command line. Checked on every invocation these tests
+    # make, not just once.
+    for line in stdin_text.splitlines():
+        if line:
+            assert all(line not in element for element in argv)
+    return completed
+
+
+@pytest.fixture
+def store(tmp_path: Path) -> Path:
+    return tmp_path / "store.json"
+
+
+@pytest.fixture
+def registered(store: Path) -> Path:
+    done = run(store, "register", "alice", PASSWORD + "\n")
+    assert (done.returncode, done.stdout, done.stderr) == (0, "registered alice\n", "")
+    return store
+
+
+def issue(store: Path, username: str = "alice", *extra: str) -> str:
+    """The administrator's half of the journey: capture the token from stdout."""
+    done = run(store, "reset-token", username, "", *extra)
+    assert (done.returncode, done.stderr) == (0, ""), (done.returncode, done.stderr)
+    # TOKEN=$(...) strips the trailing newline; this is that capture.
+    return done.stdout.rstrip("\n")
+
+
+# ------------------------------------------------- SC-010 worked example 1: issue a token
+
+
+def test_sc010_worked_example_1_reset_token_prints_one_token_line(registered):
+    """SC-010 / FR-039: one line on stdout, nothing on stderr, status 0."""
+    done = run(registered, "reset-token", "alice")
+
+    assert done.returncode == 0
+    assert done.stderr == ""
+    assert done.stdout.count("\n") == 1
+    assert TOKEN_PATTERN.fullmatch(done.stdout[:-1]), done.stdout
+
+
+def test_sc010_a_captured_token_is_usable(registered):
+    """SC-010 / FR-039: `TOKEN=$(... reset-token alice)` yields a working token.
+
+    The shell capture strips the trailing newline and nothing else, so the line must carry
+    the token alone — no label, no prefix, no trailing space.
+    """
+    token = issue(registered)
+    assert TOKEN_PATTERN.fullmatch(token)
+
+    done = run(registered, "reset", "alice", f"{token}\n{NEW_PASSWORD}\n")
+    assert (done.returncode, done.stdout, done.stderr) == (0, "password reset\n", "")
+
+
+# -------------------------------------------------- SC-010 worked example 2: redeem it
+
+
+def test_sc010_worked_example_2_reset_prints_password_reset(registered):
+    """SC-010 / FR-049: token first, then the new password; `password reset`, status 0."""
+    token = issue(registered)
+    done = run(registered, "reset", "alice", f"{token}\n{NEW_PASSWORD}\n")
+
+    assert done.returncode == 0
+    assert done.stdout == "password reset\n"
+    assert done.stderr == ""
+
+
+# ---------------------------------------- SC-010 worked example 3: the same token again
+
+
+def test_sc010_worked_example_3_the_same_token_a_second_time_is_rejected(registered):
+    """SC-010 / FR-051: `invalid token` on stderr, stdout empty, status 1, password kept."""
+    token = issue(registered)
+    assert run(registered, "reset", "alice", f"{token}\n{NEW_PASSWORD}\n").returncode == 0
+
+    done = run(registered, "reset", "alice", f"{token}\nanother new secret\n")
+    assert done.returncode == 1
+    assert done.stdout == ""
+    assert done.stderr == "invalid token\n"
+
+    # The password the successful reset set is still the one in force (FR-051).
+    assert run(registered, "login", "alice", NEW_PASSWORD + "\n").stdout == "ok\n"
+    assert run(registered, "login", "alice", "another new secret\n").returncode == 1
+
+
+# ------------------------------- SC-010 worked example 4 / SC-015: the token survives
+
+
+def test_sc010_worked_example_4_a_short_password_leaves_the_token_usable(registered):
+    """SC-010 / SC-015 / FR-053: status 2, then the same token accepted on the retry."""
+    token = issue(registered, "alice", "--ttl", "60")
+
+    rejected = run(registered, "reset", "alice", f"{token}\nshort\n")
+    assert rejected.returncode == 2
+    assert rejected.stdout == ""
+    assert rejected.stderr == "password must be at least 12 characters\n"
+
+    accepted = run(registered, "reset", "alice", f"{token}\nlong enough secret\n")
+    assert accepted.returncode == 0
+    assert accepted.stdout == "password reset\n"
+    assert accepted.stderr == ""
+
+    assert run(registered, "login", "alice", "long enough secret\n").stdout == "ok\n"
+
+
+# -------------------------------------------------------- SC-012 the recovery journey
+
+
+def test_sc012_access_is_regained_in_exactly_two_commands(registered):
+    """SC-012: one command run by the administrator, one by the user, no hand editing.
+
+    The administrator never sees the new password: it reaches the tool only on the second
+    command's standard input, which the administrator does not run.
+    """
+    administrator = run(registered, "reset-token", "alice")
+    assert administrator.returncode == 0
+    token=[REDACTED:assigned_secret]("\n")
+
+    user = run(registered, "reset", "alice", f"{token}\nmy brand new secret\n")
+    assert (user.returncode, user.stdout, user.stderr) == (0, "password reset\n", "")
+
+    # Two commands, and access is back.
+    assert run(registered, "login", "alice", "my brand new secret\n").stdout == "ok\n"
+    old = run(registered, "login", "alice", PASSWORD + "\n")
+    assert (old.returncode, old.stderr) == (1, "invalid credentials\n")
+
+    # The administrator's output never carried the new password, and the user's never
+    # carried the token (FR-058).
+    assert "my brand new secret" not in administrator.stdout + administrator.stderr
+    assert token not in user.stdout + user.stderr
+
+
+# ------------------------------------------ SC-013 the five rejections, indistinguishable
+
+
+def test_sc013_all_five_rejection_cases_are_indistinguishable_through_the_real_cli(
+    tmp_path, registered
+):
+    """SC-013: each is `invalid token` on stderr with status 1 and an empty stdout.
+
+    The expired case uses a real ``--ttl 1`` token and a real sleep, so the wiring from
+    ``cli`` to the actual system clock is asserted here rather than only against an
+    injected one (research.md R-18). The exhaustive boundary cases stay instant in
+    ``tests/test_reset.py``.
+    """
+    responses: dict[str, tuple[int, str, str]] = {}
+
+    def attempt(store: Path, token: str, label: str) -> None:
+        done = run(store, "reset", "alice", f"{token}\n{NEW_PASSWORD}\n")
+        responses[label] = (done.returncode, done.stdout, done.stderr)
+
+    # (a) no token ever issued
+    attempt(registered, "x" * 43, "never issued")
+
+    # (b) wrong token, with a real one outstanding
+    issue(registered)
+    attempt(registered, "y" * 43, "wrong")
+
+    # (c) superseded: the first of two
+    first = issue(registered)
+    issue(registered)
+    attempt(registered, first, "superseded")
+
+    # (d) already used
+    used = issue(registered)
+    assert run(registered, "reset", "alice", f"{used}\n{NEW_PASSWORD}\n").returncode == 0
+    attempt(registered, used, "already used")
+
+    # (e) expired, through the real clock
+    short_lived = issue(registered, "alice", "--ttl", "1")
+    time.sleep(1.1)
+    attempt(registered, short_lived, "expired")
+
+    assert len(responses) == 5
+    for label, response in responses.items():
+        assert response == (1, "", "invalid token\n"), label
+    assert len(set(responses.values())) == 1
+
+    # The password set by (d)'s successful reset is still in force after all five.
+    assert run(registered, "login", "alice", NEW_PASSWORD + "\n").stdout == "ok\n"
+
+
+def test_sc013_an_expired_token_is_rejected_and_leaves_the_record_in_place(registered):
+    """SC-013 / research.md R-16: expiry writes nothing — the record is not swept."""
+    token = issue(registered, "alice", "--ttl", "1")
+    before = registered.read_bytes()
+    time.sleep(1.1)
+
+    done = run(registered, "reset", "alice", f"{token}\n{NEW_PASSWORD}\n")
+    assert (done.returncode, done.stdout, done.stderr) == (1, "", "invalid token\n")
+    assert registered.read_bytes() == before
+    assert "reset_token" in json.loads(registered.read_text(encoding="utf-8"))["accounts"]["alice"]
+
+
+# ------------------------------------------------------ FR-045 / FR-054 unknown accounts
+
+
+def test_fr045_and_fr054_an_unknown_account_exits_3_in_a_real_process(store):
+    """FR-045 / FR-054: both new commands name the account and exit 3."""
+    issuing = run(store, "reset-token", "nobody")
+    assert (issuing.returncode, issuing.stdout, issuing.stderr) == (
+        3,
+        "",
+        "no such account: nobody\n",
+    )
+
+    using = run(store, "reset", "nobody", f"{'t' * 43}\n{NEW_PASSWORD}\n")
+    assert (using.returncode, using.stdout, using.stderr) == (
+        3,
+        "",
+        "no such account: nobody\n",
+    )
+    assert not store.exists()
diff --git a/tests/test_reset_performance.py b/tests/test_reset_performance.py
new file mode 100644
index 0000000..54c6e03
--- /dev/null
+++ b/tests/test_reset_performance.py
@@ -0,0 +1,116 @@
+"""SC-016: each new command completes in under 1 second on a store of 1,000 accounts.
+
+Follows the shape of ``tests/test_performance.py`` (SC-007), including its reason for
+building the store directly rather than by running 1,000 registrations: the criterion is
+about the cost of *one* command against a large store, and 1,000 real registrations would be
+1,000 PBKDF2 derivations of setup for no extra signal.
+
+Budget (research.md R-10, plan.md Performance Goals): one PBKDF2 derivation at 600,000
+iterations measures ~0.145 s on the development machine, so ``reset-token`` spends about
+0.15 s (the token's verifier) and ``reset`` about 0.30 s (verify the token, then derive the
+new password's verifier), plus a JSON load and an atomic rewrite of a ~200 KB file — roughly
+3x margin against the 1-second budget.
+"""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import pytest
+
+from accounts import passwords, store
+
+ACCOUNT_COUNT = 1000
+BUDGET_SECONDS = 1.0
+
+PASSWORD = "correct horse battery"
+NEW_PASSWORD = "a brand new secret"
+TARGET = "user_500"
+
+
+@pytest.fixture(scope="module")
+def large_store_accounts() -> dict[str, dict]:
+    """1,000 accounts, all sharing one salt and verifier so setup costs one derivation."""
+    salt = passwords.new_salt()
+    salt_text = store.encode(salt)
+    verifier_text = store.encode(passwords.derive(PASSWORD, salt))
+    return {
+        f"user_{index}": {
+            "salt": salt_text,
+            "verifier": verifier_text,
+            "failed_logins": 0,
+            "locked": False,
+        }
+        for index in range(ACCOUNT_COUNT)
+    }
+
+
+@pytest.fixture
+def large_store(tmp_path: Path, large_store_accounts) -> Path:
+    path = tmp_path / "big.json"
+    store.save(path, dict(large_store_accounts))
+    assert len(store.load(path)) == ACCOUNT_COUNT
+    return path
+
+
+def test_sc016_reset_token_completes_in_under_a_second_on_1000_accounts(
+    run_cli, large_store
+):
+    """SC-016: issuing a token is as immediate as the existing commands."""
+    started = time.perf_counter()
+    status, out, err = run_cli(["--store", str(large_store), "reset-token", TARGET])
+    elapsed = time.perf_counter() - started
+
+    assert (status, err) == (0, ""), err
+    assert len(out) == 44
+    assert elapsed < BUDGET_SECONDS, f"reset-token took {elapsed:.3f}s on {ACCOUNT_COUNT} accounts"
+
+
+def test_sc016_reset_completes_in_under_a_second_on_1000_accounts(run_cli, large_store):
+    """SC-016: redeeming a token costs two derivations and still fits the budget."""
+    _, out, _ = run_cli(["--store", str(large_store), "reset-token", TARGET])
+    token = out[:-1]
+
+    started = time.perf_counter()
+    status, out, err = run_cli(
+        ["--store", str(large_store), "reset", TARGET], f"{token}\n{NEW_PASSWORD}\n"
+    )
+    elapsed = time.perf_counter() - started
+
+    assert (status, out, err) == (0, "password reset\n", "")
+    assert elapsed < BUDGET_SECONDS, f"reset took {elapsed:.3f}s on {ACCOUNT_COUNT} accounts"
+
+
+def test_sc016_a_rejected_token_is_not_slower_than_an_accepted_one(run_cli, large_store):
+    """SC-016: the rejection path stays inside the budget too, writing nothing."""
+    run_cli(["--store", str(large_store), "reset-token", TARGET])
+
+    started = time.perf_counter()
+    status, out, err = run_cli(
+        ["--store", str(large_store), "reset", TARGET], f"{'w' * 43}\n{NEW_PASSWORD}\n"
+    )
+    elapsed = time.perf_counter() - started
+
+    assert (status, out, err) == (1, "", "invalid token\n")
+    assert elapsed < BUDGET_SECONDS, f"a rejected reset took {elapsed:.3f}s"
+
+
+def test_sc016_the_store_survives_the_rewrite_at_scale(run_cli, large_store):
+    """SC-016 / FR-008: the atomic rewrite of a 1,000-account store stays correct."""
+    _, out, _ = run_cli(["--store", str(large_store), "reset-token", TARGET])
+    token = out[:-1]
+    assert run_cli(
+        ["--store", str(large_store), "reset", TARGET], f"{token}\n{NEW_PASSWORD}\n"
+    ) == (0, "password reset\n", "")
+
+    accounts = store.load(large_store)
+    assert len(accounts) == ACCOUNT_COUNT
+    assert "reset_token" not in accounts[TARGET]
+    assert run_cli(["--store", str(large_store), "login", TARGET], NEW_PASSWORD + "\n") == (
+        0,
+        "ok\n",
+        "",
+    )
+    # Every other account is untouched, token included.
+    assert all("reset_token" not in record for record in accounts.values())
diff --git a/tests/test_reset_secrets.py b/tests/test_reset_secrets.py
new file mode 100644
index 0000000..86afe45
--- /dev/null
+++ b/tests/test_reset_secrets.py
@@ -0,0 +1,176 @@
+"""The token is never at rest and never in a message: FR-057, FR-058, SC-014.
+
+Two properties, asserted against bytes rather than against intent: an issued token cannot be
+found anywhere in the store file, and it appears on no stream of any command other than the
+single standard-output line ``reset-token`` exists to produce.
+"""
+
+from __future__ import annotations
+
+import base64
+import re
+from pathlib import Path
+
+from accounts import passwords, store
+
+PASSWORD = "correct horse battery"
+NEW_PASSWORD = "a brand new secret"
+
+
+def seed(path: Path, username: str = "alice", password: str = PASSWORD) -> None:
+    salt = passwords.new_salt()
+    store.save(
+        path,
+        {
+            username: {
+                "salt": store.encode(salt),
+                "verifier": store.encode(passwords.derive(password, salt)),
+                "failed_logins": 0,
+                "locked": False,
+            }
+        },
+    )
+
+
+def issue(path: Path, run_cli, username: str = "alice") -> str:
+    status, out, err = run_cli(["--store", str(path), "reset-token", username])
+    assert (status, err) == (0, "")
+    return out[:-1]
+
+
+# -------------------------------------------------------- FR-057 / SC-014 not in the store
+
+
+def test_fr057_the_token_does_not_appear_in_the_store_files_bytes(store_path, run_cli):
+    """FR-057 / SC-014: the 43 characters of the token are nowhere in the file."""
+    seed(store_path)
+    token = issue(store_path, run_cli)
+    raw = store_path.read_bytes()
+
+    encoded = token.encode("utf-8")
+    assert encoded not in raw
+    # The store's fields are base64, so check that encoding too, not just the plain bytes.
+    assert base64.b64encode(encoded).rstrip(b"=") not in raw
+    # And no substring long enough to be a meaningful head start on guessing it.
+    for length in (43, 32, 20, 12):
+        assert token[:length].encode("utf-8") not in raw, length
+
+
+def test_fr057_the_store_holds_only_a_salt_a_verifier_and_an_expiry(
+    store_path, run_cli, read_store
+):
+    """FR-057: validation rests on a one-way transformation with a per-token salt."""
+    seed(store_path)
+    token = issue(store_path, run_cli)
+    outstanding = read_store(store_path)["accounts"]["alice"]["reset_token"]
+
+    assert set(outstanding) == {"salt", "verifier", "expires_at"}
+    salt = base64.b64decode(outstanding["salt"], validate=True)
+    verifier = base64.b64decode(outstanding["verifier"], validate=True)
+    assert len(salt) == 16 and len(verifier) == 32
+
+    # The stored value is the PBKDF2 verifier of the token under that salt — reproducible
+    # from the token, and not invertible to it.
+    assert passwords.derive(token, salt) == verifier
+    assert passwords.verify(token, salt, verifier)
+    assert not passwords.verify(token + "x", salt, verifier)
+
+
+def test_fr057_the_token_salt_is_per_token_and_not_the_accounts_password_salt(
+    store_path, run_cli, read_store
+):
+    """FR-057: a per-token random salt, fresh at every issuance."""
+    seed(store_path)
+    issue(store_path, run_cli)
+    record = read_store(store_path)["accounts"]["alice"]
+    assert record["reset_token"]["salt"] != record["salt"]
+
+    first = record["reset_token"]["salt"]
+    issue(store_path, run_cli)
+    second = read_store(store_path)["accounts"]["alice"]["reset_token"]["salt"]
+    assert second != first
+
+
+def test_fr057_two_accounts_tokens_share_nothing(tmp_path, run_cli):
+    """FR-057: no store-wide salt, so one precomputation cannot attack every token."""
+    path = tmp_path / "two.json"
+    seed(path)
+    accounts = store.load(path)
+    accounts["bob"] = dict(accounts["alice"])
+    store.save(path, accounts)
+
+    issue(path, run_cli, "alice")
+    issue(path, run_cli, "bob")
+    loaded = store.load(path)
+    assert loaded["alice"]["reset_token"]["salt"] != loaded["bob"]["reset_token"]["salt"]
+    assert loaded["alice"]["reset_token"]["verifier"] != loaded["bob"]["reset_token"]["verifier"]
+
+
+# ------------------------------------------------- FR-058 not in any other stream
+
+
+def test_fr058_the_token_appears_on_no_stream_of_any_other_command(store_path, run_cli):
+    """FR-058: the only place a token is ever emitted is reset-token's one stdout line."""
+    seed(store_path)
+    token = issue(store_path, run_cli)
+
+    # Every path of the reset command: success, invalid token, short password, unknown
+    # account, and the two end-of-input diagnostics.
+    invocations = [
+        (["reset", "alice"], f"{token}\nshort\n"),
+        (["reset", "alice"], f"{token}\n"),
+        (["reset", "alice"], ""),
+        (["reset", "nobody"], f"{token}\n{NEW_PASSWORD}\n"),
+        (["reset", "alice"], f"{'w' * 43}\n{NEW_PASSWORD}\n"),
+        (["login", "alice"], token + "\n"),
+        (["passwd", "alice"], f"{token}\n{NEW_PASSWORD}\n"),
+        (["delete", "alice"], token + "\n"),
+        (["register", "alice"], token + "\n"),
+        (["unlock", "alice"], ""),
+        (["reset", "alice"], f"{token}\n{NEW_PASSWORD}\n"),  # the success path, last
+    ]
+    for tail, stdin_text in invocations:
+        _, out, err = run_cli(["--store", str(store_path), *tail], stdin_text)
+        assert token not in out, tail
+        assert token not in err, tail
+
+
+def test_fr058_a_rejected_token_is_not_echoed_back(store_path, run_cli):
+    """FR-058 / FR-037: the diagnostic names the condition, never the value presented."""
+    seed(store_path)
+    issue(store_path, run_cli)
+    presented = "a-token-that-was-never-real-but-is-43-chars"
+    assert len(presented) == 43
+
+    status, out, err = run_cli(
+        ["--store", str(store_path), "reset", "alice"], f"{presented}\n{NEW_PASSWORD}\n"
+    )
+    assert (status, out, err) == (1, "", "invalid token\n")
+    assert presented not in err
+
+
+def test_fr058_the_new_password_appears_on_no_stream(store_path, run_cli):
+    """FR-058 / FR-037: extending the password rule to the reset command's second line."""
+    seed(store_path)
+    token = issue(store_path, run_cli)
+    secret = "a unique reset secret"
+
+    for tail, stdin_text in (
+        (["reset", "alice"], f"{token}\n{secret}\n"),
+        (["reset", "alice"], f"{'w' * 43}\n{secret}\n"),
+        (["reset", "nobody"], f"{token}\n{secret}\n"),
+    ):
+        _, out, err = run_cli(["--store", str(store_path), *tail], stdin_text)
+        assert secret not in out, tail
+        assert secret not in err, tail
+
+    assert secret.encode("utf-8") not in store_path.read_bytes()
+
+
+def test_fr058_reset_tokens_only_output_is_the_token_line(store_path, run_cli):
+    """FR-058 / FR-062: one line on stdout, and nothing is added to it."""
+    seed(store_path)
+    status, out, err = run_cli(["--store", str(store_path), "reset-token", "alice"])
+
+    assert (status, err) == (0, "")
+    assert re.fullmatch(r"[A-Za-z0-9_-]{43}\n", out), out
diff --git a/tests/test_reset_token.py b/tests/test_reset_token.py
new file mode 100644
index 0000000..33f39e6
--- /dev/null
+++ b/tests/test_reset_token.py
@@ -0,0 +1,375 @@
+"""Issuing a reset token: FR-039, FR-040, FR-041, FR-042, FR-044, FR-045, FR-046, FR-047.
+
+Drives the in-process seam through the ``run_cli``, ``store_path`` and ``read_store``
+fixtures from ``conftest.py``, used unchanged (research.md R-18). Where a requirement is
+about an instant — the validity window — the test calls ``commands.reset_token`` directly
+with an explicit ``now``, which is the whole reason the clock is a parameter (plan.md
+Complexity Tracking).
+"""
+
+from __future__ import annotations
+
+import base64
+import copy
+import re
+import time
+from pathlib import Path
+
+import pytest
+
+from accounts import commands, passwords, store
+
+PASSWORD = "correct horse battery"
+TOKEN_PATTERN = re.compile(r"\A[A-Za-z0-9_-]{43}\Z")
+DEFAULT_TTL = 900
+
+
+def seed(path: Path, username: str = "alice", password: str = PASSWORD, **kwargs) -> None:
+    """Write a store holding one account, built directly to cost one derivation."""
+    salt = passwords.new_salt()
+    store.save(
+        path,
+        {
+            username: {
+                "salt": store.encode(salt),
+                "verifier": store.encode(passwords.derive(password, salt)),
+                "failed_logins": kwargs.get("failed_logins", 0),
+                "locked": kwargs.get("locked", False),
+            }
+        },
+    )
+
+
+def record_of(path: Path, username: str = "alice") -> dict:
+    return store.load(path)[username]
+
+
+# ------------------------------------------------------------------ FR-039 the one line
+
+
+def test_fr039_reset_token_writes_one_token_line_to_stdout_with_status_0(store_path, run_cli):
+    """FR-039: one line on stdout containing the token and nothing else, stderr empty, exit 0."""
+    seed(store_path)
+    status, out, err = run_cli(["--store", str(store_path), "reset-token", "alice"])
+
+    assert status == 0
+    assert err == ""
+    assert out.endswith("\n") and out.count("\n") == 1
+    assert TOKEN_PATTERN.fullmatch(out[:-1]), out
+
+
+def test_fr039_the_token_line_carries_no_label_or_surrounding_whitespace(store_path, run_cli):
+    """FR-039: ``TOKEN=$(... reset-token alice)`` must capture a usable token."""
+    seed(store_path)
+    _, out, _ = run_cli(["--store", str(store_path), "reset-token", "alice"])
+    captured = out[:-1]
+
+    assert captured == captured.strip()
+    assert ":" not in captured and " " not in captured
+    assert len(captured) == 43
+
+
+def test_fr039_reset_token_reads_nothing_from_standard_input(store_path, run_cli):
+    """FR-039: the token is produced, never supplied — zero lines are read."""
+    seed(store_path)
+    status, out, err = run_cli(
+        ["--store", str(store_path), "reset-token", "alice"], "unused input\nmore\n"
+    )
+    assert (status, err) == (0, "")
+    assert TOKEN_PATTERN.fullmatch(out[:-1])
+
+
+# ------------------------------------------------- FR-040 entropy, alphabet, uniqueness
+
+
+def test_fr040_a_token_is_43_characters_of_the_url_safe_alphabet():
+    """FR-040: 32 CSPRNG bytes — 256 bits — rendered with no copy-paste hazard."""
+    assert passwords.TOKEN_BYTES == 32  # 256 bits, where FR-040's floor is 128
+    for _ in range(50):
+        token=[REDACTED:assigned_secret]()
+        assert TOKEN_PATTERN.fullmatch(token), token
+        # No whitespace, no line break, no quoting hazard: the token is passed out of band
+        # by the administrator and must survive being pasted as one line.
+        assert token == token.strip()
+        assert not any(character in token for character in " \t\r\n\"'\\$`;|&<>*?()[]{}#!~")
+
+
+def test_fr040_fifty_tokens_in_a_tight_loop_are_all_distinct():
+    """FR-040: every issued token differs from every previously issued one.
+
+    The generator is exercised directly rather than through 50 CLI invocations: each
+    issuance costs a ~0.15 s PBKDF2 derivation for the verifier, and the property under
+    test belongs to the generator. The "same account, same second" case is asserted
+    against real issuance below, at an instant that is literally identical.
+    """
+    tokens = [passwords.new_token() for _ in range(50)]
+    assert len(set(tokens)) == 50
+
+
+def test_fr040_two_tokens_issued_for_one_account_at_the_same_instant_differ(store_path):
+    """FR-040: distinct "including one issued for the same account in the same second"."""
+    seed(store_path)
+    accounts = store.load(store_path)
+    frozen = 1_000_000.0
+
+    first = commands.reset_token(accounts, "alice", DEFAULT_TTL, frozen)
+    second = commands.reset_token(accounts, "alice", DEFAULT_TTL, frozen)
+
+    assert first.code == second.code == 0
+    assert first.out != second.out
+    assert TOKEN_PATTERN.fullmatch(first.out[:-1])
+    assert TOKEN_PATTERN.fullmatch(second.out[:-1])
+
+
+def test_fr040_consecutive_cli_issuances_differ(store_path, run_cli):
+    """FR-040: two real invocations in immediate succession produce different tokens."""
+    seed(store_path)
+    argv = ["--store", str(store_path), "reset-token", "alice"]
+    first = run_cli(argv)[1]
+    second = run_cli(argv)[1]
+    assert first != second
+
+
+# ------------------------------------------------------------- FR-041 validity window
+
+
+def test_fr041_an_omitted_ttl_means_a_900_second_window(store_path, run_cli, read_store):
+    """FR-041: when --ttl is omitted, SECONDS is 900."""
+    seed(store_path)
+    before = store.load(store_path)
+    issued_at = 1_700_000_000.0
+
+    accounts = copy.deepcopy(before)
+    commands.reset_token(accounts, "alice", DEFAULT_TTL, issued_at)
+    assert accounts["alice"]["reset_token"]["expires_at"] == issued_at + 900
+
+    # And through the CLI, where cli._dispatch applies the default: the window is 900
+    # seconds after an instant bracketed by the call.
+    low = time.time()
+    status, _, _ = run_cli(["--store", str(store_path), "reset-token", "alice"])
+    high = time.time()
+    assert status == 0
+    expires_at = read_store(store_path)["accounts"]["alice"]["reset_token"]["expires_at"]
+    assert low + 900 <= expires_at <= high + 900
+
+
+@pytest.mark.parametrize("ttl", [1, 60, 3600, 86_400])
+def test_fr041_an_explicit_ttl_sets_expires_at_to_now_plus_seconds(store_path, ttl):
+    """FR-041: a token is valid from issuance until SECONDS seconds have elapsed."""
+    seed(store_path)
+    accounts = store.load(store_path)
+    issued_at = 1_700_000_000.5
+
+    commands.reset_token(accounts, "alice", ttl, issued_at)
+    assert accounts["alice"]["reset_token"]["expires_at"] == issued_at + ttl
+
+
+def test_fr041_the_ttl_itself_is_not_stored(store_path):
+    """FR-041 / research.md R-12: one absolute instant, not an issued_at plus a window."""
+    seed(store_path)
+    accounts = store.load(store_path)
+    commands.reset_token(accounts, "alice", 60, 1_700_000_000.0)
+    assert set(accounts["alice"]["reset_token"]) == {"salt", "verifier", "expires_at"}
+
+
+# -------------------------------------------- FR-046 / FR-057 what the store ends up with
+
+
+def test_fr046_the_stored_token_record_carries_exactly_three_fields(
+    store_path, run_cli, read_store
+):
+    """FR-046 / FR-057: a salt, a verifier, and an expiry — nothing else, no token."""
+    seed(store_path)
+    status, out, _ = run_cli(["--store", str(store_path), "reset-token", "alice"])
+    assert status == 0
+
+    outstanding = read_store(store_path)["accounts"]["alice"]["reset_token"]
+    assert set(outstanding) == {"salt", "verifier", "expires_at"}
+    assert len(base64.b64decode(outstanding["salt"], validate=True)) == 16
+    assert len(base64.b64decode(outstanding["verifier"], validate=True)) == 32
+    assert isinstance(outstanding["expires_at"], float)
+    assert out[:-1] not in outstanding.values()
+
+
+def test_fr046_issuing_changes_nothing_else_about_the_account(store_path, run_cli, read_store):
+    """FR-046: the stored password, failed-login count, and lock state are untouched."""
+    seed(store_path, failed_logins=3)
+    before = read_store(store_path)["accounts"]["alice"]
+
+    status, _, _ = run_cli(["--store", str(store_path), "reset-token", "alice"])
+    assert status == 0
+    after = read_store(store_path)["accounts"]["alice"]
+
+    for field in ("salt", "verifier", "failed_logins", "locked"):
+        assert after[field] == before[field], field
+    assert before["failed_logins"] == 3
+
+    # The password in force before issuance still works, and issuing did not grant access.
+    assert run_cli(["--store", str(store_path), "login", "alice"], PASSWORD + "\n")[0] == 0
+
+
+def test_fr046_the_token_is_durable_the_moment_the_command_exits_0(store_path, run_cli):
+    """FR-046: a separate load sees the token the issuing command returned 0 for."""
+    seed(store_path)
+    status, out, _ = run_cli(["--store", str(store_path), "reset-token", "alice"])
+    assert status == 0
+    assert "reset_token" in record_of(store_path)
+
+    # Durable means usable by the next invocation, which is the observable form.
+    assert run_cli(
+        ["--store", str(store_path), "reset", "alice"], f"{out}a brand new secret\n"
+    ) == (0, "password reset\n", "")
+
+
+# --------------------------------------------------------------- FR-047 locked accounts
+
+
+def test_fr047_issuing_succeeds_for_a_locked_account_with_identical_output(
+    tmp_path, run_cli, read_store
+):
+    """FR-047: same output shape and same status as for an unlocked account."""
+    unlocked = tmp_path / "unlocked.json"
+    locked = tmp_path / "locked.json"
+    seed(unlocked)
+    seed(locked, failed_logins=5, locked=True)
+
+    plain = run_cli(["--store", str(unlocked), "reset-token", "alice"])
+    held = run_cli(["--store", str(locked), "reset-token", "alice"])
+
+    assert plain[0] == held[0] == 0
+    assert plain[2] == held[2] == ""
+    assert TOKEN_PATTERN.fullmatch(held[1][:-1])
+    assert len(plain[1]) == len(held[1])
+
+    # The lock survives issuance untouched (FR-046 as well).
+    after = read_store(locked)["accounts"]["alice"]
+    assert after["locked"] is True
+    assert after["failed_logins"] == 5
+
+
+# ------------------------------------------------------------------ FR-044 supersession
+
+
+def test_fr044_issuing_a_second_token_replaces_the_first(store_path, run_cli, read_store):
+    """FR-044: an account has at most one outstanding token."""
+    seed(store_path)
+    first_token = run_cli(["--store", str(store_path), "reset-token", "alice"])[1][:-1]
+    first_record = dict(read_store(store_path)["accounts"]["alice"]["reset_token"])
+
+    second_token = run_cli(["--store", str(store_path), "reset-token", "alice"])[1][:-1]
+    second_record = read_store(store_path)["accounts"]["alice"]["reset_token"]
+
+    assert first_token != second_token
+    assert second_record["salt"] != first_record["salt"]
+    assert second_record["verifier"] != first_record["verifier"]
+    assert second_record["expires_at"] >= first_record["expires_at"]
+    assert set(second_record) == {"salt", "verifier", "expires_at"}
+
+
+def test_fr044_a_superseded_token_is_treated_as_one_that_was_never_issued(
+    store_path, run_cli
+):
+    """FR-044: the first of two tokens is rejected; only the second works."""
+    seed(store_path)
+    first = run_cli(["--store", str(store_path), "reset-token", "alice"])[1][:-1]
+    second = run_cli(["--store", str(store_path), "reset-token", "alice"])[1][:-1]
+
+    status, out, err = run_cli(
+        ["--store", str(store_path), "reset", "alice"], f"{first}\na brand new secret\n"
+    )
+    assert (status, out, err) == (1, "", "invalid token\n")
+
+    assert run_cli(
+        ["--store", str(store_path), "reset", "alice"], f"{second}\na brand new secret\n"
+    ) == (0, "password reset\n", "")
+
+
+# ------------------------------------------------------------- FR-045 unknown account
+
+
+def test_fr045_reset_token_for_an_unknown_account_exits_3_naming_it(store_path, run_cli):
+    """FR-045: a diagnostic naming the account on stderr, nothing on stdout, exit 3."""
+    seed(store_path)
+    status, out, err = run_cli(["--store", str(store_path), "reset-token", "nobody"])
+
+    assert status == 3
+    assert out == ""
+    assert err == "no such account: nobody\n"
+    assert "nobody" in err
+
+
+def test_fr045_an_unknown_account_leaves_the_store_byte_identical(store_path, run_cli):
+    """FR-045: no token issued and no write at all."""
+    seed(store_path)
+    before = store_path.read_bytes()
+
+    assert run_cli(["--store", str(store_path), "reset-token", "nobody"])[0] == 3
+    assert store_path.read_bytes() == before
+
+
+def test_fr045_an_unknown_account_in_an_absent_store_creates_no_file(store_path, run_cli):
+    """FR-045 / FR-002: a missing store is a store with no accounts, and stays missing."""
+    status, out, err = run_cli(["--store", str(store_path), "reset-token", "alice"])
+    assert (status, out, err) == (3, "", "no such account: alice\n")
+    assert not store_path.exists()
+
+
+# ------------------------------------------------------------ FR-042 --ttl value rules
+
+BAD_TTL_VALUES = {
+    "zero": "0",
+    "negative": "-5",
+    "non-numeric": "abc",
+    "float": "10.0",
+    "exponent": "1e3",
+    "underscored": "1_000",
+    "explicit plus": "+5",
+    "padded with spaces": " 10 ",
+    "arabic-indic digits": "١٢٣",
+    "empty": "",
+}
+
+
+@pytest.mark.parametrize("case", sorted(BAD_TTL_VALUES), ids=sorted(BAD_TTL_VALUES))
+def test_fr042_a_ttl_that_is_not_a_positive_whole_number_is_a_usage_error(
+    case, store_path, run_cli
+):
+    """FR-042 / E17: usage diagnostic on stderr, exit 2, no token issued, store unchanged.
+
+    ``1_000`` and ``+5`` are the cases that matter most: ``int()`` would have silently
+    coerced them to 1000 and 5, issuing a token under a window the operator never wrote
+    (Principle II, research.md R-14).
+    """
+    seed(store_path)
+    before = store_path.read_bytes()
+
+    status, out, err = run_cli(
+        ["--store", str(store_path), "reset-token", "alice", "--ttl", BAD_TTL_VALUES[case]]
+    )
+
+    assert status == 2, case
+    assert out == "", case
+    assert "usage:" in err, case
+    assert "--ttl" in err, case
+    assert store_path.read_bytes() == before, case
+    assert "reset_token" not in record_of(store_path), case
+
+
+def test_fr042_a_bad_ttl_fails_before_the_store_is_read(store_path, run_cli):
+    """FR-042: failing in the parser makes "store unchanged" true by construction."""
+    status, out, err = run_cli(["--store", str(store_path), "reset-token", "alice", "--ttl", "0"])
+    assert (status, out) == (2, "")
+    assert "usage:" in err
+    assert not store_path.exists()
+
+
+@pytest.mark.parametrize("value", ["1", "7", "900", "86400", "007"])
+def test_fr042_a_positive_whole_number_of_seconds_is_accepted(value, store_path, run_cli):
+    """FR-042: any positive integer is the operator's choice — there is no upper bound."""
+    seed(store_path)
+    status, out, err = run_cli(
+        ["--store", str(store_path), "reset-token", "alice", "--ttl", value]
+    )
+    assert (status, err) == (0, "")
+    assert TOKEN_PATTERN.fullmatch(out[:-1])
+    assert record_of(store_path)["reset_token"]["expires_at"] > 0
