+
+def test_fr041_a_token_is_invalid_at_exactly_the_instant_its_window_elapses(store_path):
+    """FR-041 / FR-052: "MUST NOT be valid thereafter" — the boundary is strict."""
+    seed(store_path)
+    accounts = store.load(store_path)
+    issued = commands.reset_token(accounts, "alice", 60, 1_000.0)
+    expires_at = accounts["alice"]["reset_token"]["expires_at"]
+
+    result = commands.reset(accounts, "alice", issued.out[:-1], NEW_PASSWORD, expires_at)
+    assert (result.code, result.out, result.err) == (1, "", "invalid token\n")
+    assert result.save is False
+
+
+@pytest.mark.parametrize("overshoot", [0.001, 1.0, 86_400.0])
+def test_fr041_a_token_is_invalid_after_its_window_elapses(store_path, overshoot):
+    """FR-041: and stays invalid, however long afterwards it is presented."""
+    seed(store_path)
