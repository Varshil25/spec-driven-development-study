diff --git a/tests/unit/test_phones.py b/tests/unit/test_phones.py
new file mode 100644
index 0000000..f3200bf
--- /dev/null
+++ b/tests/unit/test_phones.py
@@ -0,0 +1,267 @@
+"""FR-001 … FR-006 and FR-003a — the phone rule, in one place.
+
+Every case here is quoted from contracts/redaction-rules.md. These drive
+``redact_line`` directly: the phone rule is pure matching, so it needs no I/O
+and no subprocess (plan.md "Structure Decision").
+"""
+
+import pytest
+
+from logredact.redact import redact_line
+
+
+def red(text):
+    return redact_line(text)[0]
+
+
+def counts(text):
+    return redact_line(text)[1]
+
+
+# --------------------------------------------------------------------------
+# FR-001, FR-002 — a `+` plus 8-15 unbroken digits becomes [PHONE]
+# --------------------------------------------------------------------------
+
+
+def test_fr001_placeholder_is_the_literal_text():
+    assert red("+14155552671") == "[PHONE]"
+
+
+def test_fr002_the_plus_is_part_of_the_match_and_is_replaced_with_the_digits():
+    """No `+` is left behind: the placeholder stands for the whole thing."""
+    text, c = redact_line("call +14155552671 now")
+    assert text == "call [PHONE] now"
+    assert "+" not in text
+    assert c["phones"] == 1
+
+
+# --------------------------------------------------------------------------
+# FR-002, FR-003 — the boundary table (contracts/redaction-rules.md)
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "source, expected, phones",
+    [
+        ("+1234567", "+1234567", 0),  # 7 digits — one short
+        ("+12345678", "[PHONE]", 1),  # 8 digits — the lower bound
+        ("+123456789012345", "[PHONE]", 1),  # 15 digits — the upper bound
+        ("+1234567890123456", "+1234567890123456", 0),  # 16 — one over
+        (  # 32 digits — unchanged in full
+            "+12345678901234567890123456789012",
+            "+12345678901234567890123456789012",
+            0,
+        ),
+    ],
+)
+def test_fr003_boundary_table(source, expected, phones):
+    text, c = redact_line(source)
+    assert text == expected
+    assert c["phones"] == phones
+
+
+def test_fr003_an_over_long_run_is_never_partially_redacted():
+    """The trailing `(?!\\d)` is what makes 16 digits *no match at all*.
+
+    Without it, `\\d{8,15}` would match the first 15 digits of a longer run and
+    emit `[PHONE]` glued to the leftover digits — the exact failure the spec's
+    "Longer digit run" edge case forbids (research.md R-001).
+    """
+    for source in ["+1234567890123456", "+12345678901234567890123456789012"]:
+        text, c = redact_line(source)
+        assert text == source
+        assert "[PHONE]" not in text
+        assert c == {"emails": 0, "ips": 0, "cards": 0, "phones": 0}
+
+
+def test_fr003_a_run_shorter_than_eight_digits_is_left_entirely_alone():
+    assert red("+1") == "+1"
+    assert red("+1234567") == "+1234567"
+    assert red("+ 14155552671") == "+ 14155552671"  # the `+` must be adjacent
+
+
+# --------------------------------------------------------------------------
+# FR-002 — unbroken digits only; separated forms are not phone numbers
+# --------------------------------------------------------------------------
+
+
+def test_fr002_separated_forms_are_not_matched_as_phones():
+    """`+1 415 555 2671` and `+1-415-555-2671` keep today's behaviour exactly.
+
+    The residual card candidate is 13 digits but fails Luhn either way, so both
+    lines come back unchanged with nothing counted (research.md R-001).
+    """
+    for source in ["+1 415 555 2671", "+1-415-555-2671"]:
+        text, c = redact_line(source)
+        assert text == source
+        assert c == {"emails": 0, "ips": 0, "cards": 0, "phones": 0}
+
+
+def test_fr002_parentheses_and_dots_are_not_separators_either():
+    assert red("+1(415)5552671") == "+1(415)5552671"
+    assert red("+1.415.555.2671") == "+1.415.555.2671"
+
+
+# --------------------------------------------------------------------------
+# FR-002 — a preceding digit does not disqualify the `+`
+# --------------------------------------------------------------------------
+
+
+def test_fr002_a_preceding_digit_does_not_disqualify_the_plus():
+    """There is deliberately no `(?<!\\d)` lookbehind: what precedes the `+` is
+    not part of a phone number (research.md R-001)."""
+    text, c = redact_line("5+14155552671")
+    assert text == "5[PHONE]"
+    assert c["phones"] == 1
+
+
+def test_fr002_non_digit_neighbours_do_not_block_recognition():
+    assert red("x+14155552671y") == "x[PHONE]y"
+    assert red("(+14155552671)") == "([PHONE])"
+
+
+# --------------------------------------------------------------------------
+# FR-004 — one left-to-right pass; several phones on one line
+# --------------------------------------------------------------------------
+
+
+def test_fr004_several_phones_on_one_line_are_all_replaced():
+    text, c = redact_line("ring +14155552671, then +442071838750.")
+    assert text == "ring [PHONE], then [PHONE]."
+    assert c["phones"] == 2
+
+
+def test_fr004_trailing_punctuation_is_not_consumed():
+    assert red("+14155552671, next") == "[PHONE], next"
+    assert red("call +442071838750.") == "call [PHONE]."
+
+
+# --------------------------------------------------------------------------
+# FR-006 — the placeholder is inert
+# --------------------------------------------------------------------------
+
+
+def test_fr006_literal_placeholder_in_the_input_passes_through_uncounted():
+    text, c = redact_line("[PHONE] unchanged")
+    assert text == "[PHONE] unchanged"
+    assert c == {"emails": 0, "ips": 0, "cards": 0, "phones": 0}
+
+
+def test_fr006_inserted_placeholders_are_not_counted_a_second_time():
+    text, c = redact_line("+14155552671 and [PHONE]")
+    assert text == "[PHONE] and [PHONE]"
+    assert c["phones"] == 1
+
+
+# --------------------------------------------------------------------------
+# FR-003a — a `+`-prefixed unbroken digit run is never a card
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "source, expected, cards, phones",
+    [
+        # No `+`: unchanged from today.
+        ("4111111111111111", "[CARD]", 1, 0),
+        # 16 digits: not a card any more (FR-003a), and not a phone either.
+        ("+4111111111111111", "+4111111111111111", 0, 0),
+        # 13 digits: a phone, and the `+` starts one character earlier.
+        ("+4111111111119", "[PHONE]", 0, 1),
+        # Separators mean this is not an unbroken run, so FR-003a does not
+        # apply and today's `+[CARD]` stands.
+        ("+4111 1111 1111 1111", "+[CARD]", 1, 0),
+    ],
+)
+def test_fr003a_plus_prefixed_card_table(source, expected, cards, phones):
+    text, c = redact_line(source)
+    assert text == expected
+    assert c["cards"] == cards
+    assert c["phones"] == phones
+
+
+def test_fr003a_exclusion_holds_whatever_the_length_or_luhn_status():
+    """FR-003a is unconditional for an unbroken run: no length test, no Luhn."""
+    # 16 digits, Luhn-valid.
+    assert red("pay +4111111111111111 now") == "pay +4111111111111111 now"
+    # 19 digits, the upper card bound, Luhn-valid (`[CARD]` without the `+`).
+    assert red("4111111111111111110") == "[CARD]"
+    assert red("+4111111111111111110") == "+4111111111111111110"
+    # 16 digits, Luhn-invalid — rejected twice over, which is still unchanged.
+    assert red("+4111111111111112") == "+4111111111111112"
+
+
+def test_fr003a_the_separated_form_is_explicitly_preserved():
+    """The pattern-level `(?<!\\+)` fix was rejected because it breaks this row.
+
+    Blocking the candidate at the `4` makes the engine restart at the second
+    group, leaving a 12-digit remainder that fails the length check and prints
+    the line unchanged — not the `+[CARD]` the spec requires (research.md R-002).
+    """
+    text, c = redact_line("+4111 1111 1111 1111")
+    assert text == "+[CARD]"
+    assert c["cards"] == 1
+
+
+def test_fr003a_a_card_merely_near_a_plus_is_unaffected():
+    """Only the character *immediately* before the run matters."""
+    assert red("+ 4111111111111111") == "+ [CARD]"
+    assert red("++4111111111111111") == "++4111111111111111"
+    assert red("a+ 4111111111111111") == "a+ [CARD]"
+
+
+# --------------------------------------------------------------------------
+# FR-005 — same-position precedence: email -> ip -> card -> phone
+# --------------------------------------------------------------------------
+
+
+def test_fr005_email_wins_over_phone_at_a_shared_start():
+    """Both candidates start at the `+` (the local-part class contains `+`),
+    and `email` is written first in the alternation."""
+    text, c = redact_line("+15551234567@example.com")
+    assert text == "[EMAIL]"
+    assert c == {"emails": 1, "ips": 0, "cards": 0, "phones": 0}
+
+
+def test_fr004_an_email_starting_earlier_wins_on_position():
+    text, c = redact_line("jane+15551234567@example.com")
+    assert text == "[EMAIL]"
+    assert c == {"emails": 1, "ips": 0, "cards": 0, "phones": 0}
+
+
+def test_fr004_position_not_alternation_order_decides_phone_against_card():
+    """`card` is written before `phone`, yet `+4111111111119` is a phone: its
+    `+` sits one character before the card candidate's first digit."""
+    text, c = redact_line("+4111111111119")
+    assert text == "[PHONE]"
+    assert c["phones"] == 1
+    assert c["cards"] == 0
+
+
+# --------------------------------------------------------------------------
+# FR-008, SC-003 — the count equals the placeholders in the output
+# --------------------------------------------------------------------------
+
+
+def test_fr008_phones_count_equals_the_placeholders_present_in_the_output():
+    """Sources deliberately free of a literal `[PHONE]`, so every placeholder in
+    the output is one this run inserted (the literal case is FR-006's)."""
+    for source in [
+        "call +14155552671 now",
+        "ring +14155552671, then +442071838750.",
+        "+1234567 +1234567890123456",
+        "nothing of interest",
+        "a@b.io 1.2.3.4 4111111111111111 +14155552671",
+        "+4111111111119 +4111111111111111 +4111 1111 1111 1111",
+    ]:
+        text, c = redact_line(source)
+        assert text.count("[PHONE]") == c["phones"]
+
+
+def test_fr008_a_rejected_phone_candidate_increments_nothing():
+    assert counts("+1234567") == {"emails": 0, "ips": 0, "cards": 0, "phones": 0}
+    assert counts("+1234567890123456") == {
+        "emails": 0,
+        "ips": 0,
+        "cards": 0,
+        "phones": 0,
+    }
diff --git a/tests/unit/test_precedence.py b/tests/unit/test_precedence.py
index a086730..15db589 100644
--- a/tests/unit/test_precedence.py
+++ b/tests/unit/test_precedence.py
