+# --------------------------------------------------------------------------
+# FR-023, 001:FR-028 — the early-closing consumer, on the `wrote N files` line
+# --------------------------------------------------------------------------
+
+
+def test_fr023_an_early_closing_consumer_of_the_wrote_line_exits_zero_silently(
+    logs
+):
+    """With `--out-dir` the only thing on stdout is `wrote N files`.
+
+    It is small enough to sit in the buffer, so the broken pipe surfaces at the
+    final flush — the path that must stay inside the 001:FR-028 guard, or the
+    run exits 120 with a traceback (research.md R-006).
+    """
+    environment = dict(os.environ)
+    environment["PYTHONPATH"] = str(SRC)
+    read_fd, write_fd = os.pipe()
+    os.close(read_fd)  # a pipe with no reader at all
+    proc = subprocess.Popen(
+        [
+            sys.executable,
+            "-m",
+            "logredact",
+            "--out-dir",
+            "clean",
+            "--count",
+            "app.log",
+            "web.log",
+        ],
+        stdin=subprocess.PIPE,
+        stdout=write_fd,
+        stderr=subprocess.PIPE,
+        env=environment,
+        cwd=str(logs),
+    )
+    os.close(write_fd)
+    _, err = proc.communicate(b"")
+
+    assert proc.returncode == 0
+    assert err == b""
+    assert b"Traceback" not in err
+    assert b"BrokenPipeError" not in err
+    assert b"Exception ignored" not in err
+    # The output files were still written in full before stdout was flushed.
+    assert (logs / "clean" / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert (logs / "clean" / "web.log").read_bytes() == b"GET / from [IP]\n"
