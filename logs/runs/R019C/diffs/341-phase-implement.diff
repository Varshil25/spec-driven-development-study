+# --------------------------------------------------------------------------
+# 002:FR-004, 002:FR-005 — the same rules with a fourth type appended
+# --------------------------------------------------------------------------
+
+
+def test_fr004_position_beats_alternation_order_for_phone_against_card():
+    """`card` is written before `phone`, and yet this is a phone.
+
+    The phone candidate starts at the `+`, one character before the card
+    candidate's first digit, so leftmost-wins decides it and the branch order is
+    never consulted (research.md R-003).
+    """
+    text, c = redact_line("+4111111111119")
+    assert text == "[PHONE]"
+    assert c == {"emails": 0, "ips": 0, "cards": 0, "phones": 1}
+
+
+def test_fr005_email_wins_over_phone_at_a_shared_start():
+    """The only type a phone can tie with: the email local-part class contains
+    `+`, so both candidates begin at offset 0 and the written order decides."""
+    text, c = redact_line("+15551234567@example.com")
+    assert text == "[EMAIL]"
+    assert c == {"emails": 1, "ips": 0, "cards": 0, "phones": 0}
+
+
+def test_fr004_an_email_starting_earlier_than_the_plus_wins_on_position():
+    text, c = redact_line("jane+15551234567@example.com")
+    assert text == "[EMAIL]"
+    assert c == {"emails": 1, "ips": 0, "cards": 0, "phones": 0}
+
+
+def test_fr004_all_four_types_on_one_line_are_resolved_left_to_right():
+    text, c = redact_line("a@b.io 1.2.3.4 4111111111111111 +14155552671")
+    assert text == "[EMAIL] [IP] [CARD] [PHONE]"
+    assert c == {"emails": 1, "ips": 1, "cards": 1, "phones": 1}
+
+
+def test_fr006_all_four_placeholders_pass_through_uncounted():
+    text, c = redact_line("[PHONE] [EMAIL] [IP] [CARD]")
+    assert text == "[PHONE] [EMAIL] [IP] [CARD]"
+    assert c == {"emails": 0, "ips": 0, "cards": 0, "phones": 0}