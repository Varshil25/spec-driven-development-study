+def test_fr020_a_symlink_to_the_input_is_caught(run_cli, logs):
+    (logs / "out").mkdir()
+    (logs / "out" / "app.log").symlink_to(logs / "app.log")
+    before = (logs / "app.log").read_bytes()
+    proc = run_cli(["--out-dir", "out", "app.log"], cwd=logs)
+    assert_failed(proc, "app.log")
+    assert (logs / "app.log").read_bytes() == before
+
+
+def test_fr020_a_hard_link_to_the_input_is_caught(run_cli, logs):
+    (logs / "out").mkdir()
+    os.link(logs / "app.log", logs / "out" / "app.log")
+    before = (logs / "app.log").read_bytes()
+    proc = run_cli(["--out-dir", "out", "app.log"], cwd=logs)
+    assert_failed(proc, "app.log")
+    assert (logs / "app.log").read_bytes() == before
+
+
+def test_fr020_the_check_runs_before_makedirs(run_cli, logs):
+    """A doomed command line leaves the filesystem untouched."""
+    nested = logs / "sub"
+    nested.mkdir()
+    (nested / "app.log").write_bytes(b"inner a@b.io\n")
+    proc = run_cli(["--out-dir", "sub", "sub/app.log", "app.log"], cwd=logs)
+    assert_failed(proc, "sub/app.log")
+    # `sub` already existed; nothing new was created anywhere.
+    assert sorted(os.listdir(logs)) == ["app.log", "sub", "web.log"]
+    assert os.listdir(nested) == ["app.log"]
+
+
+def test_fr020_an_unrelated_same_named_file_in_dir_is_not_a_collision(
+    run_cli, logs
+):
+    """Only the *same file on disk* counts; a different file of the same name
+    in DIR is simply replaced (FR-012)."""
+    (logs / "out").mkdir()
+    (logs / "out" / "app.log").write_bytes(b"stale\n")
+    proc = run_cli(["--out-dir", "out", "app.log"], cwd=logs)
+    assert proc.returncode == 0
+    assert proc.stdout == b"wrote 1 files\n"
+    assert (logs / "out" / "app.log").read_bytes() == b"user [EMAIL]\n"
+
+
+# --------------------------------------------------------------------------
+# The success control, and the {0, 2} status set (SC-006)
+# --------------------------------------------------------------------------
+
+
+def test_the_success_control_leaves_stderr_empty_and_exits_zero(run_cli, logs):
+    proc = run_cli(["--out-dir", "clean", "app.log", "web.log"], cwd=logs)
+    assert proc.stderr == b""
+    assert proc.returncode == 0
+    assert proc.stdout == b"wrote 2 files\n"
+
+
+def test_sc006_every_out_dir_invocation_returns_only_zero_or_two(
+    run_cli, logs
+):
+    (logs / "not-a-dir").write_bytes(b"")
+    (logs / "clean2" / "app.log").mkdir(parents=True)
+    (logs / "adir").mkdir()
+    (logs / "out").mkdir()
+    (logs / "out" / "b.log").write_bytes(b"x\n")
+
+    invocations = [
+        # Successes.
+        (["--out-dir", "ok1", "app.log"], 0),
+        (["--out-dir", "ok2", "--count", "app.log", "web.log"], 0),
+        (["--out-dir", "ok3/deep/deeper", "app.log"], 0),
+        # FR-019 usage error.
+        (["--out-dir", "ok4"], 2),
+        (["--out-dir", "ok4", "--count"], 2),
+        # FR-016 destination unusable.
+        (["--out-dir", "not-a-dir", "app.log"], 2),
+        (["--out-dir", "not-a-dir/deeper", "app.log"], 2),
+        # FR-017 output path unusable.
+        (["--out-dir", "clean2", "app.log"], 2),
+        # FR-018 input unreadable.
+        (["--out-dir", "ok5", "missing.log"], 2),
+        (["--out-dir", "ok6", "app.log", "adir"], 2),
+        # FR-020 collision.
+        (["--out-dir", ".", "app.log"], 2),
+        (["--out-dir", "out", "app.log", "out/b.log"], 2),
+    ]
+    observed = set()
+    for argv, expected in invocations:
+        proc = run_cli(argv, stdin=b"a@b.io\n", cwd=logs)
+        assert proc.returncode == expected, (argv, proc.returncode, proc.stderr)
+        assert proc.returncode in (0, 2)
+        assert b"Traceback" not in proc.stderr
+        observed.add(proc.returncode)
+    assert observed == {0, 2}
