@@ -0,0 +1,433 @@
+"""002:FR-009 … FR-015, FR-021, FR-022 — `--out-dir`, the happy path.
+
+A real subprocess, because the stream split (redacted lines to the folder, only
+``wrote N files`` to stdout) and the contents of the destination can only be
+observed from outside the process (plan.md "Structure Decision").
+"""
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[2] / "src"
+
+
+@pytest.fixture
+def logs(tmp_path):
+    """Two readable inputs, named relative to ``tmp_path`` as the cwd."""
+    (tmp_path / "app.log").write_bytes(b"user jane@example.com\n")
+    (tmp_path / "web.log").write_bytes(b"GET / from 10.0.0.7\n")
+    return tmp_path
+
+
+# --------------------------------------------------------------------------
+# FR-010, FR-014 — one output file per FILE, and the success line
+# --------------------------------------------------------------------------
+
+
+def test_fr010_each_file_is_written_to_a_file_of_the_same_name_in_dir(
+    run_cli, logs
+):
+    proc = run_cli(["--out-dir", "clean", "app.log", "web.log"], cwd=logs)
+    assert proc.returncode == 0
+    assert (logs / "clean" / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert (logs / "clean" / "web.log").read_bytes() == b"GET / from [IP]\n"
+    assert proc.stdout == b"wrote 2 files\n"
+    assert proc.stderr == b""
+
+
+def test_fr010_no_redacted_line_ever_reaches_stdout(run_cli, logs):
+    """stdout is byte-for-byte only the `wrote N files` line (FR-010)."""
+    proc = run_cli(["--out-dir", "clean", "app.log", "web.log"], cwd=logs)
+    assert proc.stdout == b"wrote 2 files\n"
+    assert b"[EMAIL]" not in proc.stdout
+    assert b"[IP]" not in proc.stdout
+    assert b"user" not in proc.stdout
+    assert b"GET" not in proc.stdout
+
+
+def test_fr014_one_file_still_reports_wrote_1_files_never_pluralized(
+    run_cli, logs
+):
+    proc = run_cli(["--out-dir", "clean", "app.log"], cwd=logs)
+    assert proc.stdout == b"wrote 1 files\n"
+    assert b"1 file\n" not in proc.stdout
+    assert proc.returncode == 0
+
+
+def test_fr014_n_counts_file_arguments_so_a_repeated_file_counts_again(
+    run_cli, logs
+):
+    proc = run_cli(["--out-dir", "clean", "app.log", "app.log"], cwd=logs)
+    assert proc.stdout == b"wrote 2 files\n"
+    # Written twice to the same destination; "w" mode leaves one copy.
+    assert (logs / "clean" / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert proc.returncode == 0
+
+
+def test_fr014_two_files_sharing_a_name_each_count(run_cli, logs):
+    nested = logs / "sub"
+    nested.mkdir()
+    (nested / "app.log").write_bytes(b"other 10.0.0.7\n")
+    proc = run_cli(
+        ["--out-dir", "clean", "app.log", "sub/app.log"], cwd=logs
+    )
+    assert proc.stdout == b"wrote 2 files\n"
+    # The later write wins the shared path.
+    assert (logs / "clean" / "app.log").read_bytes() == b"other [IP]\n"
+    assert proc.returncode == 0
+
+
+# --------------------------------------------------------------------------
+# FR-011, FR-015 — the destination is created, with any missing parents
+# --------------------------------------------------------------------------
+
+
+def test_fr011_a_three_level_missing_destination_and_its_parents_are_created(
+    run_cli, logs
+):
+    proc = run_cli(["--out-dir", "a/b/c", "app.log"], cwd=logs)
+    assert proc.returncode == 0
+    assert (logs / "a").is_dir()
+    assert (logs / "a" / "b").is_dir()
+    assert (logs / "a" / "b" / "c").is_dir()
+    assert (logs / "a" / "b" / "c" / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert proc.stdout == b"wrote 1 files\n"
+
+
+def test_fr011_an_existing_destination_is_used_as_it_is(run_cli, logs):
+    (logs / "clean").mkdir()
+    (logs / "clean" / "unrelated.txt").write_bytes(b"keep me\n")
+    proc = run_cli(["--out-dir", "clean", "app.log"], cwd=logs)
+    assert proc.returncode == 0
+    # The folder is not inventory: files this run did not write are untouched.
+    assert (logs / "clean" / "unrelated.txt").read_bytes() == b"keep me\n"
+    assert (logs / "clean" / "app.log").read_bytes() == b"user [EMAIL]\n"
+
+
+# --------------------------------------------------------------------------
+# FR-012 — an existing same-named file is replaced, never appended to
+# --------------------------------------------------------------------------
+
+
+def test_fr012_an_existing_same_named_file_is_replaced_entirely(run_cli, logs):
+    (logs / "clean").mkdir()
+    stale = logs / "clean" / "app.log"
+    stale.write_bytes(b"stale contents that must disappear\n")
+    proc = run_cli(["--out-dir", "clean", "app.log"], cwd=logs)
+    assert proc.returncode == 0
+    content = stale.read_bytes()
+    assert content == b"user [EMAIL]\n"
+    assert b"stale" not in content
+    assert b"disappear" not in content
+
+
+def test_fr012_a_longer_stale_file_is_truncated_not_partly_overwritten(
+    run_cli, logs
+):
+    (logs / "clean").mkdir()
+    stale = logs / "clean" / "app.log"
+    stale.write_bytes(b"x" * 5000 + b"\n")
+    proc = run_cli(["--out-dir", "clean", "app.log"], cwd=logs)
+    assert proc.returncode == 0
+    assert stale.read_bytes() == b"user [EMAIL]\n"
+
+
+# --------------------------------------------------------------------------
+# FR-010 — the input's directories are never reproduced inside DIR
+# --------------------------------------------------------------------------
+
+
+def test_fr010_the_inputs_directories_are_discarded(run_cli, logs):
+    nested = logs / "logs" / "2026"
+    nested.mkdir(parents=True)
+    (nested / "app.log").write_bytes(b"user jane@example.com\n")
+    proc = run_cli(["--out-dir", "clean", "logs/2026/app.log"], cwd=logs)
+    assert proc.returncode == 0
+    assert (logs / "clean" / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert not (logs / "clean" / "logs").exists()
+    assert os.listdir(logs / "clean") == ["app.log"]
+
+
+def test_fr010_an_absolute_input_path_is_reduced_to_its_base_name(
+    run_cli, logs
+):
+    proc = run_cli(
+        ["--out-dir", "clean", str(logs / "app.log")], cwd=logs
+    )
+    assert proc.returncode == 0
+    assert os.listdir(logs / "clean") == ["app.log"]
+    assert (logs / "clean" / "app.log").read_bytes() == b"user [EMAIL]\n"
+
+
+# --------------------------------------------------------------------------
+# FR-010, FR-014 — an empty input produces an empty file that still counts
+# --------------------------------------------------------------------------
+
+
+def test_fr014_an_empty_input_produces_an_empty_output_file_that_counts(
+    run_cli, logs
+):
+    (logs / "empty.log").write_bytes(b"")
+    proc = run_cli(["--out-dir", "clean", "empty.log", "app.log"], cwd=logs)
+    assert proc.returncode == 0
+    assert (logs / "clean" / "empty.log").read_bytes() == b""
+    assert (logs / "clean" / "empty.log").exists()
+    assert proc.stdout == b"wrote 2 files\n"
+
+
+# --------------------------------------------------------------------------
+# FR-009 — the option works in any position, and with `=`
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "argv",
+    [
+        ["--out-dir", "clean", "app.log", "web.log"],
+        ["app.log", "--out-dir", "clean", "web.log"],
+        ["app.log", "web.log", "--out-dir", "clean"],
+        ["--out-dir=clean", "app.log", "web.log"],
+        ["app.log", "web.log", "--count", "--out-dir", "clean"],
+        ["--out-dir", "clean", "--count", "app.log", "web.log"],
+        ["app.log", "--count", "--out-dir=clean", "web.log"],
+    ],
+)
+def test_fr009_the_option_is_accepted_in_any_position(run_cli, logs, argv):
+    proc = run_cli(argv, cwd=logs)
+    assert proc.returncode == 0
+    assert proc.stdout == b"wrote 2 files\n"
+    assert (logs / "clean" / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert (logs / "clean" / "web.log").read_bytes() == b"GET / from [IP]\n"
+
+
+def test_fr009_the_option_appears_in_the_help_and_usage_text(run_cli):
+    proc = run_cli(["--help"])
+    assert proc.returncode == 0
+    assert b"--out-dir DIR" in proc.stdout
+    assert b"FILE" in proc.stdout
+
+
+# --------------------------------------------------------------------------
+# FR-022 — with `--count`, both outputs are produced, stdout first
+# --------------------------------------------------------------------------
+
+
+def test_fr022_count_gives_one_combined_summary_covering_every_file(
