+"""002:FR-016 … FR-020 and FR-017a — every `--out-dir` failure path.
+
+Each case asserts both halves of Constitution Principle II — a specific
+diagnostic naming the offending path, and a failure signal — plus the two
+suppressions the spec adds: no ``wrote N files`` line and no ``--count``
+summary, so a partial run is never presented as a complete one.
+"""
+
+import os
+import resource
+import signal
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[2] / "src"
+
+
+def assert_failed(proc, path):
+    """The shared shape of every `--out-dir` failure (FR-016 … FR-020)."""
+    assert proc.returncode == 2, proc.stderr
+    assert path.encode() in proc.stderr
+    assert proc.stderr.startswith(b"python -m logredact: ") or b"usage:" in (
+        proc.stderr
+    )
+    # Neither output a complete run would have produced.
+    assert b"wrote " not in proc.stdout
+    assert b"emails=" not in proc.stderr
+    assert b"phones=" not in proc.stderr
+    # No stack trace, ever.
+    assert b"Traceback" not in proc.stderr
+    assert b"most recent call last" not in proc.stderr
+
+
+@pytest.fixture
+def logs(tmp_path):
+    (tmp_path / "app.log").write_bytes(b"user jane@example.com\n")
+    (tmp_path / "web.log").write_bytes(b"GET / from 10.0.0.7\n")
+    return tmp_path
+
+
+# --------------------------------------------------------------------------
+# FR-016 — DIR cannot be created or used
+# --------------------------------------------------------------------------
+
+
+def test_fr016_destination_is_an_existing_regular_file(run_cli, logs):
+    (logs / "not-a-dir").write_bytes(b"")
+    proc = run_cli(["--out-dir", "not-a-dir", "--count", "app.log"], cwd=logs)
+    assert_failed(proc, "not-a-dir")
+    assert proc.stdout == b""
+    # No FILE was read: no output file of any name exists, and the regular
+    # file at the destination path is untouched.
+    assert (logs / "not-a-dir").read_bytes() == b""
+    assert sorted(os.listdir(logs)) == ["app.log", "not-a-dir", "web.log"]
+
+
+def test_fr016_the_destination_is_named_exactly_as_written(run_cli, logs):
+    (logs / "not-a-dir").write_bytes(b"")
+    proc = run_cli(["--out-dir", "./not-a-dir", "app.log"], cwd=logs)
+    assert_failed(proc, "./not-a-dir")
+    # Never normalised, never made absolute (001 R-007).
+    assert str(logs).encode() not in proc.stderr
+
+
+def test_fr016_the_diagnostic_states_the_reason(run_cli, logs):
+    (logs / "not-a-dir").write_bytes(b"")
+    proc = run_cli(["--out-dir", "not-a-dir", "app.log"], cwd=logs)
+    assert proc.stderr.lower().count(b"file exists") == 1
+    assert proc.returncode == 2
+
+
+def test_fr016_no_file_is_read_so_no_later_input_diagnostic_appears(
+    run_cli, logs
+):
+    """DIR fails first, so a missing FILE never reaches the FR-018 path."""
+    (logs / "not-a-dir").write_bytes(b"")
+    proc = run_cli(
+        ["--out-dir", "not-a-dir", "app.log", "missing.log"], cwd=logs
+    )
+    assert_failed(proc, "not-a-dir")
+    assert b"missing.log" not in proc.stderr
+    assert b"No such file" not in proc.stderr
+
+
+def test_fr016_a_parent_that_is_a_regular_file_is_reported(run_cli, logs):
+    (logs / "blocker").write_bytes(b"")
+    proc = run_cli(["--out-dir", "blocker/deeper", "app.log"], cwd=logs)
+    assert_failed(proc, "blocker/deeper")
+    assert proc.stdout == b""
+
+
+# --------------------------------------------------------------------------
+# FR-017 — the output file cannot be created or written
+# --------------------------------------------------------------------------
+
+
+def test_fr017_output_path_is_an_existing_directory(run_cli, logs):
+    (logs / "clean2" / "app.log").mkdir(parents=True)
+    proc = run_cli(["--out-dir", "clean2", "--count", "app.log"], cwd=logs)
+    # The diagnostic names the OUTPUT path, not the input (FR-017).
+    assert_failed(proc, "clean2/app.log")
+    assert proc.stdout == b""
+    # The directory in the way is left alone.
+    assert (logs / "clean2" / "app.log").is_dir()
+
+
+def test_fr017_an_earlier_files_output_survives_a_later_output_failure(
+    run_cli, logs
+):
+    (logs / "clean2" / "web.log").mkdir(parents=True)
+    proc = run_cli(["--out-dir", "clean2", "app.log", "web.log"], cwd=logs)
+    assert_failed(proc, "clean2/web.log")
+    # app.log was processed first and its output is complete and valid.
+    assert (logs / "clean2" / "app.log").read_bytes() == b"user [EMAIL]\n"
+
+
+def test_fr017_processing_stops_at_the_failing_file(run_cli, logs):
+    (logs / "third.log").write_bytes(b"THIRD-SENTINEL a@b.io\n")
+    (logs / "clean2" / "web.log").mkdir(parents=True)
+    proc = run_cli(
+        ["--out-dir", "clean2", "app.log", "web.log", "third.log"], cwd=logs
+    )
+    assert_failed(proc, "clean2/web.log")
+    assert not (logs / "clean2" / "third.log").exists()
+    assert b"third.log" not in proc.stderr
+
+
+# --------------------------------------------------------------------------
+# FR-017a — a write cut short leaves no truncated file behind
+# --------------------------------------------------------------------------
+
+
+def _run_with_file_size_limit(argv, cwd, limit):
+    """Run the tool with RLIMIT_FSIZE set, so a long write fails partway.
+
+    ``SIGXFSZ`` is ignored in the child so the oversized write returns ``EFBIG``
+    as an ordinary ``OSError`` instead of killing the process — which is what
+    makes a genuine mid-write failure observable (FR-017, FR-017a).
+    """
+
+    def _limit():
+        signal.signal(signal.SIGXFSZ, signal.SIG_IGN)
+        resource.setrlimit(resource.RLIMIT_FSIZE, (limit, limit))
+
+    environment = dict(os.environ)
+    environment["PYTHONPATH"] = str(SRC)
+    return subprocess.run(
+        [sys.executable, "-m", "logredact", *argv],
+        input=b"",
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        env=environment,
+        cwd=str(cwd),
+        preexec_fn=_limit,
+    )
+
+
+@pytest.mark.skipif(
+    not hasattr(signal, "SIGXFSZ"), reason="RLIMIT_FSIZE needs a POSIX signal"
+)
+def test_fr017a_a_write_cut_short_leaves_no_truncated_file(logs):
+    big = logs / "big.log"
+    big.write_bytes(b"".join(b"a@b.io line %d\n" % i for i in range(20000)))
+    proc = _run_with_file_size_limit(
+        ["--out-dir", "clean", "--count", "app.log", "big.log"],
+        cwd=logs,
+        limit=4096,
+    )
+    assert proc.returncode == 2, proc.stderr
+    assert b"clean/big.log" in proc.stderr
+    assert b"wrote " not in proc.stdout
+    assert b"emails=" not in proc.stderr
+    assert b"Traceback" not in proc.stderr
+    # No truncated file for the input whose write was cut short...
+    assert not (logs / "clean" / "big.log").exists()
+    # ...and the earlier input's output file is still present and complete.
+    assert (logs / "clean" / "app.log").read_bytes() == b"user [EMAIL]\n"
+    assert sorted(os.listdir(logs / "clean")) == ["app.log"]
+
+
+@pytest.mark.skipif(
+    not hasattr(signal, "SIGXFSZ"), reason="RLIMIT_FSIZE needs a POSIX signal"
+)
+def test_fr017a_a_cut_short_later_write_removes_the_shared_destination_path(
+    logs
+):
+    """Two FILEs sharing a name: the destination path follows the *later*
+    write's outcome, so a cut short later write removes it rather than leaving
+    the earlier content under a name that no longer describes it (FR-017a)."""
+    nested = logs / "sub"
+    nested.mkdir()
+    (nested / "app.log").write_bytes(
+        b"".join(b"a@b.io line %d\n" % i for i in range(20000))
+    )
+    proc = _run_with_file_size_limit(
+        ["--out-dir", "clean", "app.log", "sub/app.log"],
+        cwd=logs,
+        limit=4096,
+    )
+    assert proc.returncode == 2, proc.stderr
+    assert b"clean/app.log" in proc.stderr
+    assert b"wrote " not in proc.stdout
+    assert b"Traceback" not in proc.stderr
+    # The earlier FILE's complete output is NOT left behind under that name.
+    assert not (logs / "clean" / "app.log").exists()
+    assert os.listdir(logs / "clean") == []
+
+
+# --------------------------------------------------------------------------
+# FR-018 — a FILE cannot be read, with --out-dir
+# --------------------------------------------------------------------------
+
+
+def test_fr018_the_missing_input_is_named_and_leaves_no_file_in_dir(
+    run_cli, logs
+):
+    proc = run_cli(
+        ["--out-dir", "clean", "--count", "app.log", "missing.log"], cwd=logs
