{
  "$comment": "sddlog instrumentation. Hooks no-op unless a run is active (logs/ACTIVE_RUN). Start one with: python3 tools/sddlog/sddlog.py run-start --task <id> --run-id <id> --condition unstructured|sdd|sdd_clarify --model <model>",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/sddlog/sddlog.py\" --repo \"$CLAUDE_PROJECT_DIR\" hook --event SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/sddlog/sddlog.py\" --repo \"$CLAUDE_PROJECT_DIR\" hook --event UserPromptSubmit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/sddlog/sddlog.py\" --repo \"$CLAUDE_PROJECT_DIR\" hook --event PostToolUse"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob|Task|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/sddlog/sddlog.py\" --repo \"$CLAUDE_PROJECT_DIR\" hook --event PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/sddlog/sddlog.py\" --repo \"$CLAUDE_PROJECT_DIR\" hook --event Stop"
          }
        ]
      }
    ]
  }
}
