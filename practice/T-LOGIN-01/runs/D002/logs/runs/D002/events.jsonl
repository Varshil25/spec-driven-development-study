{"schema_version": "1.0.0", "event_id": "96116ba1-59bb-4e74-8b9b-f2190aa9ca6a", "run_id": "D002", "seq": 14, "ts": "2026-10-23T22:03:31.776Z", "type": "prompt", "actor": "human", "phase": "specify", "condition": "sdd", "task_id": "T-LOGIN-01", "session_id": null, "payload": {"text": "Q1: Yes. After logout that token must stop working, even if someone kept a copy of it.\n\nQ2: After 5 failed attempts in a row for a username, refuse logins for that username for 15 minutes, even with the right password, with the same `Invalid username or password` response.\n", "chars": 274, "words": 49, "sha256": "46905cbc1db6958270540166604f7e58217d2bd483859aeef1cbfedffd64d895", "source": "manual"}}
